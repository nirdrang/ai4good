 307: /** Read a JSON request body, or refuse — a malformed body must not read as an empty one. */
 308: export async function readJsonBody(request: Request): Promise<{ ok: true; value: Record<string, unknown> } | { ok: false; reason: string }> {
 309:   let text: string;
 310:   try {
 311:     text = await request.text();
 312:   } catch {
 313:     return { ok: false, reason: 'the request body could not be read' };
 314:   }
 315:   if (text.trim() === '') return { ok: true, value: {} };
 316:   try {
 317:     const parsed = JSON.parse(text) as unknown;
 318:     if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) {
 319:       return { ok: false, reason: 'the request body must be a JSON object' };
 320:     }
 321:     return { ok: true, value: parsed as Record<string, unknown> };
 322:   } catch {
 323:     return { ok: false, reason: 'the request body is not valid JSON' };
 324:   }
 325: }

