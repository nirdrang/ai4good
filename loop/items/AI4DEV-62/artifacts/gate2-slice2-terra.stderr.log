 208: function databaseRefusal(error: unknown): { code: string; message: string } {
 209:   const carrier = error as Record<string, unknown> | null;
 210:   let code = '';
 211:   for (const field of ['errno', 'errcode', 'code'] as const) {
 212:     const value = carrier?.[field];
 213:     if (typeof value === 'string' && /^[0-9A-Z]{5}$/.test(value)) {
 214:       code = value;
 215:       break;
 216:     }
 217:   }
 218:   const message = typeof carrier?.message === 'string' ? carrier.message : String(error);
 219:   return { code, message };
 220: }
