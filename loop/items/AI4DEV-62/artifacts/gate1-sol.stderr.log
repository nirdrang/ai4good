  232:       'complete_signup refuses account type platform_admin: a platform administrator is provisioned, never self-signed-up'
  233:       using errcode = '42501';
  234:   end if;
  235: 
  236:   if p_account_type is null or p_account_type not in ('ngo', 'volunteer') then
  237:     raise exception 'complete_signup refuses account type %: public signup offers ngo or volunteer',
  238:       coalesce(p_account_type, '<null>')
