  150: /** The one place a handle is turned into a token, and the one place the divergence is enforced. */
  151: function tokensOf(store: Map<string, LiveSession>, session: Session, act: string): LiveSession {
  152:   const held = session.sessionId ? store.get(session.sessionId) : undefined;
  153:   if (!held) {
  154:     throw new Error(
  155:       `refusing to ${act}: this handle names account ${session.accountId} and holds NO session. On the live stack a ` +
  156:         `registration under enable_confirmations = true issues no tokens, so the handle it returns cannot act. Follow ` +
  157:         `the live public order â€” register, use the emailed verification link, sign in â€” and act with the sign-in's ` +
  158:         `session. Nothing was fabricated to make this call work.`,
  159:     );
  160:   }
  161:   return held;
  162: }
  163: 
  164: /** The `session_id` claim, which is the identity of the `auth.sessions` row GoTrue minted. */
  165: function sessionIdOf(accessToken: string): string {
  166:   const claims = JSON.parse(Buffer.from(accessToken.split('.')[1], 'base64url').toString('utf8')) as {
  167:     session_id?: unknown;
  168:     sub?: unknown;
  169:   };
  170:   return String(claims.session_id ?? '');
  171: }
  172: 
  173: function accountIdOf(accessToken: string): string {
  174:   const claims = JSON.parse(Buffer.from(accessToken.split('.')[1], 'base64url').toString('utf8')) as { sub?: unknown };
  175:   return String(claims.sub ?? '');
  176: }
