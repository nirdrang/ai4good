    1: /**
    2:  * THE IDS REQ-001 HAS NOT LANDED YET, and the leaf that will land each one. There are 24 of them as
    3:  * of the session-and-reset leaf; there were 28 before it, 30 before that and 33 before that, and
    4:  * the count moves down as leaves land.
    5:  *
    6:  * WHY THEY EXIST AT ALL. `harness/check.ts`'s `bijectionProblems()` refuses a run when any expected
    7:  * id has no registered call site, and `runner.ts` turns any such problem into exit 2 with NOTHING
    8:  * graded. The expected set is every `AT-001.NN (P0)` in `.taskmaster/docs/acceptance/at-req-001.md`
    9:  * â€” all 37 of them. So the moment `tests/at/suites/req-001/` exists, all 37 need executable call
   10:  * sites; there is no partial suite. Thirteen are written â€” AT-001.01 through .07 across the first
   11:  * accounts leaf and the GitHub one, AT-001.09 and .10 with the verification leaf, and AT-001.38,
   12:  * .12, .13 and .14 with the session-and-reset one. The other 24 are declared, not faked: each one
   13:  * throws, loudly, stamped with its own id and with the manifest leaf that will make it real.
   14:  *
   15:  * THEY CANNOT SILENTLY GO GREEN. `AtPending` is a thrown error, so the id is RED, and
   16:  * `tests/at/expected/req-001.json` declares that red by SHAPE â€” `expected.ts` rebuilds the anchored
   17:  * prefix `AtPending: <id> PENDING [sut-missing] â€” ` from the declaration and compares it from
   18:  * position 0. A red of any other cause fails the declaration instead of hiding inside it, and a red
   19:  * that turns green fails it too, so a later leaf must update the ledger in the same change that
   20:  * lands its id. That file is REQ-001's live progress ledger from this item onward.
   21:  *
   22:  * WHAT THE PREFIX DOES NOT CHECK, said plainly because it is the reason every leaf writes a ledger
   23:  * of its own (`loop/items/AI4DEV-57/pending-ledger.txt`, then
   24:  * `loop/items/AI4DEV-58/pending-ledger.txt`, then `loop/items/AI4DEV-59/pending-ledger.txt`, then
   25:  * `loop/items/AI4DEV-60/pending-ledger.txt`): the tail after the em dash is FREE. `expected.ts`
   26:  * anchors on the prefix only, so a stub whose detail read "todo" would pass every command in this
   27:  * repository. Nothing mechanical holds the detail below to the truth. The check that does is a
   28:  * written one â€” every leaf named here appears in `loop/decomp/req-001.md`, and the ledger is the
   29:  * artifact a reviewer compares against the manifest.
   30:  */
   31: 
   32: import { AtPending, type AtContext } from './_bind.ts';
   33: 
   34: /**
   35:  * The manifest's leaves, in the manifest's own words shortened to a recall hint. The keys are the
   36:  * deliverable-and-leaf labels from `loop/decomp/req-001.md`; the letters there are the MANIFEST's
   37:  * deliverables and are not the plan's decision letters, which use the same alphabet for a different
   38:  * purpose.
   39:  */
   40: export const LEAF = {
   41:   // THREE LABELS ARE GONE FROM THIS MAP rather than kept for symmetry, and the rule is the same for
   42:   // all three: a leaf label sitting here with nothing pointing at it is a claim that something is
   43:   // still pending when nothing is. `tests/at/expected/req-001.json` declares the landed ids green
   44:   // in the same change each time.
   45:   //   D1.L2 â€” GitHub OAuth signup and the mandatory GitHub link â€” landed AT-001.02, .04 and .05.
   46:   //   D2.L1 â€” email verification and the unverified-write gate on Discovery messages â€” landed
   47:   //           AT-001.09 and .10, its only two ids.
   48:   //   D2.L2 â€” session expiry and revocation, auto-refresh, password reset, wrong-password
   49:   //           rejection â€” landed AT-001.38, .12, .13 and .14, its only four ids, so it is removed
   50:   //           here by this leaf.
   51:   D3_L1: 'D3.L1 (per-NGO admin/member roles and multi-NGO membership isolation)',
   52:   D3_L2: 'D3.L2 (the single-seat NGO and the single-dev project invariant)',
   53:   D3_L3: 'D3.L3 (the cross-surface single-seat integration)',
   54:   D4_L1: 'D4.L1 (acknowledgment identity capture â€” name, title, authority attestation)',
   55:   D5_L1: 'D5.L1 (cross-NGO denial and unassigned-volunteer denial)',
   56:   D5_L2: 'D5.L2 (assigned-volunteer scope, platform-admin reach, logged-out visibility)',
   57:   D6_L1: 'D6.L1 (contact transfer, lost-access recovery and the escalation contact)',
   58:   D6_L2: 'D6.L2 (the lifecycle gate every write route registers through)',
   59:   D6_L3: 'D6.L3 (the append-only audit for role changes and transfer, and sign-in rate limiting)',
   60: } as const;
   61: 
   62: export type LeafLabel = (typeof LEAF)[keyof typeof LEAF];
   63: 
   64: /**
   65:  * One not-yet-landed id's whole body.
   66:  *
   67:  * `sut-missing` rather than `harness-missing` is the honest phase word: the harness is up â€” this
   68:  * suite's written ids run against it â€” and what is absent is the system under test for these
   69:  * criteria. The detail is what makes that word honest, by naming WHICH system under test.
   70:  *
   71:  * (The sentence above used to say "this suite's own four ids", which was true when four were
   72:  * written and false from the next leaf onward. The count lives in this file's header and in the
   73:  * ledger, and stating it a second time here only created somewhere for it to drift.)
   74:  */
   75: export function notLanded(leaf: LeafLabel): (ctx: AtContext) => Promise<void> {
   76:   return async (ctx: AtContext): Promise<void> => {
   77:     throw new AtPending(ctx.atId, 'sut-missing', `REQ-001 ${leaf} has not landed`);
   78:   };
