 420: const adminEmail = address('platform-admin');
 421: const adminCreate = await fetch(`${API_URL}/auth/v1/admin/users`, {
 422:   method: 'POST',
 423:   headers: { 'content-type': 'application/json', apikey: SECRET_KEY, Authorization: `Bearer ${SECRET_KEY}` },
 424:   body: JSON.stringify({ email: adminEmail, password: PASSWORD, email_confirm: true }),
 425: });
 426: const adminUser = (await adminCreate.json()) as { id?: string };
 427: if (!adminCreate.ok || !adminUser.id) fail(`could not provision the administrator's auth user: ${adminCreate.status} ${JSON.stringify(adminUser)}`);
 428: 
 429: await sql`insert into public.accounts (id, account_type) values (${adminUser.id}, 'platform_admin')`;
 430: 
 431: const adminSignIn = await signIn(adminEmail);
 432: const adminRows = await sql`select account_type from public.accounts where id = ${adminUser.id}`;
 433: record(
 434:   'g',
 435:   'a provisioned platform administrator authenticates and carries the platform_admin type',
 436:   adminSignIn.ok && adminSignIn.session?.userId === adminUser.id && adminRows.length === 1 && adminRows[0].account_type === 'platform_admin',
 437:   `sign-in HTTP ${adminSignIn.status} · user ${adminSignIn.session?.userId ?? '<none>'} · account row ${JSON.stringify(adminRows)}`,
 438: );
