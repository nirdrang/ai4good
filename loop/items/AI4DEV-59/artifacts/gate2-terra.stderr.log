 289:     const user: AuthUser = { id, email, password, provider, githubHandle, emailConfirmedAt, verificationLink };
 290:     state.authUsers.set(user.id, user);
 291:     state.byEmail.set(email, user.id);
 292:     if (verificationLink !== null) state.byVerificationLink.set(verificationLink, user.id);
 293:     return { accountId: user.id, email: user.email, provider: user.provider };
