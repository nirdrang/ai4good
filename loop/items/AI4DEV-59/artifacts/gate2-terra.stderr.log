 180:   request: CompleteSignupRequest,
===== supabase/functions/_shared/github.ts =====
   1: /**
   2:  * The two GitHub-shaped judgements REQ-001's second leaf needs, in ONE module both the shipped edge
   3:  * function and the acceptance adapter import.
   4:  *
   5:  * IT IS UNDER THE SAME TWO CONSTRAINTS AS `accounts.ts`, for the same reasons, and they are real
   6:  * rather than stylistic:
   7:  *
   8:  *   1. ZERO NON-RELATIVE IMPORTS AND NO DENO GLOBAL. It is compiled by `tests/at/tsconfig.json`
   9:  *      (`strict`, `skipLibCheck: false`, `types: ["node"]`, no DOM library) and it is also run by
  10:  *      Deno inside the edge runtime. The intersection of the two is plain TypeScript over plain
  11:  *      data.
  12:  *   2. NO I/O, NO CLOCK, NO RANDOMNESS. Both functions below are pure, so the same judgement can be
  13:  *      replayed by a test with no network and no database.
  14:  *
  15:  * WHICH PROGRAM TYPE-CHECKS IT: the `tests/at` one, and only that one — it reaches the strict
  16:  * acceptance program by being imported from `tests/at/suites/req-001/_fixture.ts`, exactly as
  17:  * `accounts.ts` does, and that import is the whole of its type coverage.
  18:  *
  19:  * ============================================================================================
  20:  * NO REAL GITHUB CALL EXISTS ANYWHERE IN THIS ITEM, AND NO GREEN MAY BE READ AS PROVING ONE.
  21:  * ============================================================================================
  22:  *
  23:  * `stubGithubStatsFor` below is the STUB IMPORT FIXTURE the decomposition manifest's cross-contract
  24:  * calls for in so many words — `loop/decomp/req-001.md` header: "REQ-007's GitHub-onboarding import
  25:  * is asserted here as observable firing only (stub import fixture until W3)". The IMPORT SOURCE is
  26:  * a stand-in by ratified design. What this leaf owns and proves is the FIRING and the populated
  27:  * profile: that completing a linked volunteer signup writes handle and stats, in the same
  28:  * transaction, with nothing queued and nothing empty. When the volunteer-profile requirement lands
  29:  * the real import in W3, `stubGithubStatsFor` is replaced in place and every caller keeps working,
  30:  * because the shape is the contract and the values are not.
  31:  */
  32: 
  33: /* --------------------------------------------------- 1. which GitHub identity is linked, if any */
  34: 
  35: /**
  36:  * The GitHub handle on the caller's linked identities, or `null` — judged from the `/auth/v1/user`
  37:  * response shape and from nothing else.
  38:  *
  39:  * IT TAKES `unknown` ON PURPOSE. The argument is a JSON body that crossed a network; typing the
  40:  * parameter as a nice record would be a claim about somebody else's server, so every step down into
  41:  * it is checked here instead. A shape this does not recognise reads as "no GitHub identity is
  42:  * linked", which is the safe direction: `validateCompleteSignup` refuses a volunteer completion on
  43:  * a null handle, so a misread response BLOCKS a signup loudly rather than waiving the gate quietly.
  44:  *
  45:  * `identity_data.user_name` is GoTrue's field for the GitHub login. It is read in exactly TWO places
  46:  * in this repository — here, and in the handle-binding check inside `public.complete_signup` — and
  47:  * the plan's risk 3 names both, because if that field ever turns out to be spelled differently when
  48:  * a real OAuth app first arrives, the change is a two-place change and not a one-line one.
  49:  */
  50: export function extractGithubHandle(user: unknown): string | null {
  51:   if (typeof user !== 'object' || user === null) return null;
  52:   const identities = (user as { identities?: unknown }).identities;
  53:   if (!Array.isArray(identities)) return null;
  54: 
  55:   for (const identity of identities) {
  56:     if (typeof identity !== 'object' || identity === null) continue;
  57:     const record = identity as { provider?: unknown; identity_data?: unknown };
  58:     if (record.provider !== 'github') continue;
  59:     const data = record.identity_data;
  60:     if (typeof data !== 'object' || data === null) continue;
  61:     const handle = (data as { user_name?: unknown }).user_name;
  62:     if (typeof handle === 'string' && handle.trim() !== '') return handle.trim();
  63:   }
  64:   return null;
  65: }
  66: 
  67: /* ------------------------------------------------------------- 2. what the onboarding import is */
  68: 
  69: /** The three public statistics AT-001.05 names: top languages, repository count, contribution summary. */
  70: export type GithubStats = {
  71:   topLanguages: string[];
  72:   repositoryCount: number;
  73:   contributionSummary: string;
  74: };
  75: 
  76: /**
  77:  * The pool the stub draws its languages from. A fixed list rather than a generated string, so the
  78:  * values look like languages to a reader of the transcript and a wrong one is obvious.
  79:  */
  80: const STUB_LANGUAGE_POOL = [
  81:   'TypeScript',
  82:   'Python',
  83:   'Go',
  84:   'Rust',
  85:   'Ruby',
  86:   'Java',
  87:   'Elixir',
  88:   'C',
  89: ] as const;
  90: 
  91: /**
  92:  * A 32-bit fingerprint of the handle — FNV-1a, chosen because it is four lines of arithmetic with no
  93:  * dependency and no platform variation. It is NOT a security primitive and nothing here treats it
  94:  * as one; its only job is to make the stub's answer differ between handles while staying identical
  95:  * for one handle on every machine that computes it.
  96:  */
  97: function handleFingerprint(handle: string): number {
  98:   let hash = 2166136261;
  99:   for (let index = 0; index < handle.length; index += 1) {
 100:     hash ^= handle.charCodeAt(index);
 101:     hash = Math.imul(hash, 16777619);
 102:   }
 103:   return hash >>> 0;
 104: }
 105: 
 106: /**
 107:  * The stand-in for REQ-007's GitHub onboarding import — DETERMINISTIC AND NON-EMPTY BY
 108:  * CONSTRUCTION, and it is a stand-in, not an import.
 109:  *
 110:  * DETERMINISTIC, because a random or clock-derived answer would make AT-001.05's assertion either
 111:  * untestable or reduced to "something is there", and "something is there" is what the criterion's
 112:  * own words — "a queued-but-empty import fails this test" — exist to refuse.
 113:  *
 114:  * NON-EMPTY BY CONSTRUCTION: at least one language always, a repository count that is always at
 115:  * least one, and a summary sentence that always mentions the handle. Note the asymmetry with the
 116:  * schema, which permits `repository_count = 0`: a REAL import may legitimately find a volunteer with
 117:  * no public repositories, so the column allows it; the STUB never produces it, so a zero read back
 118:  * in a test would mean the value did not come from here.
 119:  *
 120:  * WHAT A GREEN OVER THIS FUNCTION CLAIMS: that the import fires at completion and lands populated in
 121:  * the same transaction as the account. WHAT IT DOES NOT CLAIM: that any statistic here was ever
 122:  * fetched from GitHub. Nothing in this item reaches api.github.com.
 123:  */
 124: export function stubGithubStatsFor(handle: string): GithubStats {
 125:   const fingerprint = handleFingerprint(handle);
 126: 
 127:   // One, two or three languages — never zero, which is the whole point of the `cardinality(...) >= 1`
 128:   // constraint this value has to satisfy on the way into `public.volunteer_profiles`.
 129:   const languageCount = 1 + (fingerprint % 3);
 130:   const firstLanguage = fingerprint % STUB_LANGUAGE_POOL.length;
 131:   const topLanguages: string[] = [];
 132:   for (let offset = 0; offset < languageCount; offset += 1) {
 133:     topLanguages.push(STUB_LANGUAGE_POOL[(firstLanguage + offset) % STUB_LANGUAGE_POOL.length]);
 134:   }
 135: 
 136:   const repositoryCount = 1 + (fingerprint % 240);
 137: 
 138:   return {
 139:     topLanguages,
 140:     repositoryCount,
 141:     contributionSummary:
 142:       `stub import fixture: ${handle} has ${repositoryCount} public repositories, ` +
 143:       `most recently in ${topLanguages[0]} — no GitHub API was called to produce this`,
 144:   };
 145: }

