===== tests/at/harness/expected.ts =====
   1: /**
   2:  * The expected-state declaration — what `bun run at:verify req-0NN --tier <tier> --expect` checks
   3:  * the run against.
   4:  *
   5:  * WHY THIS EXISTS: without it `at:verify` exits 1 whenever any acceptance id is red, and REQ-016
   6:  * legitimately has honest reds waiting on later capability slices. So the command cannot gate
   7:  * anything — a machine cannot tell "the declared greens plus the declared honest reds" from
   8:  * "something broke", and every claim of green is a human reading a table. A declaration makes the
   9:  * expected state a committed, machine-checked contract instead.
  10:  *
  11:  * TWO RULES DO THE WORK, and both are deliberately harsh:
  12:  *
  13:  *   1. A RED THAT TURNED GREEN IS A FAILURE. The declaration is the contract, so improving reality
  14:  *      means updating the contract in the same change. Without that rule the gate cannot tell
  15:  *      improvement from drift, which is the whole point.
  16:  *
  17:  *   2. A DECLARED RED IS MATCHED BY SHAPE, NOT BY SUBSTRING. A free substring cannot establish
  18:  *      that a red has its declared CAUSE: `H3 fault injection` as a substring also matches
  19:  *      `Error: H3 fault injection: fixture reset failed`, so a brand-new harness defect would
  20:  *      satisfy the declaration. Each declared red therefore names its kind, and the first line the
  21:  *      harness prints is REBUILT from the declaration and compared exactly. A red whose detail
  22:  *      fits neither shape is undeclarable — and therefore a failure. That is deliberate: a red we
  23:  *      cannot describe exactly is a red we do not understand.
  24:  *
  25:  * KNOWN, ACCEPTED TRADE-OFF (rule 2): the rebuilt lines below duplicate message text owned by
  26:  * `capabilities.ts` and `registry.ts`. Deriving them by constructing the error classes would track
  27:  * a wording change silently; duplicating them means a wording change breaks declarations loudly,
  28:  * with a diff naming the id. That is the correct failure direction. Machine-readable capability
  29:  * codes emitted before redaction are the better long-term answer and belong to the slice that owns
  30:  * `capabilities.ts`.
  31:  *
  32:  * Every function here except `loadTierExpectation` is pure, so the comparison rules are unit
  33:  * testable without spawning anything.
  34:  */
  35: 
  36: import { readFileSync } from 'node:fs';
  37: import { join } from 'node:path';
  38: 
  39: import { REPO_ROOT } from './check.ts';
  40: import type { PendingPhase } from './registry.ts';
  41: import type { IdRow, ProcessOutcome } from './runner.ts';
  42: 
  43: /* ------------------------------------------------------------------------------- the schema */
  44: 
  45: /** A red we can describe exactly. Anything else is undeclarable, and so a failure. */
  46: export type RedDeclaration =
  47:   | { kind: 'capability-pending'; capabilities: string[] }
  48:   | { kind: 'pending'; phase: PendingPhase };
  49: 
  50: /** One tier's declaration: the ids that MUST be green, and the ids that MUST be red, with why. */
  51: export interface TierExpectation {
  52:   green: string[];
  53:   red: Record<string, RedDeclaration>;
  54: }
  55: 
  56: export interface ExpectedManifest {
  57:   requirement: string;
  58:   tiers: Record<string, TierExpectation>;
  59: }
  60: 
  61: /** Exactly the three fields this module reads off a runner report row. */
  62: export type ReportedRow = Pick<IdRow, 'id' | 'status' | 'detail'>;
  63: 
  64: /**
  65:  * The vitest report's own arithmetic AND its per-file entries. Typed `unknown` on purpose: this
  66:  * describes someone else's JSON file, so every field is validated at runtime rather than asserted
  67:  * at compile time.
  68:  */
  69: export interface ReportTotals {
  70:   numTotalTests?: unknown;
  71:   numPassedTests?: unknown;
  72:   numFailedTests?: unknown;
  73:   numPendingTests?: unknown;
  74:   numTodoTests?: unknown;
  75:   success?: unknown;
  76:   testResults?: unknown;
  77: }
  78: 
  79: /** One test FILE in the report. A failure that no test claims is visible here and nowhere else. */
  80: interface ReportSuiteFile {
  81:   name?: unknown;
  82:   status?: unknown;
  83:   message?: unknown;
  84:   assertionResults?: unknown;
  85: }
  86: 
  87: const TIERS = ['loop', 'integration', 'drill'];
  88: 
  89: /** The same grammar `registry.ts` enforces at the `atTest` call site. */
  90: const AT_ID = /^AT-\d{3}(?:\.\d+)*\.\d+[a-z]?$/;
  91: 
  92: /**
  93:  * What `redact()` in the runner leaves behind when it rewrites something secret-shaped. A
  94:  * declaration may never contain one — see `parseRedDeclaration` — and a detail that contains one
  95:  * fails closed at comparison time, because the sentinel identifies nothing.
  96:  */
  97: const REDACTION_SENTINEL = /<redacted(?:-[a-z]+)?>/;
  98: 
  99: /** Pinned to the type, so a phase renamed in registry.ts is a compile error here, not a dud rule. */
 100: const PENDING_PHASES = ['harness-missing', 'sut-missing', 'tier-unset'] as const satisfies readonly PendingPhase[];
 101: 
 102: /* --------------------------------------------------------------------------------- locating */
 103: 
 104: /** Declarations live under the DATA root, so `AT_REPO_ROOT` redirects them with everything else. */
 105: export function expectedManifestPath(requirement: string): string {
 106:   return join(REPO_ROOT, 'tests', 'at', 'expected', `req-${requirement}.json`);
 107: }
 108: 
 109: /** The path as it reads in a message — stable across machines, which matters for the selftests. */
 110: function manifestLabel(requirement: string): string {
 111:   return `tests/at/expected/req-${requirement}.json`;
 112: }
 113: 
 114: /* -------------------------------------------------------------------------------- validating */
 115: 
 116: function isPlainObject(value: unknown): value is Record<string, unknown> {
 117:   return typeof value === 'object' && value !== null && !Array.isArray(value);
 118: }
 119: 
 120: function parseRedDeclaration(label: string, atId: string, value: unknown): RedDeclaration {
 121:   const where = `${label}: the declaration for ${atId}`;
 122:   if (!isPlainObject(value)) {
 123:     throw new Error(
 124:       `${where} must be an object carrying its "kind" — a bare string reason is the old schema, ` +
 125:         `which could be satisfied by an unrelated failure containing the same words`,
 126:     );
 127:   }
 128: 
 129:   const kind = value.kind;
 130:   if (kind === 'capability-pending') {
 131:     const capabilities = value.capabilities;
 132:     if (!Array.isArray(capabilities) || capabilities.length === 0) {
 133:       throw new Error(`${where} needs a non-empty "capabilities" array`);
 134:     }
 135:     for (const name of capabilities) {
 136:       if (typeof name !== 'string' || name.trim() === '') {
 137:         throw new Error(`${where} has a capability name that is not a non-empty string`);
 138:       }
 139:       // The harness joins names with ", ", so a name containing a comma is ambiguous against the
 140:       // joined line: ["a, b"] and ["a", "b"] produce the same text, and the declaration would no
 141:       // longer say which capabilities are pending.
 142:       if (name.includes(',')) {
 143:         throw new Error(
 144:           `${where} has a capability name containing a comma (${JSON.stringify(name)}) — names are joined with ", ", ` +
 145:             `so a comma makes one name indistinguishable from two`,
 146:         );
 147:       }
 148:       // A redaction sentinel identifies nothing: it is what the runner prints INSTEAD of a
 149:       // secret-shaped value, so declaring one would match any capability whose name happened to be
 150:       // redacted. Refuse it rather than let a declaration become a wildcard.
 151:       if (REDACTION_SENTINEL.test(name)) {
 152:         throw new Error(
 153:           `${where} declares the redaction sentinel ${JSON.stringify(name)}, which identifies no capability — ` +
 154:             `a detail that gets redacted cannot be declared exactly, and must not be matched loosely`,
 155:         );
 156:       }
 157:     }
 158:     return { kind, capabilities: capabilities as string[] };
 159:   }
 160: 
 161:   if (kind === 'pending') {
 162:     const phase = value.phase;
 163:     if (typeof phase !== 'string' || !(PENDING_PHASES as readonly string[]).includes(phase)) {
 164:       throw new Error(`${where} needs a "phase" of ${PENDING_PHASES.join(' | ')}, not ${JSON.stringify(phase)}`);
 165:     }
 166:     return { kind, phase: phase as PendingPhase };
 167:   }
 168: 
 169:   throw new Error(`${where} has an unknown "kind" ${JSON.stringify(kind)} — expected "capability-pending" or "pending"`);
 170: }
 171: 
 172: function parseTierExpectation(label: string, tier: string, value: unknown): TierExpectation {
 173:   const where = `${label}: the ${tier} tier`;
 174:   if (!isPlainObject(value)) throw new Error(`${where} must be an object`);
 175: 
 176:   const green = value.green;
 177:   if (!Array.isArray(green) || green.some((id) => typeof id !== 'string')) {
 178:     throw new Error(`${where} needs a "green" array of ids`);
 179:   }
 180:   const red = value.red;
 181:   if (!isPlainObject(red)) throw new Error(`${where} needs a "red" object`);
 182: 
 183:   // A NULL-PROTOTYPE map, not `{}`. `JSON.parse` happily produces an own `__proto__` key, and
 184:   // assigning that key onto an ordinary object invokes the prototype setter instead of creating a
 185:   // property — so the declaration would vanish from `Object.keys` and slip past both the AT-id
 186:   // grammar check below and the bijection check. With no prototype there is no setter to hit: the
 187:   // key is stored, then refused as a malformed AT id, which is what a reader would expect.
 188:   const declared: TierExpectation = { green: green as string[], red: Object.create(null) as Record<string, RedDeclaration> };
 189:   for (const [atId, declaration] of Object.entries(red)) {
 190:     declared.red[atId] = parseRedDeclaration(label, atId, declaration);
 191:   }
 192: 
 193:   for (const atId of [...declared.green, ...Object.keys(declared.red)]) {
 194:     if (!AT_ID.test(atId)) throw new Error(`${where} declares ${JSON.stringify(atId)}, which is not a well-formed AT id`);
 195:   }
 196:   return declared;
 197: }
 198: 
 199: /** Text → validated manifest. PURE. Throws with a precise message on any malformation. */
 200: export function parseExpectedManifest(text: string, requirement: string): ExpectedManifest {
 201:   const label = manifestLabel(requirement);
 202: 
 203:   let raw: unknown;
 204:   try {
 205:     raw = JSON.parse(text) as unknown;
 206:   } catch (err) {
 207:     throw new Error(`${label} is not valid JSON: ${(err as Error).message}`);
 208:   }
 209: 
 210:   if (!isPlainObject(raw)) throw new Error(`${label} must be a JSON object`);
 211: 
 212:   // The `requirement` field has no other purpose than this copy/paste guard.
 213:   if (raw.requirement !== requirement) {
 214:     throw new Error(`${label} declares requirement ${JSON.stringify(raw.requirement)} but req-${requirement} is being verified`);
 215:   }
 216: 
 217:   const tiers = raw.tiers;
 218:   if (!isPlainObject(tiers)) throw new Error(`${label} needs a "tiers" object`);
 219: 
 220:   const manifest: ExpectedManifest = { requirement, tiers: {} };
 221:   for (const [tier, value] of Object.entries(tiers)) {
 222:     // A typo'd tier key would otherwise surface as the much vaguer "no declaration for this tier".
 223:     if (!TIERS.includes(tier)) throw new Error(`${label} declares an unknown tier ${JSON.stringify(tier)} — expected ${TIERS.join(' | ')}`);
 224:     manifest.tiers[tier] = parseTierExpectation(label, tier, value);
 225:   }
 226:   return manifest;
 227: }
 228: 
 229: /** The tier's declaration, or throw naming the tiers that ARE declared. PURE. */
 230: export function tierExpectation(manifest: ExpectedManifest, tier: string): TierExpectation {
 231:   const declared = manifest.tiers[tier];
 232:   if (!declared) {
 233:     const others = Object.keys(manifest.tiers);
 234:     throw new Error(
 235:       `${manifestLabel(manifest.requirement)} carries no declaration for the ${tier} tier ` +
 236:         `(declared: ${others.length ? others.join(', ') : 'nothing'})`,
 237:     );
 238:   }
 239:   return declared;
 240: }
 241: 
 242: /**
 243:  * The declared ids and the acceptance file's P0 ids must be in exact bijection. PURE.
 244:  * A manifest that forgets an id must never silently pass — that id would simply not be checked.
 245:  */
 246: export function declarationBijectionProblems(expectation: TierExpectation, acceptanceIds: string[]): string[] {
 247:   const redIds = Object.keys(expectation.red);
 248:   const declared = [...expectation.green, ...redIds];
 249:   const problems: string[] = [];
 250: 
 251:   const undeclared = acceptanceIds.filter((id) => !declared.includes(id));
 252:   if (undeclared.length) {
 253:     problems.push(`${undeclared.length} P0 id${undeclared.length === 1 ? '' : 's'} carr${undeclared.length === 1 ? 'ies' : 'y'} no declaration: ${undeclared.join(', ')}`);
 254:   }
 255: 
 256:   const strangers = declared.filter((id) => !acceptanceIds.includes(id));
 257:   if (strangers.length) {
 258:     problems.push(`${strangers.length} declared id${strangers.length === 1 ? ' is' : 's are'} not a P0 of this requirement: ${[...new Set(strangers)].join(', ')}`);
 259:   }
 260: 
 261:   const both = expectation.green.filter((id) => redIds.includes(id));
 262:   if (both.length) problems.push(`${both.length} id${both.length === 1 ? '' : 's'} declared both green and red: ${both.join(', ')}`);
 263: 
 264:   const twice = [...new Set(expectation.green.filter((id, i) => expectation.green.indexOf(id) !== i))];
 265:   if (twice.length) problems.push(`${twice.length} id${twice.length === 1 ? '' : 's'} listed twice in green: ${twice.join(', ')}`);
 266: 
 267:   return problems;
 268: }
 269: 
 270: /* --------------------------------------------------------------------------- matching a red */
 271: 
 272: /**
 273:  * The text a declared red MUST produce, rebuilt from the declaration. PURE.
 274:  *
 275:  * `capability-pending` rebuilds the WHOLE first line, mirroring `CapabilityPending` in
 276:  * capabilities.ts (`CAPABILITY PENDING — <names joined by ", ">`, `name = 'CapabilityPending'`)
 277:  * through vitest's `"<name>: <message>"` serialisation.
 278:  *
 279:  * `pending` rebuilds only the anchored PREFIX, mirroring `AtPending` in registry.ts
 280:  * (`<atId> PENDING [<phase>] — <detail>`). The tail is free by construction and must stay free:
 281:  * `sut-missing` carries a string the suite supplies, and `harness-missing` embeds a
 282:  * module-resolution message that differs by machine and checkout path — a declaration that could
 283:  * never be written on a second machine is not a stricter rule, it is a broken one. Class, id and
 284:  * phase are still all matched exactly, from position 0.
 285:  */
 286: export function declaredDetail(atId: string, red: RedDeclaration): string {
 287:   return red.kind === 'capability-pending'
 288:     ? `CapabilityPending: CAPABILITY PENDING — ${red.capabilities.join(', ')}`
 289:     : `AtPending: ${atId} PENDING [${red.phase}] — `;
 290: }
 291: 
 292: /** Does this reported detail carry exactly the declared shape? PURE. */
 293: export function detailMatches(atId: string, red: RedDeclaration, detail: string): boolean {
 294:   const expected = declaredDetail(atId, red);
 295:   return red.kind === 'capability-pending' ? detail === expected : detail.startsWith(expected);
 296: }
 297: 
 298: function describeRed(red: RedDeclaration): string {
 299:   return red.kind === 'capability-pending' ? `capability-pending: ${red.capabilities.join(', ')}` : `pending: ${red.phase}`;
 300: }
 301: 
 302: /* ---------------------------------------------------------------------------- the comparison */
 303: 
 304: /** Every way the reported ids deviate from the declaration, one line per offending id. PURE. */
 305: export function expectationDeviations(rows: ReportedRow[], unexpected: string[], expectation: TierExpectation): string[] {
 306:   const deviations: string[] = [];
 307:   const seen = new Set<string>();
 308: 
 309:   for (const row of rows) {
 310:     seen.add(row.id);
 311:     const red = expectation.red[row.id];
 312:     const declaredGreen = expectation.green.includes(row.id);
 313: 
 314:     if (row.status === 'missing') {
 315:       deviations.push(`${row.id} — no result was reported for this id`);
 316:       continue;
 317:     }
 318:     if (!red && !declaredGreen) {
 319:       // Unreachable once the bijection check has run; kept so a future caller cannot skip it.
 320:       deviations.push(`${row.id} — reported but not declared`);
 321:       continue;
 322:     }
 323:     if (declaredGreen && row.status === 'red') {
 324:       deviations.push(`${row.id} — declared green, reported red: ${row.detail}`);
 325:       continue;
 326:     }
 327:     if (red && row.status === 'green') {
 328:       deviations.push(
 329:         `${row.id} — declared red (${describeRed(red)}), reported GREEN. ` +
 330:           `If this id genuinely works now, update the declaration in this same change.`,
 331:       );
 332:       continue;
 333:     }
 334:     if (red && row.status === 'red' && REDACTION_SENTINEL.test(row.detail)) {
 335:       // Fail closed. The detail was rewritten because part of it looked secret-shaped, so the line
 336:       // no longer identifies anything and no declaration can honestly match it — including one
 337:       // that declares the sentinel itself, which the parser already refuses.
 338:       deviations.push(
 339:         `${row.id} — this red's detail was redacted, so it cannot be matched exactly and the id is undeclarable ` +
 340:           `until the detail no longer contains a secret-shaped token: ${row.detail}`,
 341:       );
 342:       continue;
 343:     }
 344:     if (red && row.status === 'red' && !detailMatches(row.id, red, row.detail)) {
 345:       const expected = declaredDetail(row.id, red);
 346:       const how = red.kind === 'capability-pending' ? 'expected' : 'expected prefix';
 347:       deviations.push(
 348:         `${row.id} — declared red as ${red.kind}, reported a red of a different shape. ` +
 349:           `${how}: ${JSON.stringify(expected)} actual: ${JSON.stringify(row.detail)}`,
 350:       );
 351:     }
 352:   }
 353: 
 354:   for (const id of unexpected) deviations.push(`${id} — registered but not a P0 of this requirement`);
 355:   for (const id of [...expectation.green, ...Object.keys(expectation.red)]) {
 356:     if (!seen.has(id)) deviations.push(`${id} — declared but not reported`);
 357:   }
 358: 
 359:   return deviations;
 360: }
 361: 
 362: /**
 363:  * Every way the RUN ITSELF is not fully accounted for by the declaration. PURE.
 364:  *
 365:  * WHY THE ID COMPARISON IS NOT ENOUGH: with reds declared, vitest necessarily exits non-zero, so
 366:  * the process's exit code stops carrying information and an extra failure hides behind an expected
 367:  * one. The id parser only sees tests whose titles carry an AT id, so an untagged `it()` that fails
 368:  * is invisible to it — but not to the report's own arithmetic. Every failing, passing, pending and
 369:  * todo test must add up against the declaration; anything unaccounted for is a failure.
 370:  *
 371:  * KNOWN RESIDUAL GAP, stated exactly (it was measured, not reasoned about): a hook that throws in
 372:  * a file which ALSO contains a failing test is serialised identically to a healthy run of that
 373:  * file — same file status, same counts, same `success` — so while a red is declared in that same
 374:  * file, such a failure is invisible here. A hook that throws in a file whose tests all passed IS
 375:  * caught, by `suiteFileDeviations`. Closing the remainder needs a reporter-side envelope, which is
 376:  * filed, not built here.
 377:  */
 378: export function reportAccountingDeviations(totals: ReportTotals, run: ProcessOutcome, expectation: TierExpectation): string[] {
 379:   const green = expectation.green.length;
 380:   const red = Object.keys(expectation.red).length;
 381:   const deviations: string[] = [];
 382: 
 383:   // A launch failure always fails, whatever the declaration says. No message text is quoted: the
 384:   // code is enough to diagnose a spawn failure, and this module does no redaction of its own.
 385:   if (run.error) {
 386:     const err = run.error as NodeJS.ErrnoException;
 387:     deviations.push(`the test process could not be launched (${err.code ?? 'spawn error'})`);
 388:   }
 389: 
 390:   const counts: Record<string, unknown> = {
 391:     numTotalTests: totals.numTotalTests,
 392:     numPassedTests: totals.numPassedTests,
 393:     numFailedTests: totals.numFailedTests,
 394:     numPendingTests: totals.numPendingTests,
 395:     numTodoTests: totals.numTodoTests,
 396:   };
 397:   const unusable: string[] = [];
 398:   for (const [field, value] of Object.entries(counts)) {
 399:     if (typeof value !== 'number' || !Number.isInteger(value) || value < 0) {
 400:       unusable.push(`the report carries no usable ${field}, so the run cannot be accounted for`);
 401:     }
 402:   }
 403:   if (typeof totals.success !== 'boolean') {
 404:     unusable.push('the report carries no usable success flag, so the run cannot be accounted for');
 405:   }
 406:   if (!Array.isArray(totals.testResults)) {
 407:     unusable.push('the report carries no usable testResults array, so suite-level failures cannot be accounted for');
 408:   }
 409:   // Comparing against a field that is missing would be arithmetic on nonsense: report the unusable
 410:   // fields and stop. Under --expect that is a failure, never a skipped check.
 411:   if (unusable.length) return [...deviations, ...unusable];
 412: 
 413:   const total = counts.numTotalTests as number;
 414:   const passed = counts.numPassedTests as number;
 415:   const failed = counts.numFailedTests as number;
 416:   const pending = counts.numPendingTests as number;
 417:   const todo = counts.numTodoTests as number;
 418: 
 419:   if (failed !== red) {
 420:     deviations.push(
 421:       `the report counts ${failed} failed test${failed === 1 ? '' : 's'} but the declaration declares ${red} red${red === 1 ? '' : 's'} — ` +
 422:         `a failure outside the declared ids (an untagged test, a failing hook) looks exactly like this`,
 423:     );
 424:   }
 425:   if (passed !== green) {
 426:     deviations.push(`the report counts ${passed} passed test${passed === 1 ? '' : 's'} but the declaration declares ${green} green${green === 1 ? '' : 's'}`);
 427:   }
 428:   if (total !== green + red) {
 429:     deviations.push(`the report counts ${total} test${total === 1 ? '' : 's'} in total but the declaration accounts for ${green + red} (${green} green + ${red} red) — an extra test ran`);
 430:   }
 431:   if (pending !== 0) deviations.push(`the report counts ${pending} pending (skipped) test${pending === 1 ? '' : 's'} — a skip must never hide inside a declared red`);
 432:   if (todo !== 0) deviations.push(`the report counts ${todo} todo test${todo === 1 ? '' : 's'} — a todo must never hide inside a declared red`);
 433: 
 434:   if (totals.success !== (red === 0)) {
 435:     deviations.push(
 436:       red === 0
 437:         ? 'the report says the run did not succeed while the declaration declares no red'
 438:         : `the report says the whole run succeeded while the declaration declares ${red} red${red === 1 ? '' : 's'} — ` +
 439:             `vitest should have reported those failures, so a clean run means the suite did not do what the declaration says`,
 440:     );
 441:   }
 442: 
 443:   // With no red declared the process's own exit is still the plain rule it has always been.
 444:   if (red === 0 && !run.error && run.status !== 0) {
 445:     const how = run.status === null ? `was killed by signal ${run.signal}` : `exited ${run.status}`;
 446:     deviations.push(`the test process ${how} while the declaration declares no red`);
 447:   }
 448: 
 449:   deviations.push(...suiteFileDeviations(totals.testResults as ReportSuiteFile[]));
 450: 
 451:   return deviations;
 452: }
 453: 
 454: /** The file's own name, without the directory — report paths are temporary in the selftests. */
 455: function suiteFileLabel(name: unknown): string {
 456:   const text = typeof name === 'string' ? name : '';
 457:   const base = text.split(/[\\/]/).pop();
 458:   return base && base.length ? base : 'an unnamed test file';
 459: }
 460: 
 461: function firstLineOf(text: string, limit = 200): string {
 462:   const line =
 463:     text
 464:       .split('\n')
 465:       .map((l) => l.trim())
 466:       .find((l) => l.length > 0) ?? '';
 467:   return line.length > limit ? `${line.slice(0, limit)}…` : line;
 468: }
 469: 
 470: /**
 471:  * Failures that belong to a FILE rather than to any test — and which the test counts above cannot
 472:  * see, because they change no test's status.
 473:  *
 474:  * Measured, not assumed (vitest 4.1.10's JSON reporter):
 475:  *   - a file that fails to import produces an extra `testResults` entry with `status: "failed"`,
 476:  *     ZERO assertion results and a non-empty `message`, while every declared count stays exactly
 477:  *     as declared;
 478:  *   - a file whose `afterAll` throws is reported `status: "failed"` with its assertions unchanged,
 479:  *     so it is caught here whenever that file's tests all passed.
 480:  *
 481:  * The rule is the one Kimi's invariant intends — a failed suite containing no failed test is a
 482:  * collection or hook failure — applied at FILE level, which is the level where it is actually
 483:  * true. The aggregate `numFailedTestSuites` counts `describe` blocks as well as files, so
 484:  * `numFailedTestSuites <= numFailedTests` does NOT hold on a healthy run: REQ-016 reports 6 failed
 485:  * suites for 4 failed tests (3 files plus their 3 describes). Applying it literally would fail the
 486:  * real declaration.
 487:  */
 488: function suiteFileDeviations(files: ReportSuiteFile[]): string[] {
 489:   const deviations: string[] = [];
 490: 
 491:   for (const file of files) {
 492:     const where = suiteFileLabel(file.name);
 493:     const assertions = Array.isArray(file.assertionResults) ? (file.assertionResults as { status?: unknown }[]) : [];
 494:     const failedInFile = assertions.filter((assertion) => assertion?.status !== 'passed').length;
 495: 
 496:     if (typeof file.status !== 'string') {
 497:       deviations.push(`${where} carries no usable status, so the file cannot be accounted for`);
 498:     } else if (file.status !== 'passed' && failedInFile === 0) {
 499:       deviations.push(
 500:         `${where} is reported "${file.status}" but not one test in it failed — that is a collection, import or hook ` +
 501:           `failure, and no AT id can ever claim it`,
 502:       );
 503:     }
 504: 
 505:     if (typeof file.message === 'string' && file.message.trim() !== '') {
 506:       deviations.push(`${where} carries a file-level error that no test claims: ${firstLineOf(file.message)}`);
 507:     }
 508:   }
 509: 
 510:   return deviations;
 511: }
 512: 
 513: /* ---------------------------------------------------------------------------------- the I/O */
 514: 
 515: /**
 516:  * Read, validate and select one tier's declaration — the single call the runner makes, performing
 517:  * every refusal in order so that a bad declaration stops the run before any test is run.
 518:  */
 519: export function loadTierExpectation(requirement: string, tier: string, acceptanceIds: string[]): TierExpectation {
 520:   const file = expectedManifestPath(requirement);
 521: 
 522:   let text: string;
 523:   try {
 524:     text = readFileSync(file, 'utf8');
 525:   } catch (err) {
 526:     if ((err as NodeJS.ErrnoException).code === 'ENOENT') {
 527:       throw new Error(`there is no declaration at ${file} — write one, or run without --expect`);
 528:     }
 529:     throw new Error(`could not read ${file}: ${(err as Error).message}`);
 530:   }
 531: 
 532:   const expectation = tierExpectation(parseExpectedManifest(text, requirement), tier);
 533:   const problems = declarationBijectionProblems(expectation, acceptanceIds);
 534:   if (problems.length) {
 535:     throw new Error(`${manifestLabel(requirement)} is not in bijection with the acceptance file: ${problems.join('; ')}`);
 536:   }
 537:   return expectation;
 538: }
===== tests/at/harness/capabilities.ts =====
   1: /**
   2:  * PROVENANCE IS A VERDICT THIS FILE COMPUTES, NEVER A WORD A CALLER WRITES.
   3:  *
   4:  * There used to be two factories here, one named after each provenance, and a capability's label
   5:  * was simply the one you called. Flipping the five stand-in call sites in `index.ts` to the other
   6:  * factory emptied the stand-in ledger, and `registry.ts` — which refuses ANY stubbed capability
   7:  * above the loop tier — then had nothing to refuse. A one-word edit that reads like a routine
   8:  * promotion turned the closing gate green against a reference adapter.
   9:  *
  10:  * So a capability is now built by ONE constructor that takes a name, a value, and any evidence the
  11:  * caller holds that a witness cannot derive. A witness registered for that name returns a verdict —
  12:  * or throws. There are THREE outcomes, and the third one is the whole point:
  13:  *
  14:  *   stand-in  — the witness found the seam that makes this a substitute, and says which seam.
  15:  *   real      — the witness has positive grounds, and says what they are.
  16:  *   REFUSAL   — the witness cannot classify the value, so it refuses to classify it.
  17:  *
  18:  * "I found no stand-in seam" is NEVER evidence of real backing. A `clock.controlled` value with its
  19:  * `advance` stripped is unclassifiable, not real; classifying it real would be the deleted
  20:  * real-labelling factory reached through a different door — exactly the door this file exists to
  21:  * close.
  22:  *
  23:  * The same rule covers the name itself: a capability name no witness has been registered for is an
  24:  * error at construction, naming the name. Not defaulted to real, and not quietly defaulted to
  25:  * stand-in either. `index.ts` and `registry.ts` have both written the reason down already — a guard
  26:  * that switches itself off when an entry is absent is the hole again, arriving through the door
  27:  * marked convenience.
  28:  */
  29: 
  30: const CAPABILITY = Symbol('at-capability');
  31: 
  32: export type CapabilityProvenance = 'real' | 'stand-in';
  33: 
  34: /** A witness returns one of these, or it throws. There is no `null` and there is no default. */
  35: export type CapabilityVerdict =
  36:   | { readonly kind: 'stand-in'; readonly reason: string }
  37:   | { readonly kind: 'real'; readonly evidence: string };
  38: 
  39: /**
  40:  * The one place a caller contributes anything, and it is deliberately narrow: facts a witness
  41:  * cannot derive from the value in front of it. Only `oracles.judge` needs any of it — the running
  42:  * tier and the judge transport's `kind` brand, both of which `oracles.ts` already guards and
  43:  * refuses in both mismatched directions before it ever gets here.
  44:  */
  45: export type CapabilityEvidence = {
  46:   readonly tier?: string;
  47:   readonly transport?: string;
  48: };
  49: 
  50: export interface Capability<T> {
  51:   readonly [CAPABILITY]: true;
  52:   readonly name: string;
  53:   readonly provenance: CapabilityProvenance;
  54:   /** the witness's own words, non-null EXACTLY when `provenance` is 'stand-in' */
  55:   readonly standInReason: string | null;
  56:   /** the witness's own words, non-null EXACTLY when `provenance` is 'real' */
  57:   readonly realEvidence: string | null;
  58:   readonly value: T;
  59: }
  60: 
  61: type CapabilityWitness = (value: unknown, evidence: CapabilityEvidence) => CapabilityVerdict;
  62: 
  63: /**
  64:  * CALLABILITY THROUGH THE PROTOTYPE CHAIN, never own-property presence. `ControlledClock` is a
  65:  * class and `advance` is a method on its prototype, so `Object.hasOwn(clock, 'advance')` is FALSE
  66:  * for the very object the harness builds — an own-property witness would refuse today's clock on
  67:  * its first run. Plain property access walks the chain; `typeof` is what asks the real question,
  68:  * which is whether the seam can be CALLED.
  69:  */
  70: function callable(value: unknown, ...path: readonly string[]): boolean {
  71:   let cursor: unknown = value;
  72:   for (const step of path) {
  73:     if (cursor === null || (typeof cursor !== 'object' && typeof cursor !== 'function')) return false;
  74:     cursor = (cursor as Record<string, unknown>)[step];
  75:   }
  76:   return typeof cursor === 'function';
  77: }
  78: 
  79: const REFUSAL_DOCTRINE =
  80:   'Finding no stand-in seam is not evidence of real backing — a witness that cannot classify a value refuses it.';
  81: 
  82: /**
  83:  * THE THREE NAME-SCOPED DECLARATIONS, said plainly instead of dressed up as checks.
  84:  *
  85:  * `config.registry`, `sentinels.planted` and `faults.injection` inspect nothing about their value,
  86:  * and that is honest rather than lazy: the thing each of them would be a stand-in FOR does not
  87:  * exist anywhere else. `atconfig.ts` IS the registry of pinned values; the marker store IS the
  88:  * article; the fault router IS the article. `stubbedCapabilities()` reports what the HARNESS
  89:  * substituted, and nothing here is substituted — marking them stand-in would tell an
  90:  * integration-tier run the gate is grading a substitute, which is a lie in the other direction, and
  91:  * would bar this identical machinery from the tier that is the closing gate.
  92:  *
  93:  * Writing them as a shape test would make them look like measurements. They are decisions about a
  94:  * name, they are scoped to that name, and a reader is entitled to know which of the two they are.
  95:  */
  96: function theArticleItself(what: string): CapabilityWitness {
  97:   return () => ({
  98:     kind: 'real',
  99:     evidence: `${what} — the article itself, so there is nothing here for it to be a substitute for`,
 100:   });
 101: }
 102: 
 103: /**
 104:  * THE LEGAL BRANDS ON EACH AXIS OF THE ORACLE'S EVIDENCE, ENUMERATED AT RUNTIME.
 105:  *
 106:  * The oracle witness used to accept BY ABSENCE on both axes: anything that was not `loop` counted
 107:  * as above loop, and anything that was not `replay-fs` counted as a transport worth a `real`
 108:  * verdict. That is "I found no forbidden thing, therefore the thing is present" — the sentence this
 109:  * file's own header forbids, on the only witness here whose `real` verdict is DERIVED. The three
 110:  * `theArticleItself` rows return `real` too, and on every run, but unconditionally and from a
 111:  * decision about the name; this is the one witness that reaches `real` by reasoning about evidence,
 112:  * so it is the only place that reasoning can be wrong. A
 113:  * `{ tier: 'integration', transport: 'bogus' }` construction came back `real` with confident-sounding
 114:  * evidence for a brand nobody had ever heard of.
 115:  *
 116:  * SOURCE OF TRUTH FOR EACH LIST, so a future divergence is findable:
 117:  *   tiers      — `Tier` in `registry.ts`
 118:  *   transports — `TransportKind` in `oracles.ts`
 119:  *
 120:  * These are deliberately NOT imported as types. `oracles.ts` imports this file, so importing back
 121:  * would add a cycle — and a compile-time union cannot constrain a runtime string anyway, which is
 122:  * the whole reason this check has to exist at all: `CapabilityEvidence.tier` and `.transport` are
 123:  * plain `string`, because the evidence arrives from a caller.
 124:  */
 125: const LEGAL_TIERS: readonly string[] = ['loop', 'integration', 'drill'];
 126: const LEGAL_TRANSPORTS: readonly string[] = ['replay-fs', 'live', 'fake'];
 127: 
 128: /**
 129:  * THE TABLE IS CLOSED: six exact names, no prefixes and no wildcards.
 130:  *
 131:  * A prefix rule (`sut.*` had one) means nobody ever decided about the names it swallows, which is
 132:  * an unlimited namespace inside a table whose whole claim is that it is closed. The two families
 133:  * that used to need one — `fixtures.worlds` and every `sut.<key>` — are off this table entirely and
 134:  * built through `adapterDerivedCapability()` below, so nothing looks a SUT name up and there is no
 135:  * typo surface left to guard.
 136:  */
 137: const WITNESSES = new Map<string, CapabilityWitness>([
 138:   [
 139:     'clock.controlled',
 140:     (value) => {
 141:       // The harness's `Clock` contract IS the control seam: freezeAt + advance. A capability that
 142:       // can be COMMANDED to jump forward is not the passage of time.
 143:       if (callable(value, 'freezeAt') && callable(value, 'advance')) {
 144:         return {
 145:           kind: 'stand-in',
 146:           reason:
 147:             'the value exposes the Clock control seam (freezeAt/advance) — time that can be commanded to jump ' +
 148:             'forward is not the passage of time',
 149:         };
 150:       }
 151:       throw new Error(
 152:         'refusing to construct capability "clock.controlled": its value exposes no callable Clock control seam ' +
 153:           `(freezeAt/advance), and this tree holds no attested real clock backing to record in its place. ${REFUSAL_DOCTRINE}`,
 154:       );
 155:     },
 156:   ],
 157:   [
 158:     'vendors.email',
 159:     (value) => {
 160:       // ONE LEVEL DOWN: the registered value is the `Vendors` wrapper `{ email: <sim> }`, so the
 161:       // seam to read is `email.rejectNext` / `email.attempts`, never `rejectNext` on the wrapper.
 162:       // A provider that can be told to reject the next N sends, and that hands back every attempt
 163:       // that reached its seam, is a simulator.
 164:       if (callable(value, 'email', 'rejectNext') && callable(value, 'email', 'attempts')) {
 165:         return {
 166:           kind: 'stand-in',
 167:           reason:
 168:             'the value exposes the EmailProviderSim control seam (email.rejectNext/email.attempts) — a provider ' +
 169:             'that can be told to reject the next N sends, and that hands back every attempt, is a simulator',
 170:         };
 171:       }
 172:       throw new Error(
 173:         'refusing to construct capability "vendors.email": its value exposes no callable EmailProviderSim control ' +
 174:           `seam (email.rejectNext/email.attempts), and this tree holds no attested real provider to record in its ` +
 175:           `place. ${REFUSAL_DOCTRINE}`,
 176:       );
 177:     },
 178:   ],
 179:   ['config.registry', theArticleItself('atconfig.ts IS the registry of pinned values')],
 180:   ['sentinels.planted', theArticleItself('the marker store IS the planting machinery')],
 181:   ['faults.injection', theArticleItself('the fault router IS the injection machinery')],
 182:   [
 183:     'oracles.judge',
 184:     // DERIVED FROM THE TIER AND THE TRANSPORT BRAND, which is where this doctrine was already
 185:     // working one layer down before it was carried up here. `oracles.ts` refuses both mismatched
 186:     // combinations at the point it builds the transport; this witness reaches the same judgement
 187:     // from the evidence handed over, and refuses the same two combinations rather than trusting
 188:     // that the caller already did.
 189:     (_value, evidence) => {
 190:       const { tier, transport } = evidence;
 191:       if (tier === undefined || transport === undefined) {
 192:         throw new Error(
 193:           'refusing to construct capability "oracles.judge": its provenance is derived from the running tier and ' +
 194:             'the judge transport\'s kind brand, and this construction supplied ' +
 195:             `${tier === undefined ? 'no tier' : `tier ${JSON.stringify(tier)}`} and ` +
 196:             `${transport === undefined ? 'no transport kind' : `transport ${JSON.stringify(transport)}`}. ` +
 197:             `${REFUSAL_DOCTRINE}`,
 198:         );
 199:       }
 200:       // ENUMERATE BEFORE ANY RULE IS APPLIED. Every rule below reads a brand it recognises; a value
 201:       // neither list contains is unclassifiable, and unclassifiable refuses rather than falling
 202:       // through to whichever branch happens to catch it.
 203:       if (!LEGAL_TIERS.includes(tier)) {
 204:         throw new Error(
 205:           `refusing to construct capability "oracles.judge": the TIER axis was given ${JSON.stringify(tier)}, which is ` +
 206:             `not a brand this witness recognises. The legal tiers are ${LEGAL_TIERS.join(', ')}. ${REFUSAL_DOCTRINE}`,
 207:         );
 208:       }
 209:       if (!LEGAL_TRANSPORTS.includes(transport)) {
 210:         throw new Error(
 211:           `refusing to construct capability "oracles.judge": the TRANSPORT axis was given ${JSON.stringify(transport)}, ` +
 212:             `which is not a brand this witness recognises. The legal transports are ${LEGAL_TRANSPORTS.join(', ')}. ` +
 213:             `${REFUSAL_DOCTRINE}`,
 214:         );
 215:       }
 216:       if (tier === 'loop') {
 217:         if (transport === 'live') {
 218:           throw new Error(
 219:             'refusing to construct capability "oracles.judge": a loop-tier oracle on a live transport would report ' +
 220:               "today's answer under yesterday's expectations while the ledger still called it a stand-in.",
 221:           );
 222:         }
 223:         return {
 224:           kind: 'stand-in',
 225:           reason: `the loop tier judges through a ${transport} transport rather than the live judge`,
 226:         };
 227:       }
 228:       if (transport === 'replay-fs') {
 229:         throw new Error(
 230:           `refusing to construct capability "oracles.judge": a ${tier}-tier oracle on a filesystem replay transport ` +
 231:             'would be a real capability answering from committed bytes while reporting that it stubbed nothing.',
 232:         );
 233:       }
 234:       return {
 235:         kind: 'real',
 236:         evidence: `the ${tier} tier judges through a ${transport} transport, and no filesystem replay is permitted here`,
 237:       };
 238:     },
 239:   ],
 240: ]);
 241: 
 242: function sealed<T>(name: string, verdict: CapabilityVerdict, value: T): Capability<T> {
 243:   return Object.freeze({
 244:     [CAPABILITY]: true as const,
 245:     name,
 246:     provenance: verdict.kind,
 247:     standInReason: verdict.kind === 'stand-in' ? verdict.reason : null,
 248:     realEvidence: verdict.kind === 'real' ? verdict.evidence : null,
 249:     value,
 250:   });
 251: }
 252: 
 253: /**
 254:  * The one constructor. The verdict comes from the witness registered for `name`; an unregistered
 255:  * name is refused, and a witness that cannot classify the value throws through this call.
 256:  */
 257: export function witnessedCapability<T>(name: string, value: T, evidence: CapabilityEvidence = {}): Capability<T> {
 258:   if (!name.trim()) throw new Error('a capability requires a non-empty name');
 259:   const witness = WITNESSES.get(name);
 260:   if (witness === undefined) {
 261:     throw new Error(
 262:       `refusing to construct capability ${JSON.stringify(name)}: no witness is registered for that name. The ` +
 263:         `witness table is CLOSED — ${[...WITNESSES.keys()].sort().join(', ')} — so a name nobody has decided ` +
 264:         `about is an error here rather than a default in either direction.`,
 265:     );
 266:   }
 267:   return sealed(name, witness(value, evidence), value);
 268: }
 269: 
 270: /**
 271:  * THE NAMES THIS ROUTE MAY BUILD: `fixtures.worlds` exactly, and every `sut.<key>`.
 272:  *
 273:  * `index.ts` composes the SUT names — `Object.entries(adapter.sut)` behind its own `sut.` literal —
 274:  * and strips the same prefix back off in `createHarness()`. This copy of the literal is the
 275:  * ADMISSION CHECK for the route, not a second place the name is built, and the two must stay in
 276:  * step: a change to the prefix there without a change here would refuse every SUT capability at
 277:  * construction, loudly and on the first run.
 278:  */
 279: const ADAPTER_DERIVED_EXACT = 'fixtures.worlds';
 280: const ADAPTER_DERIVED_PREFIX = 'sut.';
 281: 
 282: /**
 283:  * THE ADAPTER-DERIVED ROUTE, for the two families whose provenance comes from where the module was
 284:  * loaded rather than from anything about the value: `fixtures.worlds` and every `sut.<key>`.
 285:  *
 286:  * It returns stand-in UNCONDITIONALLY, and that is deliberate. `adapterUrl()` in `index.ts` has
 287:  * exactly one possible output today, so a route that BRANCHED on the URL would be a constant
 288:  * dressed as a check — the same dishonesty this file exists to remove. The URL is the CONTENT of
 289:  * the reason, so the ledger names the module really imported; it is not the condition of a test.
 290:  *
 291:  * ON THE URL, STATED AS IT ACTUALLY IS. Through the one route the harness uses, it is loader-derived:
 292:  * `loadAdapter()` computes it from REPO_ROOT plus the requirement and hands it back, and no caller
 293:  * passes a path in. THE SIGNATURE DOES NOT ENFORCE THAT — this parameter is a plain string and any
 294:  * caller may supply any non-empty one. What bounds it is that every outcome here is stand-in: a
 295:  * fabricated URL ADDS a name to the ledger `registry.ts` refuses above loop, so it can only make the
 296:  * closing gate stricter. The failure direction is a false RED, never a false green.
 297:  *
 298:  * THE TWO ROUTES PARTITION THE NAMESPACE, and the check below is what makes that true rather than
 299:  * merely intended. Before it, `adapterDerivedCapability('clock.controlled', strippedClock, url)`
 300:  * minted a stand-in for a name the closed witness table would have REFUSED — routing around the
 301:  * table through a door the table does not watch. So this route refuses any name the table knows, and
 302:  * refuses any name outside its own two families.
 303:  *
 304:  * THIS IS NOT THE PREFIX RULE THAT WAS REMOVED FROM THE WITNESS TABLE, and the difference is the
 305:  * whole justification. There, a `sut.*` prefix matched a name into a table that GRANTS A VERDICT, so
 306:  * a verdict was handed to a name nobody had decided about — an unlimited namespace inside a table
 307:  * whose claim was that it was closed. Here the verdict is unconditional stand-in whatever the name
 308:  * is, so matching the prefix grants nothing at all; it only restricts WHICH NAMES MAY USE THIS
 309:  * ROUTE. A prefix that decides an outcome is a hole; a prefix that decides admission is a partition.
 310:  */
 311: export function adapterDerivedCapability<T>(name: string, value: T, moduleUrl: string): Capability<T> {
 312:   if (!name.trim()) throw new Error('a capability requires a non-empty name');
 313:   if (WITNESSES.has(name)) {
 314:     throw new Error(
 315:       `refusing to construct capability ${JSON.stringify(name)} on the adapter-derived route: a witness is registered ` +
 316:         'for that name, and this route would stamp it stand-in without ever asking that witness — including for a ' +
 317:         'value the witness would have REFUSED. The two routes partition the capability namespace; they do not overlap.',
 318:     );
 319:   }
 320:   if (name !== ADAPTER_DERIVED_EXACT && !(name.startsWith(ADAPTER_DERIVED_PREFIX) && name.length > ADAPTER_DERIVED_PREFIX.length)) {
 321:     throw new Error(
 322:       `refusing to construct capability ${JSON.stringify(name)} on the adapter-derived route: this route builds ` +
 323:         `${ADAPTER_DERIVED_EXACT} and every ${ADAPTER_DERIVED_PREFIX}<key> the fixture adapter exports, and nothing ` +
 324:         'else. A name outside both families belongs on the witness table, where something decides about it.',
 325:     );
 326:   }
 327:   if (!moduleUrl.trim()) {
 328:     throw new Error(
 329:       `refusing to construct capability ${JSON.stringify(name)} on the adapter-derived route with no module URL: ` +
 330:         'the URL is the whole content of the reason, so an empty one would put a stand-in on the ledger that ' +
 331:         'cannot say which module it came from.',
 332:     );
 333:   }
 334:   return sealed(name, { kind: 'stand-in', reason: `loaded from the fixture adapter at ${moduleUrl}` }, value);
 335: }
 336: 
 337: export function stubbedCapabilityNames(capabilities: readonly Capability<unknown>[]): string[] {
 338:   return capabilities
 339:     .filter((entry) => entry[CAPABILITY] === true && entry.provenance === 'stand-in')
 340:     .map((entry) => entry.name)
 341:     .sort();
 342: }
 343: 
 344: export class CapabilityPending extends Error {
 345:   constructor(readonly capabilities: readonly string[]) {
 346:     super(`CAPABILITY PENDING — ${capabilities.join(', ')}`);
 347:     this.name = 'CapabilityPending';
 348:   }
 349: }
 350: 
 351: /** A typed seam for later slices. Any attempted use fails with the capability names, never a no-op. */
 352: export function pendingCapability<T extends object>(...capabilities: string[]): T {
 353:   const names = [...new Set(capabilities)];
 354:   return new Proxy(
 355:     {},
 356:     {
 357:       get() {
 358:         throw new CapabilityPending(names);
 359:       },
 360:     },
 361:   ) as T;
 362: }
===== tests/at/harness/suite-adapters.ts =====
   1: /**
   2:  * WHICH SUITES EXIST, AND WHAT EACH ONE'S ADAPTER REALLY PRODUCES — stated once, and checked.
   3:  *
