 275:     const existing = state.byEmail.get(email);
 276:     if (existing) throw new Error(`fixture: ${email} is already registered — Supabase Auth would refuse this`);
 277: 
 278:     // VENDOR MIRRORS 1 AND 4, and the header names what binds each. An email/password registration
 279:     // starts UNCONFIRMED and Auth emails a confirmation link; a registration a provider vouched for
 280:     // starts CONFIRMED and no confirmation email is sent, so it has no link. The provider half is
 281:     // declared UNBOUND in the header — no OAuth credential exists here — and nothing in this suite
