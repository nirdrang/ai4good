 328: 
 329: type CatcherKind = 'mailpit' | 'inbucket' | 'unknown';
 330: 
 331: /**
 332:  * WHICH MAIL CATCHER IS BEHIND PORT 54324, established by asking it rather than by remembering.
 333:  *
 334:  * The Supabase CLI has shipped Inbucket and, more recently, Mailpit, and their APIs are not the
 335:  * same shape. The plan's risk 2 is exactly this. So both are probed, BOTH ANSWERS GO IN THE
 336:  * TRANSCRIPT, and the extraction below branches on what actually replied. An assumption here would
 337:  * fail as "no confirmation email arrived", which is indistinguishable from the mailer being
 338:  * rate-limited — the single most misleading way this script could go wrong.
 339:  */
 340: async function discoverMailCatcher(): Promise<{ kind: CatcherKind; evidence: string }> {
 341:   const probe = async (path: string): Promise<string> => {
 342:     try {
 343:       const response = await fetch(`${MAIL_URL}${path}`);
 344:       const text = (await response.text()).slice(0, 200);
 345:       return `GET ${path} -> HTTP ${response.status} ${JSON.stringify(text)}`;
 346:     } catch (error) {
 347:       return `GET ${path} -> unreachable (${error instanceof Error ? error.message : String(error)})`;
 348:     }
 349:   };
 350: 
 351:   const mailpit = await probe('/api/v1/info');
 352:   const inbucket = await probe('/api/v1/mailbox/probe');
 353:   const evidence = `catcher at ${MAIL_URL} · ${mailpit} · ${inbucket}`;
 354: 
 355:   if (/HTTP 200/.test(mailpit)) return { kind: 'mailpit', evidence };
 356:   if (/HTTP 200/.test(inbucket)) return { kind: 'inbucket', evidence };
 357:   return { kind: 'unknown', evidence };
 358: }
 359: 
 360: const catcher = await discoverMailCatcher();
 361: console.log(`\nmail catcher shape, measured: ${catcher.kind}\n        ${catcher.evidence}\n`);
 362: 
 363: /**
 364:  * Every URL in the message that looks like GoTrue's verify endpoint.
 365:  *
 366:  * `&amp;` IS DECODED FIRST, and that is not cosmetic: the confirmation email's HTML part escapes
 367:  * the ampersands, so a link lifted straight out of it carries `&amp;type=signup` and GoTrue reads
 368:  * the parameter name as `amp;type`. The failure looks like a rejected link rather than like a
 369:  * mangled one.
 370:  */
 371: function verifyLinksIn(text: string): string[] {
 372:   const decoded = text.replace(/&amp;/g, '&');
 373:   return decoded.match(/https?:\/\/[^\s"'<>)\]]+\/auth\/v1\/verify[^\s"'<>)\]]*/g) ?? [];
 374: }
 375: 
 376: async function emailedVerificationLink(email: string): Promise<{ link: string | null; evidence: string }> {
 377:   const local = email.split('@')[0];
 378:   try {
 379:     if (catcher.kind === 'mailpit') {
 380:       const list = await fetch(`${MAIL_URL}/api/v1/search?query=${encodeURIComponent(`to:${email}`)}&limit=20`);
 381:       const listed = (await list.json()) as { messages?: Array<{ ID?: string }> };
 382:       const id = listed.messages?.[0]?.ID;
 383:       if (!id) return { link: null, evidence: `mailpit search for ${email} returned no message` };
 384:       const message = await fetch(`${MAIL_URL}/api/v1/message/${id}`);
 385:       const parsed = (await message.json()) as { Text?: string; HTML?: string };
 386:       const links = verifyLinksIn(`${parsed.Text ?? ''}\n${parsed.HTML ?? ''}`);
 387:       return {
 388:         link: links[0] ?? null,
 389:         evidence: `mailpit held ${listed.messages?.length ?? 0} message(s) for ${email}; ${links.length} verify link(s) found`,
 390:       };
 391:     }
 392:     if (catcher.kind === 'inbucket') {
 393:       const list = await fetch(`${MAIL_URL}/api/v1/mailbox/${encodeURIComponent(local)}`);
 394:       const listed = (await list.json()) as Array<{ id?: string }>;
 395:       const id = listed[0]?.id;
 396:       if (!id) return { link: null, evidence: `inbucket mailbox ${local} was empty` };
 397:       const message = await fetch(`${MAIL_URL}/api/v1/mailbox/${encodeURIComponent(local)}/${id}`);
 398:       const parsed = (await message.json()) as { body?: { text?: string; html?: string } };
 399:       const links = verifyLinksIn(`${parsed.body?.text ?? ''}\n${parsed.body?.html ?? ''}`);
 400:       return {
 401:         link: links[0] ?? null,
 402:         evidence: `inbucket mailbox ${local} held ${listed.length} message(s); ${links.length} verify link(s) found`,
 403:       };
 404:     }
 405:     return { link: null, evidence: `the catcher at ${MAIL_URL} matched no known API shape` };
 406:   } catch (error) {
 407:     return { link: null, evidence: `reading the catcher failed: ${error instanceof Error ? error.message : String(error)}` };
 408:   }
 409: }
 410: 
 411: /**
 412:  * THE FALLBACK THE PLAN'S RISK 2 PRE-AUTHORIZES, and it NARROWS the claim rather than rescuing it.
 413:  *
 414:  * GoTrue's admin endpoint mints a verification link with operator authority. If the catcher cannot
 415:  * yield the emailed link, this is what gets followed — and the transcript then says, in the check's
 416:  * own note, that the link followed was NOT the emailed one. That is a smaller claim, stated as a
 417:  * smaller claim. It is never used when the catcher works.
 418:  */
 419: async function adminGeneratedLink(email: string): Promise<{ link: string | null; evidence: string }> {
 420:   const wire = await authPost('/auth/v1/admin/generate_link', { type: 'signup', email, password: PASSWORD }, SECRET_KEY);
 421:   const link = (wire.body as { action_link?: string } | null)?.action_link ?? null;
 422:   return {
 423:     link: typeof link === 'string' && link !== '' ? link : null,
 424:     evidence: `admin generate_link -> HTTP ${wire.status} (action_link ${link ? 'present' : 'absent'})`,
 425:   };
 426: }
 427: 
 428: /* ============================================================================================
 429:  * THE VERIFICATION ROUND TRIP — (a) through (d), as one function so the SECOND address in (e)
 430:  * repeats exactly the same measurement rather than an abbreviated version of it.
 431:  * ============================================================================================ */
 432: 
 433: type RoundTrip = {
 434:   email: string;
 435:   userId: string;
 436:   idFrom: 'response' | 'database';
 437:   signupWire: Wire;
 438:   /** the whole point of (a): with confirmations on there must be NO token in the signup answer */
 439:   signupCarriedSession: boolean;
 440:   confirmedBefore: string | null;
 441:   linkSource: 'emailed' | 'admin-generated' | 'none';
 442:   linkEvidence: string;
 443:   signInBefore: Wire;
 444:   followStatus: number;
 445:   followLocation: string;
 446:   confirmedAfter: string | null;
 447:   signInAfter: Wire;
 448:   accessToken: string | null;
 449:   rawUserWire: Wire;
 450:   shippedVerdict: boolean;
 451: };
 452: 
 453: async function verificationRoundTrip(email: string): Promise<RoundTrip> {
 454:   const { wire: signupWire, userId, idFrom } = await signUp(email);
 455:   const signupBody = signupWire.body as { access_token?: unknown; session?: unknown } | null;
 456:   const signupCarriedSession =
 457:     typeof signupBody?.access_token === 'string' || (signupBody?.session !== null && signupBody?.session !== undefined);
 458: 
 459:   const confirmedBefore = await confirmedAt(userId);
 460: 
 461:   // (c) is measured BEFORE the link is followed, because afterwards the same call succeeds and the
 462:   // refusal would be unobtainable.
 463:   const signInBefore = (await signIn(email)).wire;
 464: 
 465:   const fromCatcher = await emailedVerificationLink(email);
 466:   let link = fromCatcher.link;
 467:   let linkSource: RoundTrip['linkSource'] = link ? 'emailed' : 'none';
 468:   let linkEvidence = fromCatcher.evidence;
 469:   if (!link) {
 470:     const fallback = await adminGeneratedLink(email);
 471:     if (fallback.link) {
 472:       link = fallback.link;
 473:       linkSource = 'admin-generated';
 474:     }
 475:     linkEvidence = `${fromCatcher.evidence} · FALLBACK: ${fallback.evidence}`;
 476:   }
 477: 
 478:   let followStatus = 0;
 479:   let followLocation = '';
 480:   if (link) {
 481:     const followed = await fetch(link, { redirect: 'manual' });
 482:     followStatus = followed.status;
 483:     // THE FRAGMENT IS CUT. GoTrue redirects to the site URL with the freshly minted access token in
 484:     // the URL fragment, and this string goes into a file that gets pushed.
 485:     followLocation = withoutFragment(followed.headers.get('location') ?? '');
 486:   }
 487: 
 488:   const confirmedAfter = await confirmedAt(userId);
 489:   const after = await signIn(email);
 490:   const rawUserWire: Wire = after.accessToken
 491:     ? await (async () => {
 492:         const response = await fetch(`${API_URL}/auth/v1/user`, {
 493:           headers: { apikey: PUBLIC_KEY, Authorization: `Bearer ${after.accessToken}` },
 494:         });
 495:         const text = await response.text();
 496:         let parsed: unknown = text;
 497:         try {
 498:           parsed = JSON.parse(text);
 499:         } catch {
 500:           /* kept raw */
 501:         }
 502:         return { status: response.status, body: parsed };
 503:       })()
 504:     : { status: 0, body: null };
 505: 
 506:   return {
 507:     email,
 508:     userId,
 509:     idFrom,
 510:     signupWire,
 511:     signupCarriedSession,
 512:     confirmedBefore,
 513:     linkSource,
 514:     linkEvidence,
 515:     signInBefore,
 516:     followStatus,
 517:     followLocation,
 518:     confirmedAfter,
 519:     signInAfter: after.wire,
 520:     accessToken: after.accessToken,

