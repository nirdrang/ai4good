@@ -183,121 +183,136 @@ enable_anonymous_sign_ins = false
 # Google (no GitHub identity yet) … linking completes signup": that link is Auth's `linkIdentity`
 # call, and GoTrue REFUSES it outright while this flag is false. With the flag false the flow the
 # criterion describes could not exist at all.
 #
 # WHAT THIS PROVES: the configuration is well-formed and the stack starts with it. WHAT IT DOES NOT:
 # that any `linkIdentity` round trip works — that is a browser flow with a consent screen in it, and
 # it is named unproved in this item's per-id table.
 #
 # SEEN AND DELIBERATELY NOT GUARDED: the same flag also opens Auth's UNLINK surface, so a volunteer
 # who linked GitHub could later unlink it while their account and imported profile remain. No
 # acceptance id in AT-REQ-001 addresses post-signup identity lifecycle, and the file records the
 # omission as deliberate — AT-001.08 is retired with "the PRD defines no identity-collision/linking
 # policy". Guarding it here would be shipped behaviour no ratified text asks for, so the product
 # question is filed for its own board item instead. Nothing this item ships calls unlink.
 enable_manual_linking = true
 # Passwords shorter than this value will be rejected as weak. Minimum 6, recommended 8 or more.
 minimum_password_length = 6
 # Passwords that do not meet the following requirements will be rejected as weak. Supported values
 # are: `letters_digits`, `lower_upper_letters_digits`, `lower_upper_letters_digits_symbols`
