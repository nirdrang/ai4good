  16:  * `tests/at/suites/req-016/_fixture.ts` says so about itself in its own opening paragraph. Putting
  17:  * the judgements here and importing them from both sides is what makes the loop-tier green a claim
  18:  * about product code. The adapter still supplies storage — that half is a stand-in and stays one.
  19:  *
  20:  * TWO CONSTRAINTS THIS FILE IS UNDER, and both are real rather than stylistic:
  21:  *
  22:  *   1. ZERO NON-RELATIVE IMPORTS AND NO DENO GLOBAL. It is compiled by `tests/at/tsconfig.json`,
  23:  *      which is `strict` with `skipLibCheck: false`, `types: ["node"]` and no DOM library — a bare
  24:  *      `jsr:`/`npm:` specifier or a reference to `Deno` would not resolve there. It is also run by
  25:  *      Deno inside the edge runtime, where a node-only import would not resolve either. The
  26:  *      intersection of the two is plain TypeScript over plain data, which is all a decision needs.
  27:  *   2. NO I/O, NO CLOCK, NO RANDOMNESS. Every function here is pure. Storage, time and identity are
  28:  *      the caller's, so the same judgement can be replayed by a test without a database.
  29:  *
  30:  * WHICH PROGRAM ACTUALLY TYPE-CHECKS IT: the `tests/at` one, and ONLY that one. `bun run typecheck`
  31:  * runs `tsc -p` over the root project too, but that project's `include` is
  32:  * `["src/**\/*.ts", "src/**\/*.tsx", "vite.config.ts", "eslint.config.js"]`, so nothing under
  33:  * `supabase/` is in its program. This module reaches the strict acceptance program by being imported
  34:  * from `tests/at/suites/req-001/_fixture.ts`, and that import is the whole of its type coverage.
  35:  */
  36: 
  37: /* ------------------------------------------------------------------ the two closed vocabularies */
  38: 
  39: /**
  40:  * The account types the PUBLIC signup surface offers — AT-001.07's second clause, as a value rather
  41:  * than as a sentence in a document. `platform_admin` is deliberately absent: it is provisioned, not
  42:  * signed up for, and `parseAccountType` below refuses it by construction rather than by a check
  43:  * somebody has to remember to write.
  44:  */
  45: export const PUBLIC_SIGNUP_ACCOUNT_TYPES = ['ngo', 'volunteer'] as const;
  46: 
  47: export type PublicSignupAccountType = (typeof PUBLIC_SIGNUP_ACCOUNT_TYPES)[number];
  48: 
  49: /**
  50:  * Every global type an account can hold, including the one no public path can produce. This mirrors
  51:  * the `public.account_type` enum in the migration; the two are separate statements of one fact, and
  52:  * the database is the one that wins — which is exactly why `public.complete_signup` re-checks the
  53:  * type itself instead of trusting this module (see `ngoOnlyActionAllowed`'s note on defence in
  54:  * depth, and the migration's own comment).
  55:  */
  56: export const ACCOUNT_TYPES = ['ngo', 'volunteer', 'platform_admin'] as const;
  57: 
  58: export type AccountType = (typeof ACCOUNT_TYPES)[number];
  59: 
  60: /* ---------------------------------------------------------------------------- the answer shape */
  61: 
  62: /**
  63:  * A decision, and its refusal carries WHY.
  64:  *
  65:  * A bare boolean would make every refusal indistinguishable at the call site, and AT-001.04 and
  66:  * AT-001.06 both assert that a refusal STATES its reason. Returning the reason rather than throwing
  67:  * it is deliberate too: these are expected outcomes of well-formed requests, not faults, and an
  68:  * exception would invite a caller to treat "a volunteer may not do this" the same way it treats a
  69:  * dropped database connection.
  70:  */
  71: export type Decision<T> = { ok: true; value: T } | { ok: false; reason: string };
  72: 
  73: function refuse<T>(reason: string): Decision<T> {
  74:   return { ok: false, reason };
  75: }
  76: 
  77: function accept<T>(value: T): Decision<T> {
  78:   return { ok: true, value };
  79: }
  80: 
  81: /* -------------------------------------------------------------- 1. what type is being asked for */
  82: 
  83: /**
  84:  * The requested account type, or a refusal naming why — and `platform_admin` can never come out of
  85:  * it, however it is spelled in the request.
  86:  *
  87:  * This is the only thing between an anonymous HTTP request and a minted platform administrator on
  88:  * the TypeScript side of the write path, which is why the database refuses the same value again
  89:  * (see the migration's `complete_signup`). One of the two being deleted or regressed must not be
  90:  * enough.
  91:  */
  92: export function parseAccountType(raw: unknown): Decision<PublicSignupAccountType> {
  93:   if (typeof raw !== 'string' || raw.trim() === '') {
  94:     return refuse(
  95:       `account type is required and must be one of ${PUBLIC_SIGNUP_ACCOUNT_TYPES.join(', ')}`,
  96:     );
  97:   }
  98:   const candidate = raw.trim();
  99:   if ((PUBLIC_SIGNUP_ACCOUNT_TYPES as readonly string[]).includes(candidate)) {
 100:     return accept(candidate as PublicSignupAccountType);
 101:   }
 102:   // Named separately from an outright unknown string, because the two are different mistakes and a
 103:   // caller that sees "unknown account type platform_admin" learns the wrong thing: the type is not
 104:   // unknown, it is not available here.
 105:   if (candidate === 'platform_admin') {
 106:     return refuse(
 107:       'platform_admin is not available through public signup — a platform administrator is provisioned, never self-signed-up',
 108:     );
 109:   }
 110:   return refuse(
 111:     `unknown account type ${JSON.stringify(candidate)} — public signup offers ${PUBLIC_SIGNUP_ACCOUNT_TYPES.join(', ')}`,
 112:   );
 113: }
 114: 
 115: /* ------------------------------------------------------ 2. is this completion request well-formed */
