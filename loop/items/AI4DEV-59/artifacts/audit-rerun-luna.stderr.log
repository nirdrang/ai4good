 141: export type SignInOutcome = { ok: true; session: Session } | { ok: false; reason: string };
 142: 
 143: export type CompleteSignupOutcome =
 144:   | { ok: true; accountId: string; organizationId: string | null }
 145:   | { ok: false; reason: string };
 146: 
 147: export type CreateOrganizationOutcome = { ok: true; organizationId: string } | { ok: false; reason: string };
 148: 
 149: /**
 150:  * The outcome of an attempted Discovery message â€” and the refusal carries WHY, for the reason
 151:  * `Decision` in the shipped module gives: AT-001.10 asserts that the block NAMES verification as
 152:  * the remedy, so a bare boolean would make the criterion untestable.
 153:  */
 154: export type SendDiscoveryMessageOutcome = { ok: true } | { ok: false; reason: string };
 155: 
 156: /* ------------------------------------------------------------------------------------ the SUT */
 157: 
 158: /**
 159:  * REQ-001's accounts system under test.
 160:  *
 161:  * The split is the point, and there are now FOUR kinds of member here rather than three:
 162:  *
 163:  *   1. THE TWO PRODUCT OPERATIONS â€” `completeSignup` and `createOrganization`. At loop tier the
 164:  *      adapter runs them over its own storage but delegates every judgement to
 165:  *      `supabase/functions/_shared/accounts.ts`, the module the edge functions import; at
 166:  *      integration tier they would be the deployed edge functions.
 167:  *   2. SUPABASE AUTH'S HALF â€” registration, sign-in, identity linking, and the verification state
 168:  *      (`emailVerified`, `emailedVerificationLink`, `useVerificationLink`). None of it is this
 169:  *      requirement's code. It is what produces the states the product operations judge.
 170:  *   3. READ-BACK â€” the row shapes an assertion reads after the fact.
 171:  *   4. ONE STAND-IN SURFACE, AND IT IS THE ONLY ONE â€” `sendDiscoveryMessage`, with
 172:  *      `discoveryMessagesBy` reading it back.
 173:  *
 174:  * THE FOURTH KIND NEEDS ITS OWN SENTENCE, because it is the one that could be misread. NO
 175:  * DISCOVERY ROUTE EXISTS IN THIS TREE. The Discovery message route is REQ-002/004's, and what
 176:  * this requirement's leaf ships is the DECISION that route must consult â€”
 177:  * `discoveryMessageAllowed` in `supabase/functions/_shared/verification.ts`. So
 178:  * `sendDiscoveryMessage` is not a deployed operation being tested; it is a stand-in surface whose
 179:  * only job is to put the shipped decision on a tested path, exactly as
 180:  * `hasPlatformAcknowledgment` below is the hook a project-creation leaf must call. A green over
 181:  * it says the DECISION is right. It says nothing about enforcement anywhere, because there is
 182:  * nowhere yet to enforce it.
 183:  */
 184: export type AccountsSut = {
 185:   /** AT-001.07's second clause: which types the PUBLIC signup surface offers. */
 186:   publicSignupAccountTypes(): Promise<readonly string[]>;
 187: 
 188:   /* --- Supabase Auth's half. Not this leaf's code; it is what produces a session to complete. --- */
 189: 
 190:   /**
 191:    * Register an auth user with an email and a password, and return the resulting session.
 192:    *
 193:    * IT STILL RETURNS A SESSION, AND THE HONEST GAP THAT LEAVES IS STATED HERE RATHER THAN HIDDEN.
 194:    * With `enable_confirmations = true` the live GoTrue issues NO session at signup, so on the real
 195:    * stack a completed-but-unverified account is not reachable by the public path. This fixture's
 196:    * `Session` has always been an identity handle rather than an access token, and session ISSUANCE
 197:    * is D2.L2's subject (AT-001.12, .13 â€” declared red). So at the loop tier such an account IS
 198:    * constructible, and AT-001.10's body constructs one deliberately: the gate exists because
 199:    * decision-8 makes verification the write path's own floor, not a property borrowed from the
 200:    * session layer. The live-stack behaviour is measured in `loop/items/AI4DEV-59/proof-local.ts`
 201:    * checks (a) and (c), and nowhere else in this item.
 202:    */
 203:   registerWithEmailPassword(email: string, password: string): Promise<Session>;
 204:   /**
 205:    * A session Auth recorded as having come from an external provider.
 206:    *
 207:    * It performs NO handshake and fabricates no authorization code or token exchange: it is the state
 208:    * Auth is in AFTER a consent round trip, which is the only part of the story any agent can reach.
 209:    */
 210:   registerWithProvider(provider: SessionProvider, email: string): Promise<Session>;
 211:   /**
 212:    * A GitHub OAuth signup, as Auth records it: a session established by GitHub whose account already
 213:    * carries the linked GitHub identity â€” AT-001.02's "signs up via GitHub OAuth".
 214:    *
 215:    * Like `registerWithProvider` it performs NO handshake. It is `registerWithProvider('github', â€¦)`
 216:    * plus the fact that a GitHub signup necessarily links the GitHub identity it signed up with, and
 217:    * it is a separate member rather than an argument because that second half is what AT-001.02's
 218:    * "the GitHub identity is linked to it" clause is about.
 219:    */
 220:   registerWithGithub(email: string, githubHandle: string): Promise<Session>;
 221:   /**
 222:    * The state Auth is in after a `linkIdentity` round trip â€” AT-001.04's "linking completes signup".
 223:    *
 224:    * A LINKED IDENTITY IS NOT THE ESTABLISHING PROVIDER, and keeping the two apart is the point of
 225:    * this member existing at all: an email- or Google-established volunteer links GitHub and their
 226:    * session's `provider` does not change. The gate in
 227:    * `supabase/functions/_shared/accounts.ts` reads the link; nothing shipped reads the provider.
 228:    *
 229:    * Same posture as every other Auth member here â€” no handshake, no fabricated authorization code.
 230:    */
 231:   linkGithubIdentity(session: Session, githubHandle: string): Promise<void>;
 232:   /** Return sign-in with the same credentials â€” AT-001.01's final clause. */
 233:   signInWithEmailPassword(email: string, password: string): Promise<SignInOutcome>;
 234:   /**
 235:    * The return visit through an external provider â€” AT-001.02's "a later sign-in via GitHub returns
 236:    * to the same account".
 237:    *
 238:    * What it asserts is IDENTITY CONTINUITY, which is the half of that clause reachable without a
 239:    * person: an existing user whose account carries that provider's identity signs in to the SAME
 240:    * account rather than to a second one. The consent round trip itself is not performed and is named
 241:    * unproved in the plan's per-id table.
 242:    */
 243:   signInWithProvider(provider: SessionProvider, email: string): Promise<SignInOutcome>;
 244: 
 245:   /* ------------------------- Supabase Auth's verification state ------------------------------- */
 246: 
 247:   /**
 248:    * Whether Supabase Auth reports this account's email address confirmed â€” AT-001.09's observable.
 249:    *
 250:    * IT IS DERIVED, NOT STORED-AND-READ. The adapter renders the account's stored Auth state as the
 251:    * canonical GoTrue `/auth/v1/user` shape and judges the answer out of it with the SHIPPED
 252:    * `emailVerifiedFromUser`. That is the same pattern `completeSignup` uses for the GitHub handle
 253:    * (the GitHub leaf's gate-2 ruling R3), and it exists so the shipped extractor sits on the tested
 254:    * path rather than being a function no test ever runs â€” which is exactly how the future Discovery
 255:    * route will resolve the same fact from the same response.
 256:    *
 257:    * WHAT NO LOOP-TIER GREEN OVER IT PROVES: that the rendered shape is the shape GoTrue really
 258:    * sends. Only `loop/items/AI4DEV-59/proof-local.ts` check (d) touches that, by feeding a real
 259:    * response to the same shipped function.
 260:    */
 261:   emailVerified(accountId: string): Promise<boolean>;
 262:   /**
 263:    * The verification link emailed to this address, or `null` when none was emailed.
 264:    *
 265:    * `null` is a real answer rather than only the empty case: a provider registration is confirmed
 266:    * by the provider and no confirmation email is sent for it.
 267:    */
 268:   emailedVerificationLink(email: string): Promise<string | null>;
 269:   /**
 270:    * Use a verification link. Using the link Auth emailed for an address confirms that address; a
 271:    * link that was never issued returns `ok: false` and flips nothing.
 272:    *
 273:    * NO EXPIRY, NO SINGLE USE AND NO RESEND IS MODELLED OR ASSERTED. AT-001.11 is retired â€” the
 274:    * acceptance file's own words are that "verification-link expiry/single-use/resend semantics are
 275:    * not stated in REQ-001" â€” so building any of them here would be asserting a criterion that was
 276:    * deliberately withdrawn.
 277:    *
 278:    * THE NEVER-ISSUED NEGATIVE IS NOT AT-001.11 GROUND, and the difference is worth being exact
