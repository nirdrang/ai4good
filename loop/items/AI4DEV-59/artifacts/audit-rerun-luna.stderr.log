 262: export function createFixtureAdapter({ worlds }: AdapterOptions) {
 263:   const state: State = {
 264:     authUsers: new Map(),
 265:     byEmail: new Map(),
 266:     byVerificationLink: new Map(),
 267:     accounts: new Map(),
 268:     organizations: new Map(),
 269:     memberships: new Map(),
 270:     acknowledgments: [],
 271:     volunteerProfiles: new Map(),
 272:     discoveryMessages: new Map(),
 273:     nextId: 1,
 274:   };
 275:   const openedWorlds = new Set<AccountsFixtureWorld>();
 276:   let worldSerial = 0;
 277: 
 278:   const nextId = (prefix: string): string => `${prefix}-${state.nextId++}`;
 279: 
 280:   /**
 281:    * The instant a confirmation is recorded at.
 282:    *
 283:    * Fixed rather than read from a clock, for the same reason the acknowledgment's instant is: no
 284:    * criterion here depends on WHICH instant, only on whether one is present, and a real timestamp
 285:    * would make the capture non-deterministic for no gain. The shipped `emailVerifiedFromUser`
 286:    * judges presence and never parses the value, so this is the whole of what the field has to be.
 287:    */
 288:   const CONFIRMED_AT = '2026-01-01T00:00:00.000Z';
 289: 
 290:   const register = (
 291:     email: string,
 292:     password: string | null,
 293:     provider: SessionProvider,
 294:     githubHandle: string | null = null,
 295:     /**
 296:      * Whether the CREATOR already confirmed the address, which only an operator can do.
 297:      *
 298:      * It exists for `provisionPlatformAdmin` and for nothing else. See the header: the recipe this
 299:      * repository records creates an administrator through `POST /auth/v1/admin/users` with
 300:      * `email_confirm: true`, so that user never receives a confirmation email and never has a link.
 301:      */
 302:     confirmedByTheCreator = false,
 303:   ): Session => {
 304:     // Supabase Auth's own uniqueness, mirrored: a second registration on one address is not a new
 305:     // user. Left out, a body could accidentally create two auth users for one address and then read
 306:     // back "one account per user" from a situation the real system cannot be in.
 307:     const existing = state.byEmail.get(email);
 308:     if (existing) throw new Error(`fixture: ${email} is already registered â€” Supabase Auth would refuse this`);
 309: 
 310:     // VENDOR MIRRORS 1 AND 4, and the header names what binds each. A public email/password
 311:     // registration starts UNCONFIRMED and Auth emails a confirmation link. A registration a
 312:     // provider vouched for, and one an operator created with the address already confirmed, both
 313:     // start CONFIRMED and receive no confirmation email, so neither has a link. The provider half
 314:     // is declared UNBOUND in the header â€” no OAuth credential exists here â€” and nothing in this
 315:     // suite reads a provider user's verified state.
 316:     const id = nextId('user');
 317:     const confirmedAtCreation = provider !== 'email' || confirmedByTheCreator;
 318:     const emailConfirmedAt = confirmedAtCreation ? CONFIRMED_AT : null;
 319:     // Derived from the user id rather than from a second counter, so the link is unique by
 320:     // construction and a link read in a failure message says which user it belongs to.
 321:     const verificationLink = confirmedAtCreation ? null : `verify-${id}`;
 322: 
 323:     const user: AuthUser = { id, email, password, provider, githubHandle, emailConfirmedAt, verificationLink };
 324:     state.authUsers.set(user.id, user);
 325:     state.byEmail.set(email, user.id);
 326:     if (verificationLink !== null) state.byVerificationLink.set(verificationLink, user.id);
 327:     return { accountId: user.id, email: user.email, provider: user.provider };
 328:   };
 329: 
 330:   /**
 331:    * The stored auth state rendered as the canonical GoTrue `/auth/v1/user` response shape.
 332:    *
 333:    * ONE RENDERER FOR BOTH SHIPPED EXTRACTORS. `extractGithubHandle` reads `identities[]` and
 334:    * `emailVerifiedFromUser` reads `email_confirmed_at`, and both read them off the SAME object here
 335:    * â€” which is the point: on the live stack they read one response body, so rendering two different
 336:    * shapes for them would be a divergence this suite could never notice.
 337:    *
 338:    * WHAT IS STILL NOT PROVED by anything that calls this: that this shape is the shape GoTrue really
 339:    * sends. That is a prediction of the vendor. The live proof is what binds it.
 340:    */
 341:   const renderAuthUser = (user: AuthUser): Record<string, unknown> => ({
 342:     id: user.id,
 343:     email: user.email,
 344:     email_confirmed_at: user.emailConfirmedAt,
 345:     identities:
 346:       user.githubHandle === null
 347:         ? []
 348:         : [{ provider: 'github', identity_data: { user_name: user.githubHandle } }],
 349:   });
 350: 
 351:   /**
 352:    * Which providers can sign this user back in â€” Auth's `identities[]`, reduced to what AT-001.02
 353:    * asks about.
 354:    *
 355:    * A GitHub signup and a later GitHub LINK produce the same answer here, deliberately: after either,
 356:    * the account carries a GitHub identity, and "a later sign-in via GitHub returns to the same
 357:    * account" is a statement about the identity, not about which provider happened to create the user.
 358:    */
 359:   const reachableThroughProvider = (user: AuthUser, provider: SessionProvider): boolean =>
 360:     provider === 'github' ? user.githubHandle !== null : user.provider === provider;
 361: 
 362:   /**
 363:    * The `complete-signup` operation, at the loop tier.
 364:    *
 365:    * EVERY DECISION ON THIS PATH COMES FROM THE SHIPPED MODULE. What is left here is the four writes,
 366:    * performed together or not at all â€” which is the shape `public.complete_signup` guarantees inside
 367:    * one transaction on the real database, and which step 7 of the plan proves there.
 368:    */
 369:   const completeSignup = async (
 370:     session: Session,
 371:     request: CompleteSignupRequest,
 372:     ip: string,
 373:   ): Promise<CompleteSignupOutcome> => {
 374:     const authUser = state.authUsers.get(session.accountId);
 375:     if (!authUser) {
 376:       return { ok: false, reason: 'no authenticated user â€” sign in before completing signup' };
 377:     }
 378: 
 379:     // THE CALLER FACT COMES FROM THE STORED AUTH USER, never from the request. That is the same
 380:     // shape the edge function has, where it comes from `/auth/v1/user` â€” a client cannot assert it
 381:     // in either place, which is the whole security property of the volunteer gate.
 382:     //
 383:     // AND IT IS DERIVED, NOT READ. The stored state is rendered as the canonical GoTrue
 384:     // `/auth/v1/user` shape â€” an `identities[]` array, empty when nothing is linked â€” and the handle
 385:     // is then judged out of it by the SHIPPED `extractGithubHandle`, which is precisely what
 386:     // `resolveCaller` does with the real response. Passing `authUser.githubHandle` in directly, as
 387:     // this used to, pre-narrowed the fact and left the extractor unexecuted by any test: storage
 388:     // would have been doing a judgement's job, which is the one thing this file's opening paragraph
 389:     // promises it does not do. What is still NOT proved here is GoTrue's real serialisation â€” that
 390:     // this shape is the shape Auth sends. Only the live proof touches that.
 391:     //
 392:     // The rendering itself is `renderAuthUser` above, shared with the verified-fact read, because
 393:     // on the live stack both facts come out of ONE response body and two renderings here could
 394:     // diverge with nothing able to notice.
 395:     const callerUser = renderAuthUser(authUser);
 396:     const decision = validateCompleteSignup(request, { githubHandle: extractGithubHandle(callerUser) });
 397:     if (!decision.ok) return { ok: false, reason: decision.reason };
 398:     const { accountType, organizationName, acknowledgmentTextVersion, githubHandle } = decision.value;
 399: 
 400:     // ONE ROW PER AUTH USER is what makes "one account holds exactly one global type" structural
 401:     // rather than remembered â€” the schema states it as a primary key, and this states it as a
 402:     // refusal at the same point.
 403:     if (state.accounts.has(session.accountId)) {
 404:       return { ok: false, reason: 'this account has already completed signup â€” one account holds exactly one global type' };
 405:     }
 406: 
 407:     const account: AccountRow = { id: session.accountId, accountType };
 408:     let organization: OrganizationRow | null = null;
 409:     let membership: MembershipRow | null = null;
 410: 
 411:     if (organizationName !== null) {
 412:       organization = { id: nextId('org'), name: organizationName };
 413:       membership = { organizationId: organization.id, accountId: account.id, role: 'admin' };
 414:     }
 415: 
 416:     // THE ONBOARDING IMPORT, COMPUTED HERE AND WRITTEN BELOW WITH EVERYTHING ELSE â€” which is the
 417:     // shape `public.complete_signup` guarantees inside one transaction on the real database. There
 418:     // is no queue and no deferred job: a volunteer completion either lands the account AND the
 419:     // populated profile, or lands nothing. AT-001.05's "a queued-but-empty import fails this test"
 420:     // is unrepresentable rather than merely untested.
 421:     let volunteerProfile: VolunteerProfileRow | null = null;
 422:     if (githubHandle !== null) {
 423:       const stats = stubGithubStatsFor(githubHandle);
 424:       volunteerProfile = {
 425:         accountId: session.accountId,
 426:         githubHandle,
 427:         topLanguages: stats.topLanguages,
 428:         repositoryCount: stats.repositoryCount,
 429:         contributionSummary: stats.contributionSummary,
 430:         // Fixed rather than read from a clock, for the same reason the acknowledgment's instant is:
 431:         // nothing in these criteria depends on WHICH instant, and the live-stack proof reads the
 432:         // database's own `now()`.
 433:         importedAt: '2026-01-01T00:00:00.000Z',
 434:       };
 435:     }
 436: 
 437:     const acknowledgment: StoredAcknowledgment = {
 438:       accountId: account.id,
 439:       kind: PLATFORM_ACKNOWLEDGMENT_KIND,
 440:       // Fixed rather than read from a clock: nothing in this leaf's four criteria depends on WHICH
 441:       // instant it is, only that one is recorded, and a real timestamp would make the capture
 442:       // non-deterministic for no gain. The live-stack proof reads `now()` from the database.
 443:       acknowledgedAt: '2026-01-01T00:00:00.000Z',
 444:       ip,
 445:       textVersion: acknowledgmentTextVersion,
 446:     };
 447: 
 448:     // All of them, together. Nothing above this line has mutated `state`.
 449:     state.accounts.set(account.id, account);
 450:     if (organization) state.organizations.set(organization.id, organization);
 451:     if (membership) state.memberships.set(membershipKey(membership.organizationId, membership.accountId), membership);
 452:     if (volunteerProfile) state.volunteerProfiles.set(volunteerProfile.accountId, volunteerProfile);
 453:     state.acknowledgments.push(acknowledgment);
 454: 
 455:     return { ok: true, accountId: account.id, organizationId: organization?.id ?? null };
 456:   };
 457: 
 458:   const sut: AccountsSut = {
 459:     // Read straight off the shipped constant. A literal here would be a second statement of the same
 460:     // fact, and AT-001.07 would then be asserting what this file says rather than what ships.
 461:     publicSignupAccountTypes: async () => [...PUBLIC_SIGNUP_ACCOUNT_TYPES],
 462: 
 463:     registerWithEmailPassword: async (email, password) => register(email, password, 'email'),
 464:     registerWithProvider: async (provider, email) => register(email, null, provider),
 465:     // A GitHub signup links the GitHub identity it signed up with â€” that is what makes it a GitHub
 466:     // signup rather than a session that merely says 'github'. Both halves are recorded here in one
 467:     // step because Auth performs them in one round trip.
 468:     registerWithGithub: async (email, githubHandle) => register(email, null, 'github', githubHandle),
 469: 
 470:     linkGithubIdentity: async (session, githubHandle) => {
 471:       const user = state.authUsers.get(session.accountId);
 472:       // A throw, not a refusal: a body that links an identity onto a user Auth never registered has
 473:       // a bug in the TEST, and returning a polite outcome would let that bug read as a product
 474:       // refusal further down.
 475:       if (!user) throw new Error(`fixture: no auth user ${session.accountId} to link a GitHub identity to`);
 476:       user.githubHandle = githubHandle;
 477:     },
 478: 
 479:     signInWithEmailPassword: async (email, password): Promise<SignInOutcome> => {
 480:       const userId = state.byEmail.get(email);
 481:       const user = userId ? state.authUsers.get(userId) : undefined;
 482:       // One reason for both branches: telling "no such account" apart from "wrong password" is an
 483:       // existence oracle, and REQ-001 spends AT-001.21 forbidding exactly that shape elsewhere.
 484:       if (!user || user.password === null || user.password !== password) {
 485:         return { ok: false, reason: 'the email or password is incorrect' };
 486:       }
 487:       return { ok: true, session: { accountId: user.id, email: user.email, provider: user.provider } };
 488:     },
 489: 
 490:     signInWithProvider: async (provider, email): Promise<SignInOutcome> => {
 491:       const userId = state.byEmail.get(email);
 492:       const user = userId ? state.authUsers.get(userId) : undefined;
 493:       // One reason again, for the AT-001.21 reason above: "no such account" and "that provider is
 494:       // not linked to it" must not be distinguishable to a caller.
 495:       if (!user || !reachableThroughProvider(user, provider)) {
 496:         return { ok: false, reason: `no account of this address is reachable through ${provider}` };
 497:       }
 498:       // THE SAME ACCOUNT, which is the clause under test. The id comes from the stored user, so a
 499:       // second identity minted per sign-in would show up as a different `accountId` rather than
 500:       // being invisible.
 501:       return { ok: true, session: { accountId: user.id, email: user.email, provider } };
 502:     },
 503: 
 504:     // DERIVED THROUGH THE SHIPPED EXTRACTOR, never read off storage. `user.emailConfirmedAt` is
 505:     // rendered into the canonical `/auth/v1/user` shape and `emailVerifiedFromUser` judges it â€”
 506:     // the same R3 pattern `completeSignup` uses for the GitHub handle, and for the same reason:
 507:     // the extractor is what the future Discovery route will run, so it has to sit on the tested
 508:     // path rather than being a function no test ever executes.
 509:     emailVerified: async (accountId) => {
 510:       const user = state.authUsers.get(accountId);
 511:       // A throw, not `false`. `false` is the answer for an unverified user, so returning it here
 512:       // would make a body that read a user Auth never registered look like a correct negative â€”
 513:       // and the whole discriminating pair in AT-001.09 turns on telling those two apart.
 514:       if (!user) throw new Error(`fixture: no auth user ${accountId} whose verified state could be read`);
