 569:       const sent = state.discoveryMessages.get(session.accountId) ?? [];
 570:       sent.push(body);
 571:       state.discoveryMessages.set(session.accountId, sent);
 572:       return { ok: true };
 573:     },
 574: 
 575:     discoveryMessagesBy: async (accountId) => clone(state.discoveryMessages.get(accountId) ?? []),
 576: 
 577:     createOrganization: async (session, organizationName): Promise<CreateOrganizationOutcome> => {
 578:       const account = state.accounts.get(session.accountId);
 579:       if (!account) return { ok: false, reason: 'complete signup before creating an organisation' };
 580: 
 581:       // THE REFUSAL IS THE SHIPPED MODULE'S, not this file's. That is what makes AT-001.06 a test of
 582:       // an application boundary rather than of a helper called directly from a test body.
 583:       const allowed = ngoOnlyActionAllowed(account.accountType);
 584:       if (!allowed.ok) return { ok: false, reason: allowed.reason };
 585: 
 586:       // The name rule is the shipped module's too. It used to be spelled out here, which made this
 587:       // file hold a second copy of a rule â€” the one thing its opening paragraph promises it does
 588:       // not do.
 589:       const name = validateOrganizationName(organizationName);
 590:       if (!name.ok) return { ok: false, reason: name.reason };
 591: 
 592:       const organization: OrganizationRow = { id: nextId('org'), name: name.value };
 593:       const membership: MembershipRow = { organizationId: organization.id, accountId: account.id, role: 'admin' };
 594:       state.organizations.set(organization.id, organization);
 595:       state.memberships.set(membershipKey(organization.id, account.id), membership);
 596:       return { ok: true, organizationId: organization.id };
 597:     },
