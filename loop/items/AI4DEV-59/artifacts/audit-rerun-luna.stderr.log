 133: };
 134: 
 135: /**
 136:  * AT-001.10, as a decision: a Discovery message is permitted to a caller whose email address is
 137:  * verified, and to nobody else.
 138:  *
 139:  * THE ONLY ALLOW IS `caller?.emailVerified === true`. Strict equality against `true`, not a
 140:  * truthiness test: a caller that passed the string `"false"`, or `1`, or any other value a
 141:  * careless JSON round trip produces, must not open the gate. This is the same fail-closed posture
 142:  * `validateCompleteSignup` takes on its caller fact, for the same measured reason â€” the edge
 143:  * entry point has no type-checker, so a missing or malformed argument is a real possibility.
 144:  *
 145:  * THE REFUSAL NAMES EMAIL VERIFICATION TWICE: as what is missing, and as the remedy. AT-001.10's
 146:  * words are "the attempt is blocked with verification named as the remedy", and a 403 saying
 147:  * "forbidden" would satisfy a weaker reading of that criterion while telling the sender nothing
 148:  * about what to do next. The test body matches the reason against `/verif/i` and `/email/i`.
 149:  *
 150:  * IT IS TYPE-BLIND â€” see the module header. No account type reaches this function, because
 151:  * decision-8's floor is under EVERY Discovery message and AT-001.10's NGO is one instance of it.
 152:  *
 153:  * IT SAYS NOTHING ABOUT VETTING. Decision-8 also says vetting is "never the Discovery wall", so a
 154:  * vetting state is not a second condition hiding in here â€” verification is the whole floor, and
 155:  * adding anything beside it would be building a wall the ratified text refuses.
 156:  */
 157: export function discoveryMessageAllowed(caller: DiscoveryMessageCaller): Decision<'verified'> {
 158:   if (caller?.emailVerified === true) {
 159:     return { ok: true, value: 'verified' };
 160:   }
 161:   return {
 162:     ok: false,
 163:     reason:
 164:       'a Discovery message needs a verified email address â€” this account is email-unverified. ' +
 165:       'Use the verification link sent to the account address, then send the message again',
 166:   };
 167: }
