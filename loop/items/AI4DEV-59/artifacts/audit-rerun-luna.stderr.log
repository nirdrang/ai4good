 695:     followStatus = followed.status;
 696:     // THE FRAGMENT IS CUT AND EVERY QUERY VALUE IS REPLACED. GoTrue redirects to the site URL with
 697:     // the freshly minted access token in the URL fragment, and this string goes into a file that
 698:     // gets pushed.
