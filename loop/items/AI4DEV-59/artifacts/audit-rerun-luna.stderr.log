 130: // in the extractor â€” returning null for a linked identity â€” would have rejected every linked
 131: // volunteer at the deployed edge while this suite stayed green.
 132: import { extractGithubHandle, stubGithubStatsFor } from '../../../../supabase/functions/_shared/github.ts';
 133: // BOTH shipped verification judgements, for the same reason both GitHub ones are imported above.
 134: // `emailVerifiedFromUser` is how the verified fact is DERIVED from the rendered GoTrue user shape
 135: // on every read â€” never read straight off storage â€” and `discoveryMessageAllowed` is the ONLY thing
 136: // that decides whether a Discovery send is refused. Between them there is no rule about
 137: // verification left in this file to drift.
 138: import {
 139:   discoveryMessageAllowed,
 140:   emailVerifiedFromUser,
 141: } from '../../../../supabase/functions/_shared/verification.ts';
 142: import type {
 143:   AccountRow,
 144:   AccountsSut,
 145:   AcknowledgmentRow,
 146:   CompleteSignupOutcome,
 147:   CreateOrganizationOutcome,
 148:   MembershipRow,
 149:   OrganizationRow,
 150:   SendDiscoveryMessageOutcome,
 151:   Session,
 152:   SessionProvider,
 153:   SignInOutcome,
 154:   VolunteerProfileRow,
