 541: async function emailedVerificationLink(email: string): Promise<{ link: string | null; evidence: string }> {
 542:   const local = email.split('@')[0];
 543:   try {
 544:     if (catcher.kind === 'mailpit') {
 545:       const list = await fetch(`${MAIL_URL}/api/v1/search?query=${encodeURIComponent(`to:${email}`)}&limit=20`);
 546:       const listed = (await list.json()) as { messages?: Array<{ ID?: string }> };
 547:       const id = listed.messages?.[0]?.ID;
 548:       if (!id) return { link: null, evidence: `mailpit search for ${email} returned no message` };
 549:       const message = await fetch(`${MAIL_URL}/api/v1/message/${id}`);
 550:       const parsed = (await message.json()) as { Text?: string; HTML?: string };
 551:       const links = verifyLinksIn(`${parsed.Text ?? ''}\n${parsed.HTML ?? ''}`);
 552:       return {
 553:         link: links[0] ?? null,
 554:         evidence: `mailpit held ${listed.messages?.length ?? 0} message(s) for ${email}; ${links.length} verify link(s) found`,
 555:       };
 556:     }
 557:     if (catcher.kind === 'inbucket') {
 558:       const list = await fetch(`${MAIL_URL}/api/v1/mailbox/${encodeURIComponent(local)}`);
 559:       const listed = (await list.json()) as Array<{ id?: string }>;
 560:       const id = listed[0]?.id;
 561:       if (!id) return { link: null, evidence: `inbucket mailbox ${local} was empty` };
 562:       const message = await fetch(`${MAIL_URL}/api/v1/mailbox/${encodeURIComponent(local)}/${id}`);
 563:       const parsed = (await message.json()) as { body?: { text?: string; html?: string } };
 564:       const links = verifyLinksIn(`${parsed.body?.text ?? ''}\n${parsed.body?.html ?? ''}`);
 565:       return {
 566:         link: links[0] ?? null,
 567:         evidence: `inbucket mailbox ${local} held ${listed.length} message(s); ${links.length} verify link(s) found`,
 568:       };
 569:     }
 570:     return { link: null, evidence: `the catcher at ${MAIL_URL} matched no known API shape` };
 571:   } catch (error) {
 572:     return { link: null, evidence: `reading the catcher failed: ${error instanceof Error ? error.message : String(error)}` };
 573:   }
 574: }
