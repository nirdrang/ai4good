 352: # `discord`, `facebook`, `github`, `gitlab`, `google`, `keycloak`, `linkedin_oidc`, `notion`, `twitch`,
 353: # `twitter`, `x`, `slack`, `spotify`, `workos`, `zoom`.
 354: [auth.external.apple]
 355: enabled = false
 356: client_id = ""
