 357: /**
 358:  * THE SAME LINK WITH A TOKEN GOTRUE NEVER ISSUED â€” check (b2)'s instrument.
 359:  *
 360:  * The mirror under test says a link that was never issued confirms nothing, and following a
 361:  * MUTATED token is how that is measured without touching any semantics REQ-001 does not state.
 362:  * The token this returns was never minted, so following it says nothing about expiry, about single
 363:  * use, or about resend â€” retired AT-001.11 stays untouched. Every other part of the link, the
 364:  * `type` and the redirect included, is left exactly as GoTrue wrote it, so the only difference
 365:  * between this request and the real one is the token itself.
 366:  *
 367:  * The mutation shifts digits and letters inside their own alphabet, which keeps the token the same
 368:  * length and shape. A token that changed shape could be refused for being malformed rather than
 369:  * for being unissued, and the check would then measure input validation instead of the mirror.
 370:  */
 371: function tamperVerificationToken(link: string): { tampered: string; parameter: string } | null {
 372:   let url: URL;
 373:   try {
 374:     url = new URL(link);
 375:   } catch {
 376:     return null;
 377:   }
 378:   const parameter = ['token', 'token_hash', 'confirmation_token'].find((name) => {
 379:     const value = url.searchParams.get(name);
 380:     return typeof value === 'string' && value !== '';
 381:   });
 382:   if (parameter === undefined) return null;
 383: 
 384:   const original = url.searchParams.get(parameter) as string;
 385:   const mutated = original.replace(/[0-9a-zA-Z]/g, (character) => {
 386:     if (character >= '0' && character <= '9') return String((Number(character) + 5) % 10);
 387:     const base = character >= 'a' ? 'a'.charCodeAt(0) : 'A'.charCodeAt(0);
 388:     return String.fromCharCode(base + ((character.charCodeAt(0) - base + 13) % 26));
 389:   });
 390:   if (mutated === original) return null;
 391: 
 392:   url.searchParams.set(parameter, mutated);
 393:   return { tampered: url.toString(), parameter };
 394: }
