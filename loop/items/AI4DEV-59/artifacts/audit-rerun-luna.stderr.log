 496: /**
 497:  * WHICH MAIL CATCHER IS BEHIND PORT 54324, established by asking it rather than by remembering.
 498:  *
 499:  * The Supabase CLI has shipped Inbucket and, more recently, Mailpit, and their APIs are not the
 500:  * same shape. The plan's risk 2 is exactly this. So both are probed, BOTH ANSWERS GO IN THE
 501:  * TRANSCRIPT, and the extraction below branches on what actually replied. An assumption here would
 502:  * fail as "no confirmation email arrived", which is indistinguishable from the mailer being
 503:  * rate-limited â€” the single most misleading way this script could go wrong.
 504:  */
 505: async function discoverMailCatcher(): Promise<{ kind: CatcherKind; evidence: string }> {
 506:   const probe = async (path: string): Promise<string> => {
 507:     try {
 508:       const response = await fetch(`${MAIL_URL}${path}`);
 509:       const text = (await response.text()).slice(0, 200);
 510:       return `GET ${path} -> HTTP ${response.status} ${JSON.stringify(scrubString(text))}`;
 511:     } catch (error) {
 512:       return `GET ${path} -> unreachable (${error instanceof Error ? error.message : String(error)})`;
 513:     }
 514:   };
 515: 
 516:   const mailpit = await probe('/api/v1/info');
 517:   const inbucket = await probe('/api/v1/mailbox/probe');
 518:   const evidence = `catcher at ${MAIL_URL} Â· ${mailpit} Â· ${inbucket}`;
 519: 
 520:   if (/HTTP 200/.test(mailpit)) return { kind: 'mailpit', evidence };
 521:   if (/HTTP 200/.test(inbucket)) return { kind: 'inbucket', evidence };
 522:   return { kind: 'unknown', evidence };
 523: }
 524: 
 525: const catcher = await discoverMailCatcher();
 526: console.log(`\nmail catcher shape, measured: ${catcher.kind}\n        ${catcher.evidence}\n`);
