 158: /**
 159:  * WHICH REQUIREMENT THIS ADAPTER IS, declared by the adapter itself.
 160:  *
 161:  * `harness/suite-adapters.ts` constrains its map entry to match this literal, and `loadAdapter()` in
 162:  * `harness/index.ts` re-checks it against the requirement it was asked for. Without it the
 163:  * type-check could describe one suite while the run drove another.
 164:  */
 165: export const requirement = 'req-001' as const;
 166: 
 167: interface AdapterOptions {
 168:   worlds: FixtureWorldStore;
 169: }
 170: 
 171: /** An auth user as Supabase Auth holds one: credentials and the provider that established them. */
 172: interface AuthUser {
 173:   id: string;
 174:   email: string;
 175:   password: string | null;
 176:   provider: SessionProvider;
 177:   /**
 178:    * The handle of a LINKED GitHub identity, or null â€” Auth's `identities[]` narrowed to the one
 179:    * field anything here reads.
 180:    *
 181:    * It is stored on the auth user and NOT on the session, which is the whole reason the gate is a
 182:    * caller fact: linking happens after a session exists, changes nothing about how that session was
 183:    * established, and is a property of the user Auth answers for.
 184:    */
 185:   githubHandle: string | null;
 186:   /**
 187:    * GoTrue's `email_confirmed_at`, or null while the address is unconfirmed â€” vendor mirror 1 and
 188:    * 4 in this file's header.
 189:    *
 190:    * IT IS STORED AS THE VENDOR'S OWN FIELD VALUE, a nullable instant, and never as a boolean. The
 191:    * shipped `emailVerifiedFromUser` is what turns it into an answer, and it does so from the
 192:    * rendered `/auth/v1/user` shape rather than from this field directly. Storing a boolean here
 193:    * would put the judgement in storage, which is the one thing this file's opening paragraph
 194:    * promises it does not do.
 195:    */
 196:   emailConfirmedAt: string | null;
 197:   /**
 198:    * The verification link Auth emailed for this address, or null when no confirmation email was
 199:    * sent â€” the fixture's stand-in for the message the local mail catcher holds on the live stack.
 200:    *
 201:    * IT IS NOT CLEARED WHEN IT IS USED, deliberately. Clearing it would model SINGLE USE, and
 202:    * single-use semantics are retired AT-001.11's â€” "not stated in REQ-001". The fixture models
 203:    * what the criterion states and no more.
 204:    */
 205:   verificationLink: string | null;
 206: }
 207: 
 208: interface StoredAcknowledgment extends AcknowledgmentRow {}
 209: 
 210: interface State {
 211:   authUsers: Map<string, AuthUser>;
 212:   /** email -> auth user id, because sign-in arrives with an address rather than an id */
 213:   byEmail: Map<string, string>;
 214:   /**
 215:    * verification link -> auth user id, because a link arrives on its own with no address beside it
 216:    * â€” which is exactly the situation on the live stack, where the link is followed from an inbox.
 217:    *
 218:    * A link this map does not hold was never issued, and confirms nothing.
 219:    */
 220:   byVerificationLink: Map<string, string>;
 221:   accounts: Map<string, AccountRow>;
 222:   organizations: Map<string, OrganizationRow>;
 223:   /** `${organizationId}:${accountId}` -> row */
 224:   memberships: Map<string, MembershipRow>;
 225:   acknowledgments: StoredAcknowledgment[];
 226:   /** account id -> the imported volunteer profile, mirroring `public.volunteer_profiles`'s primary key */
 227:   volunteerProfiles: Map<string, VolunteerProfileRow>;
 228:   /**
 229:    * account id -> the Discovery message bodies that account has sent.
 230:    *
 231:    * There is NO table behind this and no route that writes one; see the header's closing paragraph.
 232:    * It exists so AT-001.10 can assert that a refused send wrote NOTHING, which the refusal's own
 233:    * return value cannot show.
 234:    */
 235:   discoveryMessages: Map<string, string[]>;
 236:   nextId: number;
 237: }
 238: 
 239: function membershipKey(organizationId: string, accountId: string): string {
 240:   return `${organizationId}:${accountId}`;
 241: }
 242: 
 243: function clone<T>(value: T): T {
 244:   return structuredClone(value);
 245: }
