 528: /**
 529:  * Every URL in the message that looks like GoTrue's verify endpoint.
 530:  *
 531:  * `&amp;` IS DECODED FIRST, and that is not cosmetic: the confirmation email's HTML part escapes
 532:  * the ampersands, so a link lifted straight out of it carries `&amp;type=signup` and GoTrue reads
 533:  * the parameter name as `amp;type`. The failure looks like a rejected link rather than like a
 534:  * mangled one.
 535:  */
 536: function verifyLinksIn(text: string): string[] {
 537:   const decoded = text.replace(/&amp;/g, '&');
 538:   return decoded.match(/https?:\/\/[^\s"'<>)\]]+\/auth\/v1\/verify[^\s"'<>)\]]*/g) ?? [];
 539: }
