 419:   await sql`
 420:     insert into auth.identities (id, user_id, provider, provider_id, identity_data,
 421:                                  created_at, updated_at, last_sign_in_at)
 422:     values (
 423:       gen_random_uuid(),
 424:       ${userId}::uuid,
 425:       'github',
 426:       ${`gh-${handle}-${RUN}`},
 427:       -- The casts are explicit because jsonb_build_object takes "any", so PostgreSQL has nothing to
 428:       -- infer a parameter's type from and refuses the statement outright rather than guessing.
 429:       jsonb_build_object('sub', ${userId}::text, 'user_name', ${handle}::text, 'provider_id', ${`gh-${handle}-${RUN}`}::text),
 430:       now(), now(), now()
 431:     )`;
 432: }
