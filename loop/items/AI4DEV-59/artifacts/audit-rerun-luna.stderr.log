 516:     },
 517: 
 518:     emailedVerificationLink: async (email) => {
 519:       const userId = state.byEmail.get(email);
 520:       const user = userId ? state.authUsers.get(userId) : undefined;
 521:       return user?.verificationLink ?? null;
 522:     },
 523: 
 524:     // VENDOR MIRRORS 2 AND 3 â€” the header names what binds each. Using the link Auth emailed
 525:     // confirms that address; a link that was never issued flips nothing and says so.
 526:     //
 527:     // NOTHING HERE MODELS EXPIRY, SINGLE USE OR RESEND. The link is NOT removed from the map after
 528:     // it is used, because removing it would be single-use semantics, and AT-001.11 â€” which is
 529:     // where those semantics lived â€” is retired as unstated in REQ-001.
 530:     useVerificationLink: async (link) => {
 531:       const userId = state.byVerificationLink.get(link);
 532:       const user = userId ? state.authUsers.get(userId) : undefined;
 533:       if (!user) return { ok: false };
 534:       user.emailConfirmedAt = CONFIRMED_AT;
 535:       return { ok: true };
 536:     },
 537: 
 538:     completeSignup,
 539: 
 540:     // THE STAND-IN SURFACE FOR A ROUTE THAT DOES NOT EXIST â€” see the header's closing paragraph
 541:     // and `AccountsSut`'s fourth kind. Every judgement below is the shipped module's; what is left
 542:     // here is one refusal about bookkeeping and one write.
 543:     sendDiscoveryMessage: async (session, body): Promise<SendDiscoveryMessageOutcome> => {
 544:       const authUser = state.authUsers.get(session.accountId);
 545:       if (!authUser) return { ok: false, reason: 'no authenticated user â€” sign in before sending a Discovery message' };
 546:       // The same bookkeeping refusal `createOrganization` gives, and it is THIS FILE'S, not a
 547:       // product rule: an account that has not completed signup has no sender to record against.
 548:       // It is checked FIRST so that AT-001.10's refusal is unambiguously the gate's own â€” the
 549:       // account there has completed signup, so this branch cannot be what answers.
 550:       if (!state.accounts.has(session.accountId)) {
 551:         return { ok: false, reason: 'complete signup before sending a Discovery message' };
 552:       }
 553: 
 554:       // THE VERIFIED FACT IS A CALLER FACT, derived exactly as `emailVerified` derives it: from the
 555:       // rendered response shape, through the shipped extractor. It is never a request field â€”
 556:       // a request field is something a client asserts about itself, and a floor built on one is no
 557:       // floor at all.
 558:       const emailVerified = emailVerifiedFromUser(renderAuthUser(authUser));
 559: 
 560:       // THE ONLY DECISION ON THIS PATH, and it is the shipped one. The refusal text is the GATE's,
 561:       // carried through unchanged â€” AT-001.10 matches the reason, so restating it here would make
 562:       // the test grade this file instead of the module that ships.
 563:       const allowed = discoveryMessageAllowed({ emailVerified });
 564:       if (!allowed.ok) return { ok: false, reason: allowed.reason };
