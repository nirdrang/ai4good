 102: /**
 103:  * EVERY BODY GOES THROUGH THIS BEFORE IT REACHES THE TRANSCRIPT.
 104:  *
 105:  * The fields that carry secrets are known and few â€” GoTrue answers with `access_token`,
 106:  * `refresh_token`, `provider_token` and friends â€” but the rule here is by NAME PATTERN rather than
 107:  * by a list, because a list is a thing to forget to extend. A value under any key whose name looks
 108:  * like a credential is replaced; the KEY still appears, so the transcript still shows that the
 109:  * field was present, which is usually the fact a check needs.
 110:  *
 111:  * It returns a STRING, not an object, so there is no path by which an unredacted value reaches the
 112:  * output through some later `JSON.stringify`.
 113:  */
 114: const SENSITIVE = /token|secret|password|apikey|api_key|jwt|nonce|otp|code$/i;
 115: 
 116: /**
 117:  * A STRING SCRUBBED OF CREDENTIALS, for the surface `redact()`'s key walk cannot see.
 118:  *
 119:  * A key walk protects `{"access_token": "..."}`. It protects nothing inside a value â€” and GoTrue
 120:  * answers with raw strings on some paths, while any body at all can carry a link with a token in
 121:  * its query. So two shapes are replaced here:
 122:  *
 123:  *   - A JWT. Three base64url runs separated by dots, beginning `eyJ`, which is what a JSON header
 124:  *     always encodes to. Every access token, refresh token and service key in this stack is one.
 125:  *   - A `name=value` pair whose NAME is credential-shaped by the same pattern the key walk uses.
 126:  *     The name survives, so the transcript still shows which parameter was present.
 127:  */
 128: function scrubString(text: string): string {
 129:   return text
 130:     .replace(/eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+/g, '<redacted-jwt>')
 131:     .replace(/([A-Za-z0-9_.-]+)=([^&\s"'<>]+)/g, (whole, name: string) =>
 132:       SENSITIVE.test(name) ? `${name}=<redacted>` : whole,
 133:     );
 134: }
 135: 
 136: function redact(value: unknown): string {
 137:   const walk = (node: unknown): unknown => {
 138:     if (Array.isArray(node)) return node.map(walk);
 139:     if (node !== null && typeof node === 'object') {
 140:       const out: Record<string, unknown> = {};
 141:       for (const [key, inner] of Object.entries(node as Record<string, unknown>)) {
 142:         out[key] = SENSITIVE.test(key) ? '<redacted>' : walk(inner);
 143:       }
 144:       return out;
 145:     }
 146:     // A STRING VALUE IS SCRUBBED TOO. This is the half gate 2 found missing: a body that is not
 147:     // JSON reaches here as one long string, and a key walk never looks inside it.
 148:     if (typeof node === 'string') return scrubString(node);
 149:     return node;
 150:   };
 151:   try {
 152:     return JSON.stringify(walk(value));
 153:   } catch {
 154:     return '<unserialisable>';
 155:   }
 156: }
 157: 
 158: /**
 159:  * A URL SAFE TO PRINT: no fragment, and no query-parameter VALUES.
 160:  *
 161:  * The fragment is where GoTrue puts the minted access token. The QUERY is where it puts the
 162:  * token hash, the `code`, and the error description â€” and printing those unchanged was the defect
 163:  * two blind reviewers found independently. Parameter NAMES are kept, because which parameters a
 164:  * redirect carried is usually the fact a check needs, and a name is not a credential.
 165:  */
 166: function redactedLocation(url: string): string {
 167:   if (url === '') return '';
 168:   const hash = url.indexOf('#');
 169:   const fragmentNote = hash < 0 ? '' : '#<redacted-fragment>';
 170:   const withoutHash = hash < 0 ? url : url.slice(0, hash);
 171: 
 172:   const question = withoutHash.indexOf('?');
 173:   if (question < 0) return `${withoutHash}${fragmentNote}`;
 174: 
 175:   const query = withoutHash
 176:     .slice(question + 1)
 177:     .split('&')
 178:     .map((pair) => {
 179:       const equals = pair.indexOf('=');
 180:       // A bare flag has no value to redact.
 181:       return equals < 0 ? pair : `${pair.slice(0, equals)}=<redacted>`;
 182:     })
 183:     .join('&');
 184:   return `${withoutHash.slice(0, question)}?${query}${fragmentNote}`;
 185: }
