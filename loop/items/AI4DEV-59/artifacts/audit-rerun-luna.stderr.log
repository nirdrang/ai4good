 113: /* --------------------------------------------------------------------------------- the session */
 114: 
 115: /**
 116:  * An authenticated session, and WHICH PROVIDER ESTABLISHED IT.
 117:  *
 118:  * `provider` is recorded, never simulated. Supabase Auth records the provider that produced a
 119:  * session; how the session was obtained â€” an email and a password, or a completed Google consent
 120:  * round trip â€” happens entirely upstream of anything this requirement's leaf ships. AT-001.03's
 121:  * body asserts that `completeSignup` behaves identically for `'google'` and `'email'`, which is a
 122:  * real property of the shipped decision module (it never reads this field). It is NOT a claim that a
 123:  * Google round trip works: see the suite's own note on AT-001.03, and the plan's per-id table.
 124:  *
 125:  * `'github'` joins the two for AT-001.02 and carries exactly the same caveat: a github-established
 126:  * session is the state Auth is in AFTER a consent round trip, and no handshake is simulated to reach
 127:  * it. The establishing provider still participates in NO decision the shipped modules make â€” the
 128:  * volunteer gate reads a LINKED IDENTITY, which is a different fact (see `linkGithubIdentity`).
 129:  */
 130: export type SessionProvider = 'email' | 'google' | 'github';
 131: 
 132: export type Session = {
 133:   /** the auth user id, which is also the `public.accounts` primary key once signup completes */
 134:   accountId: string;
 135:   email: string;
 136:   provider: SessionProvider;
 137: };
 138: 
 139: /* -------------------------------------------------------------------------------- the outcomes */
