 635: async function verificationRoundTrip(email: string): Promise<RoundTrip> {
 636:   const { wire: signupWire, userId, idFrom } = await signUp(email);
 637:   const signupBody = signupWire.body as { access_token?: unknown; refresh_token?: unknown; session?: unknown } | null;
