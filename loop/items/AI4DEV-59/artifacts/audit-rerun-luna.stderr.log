 369: # REQ-001 AT-001.03 â€” Google sign-in. A NEW block; the [auth.external.apple] block above is the
 370: # template's own enabled-false example and is left exactly as it shipped.
 371: #
 372: # NO SECRET IS COMMITTED. Both credentials come through env() substitution: the real values live in
 373: # .env.local, which .gitignore covers ("secrets live here, never in the tracked .env"), and the
 374: # tracked .env carries public values only.
 375: #
 376: # skip_nonce_check is what the template's own comment documents as "Required for local sign in with
 377: # Google auth". It is a LOCAL development accommodation and this file is the local configuration;
 378: # the hosted project's provider settings are configured separately and are not this file.
 379: #
 380: # WHAT IS PROVED BY THIS BLOCK EXISTING AND THE STACK STARTING: that the configuration is
 381: # well-formed and /auth/v1/settings reports Google enabled. WHAT IS NOT: that a Google sign-in round
 382: # trip works. Consent is a person pressing a button in a browser, which no agent performs, so
 383: # AT-001.03's "sign-in via Google succeeds on return visits" clause is named unproved in this item's
 384: # record and in its merge ruling. A real OAuth client narrows that gap and does not close it.
 385: [auth.external.google]
 386: enabled = true
 387: client_id = "env(SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID)"
 388: # DO NOT commit your OAuth provider secret to git. Use environment variable substitution instead:
 389: secret = "env(SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET)"
 390: # If enabled, the nonce check will be skipped. Required for local sign in with Google auth.
 391: skip_nonce_check = true
 392: 
 393: # REQ-001 AT-001.02 â€” GitHub sign-in. A NEW block, mirroring the Google one above.
 394: #
 395: # NO SECRET IS COMMITTED, same arrangement as Google: both credentials come through env()
 396: # substitution, the real values live in .env.local which .gitignore covers, and the tracked .env
 397: # carries public values only.
 398: #
 399: # NO skip_nonce_check, AND THAT IS A DIFFERENCE RATHER THAN AN OMISSION. A nonce is an OpenID Connect
 400: # accommodation; GitHub is plain OAuth2 and issues no ID token, so there is no nonce to skip. Copying
 401: # the Google line here would be cargo cult.
 402: #
 403: # WHAT IS PROVED BY THIS BLOCK EXISTING AND THE STACK STARTING: that the configuration is well-formed
 404: # and /auth/v1/settings reports GitHub enabled. WHAT IS NOT: that a GitHub sign-in round trip works.
 405: # Consent is a person pressing a button in a browser, which no agent performs, so AT-001.02's real
 406: # handshake â€” both the signup and the return visit â€” is named unproved in this item's record and in
 407: # its merge ruling.
 408: #
 409: # CREATING THE GITHUB OAUTH APP IS A FOUNDER-MANUAL STEP, exactly like the Google client. Measured on
 410: # the predecessor item and carried forward: an UNSET env() variable does NOT stop the stack â€” the
 411: # literal string passes straight through â€” so a stack reporting github: true with no real credential
 412: # still proves only well-formedness. Its absence is the expected case and blocks nothing here.
 413: [auth.external.github]
 414: enabled = true
 415: client_id = "env(SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID)"
 416: # DO NOT commit your OAuth provider secret to git. Use environment variable substitution instead:
 417: secret = "env(SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET)"
