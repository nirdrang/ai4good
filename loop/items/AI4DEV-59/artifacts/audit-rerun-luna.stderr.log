 456: [edge_runtime]
 457: enabled = true
 458: # Supported request policies: `oneshot`, `per_worker`.
 459: # `per_worker` (default) â€” enables hot reload during local development.
 460: # `oneshot` â€” fallback mode if hot reload causes issues (e.g. in large repos or with symlinks).
 461: policy = "per_worker"
