 309: /**
 310:  * GoTrue's error code for "this address is not confirmed yet".
 311:  *
 312:  * It is the DISCRIMINATOR check (c) needs, and it is pinned as a constant so the transcript states
 313:  * which value was expected. If the live stack answers a different code, the check FAILS and the
 314:  * verbatim capture beside it shows the real one â€” measurement, never assumption.
 315:  */
 316: const CONFIRMATION_ERROR_CODE = 'email_not_confirmed';
 317: 
 318: /**
 319:  * IS THIS THE CONFIRMATION REFUSAL, or merely A refusal â€” the distinction gate 2 found missing.
 320:  *
 321:  * `status >= 400` alone passes on a 429 from the mailer's rate limiter and on a 500 from a broken
 322:  * stack, and either would record "confirmation is enforced" while confirmation enforced nothing.
 323:  * So a pass needs BOTH halves:
 324:  *
 325:  *   - a 4xx that is NOT 429 â€” a client refusal, not a throttle and not a server fault;
 326:  *   - a body that NAMES the unconfirmed state through the pinned error code
 327:  *     `email_not_confirmed`, exactly. If the live refusal carries a different discriminator, the
 328:  *     check FAILS, the verbatim capture beside it shows the real discriminator, and the operator
 329:  *     pins that measured value and re-runs â€” measurement, never assumption.
 330:  *
 331:  * IT READS THE IN-MEMORY BODY, NOT THE PRINTED ONE, and that is load-bearing: the transcript
 332:  * redactor's key pattern ends with `code$`, so `error_code` is blanked in everything it prints.
 333:  * Judging the printed text would judge `<redacted>`. The discriminator is surfaced separately
 334:  * below through a safe extraction â€” an error code is an enum value, not a credential.
 335:  */
 336: function unconfirmedSignInRefusal(wire: Wire): { ok: boolean; discriminator: string } {
 337:   const body =
 338:     wire.body !== null && typeof wire.body === 'object'
 339:       ? (wire.body as Record<string, unknown>)
 340:       : {};
 341:   const errorCode = typeof body.error_code === 'string' ? body.error_code : '';
 342:   const message = [body.msg, body.message, body.error_description, body.error, wire.body]
 343:     .filter((part): part is string => typeof part === 'string')
 344:     .join(' | ');
 345: 
 346:   const statusIsClientRefusal = wire.status >= 400 && wire.status < 500 && wire.status !== 429;
 347:   const bodyNamesTheState = errorCode === CONFIRMATION_ERROR_CODE;
 348: 
 349:   return {
 350:     ok: statusIsClientRefusal && bodyNamesTheState,
 351:     discriminator:
 352:       `HTTP ${wire.status} Â· error_code=${errorCode === '' ? '<absent>' : errorCode}` +
 353:       ` (expected ${CONFIRMATION_ERROR_CODE}) Â· message=${JSON.stringify(scrubString(message) || '<absent>')}`,
 354:   };
 355: }
