 256: /* --------------------------------------------------------------------------------- Auth calls */
 257: 
 258: type Wire = { status: number; body: unknown };
 259: 
 260: async function authPost(path: string, body: unknown, key = PUBLIC_KEY): Promise<Wire> {
 261:   const response = await fetch(`${API_URL}${path}`, {
 262:     method: 'POST',
 263:     headers: { 'content-type': 'application/json', apikey: key, Authorization: `Bearer ${key}` },
 264:     body: JSON.stringify(body),
 265:   });
 266:   const text = await response.text();
 267:   let parsed: unknown = text;
 268:   try {
 269:     parsed = JSON.parse(text);
 270:   } catch {
 271:     // A non-JSON answer is itself evidence; it is kept as the raw string.
 272:   }
 273:   return { status: response.status, body: parsed };
 274: }
 275: 
 276: /**
 277:  * Register an email/password user. WITH CONFIRMATIONS ON THIS MUST RETURN NO SESSION, which is
 278:  * check (a)'s first half, so the caller inspects the wire response rather than being handed a
 279:  * tidy session object.
 280:  *
 281:  * THE USER ID IS TAKEN FROM THE RESPONSE WHEN IT IS THERE, AND FROM THE DATABASE WHEN IT IS NOT.
 282:  * GoTrue's confirmations-on signup response has varied across versions â€” some return the full user
 283:  * record, some return an obfuscated one to avoid leaking whether an address already exists. Which
 284:  * one this stack does is recorded rather than assumed, and neither answer is a failure: the id is
 285:  * an operator read either way.
 286:  */
 287: async function signUp(email: string): Promise<{ wire: Wire; userId: string; idFrom: 'response' | 'database' }> {
 288:   const wire = await authPost('/auth/v1/signup', { email, password: PASSWORD });
 289:   noteIfRateLimited(`signup ${email}`, wire.status, wire.body);
 290:   if (wire.status >= 400) fail(`sign-up for ${email} failed (HTTP ${wire.status}): ${redact(wire.body)}`);
 291: 
 292:   const body = wire.body as { id?: string; user?: { id?: string } } | null;
 293:   const fromResponse = body?.user?.id ?? body?.id;
 294:   if (typeof fromResponse === 'string' && fromResponse !== '') {
 295:     return { wire, userId: fromResponse, idFrom: 'response' };
 296:   }
 297:   const rows = await sql`select id from auth.users where email = ${email}`;
 298:   if (rows.length !== 1) fail(`sign-up for ${email} left ${rows.length} rows in auth.users â€” expected exactly 1`);
 299:   return { wire, userId: String(rows[0].id), idFrom: 'database' };
 300: }
 301: 
 302: /** Sign in with a password. Returns the wire answer AND the token, which is never printed. */
 303: async function signIn(email: string): Promise<{ wire: Wire; accessToken: string | null }> {
 304:   const wire = await authPost('/auth/v1/token?grant_type=password', { email, password: PASSWORD });
 305:   const token = (wire.body as { access_token?: string } | null)?.access_token;
 306:   return { wire, accessToken: typeof token === 'string' && token !== '' ? token : null };
 307: }
