 411:  * `created_at`, `updated_at` and `last_sign_in_at` are NULLABLE in the table, so a row without them
 412:  * inserts happily; but GoTrue reads identities into a Go struct with non-pointer timestamps, so
 413:  * `GET /auth/v1/user` then answers 500 for that user, and the whole thing looks exactly like an
 414:  * expired token rather than like a malformed row three layers away. So they are filled here.
 415:  */
 416: async function fabricateGithubIdentity(userId: string, handle: string): Promise<void> {
 417:   await sql`
 418:     insert into auth.identities (id, user_id, provider, provider_id, identity_data,
 419:                                  created_at, updated_at, last_sign_in_at)
 420:     values (
 421:       gen_random_uuid(),
 422:       ${userId}::uuid,
 423:       'github',
 424:       ${`gh-${handle}-${RUN}`},
 425:       -- The casts are explicit because jsonb_build_object takes "any", so PostgreSQL has nothing to
 426:       -- infer a parameter's type from and refuses the statement outright rather than guessing.
 427:       jsonb_build_object('sub', ${userId}::text, 'user_name', ${handle}::text, 'provider_id', ${`gh-${handle}-${RUN}`}::text),
 428:       now(), now(), now()
 429:     )`;
 430: }
