 356:  * THE SAME LINK WITH A TOKEN GOTRUE NEVER ISSUED â€” check (b2)'s instrument.
 357:  *
 358:  * The mirror under test says a link that was never issued confirms nothing, and following a
 359:  * MUTATED token is how that is measured without touching any semantics REQ-001 does not state.
 360:  * The token this returns was never minted, so following it says nothing about expiry, about single
 361:  * use, or about resend â€” retired AT-001.11 stays untouched. Every other part of the link, the
 362:  * `type` and the redirect included, is left exactly as GoTrue wrote it, so the only difference
 363:  * between this request and the real one is the token itself.
 364:  *
 365:  * The mutation shifts digits and letters inside their own alphabet, which keeps the token the same
 366:  * length and shape. A token that changed shape could be refused for being malformed rather than
 367:  * for being unissued, and the check would then measure input validation instead of the mirror.
 368:  */
 369: function tamperVerificationToken(link: string): { tampered: string; parameter: string } | null {
 370:   let url: URL;
 371:   try {
 372:     url = new URL(link);
 373:   } catch {
 374:     return null;
 375:   }
 376:   const parameter = ['token', 'token_hash', 'confirmation_token'].find((name) => {
 377:     const value = url.searchParams.get(name);
 378:     return typeof value === 'string' && value !== '';
 379:   });
 380:   if (parameter === undefined) return null;
 381: 
 382:   const original = url.searchParams.get(parameter) as string;
 383:   const mutated = original.replace(/[0-9a-zA-Z]/g, (character) => {
 384:     if (character >= '0' && character <= '9') return String((Number(character) + 5) % 10);
 385:     const base = character >= 'a' ? 'a'.charCodeAt(0) : 'A'.charCodeAt(0);
 386:     return String.fromCharCode(base + ((character.charCodeAt(0) - base + 13) % 26));
 387:   });
 388:   if (mutated === original) return null;
 389: 
 390:   url.searchParams.set(parameter, mutated);
 391:   return { tampered: url.toString(), parameter };
 392: }
