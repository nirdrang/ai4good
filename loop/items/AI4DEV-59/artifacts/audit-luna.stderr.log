 514:   const mailpit = await probe('/api/v1/info');
 515:   const inbucket = await probe('/api/v1/mailbox/probe');
 516:   const evidence = `catcher at ${MAIL_URL} Â· ${mailpit} Â· ${inbucket}`;
 517: 
 518:   if (/HTTP 200/.test(mailpit)) return { kind: 'mailpit', evidence };
 519:   if (/HTTP 200/.test(inbucket)) return { kind: 'inbucket', evidence };
 520:   return { kind: 'unknown', evidence };
 521: }
