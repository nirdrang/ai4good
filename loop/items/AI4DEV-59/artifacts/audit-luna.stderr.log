 497:  * The Supabase CLI has shipped Inbucket and, more recently, Mailpit, and their APIs are not the
 498:  * same shape. The plan's risk 2 is exactly this. So both are probed, BOTH ANSWERS GO IN THE
 499:  * TRANSCRIPT, and the extraction below branches on what actually replied. An assumption here would
 500:  * fail as "no confirmation email arrived", which is indistinguishable from the mailer being
 501:  * rate-limited â€” the single most misleading way this script could go wrong.
 502:  */
 503: async function discoverMailCatcher(): Promise<{ kind: CatcherKind; evidence: string }> {
 504:   const probe = async (path: string): Promise<string> => {
 505:     try {
 506:       const response = await fetch(`${MAIL_URL}${path}`);
 507:       const text = (await response.text()).slice(0, 200);
 508:       return `GET ${path} -> HTTP ${response.status} ${JSON.stringify(text)}`;
 509:     } catch (error) {
 510:       return `GET ${path} -> unreachable (${error instanceof Error ? error.message : String(error)})`;
 511:     }
 512:   };
