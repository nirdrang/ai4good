   1: /**
   2:  * `complete-signup` â€” turn an authenticated auth user into a typed account.
   3:  *
   4:  * THE CALLER HAS ALREADY AUTHENTICATED before it reaches here, and how is not this function's
   5:  * business: an email and a password through `auth.signUp`, or a Google or GitHub consent round trip
   6:  * through the OAuth redirect. Neither is a database call, so the standing rule that UI never touches
   7:  * the database directly holds â€” and this is exactly why AT-001.01 (email), AT-001.03 (Google) and
   8:  * AT-001.02 (GitHub) are the SAME code path. The difference between them is upstream, in how the
   9:  * session was obtained.
  10:  *
  11:  * WHAT IS *NOT* UPSTREAM is whether a GitHub identity is LINKED to the caller. That is a fact Auth
  12:  * reports about the user, this function reads it through `resolveCaller`, and a volunteer completion
  13:  * turns on it â€” AT-001.04. Linking itself happens inside Supabase Auth and reaches no code here, so
  14:  * the completion request is the only server-observable moment at which the mandatory link is
  15:  * satisfied; that is why the onboarding import fires here and not at some link event nothing can
  16:  * observe.
  17:  *
  18:  * WHAT IT DOES: sets the global account type once, and for an NGO creates the organisation, the
  19:  * `admin` membership and the ToS + Platform Promise acknowledgment with the address the gateway
  20:  * chain reported â€” NOT a verified source address; see `callerIp` in `../_shared/edge.ts` for the
  21:  * trust boundary and the measurement behind it â€” and the version of the text that was accepted.
  22:  * and for a volunteer writes the imported GitHub profile. All of it through ONE call to
  23:  * `public.complete_signup`, which is one round trip and therefore one transaction â€” every row or
  24:  * none.
  25:  *
  26:  * ONE JOB. A second operation is a second function, never a switch on an action name: see
  27:  * `create-organization` beside this one.
  28:  */
  29: 
  30: import { validateCompleteSignup } from '../_shared/accounts.ts';
  31: import { stubGithubStatsFor } from '../_shared/github.ts';
  32: import {
  33:   callDatabaseFunction,
  34:   callerIp,
  35:   edgeHandler,
  36:   json,
  37:   readJsonBody,
  38:   refusal,
  39:   requireEnv,
  40:   resolveCaller,
  41: } from '../_shared/edge.ts';
  42: 
  43: const SUPABASE_URL = requireEnv('SUPABASE_URL');
  44: const ANON_KEY = requireEnv('SUPABASE_ANON_KEY', 'SUPABASE_PUBLISHABLE_KEY');
  45: const SERVICE_ROLE_KEY = requireEnv('SUPABASE_SERVICE_ROLE_KEY', 'SUPABASE_SECRET_KEY');
  46: 
  47: // `edgeHandler` answers the browser preflight and turns anything thrown into a shaped 502 â€” see its
  48: // own comment for why both belong to every entry point here rather than to this one.
  49: Deno.serve(edgeHandler('complete-signup', async (request: Request): Promise<Response> => {
  50:   if (request.method !== 'POST') return refusal('complete-signup accepts POST only', 405);
  51: 
  52:   const caller = await resolveCaller(request, SUPABASE_URL, ANON_KEY);
  53:   if (!caller) return refusal('authenticate before completing signup', 401);
  54: 
  55:   const body = await readJsonBody(request);
  56:   if (!body.ok) return refusal(body.reason, 400);
  57: 
  58:   // EVERY JUDGEMENT IS THE SHARED MODULE'S. `validateCompleteSignup` decides the account type, the
  59:   // organisation-name rule for each type, the acknowledgment text version and â€” since the GitHub
  60:   // leaf â€” whether a volunteer may complete at all â€” and it is the same module the acceptance suite
  61:   // drives, which is what makes that suite's green a statement about this code rather than about a
  62:   // re-implementation living in a test fixture.
  63:   //
  64:   // THE SECOND ARGUMENT IS THE CALLER FACT, AND IT COMES FROM `resolveCaller`, which got it from
  65:   // Auth. Note what is NOT here: no `body.value.githubHandle`. A handle taken from the request body
  66:   // would be a client asserting its own identity, and a gate built on that gates nothing.
  67:   const decision = validateCompleteSignup(
  68:     {
  69:       accountType: body.value.accountType,
  70:       organizationName: body.value.organizationName,
  71:       acknowledgmentTextVersion: body.value.acknowledgmentTextVersion,
  72:     },
  73:     { githubHandle: caller.githubHandle },
  74:   );
  75:   if (!decision.ok) return refusal(decision.reason, 400);
  76: 
  77:   const { accountType, organizationName, acknowledgmentTextVersion, githubHandle } = decision.value;
  78: 
  79:   // THE ONBOARDING IMPORT, FIRED HERE â€” AT-001.05. The handle is the JUDGED one, so the stats are
  80:   // computed for the identity the gate actually accepted rather than for one this function re-derived.
  81:   //
  82:   // It is a STUB SOURCE and the module says so at length: no request leaves this process to reach
  83:   // GitHub. What is real is that the stats travel into the same rpc call as the account, and
  84:   // therefore into the same transaction â€” there is no queue and no second request, which is what
  85:   // makes AT-001.05's "a queued-but-empty import fails this test" unrepresentable rather than merely
  86:   // untested. `null` throughout for an NGO, which the database function requires.
  87:   const githubStats = githubHandle === null ? null : stubGithubStatsFor(githubHandle);
  88: 
  89:   // THE FOUR GITHUB KEYS ARE OMITTED ENTIRELY WHEN THERE IS NO HANDLE, rather than sent as nulls,
  90:   // and the difference is a DEPLOYMENT property rather than a stylistic one.
  91:   //
  92:   // The database plane and this plane deploy separately. `public.complete_signup` gives its four new
  93:   // parameters `default null`, so a call carrying only the ORIGINAL FIVE named arguments resolves
  94:   // against either version of the function â€” which means an NGO completion sent from here keeps
  95:   // working while a migration is rolling, in either order. Sending `p_github_handle: null` instead
  96:   // would name an argument the older function does not have, and PostgREST would fail to resolve the
  97:   // call: same intent, and the NGO signup path broken for the length of the window.
  98:   //
  99:   // The database sees no difference in the new-plane case: an omitted argument arrives as the
 100:   // default, which is null, which is exactly what the NGO branch requires.
 101:   const githubArguments = githubHandle === null
 102:     ? {}
 103:     : {
 104:       p_github_handle: githubHandle,
 105:       p_github_top_languages: githubStats?.topLanguages ?? null,
 106:       p_github_repository_count: githubStats?.repositoryCount ?? null,
 107:       p_github_contribution_summary: githubStats?.contributionSummary ?? null,
 108:     };
 109: 
 110:   const outcome = await callDatabaseFunction(SUPABASE_URL, SERVICE_ROLE_KEY, 'complete_signup', {
 111:     p_account_id: caller.id,
 112:     p_account_type: accountType,
 113:     p_organization_name: organizationName,
 114:     p_acknowledgment_text_version: acknowledgmentTextVersion,
 115:     p_ip: callerIp(request),
 116:     ...githubArguments,
 117:   });
 118: 
 119:   if (!outcome.ok) {
 120:     // The database's own sentence travels back. `complete_signup` refuses `platform_admin`, a
 121:     // second completion, and a malformed organisation name with messages written to be read by a
 122:     // caller â€” replacing them with "internal error" would throw away the only thing that says what
 123:     // to do differently. The status is 409 for anything the database judged and 502 for a transport
 124:     // failure, so a client can tell a refusal from an outage.
 125:     const status = outcome.status >= 400 && outcome.status < 500 ? 409 : 502;
 126:     return refusal(outcome.message, status);
 127:   }
 128: 
 129:   const result = outcome.value as { account_id?: string; account_type?: string; organization_id?: string | null } | null;
 130:   return json(
 131:     {
 132:       ok: true,
 133:       accountId: result?.account_id ?? caller.id,
 134:       accountType: result?.account_type ?? accountType,
 135:       organizationId: result?.organization_id ?? null,
 136:     },
 137:     200,
 138:   );
 139: }));

