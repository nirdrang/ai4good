 243: /**
 244:  * Anything that looks like the mailer refusing to send. Check (f) reports on this, so a starved
 245:  * run can never look like a clean one.
 246:  */
 247: const rateLimitEvidence: string[] = [];
 248: 
 249: function noteIfRateLimited(where: string, httpStatus: number, body: unknown): void {
 250:   const text = typeof body === 'string' ? body : JSON.stringify(body ?? null);
 251:   if (httpStatus === 429 || /rate.?limit|over_email_send/i.test(text)) {
 252:     rateLimitEvidence.push(`${where}: HTTP ${httpStatus} ${redact(body)}`);
 253:   }
 254: }
