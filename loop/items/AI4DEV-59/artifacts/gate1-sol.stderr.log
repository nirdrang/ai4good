 633: /* ------------------------------------------------------------------------------- registration */
 634: 
 635: /** One authored test body, for the suite bound to requirement `R` and sut key `K`. */
 636: export type AtTestBody<R extends SuiteId, K extends SutKeyOf<R>> = (ctx: AtContext<R, K>) => Promise<void>;
 637: 
 638: function emitRuntimeRegistration(registration: Registration): void {
 639:   const dir = process.env.AT_REGISTRATION_DIR;
 640:   if (!dir) return;
 641:   mkdirSync(dir, { recursive: true });
 642:   appendFileSync(join(dir, `registration-${process.pid}.jsonl`), `${JSON.stringify(registration)}\n`, 'utf8');
 643: }
 644: 
 645: /**
 646:  * THE ONE PLACE the AT id's requirement and the binding's requirement are made to agree.
 647:  *
 648:  * They are two independent strings that must denote the same suite: the id decides which fixture
 649:  * adapter `createHarness()` loads at RUN time (`openWorld` passes `parsed.requirement` straight
 650:  * through), while the binding decides which adapter the TYPES were read off at compile time. Left
 651:  * unchecked, `AT-017.03` registered through a suite bound to `req-016` would drive req-017's
 652:  * implementation while every type in the body described req-016's, and both halves would look fine.
 653:  *
 654:  * The formats differ and the comparison must normalize, or it would reject every valid suite:
 655:  * `parseAtId('AT-016.01').requirement` is `"016"`, whereas the binding and the registry key are
 656:  * `"req-016"`.
 657:  *
 658:  * The field stays MANDATORY. Making the check fire only when a requirement happens to be supplied
 659:  * would reopen the hole through the door marked convenience â€” so a binding with no requirement is
 660:  * its own error, not a skipped check.
 661:  */
 662: export function requirementMismatch(atId: string, parsedRequirement: string, bound: string): string | null {
 663:   if (!bound) {
 664:     return (
 665:       `${atId} was registered with no requirement â€” atTest cannot check that the suite whose types ` +
 666:       `were used is the suite whose fixture adapter will be loaded. Bind the suite with ` +
 667:       `bindSuite({ requirement: 'req-${parsedRequirement}', sut: â€¦ }).`
 668:     );
 669:   }
 670:   const fromId = `req-${parsedRequirement}`;
 671:   if (fromId === bound) return null;
 672:   return (
 673:     `${atId} was registered through a suite bound to ${bound} â€” at run time the harness would load ` +
 674:     `${fromId}'s fixture adapter, because the requirement comes from the AT id, while the ` +
 675:     `type-check described ${bound}'s. One id, one suite: correct the id or correct the binding.`
 676:   );
 677: }
 678: 
 679: /**
 680:  * Register one acceptance test. The id is declared here and nowhere else.
 681:  *
 682:  * - a malformed id throws AT REGISTRATION â€” the id is checked where it is written.
 683:  * - the id's requirement must match the suite's binding, for the reason above.
 684:  * - `expect.hasAssertions()` makes a body that asserts nothing a RED, so a tagged test cannot
 685:  *   satisfy the bijection checker by existing.
 686:  * - worlds AND harnesses are tracked per test and always torn down, so a frozen clock, a vendor
 687:  *   counter or an armed fault cannot leak into the next id â€” and a teardown that REJECTS fails
 688:  *   the test rather than being swallowed, because state that was never released is a defect that
 689:  *   would otherwise land on a different id.
 690:  *
 691:  * THE BODY'S TYPES ARE DERIVED, NOT ACCEPTED. `Sut` and `W` used to be this function's own type
 692:  * parameters, filled in by whatever the suite wrote; now they are `SutOf<R, K>` and `WorldOf<R>`,
 693:  * read off the adapter registered under `R` in `suite-adapters.ts`. There is no type argument left
 694:  * for a suite to lie with.
 695:  *
 696:  * A `const` typed by a call-signature alias, NOT an exported `function` declaration, for the reason
 697:  * given on `defineEvidenceCapture`: a function declaration accepts a merged-in overload and a
 698:  * `const` does not.
 699:  */
 700: type AtTestFn = {
 701:   <R extends SuiteId, K extends SutKeyOf<R>>(
 702:     atId: string,
 703:     title: string,
 704:     opts: AtTestOptions & SuiteBinding<R, K>,
 705:     body: AtTestBody<R, K>,
 706:   ): void;
 707: };
 708: 
 709: export const atTest: AtTestFn = <R extends SuiteId, K extends SutKeyOf<R>>(
 710:   atId: string,
 711:   title: string,
 712:   opts: AtTestOptions & SuiteBinding<R, K>,
 713:   body: AtTestBody<R, K>,
 714: ): void => {
 715:   if (typeof body !== 'function') throw new Error(`${atId}: atTest was given no test body`);
 716: 
 717:   const parsed = parseAtId(atId);
 718:   const mismatch = requirementMismatch(atId, parsed.requirement, opts.requirement);
 719:   if (mismatch) throw new Error(mismatch);
 720: 
 721:   const previous = registrations.get(atId);
 722:   if (previous) throw new Error(`${atId} is registered twice ("${previous.title}" and "${title}") â€” one id, one test`);
 723:   const registration = { ...parsed, title, surface: opts.surface ?? 'backend' };
 724:   registrations.set(atId, registration);
 725:   emitRuntimeRegistration(registration);
 726: 
 727:   const sutKey = opts.sut;
 728:   const sutMissing =
 729:     opts.sutMissingDetail ?? `REQ-${parsed.requirement}'s implementation is not in the tree â€” harness.sut.${sutKey} is absent`;
 730: 
 731:   it(`${atId} â€” ${title}`, async () => {
 732:     expect.hasAssertions();
 733: 
 734:     const worlds: TrackedTeardown[] = [];
 735:     const harnesses: TrackedTeardown[] = [];
 736:     const usage: Usage = { opens: 0, captures: 0 };
 737:     const ctx: InternalContext<SutOf<R, K>, WorldOf<R>> = {
 738:       atId,
 739:       [USAGE]: usage,
 740:       open: async (fixture = `req-${parsed.requirement}/base`, openOpts) => {
 741:         const { opened, harness } = await openWorld({
 742:           atId,
 743:           requirement: parsed.requirement,
 744:           sutKey,
 745:           sutMissing,
 746:           fixture,
 747:           configOverrides: openOpts?.config,
 748:         });
 749:         harnesses.push({ what: `harness for fixture world ${JSON.stringify(fixture)}`, teardown: () => harness.teardown() });
 750:         worlds.push({ what: `fixture world ${JSON.stringify(fixture)}`, teardown: () => opened.w.teardown() });
 751:         usage.opens += 1;
 752:         // THE ONE SURVIVING ASSERTION, and exactly what it still takes on trust.
 753:         //
 754:         // `h.sut[key]` is `unknown` and `h.fixtures.world()` is `WorldSeam`, because `h` is the
 755:         // concrete `AtHarness` the factory is checked to produce and that type deliberately says
 756:         // nothing about any one suite. No run-time value can prove its own static type, so this
 757:         // relabelling cannot be removed â€” only moved to where the claim is smallest.
 758:         //
 759:         // What changed is WHOSE claim it is. It used to be the suite's: `bindSuite<X, Y>` named two
 760:         // types and this line stamped them onto whatever the harness returned, so any pair of names
 761:         // was accepted. Now both come from `suite-adapters.ts`, which reads them off the adapter
 762:         // module that the `requirement` literal proves is the module `loadAdapter()` imports â€”
 763:         // checked at the map entry, and again at run time in `index.ts`.
 764:         //
 765:         // So what remains unchecked here is narrow and nameable: that the object `createHarness()`
 766:         // built at run time really is the one that module's `createFixtureAdapter()` returned. That
 767:         // holds unless somebody casts inside `index.ts` or mutates the adapter after it is built â€”
 768:         // both trusted-author escapes this item does not claim to close.
 769:         return opened as OpenWorld<R, K>;
 770:       },
 771:       capture: async (evidence) => {
 772:         const value = await evidence.consume(ctx);
 773:         usage.captures += 1;
 774:         return value;
 775:       },
 776:     };
 777: 
 778:     await runTrackedTest(atId, () => executeRegisteredBody(atId, body, ctx, usage), worlds, harnesses);
 779:   });
 780: };
 781: 
 782: /* ------------------------------------------------------------------------------ suite binding */
 783: 
 784: /** `atTest`, with the binding already applied â€” so bodies say `atTest(id, title, body)`. */
 785: type BoundAtTest<R extends SuiteId, K extends SutKeyOf<R>> = {
 786:   (atId: string, title: string, opts: AtTestOptions, body: AtTestBody<R, K>): void;
 787:   (atId: string, title: string, body: AtTestBody<R, K>): void;
 788: };
 789: 
 790: /** `defineEvidenceCapture`, with the binding already applied. */
 791: type BoundDefineEvidenceCapture<R extends SuiteId, K extends SutKeyOf<R>> = <T>(
 792:   name: string,
 793:   producer: (ctx: AtContext<R, K>) => Promise<T>,
 794: ) => EvidenceCapture<T, R, K>;
 795: 
 796: /**
 797:  * A suite's ONE line of harness contact: name the requirement and the system-under-test key, and
 798:  * get back both entry points with the seam types already derived from that suite's adapter.
 799:  *
 800:  * BOTH are returned because both were doors. Closing `atTest` alone would have moved the defect one
 801:  * import along â€” `defineEvidenceCapture` handed its producer the same `AtContext`, so a suite could
 802:  * fabricate a system under test there instead and read it green, and the item would have shipped
 803:  * claiming a closure it did not have.
 804:  *
 805:  * It is the same `atTest` and the same `defineEvidenceCapture` as above: one implementation, not
 806:  * one per suite. And it is a `const`, not an exported `function` declaration, so no suite can merge
 807:  * an extra generic overload onto it through `declare module` and restore the fabricated arguments.
 808:  */
 809: type BindSuiteFn = <R extends SuiteId, K extends SutKeyOf<R>>(
 810:   binding: SuiteBinding<R, K>,
 811: ) => {
 812:   atTest: BoundAtTest<R, K>;
 813:   defineEvidenceCapture: BoundDefineEvidenceCapture<R, K>;
 814: };
 815: 
 816: export const bindSuite: BindSuiteFn = <R extends SuiteId, K extends SutKeyOf<R>>(binding: SuiteBinding<R, K>) => {
 817:   const boundAtTest = (
 818:     atId: string,
 819:     title: string,
 820:     optsOrBody: AtTestOptions | AtTestBody<R, K>,
 821:     maybeBody?: AtTestBody<R, K>,
 822:   ): void => {
 823:     const opts: AtTestOptions = typeof optsOrBody === 'function' ? {} : optsOrBody;
 824:     const body = (typeof optsOrBody === 'function' ? optsOrBody : maybeBody) as AtTestBody<R, K>;
 825:     atTest<R, K>(atId, title, { ...opts, ...binding }, body);
 826:   };
 827: 
 828:   // Annotated here rather than left to the contextual type from `BindSuiteFn`: inside the object
 829:   // literal the context would supply that alias's own `R`/`K`, which TypeScript treats as unrelated
 830:   // to this implementation's â€” the "two different types with this name exist" rejection. Naming the
 831:   // type against the local parameters is what makes `binding` line up with the call below.
 832:   const boundCapture: BoundDefineEvidenceCapture<R, K> = (name, producer) =>
 833:     defineEvidenceCapture(binding, name, producer);
 834: 
 835:   return {
 836:     atTest: boundAtTest,
 837:     defineEvidenceCapture: boundCapture,
 838:   };
 839: };
