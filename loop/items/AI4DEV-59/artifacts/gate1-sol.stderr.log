 215:   if (typeof rawVersion !== 'string' || rawVersion.trim() === '') {
 216:     return refuse(
 217:       'the ToS + Platform Promise acknowledgment text version is required â€” an acknowledgment that does not say which text was accepted records nothing',
 218:     );
 219:   }
 220: 
 221:   return accept({
 222:     accountType,
 223:     organizationName,
 224:     acknowledgmentTextVersion: rawVersion.trim(),
 225:     // NULL FOR AN NGO EVEN WHEN ONE IS LINKED. An NGO's account may well carry a GitHub identity â€”
 226:     // nothing forbids it â€” but the GitHub link and the onboarding import it fires are volunteer
