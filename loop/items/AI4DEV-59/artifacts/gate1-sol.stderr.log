 134:  * The exploit needed `W` at its DEFAULT, which is what made it easy to miss: a suite that pinned its
 135:  * own world type (as REQ-016 did) resolved `w` to that type and never saw the merged member â€” which
 136:  * hid the hole rather than closing it.
 137:  *
 138:  * A suite can no longer pin a world type at all. AI4DEV-31 derives `w` from the adapter that really
 139:  * produces it, so this type's job is now only what it always said on the tin: the minimum the
 140:  * harness needs in order to tear a world down, which is why `suite-adapters.ts` constrains every
 141:  * registered adapter's `fixtures.world()` to return one.
 142:  */
 143: export type WorldLike = {
 144:   teardown(): Promise<void>;
 145: };
 146: 
 147: /** Re-tuned pinned values for ONE world. Keys are the at-config registry's dotted keys. */
 148: export type ConfigOverrides = Record<string, number | boolean>;
 149: 
 150: export interface HarnessModule {
 151:   createHarness(opts: { requirement: string; tier: Tier; configOverrides?: ConfigOverrides }): Promise<AtHarness>;
 152: }
 153: 
 154: let harnessModule: HarnessModule | null = null;
 155: let harnessResolveError = '';
 156: 
 157: try {
 158:   const mod = (await import(/* @vite-ignore */ HARNESS_MODULE)) as Partial<HarnessModule>;
 159:   if (typeof mod.createHarness !== 'function') {
 160:     harnessResolveError = `resolved ${HARNESS_MODULE} but it exports no createHarness()`;
 161:   } else {
 162:     harnessModule = mod as HarnessModule;
 163:   }
 164: } catch (err) {
 165:   harnessResolveError = err instanceof Error ? err.message : String(err);
 166: }
 167: 
 168: /* ---------------------------------------------------------------------------- pending errors */
 169: 
 170: export type PendingPhase = 'harness-missing' | 'sut-missing' | 'tier-unset';
 171: 
 172: export class AtPending extends Error {
 173:   constructor(
 174:     readonly atId: string,
 175:     readonly phase: PendingPhase,
 176:     detail: string,
 177:   ) {
 178:     super(`${atId} PENDING [${phase}] â€” ${detail}`);
 179:     this.name = 'AtPending';
 180:   }
 181: }
 182: 
 183: /* --------------------------------------------------------------------------- the test context */
 184: 
 185: /**
 186:  * THE STRUCTURE of what `open()` hands back, parameterized by shape and NOT EXPORTED.
 187:  *
 188:  * The exported `OpenWorld` below takes a requirement and a sut key instead, and this is why. Any
 189:  * exported type generic over the SUT's shape is a way back into the hole, and not through the door
 190:  * anyone was watching: leave `bindSuite` alone, and widen the type at the BODY instead â€”
 191:  * `async (ctx: AtContext<NotificationsSut & { invented?: string }, World>) => â€¦` â€” then read the
 192:  * invented member. It needs no cast and no suppression. It was measured compiling clean against the
 193:  * first version of this change, with every other door already shut.
 194:  *
 195:  * NOTHING STRUCTURAL CAN REJECT IT, which is the part worth writing down. `NotificationsSut` and
 196:  * `NotificationsSut & { invented?: string }` are assignable in BOTH directions â€” an optional member
 197:  * adds no obligation â€” so they are indistinguishable to the assignability check however the
 198:  * variance is arranged. Marking the parameter invariant does not help; nor does any conditional
 199:  * "exactly this type" trick, because both directions genuinely hold.
 200:  *
 201:  * So what this closes is the INVITED spelling. `OpenWorld`, `AtContext`, `AtTestBody` and
 202:  * `EvidenceCapture` are exported over `<R, K>` â€” a requirement and a sut key, both of which derive â€”
 203:  * and the shape-parameterized versions stay inside this module. The old API positively ASKED a suite
 204:  * to name its seam types; the new one hands it nothing to name them with. That is the same decision
 205:  * D1 made for `bindSuite`, carried to the rest of the exported surface rather than stopped one type
 206:  * short.
 207:  *
 208:  * IT IS NOT UNSPELLABLE, AND AN EARLIER VERSION OF THIS COMMENT SAID IT WAS. Gate 2 refuted that by
 209:  * compiling the refutation, and it was reproduced here before being accepted. A determined author
 210:  * rebuilds the widened type out of the derived ones:
 211:  *
 212:  *   type WidenedCtx = Omit<AtContext<'req-016','notifications'>, 'open'> & {
 213:  *     open(): Promise<OpenWorld<'req-016','notifications'> & { sut: { invented?: string } }>;
 214:  *   };
 215:  *
 216:  * Exit 0 â€” through the bound `atTest`, the raw `atTest` and `defineEvidenceCapture` alike, with no
 217:  * cast, no `any`, no suppression and no module augmentation. NOTHING IN THE TYPE SYSTEM CAN STOP IT,
 218:  * for the reason two paragraphs up: the widened type and the derived one are assignable in both
 219:  * directions, so no annotation the harness writes can tell them apart. Closing it means INSPECTING
 220:  * SOURCE â€” permitting only inline, unannotated bodies â€” which is a different kind of machinery,
 221:  * filed as its own item rather than built here (AI4DEV-37).
 222:  *
 223:  * The line is worth stating as a rule rather than as an excuse. What is closed is a suite NAMING the
 224:  * seam types, and with it every route the API used to invite. What is open is a hand-written
 225:  * structural reconstruction, which is a decision somebody takes rather than a mistake they make.
 226:  * `tests/at/typeprobes/sut-seam.probe.ts` carries it verbatim as a documented known-open case (it
 227:  * cannot be an active probe there, because that program must not compile and this attack does), and
 228:  * `loop/items/AI4DEV-31/gate2-widen-reproduction.txt` is the compile transcript with its controls.
 229:  */
 230: type SeamOpenWorld<Sut = unknown, W extends WorldLike = WorldLike> = {
 231:   /**
 232:    * The harness, at EXACTLY the type `createHarness()` is statically checked to produce â€” not a
 233:    * suite-chosen type, and not the suite's type arguments pushed back into it.
 234:    *
 235:    * Two doors are shut here, and both were opened by earlier drafts of this file. A free type
 236:    * parameter (`H extends HarnessLike`) let a suite declare seams the factory never supplies, since
 237:    * an intersection is a subtype and satisfies the constraint. Re-labelling the produced harness
 238:    * with the suite's own world and channel types was the same defect wearing a smaller hat: the
 239:    * factory proves `AtHarness<â€¦, WorldSeam, string>`, so a suite binding channel `'sms'` would have
 240:    * been told `vendors.email.attempts()` yields `'sms'` on the strength of nothing at all.
 241:    *
 242:    * `h` is deliberately NOT re-parameterized by AI4DEV-31 either. Deriving `w` and `sut` from the
 243:    * adapter does not license pushing them back into the harness: that is the same door, and it
 244:    * stays shut.
 245:    */
 246:   h: AtHarness;
 247:   /**
 248:    * The fixture world, at the type the requirement's ADAPTER really returns â€” `WorldOf<R>`, read
 249:    * off `fixtures.world`'s return type in `suite-adapters.ts`.
 250:    *
 251:    * It used to be the suite's own type argument, asserted rather than verified, so
 252:    * `bindSuite<NotificationsSut, AnythingAtAll>` type-checked green and a body could read members
 253:    * no fixture supplies. `tests/at/typeprobes/sut-seam-legacy.probe.ts` is that attack, kept alive:
 254:    * it compiled clean before this change and must fail now.
 255:    */
 256:   w: W;
 257:   /**
 258:    * The requirement's system under test, at the type its ADAPTER declares (`SutOf<R, K>`), and
 259:    * guaranteed non-null once open() returns.
 260:    *
 261:    * WHAT IS ACTUALLY CHECKED, precisely, because a closure claim wider than the truth is the defect
 262:    * this item removes: the adapter annotates what it builds (`const sut: NotificationsSut = â€¦`), so
 263:    * the shape is proven at the producer; the suite reads that type instead of restating it; the
 264:    * `requirement` literal ties the map entry, the module the type came from and the module
 265:    * `loadAdapter()` really imports to one self-declared value, checked at compile time AND again at
 266:    * run time. One assertion survives, at the end of `open()`, and it is commented there.
 267:    *
 268:    * WHAT IS NOT CHECKED: `any`, `as`, `@ts-ignore`, `@ts-nocheck`, mutating the adapter's object at
 269:    * run time, pointing `AT_REPO_ROOT` at a different tree, and REBUILDING A WIDENED CONTEXT BY HAND
 270:    * out of the derived types (measured, and documented on `SeamOpenWorld` above) all still work. The
 271:    * threat model is a suite DRIFTING from its harness with nobody able to notice â€” an honest mistake
 272:    * that type-checks green â€” not an author set on defeating the type system, who can always write a
 273:    * cast, and who now has to write something at least as deliberate as one.
 274:    */
 275:   sut: Sut;
 276: };
 277: 
 278: /**
 279:  * What `open()` hands a test body, for the suite bound to requirement `R` and sut key `K`.
 280:  *
 281:  * Named by TWO STRINGS, never by a shape â€” see `SeamOpenWorld` above for why that distinction is
 282:  * the whole protection rather than a stylistic preference.
 283:  */
 284: export type OpenWorld<R extends SuiteId, K extends SutKeyOf<R>> = SeamOpenWorld<SutOf<R, K>, WorldOf<R>>;
 285: 
 286: export interface OpenOverrides {
 287:   /**
 288:    * Re-tune pinned values for THIS world only, so one authored body can be run against two
 289:    * materially different configurations. A key the at-config registry does not already carry
 290:    * throws: an override may re-tune a knob that exists, never invent one the product has not
 291:    * got.
 292:    */
 293:   config?: ConfigOverrides;
 294: }
 295: 
 296: /** The STRUCTURE of what a test body is given â€” not exported, for the reason on `SeamOpenWorld`. */
 297: type SeamContext<Sut = unknown, W extends WorldLike = WorldLike> = {
 298:   atId: string;
 299:   /** build a fresh "Given" world (and its own harness). Call it more than once for isolation. */
 300:   open(fixture?: string, opts?: OpenOverrides): Promise<SeamOpenWorld<Sut, W>>;
 301:   /** consume an immutable capture whose producer proved at least one real open() */
 302:   capture<T>(evidence: EvidenceCaptureImpl<T, Sut, W>): Promise<T>;
 303: };
 304: 
 305: /** Everything a test body is given. `atId` is read-only context, never re-supplied to open(). */
 306: export type AtContext<R extends SuiteId, K extends SutKeyOf<R>> = SeamContext<SutOf<R, K>, WorldOf<R>>;
 307: 
 308: const USAGE = Symbol('at-context-usage');
 309: 
 310: interface Usage {
 311:   opens: number;
 312:   captures: number;
 313: }
 314: 
 315: /**
 316:  * NOT EXPORTED, and a type alias rather than an interface, for the two different reasons this file
 317:  * keeps apart: not exported so no suite can name it, an alias so nothing can merge a member into it
 318:  * even from inside this module. It is reachable from a test body â€” `capture()` hands it to an
 319:  * evidence producer â€” and everything on that path obeys the alias rule.
 320:  */
 321: type InternalContext<Sut, W extends WorldLike> = SeamContext<Sut, W> & {
 322:   [USAGE]: Usage;
 323: };
 324: 
 325: /** Where in the captured structure a value sits, said in words a test author can act on. */
 326: function evidencePath(path: string): string {
 327:   return path ? `the captured value at ${JSON.stringify(path)}` : 'the captured value';
 328: }
 329: 
 330: function constructorName(value: object): string {
 331:   return Object.getPrototypeOf(value)?.constructor?.name ?? 'an object with an exotic prototype';
 332: }
 333: 
 334: /**
 335:  * Deep-freeze a capture â€” and REFUSE anything that freezing does not actually make immutable.
 336:  *
 337:  * `Object.freeze` is shallow in a second sense nobody expects: it seals a Map's own properties
 338:  * and leaves `set`/`delete` fully working, and the same is true of a Set, a Date and any class
 339:  * instance with mutating methods. So a capture carrying one of those LOOKS frozen and is not â€”
 340:  * which defeats the whole point of capture-once/assert-many, where one lens normalizing or
 341:  * de-duplicating evidence in place would hide it from the next lens. Silently freezing such a
 342:  * value is worse than rejecting it, because the immutability the suites are told to rely on
 343:  * would be a lie in exactly the cases that matter.
 344:  *
 345:  * So the accepted shapes are the ones freezing genuinely closes: primitives, arrays, and plain
 346:  * objects (`Object.prototype` or a null prototype â€” what `structuredClone` and object literals
 347:  * produce). Everything else throws, naming the path, so the producer converts it to inert data
 348:  * (a Date to an ISO string, a Map to entries) where the conversion is visible.
 349:  */
 350: export function freezeEvidence<T>(value: T, path = '', seen = new WeakSet<object>()): T {
 351:   if (value === null) return value;
 352:   const type = typeof value;
 353:   if (type === 'undefined' || type === 'string' || type === 'number' || type === 'boolean' || type === 'bigint') return value;
 354:   if (type === 'function') {
 355:     throw new Error(`${evidencePath(path)} is a function â€” captured evidence must be inert data, not something that can still run`);
 356:   }
 357:   if (type === 'symbol') {
 358:     throw new Error(`${evidencePath(path)} is a symbol â€” captured evidence must be inert data an assertion can read`);
 359:   }
 360: 
 361:   const object = value as unknown as object;
 362:   if (seen.has(object)) return value;
 363:   seen.add(object);
 364: 
 365:   if (Array.isArray(object)) {
 366:     for (const [index, child] of object.entries()) freezeEvidence(child, `${path}[${index}]`, seen);
 367:     return Object.freeze(value);
 368:   }
 369: 
 370:   const proto = Object.getPrototypeOf(object);
 371:   if (proto !== null && proto !== Object.prototype) {
 372:     throw new Error(
 373:       `${evidencePath(path)} is a ${constructorName(object)} â€” freezeEvidence accepts only primitives, ` +
 374:         `arrays and plain objects, because Object.freeze leaves a Map, Set, Date or class instance ` +
 375:         `mutable through its own methods. Capture it as inert data instead.`,
 376:     );
 377:   }
 378: 
 379:   for (const [key, child] of Object.entries(object as Record<string, unknown>)) {
 380:     freezeEvidence(child, path ? `${path}.${key}` : key, seen);
 381:   }
 382:   return Object.freeze(value);
 383: }
 384: 
 385: export function captureProducerProblem(opensBefore: number, opensAfter: number): string | null {
 386:   return opensAfter === opensBefore ? 'capture producer completed without open()' : null;
 387: }
 388: 
 389: /**
 390:  * The implementation class, DELIBERATELY NOT EXPORTED â€” only the type alias below is.
 391:  *
 392:  * An exported class is a value with a public constructor, so `new EvidenceCapture<T, Anything,
 393:  * AnythingElse>(name, producer)` was a way to hand a producer a fabricated `AtContext` without ever
 394:  * touching `bindSuite`: the same lie as the one AI4DEV-31 closes at `open()`, reached through a
 395:  * `new`. Exporting only the type removes the constructor from a suite's reach, and has the second
 396:  * effect of making `EvidenceCapture` a type ALIAS, which declaration merging cannot open.
 397:  */
 398: class EvidenceCaptureImpl<T, Sut = unknown, W extends WorldLike = WorldLike> {
 399:   private result: Promise<T> | null = null;
 400:   private producerAtId = '';
 401: 
 402:   constructor(
 403:     readonly name: string,
 404:     /** the suite this capture reads the seam of â€” it is in the failure text so a red says whose */
 405:     readonly requirement: string,
 406:     private readonly producer: (ctx: SeamContext<Sut, W>) => Promise<T>,
 407:   ) {}
 408: 
 409:   consume(ctx: InternalContext<Sut, W>): Promise<T> {
 410:     if (!this.result) {
 411:       this.producerAtId = ctx.atId;
 412:       const opensBefore = ctx[USAGE].opens;
 413:       this.result = (async () => {
 414:         try {
 415:           const value = await this.producer(ctx);
 416:           const problem = captureProducerProblem(opensBefore, ctx[USAGE].opens);
 417:           if (problem) {
 418:             throw new Error(`evidence capture ${JSON.stringify(this.name)} produced by ${ctx.atId} â€” ${problem}`);
 419:           }
 420:           return freezeEvidence(value);
 421:         } catch (err) {
 422:           const detail = err instanceof Error ? err.message : String(err);
 423:           throw new Error(
 424:             `evidence capture ${JSON.stringify(this.name)} (${this.requirement}) produced by ${this.producerAtId} failed â€” ${detail}`,
 425:             { cause: err },
 426:           );
 427:         }
 428:       })();
 429:     }
 430:     return this.result;
 431:   }
 432: }
 433: 
 434: /**
 435:  * An immutable capture, consumable by any test in the suite that defined it.
 436:  *
 437:  * A TYPE, never the class â€” and named by a requirement and a sut key, never by a shape. Both halves
 438:  * matter: the class would expose a constructor that takes a producer at any types, and shape
 439:  * parameters would let a body widen the context it is handed. See `SeamOpenWorld`.
 440:  */
 441: export type EvidenceCapture<T, R extends SuiteId, K extends SutKeyOf<R>> = EvidenceCaptureImpl<T, SutOf<R, K>, WorldOf<R>>;
 442: 
 443: /**
 444:  * `defineEvidenceCapture` was the SECOND door to the seam AI4DEV-31 closes, and closing `bindSuite`
 445:  * alone would have moved the defect rather than removed it: this function handed its producer a
 446:  * full `AtContext<Sut, W>` at whatever types the caller named, so a suite that never called
 447:  * `bindSuite` could still declare a system under test and a world out of nothing and read both green.
 448:  *
 449:  * So it takes the BINDING and derives, exactly as `atTest` does. There is no type argument left to
 450:  * lie with: `SutOf<R, K>` and `WorldOf<R>` come from the adapter registered under `R`.
 451:  *
 452:  * A `const` typed by a call-signature alias, NOT an exported `function` declaration â€” that is not
 453:  * stylistic. Gate 1 measured that an exported function declaration can be given a fresh generic
 454:  * overload through `declare module`, restoring the fabricated type argument, and that type aliases
 455:  * do not protect it. A `const` has no declaration to merge an overload into.
 456:  */
 457: type DefineEvidenceCaptureFn = <T, R extends SuiteId, K extends SutKeyOf<R>>(
 458:   binding: SuiteBinding<R, K>,
 459:   name: string,
 460:   producer: (ctx: AtContext<R, K>) => Promise<T>,
 461: ) => EvidenceCapture<T, R, K>;
 462: 
 463: export const defineEvidenceCapture: DefineEvidenceCaptureFn = (binding, name, producer) =>
 464:   new EvidenceCaptureImpl(name, binding.requirement, producer);
 465: 
 466: export function testUseProblem(opens: number, captures: number): string | null {
 467:   return opens === 0 && captures === 0 ? 'test body never opened a fixture world or consumed trusted captured evidence' : null;
 468: }
 469: 
 470: /**
 471:  * Runs one body and refuses a pass that observed nothing.
 472:  *
 473:  * Still parameterized by SHAPE rather than by `<R, K>`, and that is not an oversight. It is not a
 474:  * door to the seam: it never produces a harness-backed value, so the only context it can be given
 475:  * is one the caller built by hand â€” fabricating a type there is a caller lying to itself about its
 476:  * own object, with no harness claim anywhere in it. Keeping the structural signature is also what
 477:  * lets `conformance.selftest.ts` drive it with a hand-built context, which is the point of the
 478:  * false-green reproduction it appears in.
 479:  */
 480: export async function executeRegisteredBody<Sut, W extends WorldLike>(
 481:   atId: string,
 482:   body: (ctx: SeamContext<Sut, W>) => Promise<void>,
 483:   ctx: SeamContext<Sut, W>,
 484:   usage: Usage,
 485: ): Promise<void> {
 486:   await body(ctx);
 487:   const problem = testUseProblem(usage.opens, usage.captures);
 488:   if (problem) throw new Error(`${atId} INVALID â€” ${problem}`);
 489: }
 490: 
 491: /* ------------------------------------------------------------------------ teardown accounting */
 492: 
 493: /** One thing a test built and must give back, named so a failure says which one. */
 494: export interface TrackedTeardown {
 495:   /** plain words for the thing being torn down, e.g. `fixture world "req-016/base"` */
 496:   what: string;
 497:   teardown(): Promise<void>;
 498: }
 499: 
 500: export interface TeardownFailure {
 501:   what: string;
 502:   error: unknown;
 503: }
 504: 
 505: function errorText(error: unknown): string {
 506:   return error instanceof Error ? error.message : String(error);
 507: }
 508: 
 509: /**
 510:  * Tear down everything the test built â€” worlds first, then harnesses, last-opened-first within
 511:  * each â€” ATTEMPTING EVERY ONE and collecting the rejections rather than stopping at the first.
 512:  *
 513:  * Attempting all of them is the point: giving up after one rejection leaves the rest of the stack
 514:  * standing, and a frozen clock, an armed fault or a vendor counter that survives into the next id
 515:  * is exactly the cross-test leak the per-test teardown exists to prevent.
 516:  */
 517: export async function drainTeardowns(worlds: TrackedTeardown[], harnesses: TrackedTeardown[]): Promise<TeardownFailure[]> {
 518:   const failures: TeardownFailure[] = [];
 519:   const drain = async (stack: TrackedTeardown[]) => {
 520:     while (stack.length) {
 521:       const entry = stack.pop()!;
 522:       try {
 523:         await entry.teardown();
 524:       } catch (err) {
 525:         failures.push({ what: entry.what, error: err });
 526:       }
 527:     }
 528:   };
 529:   await drain(worlds);
 530:   await drain(harnesses);
 531:   return failures;
 532: }
 533: 
 534: /**
 535:  * One acceptance test's whole lifecycle: run the body, tear everything down, then decide.
 536:  *
 537:  * WHY THE VERDICT LIVES HERE rather than in a `finally` that swallows teardown rejections â€”
 538:  * which is what this used to do: a world whose teardown rejected did NOT release what it holds,
 539:  * so the next id inherits it. Reporting that as green is a false green of the worst kind, because
 540:  * the damage lands on a different test and the report blames the wrong id.
 541:  *
 542:  * When the body already failed, the body's error still wins the report: it is the more specific
 543:  * fact, and a teardown that rejects because the body left the world half-built is a symptom, not
 544:  * the cause. The teardown failures are printed so they are never invisible.
 545:  */
 546: export async function runTrackedTest(
 547:   atId: string,
 548:   run: () => Promise<void>,
 549:   worlds: TrackedTeardown[],
 550:   harnesses: TrackedTeardown[],
 551: ): Promise<void> {
 552:   let bodyFailed = false;
 553:   let bodyError: unknown;
 554:   try {
 555:     await run();
 556:   } catch (err) {
 557:     bodyFailed = true;
 558:     bodyError = err;
 559:   }
 560: 
 561:   const failures = await drainTeardowns(worlds, harnesses);
 562: 
 563:   if (bodyFailed) {
 564:     for (const failure of failures) {
 565:       console.error(`${atId} â€” teardown ALSO failed (${failure.what}): ${errorText(failure.error)}`);
 566:     }
 567:     throw bodyError;
 568:   }
 569: 
 570:   if (failures.length) {
 571:     const summary = failures.map((failure) => `${failure.what}: ${errorText(failure.error)}`).join('; ');
 572:     throw new AggregateError(
 573:       failures.map((failure) => (failure.error instanceof Error ? failure.error : new Error(errorText(failure.error)))),
 574:       `${atId} INVALID â€” the body passed but ${failures.length} teardown${failures.length === 1 ? '' : 's'} failed, ` +
 575:         `so state this test built leaks into the next id: ${summary}`,
 576:     );
 577:   }
 578: }
 579: 
 580: interface OpenOptions {
 581:   atId: string;
 582:   requirement: string;
 583:   sutKey: string;
 584:   sutMissing: string;
 585:   fixture: string;
 586:   configOverrides?: ConfigOverrides;
 587: }
 588: 
 589: /**
 590:  * Builds a harness and a world, at the types the HARNESS can actually prove: `sut` is `unknown`
 591:  * (`h.sut[key]` on a concrete `AtHarness`) and `w` is a bare `WorldLike`. It deliberately knows
 592:  * nothing about any suite â€” the narrowing to that suite's derived types happens once, at the end of
 593:  * `open()`, where the comment says exactly what is still taken on trust.
 594:  */
 595: async function openWorld(o: OpenOptions): Promise<{ opened: SeamOpenWorld; harness: AtHarness }> {
 596:   if (TIER === null) throw new AtPending(o.atId, 'tier-unset', tierError(o.requirement));
 597: 
 598:   if (!harnessModule) {
 599:     throw new AtPending(
 600:       o.atId,
 601:       'harness-missing',
 602:       `AI4DEV-3 capability modules (H2 fixtures/clock, H3 sentinels/faults, H4 oracles, ` +
 603:         `H5 vendor sims) are not in the tree: cannot resolve "${HARNESS_MODULE}" ` +
 604:         `from tests/at/harness (${harnessResolveError})`,
 605:     );
 606:   }
 607: 
 608:   const h = await harnessModule.createHarness({
 609:     requirement: `req-${o.requirement}`,
 610:     tier: TIER,
 611:     configOverrides: o.configOverrides,
 612:   });
 613:   // Tracked from here on: every later failure must still tear the harness down.
 614:   try {
 615:     expect(h.tier, `harness built tier "${h.tier}" for a --tier ${TIER} run`).toBe(TIER);
 616: 
 617:     // Tier semantics: above `loop`, nothing the suite leans on may be a stand-in.
 618:     if (TIER !== 'loop') {
 619:       expect(await h.stubbedCapabilities(), `a ${TIER}-tier run stubbed capabilities â€” the gate would be grading a stand-in`).toEqual([]);
 620:     }
 621: 
 622:     const sut = h.sut?.[o.sutKey];
 623:     if (!sut) throw new AtPending(o.atId, 'sut-missing', o.sutMissing);
 624: 
 625:     const w = await h.fixtures.world(o.fixture);
 626:     return { opened: { h, w, sut }, harness: h };
 627:   } catch (err) {
 628:     await h.teardown().catch(() => undefined);
 629:     throw err;
 630:   }
 631: }
