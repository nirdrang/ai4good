  71: interface Args {
  72:   requirement: string;
  73:   tier: Tier;
  74:   wired: boolean;
  75:   /** Named `expectDeclared`, not `expect`, so nobody later reads it as vitest's `expect`. */
  76:   expectDeclared: boolean;
  77: }
  78: 
  79: function parseArgs(argv: string[]): Args {
  80:   let requirement = '';
  81:   let tier = '';
  82:   let wired = false;
  83:   let expectDeclared = false;
  84: 
  85:   for (let i = 0; i < argv.length; i++) {
  86:     const arg = argv[i];
  87:     if (arg === '--wired') wired = true;
  88:     else if (arg === '--expect') expectDeclared = true;
  89:     else if (arg === '--tier') tier = argv[++i] ?? '';
  90:     else if (arg.startsWith('--tier=')) tier = arg.slice('--tier='.length);
  91:     else if (arg.startsWith('--')) throw new Error(`unknown option "${arg}"`);
  92:     else if (!requirement) requirement = arg;
  93:     else throw new Error(`unexpected argument "${arg}"`);
  94:   }
  95: 
  96:   if (!requirement) throw new Error('no requirement given');
  97:   if (!tier) throw new Error('--tier is required â€” there is no default tier, by design');
  98:   if (!TIERS.includes(tier as Tier)) throw new Error(`unknown tier "${tier}" â€” expected one of ${TIERS.join('|')}`);
  99:   // Refused here rather than later: `--wired` runs no tests at all, so there would be no report
 100:   // for a declaration to be checked against, and a declaration refusal must never be reported as
 101:   // the wired refusal. A usage error exits 2, which is what a `--expect` command that cannot be
 102:   // honoured is required to do.
 103:   if (wired && expectDeclared) {
 104:     throw new Error('--expect and --wired cannot be combined: --wired runs no tests, so there is no report for a declaration to be checked against');
 105:   }
 106: 
 107:   return { requirement: normalizeRequirement(requirement), tier: tier as Tier, wired, expectDeclared };
 108: }
