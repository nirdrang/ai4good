 983:   }
 984: 
 985:   let expected: string[];
 986:   try {
 987:     const preflight = inspectBijection(requirement);
 988:     expected = preflight.expected;
 989:     if (preflight.problems.length) {
 990:       console.error(`at:verify req-${requirement} â€” ATâ†”code preflight refused the run: ${preflight.problems.join('; ')}`);
 991:       return 2;
 992:     }
 993:   } catch (err) {
 994:     console.error(`at:verify req-${requirement} â€” ${(err as Error).message}`);
 995:     return 2;
 996:   }
 997: 
 998:   // The declaration preflight sits HERE for two reasons, both load-bearing. It needs the
 999:   // acceptance file's P0 id set, which only exists after the bijection preflight above; and every
1000:   // refusal must run NO tests, so it must precede the vitest spawn. Placing it before the stack
1001:   // sequence as well means a bad declaration never takes the machine-wide lock, never talks to
1002:   // Docker and never resets a database â€” the refusal costs nothing at any tier.
1003:   let expectation: TierExpectation | null = null;
1004:   if (expectDeclared) {
1005:     try {
1006:       expectation = loadTierExpectation(requirement, tier, expected);
1007:     } catch (err) {
1008:       console.error(`at:verify req-${requirement} --tier ${tier} --expect â€” DECLARATION REFUSED: ${(err as Error).message}`);
1009:       console.error(`No tests were run. The declaration is the contract; fix ${expectedManifestPath(requirement)}.`);
1010:       return 2;
1011:     }
1012:   }
1013: 
1014:   const infra = (message: string): number => {
1015:     console.error(`at:verify req-${requirement} --tier ${tier} â€” INFRASTRUCTURE: ${message}`);
1016:     console.error('No tests were run. This is an infrastructure failure, not a test failure.');
1017:     return 3;
1018:   };
1019: 
1020:   const stackHelp =
1021:     `Two things cause this:\n` +
1022:     `  1. Docker Desktop is not installed, or is installed but not running, or its CLI is not on ` +
1023:     `PATH â€” the local stack is a set of Docker containers and cannot run without it.\n` +
1024:     `  2. Docker is fine but the stack was never started â€” run \`bun run db:start\`.`;
1025: 
1026:   // The `loop` tier touches no database: no lock, no stack, no reset.
1027:   const stackEnv: Record<string, string> = {};
1028:   let lock: StackLock | null = null;
1029:   const reportDir = mkdtempSync(join(tmpdir(), 'at-verify-'));
1030:   const registrationDir = join(reportDir, 'registrations');
1031:   mkdirSync(registrationDir);
1032:   const cleanup = () => {
1033:     cleanupRun(reportDir, lock);
1034:     lock = null;
1035:   };
1036:   const onSignal = () => {
1037:     cleanup();
1038:     process.exit(130);
1039:   };
1040:   process.once('SIGINT', onSignal);
1041:   process.once('SIGTERM', onSignal);
1042: 
1043:   try {
1044:     if (tier !== 'loop') {
1045:       let config: LocalConfig;
1046:       try {
1047:         config = readLocalConfig();
1048:       } catch (err) {
1049:         return infra((err as Error).message);
1050:       }
1051: 
1052:       // (1) Lock FIRST â€” before anything reads, resets or runs against the stack.
1053:       try {
1054:         lock = acquireStackLock(config, `req-${requirement}`);
1055:       } catch (err) {
1056:         return infra((err as Error).message);
1057:       }
1058: 
1059:       // (2) Read the stack's report of itself and prove it is local, BEFORE anything destructive.
1060:       let status: StackStatus;
1061:       try {
1062:         status = readStackStatus();
1063:       } catch (err) {
1064:         return infra(`${(err as Error).message}\n${stackHelp}`);
1065:       }
1066: 
1067:       const problems = localStackProblems(status, config);
1068:       if (problems.length) {
1069:         return infra(
1070:           `the stack that answered is not provably the local development stack, so nothing was reset ` +
1071:             `and nothing was run. Failed checks: ${problems.join('; ')}. (Values are deliberately not printed.)`,
1072:         );
1073:       }
1074: 
1075:       // (3) Readiness before the destructive step.
1076:       try {
1077:         await waitForReady(status, 'before the reset');
1078:       } catch (err) {
