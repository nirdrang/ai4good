 248: /* ---------------------------------------------------------------------- the machine-wide lock */
 249: 
 250: interface StackLock {
 251:   file: string;
 252:   release(): void;
 253: }
 254: 
 255: function lockDir(): string {
 256:   const base = process.env.LOCALAPPDATA ?? process.env.XDG_CACHE_HOME ?? tmpdir();
 257:   const dir = join(base, 'ai4good-build', 'at-locks');
 258:   mkdirSync(dir, { recursive: true });
 259:   return dir;
 260: }
 261: 
 262: function processIsAlive(pid: number): boolean {
 263:   try {
 264:     process.kill(pid, 0);
 265:     return true;
 266:   } catch (err) {
 267:     // EPERM means it exists but belongs to someone else; ESRCH means it is gone.
 268:     return (err as NodeJS.ErrnoException).code === 'EPERM';
 269:   }
 270: }
 271: 
 272: /** The lock path for one stack. Machine-wide, and deliberately carries no folder component. */
 273: export function stackLockPath(config: LocalConfig): string {
 274:   return join(lockDir(), `at-verify-${config.projectId}-${config.apiPort}.lock`);
 275: }
 276: 
 277: interface Holder {
 278:   pid?: number;
 279:   host?: string;
 280:   requirement?: string;
 281:   startedAt?: string;
 282: }
 283: 
 284: /** Live = the recorded process still exists AND the lock is young enough to be a real run. */
 285: function holderIsLive(holder: Holder): boolean {
 286:   const startedAt = holder.startedAt ? Date.parse(holder.startedAt) : NaN;
 287:   const ageMinutes = Number.isFinite(startedAt) ? (Date.now() - startedAt) / 60_000 : Infinity;
 288:   return typeof holder.pid === 'number' && processIsAlive(holder.pid) && ageMinutes < LOCK_STALE_MINUTES;
 289: }
 290: 
 291: function heldByAnotherRun(holder: Holder, file: string): Error {
 292:   return new Error(
 293:     `another at:verify run holds this stack (pid ${holder.pid} on ${holder.host ?? 'this machine'}, ` +
 294:       `requirement ${holder.requirement ?? 'unknown'}, started ${holder.startedAt ?? 'unknown'}). ` +
 295:       `Two runs against one stack destroy each other: the second would reset the first's database ` +
 296:       `mid-run. Wait for it to finish. If that process is definitely gone, delete ${file}.`,
 297:   );
 298: }
 299: 
 300: /**
 301:  * A gate left behind by a process that died mid-takeover. The section lasts milliseconds, so
 302:  * anything this old is certainly abandoned; removing one wrongly costs at most two processes in
 303:  * the section, which is the behaviour we had before the gate existed.
 304:  */
 305: function clearStrandedGate(gate: string): void {
 306:   try {
 307:     const held = JSON.parse(readFileSync(gate, 'utf8')) as { pid?: number; at?: string };
 308:     const at = held.at ? Date.parse(held.at) : NaN;
 309:     const ageMinutes = Number.isFinite(at) ? (Date.now() - at) / 60_000 : Infinity;
 310:     const alive = typeof held.pid === 'number' && processIsAlive(held.pid);
 311:     if (!alive || ageMinutes > GATE_STALE_MINUTES) rmSync(gate, { force: true });
 312:   } catch {
 313:     // unreadable or already gone â€” the next pass finds out
 314:   }
 315: }
 316: 
 317: /**
 318:  * Serialize every destructive run against one stack. The key is project id + api port because
 319:  * that pair IS the stack's identity: a second checkout carrying the same `project_id` shares the
 320:  * same Docker containers and the same ports, so its `at:verify` would reset this run's database
 321:  * out from under it. Mirrors `Acquire-WorkLock` in loop/work/work-lib.ps1 â€” exclusive create,
 322:  * holder recorded, stale takeover.
 323:  *
 324:  * TAKEOVER IS THE WHOLE DIFFICULTY. Two processes can both read the same leftover lock and both
 325:  * conclude it is stale; if each then removed it and created its own, the second removal would take
 326:  * out the FIRST one's brand-new live lock and both would run â€” the precise failure this exists to
 327:  * prevent. Moving the stale file aside with an atomic rename does NOT fix that: the winner
 328:  * repopulates the path microseconds later, so the loser's rename succeeds against a LIVE lock,
 329:  * which is just as destructive as unlinking it. (Proved with a two-contender race, not reasoned
 330:  * about; the race is in runner.selftest.ts.)
 331:  *
 332:  * So the takeover DECISION is serialized by a second exclusive-create lock â€” the gate. Only one
 333:  * process is ever inside it, and it re-reads the holder INSIDE, so:
 334:  *   - no other process can be taking over concurrently (the gate is exclusive);
 335:  *   - no ordinary claim can have slipped in, because the stale file occupies the path continuously
 336:  *     until the gate holder removes it, and an exclusive create only succeeds on a free path;
 337:  *   - if a third process wins the claim in the instant after removal, the gate holder's own create
 338:  *     simply fails and it restarts, having deleted nothing further.
 339:  * A gate stranded by a killed process is cleared on age. The section lasts milliseconds, so a live
 340:  * holder never reaches that threshold, and clearing one wrongly degrades to two takers in the
 341:  * section â€” today's behaviour, not worse.
 342:  */
 343: export function acquireStackLock(config: LocalConfig, requirement: string): StackLock {
 344:   const file = stackLockPath(config);
 345: 
 346:   const claim = (): StackLock | null => {
 347:     let fd: number;
 348:     try {
 349:       fd = openSync(file, 'wx');
 350:     } catch (err) {
 351:       if ((err as NodeJS.ErrnoException).code === 'EEXIST') return null;
 352:       throw err;
 353:     }
 354:     try {
 355:       writeSync(
 356:         fd,
 357:         JSON.stringify({
 358:           pid: process.pid,
 359:           host: hostname(),
 360:           requirement,
 361:           startedAt: new Date().toISOString(),
 362:         }),
 363:       );
 364:     } finally {
 365:       closeSync(fd);
 366:     }
 367:     return {
 368:       file,
 369:       release: () => {
 370:         try {
 371:           const held = JSON.parse(readFileSync(file, 'utf8')) as { pid?: number };
 372:           if (held.pid === process.pid) rmSync(file, { force: true });
 373:         } catch {
 374:           // already removed, or unreadable â€” nothing of ours left to release
 375:         }
 376:       },
 377:     };
 378:   };
 379: 
 380:   const gate = `${file}.takeover`;
 381: 
 382:   /** The recorded holder, or null if the lock is gone. */
 383:   const readHolder = (): Holder | null => {
 384:     try {
 385:       return JSON.parse(readFileSync(file, 'utf8')) as Holder;
 386:     } catch (err) {
 387:       if ((err as NodeJS.ErrnoException).code === 'ENOENT') return null;
 388:       return {}; // unreadable or half-written: treat as an unidentifiable holder, judged below
 389:     }
 390:   };
 391: 
 392:   /** Bounded synchronous pause; a gate is held for milliseconds, so this is all the wait needed. */
 393:   const pause = (ms: number) => {
 394:     const until = Date.now() + ms;
 395:     while (Date.now() < until) {
 396:       /* spin */
 397:     }
 398:   };
 399: 
 400:   // Bounded: every retry follows another process winning the gate, which cannot repeat forever.
 401:   for (let attempt = 0; attempt < 20; attempt++) {
 402:     const claimed = claim();
 403:     if (claimed) return claimed;
 404: 
 405:     const holder = readHolder();
 406:     if (holder === null) continue; // released between the failed claim and the read
 407:     if (holderIsLive(holder)) throw heldByAnotherRun(holder, file);
 408: 
 409:     // Stale. Enter the takeover gate â€” the only place the live lock path may be removed.
 410:     let gateFd: number;
 411:     try {
 412:       gateFd = openSync(gate, 'wx');
 413:     } catch (err) {
 414:       if ((err as NodeJS.ErrnoException).code !== 'EEXIST') throw err;
 415:       clearStrandedGate(gate);
 416:       pause(10);
 417:       continue;
 418:     }
 419: 
 420:     try {
 421:       writeSync(gateFd, JSON.stringify({ pid: process.pid, at: new Date().toISOString() }));
 422:       const inside = readHolder();
 423:       if (inside === null) continue; // released while we were entering; the next claim takes it
 424:       if (holderIsLive(inside)) continue; // refreshed under us; the next pass refuses it properly
 425: 
 426:       rmSync(file, { force: true });
 427:       const takeover = claim();
 428:       if (!takeover) continue; // a third process claimed the free path first â€” delete nothing more
 429: 
 430:       console.log(
 431:         `at:verify â€” took over a stale stack lock (holder pid ${inside.pid ?? 'unknown'} ` +
 432:           `${typeof inside.pid === 'number' && processIsAlive(inside.pid) ? `is older than ${LOCK_STALE_MINUTES} minutes` : 'is no longer running'})`,
 433:       );
 434:       return takeover;
 435:     } finally {
 436:       closeSync(gateFd);
 437:       rmSync(gate, { force: true });
 438:     }
 439:   }
 440: 
 441:   throw new Error(`could not acquire the stack lock at ${file} â€” it kept changing hands; try again`);
 442: }
 443: 
 444: /* -------------------------------------------------------------------- the stack's own report */
 445: 
 446: export interface StackStatus {
 447:   apiUrl: string;
 448:   dbUrl: string;
 449:   anonKey: string;
 450:   serviceRoleKey: string;
 451: }
 452: 
 453: const REQUIRED_STATUS_FIELDS: Record<keyof StackStatus, string> = {
 454:   apiUrl: 'API_URL',
 455:   dbUrl: 'DB_URL',
 456:   anonKey: 'ANON_KEY',
 457:   serviceRoleKey: 'SERVICE_ROLE_KEY',
 458: };
 459: 
 460: function supabaseArgs(...args: string[]): string[] {
 461:   if (!existsSync(SUPABASE_ENTRY)) throw new Error(`the Supabase CLI is not installed at ${SUPABASE_ENTRY} â€” run \`bun install\``);
 462:   return ['--no-env-file', SUPABASE_ENTRY, ...args];
 463: }
 464: 
 465: /**
 466:  * Ask the running stack to describe itself. The raw output is NEVER printed: it contains every
 467:  * key the stack issues. Only field names travel into error messages.
 468:  */
 469: function readStackStatus(): StackStatus {
 470:   const res = spawnSync(bunExecutable(), supabaseArgs('status', '-o', 'json'), {
 471:     cwd: REPO_ROOT,
 472:     env: childEnv(),
 473:     encoding: 'utf8',
 474:   });
 475: 
 476:   if (res.error) {
 477:     const err = res.error as NodeJS.ErrnoException;
 478:     throw new Error(`could not launch the Supabase CLI (${err.code ?? 'spawn error'}): ${diagnostic(err.message)}`);
 479:   }
 480: 
 481:   const stdout = res.stdout ?? '';
 482:   const open = stdout.indexOf('{');
 483:   const close = stdout.lastIndexOf('}');
 484:   if (open < 0 || close <= open) {
 485:     throw new Error(
 486:       `\`supabase status\` reported no JSON (exit ${res.status}${res.signal ? `, signal ${res.signal}` : ''}): ` +
 487:         `${diagnostic(res.stderr) || '(no error output)'}`,
 488:     );
 489:   }
 490: 
 491:   // The CLI exits non-zero merely because config.toml disables imgproxy and the pooler. That is
 492:   // not a failure; anything ELSE reported stopped is.
 493:   const notice = `${stdout.slice(0, open)}\n${res.stderr ?? ''}`;
 494:   const stopped = /Stopped services:\s*\[([^\]]*)\]/.exec(notice)?.[1] ?? '';
 495:   const unexpectedStopped = stopped.split(/\s+/).filter((name) => name && !DISABLED_SERVICES.test(name));
 496:   if (unexpectedStopped.length) {
 497:     throw new Error(`the stack reports stopped services: ${unexpectedStopped.join(', ')} â€” start them before running the suite`);
 498:   }
 499: 
 500:   let parsed: Record<string, unknown>;
 501:   try {
 502:     parsed = JSON.parse(stdout.slice(open, close + 1)) as Record<string, unknown>;
 503:   } catch (err) {
 504:     throw new Error(`\`supabase status\` produced unparseable JSON: ${(err as Error).message}`);
 505:   }
 506: 
 507:   const status: Partial<StackStatus> = {};
 508:   const missing: string[] = [];
 509:   for (const [field, key] of Object.entries(REQUIRED_STATUS_FIELDS) as [keyof StackStatus, string][]) {
 510:     const value = parsed[key];
 511:     if (typeof value !== 'string' || value.trim() === '') missing.push(key);
 512:     else status[field] = value;
 513:   }
 514:   if (missing.length) throw new Error(`\`supabase status\` reported no ${missing.join(', no ')}`);
 515:   return status as StackStatus;
 516: }
 517: 
 518: /* --------------------------------------------------------- proving the stack is the LOCAL one */
 519: 
 520: const LOOPBACK = new Set(['127.0.0.1', 'localhost', '::1', '[::1]']);
 521: 
 522: function decodeJwtClaims(token: string): Record<string, unknown> | null {
 523:   const parts = token.split('.');
 524:   if (parts.length !== 3) return null;
 525:   try {
 526:     return JSON.parse(Buffer.from(parts[1], 'base64url').toString('utf8')) as Record<string, unknown>;
 527:   } catch {
 528:     return null;
 529:   }
 530: }
 531: 
 532: /**
 533:  * Refuse to touch anything that is not demonstrably the local development stack. Returns the
 534:  * names of the checks that failed â€” never the values, which are keys and connection strings.
 535:  */
 536: export function localStackProblems(status: StackStatus, config: LocalConfig): string[] {
 537:   const problems: string[] = [];
 538: 
 539:   const checkUrl = (label: string, raw: string, expectedPort: number) => {
 540:     let url: URL;
 541:     try {
 542:       url = new URL(raw);
 543:     } catch {
 544:       problems.push(`${label} is not a URL`);
 545:       return;
 546:     }
 547:     if (!LOOPBACK.has(url.hostname)) problems.push(`${label} does not point at the loopback address`);
 548:     if (url.port !== String(expectedPort)) problems.push(`${label} port is not the ${expectedPort} configured in supabase/config.toml`);
 549:   };
 550: 
 551:   checkUrl('API_URL', status.apiUrl, config.apiPort);
 552:   checkUrl('DB_URL', status.dbUrl, config.dbPort);
 553: 
 554:   const checkKey = (label: string, token: string, expectedRole: string) => {
 555:     const claims = decodeJwtClaims(token);
 556:     if (!claims) {
 557:       problems.push(`${label} is not a decodable local development JWT`);
 558:       return;
 559:     }
 560:     if (claims.iss !== 'supabase-demo') problems.push(`${label} was not issued by the local development issuer`);
 561:     if (claims.role !== expectedRole) problems.push(`${label} does not carry the ${expectedRole} role`);
 562:     if (typeof claims.ref === 'string') problems.push(`${label} carries a hosted project reference`);
 563:   };
 564: 
 565:   checkKey('ANON_KEY', status.anonKey, 'anon');
 566:   checkKey('SERVICE_ROLE_KEY', status.serviceRoleKey, 'service_role');
 567: 
 568:   return problems;
 569: }
 570: 
 571: /* --------------------------------------------------------------------------------- readiness */
 572: 
 573: interface BunSqlClient {
 574:   (strings: TemplateStringsArray, ...values: unknown[]): Promise<unknown>;
 575:   close(): Promise<void>;
 576: }
 577: type BunSqlCtor = new (url: string) => BunSqlClient;
 578: 
 579: /** Postgres itself answers a query â€” not "the port is open", which a half-started stack satisfies. */
 580: async function databaseAnswers(dbUrl: string): Promise<string | null> {
 581:   const SQL = (globalThis as { Bun?: { SQL?: BunSqlCtor } }).Bun?.SQL;
 582:   if (!SQL) return 'this runtime has no SQL client (expected bun)';
 583:   let sql: BunSqlClient | null = null;
 584:   try {
 585:     sql = new SQL(dbUrl);
 586:     await sql`select 1`;
 587:     return null;
 588:   } catch (err) {
 589:     return diagnostic((err as Error).message);
 590:   } finally {
 591:     await sql?.close().catch(() => undefined);
 592:   }
 593: }
 594: 
 595: /** One request that only succeeds if Kong routed it, PostgREST served it, and Postgres answered. */
 596: async function gatewayAnswers(status: StackStatus): Promise<string | null> {
 597:   try {
 598:     const res = await fetch(`${status.apiUrl.replace(/\/$/, '')}/rest/v1/`, {
 599:       headers: { apikey: status.anonKey, Authorization: `Bearer ${status.anonKey}` },
 600:       signal: AbortSignal.timeout(5000),
 601:     });
 602:     if (!res.ok) return `the API gateway answered ${res.status}`;
 603:     const type = res.headers.get('content-type') ?? '';
 604:     if (!type.includes('json')) return `the API gateway answered 200 but served ${type || 'no content type'}`;
 605:     return null;
 606:   } catch (err) {
 607:     return diagnostic((err as Error).message);
 608:   }
 609: }
 610: 
 611: /**
 612:  * Wait until the stack is genuinely usable, or give up. "Something answered on the port" is not
 613:  * readiness: a half-started stack answers 502/503, and a run launched against it fails in ways
 614:  * that look like test failures instead of infrastructure failures.
 615:  */
 616: async function waitForReady(status: StackStatus, phase: string): Promise<void> {
 617:   const deadline = Date.now() + READY_TIMEOUT_MS;
 618:   let lastProblem = 'not attempted';
 619:   let delay = 250;
 620: 
 621:   while (Date.now() < deadline) {
 622:     const db = await databaseAnswers(status.dbUrl);
 623:     if (db === null) {
 624:       const gateway = await gatewayAnswers(status);
 625:       if (gateway === null) return;
 626:       lastProblem = gateway;
 627:     } else {
 628:       lastProblem = `the database did not answer: ${db}`;
 629:     }
 630:     await new Promise((resolve) => setTimeout(resolve, delay));
 631:     delay = Math.min(delay * 2, 2000);
 632:   }
 633: 
 634:   throw new Error(`the stack was still not ready ${phase} after ${Math.round(READY_TIMEOUT_MS / 1000)}s â€” last problem: ${lastProblem}`);
 635: }
 636: 
 637: /* --------------------------------------------------------------------- the migration-set proof */
 638: 
 639: /**
 640:  * The migrations the reset is supposed to replay, read from disk. The CLI names them
 641:  * `<timestamp>_name.sql` and records the timestamp as the applied version, so the timestamp is
 642:  * the identity. `.gitkeep` and `README.md` are not migrations and are ignored.
 643:  */
 644: export function expectedMigrations(): string[] {
 645:   const dir = join(REPO_ROOT, 'supabase', 'migrations');
 646:   if (!existsSync(dir)) return [];
 647:   return readdirSync(dir)
 648:     .map((name) => /^(\d{14})_.*\.sql$/.exec(name)?.[1])
 649:     .filter((version): version is string => Boolean(version))
 650:     .sort();
 651: }
 652: 
 653: /** What the database says it actually replayed. */
 654: async function appliedMigrations(dbUrl: string): Promise<string[]> {
 655:   const SQL = (globalThis as { Bun?: { SQL?: BunSqlCtor } }).Bun?.SQL;
 656:   if (!SQL) throw new Error('this runtime has no SQL client (expected bun)');
 657:   let sql: BunSqlClient | null = null;
 658:   try {
 659:     sql = new SQL(dbUrl);
 660:     const rows = (await sql`select version from supabase_migrations.schema_migrations order by version`) as {
 661:       version: string;
 662:     }[];
 663:     return rows.map((row) => String(row.version)).sort();
 664:   } catch (err) {
 665:     // A database that has never had a migration applied has no history table at all. "No table"
 666:     // and "empty table" mean the same thing â€” nothing was applied â€” and saying so lets the
 667:     // comparison below name exactly which migrations are missing instead of reporting a SQL error.
 668:     const message = (err as Error).message ?? '';
 669:     if (/schema_migrations/.test(message) && /does not exist/i.test(message)) return [];
 670:     throw new Error(`could not read the migration history: ${diagnostic(message)}`);
 671:   } finally {
 672:     await sql?.close().catch(() => undefined);
 673:   }
 674: }
 675: 
 676: /** Exact set equality, both directions, named plainly. */
 677: export function migrationSetProblems(expected: string[], applied: string[]): string[] {
 678:   const missing = expected.filter((version) => !applied.includes(version));
 679:   const extra = applied.filter((version) => !expected.includes(version));
 680:   const problems: string[] = [];
 681:   if (missing.length) problems.push(`never applied: ${missing.join(', ')}`);
 682:   if (extra.length) problems.push(`applied but not in supabase/migrations: ${extra.join(', ')}`);
 683:   return problems;
 684: }
 685: 
 686: /**
 687:  * Prove the rebuild actually replayed the migration set â€” the promise `supabase/migrations/README.md`
 688:  * makes. "The reset command exited zero" is not that proof: a reset that replays NOTHING also exits
 689:  * zero, and a suite then grades an empty schema while believing it graded the real one.
 690:  *
 691:  * An empty expected set is legitimate today (no migrations have been written yet) and is allowed â€”
 692:  * but it is STATED on every run, so an empty rebuild can never be silently mistaken for a real one.
 693:  */
 694: async function proveMigrationsReplayed(status: StackStatus): Promise<void> {
 695:   const expected = expectedMigrations();
 696:   const applied = await appliedMigrations(status.dbUrl);
 697:   const problems = migrationSetProblems(expected, applied);
 698: 
 699:   const summary = `${expected.length} migration${expected.length === 1 ? '' : 's'} expected, ${applied.length} applied`;
 700:   if (problems.length) {
 701:     throw new Error(`the rebuilt database does not match supabase/migrations (${summary}) â€” ${problems.join('; ')}`);
 702:   }
 703:   console.log(
 704:     expected.length === 0
 705:       ? `at:verify â€” ${summary} â€” the schema is empty by design at this stage`
 706:       : `at:verify â€” ${summary} â€” the rebuilt schema matches supabase/migrations exactly`,
 707:   );
 708: }
 709: 
 710: /* ------------------------------------------------------------------------------------- reset */
 711: 
 712: /**
 713:  * Rebuild the local database from `supabase/migrations` â€” the same work `bun run db:reset` does,
 714:  * invoked at the pinned CLI so failures are catchable and bounded.
 715:  *
 716:  * WHY EVERY RUN: without it the second run works on the first run's leftover rows, and on a
 717:  * schema missing whatever migration landed since â€” a suite grading a database nobody established.
 718:  */
 719: async function resetLocalDatabase(): Promise<void> {
 720:   const child = spawn(bunExecutable(), supabaseArgs('db', 'reset', '--local'), {
 721:     cwd: REPO_ROOT,
 722:     env: childEnv(),
 723:     // progress is worth watching (a reset replays every migration); stderr is captured so a
 724:     // failure can be reported in our own words rather than scrolling past.
 725:     stdio: ['ignore', 'inherit', 'pipe'],
 726:   });
 727: 
 728:   let stderr = '';
 729:   child.stderr?.on('data', (chunk: Buffer) => {
 730:     stderr = (stderr + chunk.toString('utf8')).slice(-8000);
 731:   });
 732: 
 733:   let timedOut = false;
 734:   const timer = setTimeout(() => {
 735:     timedOut = true;
 736:     // Kill the TREE: the CLI shells out to the container runtime, and killing only the parent
 737:     // leaves a migration running against the database this run is about to test.
 738:     if (child.pid && process.platform === 'win32') spawnSync('taskkill', ['/PID', String(child.pid), '/T', '/F'], { stdio: 'ignore' });
 739:     else child.kill('SIGKILL');
 740:   }, RESET_TIMEOUT_MS);
 741: 
 742:   try {
 743:     await new Promise<void>((resolve, reject) => {
 744:       child.once('error', (err) => {
 745:         const e = err as NodeJS.ErrnoException;
 746:         reject(new Error(`the reset process could not be launched (${e.code ?? 'spawn error'}): ${diagnostic(e.message)}`));
 747:       });
 748:       child.once('close', (code, signal) => {
 749:         if (timedOut) {
 750:           reject(new Error(`the reset did not finish within ${Math.round(RESET_TIMEOUT_MS / 1000)}s and its process tree was killed`));
 751:         } else if (code === 0) {
 752:           resolve();
 753:         } else {
 754:           const how = code === null ? `was killed by signal ${signal}` : `exited ${code}`;
 755:           reject(new Error(`\`supabase db reset\` ${how}: ${diagnostic(stderr) || '(no error output)'}`));
 756:         }
 757:       });
 758:     });
 759:   } finally {
 760:     clearTimeout(timer);
 761:   }
 762: }
 763: 
 764: /* --------------------------------------------------------------------------- vitest json shape */
 765: 
 766: export interface AssertionResult {
 767:   title?: string;
 768:   fullName?: string;
 769:   status?: string;
 770:   failureMessages?: string[];
 771: }
 772: 
 773: /**
 774:  * The report's own arithmetic, alongside the per-test results. `--expect` needs both: the id
 775:  * parser only sees tests whose titles carry an AT id, so an untagged `it()` that fails is
 776:  * invisible to it and visible in these counts. Optional because this describes a file on disk â€”
 777:  * a missing field is validated at runtime (see `reportAccountingDeviations`), not asserted here.
 778:  */
 779: interface VitestJson {
 780:   /**
 781:    * One entry per test FILE. `status` and `message` are kept alongside the assertions because a
 782:    * file that fails to import, or whose hook throws, changes no test's status: that failure is
 783:    * visible here and nowhere else in the report.
 784:    */
 785:   testResults?: { name?: string; status?: string; message?: string; assertionResults?: AssertionResult[] }[];
 786:   numTotalTests?: number;
 787:   numPassedTests?: number;
 788:   numFailedTests?: number;
 789:   numPendingTests?: number;
 790:   numTodoTests?: number;
 791:   success?: boolean;
 792: }
 793: 
 794: export interface IdRow {
 795:   id: string;
 796:   status: 'green' | 'red' | 'missing';
 797:   detail: string;
 798: }
 799: 
 800: export interface RuntimeRegistration {
 801:   atId: string;
 802:   title: string;
 803:   surface: string;
 804: }
 805: 
 806: export interface ReportAnalysis {
 807:   rows: IdRow[];
 808:   unexpected: string[];
 809: }
 810: 
 811: function assertionId(assertion: AssertionResult): string | null {
 812:   return /^(AT-[\d.]+[a-z]?)\s+â€”/.exec(assertion.title ?? assertion.fullName ?? '')?.[1] ?? null;
 813: }
 814: 
 815: export function analyzeReportedTests(
 816:   expected: string[],
 817:   registrations: RuntimeRegistration[],
 818:   assertions: AssertionResult[],
 819: ): ReportAnalysis {
 820:   const registrationGroups = new Map<string, RuntimeRegistration[]>();
 821:   for (const registration of registrations) {
 822:     const group = registrationGroups.get(registration.atId) ?? [];
 823:     group.push(registration);
 824:     registrationGroups.set(registration.atId, group);
 825:   }
 826: 
 827:   const assertionGroups = new Map<string, AssertionResult[]>();
 828:   for (const assertion of assertions) {
 829:     const id = assertionId(assertion);
 830:     if (!id) continue;
 831:     const group = assertionGroups.get(id) ?? [];
 832:     group.push(assertion);
 833:     assertionGroups.set(id, group);
 834:   }
 835: 
 836:   const rows: IdRow[] = expected.map((id) => {
 837:     const runtime = registrationGroups.get(id) ?? [];
 838:     const results = assertionGroups.get(id) ?? [];
 839:     if (runtime.length !== 1) {
 840:       return {
 841:         id,
 842:         status: 'red',
 843:         detail:
 844:           runtime.length === 0
 845:             ? 'no runtime registration emitted by atTest'
 846:             : `${runtime.length} runtime registrations emitted by atTest; expected exactly 1`,
 847:       };
 848:     }
 849:     if (results.length !== 1) {
 850:       return {
 851:         id,
 852:         status: 'red',
 853:         detail: `${results.length} Vitest results reported; expected exactly 1`,
 854:       };
 855:     }
 856: 
 857:     const result = results[0];
 858:     const expectedTitle = `${id} â€” ${runtime[0].title}`;
 859:     if (result.title !== expectedTitle) {
 860:       return {
 861:         id,
 862:         status: 'red',
 863:         detail: `Vitest title ${JSON.stringify(result.title)} does not match runtime registration ${JSON.stringify(expectedTitle)}`,
 864:       };
 865:     }
 866:     if (result.status !== 'passed') {
 867:       return {
 868:         id,
 869:         status: 'red',
 870:         detail: firstLine(result.failureMessages?.join('\n'), `status "${result.status}"`),
 871:       };
 872:     }
 873:     return { id, status: 'green', detail: runtime[0].title };
 874:   });
 875: 
 876:   const observed = new Set([...registrationGroups.keys(), ...assertionGroups.keys()]);
 877:   const unexpected = [...observed].filter((id) => !expected.includes(id)).sort();
 878:   return { rows, unexpected };
 879: }
 880: 
 881: function runtimeRegistrations(dir: string): RuntimeRegistration[] {
 882:   const registrations: RuntimeRegistration[] = [];
 883:   for (const file of readdirSync(dir, { withFileTypes: true })) {
 884:     if (!file.isFile() || !file.name.endsWith('.jsonl')) continue;
 885:     const lines = readFileSync(join(dir, file.name), 'utf8').split(/\r?\n/).filter(Boolean);
 886:     for (const line of lines) registrations.push(JSON.parse(line) as RuntimeRegistration);
 887:   }
 888:   return registrations;
 889: }
 890: 
 891: export interface ProcessOutcome {
 892:   error?: unknown;
 893:   status: number | null;
 894:   signal?: NodeJS.Signals | null;
 895: }
 896: 
 897: /**
 898:  * The verdict is NOT "did every row go green". A vitest process can report twelve green
 899:  * assertions and still exit non-zero â€” a global teardown that threw, an unhandled rejection, a
 900:  * worker that died after its last test. Treating that as success is exactly the false green this
 901:  * harness exists to prevent, so the process's own exit is part of the verdict, and a discrepancy
 902:  * between green rows and a non-zero exit is called out rather than smoothed over.
 903:  */
 904: export function runVerdict(rows: IdRow[], unexpected: string[], run: ProcessOutcome): string[] {
 905:   const problems: string[] = [];
 906:   const red = rows.filter((r) => r.status === 'red').length;
 907:   const missing = rows.filter((r) => r.status === 'missing').length;
 908: 
 909:   if (red) problems.push(`${red} id${red === 1 ? '' : 's'} red`);
 910:   if (missing) problems.push(`${missing} id${missing === 1 ? '' : 's'} missing`);
 911:   if (unexpected.length) {
 912:     problems.push(`${unexpected.length} registered id${unexpected.length === 1 ? '' : 's'} not P0 of this requirement`);
 913:   }
 914: 
 915:   if (run.error) {
 916:     const err = run.error as NodeJS.ErrnoException;
 917:     problems.push(`the test process could not be launched (${err.code ?? 'spawn error'}): ${diagnostic(err.message)}`);
 918:   } else if (run.status !== 0) {
 919:     const how = run.status === null ? `was killed by signal ${run.signal}` : `exited ${run.status}`;
 920:     problems.push(
 921:       red || missing
 922:         ? `the test process ${how}`
 923:         : `the test process ${how} even though every id reported green â€” something failed outside the ` +
 924:             `assertions (a teardown, an unhandled rejection, a worker that died). This run is a FAILURE.`,
 925:     );
 926:   }
 927: 
 928:   return problems;
 929: }
 930: 
 931: /**
 932:  * End-of-run housekeeping. The lock release lives in a `finally` of its OWN so that it cannot be
 933:  * skipped: on Windows, removing the report directory can throw EPERM while a file in it is still
 934:  * open, and if that throw escaped, the stack lock would be stranded and every later run would
 935:  * find a leftover it has to reason about. A lost temp directory is untidy; a stranded lock blocks
 936:  * work, so the release always wins and the cleanup failure is reported instead of hidden.
 937:  */
 938: export function cleanupRun(reportDir: string, lock: { release(): void } | null): void {
 939:   try {
 940:     rmSync(reportDir, { recursive: true, force: true });
 941:   } catch (err) {
 942:     console.error(`at:verify â€” could not remove the report directory ${reportDir}: ${diagnostic((err as Error).message)}`);
 943:   } finally {
 944:     lock?.release();
 945:   }
 946: }
 947: 
 948: function firstLine(text: string | undefined, fallback: string): string {
 949:   const line = redact(text ?? '')
 950:     .split('\n')
 951:     .map((l) => l.trim())
 952:     .find((l) => l.length > 0);
 953:   return line ?? fallback;
 954: }
