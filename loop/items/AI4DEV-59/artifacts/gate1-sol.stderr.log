 958: async function main(argv: string[]): Promise<number> {
 959:   let args: Args;
 960:   try {
 961:     args = parseArgs(argv);
 962:   } catch (err) {
 963:     console.error(`at:verify â€” ${(err as Error).message}`);
 964:     console.error(USAGE);
 965:     return 2;
 966:   }
 967: 
 968:   const { requirement, tier, wired, expectDeclared } = args;
 969: 
 970:   if (wired) {
 971:     console.error(
 972:       `at:verify req-${requirement} --wired â€” the screen driver does not exist yet. Wired re-runs ` +
 973:         `drive the ui-marked ids through real screens; that driver is a later AI4DEV-3 slice, so ` +
 974:         `there is nothing to re-run against and a silent fixture run would be a false green.`,
 975:     );
 976:     return 3;
 977:   }
