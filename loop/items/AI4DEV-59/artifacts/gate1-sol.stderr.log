 172: /**
 173:  * The bun binary. Children are launched under bun deliberately â€” `--no-env-file` is a bun flag,
 174:  * and it is what stops a child from re-reading `.env`/`.env.local` for itself. Normally this
 175:  * process IS bun, so its own path is the answer; the PATH lookup only matters when something
 176:  * else (a test runner's node worker, say) is asking.
 177:  */
 178: export function bunExecutable(): string {
 179:   if (/[\\/]bun(\.exe)?$/i.test(process.execPath)) return process.execPath;
 180:   const lookup = spawnSync(process.platform === 'win32' ? 'where' : 'which', ['bun'], {
 181:     encoding: 'utf8',
 182:     env: childEnv(),
 183:   });
 184:   const found = (lookup.stdout ?? '')
 185:     .split('\n')
 186:     .map((line) => line.trim())
 187:     .find(Boolean);
 188:   if (!found) throw new Error('bun was not found on PATH â€” the harness runs its children under bun');
 189:   return found;
 190: }
