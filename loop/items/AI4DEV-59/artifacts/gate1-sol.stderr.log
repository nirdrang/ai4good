 162: function isIpv4(value: string): boolean {
 163:   const parts = value.split('.');
 164:   return parts.length === 4 && parts.every((part) => /^\d{1,3}$/.test(part) && Number(part) <= 255);
 165: }
 166: 
 167: function isIpv6(value: string): boolean {
 168:   if (value.split('::').length > 2) return false;
 169:   const abbreviated = value.includes('::');
 170:   const groups = value.split(':').filter((group) => group !== '');
 171:   if (groups.length === 0) return abbreviated; // `::` itself
 172:   const last = groups[groups.length - 1];
 173:   // `::ffff:127.0.0.1` is a legal IPv6 address whose final element is a dotted IPv4 and occupies
 174:   // two of the eight groups.
 175:   const trailingIpv4 = last.includes('.');
 176:   if (trailingIpv4 && !isIpv4(last)) return false;
 177:   const hexGroups = trailingIpv4 ? groups.slice(0, -1) : groups;
 178:   if (!hexGroups.every((group) => /^[0-9a-fA-F]{1,4}$/.test(group))) return false;
 179:   const count = hexGroups.length + (trailingIpv4 ? 2 : 0);
 180:   return abbreviated ? count < 8 : count === 8;
 181: }
