 242: function sealed<T>(name: string, verdict: CapabilityVerdict, value: T): Capability<T> {
 243:   return Object.freeze({
 244:     [CAPABILITY]: true as const,
 245:     name,
 246:     provenance: verdict.kind,
 247:     standInReason: verdict.kind === 'stand-in' ? verdict.reason : null,
 248:     realEvidence: verdict.kind === 'real' ? verdict.evidence : null,
 249:     value,
 250:   });
 251: }
 252: 
 253: /**
 254:  * The one constructor. The verdict comes from the witness registered for `name`; an unregistered
 255:  * name is refused, and a witness that cannot classify the value throws through this call.
 256:  */
 257: export function witnessedCapability<T>(name: string, value: T, evidence: CapabilityEvidence = {}): Capability<T> {
 258:   if (!name.trim()) throw new Error('a capability requires a non-empty name');
 259:   const witness = WITNESSES.get(name);
 260:   if (witness === undefined) {
 261:     throw new Error(
 262:       `refusing to construct capability ${JSON.stringify(name)}: no witness is registered for that name. The ` +
 263:         `witness table is CLOSED â€” ${[...WITNESSES.keys()].sort().join(', ')} â€” so a name nobody has decided ` +
 264:         `about is an error here rather than a default in either direction.`,
 265:     );
 266:   }
 267:   return sealed(name, witness(value, evidence), value);
 268: }
 269: 
 270: /**
 271:  * THE NAMES THIS ROUTE MAY BUILD: `fixtures.worlds` exactly, and every `sut.<key>`.
 272:  *
 273:  * `index.ts` composes the SUT names â€” `Object.entries(adapter.sut)` behind its own `sut.` literal â€”
 274:  * and strips the same prefix back off in `createHarness()`. This copy of the literal is the
 275:  * ADMISSION CHECK for the route, not a second place the name is built, and the two must stay in
 276:  * step: a change to the prefix there without a change here would refuse every SUT capability at
 277:  * construction, loudly and on the first run.
 278:  */
 279: const ADAPTER_DERIVED_EXACT = 'fixtures.worlds';
 280: const ADAPTER_DERIVED_PREFIX = 'sut.';
 281: 
 282: /**
 283:  * THE ADAPTER-DERIVED ROUTE, for the two families whose provenance comes from where the module was
 284:  * loaded rather than from anything about the value: `fixtures.worlds` and every `sut.<key>`.
 285:  *
 286:  * It returns stand-in UNCONDITIONALLY, and that is deliberate. `adapterUrl()` in `index.ts` has
 287:  * exactly one possible output today, so a route that BRANCHED on the URL would be a constant
 288:  * dressed as a check â€” the same dishonesty this file exists to remove. The URL is the CONTENT of
 289:  * the reason, so the ledger names the module really imported; it is not the condition of a test.
 290:  *
 291:  * ON THE URL, STATED AS IT ACTUALLY IS. Through the one route the harness uses, it is loader-derived:
 292:  * `loadAdapter()` computes it from REPO_ROOT plus the requirement and hands it back, and no caller
 293:  * passes a path in. THE SIGNATURE DOES NOT ENFORCE THAT â€” this parameter is a plain string and any
 294:  * caller may supply any non-empty one. What bounds it is that every outcome here is stand-in: a
 295:  * fabricated URL ADDS a name to the ledger `registry.ts` refuses above loop, so it can only make the
 296:  * closing gate stricter. The failure direction is a false RED, never a false green.
 297:  *
 298:  * THE TWO ROUTES PARTITION THE NAMESPACE, and the check below is what makes that true rather than
 299:  * merely intended. Before it, `adapterDerivedCapability('clock.controlled', strippedClock, url)`
 300:  * minted a stand-in for a name the closed witness table would have REFUSED â€” routing around the
 301:  * table through a door the table does not watch. So this route refuses any name the table knows, and
 302:  * refuses any name outside its own two families.
 303:  *
 304:  * THIS IS NOT THE PREFIX RULE THAT WAS REMOVED FROM THE WITNESS TABLE, and the difference is the
 305:  * whole justification. There, a `sut.*` prefix matched a name into a table that GRANTS A VERDICT, so
 306:  * a verdict was handed to a name nobody had decided about â€” an unlimited namespace inside a table
 307:  * whose claim was that it was closed. Here the verdict is unconditional stand-in whatever the name
 308:  * is, so matching the prefix grants nothing at all; it only restricts WHICH NAMES MAY USE THIS
 309:  * ROUTE. A prefix that decides an outcome is a hole; a prefix that decides admission is a partition.
 310:  */
 311: export function adapterDerivedCapability<T>(name: string, value: T, moduleUrl: string): Capability<T> {
 312:   if (!name.trim()) throw new Error('a capability requires a non-empty name');
 313:   if (WITNESSES.has(name)) {
 314:     throw new Error(
 315:       `refusing to construct capability ${JSON.stringify(name)} on the adapter-derived route: a witness is registered ` +
 316:         'for that name, and this route would stamp it stand-in without ever asking that witness â€” including for a ' +
 317:         'value the witness would have REFUSED. The two routes partition the capability namespace; they do not overlap.',
 318:     );
 319:   }
 320:   if (name !== ADAPTER_DERIVED_EXACT && !(name.startsWith(ADAPTER_DERIVED_PREFIX) && name.length > ADAPTER_DERIVED_PREFIX.length)) {
 321:     throw new Error(
 322:       `refusing to construct capability ${JSON.stringify(name)} on the adapter-derived route: this route builds ` +
 323:         `${ADAPTER_DERIVED_EXACT} and every ${ADAPTER_DERIVED_PREFIX}<key> the fixture adapter exports, and nothing ` +
 324:         'else. A name outside both families belongs on the witness table, where something decides about it.',
 325:     );
 326:   }
 327:   if (!moduleUrl.trim()) {
 328:     throw new Error(
 329:       `refusing to construct capability ${JSON.stringify(name)} on the adapter-derived route with no module URL: ` +
 330:         'the URL is the whole content of the reason, so an empty one would put a stand-in on the ledger that ' +
 331:         'cannot say which module it came from.',
 332:     );
 333:   }
 334:   return sealed(name, { kind: 'stand-in', reason: `loaded from the fixture adapter at ${moduleUrl}` }, value);
 335: }
 336: 
 337: export function stubbedCapabilityNames(capabilities: readonly Capability<unknown>[]): string[] {
 338:   return capabilities
 339:     .filter((entry) => entry[CAPABILITY] === true && entry.provenance === 'stand-in')
 340:     .map((entry) => entry.name)
 341:     .sort();
 342: }
