  67: /* ------------------------------------------------------------- 2. what the onboarding import is */
  68: 
  69: /** The three public statistics AT-001.05 names: top languages, repository count, contribution summary. */
  70: export type GithubStats = {
  71:   topLanguages: string[];
  72:   repositoryCount: number;
  73:   contributionSummary: string;
  74: };
  75: 
  76: /**
  77:  * The pool the stub draws its languages from. A fixed list rather than a generated string, so the
  78:  * values look like languages to a reader of the transcript and a wrong one is obvious.
  79:  */
  80: const STUB_LANGUAGE_POOL = [
  81:   'TypeScript',
  82:   'Python',
  83:   'Go',
  84:   'Rust',
  85:   'Ruby',
  86:   'Java',
  87:   'Elixir',
  88:   'C',
  89: ] as const;
  90: 
  91: /**
  92:  * A 32-bit fingerprint of the handle â€” FNV-1a, chosen because it is four lines of arithmetic with no
  93:  * dependency and no platform variation. It is NOT a security primitive and nothing here treats it
  94:  * as one; its only job is to make the stub's answer differ between handles while staying identical
  95:  * for one handle on every machine that computes it.
  96:  */
  97: function handleFingerprint(handle: string): number {
  98:   let hash = 2166136261;
  99:   for (let index = 0; index < handle.length; index += 1) {
 100:     hash ^= handle.charCodeAt(index);
 101:     hash = Math.imul(hash, 16777619);
 102:   }
 103:   return hash >>> 0;
 104: }
 105: 
 106: /**
 107:  * The stand-in for REQ-007's GitHub onboarding import â€” DETERMINISTIC AND NON-EMPTY BY
 108:  * CONSTRUCTION, and it is a stand-in, not an import.
 109:  *
 110:  * DETERMINISTIC, because a random or clock-derived answer would make AT-001.05's assertion either
 111:  * untestable or reduced to "something is there", and "something is there" is what the criterion's
 112:  * own words â€” "a queued-but-empty import fails this test" â€” exist to refuse.
 113:  *
 114:  * NON-EMPTY BY CONSTRUCTION: at least one language always, a repository count that is always at
 115:  * least one, and a summary sentence that always mentions the handle. Note the asymmetry with the
 116:  * schema, which permits `repository_count = 0`: a REAL import may legitimately find a volunteer with
 117:  * no public repositories, so the column allows it; the STUB never produces it, so a zero read back
 118:  * in a test would mean the value did not come from here.
 119:  *
 120:  * WHAT A GREEN OVER THIS FUNCTION CLAIMS: that the import fires at completion and lands populated in
 121:  * the same transaction as the account. WHAT IT DOES NOT CLAIM: that any statistic here was ever
 122:  * fetched from GitHub. Nothing in this item reaches api.github.com.
 123:  */
 124: export function stubGithubStatsFor(handle: string): GithubStats {
 125:   const fingerprint = handleFingerprint(handle);
 126: 
 127:   // One, two or three languages â€” never zero, which is the whole point of the `cardinality(...) >= 1`
 128:   // constraint this value has to satisfy on the way into `public.volunteer_profiles`.
 129:   const languageCount = 1 + (fingerprint % 3);
 130:   const firstLanguage = fingerprint % STUB_LANGUAGE_POOL.length;
 131:   const topLanguages: string[] = [];
 132:   for (let offset = 0; offset < languageCount; offset += 1) {
 133:     topLanguages.push(STUB_LANGUAGE_POOL[(firstLanguage + offset) % STUB_LANGUAGE_POOL.length]);
 134:   }
 135: 
 136:   const repositoryCount = 1 + (fingerprint % 240);
 137: 
 138:   return {
 139:     topLanguages,
 140:     repositoryCount,
 141:     contributionSummary:
 142:       `stub import fixture: ${handle} has ${repositoryCount} public repositories, ` +
 143:       `most recently in ${topLanguages[0]} â€” no GitHub API was called to produce this`,
 144:   };
 145: }
