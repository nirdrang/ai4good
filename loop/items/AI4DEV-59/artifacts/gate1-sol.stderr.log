 203: /** First non-empty line, redacted and length-capped â€” enough to diagnose, not enough to leak. */
 204: function diagnostic(text: string | undefined, limit = 400): string {
 205:   const line =
 206:     redact(text ?? '')
 207:       .split('\n')
 208:       .map((l) => l.trim())
 209:       .find((l) => l.length > 0) ?? '';
 210:   return line.length > limit ? `${line.slice(0, limit)}â€¦` : line;
 211: }
