1089:             `suite never grades leftover rows or a schema missing a migration; if that rebuild fails, ` +
1090:             `the state under test is unknown and the run stops here.`,
1091:         );
1092:       }
1093: 
1094:       try {
1095:         await waitForReady(status, 'after the reset');
1096:       } catch (err) {
1097:         return infra((err as Error).message);
1098:       }
1099: 
1100:       // (5) Prove the rebuild replayed the migration set â€” a reset that replays nothing also
1101:       // exits zero, and the suite would grade an empty schema believing it was the real one.
1102:       try {
1103:         await proveMigrationsReplayed(status);
1104:       } catch (err) {
1105:         return infra((err as Error).message);
1106:       }
1107: 
1108:       stackEnv.AT_SUPABASE_URL = status.apiUrl;
1109:       stackEnv.AT_SUPABASE_DB_URL = status.dbUrl;
1110:       stackEnv.AT_SUPABASE_ANON_KEY = status.anonKey;
1111:       stackEnv.AT_SUPABASE_SERVICE_ROLE_KEY = status.serviceRoleKey;
1112:     }
1113: 
1114:     // The suites and their vitest root come from the DATA root; vitest itself comes from the
1115:     // install root, so a run pointed at a disposable tree still runs the pinned test framework.
1116:     const atRoot = join(REPO_ROOT, 'tests', 'at');
1117:     const outputFile = join(reportDir, 'vitest-report.json');
1118:     const rootOverride: Record<string, string> = {};
1119:     if (process.env.AT_REPO_ROOT?.trim()) rootOverride.AT_REPO_ROOT = process.env.AT_REPO_ROOT.trim();
1120: 
1121:     const run = spawnSync(
1122:       bunExecutable(),
1123:       [
1124:         '--no-env-file',
1125:         join(INSTALL_ROOT, 'node_modules', 'vitest', 'vitest.mjs'),
1126:         'run',
1127:         '--root',
1128:         atRoot,
1129:         '--config',
1130:         join(atRoot, 'vitest.config.ts'),
1131:         '--reporter=json',
1132:         `--outputFile=${outputFile}`,
1133:         `suites/req-${requirement}/`,
1134:       ],
1135:       {
1136:         cwd: INSTALL_ROOT,
1137:         env: childEnv({ ...stackEnv, ...rootOverride, AT_TIER: tier, AT_REGISTRATION_DIR: registrationDir }),
1138:         stdio: ['ignore', 'inherit', 'inherit'],
1139:       },
1140:     );
1141: 
1142:     if (!existsSync(outputFile)) {
1143:       console.error(
1144:         `at:verify req-${requirement} â€” vitest produced no report ` +
1145:           `(exit ${run.status}${run.signal ? `, signal ${run.signal}` : ''}` +
1146:           `${run.error ? `, ${diagnostic((run.error as Error).message)}` : ''})`,
1147:       );
1148:       return 4;
1149:     }
1150: 
1151:     let report: VitestJson;
1152:     try {
1153:       report = JSON.parse(readFileSync(outputFile, 'utf8')) as VitestJson;
1154:     } catch (err) {
1155:       console.error(`at:verify req-${requirement} â€” unreadable vitest report: ${(err as Error).message}`);
1156:       return 4;
1157:     }
1158: 
1159:     const assertions = (report.testResults ?? []).flatMap((r) => r.assertionResults ?? []);
1160:     const analysis = analyzeReportedTests(expected, runtimeRegistrations(registrationDir), assertions);
1161:     const { rows, unexpected } = analysis;
1162: 
1163:     console.log('');
1164:     console.log(`at:verify req-${requirement} --tier ${tier}`);
1165:     for (const row of rows) console.log(`  ${row.id.padEnd(12)} ${row.status.padEnd(8)} ${row.detail}`);
1166:     for (const id of unexpected) console.log(`  ${id.padEnd(12)} ${'extra'.padEnd(8)} registered but not a P0 of this requirement`);
1167: 
1168:     const green = rows.filter((r) => r.status === 'green').length;
1169:     const red = rows.filter((r) => r.status === 'red').length;
1170:     const missing = rows.filter((r) => r.status === 'missing').length;
1171:     console.log(
1172:       `  ${rows.length} P0: ${green} green, ${red} red, ${missing} missing${unexpected.length ? `, ${unexpected.length} extra` : ''}`,
1173:     );
1174: 
1175:     if (!expectation) {
1176:       const verdict = runVerdict(rows, unexpected, run as ProcessOutcome);
1177:       if (verdict.length === 0) return 0;
1178:       for (const problem of verdict) console.log(`  FAILURE: ${problem}`);
1179:       return 1;
1180:     }
1181: 
1182:     // Both deviation sets are computed and printed: an id-level and a report-level problem in the
1183:     // same run are two facts an author needs at once, and printing only the first costs a second
1184:     // run to find the second.
1185:     const deviations = [
1186:       ...expectationDeviations(rows, unexpected, expectation),
1187:       ...reportAccountingDeviations(report, run as ProcessOutcome, expectation),
1188:     ];
1189:     if (deviations.length === 0) {
1190:       console.log(
1191:         `  EXPECTED: the run matches ${expectedManifestPath(requirement)} exactly ` +
1192:           `(${expectation.green.length} declared green, ${Object.keys(expectation.red).length} declared red)`,
1193:       );
1194:       return 0;
1195:     }
1196:     for (const deviation of deviations) console.log(`  DEVIATION: ${deviation}`);
1197:     console.log(
