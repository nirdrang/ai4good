1420: /**
1421:  * A READ-ONLY identity record of the personal stack's docker objects. Only `ps`, `inspect`,
1422:  * `volume ls` and `volume inspect` are used, and only identity fields are recorded: container id,
1423:  * created timestamp, image and port bindings; volume name and CreatedAt. No run state.
1424:  */
1425: function personalDockerSnapshot(personal: string): DockerSnapshot {
1426:   const containerNames = dockerLines(['ps', '-a', '--filter', `name=${personal}`, '--format', '{{.Names}}']).sort();
1427:   const containers = containerNames.length
1428:     ? dockerLines([
1429:         'inspect',
1430:         '--format',
1431:         '{{.Name}} | id {{.Id}} | created {{.Created}} | image {{.Config.Image}} | ports {{json .HostConfig.PortBindings}}',
1432:         ...containerNames,
1433:       ]).sort()
1434:     : [];
1435:   const volumeNames = dockerLines(['volume', 'ls', '--filter', `name=${personal}`, '--format', '{{.Name}}']).sort();
1436:   const volumes = volumeNames.length
1437:     ? dockerLines(['volume', 'inspect', '--format', '{{.Name}} | created {{.CreatedAt}}', ...volumeNames]).sort()
1438:     : [];
1439:   return { containers, volumes };
1440: }
