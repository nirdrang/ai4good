 260: /* ---------------------------------------------------------------------- the machine-wide lock */
 261: 
 262: export interface StackLock {
 263:   file: string;
 264:   release(): void;
 265: }
 266: 
 267: /**
 268:  * Where the machine-wide claim files live.
 269:  *
 270:  * `AT_LOCK_DIR` overrides it, the same pattern and the same reason as `AT_REPO_ROOT`: a test that
 271:  * exercises the claim protocol must not write into the directory a real run reads, or a selftest
 272:  * and a live `at:verify` could take each other's lock. Unset â€” every ordinary run â€” the answer is
 273:  * unchanged.
 274:  */
 275: function lockDir(): string {
 276:   const override = process.env.AT_LOCK_DIR?.trim();
 277:   const dir = override ? override : join(process.env.LOCALAPPDATA ?? process.env.XDG_CACHE_HOME ?? tmpdir(), 'ai4good-build', 'at-locks');
 278:   mkdirSync(dir, { recursive: true });
 279:   return dir;
 280: }
 281: 
 282: function processIsAlive(pid: number): boolean {
 283:   try {
 284:     process.kill(pid, 0);
 285:     return true;
 286:   } catch (err) {
 287:     // EPERM means it exists but belongs to someone else; ESRCH means it is gone.
 288:     return (err as NodeJS.ErrnoException).code === 'EPERM';
 289:   }
 290: }
 291: 
 292: /** The lock path for one stack. Machine-wide, and deliberately carries no folder component. */
 293: export function stackLockPath(config: LocalConfig): string {
 294:   return join(lockDir(), `at-verify-${config.projectId}-${config.apiPort}.lock`);
 295: }
 296: 
 297: export interface Holder {
 298:   pid?: number;
 299:   host?: string;
 300:   requirement?: string;
 301:   startedAt?: string;
 302:   /** Set only on a claim that replaced a stale one, so the takeover is recorded IN the claim. */
 303:   tookOverFrom?: { pid?: number; startedAt?: string; requirement?: string };
 304: }
 305: 
 306: /**
 307:  * Which holders a caller is allowed to displace.
 308:  *
 309:  * `stale-or-dead` is the runner's own long-standing rule: a dead process, or a live one whose
 310:  * claim is older than `LOCK_STALE_MINUTES`. `dead-pid-only` never displaces a running process at
 311:  * any age â€” the database-slot pool passes it, because a slot's occupancy is ruled to break on a
 312:  * dead holder pid and on nothing else. A run that legitimately lasts longer than the stale window
 313:  * must not have its database reset under it.
 314:  */
 315: export type TakeoverPolicy = 'stale-or-dead' | 'dead-pid-only';
 316: 
 317: export interface StackLockOptions {
 318:   takeover?: TakeoverPolicy;
 319: }
 320: 
 321: /** Live = a holder this policy may not displace. */
 322: function holderIsLive(holder: Holder, policy: TakeoverPolicy = 'stale-or-dead'): boolean {
 323:   if (typeof holder.pid !== 'number' || !processIsAlive(holder.pid)) return false;
 324:   if (policy === 'dead-pid-only') return true;
 325:   const startedAt = holder.startedAt ? Date.parse(holder.startedAt) : NaN;
 326:   const ageMinutes = Number.isFinite(startedAt) ? (Date.now() - startedAt) / 60_000 : Infinity;
 327:   return ageMinutes < LOCK_STALE_MINUTES;
 328: }
 329: 
 330: function heldByAnotherRun(holder: Holder, file: string): Error {
 331:   return new Error(
 332:     `another at:verify run holds this stack (pid ${holder.pid} on ${holder.host ?? 'this machine'}, ` +
 333:       `requirement ${holder.requirement ?? 'unknown'}, started ${holder.startedAt ?? 'unknown'}). ` +
 334:       `Two runs against one stack destroy each other: the second would reset the first's database ` +
 335:       `mid-run. Wait for it to finish. If that process is definitely gone, delete ${file}.`,
 336:   );
 337: }
 338: 
 339: /**
 340:  * A gate left behind by a process that died mid-takeover. The section lasts milliseconds, so
 341:  * anything this old is certainly abandoned; removing one wrongly costs at most two processes in
 342:  * the section, which is the behaviour we had before the gate existed.
 343:  */
 344: function clearStrandedGate(gate: string): void {
 345:   try {
 346:     const held = JSON.parse(readFileSync(gate, 'utf8')) as { pid?: number; at?: string };
 347:     const at = held.at ? Date.parse(held.at) : NaN;
 348:     const ageMinutes = Number.isFinite(at) ? (Date.now() - at) / 60_000 : Infinity;
 349:     const alive = typeof held.pid === 'number' && processIsAlive(held.pid);
 350:     if (!alive || ageMinutes > GATE_STALE_MINUTES) rmSync(gate, { force: true });
 351:   } catch {
 352:     // unreadable or already gone â€” the next pass finds out
 353:   }
 354: }
 355: 
 356: /**
 357:  * Serialize every destructive run against one stack. The key is project id + api port because
 358:  * that pair IS the stack's identity: a second checkout carrying the same `project_id` shares the
 359:  * same Docker containers and the same ports, so its `at:verify` would reset this run's database
 360:  * out from under it. Mirrors `Acquire-WorkLock` in loop/work/work-lib.ps1 â€” exclusive create,
 361:  * holder recorded, stale takeover.
 362:  *
 363:  * TAKEOVER IS THE WHOLE DIFFICULTY. Two processes can both read the same leftover lock and both
 364:  * conclude it is stale; if each then removed it and created its own, the second removal would take
 365:  * out the FIRST one's brand-new live lock and both would run â€” the precise failure this exists to
 366:  * prevent. Moving the stale file aside with an atomic rename does NOT fix that: the winner
 367:  * repopulates the path microseconds later, so the loser's rename succeeds against a LIVE lock,
 368:  * which is just as destructive as unlinking it. (Proved with a two-contender race, not reasoned
 369:  * about; the race is in runner.selftest.ts.)
 370:  *
 371:  * So the takeover DECISION is serialized by a second exclusive-create lock â€” the gate. Only one
 372:  * process is ever inside it, and it re-reads the holder INSIDE, so:
 373:  *   - no other process can be taking over concurrently (the gate is exclusive);
 374:  *   - no ordinary claim can have slipped in, because the stale file occupies the path continuously
 375:  *     until the gate holder removes it, and an exclusive create only succeeds on a free path;
 376:  *   - if a third process wins the claim in the instant after removal, the gate holder's own create
 377:  *     simply fails and it restarts, having deleted nothing further.
 378:  * A gate stranded by a killed process is cleared on age. The section lasts milliseconds, so a live
 379:  * holder never reaches that threshold, and clearing one wrongly degrades to two takers in the
 380:  * section â€” today's behaviour, not worse.
 381:  */
 382: export function acquireStackLock(config: LocalConfig, requirement: string, options: StackLockOptions = {}): StackLock {
 383:   const file = stackLockPath(config);
 384:   const policy: TakeoverPolicy = options.takeover ?? 'stale-or-dead';
 385: 
 386:   const claim = (displaced?: Holder): StackLock | null => {
 387:     let fd: number;
 388:     try {
 389:       fd = openSync(file, 'wx');
 390:     } catch (err) {
 391:       if ((err as NodeJS.ErrnoException).code === 'EEXIST') return null;
 392:       throw err;
 393:     }
 394:     try {
 395:       writeSync(
 396:         fd,
 397:         JSON.stringify({
 398:           pid: process.pid,
 399:           host: hostname(),
 400:           requirement,
 401:           startedAt: new Date().toISOString(),
 402:           // A takeover recorded ONLY on the console is lost the moment the terminal scrolls. The
 403:           // claim file outlives the run that wrote it, so whoever reads it later can see that this
 404:           // occupancy began by displacing an abandoned one, and whose.
 405:           ...(displaced
 406:             ? {
 407:                 tookOverFrom: {
 408:                   pid: displaced.pid,
 409:                   startedAt: displaced.startedAt,
 410:                   requirement: displaced.requirement,
 411:                 },
 412:               }
 413:             : {}),
 414:         }),
 415:       );
 416:     } finally {
 417:       closeSync(fd);
 418:     }
 419:     return {
 420:       file,
 421:       release: () => {
 422:         try {
 423:           const held = JSON.parse(readFileSync(file, 'utf8')) as { pid?: number };
 424:           if (held.pid === process.pid) rmSync(file, { force: true });
 425:         } catch {
 426:           // already removed, or unreadable â€” nothing of ours left to release
 427:         }
 428:       },
 429:     };
 430:   };
 431: 
 432:   const gate = `${file}.takeover`;
 433: 
 434:   /** The recorded holder, or null if the lock is gone. */
 435:   const readHolder = (): Holder | null => {
 436:     try {
 437:       return JSON.parse(readFileSync(file, 'utf8')) as Holder;
 438:     } catch (err) {
 439:       if ((err as NodeJS.ErrnoException).code === 'ENOENT') return null;
 440:       return {}; // unreadable or half-written: treat as an unidentifiable holder, judged below
 441:     }
 442:   };
 443: 
 444:   /** Bounded synchronous pause; a gate is held for milliseconds, so this is all the wait needed. */
 445:   const pause = (ms: number) => {
 446:     const until = Date.now() + ms;
 447:     while (Date.now() < until) {
 448:       /* spin */
 449:     }
 450:   };
 451: 
 452:   /**
 453:    * UNDER `dead-pid-only`, AN UNIDENTIFIABLE HOLDER IS NEVER TAKEOVER-ELIGIBLE.
 454:    *
 455:    * `readHolder` returns `{}` for a file it cannot read or parse, and `holderIsLive({})` is false
 456:    * under every policy â€” so without this guard a claim file that is empty or half written looks
 457:    * exactly like a dead holder and is deleted. The window is real and small: it is the microseconds
 458:    * between `openSync(file, 'wx')` and the `writeSync` that fills the file, so a second occupier
 459:    * arriving in that instant would remove a LIVE process's brand-new claim. That is the one thing
 460:    * this policy exists to make impossible.
 461:    *
 462:    * One bounded re-read skates over the write window. A holder that STILL has no parseable pid is
 463:    * not a dead holder â€” it is a file nobody in this process can account for â€” so it refuses loudly
 464:    * and names the manual repair. `stale-or-dead` keeps its long-standing behaviour: that path
 465:    * predates the slot pool and is another item's business.
 466:    *
 467:    * Returns the identified holder, or null when the file went away and the loop should retry.
 468:    */
 469:   const identified = (holder: Holder, where: string): Holder | null => {
 470:     if (typeof holder.pid === 'number') return holder;
 471:     if (policy !== 'dead-pid-only') return holder;
 472: 
 473:     pause(50);
 474:     const again = readHolder();
 475:     if (again === null) return null; // released while we looked; the loop takes the free path
 476:     if (typeof again.pid === 'number') return again;
 477: 
 478:     throw new Error(
 479:       `refusing to take over the claim at ${file}: it names no process id that this run can read, ` +
 480:         `so it cannot be shown to be dead â€” and a claim file being written right now looks exactly ` +
 481:         `like this. Nothing was taken over. If no run holds that stack, delete ${file} by hand ` +
 482:         `(checked ${where}).`,
 483:     );
 484:   };
 485: 
 486:   // Bounded: every retry follows another process winning the gate, which cannot repeat forever.
 487:   for (let attempt = 0; attempt < 20; attempt++) {
 488:     const claimed = claim();
 489:     if (claimed) return claimed;
 490: 
 491:     const read = readHolder();
 492:     if (read === null) continue; // released between the failed claim and the read
 493:     const holder = identified(read, 'before the takeover gate');
 494:     if (holder === null) continue;
 495:     if (holderIsLive(holder, policy)) throw heldByAnotherRun(holder, file);
 496: 
 497:     // Stale. Enter the takeover gate â€” the only place the live lock path may be removed.
 498:     let gateFd: number;
 499:     try {
 500:       gateFd = openSync(gate, 'wx');
 501:     } catch (err) {
 502:       if ((err as NodeJS.ErrnoException).code !== 'EEXIST') throw err;
 503:       clearStrandedGate(gate);
 504:       pause(10);
 505:       continue;
 506:     }
 507: 
 508:     try {
 509:       writeSync(gateFd, JSON.stringify({ pid: process.pid, at: new Date().toISOString() }));
 510:       const readInside = readHolder();
 511:       if (readInside === null) continue; // released while we were entering; the next claim takes it
 512:       // The same guard as above: the gate must not be able to remove an unidentifiable file either.
 513:       const inside = identified(readInside, 'inside the takeover gate');
 514:       if (inside === null) continue;
 515:       if (holderIsLive(inside, policy)) continue; // refreshed under us; the next pass refuses it properly
 516: 
 517:       rmSync(file, { force: true });
 518:       const takeover = claim(inside);
 519:       if (!takeover) continue; // a third process claimed the free path first â€” delete nothing more
 520: 
 521:       console.log(
 522:         `at:verify â€” took over a stale stack lock (holder pid ${inside.pid ?? 'unknown'} ` +
 523:           `${typeof inside.pid === 'number' && processIsAlive(inside.pid) ? `is older than ${LOCK_STALE_MINUTES} minutes` : 'is no longer running'})`,
 524:       );
 525:       return takeover;
 526:     } finally {
 527:       closeSync(gateFd);
 528:       rmSync(gate, { force: true });
 529:     }
 530:   }
 531: 
 532:   throw new Error(`could not acquire the stack lock at ${file} â€” it kept changing hands; try again`);
 533: }
