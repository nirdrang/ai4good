1045: 
1046:   const raw = `${res.stdout}\n${res.stderr}`;
1047:   const personal = personalProjectId(itemRoot);
1048:   const foreign = foreignContainerNames(raw, project);
1049:   const carriesPersonal = personal !== '' && raw.includes(personal);
1050:   if (foreign.length || carriesPersonal) {
1051:     throw new Error(
1052:       `REFUSING TO ${act.toUpperCase()} SLOT ${slot}: the identity read did not resolve to ${project}. ` +
1053:         (foreign.length ? `The CLI named ${foreign.join(', ')}. ` : '') +
1054:         (carriesPersonal ? `The founder's personal project id appears in the output. ` : '') +
1055:         `Nothing was done.`,
1056:     );
1057:   }
1058: 
1059:   let status: StackStatus;
1060:   try {
1061:     status = parseStackStatus(res);
