 317:   const lines = sourceText.split('\n');
 318:   lines[projectIdEntry.line] = lines[projectIdEntry.line].replace(/^(\s*project_id\s*=\s*)"[^"]*"/, `$1"${slotProjectId(slot)}"`);
 319:   for (const mapping of mappings) {
 320:     // The digits AND any TOML underscores between them, so a value written `54_321` is replaced
 321:     // whole. Replacing only the leading digits would leave the tail of the old value behind.
 322:     const pattern = new RegExp(`^(\\s*${mapping.key}\\s*=\\s*)\\d(?:_?\\d)*`);
 323:     lines[mapping.line] = lines[mapping.line].replace(pattern, `$1${mapping.to}`);
 324:   }
 325:   return lines.join('\n');
 326: }
 327: 
 328: /* ------------------------------------------------------- the personal stack, refused in code */
 329: 
 330: /**
 331:  * The "untouchable" ruling as an executable guard. Called before every destructive act and before
 332:  * any env is emitted, because a convention that is only written down is one a later change can
 333:  * step over without noticing.
 334:  *
 335:  * It scans EVERY active port-valued key, not a fixed list: the danger is a port in the personal
 336:  * block reaching a slot, and it does not matter which setting carried it there.
 337:  */
 338: export function personalBlockProblems(slotConfigText: string, personalProjectId: string): string[] {
 339:   const problems: string[] = [];
 340:   const entries = scanConfig(slotConfigText);
 341: 
 342:   const projectId = entries.find((entry) => entry.section === '' && entry.key === 'project_id');
 343:   const value = /^"([^"]*)"/.exec(projectId?.value ?? '')?.[1] ?? '';
 344:   if (!value) problems.push('the slot config carries no project_id, so it cannot be told apart from the personal stack');
 345:   else if (value === personalProjectId) problems.push(`the slot config carries the personal stack's project id "${personalProjectId}"`);
 346: 
 347:   for (const entry of entries) {
 348:     if (!isPortKey(entry.key)) continue;
 349:     // WHOLE TOKEN, AND AN UNPARSEABLE VALUE IS A PROBLEM (audit ruling A5). Two fail-opens sat
 350:     // here: a prefix parse read `54_321` â€” a legal TOML spelling of a personal-block port â€” as
 351:     // 54, and a value that did not parse at all was skipped in silence. A port this guard cannot
 352:     // read cannot be shown to be outside the founder's block, so it refuses, named with its value.
 353:     const port = portValue(entry.value);
 354:     if (port === null) {
 355:       problems.push(
 356:         `[${entry.section}] ${entry.key} = ${entry.value} is not a plain port number, so it cannot be shown to be ` +
 357:           `outside the personal stack's port block ${PERSONAL_PORT_LOW}â€“${PERSONAL_PORT_HIGH}`,
 358:       );
 359:       continue;
 360:     }
 361:     if (port >= PERSONAL_PORT_LOW && port <= PERSONAL_PORT_HIGH) {
 362:       problems.push(`[${entry.section}] ${entry.key} = ${port} is inside the personal stack's port block ${PERSONAL_PORT_LOW}â€“${PERSONAL_PORT_HIGH}`);
 363:     }
 364:     if (entry.key === 'inspector_port' && port === PERSONAL_INSPECTOR_PORT) {
 365:       problems.push(`[${entry.section}] inspector_port = ${port} is the personal stack's inspector port`);
 366:     }
 367:   }
 368: 
 369:   return problems;
 370: }
 371: 
 372: /** The identity the pool must never wear. Read from the item tree, never hard-coded. */
 373: export function personalProjectId(itemRoot: string = REPO_ROOT): string {
 374:   return readLocalConfig(itemRoot).projectId;
 375: }
 376: 
 377: function refusePersonal(slotConfigText: string, itemRoot: string, act: string): void {
 378:   const problems = personalBlockProblems(slotConfigText, personalProjectId(itemRoot));
 379:   if (problems.length) {
 380:     throw new Error(
 381:       `refusing to ${act}: this configuration is not provably outside the founder's personal stack. ` +
 382:         `Failed checks: ${problems.join('; ')}. The personal stack is untouchable, so nothing was done.`,
 383:     );
 384:   }
 385: }
 386: 
 387: /**
 388:  * The same guard, over a slot's config AS IT SITS ON DISK (rulings T7 and F1).
 389:  *
 390:  * `occupy` and `prepare` run the guard over text they hold in hand. The other three entry points â€”
 391:  * reset, stop and the env emitter â€” are exported and reachable directly, so each runs the guard
 392:  * for itself over the file. A guard that only the usual caller runs is a convention, not a guard.
 393:  */
 394: function refusePersonalSlotConfig(slot: number, itemRoot: string, act: string): void {
 395:   const configPath = slotConfigPath(slot);
 396:   if (!existsSync(configPath)) {
 397:     throw new Error(
 398:       `refusing to ${act} slot ${slot}: it has no config at ${configPath}, so it cannot be shown to be outside the ` +
 399:         `founder's personal stack. Run \`bun tests/at/harness/db-pool.ts setup\`. Nothing was done.`,
 400:     );
 401:   }
 402:   refusePersonal(readFileSync(configPath, 'utf8'), itemRoot, `${act} slot ${slot}`);
 403: }
 404: 
 405: /* ------------------------------------------------------------------------- the path closure */
 406: 
 407: /** Config settings whose value names a file or directory the stack has to be able to read. */
 408: const PATH_KEYS = new Set([
 409:   'sql_paths',
 410:   'schema_paths',
 411:   'content_path',
 412:   'cert_path',
 413:   'key_path',
 414:   'signing_keys_path',
 415:   'objects_path',
 416:   'declarative_schema_path',
 417: ]);
 418: 
 419: function stringValues(raw: string): string[] {
 420:   const array = /^\[(.*)\]$/.exec(raw);
 421:   const body = array ? array[1] : raw;
 422:   return [...body.matchAll(/"([^"]*)"/g)].map((match) => match[1]).filter((value) => value.trim() !== '');
 423: }
 424: 
 425: /**
 426:  * Fail closed on what the config asks for but the mirror cannot deliver.
 427:  *
 428:  * `prepare` mirrors the item tree's whole `supabase/` directory into the slot, so every path
 429:  * UNDER that directory is provided exactly as the item tree has it â€” present if present, absent
 430:  * if absent. A configured path that is absent in the item tree is therefore not a problem: the
 431:  * slot is then in the same state the repo-configured stack would be in, which is the state the
 432:  * item asked for. (`[db.seed] sql_paths = ["./seed.sql"]` with no `seed.sql` in the tree is
 433:  * exactly today's arrangement on the personal stack.)
 434:  *
 435:  * A path that points OUTSIDE `supabase/` is a different thing: the mirror cannot deliver it, so
 436:  * the slot would start half-provisioned and grade against a file it does not have. That refuses
 437:  * loudly and a person decides. The same applies to the two directories the mirror EXCLUDES
 438:  * (`MIRROR_EXCLUSIONS`): a config that names a file inside the CLI's own runtime state is naming
 439:  * something the slot will not have, so the closure stays honest about the exclusions.
 440:  *
 441:  * A VALUE THIS SCANNER CANNOT SEE REFUSES rather than passing. `scanConfig` reads one line per
 442:  * setting, so a multi-line array â€” `sql_paths = [` on its own line â€” yields the value `[` and no
 443:  * paths at all. For the OVERLAY an invisible value is harmless: it is copied verbatim. For the
 444:  * CLOSURE it is a missed refusal, which is the failure this function exists to prevent.
 445:  */
 446: export function pathClosureProblems(configText: string, itemRoot: string): string[] {
 447:   const problems: string[] = [];
 448:   const base = resolve(join(itemRoot, 'supabase'));
 449: 
 450:   for (const entry of scanConfig(configText)) {
 451:     if (!PATH_KEYS.has(entry.key)) continue;
 452:     if (entry.value.startsWith('[') && !entry.value.includes(']')) {
 453:       problems.push(
 454:         `[${entry.section}] ${entry.key} opens an array that does not close on the same line, so this check ` +
 455:           `cannot see the paths it names â€” write the value on one line (${entry.key} = ["./a.sql", "./b.sql"]) ` +
 456:           `and run this again`,
 457:       );
 458:       continue;
 459:     }
 460:     for (const value of stringValues(entry.value)) {
 461:       if (/^[a-z][a-z0-9+.-]*:\/\//i.test(value)) {
 462:         problems.push(`[${entry.section}] ${entry.key} names "${value}", which is a URL rather than a file the slot can be given`);
 463:         continue;
 464:       }
 465:       if (isAbsolute(value)) {
 466:         problems.push(`[${entry.section}] ${entry.key} names the absolute path "${value}", which the slot mirror cannot reproduce`);
 467:         continue;
 468:       }
 469:       const target = resolve(base, value);
 470:       const inside = relative(base, target);
 471:       if (inside.startsWith('..')) {
 472:         problems.push(
 473:           `[${entry.section}] ${entry.key} names "${value}", which is outside supabase/ â€” the slot mirror copies supabase/ ` +
 474:             `and nothing else, so this file would be missing from the slot`,
 475:         );
 476:         continue;
 477:       }
 478:       const first = inside.split(/[\\/]/)[0];
 479:       if (MIRROR_EXCLUSIONS.includes(first)) {
 480:         problems.push(
 481:           `[${entry.section}] ${entry.key} names "${value}", which resolves into supabase/${first} â€” the slot mirror ` +
 482:             `deliberately does not copy that directory (it is the CLI's own runtime state about another stack), so ` +
 483:             `this file would be missing from the slot`,
 484:         );
 485:       }
 486:     }
 487:   }
 488: 
 489:   return problems;
 490: }
 491: 
 492: /* -------------------------------------------------------------------------------- the mirror */
 493: 
 494: /**
 495:  * What the mirror does NOT carry into a slot (rulings T3, F3 and T11). Top-level entries of
 496:  * `supabase/` only, so the list cannot quietly grow into a filter on file names.
 497:  *
 498:  *   - `.temp` and `.branches` are the CLI's OWN RUNTIME STATE, not project source. `.temp` holds
 499:  *     the CLI's record of the stack it last ran â€” the founder's personal one â€” and `.gitignore`
 500:  *     itself says its `start-secrets/**` "must NEVER be committed". Copying it carries another
 501:  *     stack's identity residue and its secrets into every slot.
 502:  *   - `config.toml` is the slot's IDENTITY, and the item tree's copy carries the personal
 503:  *     identity. Excluding it means no slot config ever holds that identity, not even for the
 504:  *     instant between the mirror and the regenerated write â€” and a crash in that instant leaves
 505:  *     NO config rather than a personal one.
 506:  */
 507: export const MIRROR_EXCLUSIONS: readonly string[] = ['.temp', '.branches', 'config.toml'];
 508: 
 509: /**
 510:  * Every symlink under a directory tree. A pre-copy scan, because a symlink is not a file the
 511:  * mirror can reproduce: `cpSync` would copy it as a link, and the link points wherever it likes â€”
 512:  * including straight back at the personal stack's own directory.
 513:  */
 514: function symlinksUnder(dir: string): string[] {
 515:   const found: string[] = [];
 516:   const walk = (current: string): void => {
 517:     for (const entry of readdirSync(current, { withFileTypes: true })) {
 518:       const full = join(current, entry.name);
 519:       if (entry.isSymbolicLink()) {
 520:         found.push(full);
 521:         continue; // never follow it â€” that is the whole point
 522:       }
 523:       if (entry.isDirectory()) walk(full);
 524:     }
 525:   };
 526:   walk(dir);
 527:   return found;
 528: }
 529: 
 530: /**
 531:  * Copy the item tree's `supabase/` into the slot, having first removed the slot's copy.
 532:  *
 533:  * DELETE THEN COPY, never merge: the previous holder's leftover migration or leftover function is
 534:  * exactly the state this pool exists to make impossible.
 535:  *
 536:  * THE PROJECT SOURCE ENTIRE, and nothing else (ruling E3 as narrowed by T3, F3 and T11). Every
 537:  * path the config names under `supabase/` arrives in the slot exactly as the item tree has it â€”
 538:  * present if present, absent if absent â€” and `pathClosureProblems` refuses any config path that
 539:  * names one of the three excluded entries, so the closure guarantee stays honest about them.
 540:  * (`README.md` and `.gitkeep` therefore travel into the slot's `migrations/` too. The CLI reads
 541:  * only `<timestamp>_name.sql` there, and the runner's migration proof counts exactly those.)
 542:  *
 543:  * A SYMLINK ANYWHERE UNDER `supabase/` REFUSES THE WHOLE MIRROR (ruling T13). The tree carries
 544:  * none today, so nothing breaks; one smuggled in later refuses loudly instead of being copied as
 545:  * a link into a directory the pool then resets.
 546:  */
 547: export function mirrorItemTree(itemRoot: string, slot: number): void {
 548:   const source = join(itemRoot, 'supabase');
 549:   const destination = join(slotDir(slot), 'supabase');
 550:   if (!existsSync(source)) throw new Error(`${source} does not exist â€” there is no project to give the slot`);
 551: 
 552:   const links = symlinksUnder(source);
 553:   if (links.length) {
 554:     throw new Error(
 555:       `refusing to mirror ${source} into slot ${slot}: it contains ${links.length} symlink(s) â€” ${links.join(', ')}. ` +
 556:         `A symlink is not a file the mirror can reproduce, and a link copied into a slot points wherever it likes, ` +
 557:         `including outside the pool. Replace them with real files, or decide by hand. Nothing was copied.`,

exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command '$lines = Get-Content -LiteralPath '"'tests/at/harness/db-pool.ts'; for ("'$i=547; $i -lt 870; $i++) { '"'{0,4}: {1}' -f ("'$i+1), $lines[$i] }' in C:\Users\nirdr\Downloads\ai4good\.claude\worktrees\agent-a064eb77d7bb37dd7
