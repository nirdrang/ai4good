1151:     );
1152:   }
1153: 
1154:   // THE MIRROR AND THE CONFIG WRITE ARE ONE STEP (ruling T11). The mirror excludes `config.toml`
1155:   // and removes the slot's copy, so between these two statements the slot has NO config â€” never the
1156:   // item tree's one, which carries the personal identity. A crash in the window leaves a slot with
1157:   // nothing, which `occupy` refuses loudly and one `setup` repairs. The write is unconditional:
1158:   // the mirror has just deleted whatever was there.
1159:   mirrorItemTree(itemRoot, slot);
1160:   const configPath = slotConfigPath(slot);
1161:   mkdirSync(join(dir, 'supabase'), { recursive: true });
1162:   writeFileSync(configPath, generated, 'utf8');
1163: 
1164:   const hash = hashConfig(generated);
1165:   const marker = readMarker(slot);
1166:   const restarted = marker?.configHash !== hash;
1167:   if (restarted) {
1168:     // The auth container reads config at START, not at reset, so a changed config that is not
1169:     // restarted into would grade the previous item's auth behaviour.
1170:     console.log(`at:verify â€” db slot ${slot} configuration changed since its last start; restarting the slot's stack`);
