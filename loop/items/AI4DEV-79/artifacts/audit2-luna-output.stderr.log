  60:  * read the config for the api port would be asserting against a name `prepare` is allowed to move,
  61:  * and would keep passing while the two runs it is meant to serialize held different files.
  62:  */
  63: function claimPath(slot: number): string {
  64:   return stackLockPath(slotClaimKey(slot));
  65: }
  66: 
  67: /** A process id that is PROVABLY dead: a real child, started, waited for, and gone (ruling F9). */
  68: function deadPid(): number {
  69:   const child = spawnSync(bunExecutable(), ['--no-env-file', '-e', 'process.exit(0)'], { encoding: 'utf8' });
  70:   expect(typeof child.pid, 'the probe child reported no process id, so nothing provably dead exists to plant').toBe('number');
  71:   return child.pid as number;
  72: }
  73: 
  74: function writeReservation(slot: number, item: string): void {
  75:   mkdirSync(join(poolTemp, 'reservations'), { recursive: true });
  76:   writeFileSync(
  77:     reservationPath(slot),
  78:     JSON.stringify({ slot, item, branch: 'test', at: new Date().toISOString(), holder: 'selftest' }),
  79:     'utf8',
  80:   );
  81: }
  82: 
  83: /** A reservation file exactly as it looks mid-write, or after a crash: present, and saying nothing. */
  84: function plantRawReservation(slot: number, text: string): void {
  85:   mkdirSync(join(poolTemp, 'reservations'), { recursive: true });
  86:   writeFileSync(reservationPath(slot), text, 'utf8');
  87: }
  88: 
  89: function plantClaim(slot: number, holder: Record<string, unknown>): void {
  90:   writeFileSync(claimPath(slot), JSON.stringify(holder), 'utf8');
  91: }
  92: 
  93: /** A claim file exactly as it looks mid-write, or after a crash: present, and saying nothing. */
  94: function plantRawClaim(slot: number, text: string): void {
  95:   writeFileSync(claimPath(slot), text, 'utf8');
  96: }
  97: 
  98: function scrubClaim(slot: number): void {
  99:   rmSync(claimPath(slot), { force: true });
 100: }
