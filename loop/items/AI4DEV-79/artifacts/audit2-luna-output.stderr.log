nary(slot: number, status: StackStatus, note: string): Promise<void> {\\n  await withSlotSql(slot, status, async (sql) => {\\n    await sql`drop table if exists public.spike_canary`;\\n    await sql`create table public.spike_canary (note text)`;\\n    await sql`insert into public.spike_canary (note) values (${note})`;\\n  });\\n}\\n\\n/** The canary's note, or null when the table or the row is gone â€” which is what a reset does. */\\nasync function readCanary(slot: number, status: StackStatus): Promise<string | null> {\\n  return withSlotSql(slot, status, async (sql) => {\\n    try {\\n      const rows = (await sql`select note from public.spike_canary`) as { note?: unknown }[];\\n      return rows.length ? String(rows[0].note) : null;\\n    } catch (err) {\\n      const message = (err as Error).message ?? '';\\n      if (/spike_canary/.test(message) && /does not exist/i.test(message)) return null;\\n      throw err;\\n    }\\n  });\\n}\\n\\nfunction dockerLines(args: string[]): string[] {\\n  const res = spawnSync('docker', args, { env: childEnv(), encoding: 'utf8' });\\n  if (res.error) throw new Error(`docker could not be run (${diagnostic((res.error as Error).message)})`);\\n  if (res.status !== 0) throw new Error(`\\\\`docker ${args.slice(0, 2).join(' ')}\\\\` exited ${res.status}: ${diagnostic(res.stderr) || '(no error output)'}`);\\n  return (res.stdout ?? '')\\n    .split('\\\\n')\\n    .map((line) => line.trim())\\n    .filter(Boolean);\\n}\\n\\ninterface DockerSnapshot {\\n  containers: string[];\\n  volumes: string[];\\n}\\n\\n/**\\n * A READ-ONLY identity record of the personal stack's docker objects. Only `ps`, `inspect`,\\n * `volume ls` and `volume inspect` are used, and only identity fields are recorded: container id,\\n * created timestamp, image and port bindings; volume name and CreatedAt. No run state.\\n */\\nfunction personalDockerSnapshot(personal: string): DockerSnapshot {\\n  const containerNames = dockerLines(['ps', '-a', '--filter', `name=${personal}`, '--format', '{{.Names}}']).sort();\\n  const containers = containerNames.length\\n    ? dockerLines([\\n        'inspect',\\n        '--format',\\n        '{{.Name}} | id {{.Id}} | created {{.Created}} | image {{.Config.Image}} | ports {{json .HostConfig.PortBindings}}',\\n        ...containerNames,\\n      ]).sort()\\n    : [];\\n  const volumeNames = dockerLines(['volume', 'ls', '--filter', `name=${personal}`, '--format', '{{.Name}}']).sort();\\n  const volumes = volumeNames.length\\n    ? dockerLines(['volume', 'inspect', '--format', '{{.Name}} | created {{.CreatedAt}}', ...volumeNames]).sort()\\n    : [];\\n  return { containers, volumes };\\n}\\n\\nfunction snapshotDifferences(before: DockerSnapshot, after: DockerSnapshot): string[] {\\n  const differences: string[] = [];\\n  const pairs = [\\n    ['container', before.containers, after.containers],\\n    ['volume', before.volumes, after.volumes],\\n  ] as const;\\n  for (const [what, first, second] of pairs) {\\n    for (const line of first) if (!second.includes(line)) differences.push(`${what} recorded BEFORE and not after: ${line}`);\\n    for (const line of second) if (!first.includes(line)) differences.push(`${what} recorded AFTER and not before: ${line}`);\\n  }\\n  return differences;\\n}\\n\\nfunction gitHead(): string {\\n  const res = spawnSync('git', ['-C', REPO_ROOT, 'rev-parse', 'HEAD'], { encoding: 'utf8', env: childEnv() });\\n  return (res.stdout ?? '').trim() || '(git could not report the head)';\\n}\\n\\nasync function spike(): Promise<number> {\\n  const personal = personalProjectId();\\n  const hostile = process.env.SUPABASE_PROJECT_ID ?? '';\\n\\n  console.log('');\\n  console.log('AI4DEV-79 (parallel DB slot pool) - step S3 as amended by ruling E5, the isolation re-proof.');\\n  console.log('');\\n  console.log('REDACTION: database passwords and any key-shaped token are replaced before printing.');\\n  console.log('Container names, project ids and ports are kept: they are the evidence.');\\n  console.log('');\\n  console.log(`date      : ${new Date().toISOString()}`);\\n  console.log(`machine   : ${hostname()}`);\\n  console.log(`worktree  : ${REPO_ROOT}`);\\n  console.log(`branch    : ${(() => { try { return currentBranch(); } catch { return '(unreadable)'; } })()}`);\\n  console.log(`head      : ${gitHead()}`);\\n  console.log(`pool root : ${poolRoot()}`);\\n  console.log('');\\n\\n  console.log('=== the hostile condition, mandatory ===');\\n  if (hostile !== personal) {\\n    console.log(`REFUSING TO RUN. The parent process carries SUPABASE_PROJECT_ID=\\\"${hostile}\\\" and the proof needs \\\"${personal}\\\".`);\\n    console.log('Run this entry so the tracked .env loads into the parent, or set the variable in the parent shell.');\\n    console.log('A pass under a clean environment would prove nothing: the route this helper closes would not be loaded.');\\n    return 2;\\n  }\\n  console.log(`SUPABASE_PROJECT_ID IS PRESENT IN THIS PROCESS: \\\"${hostile}\\\".`);\\n  console.log('That is the founder\\\\'s personal project id, and it is the exact override that destroyed the personal');\\n  console.log('database on 2026-08-09. It stays in this process for the whole run. Every CLI call below is made');\\n  console.log('through the shared helper, which states the slot identity positively in the child environment.');\\n  console.log('');\\n\\n  console.log('=== (a) BEFORE: docker identity snapshot of the personal stack (a READ; nothing is written) ===');\\n  const before = personalDockerSnapshot(personal);\\n  for (const line of before.containers) console.log(`  ${line}`);\\n  for (const line of before.volumes) console.log(`  ${line}`);\\n  console.log(`  ${before.containers.length} containers, ${before.volumes.length} volumes recorded`);\\n  console.log('');\\n\\n  let failure: string | null = null;\\n  let slot1Canary: string | null = null;\\n  let slot2Canary: string | null = null;\\n  let preReadShown = false;\\n  let resetDone = false;\\n  let held1: Occupancy | null = null;\\n  let held2: Occupancy | null = null;\\n\\n  try {\\n    // THE SPIKE TAKES BOTH SLOTS FIRST (ruling T4). D6's own sentence â€” \\\"the occupancy claim still\\n    // applies\\\" for override runs â€” binds this run too: it writes to slot 1 and resets slot 2, so a\\n    // verify window opening on either one under it would be exactly the collision the pool exists\\n    // to prevent. Both claims are released in the `finally` below.\\n    console.log('=== (a2) occupying both slots, dead-pid-only, before anything is touched ===');\\n    held1 = occupy('spike', { slot: 1 });\\n    held2 = occupy('spike', { slot: 2 });\\n    console.log(`  slot 1 claim ${held1.claim.file}`);\\n    console.log(`  slot 2 claim ${held2.claim.file}`);\\n    console.log('');\\n\\n    console.log('=== (b) preflight: both slots answer on their own port block, through the helper ===');\\n    const statuses = new Map<number, StackStatus>();\\n    for (const slot of [1, 2]) {\\n      let read = proveSlotTarget(slot, `preflight of slot ${slot}`);\\n      if (!read.status) {\\n        console.log(`  slot ${slot} reported no running stack (${read.notRunning}); starting it â€” slots are pool property`);\\n        startSlotStack(slot);\\n        read = proveSlotTarget(slot, `preflight of slot ${slot}`);\\n      }\\n      if (!read.status) throw new Error(`slot ${slot} still reports no running stack: ${read.notRunning}`);\\n      statuses.set(slot, read.status);\\n      console.log(`  slot ${slot}  API ${read.status.apiUrl}  DB ${redactDbUrl(read.status.dbUrl)}`);\\n    }\\n    const slot1 = statuses.get(1) as StackStatus;\\n    const slot2 = statuses.get(2) as StackStatus;\\n    console.log('');\\n\\n    console.log('=== (c) canary row in slot 1 â€” the bystander that must SURVIVE ===');\\n    await writeCanary(1, slot1, 'slot-1 canary');\\n    console.log(`  slot 1 canary written: ${JSON.stringify(await readCanary(1, slot1))}`);\\n    console.log('');\\n\\n    console.log('=== (d) canary row in slot 2 â€” the row the reset must DESTROY ===');\\n    await writeCanary(2, slot2, 'slot-2 canary');\\n    console.log(`  slot 2 canary written: ${JSON.stringify(await readCanary(2, slot2))}`);\\n    console.log('');\\n\\n    console.log('=== (e) the pre-destructive identity read on slot 2 ===');\\n    const read = proveSlotTarget(2, 'reset', REPO_ROOT, true);\\n    if (!read.status) throw new Error(`slot 2 reported no running stack: ${read.notRunning}`);\\n    preReadShown = true;\\n    console.log('  the line above is the helper stating which project the CLI resolved, before anything destructive.');\\n    console.log('');\\n\\n    console.log('=== (f) supabase db reset, aimed at slot 2, through the helper, hostile variable present ===');\\n    await resetSlotDatabase(2);\\n    resetDone = true;\\n    console.log('  the reset exited zero.');\\n    console.log('');\\n\\n    console.log('=== (g) the canaries after the reset ===');\\n    slot1Canary = await readCanary(1, slot1);\\n    slot2Canary = await readCanary(2, slot2);\\n    console.log(`  slot 1 canary: ${JSON.stringify(slot1Canary)}`);\\n    console.log(`  slot 2 canary: ${JSON.stringify(slot2Canary)}`);\\n    console.log('');\\n  } catch (err) {\\n    failure = diagnostic((err as Error).message, 2000);\\n    console.log('');\\n    console.log(`STOPPED: ${failure}`);\\n    console.log('');\\n  } finally {\\n    release(held2);\\n    release(held1);\\n    console.log('=== both slot claims released ===');\\n    console.log('');\\n  }\\n\\n  console.log('=== (h) AFTER: the same docker identity snapshot, compared on identity fields only ===');\\n  const after = personalDockerSnapshot(personal);\\n  for (const line of after.containers) console.log(`  ${line}`);\\n  for (const line of after.volumes) console.log(`  ${line}`);\\n  const differences = snapshotDifferences(before, after);\\n  if (differences.length === 0) console.log('  IDENTICAL: same container ids, created timestamps, images, port bindings, volumes and volume CreatedAt.');\\n  else for (const line of differences) console.log(`  DIFFERENT: ${line}`);\\n  console.log('');\\n\\n  const criteria: [string, boolean][] = [\\n    ['the hostile variable was present in the parent process', hostile === personal],\\n    // Ruling F2: without this, a slot 2 canary READ that throws after a good reset is swallowed by\\n    // the catch, and every remaining criterion passes with the canary never read at all.\\n    ['the spike body completed without an exception', failure === null],\\n    ['the identity pre-read named slot 2 before the reset', preReadShown],\\n    ['the reset ran through the helper and exited zero', resetDone],\\n    ['the slot 2 canary is GONE â€” the reset acted on slot 2', resetDone && slot2Canary === null],\\n    ['the slot 1 canary SURVIVES â€” the reset acted on nothing else', slot1Canary === 'slot-1 canary'],\\n    // Ruling T12: two empty docker queries compare EQUAL, so the central instrument would report\\n    // IDENTICAL while having observed nothing at all.\\n    [\\n      'the BEFORE snapshot recorded at least one personal container and one personal volume',\\n      before.containers.length > 0 && before.volumes.length > 0,\\n    ],\\n    ['the personal docker snapshots are equal on every identity field', differences.length === 0],\\n  ];\\n  console.log('=== the done-criterion, item by item ===');\\n  for (const [what, met] of criteria) console.log(`  ${met ? 'PASS' : 'FAIL'}  ${what}`);\\n  const passed = criteria.every(([, met]) => met);\\n  console.log('');\\n  console.log(passed ? 'THE SPIKE PASSED: the wall holds under the exact condition that broke it.' : 'THE SPIKE FAILED. The wall is NOT proven.');\\n  console.log('');\\n  console.log('Residue: slot 1 keeps a public.spike_canary table until its next occupancy, which resets it.');\\n  console.log('END OF S3 TRANSCRIPT (re-proof)');\\n  return passed ? 0 : 1;\\n}\\n\\nfunction usage(): void {\\n  console.error('usage: bun tests/at/harness/db-pool.ts <setup|status|spike>');\\n}\\n\\nasync function main(argv: string[]): Promise<number> {\\n  const command = argv[0] ?? '';\\n  if (command === 'setup') return setup();\\n  if (command === 'spike') return spike();\\n  if (command === 'status') {\\n    for (const view of readPool()) {\\n      console.log(\\n        `slot ${view.slot}: ${view.configured ? `${view.projectId}, api ${view.apiPort}` : 'NOT CONFIGURED'}` +\\n          `, reservation ${view.reservation ? `${view.reservation.item} (${view.reservation.at})` : 'none'}` +\\n          `, occupancy ${view.occupiedBy ? `pid ${view.occupiedBy.pid} for ${view.occupiedBy.requirement}` : 'none'}`,\\n      );\\n    }\\n    return 0;\\n  }\\n  usage();\\n  return 2;\\n}\\n\\nif (import.meta.main) {\\n  try {\\n    process.exit(await main(process.argv.slice(2)));\\n  } catch (err) {\\n    console.error(`db-pool â€” ${(err as Error).message}`);\\n    process.exit(3);\\n  }\\n}\",\"lineStart\":1099,\"lineEnd\":1523,\"totalLines\":1523,\"truncated\":false}},\"title\":\"tests\\\\at\\\\harness\\\\db-pool.ts\",\"time\":{\"start\":1786349854079,\"end\":1786349854096}},\"id\":\"prt_feabf9c52001FJd40WHtsVf7Ne\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"messageID\":\"msg_feabf923c001H1e2Z4vWGLd52O\"}}\r\n+{\"type\":\"step_finish\",\"timestamp\":1786349854591,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feabf9f73001cFoG9kgks5MTmJ\",\"reason\":\"tool-calls\",\"snapshot\":\"14300a84ba352d3c5bf13238e30244f5f404984e\",\"messageID\":\"msg_feabf923c001H1e2Z4vWGLd52O\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"type\":\"step-finish\",\"tokens\":{\"total\":49529,\"input\":15748,\"output\":103,\"reasoning\":14,\"cache\":{\"write\":0,\"read\":33664}},\"cost\":0.0011658696}}\r\n+{\"type\":\"step_start\",\"timestamp\":1786349856525,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feabfa70b0010v9ZPjF0NvCYpz\",\"messageID\":\"msg_feabfa15c001HaL0Lu1Rq80kHK\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"snapshot\":\"9967df925a36559b9acad45a45dc57b62ffd8b55\",\"type\":\"step-start\"}}\r\n+{\"type\":\"tool_use\",\"timestamp\":1786349870399,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"type\":\"tool\",\"tool\":\"read\",\"callID\":\"call_00_g0tw813zme7PCLdC09T26461\",\"state\":{\"status\":\"completed\",\"input\":{\"filePath\":\"C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\runner.ts\"},\"output\":\"<path>C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\runner.ts</path>\\n<type>file</type>\\n<content>\\n1: /**\\n2:  * The AT runner â€” `bun run at:verify req-0NN --tier <loop|integration|drill>`.\\n3:  *\\n4:  * The command shape is fixed: all 30 decomposition manifests cite it verbatim in their done\\n5:  * contracts, and the skills (`/dev-start`'s inner loop, `/dev-end`, `/pm-done`'s gate) call it.\\n6:  * It resolves the requirement's suite, runs it under vitest with the tier passed through\\n7:  * `AT_TIER`, and reports PER AT ID â€” green / red / missing â€” because \\\"3 failed\\\" tells a gate\\n8:  * nothing about which acceptance criterion is unmet.\\n9:  *\\n10:  * The `integration` tier needs a real database, and that database is a SLOT out of the local\\n11:  * database pool (`db-pool.ts`) â€” never a shared hosted project, because every run wipes and\\n12:  * rebuilds it, and never the stack described by this repository's own `supabase/config.toml`,\\n13:  * because that one is the founder's personal stack and is untouchable. The sequence is\\n14:  * deliberately paranoid:\\n15:  *\\n16:  *   1. occupy the slot the coordinator reserved for this item â€” a machine-wide claim keyed by the\\n17:  *      slot's project id + api port, so two runs cannot reset under each other;\\n18:  *   2. prepare the slot: mirror this tree's `supabase/` into it, overlay the slot's permanent\\n19:  *      identity, PROVE the stack that answers is that slot â€” loopback host, the slot's own ports,\\n20:  *      keys issued by the local development issuer â€” reset it, and prove the migration set\\n21:  *      replayed. Every step of that lives in `db-pool.ts`;\\n22:  *   3. print the evidence line naming the slot, so a green can always name the database it graded;\\n23:  *   4. run the suite with an ALLOWLISTED environment â€” the child gets the platform minimum plus\\n24:  *      the validated slot coordinates, and nothing else, so a secret sitting in a developer's\\n25:  *      `.env.local` can never reach a test (and a test can never reach the hosted project).\\n26:  *\\n27:  * The `drill` tier resolves no database at all until an item decides which stack it should use.\\n28:  *\\n29:  * Any failure in that sequence is an INFRASTRUCTURE failure: non-zero exit, no tests run, a\\n30:  * message naming what failed. The runner never falls back to the loop tier's stubs and never\\n31:  * runs against a database whose state it could not establish â€” a gate grading a stand-in, or an\\n32:  * unknown database, is worse than a gate that refuses to run. Secrets are never printed: raw CLI\\n33:  * output is redacted, and validation reports which check failed, never the value that failed it.\\n34:  */\\n35: \\n36: import { spawn, spawnSync } from 'node:child_process';\\n37: import { closeSync, existsSync, mkdirSync, mkdtempSync, openSync, readdirSync, readFileSync, rmSync, writeSync } from 'node:fs';\\n38: import { hostname, tmpdir } from 'node:os';\\n39: import { join } from 'node:path';\\n40: \\n41: import { INSTALL_ROOT, inspectBijection, normalizeRequirement, REPO_ROOT, suiteDir } from './check.ts';\\n42: // The cycle with db-pool.ts is deliberate and safe: neither module calls the other at module\\n43: // scope, and both sides export hoisted function declarations.\\n44: import { evidence, occupy, prepare, stackEnv as slotStackEnv, type Occupancy, type PrepareResult } from './db-pool.ts';\\n45: import {\\n46:   expectationDeviations,\\n47:   expectedManifestPath,\\n48:   loadTierExpectation,\\n49:   reportAccountingDeviations,\\n50:   type TierExpectation,\\n51: } from './expected.ts';\\n52: \\n53: const TIERS = ['loop', 'integration', 'drill'] as const;\\n54: type Tier = (typeof TIERS)[number];\\n55: \\n56: const USAGE = 'usage: bun run at:verify req-0NN --tier <loop|integration|drill> [--wired] [--expect]';\\n57: \\n58: /** How long the stack gets to become genuinely ready before the run is called off. */\\n59: const READY_TIMEOUT_MS = Number(process.env.AT_READY_TIMEOUT_MS ?? 120_000);\\n60: /** How long `supabase db reset` gets before it is assumed wedged and its process tree killed. */\\n61: const RESET_TIMEOUT_MS = Number(process.env.AT_RESET_TIMEOUT_MS ?? 600_000);\\n62: /** A lock older than this, or held by a process that is gone, is taken over. */\\n63: const LOCK_STALE_MINUTES = Number(process.env.AT_LOCK_STALE_MINUTES ?? 60);\\n64: /** The takeover gate is held for milliseconds; anything this old was abandoned by a dead process. */\\n65: const GATE_STALE_MINUTES = Number(process.env.AT_LOCK_GATE_STALE_MINUTES ?? 2);\\n66: \\n67: /** `supabase status` reports these two as stopped because config.toml disables them. Benign. */\\n68: const DISABLED_SERVICES = /^supabase_(imgproxy|pooler)_/;\\n69: \\n70: /**\\n71:  * The pinned CLI, invoked directly â€” no shell, no PATH lookup, no globally installed version.\\n72:  * Resolved from the INSTALL root, never the (overridable) data root: the pinned versions live in\\n73:  * the real checkout's `node_modules` wherever the acceptance files being read happen to be.\\n74:  */\\n75: const SUPABASE_ENTRY = join(INSTALL_ROOT, 'node_modules', 'supabase', 'dist', 'supabase.js');\\n76: \\n77: interface Args {\\n78:   requirement: string;\\n79:   tier: Tier;\\n80:   wired: boolean;\\n81:   /** Named `expectDeclared`, not `expect`, so nobody later reads it as vitest's `expect`. */\\n82:   expectDeclared: boolean;\\n83: }\\n84: \\n85: function parseArgs(argv: string[]): Args {\\n86:   let requirement = '';\\n87:   let tier = '';\\n88:   let wired = false;\\n89:   let expectDeclared = false;\\n90: \\n91:   for (let i = 0; i < argv.length; i++) {\\n92:     const arg = argv[i];\\n93:     if (arg === '--wired') wired = true;\\n94:     else if (arg === '--expect') expectDeclared = true;\\n95:     else if (arg === '--tier') tier = argv[++i] ?? '';\\n96:     else if (arg.startsWith('--tier=')) tier = arg.slice('--tier='.length);\\n97:     else if (arg.startsWith('--')) throw new Error(`unknown option \\\"${arg}\\\"`);\\n98:     else if (!requirement) requirement = arg;\\n99:     else throw new Error(`unexpected argument \\\"${arg}\\\"`);\\n100:   }\\n101: \\n102:   if (!requirement) throw new Error('no requirement given');\\n103:   if (!tier) throw new Error('--tier is required â€” there is no default tier, by design');\\n104:   if (!TIERS.includes(tier as Tier)) throw new Error(`unknown tier \\\"${tier}\\\" â€” expected one of ${TIERS.join('|')}`);\\n105:   // Refused here rather than later: `--wired` runs no tests at all, so there would be no report\\n106:   // for a declaration to be checked against, and a declaration refusal must never be reported as\\n107:   // the wired refusal. A usage error exits 2, which is what a `--expect` command that cannot be\\n108:   // honoured is required to do.\\n109:   if (wired && expectDeclared) {\\n110:     throw new Error('--expect and --wired cannot be combined: --wired runs no tests, so there is no report for a declaration to be checked against');\\n111:   }\\n112: \\n113:   return { requirement: normalizeRequirement(requirement), tier: tier as Tier, wired, expectDeclared };\\n114: }\\n115: \\n116: /* --------------------------------------------------------------- the child environment (leak) */\\n117: \\n118: /**\\n119:  * The ONLY variables a child process inherits. Everything else is dropped.\\n120:  *\\n121:  * WHY AN ALLOWLIST: bun auto-loads `.env` and `.env.local` into this process, and `.env.example`\\n122:  * tells developers to put their real secrets in `.env.local`. Spreading `process.env` into the\\n123:  * test process would hand every one of those to every test â€” and a test reading a conventional\\n124:  * name like `SUPABASE_SERVICE_ROLE_KEY` would then be pointed at the HOSTED project, which the\\n125:  * acceptance suites must never touch. The child gets the platform minimum plus exactly the\\n126:  * values this runner validated. Children are additionally launched with bun's `--no-env-file`,\\n127:  * so a child does not re-read the env files for itself.\\n128:  */\\n129: const ENV_ALLOWLIST = [\\n130:   // process/platform basics\\n131:   'PATH',\\n132:   'PATHEXT',\\n133:   'COMSPEC',\\n134:   'SystemRoot',\\n135:   'SystemDrive',\\n136:   'windir',\\n137:   'OS',\\n138:   'NUMBER_OF_PROCESSORS',\\n139:   'PROCESSOR_ARCHITECTURE',\\n140:   'PROCESSOR_IDENTIFIER',\\n141:   'USERNAME',\\n142:   'LANG',\\n143:   'LC_ALL',\\n144:   'TZ',\\n145:   // temp + home, which bun, vitest and the Supabase CLI all need in order to write caches\\n146:   'TEMP',\\n147:   'TMP',\\n148:   'TMPDIR',\\n149:   'HOME',\\n150:   'HOMEDRIVE',\\n151:   'HOMEPATH',\\n152:   'USERPROFILE',\\n153:   'APPDATA',\\n154:   'LOCALAPPDATA',\\n155:   'PROGRAMDATA',\\n156:   'PROGRAMFILES',\\n157:   'PROGRAMFILES(X86)',\\n158:   'PROGRAMW6432',\\n159:   'XDG_CACHE_HOME',\\n160:   'BUN_INSTALL',\\n161:   // how the Supabase CLI finds the container runtime (never a credential)\\n162:   'DOCKER_HOST',\\n163:   'DOCKER_CONTEXT',\\n164:   'DOCKER_CONFIG',\\n165:   'DOCKER_CERT_PATH',\\n166: ];\\n167: \\n168: /** Windows environment names are case-insensitive, so match that way and keep the parent's casing. */\\n169: export function childEnv(extra: Record<string, string> = {}): Record<string, string> {\\n170:   const wanted = new Set(ENV_ALLOWLIST.map((name) => name.toLowerCase()));\\n171:   const env: Record<string, string> = {};\\n172:   for (const [key, value] of Object.entries(process.env)) {\\n173:     if (value !== undefined && wanted.has(key.toLowerCase())) env[key] = value;\\n174:   }\\n175:   return { ...env, ...extra };\\n176: }\\n177: \\n178: /**\\n179:  * The bun binary. Children are launched under bun deliberately â€” `--no-env-file` is a bun flag,\\n180:  * and it is what stops a child from re-reading `.env`/`.env.local` for itself. Normally this\\n181:  * process IS bun, so its own path is the answer; the PATH lookup only matters when something\\n182:  * else (a test runner's node worker, say) is asking.\\n183:  */\\n184: export function bunExecutable(): string {\\n185:   if (/[\\\\\\\\/]bun(\\\\.exe)?$/i.test(process.execPath)) return process.execPath;\\n186:   const lookup = spawnSync(process.platform === 'win32' ? 'where' : 'which', ['bun'], {\\n187:     encoding: 'utf8',\\n188:     env: childEnv(),\\n189:   });\\n190:   const found = (lookup.stdout ?? '')\\n191:     .split('\\\\n')\\n192:     .map((line) => line.trim())\\n193:     .find(Boolean);\\n194:   if (!found) throw new Error('bun was not found on PATH â€” the harness runs its children under bun');\\n195:   return found;\\n196: }\\n197: \\n198: /* --------------------------------------------------------------------------------- redaction */\\n199: \\n200: /** Strip anything key-shaped out of text that is about to be printed. */\\n201: export function redact(text: string): string {\\n202:   return String(text ?? '')\\n203:     .replace(/eyJ[A-Za-z0-9_-]{5,}\\\\.[A-Za-z0-9_-]{5,}\\\\.[A-Za-z0-9_-]{5,}/g, '<redacted-jwt>')\\n204:     .replace(/\\\\bsb_[a-z]+_[A-Za-z0-9_-]{8,}/g, '<redacted-key>')\\n205:     .replace(/(postgres(?:ql)?:\\\\/\\\\/)[^@\\\\s/]+@/gi, '$1<redacted>@')\\n206:     .replace(/[A-Za-z0-9_-]{40,}/g, '<redacted-token>');\\n207: }\\n208: \\n209: /** First non-empty line, redacted and length-capped â€” enough to diagnose, not enough to leak. */\\n210: export function diagnostic(text: string | undefined, limit = 400): string {\\n211:   const line =\\n212:     redact(text ?? '')\\n213:       .split('\\\\n')\\n214:       .map((l) => l.trim())\\n215:       .find((l) => l.length > 0) ?? '';\\n216:   return line.length > limit ? `${line.slice(0, limit)}â€¦` : line;\\n217: }\\n218: \\n219: /* ------------------------------------------------------------------------ config.toml reading */\\n220: \\n221: export interface LocalConfig {\\n222:   projectId: string;\\n223:   apiPort: number;\\n224:   dbPort: number;\\n225: }\\n226: \\n227: /**\\n228:  * Ports and project id come from `supabase/config.toml` â€” never guessed, never hard-coded.\\n229:  *\\n230:  * The root is a parameter so the database-slot pool can read a SLOT's own config with this exact\\n231:  * scanner instead of a second copy of it. Unset â€” every ordinary run â€” it reads the repo tree, so\\n232:  * the loop and integration call sites behave as they did before the parameter existed.\\n233:  */\\n234: export function readLocalConfig(root: string = REPO_ROOT): LocalConfig {\\n235:   const file = join(root, 'supabase', 'config.toml');\\n236:   const text = readFileSync(file, 'utf8');\\n237:   let section = '';\\n238:   let projectId = '';\\n239:   let apiPort = 0;\\n240:   let dbPort = 0;\\n241: \\n242:   for (const raw of text.split('\\\\n')) {\\n243:     const line = raw.trim();\\n244:     const header = /^\\\\[([^\\\\]]+)\\\\]/.exec(line);\\n245:     if (header) {\\n246:       section = header[1];\\n247:       continue;\\n248:     }\\n249:     const port = /^port\\\\s*=\\\\s*(\\\\d+)/.exec(line);\\n250:     if (section === '' && /^project_id\\\\s*=/.test(line)) projectId = /\\\"([^\\\"]+)\\\"/.exec(line)?.[1] ?? '';\\n251:     else if (section === 'api' && port && !apiPort) apiPort = Number(port[1]);\\n252:     else if (section === 'db' && port && !dbPort) dbPort = Number(port[1]);\\n253:   }\\n254: \\n255:   const missing = [projectId ? '' : 'project_id', apiPort ? '' : '[api] port', dbPort ? '' : '[db] port'].filter(Boolean);\\n256:   if (missing.length) throw new Error(`${file} is missing ${missing.join(' and ')}`);\\n257:   return { projectId, apiPort, dbPort };\\n258: }\\n259: \\n260: /* ---------------------------------------------------------------------- the machine-wide lock */\\n261: \\n262: export interface StackLock {\\n263:   file: string;\\n264:   release(): void;\\n265: }\\n266: \\n267: /**\\n268:  * Where the machine-wide claim files live.\\n269:  *\\n270:  * `AT_LOCK_DIR` overrides it, the same pattern and the same reason as `AT_REPO_ROOT`: a test that\\n271:  * exercises the claim protocol must not write into the directory a real run reads, or a selftest\\n272:  * and a live `at:verify` could take each other's lock. Unset â€” every ordinary run â€” the answer is\\n273:  * unchanged.\\n274:  */\\n275: function lockDir(): string {\\n276:   const override = process.env.AT_LOCK_DIR?.trim();\\n277:   const dir = override ? override : join(process.env.LOCALAPPDATA ?? process.env.XDG_CACHE_HOME ?? tmpdir(), 'ai4good-build', 'at-locks');\\n278:   mkdirSync(dir, { recursive: true });\\n279:   return dir;\\n280: }\\n281: \\n282: function processIsAlive(pid: number): boolean {\\n283:   try {\\n284:     process.kill(pid, 0);\\n285:     return true;\\n286:   } catch (err) {\\n287:     // EPERM means it exists but belongs to someone else; ESRCH means it is gone.\\n288:     return (err as NodeJS.ErrnoException).code === 'EPERM';\\n289:   }\\n290: }\\n291: \\n292: /** The lock path for one stack. Machine-wide, and deliberately carries no folder component. */\\n293: export function stackLockPath(config: LocalConfig): string {\\n294:   return join(lockDir(), `at-verify-${config.projectId}-${config.apiPort}.lock`);\\n295: }\\n296: \\n297: export interface Holder {\\n298:   pid?: number;\\n299:   host?: string;\\n300:   requirement?: string;\\n301:   startedAt?: string;\\n302:   /** Set only on a claim that replaced a stale one, so the takeover is recorded IN the claim. */\\n303:   tookOverFrom?: { pid?: number; startedAt?: string; requirement?: string };\\n304: }\\n305: \\n306: /**\\n307:  * Which holders a caller is allowed to displace.\\n308:  *\\n309:  * `stale-or-dead` is the runner's own long-standing rule: a dead process, or a live one whose\\n310:  * claim is older than `LOCK_STALE_MINUTES`. `dead-pid-only` never displaces a running process at\\n311:  * any age â€” the database-slot pool passes it, because a slot's occupancy is ruled to break on a\\n312:  * dead holder pid and on nothing else. A run that legitimately lasts longer than the stale window\\n313:  * must not have its database reset under it.\\n314:  */\\n315: export type TakeoverPolicy = 'stale-or-dead' | 'dead-pid-only';\\n316: \\n317: export interface StackLockOptions {\\n318:   takeover?: TakeoverPolicy;\\n319: }\\n320: \\n321: /** Live = a holder this policy may not displace. */\\n322: function holderIsLive(holder: Holder, policy: TakeoverPolicy = 'stale-or-dead'): boolean {\\n323:   if (typeof holder.pid !== 'number' || !processIsAlive(holder.pid)) return false;\\n324:   if (policy === 'dead-pid-only') return true;\\n325:   const startedAt = holder.startedAt ? Date.parse(holder.startedAt) : NaN;\\n326:   const ageMinutes = Number.isFinite(startedAt) ? (Date.now() - startedAt) / 60_000 : Infinity;\\n327:   return ageMinutes < LOCK_STALE_MINUTES;\\n328: }\\n329: \\n330: function heldByAnotherRun(holder: Holder, file: string): Error {\\n331:   return new Error(\\n332:     `another at:verify run holds this stack (pid ${holder.pid} on ${holder.host ?? 'this machine'}, ` +\\n333:       `requirement ${holder.requirement ?? 'unknown'}, started ${holder.startedAt ?? 'unknown'}). ` +\\n334:       `Two runs against one stack destroy each other: the second would reset the first's database ` +\\n335:       `mid-run. Wait for it to finish. If that process is definitely gone, delete ${file}.`,\\n336:   );\\n337: }\\n338: \\n339: /**\\n340:  * A gate left behind by a process that died mid-takeover. The section lasts milliseconds, so\\n341:  * anything this old is certainly abandoned; removing one wrongly costs at most two processes in\\n342:  * the section, which is the behaviour we had before the gate existed.\\n343:  */\\n344: function clearStrandedGate(gate: string): void {\\n345:   try {\\n346:     const held = JSON.parse(readFileSync(gate, 'utf8')) as { pid?: number; at?: string };\\n347:     const at = held.at ? Date.parse(held.at) : NaN;\\n348:     const ageMinutes = Number.isFinite(at) ? (Date.now() - at) / 60_000 : Infinity;\\n349:     const alive = typeof held.pid === 'number' && processIsAlive(held.pid);\\n350:     if (!alive || ageMinutes > GATE_STALE_MINUTES) rmSync(gate, { force: true });\\n351:   } catch {\\n352:     // unreadable or already gone â€” the next pass finds out\\n353:   }\\n354: }\\n355: \\n356: /**\\n357:  * Serialize every destructive run against one stack. The key is project id + api port because\\n358:  * that pair IS the stack's identity: a second checkout carrying the same `project_id` shares the\\n359:  * same Docker containers and the same ports, so its `at:verify` would reset this run's database\\n360:  * out from under it. Mirrors `Acquire-WorkLock` in loop/work/work-lib.ps1 â€” exclusive create,\\n361:  * holder recorded, stale takeover.\\n362:  *\\n363:  * TAKEOVER IS THE WHOLE DIFFICULTY. Two processes can both read the same leftover lock and both\\n364:  * conclude it is stale; if each then removed it and created its own, the second removal would take\\n365:  * out the FIRST one's brand-new live lock and both would run â€” the precise failure this exists to\\n366:  * prevent. Moving the stale file aside with an atomic rename does NOT fix that: the winner\\n367:  * repopulates the path microseconds later, so the loser's rename succeeds against a LIVE lock,\\n368:  * which is just as destructive as unlinking it. (Proved with a two-contender race, not reasoned\\n369:  * about; the race is in runner.selftest.ts.)\\n370:  *\\n371:  * So the takeover DECISION is serialized by a second exclusive-create lock â€” the gate. Only one\\n372:  * process is ever inside it, and it re-reads the holder INSIDE, so:\\n373:  *   - no other process can be taking over concurrently (the gate is exclusive);\\n374:  *   - no ordinary claim can have slipped in, because the stale file occupies the path continuously\\n375:  *     until the gate holder removes it, and an exclusive create only succeeds on a free path;\\n376:  *   - if a third process wins the claim in the instant after removal, the gate holder's own create\\n377:  *     simply fails and it restarts, having deleted nothing further.\\n378:  * A gate stranded by a killed process is cleared on age. The section lasts milliseconds, so a live\\n379:  * holder never reaches that threshold, and clearing one wrongly degrades to two takers in the\\n380:  * section â€” today's behaviour, not worse.\\n381:  */\\n382: export function acquireStackLock(config: LocalConfig, requirement: string, options: StackLockOptions = {}): StackLock {\\n383:   const file = stackLockPath(config);\\n384:   const policy: TakeoverPolicy = options.takeover ?? 'stale-or-dead';\\n385: \\n386:   const claim = (displaced?: Holder): StackLock | null => {\\n387:     let fd: number;\\n388:     try {\\n389:       fd = openSync(file, 'wx');\\n390:     } catch (err) {\\n391:       if ((err as NodeJS.ErrnoException).code === 'EEXIST') return null;\\n392:       throw err;\\n393:     }\\n394:     try {\\n395:       writeSync(\\n396:         fd,\\n397:         JSON.stringify({\\n398:           pid: process.pid,\\n399:           host: hostname(),\\n400:           requirement,\\n401:           startedAt: new Date().toISOString(),\\n402:           // A takeover recorded ONLY on the console is lost the moment the terminal scrolls. The\\n403:           // claim file outlives the run that wrote it, so whoever reads it later can see that this\\n404:           // occupancy began by displacing an abandoned one, and whose.\\n405:           ...(displaced\\n406:             ? {\\n407:                 tookOverFrom: {\\n408:                   pid: displaced.pid,\\n409:                   startedAt: displaced.startedAt,\\n410:                   requirement: displaced.requirement,\\n411:                 },\\n412:               }\\n413:             : {}),\\n414:         }),\\n415:       );\\n416:     } finally {\\n417:       closeSync(fd);\\n418:     }\\n419:     return {\\n420:       file,\\n421:       release: () => {\\n422:         try {\\n423:           const held = JSON.parse(readFileSync(file, 'utf8')) as { pid?: number };\\n424:           if (held.pid === process.pid) rmSync(file, { force: true });\\n425:         } catch {\\n426:           // already removed, or unreadable â€” nothing of ours left to release\\n427:         }\\n428:       },\\n429:     };\\n430:   };\\n431: \\n432:   const gate = `${file}.takeover`;\\n433: \\n434:   /** The recorded holder, or null if the lock is gone. */\\n435:   const readHolder = (): Holder | null => {\\n436:     try {\\n437:       return JSON.parse(readFileSync(file, 'utf8')) as Holder;\\n438:     } catch (err) {\\n439:       if ((err as NodeJS.ErrnoException).code === 'ENOENT') return null;\\n440:       return {}; // unreadable or half-written: treat as an unidentifiable holder, judged below\\n441:     }\\n442:   };\\n443: \\n444:   /** Bounded synchronous pause; a gate is held for milliseconds, so this is all the wait needed. */\\n445:   const pause = (ms: number) => {\\n446:     const until = Date.now() + ms;\\n447:     while (Date.now() < until) {\\n448:       /* spin */\\n449:     }\\n450:   };\\n451: \\n452:   /**\\n453:    * UNDER `dead-pid-only`, AN UNIDENTIFIABLE HOLDER IS NEVER TAKEOVER-ELIGIBLE.\\n454:    *\\n455:    * `readHolder` returns `{}` for a file it cannot read or parse, and `holderIsLive({})` is false\\n456:    * under every policy â€” so without this guard a claim file that is empty or half written looks\\n457:    * exactly like a dead holder and is deleted. The window is real and small: it is the microseconds\\n458:    * between `openSync(file, 'wx')` and the `writeSync` that fills the file, so a second occupier\\n459:    * arriving in that instant would remove a LIVE process's brand-new claim. That is the one thing\\n460:    * this policy exists to make impossible.\\n461:    *\\n462:    * One bounded re-read skates over the write window. A holder that STILL has no parseable pid is\\n463:    * not a dead holder â€” it is a file nobody in this process can account for â€” so it refuses loudly\\n464:    * and names the manual repair. `stale-or-dead` keeps its long-standing behaviour: that path\\n465:    * predates the slot pool and is another item's business.\\n466:    *\\n467:    * Returns the identified holder, or null when the file went away and the loop should retry.\\n468:    */\\n469:   const identified = (holder: Holder, where: string): Holder | null => {\\n470:     if (typeof holder.pid === 'number') return holder;\\n471:     if (policy !== 'dead-pid-only') return holder;\\n472: \\n473:     pause(50);\\n474:     const again = readHolder();\\n475:     if (again === null) return null; // released while we looked; the loop takes the free path\\n476:     if (typeof again.pid === 'number') return again;\\n477: \\n478:     throw new Error(\\n479:       `refusing to take over the claim at ${file}: it names no process id that this run can read, ` +\\n480:         `so it cannot be shown to be dead â€” and a claim file being written right now looks exactly ` +\\n481:         `like this. Nothing was taken over. If no run holds that stack, delete ${file} by hand ` +\\n482:         `(checked ${where}).`,\\n483:     );\\n484:   };\\n485: \\n486:   // Bounded: every retry follows another process winning the gate, which cannot repeat forever.\\n487:   for (let attempt = 0; attempt < 20; attempt++) {\\n488:     const claimed = claim();\\n489:     if (claimed) return claimed;\\n490: \\n491:     const read = readHolder();\\n492:     if (read === null) continue; // released between the failed claim and the read\\n493:     const holder = identified(read, 'before the takeover gate');\\n494:     if (holder === null) continue;\\n495:     if (holderIsLive(holder, policy)) throw heldByAnotherRun(holder, file);\\n496: \\n497:     // Stale. Enter the takeover gate â€” the only place the live lock path may be removed.\\n498:     let gateFd: number;\\n499:     try {\\n500:       gateFd = openSync(gate, 'wx');\\n501:     } catch (err) {\\n502:       if ((err as NodeJS.ErrnoException).code !== 'EEXIST') throw err;\\n503:       clearStrandedGate(gate);\\n504:       pause(10);\\n505:       continue;\\n506:     }\\n507: \\n508:     try {\\n509:       writeSync(gateFd, JSON.stringify({ pid: process.pid, at: new Date().toISOString() }));\\n510:       const readInside = readHolder();\\n511:       if (readInside === null) continue; // released while we were entering; the next claim takes it\\n512:       // The same guard as above: the gate must not be able to remove an unidentifiable file either.\\n513:       const inside = identified(readInside, 'inside the takeover gate');\\n514:       if (inside === null) continue;\\n515:       if (holderIsLive(inside, policy)) continue; // refreshed under us; the next pass refuses it properly\\n516: \\n517:       rmSync(file, { force: true });\\n518:       const takeover = claim(inside);\\n519:       if (!takeover) continue; // a third process claimed the free path first â€” delete nothing more\\n520: \\n521:       console.log(\\n522:         `at:verify â€” took over a stale stack lock (holder pid ${inside.pid ?? 'unknown'} ` +\\n523:           `${typeof inside.pid === 'number' && processIsAlive(inside.pid) ? `is older than ${LOCK_STALE_MINUTES} minutes` : 'is no longer running'})`,\\n524:       );\\n525:       return takeover;\\n526:     } finally {\\n527:       closeSync(gateFd);\\n528:       rmSync(gate, { force: true });\\n529:     }\\n530:   }\\n531: \\n532:   throw new Error(`could not acquire the stack lock at ${file} â€” it kept changing hands; try again`);\\n533: }\\n534: \\n535: /* -------------------------------------------------------------------- the stack's own report */\\n536: \\n537: export interface StackStatus {\\n538:   apiUrl: string;\\n539:   dbUrl: string;\\n540:   anonKey: string;\\n541:   serviceRoleKey: string;\\n542: }\\n543: \\n544: const REQUIRED_STATUS_FIELDS: Record<keyof StackStatus, string> = {\\n545:   apiUrl: 'API_URL',\\n546:   dbUrl: 'DB_URL',\\n547:   anonKey: 'ANON_KEY',\\n548:   serviceRoleKey: 'SERVICE_ROLE_KEY',\\n549: };\\n550: \\n551: export function supabaseArgs(...args: string[]): string[] {\\n552:   if (!existsSync(SUPABASE_ENTRY)) throw new Error(`the Supabase CLI is not installed at ${SUPABASE_ENTRY} â€” run \\\\`bun install\\\\``);\\n553:   return ['--no-env-file', SUPABASE_ENTRY, ...args];\\n554: }\\n555: \\n556: /**\\n557:  * WHICH PROJECT an invocation acts on. A target names both halves of an identity, because either\\n558:  * half alone is a hybrid.\\n559:  */\\n560: export interface CliTarget {\\n561:   /** The directory that CONTAINS the `supabase/` project folder â€” what `--workdir` names. */\\n562:   workdir: string;\\n563:   /** The project id the invocation must resolve, stated POSITIVELY in `SUPABASE_PROJECT_ID`. */\\n564:   projectId: string;\\n565: }\\n566: \\n567: export interface CliInvocation {\\n568:   args: string[];\\n569:   cwd: string;\\n570:   env: Record<string, string>;\\n571: }\\n572: \\n573: /**\\n574:  * THE ONE SEAM every Supabase CLI invocation is built at. Nothing in this repository assembles a\\n575:  * CLI command line, working directory or environment anywhere else, and that single seam is the\\n576:  * whole wall â€” a wall with two builders is a wall with a gap.\\n577:  *\\n578:  * THREE THINGS HAVE TO AGREE, and the reason each is here was measured, not reasoned about:\\n579:  *\\n580:  *   1. `SUPABASE_PROJECT_ID`, set POSITIVELY to the target's project id. The CLI treats that\\n581:  *      variable as an OVERRIDE of `project_id` in `config.toml`. The repo's tracked `.env` carries\\n582:  *      it, bun loads `.env` into this process, and on 2026-08-09 a `db reset` aimed at slot 2\\n583:  *      destroyed the founder's personal database because the environment supplied the identity\\n584:  *      while the slot's config supplied the ports. The wall is stating the identity, never merely\\n585:  *      avoiding an override: an absence can be reintroduced by any parent process, a positive\\n586:  *      value cannot.\\n587:  *   2. NO OTHER `SUPABASE_*` variable. `childEnv` is an allowlist that carries none, and this\\n588:  *      function asserts that rather than trusting it, because the allowlist is edited by people.\\n589:  *   3. The WORKING DIRECTORY, equal to `--workdir`. Measured 2026-08-10: when the CLI's working\\n590:  *      directory is itself a Supabase project, `--workdir <other>` produces a hybrid â€” the other\\n591:  *      project's ports beside the working directory's project's containers. Run from a directory\\n592:  *      that is not a project, the same command correctly says\\n593:  *      `No such container: supabase_db_ai4good-slot-1`.\\n594:  *\\n595:  * `bun --no-env-file` (in `supabaseArgs`) closes the fourth route: a child that re-reads `.env`\\n596:  * for itself.\\n597:  *\\n598:  * No target means the repository's own project, exactly as every call site behaved before targets\\n599:  * existed: no `--workdir`, the repo root, and an environment carrying no `SUPABASE_*` at all.\\n600:  */\\n601: export function supabaseInvocation(target: CliTarget | undefined, args: string[]): CliInvocation {\\n602:   if (!target) return { args: supabaseArgs(...args), cwd: REPO_ROOT, env: childEnv() };\\n603: \\n604:   const env = childEnv({ SUPABASE_PROJECT_ID: target.projectId });\\n605:   const foreign = Object.keys(env).filter((name) => /^SUPABASE_/i.test(name) && name.toUpperCase() !== 'SUPABASE_PROJECT_ID');\\n606:   if (foreign.length) {\\n607:     throw new Error(\\n608:       `refusing to run the Supabase CLI against ${target.projectId}: the child environment would also carry ` +\\n609:         `${foreign.join(', ')}, and a second SUPABASE_* variable can override the identity this invocation states.`,\\n610:     );\\n611:   }\\n612:   if (env.SUPABASE_PROJECT_ID !== target.projectId) {\\n613:     throw new Error(`refusing to run the Supabase CLI: SUPABASE_PROJECT_ID would not be \\\"${target.projectId}\\\"`);\\n614:   }\\n615:   return { args: supabaseArgs('--workdir', target.workdir, ...args), cwd: target.workdir, env };\\n616: }\\n617: \\n618: export interface CliResult {\\n619:   status: number | null;\\n620:   signal?: NodeJS.Signals | null;\\n621:   stdout: string;\\n622:   stderr: string;\\n623:   error?: Error;\\n624: }\\n625: \\n626: /** Run the pinned CLI through the seam and hand back the RAW result. The caller decides what to\\n627:  * read and what may be printed â€” raw output carries every key the stack issues. */\\n628: export function runSupabaseCli(target: CliTarget | undefined, args: string[]): CliResult {\\n629:   const invocation = supabaseInvocation(target, args);\\n630:   const res = spawnSync(bunExecutable(), invocation.args, { cwd: invocation.cwd, env: invocation.env, encoding: 'utf8' });\\n631:   return {\\n632:     status: res.status,\\n633:     signal: res.signal,\\n634:     stdout: res.stdout ?? '',\\n635:     stderr: res.stderr ?? '',\\n636:     error: res.error as Error | undefined,\\n637:   };\\n638: }\\n639: \\n640: /**\\n641:  * Ask the running stack to describe itself. The raw output is NEVER printed: it contains every\\n642:  * key the stack issues. Only field names travel into error messages.\\n643:  */\\n644: export function readStackStatus(target?: CliTarget): StackStatus {\\n645:   return parseStackStatus(runSupabaseCli(target, ['status', '-o', 'json']));\\n646: }\\n647: \\n648: /**\\n649:  * The status parser, separate from the invocation so that a caller which needs the RAW output for\\n650:  * its own checks (the slot pool's identity read) reads it once and parses the same result, rather\\n651:  * than running the CLI twice or keeping a second copy of this parser.\\n652:  */\\n653: export function parseStackStatus(res: CliResult): StackStatus {\\n654:   if (res.error) {\\n655:     const err = res.error as NodeJS.ErrnoException;\\n656:     throw new Error(`could not launch the Supabase CLI (${err.code ?? 'spawn error'}): ${diagnostic(err.message)}`);\\n657:   }\\n658: \\n659:   const stdout = res.stdout ?? '';\\n660:   const open = stdout.indexOf('{');\\n661:   const close = stdout.lastIndexOf('}');\\n662:   if (open < 0 || close <= open) {\\n663:     throw new Error(\\n664:       `\\\\`supabase status\\\\` reported no JSON (exit ${res.status}${res.signal ? `, signal ${res.signal}` : ''}): ` +\\n665:         `${diagnostic(res.stderr) || '(no error output)'}`,\\n666:     );\\n667:   }\\n668: \\n669:   // The CLI exits non-zero merely because config.toml disables imgproxy and the pooler. That is\\n670:   // not a failure; anything ELSE reported stopped is.\\n671:   const notice = `${stdout.slice(0, open)}\\\\n${res.stderr ?? ''}`;\\n672:   const stopped = /Stopped services:\\\\s*\\\\[([^\\\\]]*)\\\\]/.exec(notice)?.[1] ?? '';\\n673:   const unexpectedStopped = stopped.split(/\\\\s+/).filter((name) => name && !DISABLED_SERVICES.test(name));\\n674:   if (unexpectedStopped.length) {\\n675:     throw new Error(`the stack reports stopped services: ${unexpectedStopped.join(', ')} â€” start them before running the suite`);\\n676:   }\\n677: \\n678:   let parsed: Record<string, unknown>;\\n679:   try {\\n680:     parsed = JSON.parse(stdout.slice(open, close + 1)) as Record<string, unknown>;\\n681:   } catch (err) {\\n682:     throw new Error(`\\\\`supabase status\\\\` produced unparseable JSON: ${(err as Error).message}`);\\n683:   }\\n684: \\n685:   const status: Partial<StackStatus> = {};\\n686:   const missing: string[] = [];\\n687:   for (const [field, key] of Object.entries(REQUIRED_STATUS_FIELDS) as [keyof StackStatus, string][]) {\\n688:     const value = parsed[key];\\n689:     if (typeof value !== 'string' || value.trim() === '') missing.push(key);\\n690:     else status[field] = value;\\n691:   }\\n692:   if (missing.length) throw new Error(`\\\\`supabase status\\\\` reported no ${missing.join(', no ')}`);\\n693:   return status as StackStatus;\\n694: }\\n695: \\n696: /* --------------------------------------------------------- proving the stack is the LOCAL one */\\n697: \\n698: const LOOPBACK = new Set(['127.0.0.1', 'localhost', '::1', '[::1]']);\\n699: \\n700: function decodeJwtClaims(token: string): Record<string, unknown> | null {\\n701:   const parts = token.split('.');\\n702:   if (parts.length !== 3) return null;\\n703:   try {\\n704:     return JSON.parse(Buffer.from(parts[1], 'base64url').toString('utf8')) as Record<string, unknown>;\\n705:   } catch {\\n706:     return null;\\n707:   }\\n708: }\\n709: \\n710: /**\\n711:  * Refuse to touch anything that is not demonstrably the local development stack. Returns the\\n712:  * names of the checks that failed â€” never the values, which are keys and connection strings.\\n713:  */\\n714: export function localStackProblems(status: StackStatus, config: LocalConfig): string[] {\\n715:   const problems: string[] = [];\\n716: \\n717:   const checkUrl = (label: string, raw: string, expectedPort: number) => {\\n718:     let url: URL;\\n719:     try {\\n720:       url = new URL(raw);\\n721:     } catch {\\n722:       problems.push(`${label} is not a URL`);\\n723:       return;\\n724:     }\\n725:     if (!LOOPBACK.has(url.hostname)) problems.push(`${label} does not point at the loopback address`);\\n726:     if (url.port !== String(expectedPort)) problems.push(`${label} port is not the ${expectedPort} configured in supabase/config.toml`);\\n727:   };\\n728: \\n729:   checkUrl('API_URL', status.apiUrl, config.apiPort);\\n730:   checkUrl('DB_URL', status.dbUrl, config.dbPort);\\n731: \\n732:   const checkKey = (label: string, token: string, expectedRole: string) => {\\n733:     const claims = decodeJwtClaims(token);\\n734:     if (!claims) {\\n735:       problems.push(`${label} is not a decodable local development JWT`);\\n736:       return;\\n737:     }\\n738:     if (claims.iss !== 'supabase-demo') problems.push(`${label} was not issued by the local development issuer`);\\n739:     if (claims.role !== expectedRole) problems.push(`${label} does not carry the ${expectedRole} role`);\\n740:     if (typeof claims.ref === 'string') problems.push(`${label} carries a hosted project reference`);\\n741:   };\\n742: \\n743:   checkKey('ANON_KEY', status.anonKey, 'anon');\\n744:   checkKey('SERVICE_ROLE_KEY', status.serviceRoleKey, 'service_role');\\n745: \\n746:   return problems;\\n747: }\\n748: \\n749: /* --------------------------------------------------------------------------------- readiness */\\n750: \\n751: interface BunSqlClient {\\n752:   (strings: TemplateStringsArray, ...values: unknown[]): Promise<unknown>;\\n753:   close(): Promise<void>;\\n754: }\\n755: type BunSqlCtor = new (url: string) => BunSqlClient;\\n756: \\n757: /** Postgres itself answers a query â€” not \\\"the port is open\\\", which a half-started stack satisfies. */\\n758: async function databaseAnswers(dbUrl: string): Promise<string | null> {\\n759:   const SQL = (globalThis as { Bun?: { SQL?: BunSqlCtor } }).Bun?.SQL;\\n760:   if (!SQL) return 'this runtime has no SQL client (expected bun)';\\n761:   let sql: BunSqlClient | null = null;\\n762:   try {\\n763:     sql = new SQL(dbUrl);\\n764:     await sql`select 1`;\\n765:     return null;\\n766:   } catch (err) {\\n767:     return diagnostic((err as Error).message);\\n768:   } finally {\\n769:     await sql?.close().catch(() => undefined);\\n770:   }\\n771: }\\n772: \\n773: /** One request that only succeeds if Kong routed it, PostgREST served it, and Postgres answered. */\\n774: async function gatewayAnswers(status: StackStatus): Promise<string | null> {\\n775:   try {\\n776:     const res = await fetch(`${status.apiUrl.replace(/\\\\/$/, '')}/rest/v1/`, {\\n777:       headers: { apikey: status.anonKey, Authorization: `Bearer ${status.anonKey}` },\\n778:       signal: AbortSignal.timeout(5000),\\n779:     });\\n780:     if (!res.ok) return `the API gateway answered ${res.status}`;\\n781:     const type = res.headers.get('content-type') ?? '';\\n782:     if (!type.includes('json')) return `the API gateway answered 200 but served ${type || 'no content type'}`;\\n783:     return null;\\n784:   } catch (err) {\\n785:     return diagnostic((err as Error).message);\\n786:   }\\n787: }\\n788: \\n789: /**\\n790:  * Wait until the stack is genuinely usable, or give up. \\\"Something answered on the port\\\" is not\\n791:  * readiness: a half-started stack answers 502/503, and a run launched against it fails in ways\\n792:  * that look like test failures instead of infrastructure failures.\\n793:  */\\n794: export async function waitForReady(status: StackStatus, phase: string): Promise<void> {\\n795:   const deadline = Date.now() + READY_TIMEOUT_MS;\\n796:   let lastProblem = 'not attempted';\\n797:   let delay = 250;\\n798: \\n799:   while (Date.now() < deadline) {\\n800:     const db = await databaseAnswers(status.dbUrl);\\n801:     if (db === null) {\\n802:       const gateway = await gatewayAnswers(status);\\n803:       if (gateway === null) return;\\n804:       lastProblem = gateway;\\n805:     } else {\\n806:       lastProblem = `the database did not answer: ${db}`;\\n807:     }\\n808:     await new Promise((resolve) => setTimeout(resolve, delay));\\n809:     delay = Math.min(delay * 2, 2000);\\n810:   }\\n811: \\n812:   throw new Error(`the stack was still not ready ${phase} after ${Math.round(READY_TIMEOUT_MS / 1000)}s â€” last problem: ${lastProblem}`);\\n813: }\\n814: \\n815: /* --------------------------------------------------------------------- the migration-set proof */\\n816: \\n817: /** Counted, not just proved â€” the pool's evidence line has to state the migration state it saw. */\\n818: export interface MigrationProof {\\n819:   expected: number;\\n820:   applied: number;\\n821: }\\n822: \\n823: /**\\n824:  * The migrations the reset is supposed to replay, read from disk. The CLI names them\\n825:  * `<timestamp>_name.sql` and records the timestamp as the applied version, so the timestamp is\\n826:  * the identity. `.gitkeep` and `README.md` are not migrations and are ignored.\\n827:  */\\n828: export function expectedMigrations(root: string = REPO_ROOT): string[] {\\n829:   const dir = join(root, 'supabase', 'migrations');\\n830:   if (!existsSync(dir)) return [];\\n831:   return readdirSync(dir)\\n832:     .map((name) => /^(\\\\d{14})_.*\\\\.sql$/.exec(name)?.[1])\\n833:     .filter((version): version is string => Boolean(version))\\n834:     .sort();\\n835: }\\n836: \\n837: /** What the database says it actually replayed. */\\n838: async function appliedMigrations(dbUrl: string): Promise<string[]> {\\n839:   const SQL = (globalThis as { Bun?: { SQL?: BunSqlCtor } }).Bun?.SQL;\\n840:   if (!SQL) throw new Error('this runtime has no SQL client (expected bun)');\\n841:   let sql: BunSqlClient | null = null;\\n842:   try {\\n843:     sql = new SQL(dbUrl);\\n844:     const rows = (await sql`select version from supabase_migrations.schema_migrations order by version`) as {\\n845:       version: string;\\n846:     }[];\\n847:     return rows.map((row) => String(row.version)).sort();\\n848:   } catch (err) {\\n849:     // A database that has never had a migration applied has no history table at all. \\\"No table\\\"\\n850:     // and \\\"empty table\\\" mean the same thing â€” nothing was applied â€” and saying so lets the\\n851:     // comparison below name exactly which migrations are missing instead of reporting a SQL error.\\n852:     const message = (err as Error).message ?? '';\\n853:     if (/schema_migrations/.test(message) && /does not exist/i.test(message)) return [];\\n854:     throw new Error(`could not read the migration history: ${diagnostic(message)}`);\\n855:   } finally {\\n856:     await sql?.close().catch(() => undefined);\\n857:   }\\n858: }\\n859: \\n860: /** Exact set equality, both directions, named plainly. */\\n861: export function migrationSetProblems(expected: string[], applied: string[]): string[] {\\n862:   const missing = expected.filter((version) => !applied.includes(version));\\n863:   const extra = applied.filter((version) => !expected.includes(version));\\n864:   const problems: string[] = [];\\n865:   if (missing.length) problems.push(`never applied: ${missing.join(', ')}`);\\n866:   if (extra.length) problems.push(`applied but not in supabase/migrations: ${extra.join(', ')}`);\\n867:   return problems;\\n868: }\\n869: \\n870: /**\\n871:  * Prove the rebuild actually replayed the migration set â€” the promise `supabase/migrations/README.md`\\n872:  * makes. \\\"The reset command exited zero\\\" is not that proof: a reset that replays NOTHING also exits\\n873:  * zero, and a suite then grades an empty schema while believing it graded the real one.\\n874:  *\\n875:  * An empty expected set is legitimate today (no migrations have been written yet) and is allowed â€”\\n876:  * but it is STATED on every run, so an empty rebuild can never be silently mistaken for a real one.\\n877:  */\\n878: export async function proveMigrationsReplayed(status: StackStatus, root: string = REPO_ROOT): Promise<MigrationProof> {\\n879:   const expected = expectedMigrations(root);\\n880:   const applied = await appliedMigrations(status.dbUrl);\\n881:   const problems = migrationSetProblems(expected, applied);\\n882: \\n883:   const summary = `${expected.length} migration${expected.length === 1 ? '' : 's'} expected, ${applied.length} applied`;\\n884:   if (problems.length) {\\n885:     throw new Error(`the rebuilt database does not match supabase/migrations (${summary}) â€” ${problems.join('; ')}`);\\n886:   }\\n887:   console.log(\\n888:     expected.length === 0\\n889:       ? `at:verify â€” ${summary} â€” the schema is empty by design at this stage`\\n890:       : `at:verify â€” ${summary} â€” the rebuilt schema matches supabase/migrations exactly`,\\n891:   );\\n892:   return { expected: expected.length, applied: applied.length };\\n893: }\\n894: \\n895: /* ------------------------------------------------------------------------------------- reset */\\n896: \\n897: /**\\n898:  * Rebuild the local database from `supabase/migrations` â€” the same work `bun run db:reset` does,\\n899:  * invoked at the pinned CLI so failures are catchable and bounded.\\n900:  *\\n901:  * WHY EVERY RUN: without it the second run works on the first run's leftover rows, and on a\\n902:  * schema missing whatever migration landed since â€” a suite grading a database nobody established.\\n903:  */\\n904: export async function resetLocalDatabase(target?: CliTarget): Promise<void> {\\n905:   const invocation = supabaseInvocation(target, ['db', 'reset', '--local']);\\n906:   const child = spawn(bunExecutable(), invocation.args, {\\n907:     cwd: invocation.cwd,\\n908:     env: invocation.env,\\n909:     // progress is worth watching (a reset replays every migration); stderr is captured so a\\n910:     // failure can be reported in our own words rather than scrolling past.\\n911:     stdio: ['ignore', 'inherit', 'pipe'],\\n912:   });\\n913: \\n914:   let stderr = '';\\n915:   child.stderr?.on('data', (chunk: Buffer) => {\\n916:     stderr = (stderr + chunk.toString('utf8')).slice(-8000);\\n917:   });\\n918: \\n919:   let timedOut = false;\\n920:   const timer = setTimeout(() => {\\n921:     timedOut = true;\\n922:     // Kill the TREE: the CLI shells out to the container runtime, and killing only the parent\\n923:     // leaves a migration running against the database this run is about to test.\\n924:     if (child.pid && process.platform === 'win32') spawnSync('taskkill', ['/PID', String(child.pid), '/T', '/F'], { stdio: 'ignore' });\\n925:     else child.kill('SIGKILL');\\n926:   }, RESET_TIMEOUT_MS);\\n927: \\n928:   try {\\n929:     await new Promise<void>((resolve, reject) => {\\n930:       child.once('error', (err) => {\\n931:         const e = err as NodeJS.ErrnoException;\\n932:         reject(new Error(`the reset process could not be launched (${e.code ?? 'spawn error'}): ${diagnostic(e.message)}`));\\n933:       });\\n934:       child.once('close', (code, signal) => {\\n935:         if (timedOut) {\\n936:           reject(new Error(`the reset did not finish within ${Math.round(RESET_TIMEOUT_MS / 1000)}s and its process tree was killed`));\\n937:         } else if (code === 0) {\\n938:           resolve();\\n939:         } else {\\n940:           const how = code === null ? `was killed by signal ${signal}` : `exited ${code}`;\\n941:           reject(new Error(`\\\\`supabase db reset\\\\` ${how}: ${diagnostic(stderr) || '(no error output)'}`));\\n942:         }\\n943:       });\\n944:     });\\n945:   } finally {\\n946:     clearTimeout(timer);\\n947:   }\\n948: }\\n949: \\n950: /* --------------------------------------------------------------------------- vitest json shape */\\n951: \\n952: export interface AssertionResult {\\n953:   title?: string;\\n954:   fullName?: string;\\n955:   status?: string;\\n956:   failureMessages?: string[];\\n957: }\\n958: \\n959: /**\\n960:  * The report's own arithmetic, alongside the per-test results. `--expect` needs both: the id\\n961:  * parser only sees tests whose titles carry an AT id, so an untagged `it()` that fails is\\n962:  * invisible to it and visible in these counts. Optional because this describes a file on disk â€”\\n963:  * a missing field is validated at runtime (see `reportAccountingDeviations`), not asserted here.\\n964:  */\\n965: interface VitestJson {\\n966:   /**\\n967:    * One entry per test FILE. `status` and `message` are kept alongside the assertions because a\\n968:    * file that fails to import, or whose hook throws, changes no test's status: that failure is\\n969:    * visible here and nowhere else in the report.\\n970:    */\\n971:   testResults?: { name?: string; status?: string; message?: string; assertionResults?: AssertionResult[] }[];\\n972:   numTotalTests?: number;\\n973:   numPassedTests?: number;\\n974:   numFailedTests?: number;\\n975:   numPendingTests?: number;\\n976:   numTodoTests?: number;\\n977:   success?: boolean;\\n978: }\\n979: \\n980: export interface IdRow {\\n981:   id: string;\\n982:   status: 'green' | 'red' | 'missing';\\n983:   detail: string;\\n984: }\\n985: \\n986: export interface RuntimeRegistration {\\n987:   atId: string;\\n988:   title: string;\\n989:   surface: string;\\n990: }\\n991: \\n992: export interface ReportAnalysis {\\n993:   rows: IdRow[];\\n994:   unexpected: string[];\\n995: }\\n996: \\n997: function assertionId(assertion: AssertionResult): string | null {\\n998:   return /^(AT-[\\\\d.]+[a-z]?)\\\\s+â€”/.exec(assertion.title ?? assertion.fullName ?? '')?.[1] ?? null;\\n999: }\\n1000: \\n1001: export function analyzeReportedTests(\\n1002:   expected: string[],\\n1003:   registrations: RuntimeRegistration[],\\n1004:   assertions: AssertionResult[],\\n1005: ): ReportAnalysis {\\n1006:   const registrationGroups = new Map<string, RuntimeRegistration[]>();\\n1007:   for (const registration of registrations) {\\n1008:     const group = registrationGroups.get(registration.atId) ?? [];\\n1009:     group.push(registration);\\n1010:     registrationGroups.set(registration.atId, group);\\n1011:   }\\n1012: \\n1013:   const assertionGroups = new Map<string, AssertionResult[]>();\\n1014:   for (const assertion of assertions) {\\n1015:     const id = assertionId(assertion);\\n1016:     if (!id) continue;\\n1017:     const group = assertionGroups.get(id) ?? [];\\n1018:     group.push(assertion);\\n1019:     assertionGroups.set(id, group);\\n1020:   }\\n1021: \\n1022:   const rows: IdRow[] = expected.map((id) => {\\n1023:     const runtime = registrationGroups.get(id) ?? [];\\n1024:     const results = assertionGroups.get(id) ?? [];\\n1025:     if (runtime.length !== 1) {\\n1026:       return {\\n1027:         id,\\n1028:         status: 'red',\\n1029:         detail:\\n1030:           runtime.length === 0\\n1031:             ? 'no runtime registration emitted by atTest'\\n1032:             : `${runtime.length} runtime registrations emitted by atTest; expected exactly 1`,\\n1033:       };\\n1034:     }\\n1035:     if (results.length !== 1) {\\n1036:       return {\\n1037:         id,\\n1038:         status: 'red',\\n1039:         detail: `${results.length} Vitest results reported; expected exactly 1`,\\n1040:       };\\n1041:     }\\n1042: \\n1043:     const result = results[0];\\n1044:     const expectedTitle = `${id} â€” ${runtime[0].title}`;\\n1045:     if (result.title !== expectedTitle) {\\n1046:       return {\\n1047:         id,\\n1048:         status: 'red',\\n1049:         detail: `Vitest title ${JSON.stringify(result.title)} does not match runtime registration ${JSON.stringify(expectedTitle)}`,\\n1050:       };\\n1051:     }\\n1052:     if (result.status !== 'passed') {\\n1053:       return {\\n1054:         id,\\n1055:         status: 'red',\\n1056:         detail: firstLine(result.failureMessages?.join('\\\\n'), `status \\\"${result.status}\\\"`),\\n1057:       };\\n1058:     }\\n1059:     return { id, status: 'green', detail: runtime[0].title };\\n1060:   });\\n1061: \\n1062:   const observed = new Set([...registrationGroups.keys(), ...assertionGroups.keys()]);\\n1063:   const unexpected = [...observed].filter((id) => !expected.includes(id)).sort();\\n1064:   return { rows, unexpected };\\n1065: }\\n1066: \\n1067: function runtimeRegistrations(dir: string): RuntimeRegistration[] {\\n1068:   const registrations: RuntimeRegistration[] = [];\\n1069:   for (const file of readdirSync(dir, { withFileTypes: true })) {\\n1070:     if (!file.isFile() || !file.name.endsWith('.jsonl')) continue;\\n1071:     const lines = readFileSync(join(dir, file.name), 'utf8').split(/\\\\r?\\\\n/).filter(Boolean);\\n1072:     for (const line of lines) registrations.push(JSON.parse(line) as RuntimeRegistration);\\n1073:   }\\n1074:   return registrations;\\n1075: }\\n1076: \\n1077: export interface ProcessOutcome {\\n1078:   error?: unknown;\\n1079:   status: number | null;\\n1080:   signal?: NodeJS.Signals | null;\\n1081: }\\n1082: \\n1083: /**\\n1084:  * The verdict is NOT \\\"did every row go green\\\". A vitest process can report twelve green\\n1085:  * assertions and still exit non-zero â€” a global teardown that threw, an unhandled rejection, a\\n1086:  * worker that died after its last test. Treating that as success is exactly the false green this\\n1087:  * harness exists to prevent, so the process's own exit is part of the verdict, and a discrepancy\\n1088:  * between green rows and a non-zero exit is called out rather than smoothed over.\\n1089:  */\\n1090: export function runVerdict(rows: IdRow[], unexpected: string[], run: ProcessOutcome): string[] {\\n1091:   const problems: string[] = [];\\n1092:   const red = rows.filter((r) => r.status === 'red').length;\\n1093:   const missing = rows.filter((r) => r.status === 'missing').length;\\n1094: \\n1095:   if (red) problems.push(`${red} id${red === 1 ? '' : 's'} red`);\\n1096:   if (missing) problems.push(`${missing} id${missing === 1 ? '' : 's'} missing`);\\n1097:   if (unexpected.length) {\\n1098:     problems.push(`${unexpected.length} registered id${unexpected.length === 1 ? '' : 's'} not P0 of this requirement`);\\n1099:   }\\n1100: \\n1101:   if (run.error) {\\n1102:     const err = run.error as NodeJS.ErrnoException;\\n1103:     problems.push(`the test process could not be launched (${err.code ?? 'spawn error'}): ${diagnostic(err.message)}`);\\n1104:   } else if (run.status !== 0) {\\n1105:     const how = run.status === null ? `was killed by signal ${run.signal}` : `exited ${run.status}`;\\n1106:     problems.push(\\n1107:       red || missing\\n1108:         ? `the test process ${how}`\\n1109:         : `the test process ${how} even though every id reported green â€” something failed outside the ` +\\n1110:             `assertions (a teardown, an unhandled rejection, a worker that died). This run is a FAILURE.`,\\n1111:     );\\n1112:   }\\n1113: \\n1114:   return problems;\\n1115: }\\n1116: \\n1117: /**\\n1118:  * End-of-run housekeeping. The lock release lives in a `finally` of its OWN so that it cannot be\\n1119:  * skipped: on Windows, removing the report directory can throw EPERM while a file in it is still\\n1120:  * open, and if that throw escaped, the stack lock would be stranded and every later run would\\n1121:  * find a leftover it has to reason about. A lost temp directory is untidy; a stranded lock blocks\\n1122:  * work, so the release always wins and the cleanup failure is reported instead of hidden.\\n1123:  */\\n1124: export function cleanupRun(reportDir: string, lock: { release(): void } | null): void {\\n1125:   try {\\n1126:     rmSync(reportDir, { recursive: true, force: true });\\n1127:   } catch (err) {\\n1128:     console.error(`at:verify â€” could not remove the report directory ${reportDir}: ${diagnostic((err as Error).message)}`);\\n1129:   } finally {\\n1130:     lock?.release();\\n1131:   }\\n1132: }\\n1133: \\n1134: function firstLine(text: string | undefined, fallback: string): string {\\n1135:   const line = redact(text ?? '')\\n1136:     .split('\\\\n')\\n1137:     .map((l) => l.trim())\\n1138:     .find((l) => l.length > 0);\\n1139:   return line ?? fallback;\\n1140: }\\n1141: \\n1142: /* --------------------------------------------------------------------------------------- main */\\n1143: \\n1144: async function main(argv: string[]): Promise<number> {\\n1145:   let args: Args;\\n1146:   try {\\n1147:     args = parseArgs(argv);\\n1148:   } catch (err) {\\n1149:     console.error(`at:verify â€” ${(err as Error).message}`);\\n1150:     console.error(USAGE);\\n1151:     return 2;\\n1152:   }\\n1153: \\n1154:   const { requirement, tier, wired, expectDeclared } = args;\\n1155: \\n1156:   if (wired) {\\n1157:     console.error(\\n1158:       `at:verify req-${requirement} --wired â€” the screen driver does not exist yet. Wired re-runs ` +\\n1159:         `drive the ui-marked ids through real screens; that driver is a later AI4DEV-3 slice, so ` +\\n1160:         `there is nothing to re-run against and a silent fixture run would be a false green.`,\\n1161:     );\\n1162:     return 3;\\n1163:   }\\n1164: \\n1165:   const dir = suiteDir(requirement);\\n1166:   if (!existsSync(dir)) {\\n1167:     console.error(`at:verify req-${requirement} â€” no suite at ${dir}`);\\n1168:     return 2;\\n1169:   }\\n1170: \\n1171:   let expected: string[];\\n1172:   try {\\n1173:     const preflight = inspectBijection(requirement);\\n1174:     expected = preflight.expected;\\n1175:     if (preflight.problems.length) {\\n1176:       console.error(`at:verify req-${requirement} â€” ATâ†”code preflight refused the run: ${preflight.problems.join('; ')}`);\\n1177:       return 2;\\n1178:     }\\n1179:   } catch (err) {\\n1180:     console.error(`at:verify req-${requirement} â€” ${(err as Error).message}`);\\n1181:     return 2;\\n1182:   }\\n1183: \\n1184:   // The declaration preflight sits HERE for two reasons, both load-bearing. It needs the\\n1185:   // acceptance file's P0 id set, which only exists after the bijection preflight above; and every\\n1186:   // refusal must run NO tests, so it must precede the vitest spawn. Placing it before the stack\\n1187:   // sequence as well means a bad declaration never takes the machine-wide lock, never talks to\\n1188:   // Docker and never resets a database â€” the refusal costs nothing at any tier.\\n1189:   let expectation: TierExpectation | null = null;\\n1190:   if (expectDeclared) {\\n1191:     try {\\n1192:       expectation = loadTierExpectation(requirement, tier, expected);\\n1193:     } catch (err) {\\n1194:       console.error(`at:verify req-${requirement} --tier ${tier} --expect â€” DECLARATION REFUSED: ${(err as Error).message}`);\\n\\n(Output capped at 50 KB. Showing lines 1-1194. Use offset=1195 to continue.)\\n</content>\",\"metadata\":{\"preview\":\"/**\\n * The AT runner â€” `bun run at:verify req-0NN --tier <loop|integration|drill>`.\\n *\\n * The command shape is fixed: all 30 decomposition manifests cite it verbatim in their done\\n * contracts, and the skills (`/dev-start`'s inner loop, `/dev-end`, `/pm-done`'s gate) call it.\\n * It resolves the requirement's suite, runs it under vitest with the tier passed through\\n * `AT_TIER`, and reports PER AT ID â€” green / red / missing â€” because \\\"3 failed\\\" tells a gate\\n * nothing about which acceptance criterion is unmet.\\n *\\n * The `integration` tier needs a real database, and that database is a SLOT out of the local\\n * database pool (`db-pool.ts`) â€” never a shared hosted project, because every run wipes and\\n * rebuilds it, and never the stack described by this repository's own `supabase/config.toml`,\\n * because that one is the founder's personal stack and is untouchable. The sequence is\\n * deliberately paranoid:\\n *\\n *   1. occupy the slot the coordinator reserved for this item â€” a machine-wide claim keyed by the\\n *      slot's project id + api port, so two runs cannot reset under each other;\\n *   2. prepare the slot: mirror this tree's `supabase/` into it, overlay the slot's permanent\\n *      identity, PROVE the stack that answers is that slot â€” loopback host, the slot's own ports,\\n *      keys issued by the local development issuer â€” reset it, and prove the migration set\",\"truncated\":true,\"loaded\":[],\"display\":{\"type\":\"file\",\"path\":\"C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\runner.ts\",\"text\":\"/**\\n * The AT runner â€” `bun run at:verify req-0NN --tier <loop|integration|drill>`.\\n *\\n * The command shape is fixed: all 30 decomposition manifests cite it verbatim in their done\\n * contracts, and the skills (`/dev-start`'s inner loop, `/dev-end`, `/pm-done`'s gate) call it.\\n * It resolves the requirement's suite, runs it under vitest with the tier passed through\\n * `AT_TIER`, and reports PER AT ID â€” green / red / missing â€” because \\\"3 failed\\\" tells a gate\\n * nothing about which acceptance criterion is unmet.\\n *\\n * The `integration` tier needs a real database, and that database is a SLOT out of the local\\n * database pool (`db-pool.ts`) â€” never a shared hosted project, because every run wipes and\\n * rebuilds it, and never the stack described by this repository's own `supabase/config.toml`,\\n * because that one is the founder's personal stack and is untouchable. The sequence is\\n * deliberately paranoid:\\n *\\n *   1. occupy the slot the coordinator reserved for this item â€” a machine-wide claim keyed by the\\n *      slot's project id + api port, so two runs cannot reset under each other;\\n *   2. prepare the slot: mirror this tree's `supabase/` into it, overlay the slot's permanent\\n *      identity, PROVE the stack that answers is that slot â€” loopback host, the slot's own ports,\\n *      keys issued by the local development issuer â€” reset it, and prove the migration set\\n *      replayed. Every step of that lives in `db-pool.ts`;\\n *   3. print the evidence line naming the slot, so a green can always name the database it graded;\\n *   4. run the suite with an ALLOWLISTED environment â€” the child gets the platform minimum plus\\n *      the validated slot coordinates, and nothing else, so a secret sitting in a developer's\\n *      `.env.local` can never reach a test (and a test can never reach the hosted project).\\n *\\n * The `drill` tier resolves no database at all until an item decides which stack it should use.\\n *\\n * Any failure in that sequence is an INFRASTRUCTURE failure: non-zero exit, no tests run, a\\n * message naming what failed. The runner never falls back to the loop tier's stubs and never\\n * runs against a database whose state it could not establish â€” a gate grading a stand-in, or an\\n * unknown database, is worse than a gate that refuses to run. Secrets are never printed: raw CLI\\n * output is redacted, and validation reports which check failed, never the value that failed it.\\n */\\n\\nimport { spawn, spawnSync } from 'node:child_process';\\nimport { closeSync, existsSync, mkdirSync, mkdtempSync, openSync, readdirSync, readFileSync, rmSync, writeSync } from 'node:fs';\\nimport { hostname, tmpdir } from 'node:os';\\nimport { join } from 'node:path';\\n\\nimport { INSTALL_ROOT, inspectBijection, normalizeRequirement, REPO_ROOT, suiteDir } from './check.ts';\\n// The cycle with db-pool.ts is deliberate and safe: neither module calls the other at module\\n// scope, and both sides export hoisted function declarations.\\nimport { evidence, occupy, prepare, stackEnv as slotStackEnv, type Occupancy, type PrepareResult } from './db-pool.ts';\\nimport {\\n  expectationDeviations,\\n  expectedManifestPath,\\n  loadTierExpectation,\\n  reportAccountingDeviations,\\n  type TierExpectation,\\n} from './expected.ts';\\n\\nconst TIERS = ['loop', 'integration', 'drill'] as const;\\ntype Tier = (typeof TIERS)[number];\\n\\nconst USAGE = 'usage: bun run at:verify req-0NN --tier <loop|integration|drill> [--wired] [--expect]';\\n\\n/** How long the stack gets to become genuinely ready before the run is called off. */\\nconst READY_TIMEOUT_MS = Number(process.env.AT_READY_TIMEOUT_MS ?? 120_000);\\n/** How long `supabase db reset` gets before it is assumed wedged and its process tree killed. */\\nconst RESET_TIMEOUT_MS = Number(process.env.AT_RESET_TIMEOUT_MS ?? 600_000);\\n/** A lock older than this, or held by a process that is gone, is taken over. */\\nconst LOCK_STALE_MINUTES = Number(process.env.AT_LOCK_STALE_MINUTES ?? 60);\\n/** The takeover gate is held for milliseconds; anything this old was abandoned by a dead process. */\\nconst GATE_STALE_MINUTES = Number(process.env.AT_LOCK_GATE_STALE_MINUTES ?? 2);\\n\\n/** `supabase status` reports these two as stopped because config.toml disables them. Benign. */\\nconst DISABLED_SERVICES = /^supabase_(imgproxy|pooler)_/;\\n\\n/**\\n * The pinned CLI, invoked directly â€” no shell, no PATH lookup, no globally installed version.\\n * Resolved from the INSTALL root, never the (overridable) data root: the pinned versions live in\\n * the real checkout's `node_modules` wherever the acceptance files being read happen to be.\\n */\\nconst SUPABASE_ENTRY = join(INSTALL_ROOT, 'node_modules', 'supabase', 'dist', 'supabase.js');\\n\\ninterface Args {\\n  requirement: string;\\n  tier: Tier;\\n  wired: boolean;\\n  /** Named `expectDeclared`, not `expect`, so nobody later reads it as vitest's `expect`. */\\n  expectDeclared: boolean;\\n}\\n\\nfunction parseArgs(argv: string[]): Args {\\n  let requirement = '';\\n  let tier = '';\\n  let wired = false;\\n  let expectDeclared = false;\\n\\n  for (let i = 0; i < argv.length; i++) {\\n    const arg = argv[i];\\n    if (arg === '--wired') wired = true;\\n    else if (arg === '--expect') expectDeclared = true;\\n    else if (arg === '--tier') tier = argv[++i] ?? '';\\n    else if (arg.startsWith('--tier=')) tier = arg.slice('--tier='.length);\\n    else if (arg.startsWith('--')) throw new Error(`unknown option \\\"${arg}\\\"`);\\n    else if (!requirement) requirement = arg;\\n    else throw new Error(`unexpected argument \\\"${arg}\\\"`);\\n  }\\n\\n  if (!requirement) throw new Error('no requirement given');\\n  if (!tier) throw new Error('--tier is required â€” there is no default tier, by design');\\n  if (!TIERS.includes(tier as Tier)) throw new Error(`unknown tier \\\"${tier}\\\" â€” expected one of ${TIERS.join('|')}`);\\n  // Refused here rather than later: `--wired` runs no tests at all, so there would be no report\\n  // for a declaration to be checked against, and a declaration refusal must never be reported as\\n  // the wired refusal. A usage error exits 2, which is what a `--expect` command that cannot be\\n  // honoured is required to do.\\n  if (wired && expectDeclared) {\\n    throw new Error('--expect and --wired cannot be combined: --wired runs no tests, so there is no report for a declaration to be checked against');\\n  }\\n\\n  return { requirement: normalizeRequirement(requirement), tier: tier as Tier, wired, expectDeclared };\\n}\\n\\n/* --------------------------------------------------------------- the child environment (leak) */\\n\\n/**\\n * The ONLY variables a child process inherits. Everything else is dropped.\\n *\\n * WHY AN ALLOWLIST: bun auto-loads `.env` and `.env.local` into this process, and `.env.example`\\n * tells developers to put their real secrets in `.env.local`. Spreading `process.env` into the\\n * test process would hand every one of those to every test â€” and a test reading a conventional\\n * name like `SUPABASE_SERVICE_ROLE_KEY` would then be pointed at the HOSTED project, which the\\n * acceptance suites must never touch. The child gets the platform minimum plus exactly the\\n * values this runner validated. Children are additionally launched with bun's `--no-env-file`,\\n * so a child does not re-read the env files for itself.\\n */\\nconst ENV_ALLOWLIST = [\\n  // process/platform basics\\n  'PATH',\\n  'PATHEXT',\\n  'COMSPEC',\\n  'SystemRoot',\\n  'SystemDrive',\\n  'windir',\\n  'OS',\\n  'NUMBER_OF_PROCESSORS',\\n  'PROCESSOR_ARCHITECTURE',\\n  'PROCESSOR_IDENTIFIER',\\n  'USERNAME',\\n  'LANG',\\n  'LC_ALL',\\n  'TZ',\\n  // temp + home, which bun, vitest and the Supabase CLI all need in order to write caches\\n  'TEMP',\\n  'TMP',\\n  'TMPDIR',\\n  'HOME',\\n  'HOMEDRIVE',\\n  'HOMEPATH',\\n  'USERPROFILE',\\n  'APPDATA',\\n  'LOCALAPPDATA',\\n  'PROGRAMDATA',\\n  'PROGRAMFILES',\\n  'PROGRAMFILES(X86)',\\n  'PROGRAMW6432',\\n  'XDG_CACHE_HOME',\\n  'BUN_INSTALL',\\n  // how the Supabase CLI finds the container runtime (never a credential)\\n  'DOCKER_HOST',\\n  'DOCKER_CONTEXT',\\n  'DOCKER_CONFIG',\\n  'DOCKER_CERT_PATH',\\n];\\n\\n/** Windows environment names are case-insensitive, so match that way and keep the parent's casing. */\\nexport function childEnv(extra: Record<string, string> = {}): Record<string, string> {\\n  const wanted = new Set(ENV_ALLOWLIST.map((name) => name.toLowerCase()));\\n  const env: Record<string, string> = {};\\n  for (const [key, value] of Object.entries(process.env)) {\\n    if (value !== undefined && wanted.has(key.toLowerCase())) env[key] = value;\\n  }\\n  return { ...env, ...extra };\\n}\\n\\n/**\\n * The bun binary. Children are launched under bun deliberately â€” `--no-env-file` is a bun flag,\\n * and it is what stops a child from re-reading `.env`/`.env.local` for itself. Normally this\\n * process IS bun, so its own path is the answer; the PATH lookup only matters when something\\n * else (a test runner's node worker, say) is asking.\\n */\\nexport function bunExecutable(): string {\\n  if (/[\\\\\\\\/]bun(\\\\.exe)?$/i.test(process.execPath)) return process.execPath;\\n  const lookup = spawnSync(process.platform === 'win32' ? 'where' : 'which', ['bun'], {\\n    encoding: 'utf8',\\n    env: childEnv(),\\n  });\\n  const found = (lookup.stdout ?? '')\\n    .split('\\\\n')\\n    .map((line) => line.trim())\\n    .find(Boolean);\\n  if (!found) throw new Error('bun was not found on PATH â€” the harness runs its children under bun');\\n  return found;\\n}\\n\\n/* --------------------------------------------------------------------------------- redaction */\\n\\n/** Strip anything key-shaped out of text that is about to be printed. */\\nexport function redact(text: string): string {\\n  return String(text ?? '')\\n    .replace(/eyJ[A-Za-z0-9_-]{5,}\\\\.[A-Za-z0-9_-]{5,}\\\\.[A-Za-z0-9_-]{5,}/g, '<redacted-jwt>')\\n    .replace(/\\\\bsb_[a-z]+_[A-Za-z0-9_-]{8,}/g, '<redacted-key>')\\n    .replace(/(postgres(?:ql)?:\\\\/\\\\/)[^@\\\\s/]+@/gi, '$1<redacted>@')\\n    .replace(/[A-Za-z0-9_-]{40,}/g, '<redacted-token>');\\n}\\n\\n/** First non-empty line, redacted and length-capped â€” enough to diagnose, not enough to leak. */\\nexport function diagnostic(text: string | undefined, limit = 400): string {\\n  const line =\\n    redact(text ?? '')\\n      .split('\\\\n')\\n      .map((l) => l.trim())\\n      .find((l) => l.length > 0) ?? '';\\n  return line.length > limit ? `${line.slice(0, limit)}â€¦` : line;\\n}\\n\\n/* ------------------------------------------------------------------------ config.toml reading */\\n\\nexport interface LocalConfig {\\n  projectId: string;\\n  apiPort: number;\\n  dbPort: number;\\n}\\n\\n/**\\n * Ports and project id come from `supabase/config.toml` â€” never guessed, never hard-coded.\\n *\\n * The root is a parameter so the database-slot pool can read a SLOT's own config with this exact\\n * scanner instead of a second copy of it. Unset â€” every ordinary run â€” it reads the repo tree, so\\n * the loop and integration call sites behave as they did before the parameter existed.\\n */\\nexport function readLocalConfig(root: string = REPO_ROOT): LocalConfig {\\n  const file = join(root, 'supabase', 'config.toml');\\n  const text = readFileSync(file, 'utf8');\\n  let section = '';\\n  let projectId = '';\\n  let apiPort = 0;\\n  let dbPort = 0;\\n\\n  for (const raw of text.split('\\\\n')) {\\n    const line = raw.trim();\\n    const header = /^\\\\[([^\\\\]]+)\\\\]/.exec(line);\\n    if (header) {\\n      section = header[1];\\n      continue;\\n    }\\n    const port = /^port\\\\s*=\\\\s*(\\\\d+)/.exec(line);\\n    if (section === '' && /^project_id\\\\s*=/.test(line)) projectId = /\\\"([^\\\"]+)\\\"/.exec(line)?.[1] ?? '';\\n    else if (section === 'api' && port && !apiPort) apiPort = Number(port[1]);\\n    else if (section === 'db' && port && !dbPort) dbPort = Number(port[1]);\\n  }\\n\\n  const missing = [projectId ? '' : 'project_id', apiPort ? '' : '[api] port', dbPort ? '' : '[db] port'].filter(Boolean);\\n  if (missing.length) throw new Error(`${file} is missing ${missing.join(' and ')}`);\\n  return { projectId, apiPort, dbPort };\\n}\\n\\n/* ---------------------------------------------------------------------- the machine-wide lock */\\n\\nexport interface StackLock {\\n  file: string;\\n  release(): void;\\n}\\n\\n/**\\n * Where the machine-wide claim files live.\\n *\\n * `AT_LOCK_DIR` overrides it, the same pattern and the same reason as `AT_REPO_ROOT`: a test that\\n * exercises the claim protocol must not write into the directory a real run reads, or a selftest\\n * and a live `at:verify` could take each other's lock. Unset â€” every ordinary run â€” the answer is\\n * unchanged.\\n */\\nfunction lockDir(): string {\\n  const override = process.env.AT_LOCK_DIR?.trim();\\n  const dir = override ? override : join(process.env.LOCALAPPDATA ?? process.env.XDG_CACHE_HOME ?? tmpdir(), 'ai4good-build', 'at-locks');\\n  mkdirSync(dir, { recursive: true });\\n  return dir;\\n}\\n\\nfunction processIsAlive(pid: number): boolean {\\n  try {\\n    process.kill(pid, 0);\\n    return true;\\n  } catch (err) {\\n    // EPERM means it exists but belongs to someone else; ESRCH means it is gone.\\n    return (err as NodeJS.ErrnoException).code === 'EPERM';\\n  }\\n}\\n\\n/** The lock path for one stack. Machine-wide, and deliberately carries no folder component. */\\nexport function stackLockPath(config: LocalConfig): string {\\n  return join(lockDir(), `at-verify-${config.projectId}-${config.apiPort}.lock`);\\n}\\n\\nexport interface Holder {\\n  pid?: number;\\n  host?: string;\\n  requirement?: string;\\n  startedAt?: string;\\n  /** Set only on a claim that replaced a stale one, so the takeover is recorded IN the claim. */\\n  tookOverFrom?: { pid?: number; startedAt?: string; requirement?: string };\\n}\\n\\n/**\\n * Which holders a caller is allowed to displace.\\n *\\n * `stale-or-dead` is the runner's own long-standing rule: a dead process, or a live one whose\\n * claim is older than `LOCK_STALE_MINUTES`. `dead-pid-only` never displaces a running process at\\n * any age â€” the database-slot pool passes it, because a slot's occupancy is ruled to break on a\\n * dead holder pid and on nothing else. A run that legitimately lasts longer than the stale window\\n * must not have its database reset under it.\\n */\\nexport type TakeoverPolicy = 'stale-or-dead' | 'dead-pid-only';\\n\\nexport interface StackLockOptions {\\n  takeover?: TakeoverPolicy;\\n}\\n\\n/** Live = a holder this policy may not displace. */\\nfunction holderIsLive(holder: Holder, policy: TakeoverPolicy = 'stale-or-dead'): boolean {\\n  if (typeof holder.pid !== 'number' || !processIsAlive(holder.pid)) return false;\\n  if (policy === 'dead-pid-only') return true;\\n  const startedAt = holder.startedAt ? Date.parse(holder.startedAt) : NaN;\\n  const ageMinutes = Number.isFinite(startedAt) ? (Date.now() - startedAt) / 60_000 : Infinity;\\n  return ageMinutes < LOCK_STALE_MINUTES;\\n}\\n\\nfunction heldByAnotherRun(holder: Holder, file: string): Error {\\n  return new Error(\\n    `another at:verify run holds this stack (pid ${holder.pid} on ${holder.host ?? 'this machine'}, ` +\\n      `requirement ${holder.requirement ?? 'unknown'}, started ${holder.startedAt ?? 'unknown'}). ` +\\n      `Two runs against one stack destroy each other: the second would reset the first's database ` +\\n      `mid-run. Wait for it to finish. If that process is definitely gone, delete ${file}.`,\\n  );\\n}\\n\\n/**\\n * A gate left behind by a process that died mid-takeover. The section lasts milliseconds, so\\n * anything this old is certainly abandoned; removing one wrongly costs at most two processes in\\n * the section, which is the behaviour we had before the gate existed.\\n */\\nfunction clearStrandedGate(gate: string): void {\\n  try {\\n    const held = JSON.parse(readFileSync(gate, 'utf8')) as { pid?: number; at?: string };\\n    const at = held.at ? Date.parse(held.at) : NaN;\\n    const ageMinutes = Number.isFinite(at) ? (Date.now() - at) / 60_000 : Infinity;\\n    const alive = typeof held.pid === 'number' && processIsAlive(held.pid);\\n    if (!alive || ageMinutes > GATE_STALE_MINUTES) rmSync(gate, { force: true });\\n  } catch {\\n    // unreadable or already gone â€” the next pass finds out\\n  }\\n}\\n\\n/**\\n * Serialize every destructive run against one stack. The key is project id + api port because\\n * that pair IS the stack's identity: a second checkout carrying the same `project_id` shares the\\n * same Docker containers and the same ports, so its `at:verify` would reset this run's database\\n * out from under it. Mirrors `Acquire-WorkLock` in loop/work/work-lib.ps1 â€” exclusive create,\\n * holder recorded, stale takeover.\\n *\\n * TAKEOVER IS THE WHOLE DIFFICULTY. Two processes can both read the same leftover lock and both\\n * conclude it is stale; if each then removed it and created its own, the second removal would take\\n * out the FIRST one's brand-new live lock and both would run â€” the precise failure this exists to\\n * prevent. Moving the stale file aside with an atomic rename does NOT fix that: the winner\\n * repopulates the path microseconds later, so the loser's rename succeeds against a LIVE lock,\\n * which is just as destructive as unlinking it. (Proved with a two-contender race, not reasoned\\n * about; the race is in runner.selftest.ts.)\\n *\\n * So the takeover DECISION is serialized by a second exclusive-create lock â€” the gate. Only one\\n * process is ever inside it, and it re-reads the holder INSIDE, so:\\n *   - no other process can be taking over concurrently (the gate is exclusive);\\n *   - no ordinary claim can have slipped in, because the stale file occupies the path continuously\\n *     until the gate holder removes it, and an exclusive create only succeeds on a free path;\\n *   - if a third process wins the claim in the instant after removal, the gate holder's own create\\n *     simply fails and it restarts, having deleted nothing further.\\n * A gate stranded by a killed process is cleared on age. The section lasts milliseconds, so a live\\n * holder never reaches that threshold, and clearing one wrongly degrades to two takers in the\\n * section â€” today's behaviour, not worse.\\n */\\nexport function acquireStackLock(config: LocalConfig, requirement: string, options: StackLockOptions = {}): StackLock {\\n  const file = stackLockPath(config);\\n  const policy: TakeoverPolicy = options.takeover ?? 'stale-or-dead';\\n\\n  const claim = (displaced?: Holder): StackLock | null => {\\n    let fd: number;\\n    try {\\n      fd = openSync(file, 'wx');\\n    } catch (err) {\\n      if ((err as NodeJS.ErrnoException).code === 'EEXIST') return null;\\n      throw err;\\n    }\\n    try {\\n      writeSync(\\n        fd,\\n        JSON.stringify({\\n          pid: process.pid,\\n          host: hostname(),\\n          requirement,\\n          startedAt: new Date().toISOString(),\\n          // A takeover recorded ONLY on the console is lost the moment the terminal scrolls. The\\n          // claim file outlives the run that wrote it, so whoever reads it later can see that this\\n          // occupancy began by displacing an abandoned one, and whose.\\n          ...(displaced\\n            ? {\\n                tookOverFrom: {\\n                  pid: displaced.pid,\\n                  startedAt: displaced.startedAt,\\n                  requirement: displaced.requirement,\\n                },\\n              }\\n            : {}),\\n        }),\\n      );\\n    } finally {\\n      closeSync(fd);\\n    }\\n    return {\\n      file,\\n      release: () => {\\n        try {\\n          const held = JSON.parse(readFileSync(file, 'utf8')) as { pid?: number };\\n          if (held.pid === process.pid) rmSync(file, { force: true });\\n        } catch {\\n          // already removed, or unreadable â€” nothing of ours left to release\\n        }\\n      },\\n    };\\n  };\\n\\n  const gate = `${file}.takeover`;\\n\\n  /** The recorded holder, or null if the lock is gone. */\\n  const readHolder = (): Holder | null => {\\n    try {\\n      return JSON.parse(readFileSync(file, 'utf8')) as Holder;\\n    } catch (err) {\\n      if ((err as NodeJS.ErrnoException).code === 'ENOENT') return null;\\n      return {}; // unreadable or half-written: treat as an unidentifiable holder, judged below\\n    }\\n  };\\n\\n  /** Bounded synchronous pause; a gate is held for milliseconds, so this is all the wait needed. */\\n  const pause = (ms: number) => {\\n    const until = Date.now() + ms;\\n    while (Date.now() < until) {\\n      /* spin */\\n    }\\n  };\\n\\n  /**\\n   * UNDER `dead-pid-only`, AN UNIDENTIFIABLE HOLDER IS NEVER TAKEOVER-ELIGIBLE.\\n   *\\n   * `readHolder` returns `{}` for a file it cannot read or parse, and `holderIsLive({})` is false\\n   * under every policy â€” so without this guard a claim file that is empty or half written looks\\n   * exactly like a dead holder and is deleted. The window is real and small: it is the microseconds\\n   * between `openSync(file, 'wx')` and the `writeSync` that fills the file, so a second occupier\\n   * arriving in that instant would remove a LIVE process's brand-new claim. That is the one thing\\n   * this policy exists to make impossible.\\n   *\\n   * One bounded re-read skates over the write window. A holder that STILL has no parseable pid is\\n   * not a dead holder â€” it is a file nobody in this process can account for â€” so it refuses loudly\\n   * and names the manual repair. `stale-or-dead` keeps its long-standing behaviour: that path\\n   * predates the slot pool and is another item's business.\\n   *\\n   * Returns the identified holder, or null when the file went away and the loop should retry.\\n   */\\n  const identified = (holder: Holder, where: string): Holder | null => {\\n    if (typeof holder.pid === 'number') return holder;\\n    if (policy !== 'dead-pid-only') return holder;\\n\\n    pause(50);\\n    const again = readHolder();\\n    if (again === null) return null; // released while we looked; the loop takes the free path\\n    if (typeof again.pid === 'number') return again;\\n\\n    throw new Error(\\n      `refusing to take over the claim at ${file}: it names no process id that this run can read, ` +\\n        `so it cannot be shown to be dead â€” and a claim file being written right now looks exactly ` +\\n        `like this. Nothing was taken over. If no run holds that stack, delete ${file} by hand ` +\\n        `(checked ${where}).`,\\n    );\\n  };\\n\\n  // Bounded: every retry follows another process winning the gate, which cannot repeat forever.\\n  for (let attempt = 0; attempt < 20; attempt++) {\\n    const claimed = claim();\\n    if (claimed) return claimed;\\n\\n    const read = readHolder();\\n    if (read === null) continue; // released between the failed claim and the read\\n    const holder = identified(read, 'before the takeover gate');\\n    if (holder === null) continue;\\n    if (holderIsLive(holder, policy)) throw heldByAnotherRun(holder, file);\\n\\n    // Stale. Enter the takeover gate â€” the only place the live lock path may be removed.\\n    let gateFd: number;\\n    try {\\n      gateFd = openSync(gate, 'wx');\\n    } catch (err) {\\n      if ((err as NodeJS.ErrnoException).code !== 'EEXIST') throw err;\\n      clearStrandedGate(gate);\\n      pause(10);\\n      continue;\\n    }\\n\\n    try {\\n      writeSync(gateFd, JSON.stringify({ pid: process.pid, at: new Date().toISOString() }));\\n      const readInside = readHolder();\\n      if (readInside === null) continue; // released while we were entering; the next claim takes it\\n      // The same guard as above: the gate must not be able to remove an unidentifiable file either.\\n      const inside = identified(readInside, 'inside the takeover gate');\\n      if (inside === null) continue;\\n      if (holderIsLive(inside, policy)) continue; // refreshed under us; the next pass refuses it properly\\n\\n      rmSync(file, { force: true });\\n      const takeover = claim(inside);\\n      if (!takeover) continue; // a third process claimed the free path first â€” delete nothing more\\n\\n      console.log(\\n        `at:verify â€” took over a stale stack lock (holder pid ${inside.pid ?? 'unknown'} ` +\\n          `${typeof inside.pid === 'number' && processIsAlive(inside.pid) ? `is older than ${LOCK_STALE_MINUTES} minutes` : 'is no longer running'})`,\\n      );\\n      return takeover;\\n    } finally {\\n      closeSync(gateFd);\\n      rmSync(gate, { force: true });\\n    }\\n  }\\n\\n  throw new Error(`could not acquire the stack lock at ${file} â€” it kept changing hands; try again`);\\n}\\n\\n/* -------------------------------------------------------------------- the stack's own report */\\n\\nexport interface StackStatus {\\n  apiUrl: string;\\n  dbUrl: string;\\n  anonKey: string;\\n  serviceRoleKey: string;\\n}\\n\\nconst REQUIRED_STATUS_FIELDS: Record<keyof StackStatus, string> = {\\n  apiUrl: 'API_URL',\\n  dbUrl: 'DB_URL',\\n  anonKey: 'ANON_KEY',\\n  serviceRoleKey: 'SERVICE_ROLE_KEY',\\n};\\n\\nexport function supabaseArgs(...args: string[]): string[] {\\n  if (!existsSync(SUPABASE_ENTRY)) throw new Error(`the Supabase CLI is not installed at ${SUPABASE_ENTRY} â€” run \\\\`bun install\\\\``);\\n  return ['--no-env-file', SUPABASE_ENTRY, ...args];\\n}\\n\\n/**\\n * WHICH PROJECT an invocation acts on. A target names both halves of an identity, because either\\n * half alone is a hybrid.\\n */\\nexport interface CliTarget {\\n  /** The directory that CONTAINS the `supabase/` project folder â€” what `--workdir` names. */\\n  workdir: string;\\n  /** The project id the invocation must resolve, stated POSITIVELY in `SUPABASE_PROJECT_ID`. */\\n  projectId: string;\\n}\\n\\nexport interface CliInvocation {\\n  args: string[];\\n  cwd: string;\\n  env: Record<string, string>;\\n}\\n\\n/**\\n * THE ONE SEAM every Supabase CLI invocation is built at. Nothing in this repository assembles a\\n * CLI command line, working directory or environment anywhere else, and that single seam is the\\n * whole wall â€” a wall with two builders is a wall with a gap.\\n *\\n * THREE THINGS HAVE TO AGREE, and the reason each is here was measured, not reasoned about:\\n *\\n *   1. `SUPABASE_PROJECT_ID`, set POSITIVELY to the target's project id. The CLI treats that\\n *      variable as an OVERRIDE of `project_id` in `config.toml`. The repo's tracked `.env` carries\\n *      it, bun loads `.env` into this process, and on 2026-08-09 a `db reset` aimed at slot 2\\n *      destroyed the founder's personal database because the environment supplied the identity\\n *      while the slot's config supplied the ports. The wall is stating the identity, never merely\\n *      avoiding an override: an absence can be reintroduced by any parent process, a positive\\n *      value cannot.\\n *   2. NO OTHER `SUPABASE_*` variable. `childEnv` is an allowlist that carries none, and this\\n *      function asserts that rather than trusting it, because the allowlist is edited by people.\\n *   3. The WORKING DIRECTORY, equal to `--workdir`. Measured 2026-08-10: when the CLI's working\\n *      directory is itself a Supabase project, `--workdir <other>` produces a hybrid â€” the other\\n *      project's ports beside the working directory's project's containers. Run from a directory\\n *      that is not a project, the same command correctly says\\n *      `No such container: supabase_db_ai4good-slot-1`.\\n *\\n * `bun --no-env-file` (in `supabaseArgs`) closes the fourth route: a child that re-reads `.env`\\n * for itself.\\n *\\n * No target means the repository's own project, exactly as every call site behaved before targets\\n * existed: no `--workdir`, the repo root, and an environment carrying no `SUPABASE_*` at all.\\n */\\nexport function supabaseInvocation(target: CliTarget | undefined, args: string[]): CliInvocation {\\n  if (!target) return { args: supabaseArgs(...args), cwd: REPO_ROOT, env: childEnv() };\\n\\n  const env = childEnv({ SUPABASE_PROJECT_ID: target.projectId });\\n  const foreign = Object.keys(env).filter((name) => /^SUPABASE_/i.test(name) && name.toUpperCase() !== 'SUPABASE_PROJECT_ID');\\n  if (foreign.length) {\\n    throw new Error(\\n      `refusing to run the Supabase CLI against ${target.projectId}: the child environment would also carry ` +\\n        `${foreign.join(', ')}, and a second SUPABASE_* variable can override the identity this invocation states.`,\\n    );\\n  }\\n  if (env.SUPABASE_PROJECT_ID !== target.projectId) {\\n    throw new Error(`refusing to run the Supabase CLI: SUPABASE_PROJECT_ID would not be \\\"${target.projectId}\\\"`);\\n  }\\n  return { args: supabaseArgs('--workdir', target.workdir, ...args), cwd: target.workdir, env };\\n}\\n\\nexport interface CliResult {\\n  status: number | null;\\n  signal?: NodeJS.Signals | null;\\n  stdout: string;\\n  stderr: string;\\n  error?: Error;\\n}\\n\\n/** Run the pinned CLI through the seam and hand back the RAW result. The caller decides what to\\n * read and what may be printed â€” raw output carries every key the stack issues. */\\nexport function runSupabaseCli(target: CliTarget | undefined, args: string[]): CliResult {\\n  const invocation = supabaseInvocation(target, args);\\n  const res = spawnSync(bunExecutable(), invocation.args, { cwd: invocation.cwd, env: invocation.env, encoding: 'utf8' });\\n  return {\\n    status: res.status,\\n    signal: res.signal,\\n    stdout: res.stdout ?? '',\\n    stderr: res.stderr ?? '',\\n    error: res.error as Error | undefined,\\n  };\\n}\\n\\n/**\\n * Ask the running stack to describe itself. The raw output is NEVER printed: it contains every\\n * key the stack issues. Only field names travel into error messages.\\n */\\nexport function readStackStatus(target?: CliTarget): StackStatus {\\n  return parseStackStatus(runSupabaseCli(target, ['status', '-o', 'json']));\\n}\\n\\n/**\\n * The status parser, separate from the invocation so that a caller which needs the RAW output for\\n * its own checks (the slot pool's identity read) reads it once and parses the same result, rather\\n * than running the CLI twice or keeping a second copy of this parser.\\n */\\nexport function parseStackStatus(res: CliResult): StackStatus {\\n  if (res.error) {\\n    const err = res.error as NodeJS.ErrnoException;\\n    throw new Error(`could not launch the Supabase CLI (${err.code ?? 'spawn error'}): ${diagnostic(err.message)}`);\\n  }\\n\\n  const stdout = res.stdout ?? '';\\n  const open = stdout.indexOf('{');\\n  const close = stdout.lastIndexOf('}');\\n  if (open < 0 || close <= open) {\\n    throw new Error(\\n      `\\\\`supabase status\\\\` reported no JSON (exit ${res.status}${res.signal ? `, signal ${res.signal}` : ''}): ` +\\n        `${diagnostic(res.stderr) || '(no error output)'}`,\\n    );\\n  }\\n\\n  // The CLI exits non-zero merely because config.toml disables imgproxy and the pooler. That is\\n  // not a failure; anything ELSE reported stopped is.\\n  const notice = `${stdout.slice(0, open)}\\\\n${res.stderr ?? ''}`;\\n  const stopped = /Stopped services:\\\\s*\\\\[([^\\\\]]*)\\\\]/.exec(notice)?.[1] ?? '';\\n  const unexpectedStopped = stopped.split(/\\\\s+/).filter((name) => name && !DISABLED_SERVICES.test(name));\\n  if (unexpectedStopped.length) {\\n    throw new Error(`the stack reports stopped services: ${unexpectedStopped.join(', ')} â€” start them before running the suite`);\\n  }\\n\\n  let parsed: Record<string, unknown>;\\n  try {\\n    parsed = JSON.parse(stdout.slice(open, close + 1)) as Record<string, unknown>;\\n  } catch (err) {\\n    throw new Error(`\\\\`supabase status\\\\` produced unparseable JSON: ${(err as Error).message}`);\\n  }\\n\\n  const status: Partial<StackStatus> = {};\\n  const missing: string[] = [];\\n  for (const [field, key] of Object.entries(REQUIRED_STATUS_FIELDS) as [keyof StackStatus, string][]) {\\n    const value = parsed[key];\\n    if (typeof value !== 'string' || value.trim() === '') missing.push(key);\\n    else status[field] = value;\\n  }\\n  if (missing.length) throw new Error(`\\\\`supabase status\\\\` reported no ${missing.join(', no ')}`);\\n  return status as StackStatus;\\n}\\n\\n/* --------------------------------------------------------- proving the stack is the LOCAL one */\\n\\nconst LOOPBACK = new Set(['127.0.0.1', 'localhost', '::1', '[::1]']);\\n\\nfunction decodeJwtClaims(token: string): Record<string, unknown> | null {\\n  const parts = token.split('.');\\n  if (parts.length !== 3) return null;\\n  try {\\n    return JSON.parse(Buffer.from(parts[1], 'base64url').toString('utf8')) as Record<string, unknown>;\\n  } catch {\\n    return null;\\n  }\\n}\\n\\n/**\\n * Refuse to touch anything that is not demonstrably the local development stack. Returns the\\n * names of the checks that failed â€” never the values, which are keys and connection strings.\\n */\\nexport function localStackProblems(status: StackStatus, config: LocalConfig): string[] {\\n  const problems: string[] = [];\\n\\n  const checkUrl = (label: string, raw: string, expectedPort: number) => {\\n    let url: URL;\\n    try {\\n      url = new URL(raw);\\n    } catch {\\n      problems.push(`${label} is not a URL`);\\n      return;\\n    }\\n    if (!LOOPBACK.has(url.hostname)) problems.push(`${label} does not point at the loopback address`);\\n    if (url.port !== String(expectedPort)) problems.push(`${label} port is not the ${expectedPort} configured in supabase/config.toml`);\\n  };\\n\\n  checkUrl('API_URL', status.apiUrl, config.apiPort);\\n  checkUrl('DB_URL', status.dbUrl, config.dbPort);\\n\\n  const checkKey = (label: string, token: string, expectedRole: string) => {\\n    const claims = decodeJwtClaims(token);\\n    if (!claims) {\\n      problems.push(`${label} is not a decodable local development JWT`);\\n      return;\\n    }\\n    if (claims.iss !== 'supabase-demo') problems.push(`${label} was not issued by the local development issuer`);\\n    if (claims.role !== expectedRole) problems.push(`${label} does not carry the ${expectedRole} role`);\\n    if (typeof claims.ref === 'string') problems.push(`${label} carries a hosted project reference`);\\n  };\\n\\n  checkKey('ANON_KEY', status.anonKey, 'anon');\\n  checkKey('SERVICE_ROLE_KEY', status.serviceRoleKey, 'service_role');\\n\\n  return problems;\\n}\\n\\n/* --------------------------------------------------------------------------------- readiness */\\n\\ninterface BunSqlClient {\\n  (strings: TemplateStringsArray, ...values: unknown[]): Promise<unknown>;\\n  close(): Promise<void>;\\n}\\ntype BunSqlCtor = new (url: string) => BunSqlClient;\\n\\n/** Postgres itself answers a query â€” not \\\"the port is open\\\", which a half-started stack satisfies. */\\nasync function databaseAnswers(dbUrl: string): Promise<string | null> {\\n  const SQL = (globalThis as { Bun?: { SQL?: BunSqlCtor } }).Bun?.SQL;\\n  if (!SQL) return 'this runtime has no SQL client (expected bun)';\\n  let sql: BunSqlClient | null = null;\\n  try {\\n    sql = new SQL(dbUrl);\\n    await sql`select 1`;\\n    return null;\\n  } catch (err) {\\n    return diagnostic((err as Error).message);\\n  } finally {\\n    await sql?.close().catch(() => undefined);\\n  }\\n}\\n\\n/** One request that only succeeds if Kong routed it, PostgREST served it, and Postgres answered. */\\nasync function gatewayAnswers(status: StackStatus): Promise<string | null> {\\n  try {\\n    const res = await fetch(`${status.apiUrl.replace(/\\\\/$/, '')}/rest/v1/`, {\\n      headers: { apikey: status.anonKey, Authorization: `Bearer ${status.anonKey}` },\\n      signal: AbortSignal.timeout(5000),\\n    });\\n    if (!res.ok) return `the API gateway answered ${res.status}`;\\n    const type = res.headers.get('content-type') ?? '';\\n    if (!type.includes('json')) return `the API gateway answered 200 but served ${type || 'no content type'}`;\\n    return null;\\n  } catch (err) {\\n    return diagnostic((err as Error).message);\\n  }\\n}\\n\\n/**\\n * Wait until the stack is genuinely usable, or give up. \\\"Something answered on the port\\\" is not\\n * readiness: a half-started stack answers 502/503, and a run launched against it fails in ways\\n * that look like test failures instead of infrastructure failures.\\n */\\nexport async function waitForReady(status: StackStatus, phase: string): Promise<void> {\\n  const deadline = Date.now() + READY_TIMEOUT_MS;\\n  let lastProblem = 'not attempted';\\n  let delay = 250;\\n\\n  while (Date.now() < deadline) {\\n    const db = await databaseAnswers(status.dbUrl);\\n    if (db === null) {\\n      const gateway = await gatewayAnswers(status);\\n      if (gateway === null) return;\\n      lastProblem = gateway;\\n    } else {\\n      lastProblem = `the database did not answer: ${db}`;\\n    }\\n    await new Promise((resolve) => setTimeout(resolve, delay));\\n    delay = Math.min(delay * 2, 2000);\\n  }\\n\\n  throw new Error(`the stack was still not ready ${phase} after ${Math.round(READY_TIMEOUT_MS / 1000)}s â€” last problem: ${lastProblem}`);\\n}\\n\\n/* --------------------------------------------------------------------- the migration-set proof */\\n\\n/** Counted, not just proved â€” the pool's evidence line has to state the migration state it saw. */\\nexport interface MigrationProof {\\n  expected: number;\\n  applied: number;\\n}\\n\\n/**\\n * The migrations the reset is supposed to replay, read from disk. The CLI names them\\n * `<timestamp>_name.sql` and records the timestamp as the applied version, so the timestamp is\\n * the identity. `.gitkeep` and `README.md` are not migrations and are ignored.\\n */\\nexport function expectedMigrations(root: string = REPO_ROOT): string[] {\\n  const dir = join(root, 'supabase', 'migrations');\\n  if (!existsSync(dir)) return [];\\n  return readdirSync(dir)\\n    .map((name) => /^(\\\\d{14})_.*\\\\.sql$/.exec(name)?.[1])\\n    .filter((version): version is string => Boolean(version))\\n    .sort();\\n}\\n\\n/** What the database says it actually replayed. */\\nasync function appliedMigrations(dbUrl: string): Promise<string[]> {\\n  const SQL = (globalThis as { Bun?: { SQL?: BunSqlCtor } }).Bun?.SQL;\\n  if (!SQL) throw new Error('this runtime has no SQL client (expected bun)');\\n  let sql: BunSqlClient | null = null;\\n  try {\\n    sql = new SQL(dbUrl);\\n    const rows = (await sql`select version from supabase_migrations.schema_migrations order by version`) as {\\n      version: string;\\n    }[];\\n    return rows.map((row) => String(row.version)).sort();\\n  } catch (err) {\\n    // A database that has never had a migration applied has no history table at all. \\\"No table\\\"\\n    // and \\\"empty table\\\" mean the same thing â€” nothing was applied â€” and saying so lets the\\n    // comparison below name exactly which migrations are missing instead of reporting a SQL error.\\n    const message = (err as Error).message ?? '';\\n    if (/schema_migrations/.test(message) && /does not exist/i.test(message)) return [];\\n    throw new Error(`could not read the migration history: ${diagnostic(message)}`);\\n  } finally {\\n    await sql?.close().catch(() => undefined);\\n  }\\n}\\n\\n/** Exact set equality, both directions, named plainly. */\\nexport function migrationSetProblems(expected: string[], applied: string[]): string[] {\\n  const missing = expected.filter((version) => !applied.includes(version));\\n  const extra = applied.filter((version) => !expected.includes(version));\\n  const problems: string[] = [];\\n  if (missing.length) problems.push(`never applied: ${missing.join(', ')}`);\\n  if (extra.length) problems.push(`applied but not in supabase/migrations: ${extra.join(', ')}`);\\n  return problems;\\n}\\n\\n/**\\n * Prove the rebuild actually replayed the migration set â€” the promise `supabase/migrations/README.md`\\n * makes. \\\"The reset command exited zero\\\" is not that proof: a reset that replays NOTHING also exits\\n * zero, and a suite then grades an empty schema while believing it graded the real one.\\n *\\n * An empty expected set is legitimate today (no migrations have been written yet) and is allowed â€”\\n * but it is STATED on every run, so an empty rebuild can never be silently mistaken for a real one.\\n */\\nexport async function proveMigrationsReplayed(status: StackStatus, root: string = REPO_ROOT): Promise<MigrationProof> {\\n  const expected = expectedMigrations(root);\\n  const applied = await appliedMigrations(status.dbUrl);\\n  const problems = migrationSetProblems(expected, applied);\\n\\n  const summary = `${expected.length} migration${expected.length === 1 ? '' : 's'} expected, ${applied.length} applied`;\\n  if (problems.length) {\\n    throw new Error(`the rebuilt database does not match supabase/migrations (${summary}) â€” ${problems.join('; ')}`);\\n  }\\n  console.log(\\n    expected.length === 0\\n      ? `at:verify â€” ${summary} â€” the schema is empty by design at this stage`\\n      : `at:verify â€” ${summary} â€” the rebuilt schema matches supabase/migrations exactly`,\\n  );\\n  return { expected: expected.length, applied: applied.length };\\n}\\n\\n/* ------------------------------------------------------------------------------------- reset */\\n\\n/**\\n * Rebuild the local database from `supabase/migrations` â€” the same work `bun run db:reset` does,\\n * invoked at the pinned CLI so failures are catchable and bounded.\\n *\\n * WHY EVERY RUN: without it the second run works on the first run's leftover rows, and on a\\n * schema missing whatever migration landed since â€” a suite grading a database nobody established.\\n */\\nexport async function resetLocalDatabase(target?: CliTarget): Promise<void> {\\n  const invocation = supabaseInvocation(target, ['db', 'reset', '--local']);\\n  const child = spawn(bunExecutable(), invocation.args, {\\n    cwd: invocation.cwd,\\n    env: invocation.env,\\n    // progress is worth watching (a reset replays every migration); stderr is captured so a\\n    // failure can be reported in our own words rather than scrolling past.\\n    stdio: ['ignore', 'inherit', 'pipe'],\\n  });\\n\\n  let stderr = '';\\n  child.stderr?.on('data', (chunk: Buffer) => {\\n    stderr = (stderr + chunk.toString('utf8')).slice(-8000);\\n  });\\n\\n  let timedOut = false;\\n  const timer = setTimeout(() => {\\n    timedOut = true;\\n    // Kill the TREE: the CLI shells out to the container runtime, and killing only the parent\\n    // leaves a migration running against the database this run is about to test.\\n    if (child.pid && process.platform === 'win32') spawnSync('taskkill', ['/PID', String(child.pid), '/T', '/F'], { stdio: 'ignore' });\\n    else child.kill('SIGKILL');\\n  }, RESET_TIMEOUT_MS);\\n\\n  try {\\n    await new Promise<void>((resolve, reject) => {\\n      child.once('error', (err) => {\\n        const e = err as NodeJS.ErrnoException;\\n        reject(new Error(`the reset process could not be launched (${e.code ?? 'spawn error'}): ${diagnostic(e.message)}`));\\n      });\\n      child.once('close', (code, signal) => {\\n        if (timedOut) {\\n          reject(new Error(`the reset did not finish within ${Math.round(RESET_TIMEOUT_MS / 1000)}s and its process tree was killed`));\\n        } else if (code === 0) {\\n          resolve();\\n        } else {\\n          const how = code === null ? `was killed by signal ${signal}` : `exited ${code}`;\\n          reject(new Error(`\\\\`supabase db reset\\\\` ${how}: ${diagnostic(stderr) || '(no error output)'}`));\\n        }\\n      });\\n    });\\n  } finally {\\n    clearTimeout(timer);\\n  }\\n}\\n\\n/* --------------------------------------------------------------------------- vitest json shape */\\n\\nexport interface AssertionResult {\\n  title?: string;\\n  fullName?: string;\\n  status?: string;\\n  failureMessages?: string[];\\n}\\n\\n/**\\n * The report's own arithmetic, alongside the per-test results. `--expect` needs both: the id\\n * parser only sees tests whose titles carry an AT id, so an untagged `it()` that fails is\\n * invisible to it and visible in these counts. Optional because this describes a file on disk â€”\\n * a missing field is validated at runtime (see `reportAccountingDeviations`), not asserted here.\\n */\\ninterface VitestJson {\\n  /**\\n   * One entry per test FILE. `status` and `message` are kept alongside the assertions because a\\n   * file that fails to import, or whose hook throws, changes no test's status: that failure is\\n   * visible here and nowhere else in the report.\\n   */\\n  testResults?: { name?: string; status?: string; message?: string; assertionResults?: AssertionResult[] }[];\\n  numTotalTests?: number;\\n  numPassedTests?: number;\\n  numFailedTests?: number;\\n  numPendingTests?: number;\\n  numTodoTests?: number;\\n  success?: boolean;\\n}\\n\\nexport interface IdRow {\\n  id: string;\\n  status: 'green' | 'red' | 'missing';\\n  detail: string;\\n}\\n\\nexport interface RuntimeRegistration {\\n  atId: string;\\n  title: string;\\n  surface: string;\\n}\\n\\nexport interface ReportAnalysis {\\n  rows: IdRow[];\\n  unexpected: string[];\\n}\\n\\nfunction assertionId(assertion: AssertionResult): string | null {\\n  return /^(AT-[\\\\d.]+[a-z]?)\\\\s+â€”/.exec(assertion.title ?? assertion.fullName ?? '')?.[1] ?? null;\\n}\\n\\nexport function analyzeReportedTests(\\n  expected: string[],\\n  registrations: RuntimeRegistration[],\\n  assertions: AssertionResult[],\\n): ReportAnalysis {\\n  const registrationGroups = new Map<string, RuntimeRegistration[]>();\\n  for (const registration of registrations) {\\n    const group = registrationGroups.get(registration.atId) ?? [];\\n    group.push(registration);\\n    registrationGroups.set(registration.atId, group);\\n  }\\n\\n  const assertionGroups = new Map<string, AssertionResult[]>();\\n  for (const assertion of assertions) {\\n    const id = assertionId(assertion);\\n    if (!id) continue;\\n    const group = assertionGroups.get(id) ?? [];\\n    group.push(assertion);\\n    assertionGroups.set(id, group);\\n  }\\n\\n  const rows: IdRow[] = expected.map((id) => {\\n    const runtime = registrationGroups.get(id) ?? [];\\n    const results = assertionGroups.get(id) ?? [];\\n    if (runtime.length !== 1) {\\n      return {\\n        id,\\n        status: 'red',\\n        detail:\\n          runtime.length === 0\\n            ? 'no runtime registration emitted by atTest'\\n            : `${runtime.length} runtime registrations emitted by atTest; expected exactly 1`,\\n      };\\n    }\\n    if (results.length !== 1) {\\n      return {\\n        id,\\n        status: 'red',\\n        detail: `${results.length} Vitest results reported; expected exactly 1`,\\n      };\\n    }\\n\\n    const result = results[0];\\n    const expectedTitle = `${id} â€” ${runtime[0].title}`;\\n    if (result.title !== expectedTitle) {\\n      return {\\n        id,\\n        status: 'red',\\n        detail: `Vitest title ${JSON.stringify(result.title)} does not match runtime registration ${JSON.stringify(expectedTitle)}`,\\n      };\\n    }\\n    if (result.status !== 'passed') {\\n      return {\\n        id,\\n        status: 'red',\\n        detail: firstLine(result.failureMessages?.join('\\\\n'), `status \\\"${result.status}\\\"`),\\n      };\\n    }\\n    return { id, status: 'green', detail: runtime[0].title };\\n  });\\n\\n  const observed = new Set([...registrationGroups.keys(), ...assertionGroups.keys()]);\\n  const unexpected = [...observed].filter((id) => !expected.includes(id)).sort();\\n  return { rows, unexpected };\\n}\\n\\nfunction runtimeRegistrations(dir: string): RuntimeRegistration[] {\\n  const registrations: RuntimeRegistration[] = [];\\n  for (const file of readdirSync(dir, { withFileTypes: true })) {\\n    if (!file.isFile() || !file.name.endsWith('.jsonl')) continue;\\n    const lines = readFileSync(join(dir, file.name), 'utf8').split(/\\\\r?\\\\n/).filter(Boolean);\\n    for (const line of lines) registrations.push(JSON.parse(line) as RuntimeRegistration);\\n  }\\n  return registrations;\\n}\\n\\nexport interface ProcessOutcome {\\n  error?: unknown;\\n  status: number | null;\\n  signal?: NodeJS.Signals | null;\\n}\\n\\n/**\\n * The verdict is NOT \\\"did every row go green\\\". A vitest process can report twelve green\\n * assertions and still exit non-zero â€” a global teardown that threw, an unhandled rejection, a\\n * worker that died after its last test. Treating that as success is exactly the false green this\\n * harness exists to prevent, so the process's own exit is part of the verdict, and a discrepancy\\n * between green rows and a non-zero exit is called out rather than smoothed over.\\n */\\nexport function runVerdict(rows: IdRow[], unexpected: string[], run: ProcessOutcome): string[] {\\n  const problems: string[] = [];\\n  const red = rows.filter((r) => r.status === 'red').length;\\n  const missing = rows.filter((r) => r.status === 'missing').length;\\n\\n  if (red) problems.push(`${red} id${red === 1 ? '' : 's'} red`);\\n  if (missing) problems.push(`${missing} id${missing === 1 ? '' : 's'} missing`);\\n  if (unexpected.length) {\\n    problems.push(`${unexpected.length} registered id${unexpected.length === 1 ? '' : 's'} not P0 of this requirement`);\\n  }\\n\\n  if (run.error) {\\n    const err = run.error as NodeJS.ErrnoException;\\n    problems.push(`the test process could not be launched (${err.code ?? 'spawn error'}): ${diagnostic(err.message)}`);\\n  } else if (run.status !== 0) {\\n    const how = run.status === null ? `was killed by signal ${run.signal}` : `exited ${run.status}`;\\n    problems.push(\\n      red || missing\\n        ? `the test process ${how}`\\n        : `the test process ${how} even though every id reported green â€” something failed outside the ` +\\n            `assertions (a teardown, an unhandled rejection, a worker that died). This run is a FAILURE.`,\\n    );\\n  }\\n\\n  return problems;\\n}\\n\\n/**\\n * End-of-run housekeeping. The lock release lives in a `finally` of its OWN so that it cannot be\\n * skipped: on Windows, removing the report directory can throw EPERM while a file in it is still\\n * open, and if that throw escaped, the stack lock would be stranded and every later run would\\n * find a leftover it has to reason about. A lost temp directory is untidy; a stranded lock blocks\\n * work, so the release always wins and the cleanup failure is reported instead of hidden.\\n */\\nexport function cleanupRun(reportDir: string, lock: { release(): void } | null): void {\\n  try {\\n    rmSync(reportDir, { recursive: true, force: true });\\n  } catch (err) {\\n    console.error(`at:verify â€” could not remove the report directory ${reportDir}: ${diagnostic((err as Error).message)}`);\\n  } finally {\\n    lock?.release();\\n  }\\n}\\n\\nfunction firstLine(text: string | undefined, fallback: string): string {\\n  const line = redact(text ?? '')\\n    .split('\\\\n')\\n    .map((l) => l.trim())\\n    .find((l) => l.length > 0);\\n  return line ?? fallback;\\n}\\n\\n/* --------------------------------------------------------------------------------------- main */\\n\\nasync function main(argv: string[]): Promise<number> {\\n  let args: Args;\\n  try {\\n    args = parseArgs(argv);\\n  } catch (err) {\\n    console.error(`at:verify â€” ${(err as Error).message}`);\\n    console.error(USAGE);\\n    return 2;\\n  }\\n\\n  const { requirement, tier, wired, expectDeclared } = args;\\n\\n  if (wired) {\\n    console.error(\\n      `at:verify req-${requirement} --wired â€” the screen driver does not exist yet. Wired re-runs ` +\\n        `drive the ui-marked ids through real screens; that driver is a later AI4DEV-3 slice, so ` +\\n        `there is nothing to re-run against and a silent fixture run would be a false green.`,\\n    );\\n    return 3;\\n  }\\n\\n  const dir = suiteDir(requirement);\\n  if (!existsSync(dir)) {\\n    console.error(`at:verify req-${requirement} â€” no suite at ${dir}`);\\n    return 2;\\n  }\\n\\n  let expected: string[];\\n  try {\\n    const preflight = inspectBijection(requirement);\\n    expected = preflight.expected;\\n    if (preflight.problems.length) {\\n      console.error(`at:verify req-${requirement} â€” ATâ†”code preflight refused the run: ${preflight.problems.join('; ')}`);\\n      return 2;\\n    }\\n  } catch (err) {\\n    console.error(`at:verify req-${requirement} â€” ${(err as Error).message}`);\\n    return 2;\\n  }\\n\\n  // The declaration preflight sits HERE for two reasons, both load-bearing. It needs the\\n  // acceptance file's P0 id set, which only exists after the bijection preflight above; and every\\n  // refusal must run NO tests, so it must precede the vitest spawn. Placing it before the stack\\n  // sequence as well means a bad declaration never takes the machine-wide lock, never talks to\\n  // Docker and never resets a database â€” the refusal costs nothing at any tier.\\n  let expectation: TierExpectation | null = null;\\n  if (expectDeclared) {\\n    try {\\n      expectation = loadTierExpectation(requirement, tier, expected);\\n    } catch (err) {\\n      console.error(`at:verify req-${requirement} --tier ${tier} --expect â€” DECLARATION REFUSED: ${(err as Error).message}`);\",\"lineStart\":1,\"lineEnd\":1194,\"totalLines\":1195,\"truncated\":true}},\"title\":\"tests\\\\at\\\\harness\\\\runner.ts\",\"time\":{\"start\":1786349870370,\"end\":1786349870390}},\"id\":\"prt_feabfdc17001zJgaHkKR53f6Io\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"messageID\":\"msg_feabfa15c001HaL0Lu1Rq80kHK\"}}\r\n+{\"type\":\"text\",\"timestamp\":1786349870511,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feabfdb1d001ftMF80t1Ex8dTr\",\"messageID\":\"msg_feabfa15c001HaL0Lu1Rq80kHK\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"type\":\"text\",\"text\":\"Now let me read the runner.ts â€” the shared seam, takeover policy, and the integration hook.\",\"time\":{\"start\":1786349869853,\"end\":1786349870507}}}\r\n+{\"type\":\"step_finish\",\"timestamp\":1786349870901,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feabfdf280013mYkXwD4UgyhkA\",\"reason\":\"tool-calls\",\"snapshot\":\"e7feb1bc624098c742c3768936fdbefb56ba090d\",\"messageID\":\"msg_feabfa15c001HaL0Lu1Rq80kHK\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"type\":\"step-finish\",\"tokens\":{\"total\":58391,\"input\":6959,\"output\":103,\"reasoning\":1921,\"cache\":{\"write\":0,\"read\":49408}},\"cost\":0.0008396612}}\r\n+{\"type\":\"step_start\",\"timestamp\":1786349873203,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feabfe82e001ftfYWySmCCt37P\",\"messageID\":\"msg_feabfe102001YSc6qNV0MQf28X\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"snapshot\":\"4473f0fda603534134c08bf1d8139406a47f1e05\",\"type\":\"step-start\"}}\r\n+{\"type\":\"tool_use\",\"timestamp\":1786349875271,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"type\":\"tool\",\"tool\":\"read\",\"callID\":\"call_00_3nbbaj2s9SYOeHwqqw8j2212\",\"state\":{\"status\":\"completed\",\"input\":{\"filePath\":\"C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\runner.ts\",\"offset\":1195},\"output\":\"<path>C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\runner.ts</path>\\n<type>file</type>\\n<content>\\n1195:       console.error(`No tests were run. The declaration is the contract; fix ${expectedManifestPath(requirement)}.`);\\n1196:       return 2;\\n1197:     }\\n1198:   }\\n1199: \\n1200:   const infra = (message: string): number => {\\n1201:     console.error(`at:verify req-${requirement} --tier ${tier} â€” INFRASTRUCTURE: ${message}`);\\n1202:     console.error('No tests were run. This is an infrastructure failure, not a test failure.');\\n1203:     return 3;\\n1204:   };\\n1205: \\n1206:   const stackHelp =\\n1207:     `Two things cause this:\\\\n` +\\n1208:     `  1. Docker Desktop is not installed, or is installed but not running, or its CLI is not on ` +\\n1209:     `PATH â€” a slot's stack is a set of Docker containers and cannot run without it.\\\\n` +\\n1210:     `  2. Docker is fine but the pool was never set up on this machine â€” run ` +\\n1211:     `\\\\`bun tests/at/harness/db-pool.ts setup\\\\`.`;\\n1212: \\n1213:   // The `loop` tier touches no database: no lock, no stack, no reset.\\n1214:   const stackEnv: Record<string, string> = {};\\n1215:   let lock: StackLock | null = null;\\n1216:   const reportDir = mkdtempSync(join(tmpdir(), 'at-verify-'));\\n1217:   const registrationDir = join(reportDir, 'registrations');\\n1218:   mkdirSync(registrationDir);\\n1219:   const cleanup = () => {\\n1220:     cleanupRun(reportDir, lock);\\n1221:     lock = null;\\n1222:   };\\n1223:   const onSignal = () => {\\n1224:     cleanup();\\n1225:     process.exit(130);\\n1226:   };\\n1227:   process.once('SIGINT', onSignal);\\n1228:   process.once('SIGTERM', onSignal);\\n1229: \\n1230:   try {\\n1231:     // THE DRILL TIER RESOLVES NO DATABASE. It used to reach the stack described by the repository's\\n1232:     // own `supabase/config.toml` â€” which is the founder's personal stack â€” and reset it. Nothing in\\n1233:     // this tree invokes the tier, so refusing costs nothing, and it closes the last path in the\\n1234:     // harness that could reset that stack. The item that decides drill's stack replaces this.\\n1235:     if (tier === 'drill') {\\n1236:       return infra(\\n1237:         `the drill tier's stack is not yet decided, so this tier resolves no database at all. It used ` +\\n1238:           `to reset the stack described by the repository's own supabase/config.toml, which is the ` +\\n1239:           `founder's personal stack, and that stack is untouchable.`,\\n1240:       );\\n1241:     }\\n1242: \\n1243:     if (tier === 'integration') {\\n1244:       // THE STACK IS RESOLVED ONLY THROUGH THE POOL. Occupy a slot, make its database be this\\n1245:       // tree's database, and hand the suite the slot's coordinates. The repo-configured stack is\\n1246:       // never read, never locked and never reset from here.\\n1247:       let occupancy: Occupancy;\\n1248:       try {\\n1249:         const override = process.env.AT_DB_SLOT?.trim();\\n1250:         occupancy = occupy(`req-${requirement}`, override ? { slot: Number(override) } : {});\\n1251:       } catch (err) {\\n1252:         return infra((err as Error).message);\\n1253:       }\\n1254:       // The claim goes into the SAME `lock` variable `cleanupRun` already releases, so the release\\n1255:       // stays in the one `finally` chain that exists rather than in a second one nobody can see.\\n1256:       lock = occupancy.claim;\\n1257: \\n1258:       let prepared: PrepareResult;\\n1259:       try {\\n1260:         // prepare() mirrors this tree into the slot, regenerates the slot's identity, proves the\\n1261:         // stack that answers is the slot's own, resets it, and proves the migration set replayed.\\n1262:         prepared = await prepare(occupancy);\\n1263:       } catch (err) {\\n1264:         return infra(\\n1265:           `slot ${occupancy.slot} could not be prepared: ${(err as Error).message}\\\\n` +\\n1266:             `The integration tier rebuilds its slot's database from supabase/migrations on every run, ` +\\n1267:             `so that a suite never grades leftover rows or a schema missing a migration; if that ` +\\n1268:             `rebuild fails, the state under test is unknown and the run stops here.\\\\n${stackHelp}`,\\n1269:         );\\n1270:       }\\n1271: \\n1272:       // The ruled evidence line: which slot, that the reset happened, and the migration state.\\n1273:       console.log(evidence(occupancy, prepared));\\n1274:       Object.assign(stackEnv, slotStackEnv(occupancy, prepared.status));\\n1275:     }\\n1276: \\n1277:     // The suites and their vitest root come from the DATA root; vitest itself comes from the\\n1278:     // install root, so a run pointed at a disposable tree still runs the pinned test framework.\\n1279:     const atRoot = join(REPO_ROOT, 'tests', 'at');\\n1280:     const outputFile = join(reportDir, 'vitest-report.json');\\n1281:     const rootOverride: Record<string, string> = {};\\n1282:     if (process.env.AT_REPO_ROOT?.trim()) rootOverride.AT_REPO_ROOT = process.env.AT_REPO_ROOT.trim();\\n1283: \\n1284:     const run = spawnSync(\\n1285:       bunExecutable(),\\n1286:       [\\n1287:         '--no-env-file',\\n1288:         join(INSTALL_ROOT, 'node_modules', 'vitest', 'vitest.mjs'),\\n1289:         'run',\\n1290:         '--root',\\n1291:         atRoot,\\n1292:         '--config',\\n1293:         join(atRoot, 'vitest.config.ts'),\\n1294:         '--reporter=json',\\n1295:         `--outputFile=${outputFile}`,\\n1296:         `suites/req-${requirement}/`,\\n1297:       ],\\n1298:       {\\n1299:         cwd: INSTALL_ROOT,\\n1300:         env: childEnv({ ...stackEnv, ...rootOverride, AT_TIER: tier, AT_REGISTRATION_DIR: registrationDir }),\\n1301:         stdio: ['ignore', 'inherit', 'inherit'],\\n1302:       },\\n1303:     );\\n1304: \\n1305:     if (!existsSync(outputFile)) {\\n1306:       console.error(\\n1307:         `at:verify req-${requirement} â€” vitest produced no report ` +\\n1308:           `(exit ${run.status}${run.signal ? `, signal ${run.signal}` : ''}` +\\n1309:           `${run.error ? `, ${diagnostic((run.error as Error).message)}` : ''})`,\\n1310:       );\\n1311:       return 4;\\n1312:     }\\n1313: \\n1314:     let report: VitestJson;\\n1315:     try {\\n1316:       report = JSON.parse(readFileSync(outputFile, 'utf8')) as VitestJson;\\n1317:     } catch (err) {\\n1318:       console.error(`at:verify req-${requirement} â€” unreadable vitest report: ${(err as Error).message}`);\\n1319:       return 4;\\n1320:     }\\n1321: \\n1322:     const assertions = (report.testResults ?? []).flatMap((r) => r.assertionResults ?? []);\\n1323:     const analysis = analyzeReportedTests(expected, runtimeRegistrations(registrationDir), assertions);\\n1324:     const { rows, unexpected } = analysis;\\n1325: \\n1326:     console.log('');\\n1327:     console.log(`at:verify req-${requirement} --tier ${tier}`);\\n1328:     for (const row of rows) console.log(`  ${row.id.padEnd(12)} ${row.status.padEnd(8)} ${row.detail}`);\\n1329:     for (const id of unexpected) console.log(`  ${id.padEnd(12)} ${'extra'.padEnd(8)} registered but not a P0 of this requirement`);\\n1330: \\n1331:     const green = rows.filter((r) => r.status === 'green').length;\\n1332:     const red = rows.filter((r) => r.status === 'red').length;\\n1333:     const missing = rows.filter((r) => r.status === 'missing').length;\\n1334:     console.log(\\n1335:       `  ${rows.length} P0: ${green} green, ${red} red, ${missing} missing${unexpected.length ? `, ${unexpected.length} extra` : ''}`,\\n1336:     );\\n1337: \\n1338:     if (!expectation) {\\n1339:       const verdict = runVerdict(rows, unexpected, run as ProcessOutcome);\\n1340:       if (verdict.length === 0) return 0;\\n1341:       for (const problem of verdict) console.log(`  FAILURE: ${problem}`);\\n1342:       return 1;\\n1343:     }\\n1344: \\n1345:     // Both deviation sets are computed and printed: an id-level and a report-level problem in the\\n1346:     // same run are two facts an author needs at once, and printing only the first costs a second\\n1347:     // run to find the second.\\n1348:     const deviations = [\\n1349:       ...expectationDeviations(rows, unexpected, expectation),\\n1350:       ...reportAccountingDeviations(report, run as ProcessOutcome, expectation),\\n1351:     ];\\n1352:     if (deviations.length === 0) {\\n1353:       console.log(\\n1354:         `  EXPECTED: the run matches ${expectedManifestPath(requirement)} exactly ` +\\n1355:           `(${expectation.green.length} declared green, ${Object.keys(expectation.red).length} declared red)`,\\n1356:       );\\n1357:       return 0;\\n1358:     }\\n1359:     for (const deviation of deviations) console.log(`  DEVIATION: ${deviation}`);\\n1360:     console.log(\\n1361:       `  EXPECT FAILURE: ${deviations.length} deviation(s) from the declaration. A red that turned green is a ` +\\n1362:         `failure too â€” if reality improved, update the declaration in the same change.`,\\n1363:     );\\n1364:     return 1;\\n1365:   } finally {\\n1366:     process.off('SIGINT', onSignal);\\n1367:     process.off('SIGTERM', onSignal);\\n1368:     cleanup();\\n1369:   }\\n1370: }\\n1371: \\n1372: if (import.meta.main) process.exit(await main(process.argv.slice(2)));\\n\\n(End of file - total 1372 lines)\\n</content>\",\"metadata\":{\"preview\":\"      console.error(`No tests were run. The declaration is the contract; fix ${expectedManifestPath(requirement)}.`);\\n      return 2;\\n    }\\n  }\\n\\n  const infra = (message: string): number => {\\n    console.error(`at:verify req-${requirement} --tier ${tier} â€” INFRASTRUCTURE: ${message}`);\\n    console.error('No tests were run. This is an infrastructure failure, not a test failure.');\\n    return 3;\\n  };\\n\\n  const stackHelp =\\n    `Two things cause this:\\\\n` +\\n    `  1. Docker Desktop is not installed, or is installed but not running, or its CLI is not on ` +\\n    `PATH â€” a slot's stack is a set of Docker containers and cannot run without it.\\\\n` +\\n    `  2. Docker is fine but the pool was never set up on this machine â€” run ` +\\n    `\\\\`bun tests/at/harness/db-pool.ts setup\\\\`.`;\\n\\n  // The `loop` tier touches no database: no lock, no stack, no reset.\\n  const stackEnv: Record<string, string> = {};\",\"truncated\":false,\"loaded\":[],\"display\":{\"type\":\"file\",\"path\":\"C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\runner.ts\",\"text\":\"      console.error(`No tests were run. The declaration is the contract; fix ${expectedManifestPath(requirement)}.`);\\n      return 2;\\n    }\\n  }\\n\\n  const infra = (message: string): number => {\\n    console.error(`at:verify req-${requirement} --tier ${tier} â€” INFRASTRUCTURE: ${message}`);\\n    console.error('No tests were run. This is an infrastructure failure, not a test failure.');\\n    return 3;\\n  };\\n\\n  const stackHelp =\\n    `Two things cause this:\\\\n` +\\n    `  1. Docker Desktop is not installed, or is installed but not running, or its CLI is not on ` +\\n    `PATH â€” a slot's stack is a set of Docker containers and cannot run without it.\\\\n` +\\n    `  2. Docker is fine but the pool was never set up on this machine â€” run ` +\\n    `\\\\`bun tests/at/harness/db-pool.ts setup\\\\`.`;\\n\\n  // The `loop` tier touches no database: no lock, no stack, no reset.\\n  const stackEnv: Record<string, string> = {};\\n  let lock: StackLock | null = null;\\n  const reportDir = mkdtempSync(join(tmpdir(), 'at-verify-'));\\n  const registrationDir = join(reportDir, 'registrations');\\n  mkdirSync(registrationDir);\\n  const cleanup = () => {\\n    cleanupRun(reportDir, lock);\\n    lock = null;\\n  };\\n  const onSignal = () => {\\n    cleanup();\\n    process.exit(130);\\n  };\\n  process.once('SIGINT', onSignal);\\n  process.once('SIGTERM', onSignal);\\n\\n  try {\\n    // THE DRILL TIER RESOLVES NO DATABASE. It used to reach the stack described by the repository's\\n    // own `supabase/config.toml` â€” which is the founder's personal stack â€” and reset it. Nothing in\\n    // this tree invokes the tier, so refusing costs nothing, and it closes the last path in the\\n    // harness that could reset that stack. The item that decides drill's stack replaces this.\\n    if (tier === 'drill') {\\n      return infra(\\n        `the drill tier's stack is not yet decided, so this tier resolves no database at all. It used ` +\\n          `to reset the stack described by the repository's own supabase/config.toml, which is the ` +\\n          `founder's personal stack, and that stack is untouchable.`,\\n      );\\n    }\\n\\n    if (tier === 'integration') {\\n      // THE STACK IS RESOLVED ONLY THROUGH THE POOL. Occupy a slot, make its database be this\\n      // tree's database, and hand the suite the slot's coordinates. The repo-configured stack is\\n      // never read, never locked and never reset from here.\\n      let occupancy: Occupancy;\\n      try {\\n        const override = process.env.AT_DB_SLOT?.trim();\\n        occupancy = occupy(`req-${requirement}`, override ? { slot: Number(override) } : {});\\n      } catch (err) {\\n        return infra((err as Error).message);\\n      }\\n      // The claim goes into the SAME `lock` variable `cleanupRun` already releases, so the release\\n      // stays in the one `finally` chain that exists rather than in a second one nobody can see.\\n      lock = occupancy.claim;\\n\\n      let prepared: PrepareResult;\\n      try {\\n        // prepare() mirrors this tree into the slot, regenerates the slot's identity, proves the\\n        // stack that answers is the slot's own, resets it, and proves the migration set replayed.\\n        prepared = await prepare(occupancy);\\n      } catch (err) {\\n        return infra(\\n          `slot ${occupancy.slot} could not be prepared: ${(err as Error).message}\\\\n` +\\n            `The integration tier rebuilds its slot's database from supabase/migrations on every run, ` +\\n            `so that a suite never grades leftover rows or a schema missing a migration; if that ` +\\n            `rebuild fails, the state under test is unknown and the run stops here.\\\\n${stackHelp}`,\\n        );\\n      }\\n\\n      // The ruled evidence line: which slot, that the reset happened, and the migration state.\\n      console.log(evidence(occupancy, prepared));\\n      Object.assign(stackEnv, slotStackEnv(occupancy, prepared.status));\\n    }\\n\\n    // The suites and their vitest root come from the DATA root; vitest itself comes from the\\n    // install root, so a run pointed at a disposable tree still runs the pinned test framework.\\n    const atRoot = join(REPO_ROOT, 'tests', 'at');\\n    const outputFile = join(reportDir, 'vitest-report.json');\\n    const rootOverride: Record<string, string> = {};\\n    if (process.env.AT_REPO_ROOT?.trim()) rootOverride.AT_REPO_ROOT = process.env.AT_REPO_ROOT.trim();\\n\\n    const run = spawnSync(\\n      bunExecutable(),\\n      [\\n        '--no-env-file',\\n        join(INSTALL_ROOT, 'node_modules', 'vitest', 'vitest.mjs'),\\n        'run',\\n        '--root',\\n        atRoot,\\n        '--config',\\n        join(atRoot, 'vitest.config.ts'),\\n        '--reporter=json',\\n        `--outputFile=${outputFile}`,\\n        `suites/req-${requirement}/`,\\n      ],\\n      {\\n        cwd: INSTALL_ROOT,\\n        env: childEnv({ ...stackEnv, ...rootOverride, AT_TIER: tier, AT_REGISTRATION_DIR: registrationDir }),\\n        stdio: ['ignore', 'inherit', 'inherit'],\\n      },\\n    );\\n\\n    if (!existsSync(outputFile)) {\\n      console.error(\\n        `at:verify req-${requirement} â€” vitest produced no report ` +\\n          `(exit ${run.status}${run.signal ? `, signal ${run.signal}` : ''}` +\\n          `${run.error ? `, ${diagnostic((run.error as Error).message)}` : ''})`,\\n      );\\n      return 4;\\n    }\\n\\n    let report: VitestJson;\\n    try {\\n      report = JSON.parse(readFileSync(outputFile, 'utf8')) as VitestJson;\\n    } catch (err) {\\n      console.error(`at:verify req-${requirement} â€” unreadable vitest report: ${(err as Error).message}`);\\n      return 4;\\n    }\\n\\n    const assertions = (report.testResults ?? []).flatMap((r) => r.assertionResults ?? []);\\n    const analysis = analyzeReportedTests(expected, runtimeRegistrations(registrationDir), assertions);\\n    const { rows, unexpected } = analysis;\\n\\n    console.log('');\\n    console.log(`at:verify req-${requirement} --tier ${tier}`);\\n    for (const row of rows) console.log(`  ${row.id.padEnd(12)} ${row.status.padEnd(8)} ${row.detail}`);\\n    for (const id of unexpected) console.log(`  ${id.padEnd(12)} ${'extra'.padEnd(8)} registered but not a P0 of this requirement`);\\n\\n    const green = rows.filter((r) => r.status === 'green').length;\\n    const red = rows.filter((r) => r.status === 'red').length;\\n    const missing = rows.filter((r) => r.status === 'missing').length;\\n    console.log(\\n      `  ${rows.length} P0: ${green} green, ${red} red, ${missing} missing${unexpected.length ? `, ${unexpected.length} extra` : ''}`,\\n    );\\n\\n    if (!expectation) {\\n      const verdict = runVerdict(rows, unexpected, run as ProcessOutcome);\\n      if (verdict.length === 0) return 0;\\n      for (const problem of verdict) console.log(`  FAILURE: ${problem}`);\\n      return 1;\\n    }\\n\\n    // Both deviation sets are computed and printed: an id-level and a report-level problem in the\\n    // same run are two facts an author needs at once, and printing only the first costs a second\\n    // run to find the second.\\n    const deviations = [\\n      ...expectationDeviations(rows, unexpected, expectation),\\n      ...reportAccountingDeviations(report, run as ProcessOutcome, expectation),\\n    ];\\n    if (deviations.length === 0) {\\n      console.log(\\n        `  EXPECTED: the run matches ${expectedManifestPath(requirement)} exactly ` +\\n          `(${expectation.green.length} declared green, ${Object.keys(expectation.red).length} declared red)`,\\n      );\\n      return 0;\\n    }\\n    for (const deviation of deviations) console.log(`  DEVIATION: ${deviation}`);\\n    console.log(\\n      `  EXPECT FAILURE: ${deviations.length} deviation(s) from the declaration. A red that turned green is a ` +\\n        `failure too â€” if reality improved, update the declaration in the same change.`,\\n    );\\n    return 1;\\n  } finally {\\n    process.off('SIGINT', onSignal);\\n    process.off('SIGTERM', onSignal);\\n    cleanup();\\n  }\\n}\\n\\nif (import.meta.main) process.exit(await main(process.argv.slice(2)));\",\"lineStart\":1195,\"lineEnd\":1372,\"totalLines\":1372,\"truncated\":false}},\"title\":\"tests\\\\at\\\\harness\\\\runner.ts\",\"time\":{\"start\":1786349875239,\"end\":1786349875268}},\"id\":\"prt_feabfeeff001xztloqd779yqwX\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"messageID\":\"msg_feabfe102001YSc6qNV0MQf28X\"}}\r\n+{\"type\":\"step_finish\",\"timestamp\":1786349875711,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feabff1f3001flPrU0xvtIqfAs\",\"reason\":\"tool-calls\",\"snapshot\":\"0d51d8f4d77b792f709f68aa52a24ad3a75effa6\",\"messageID\":\"msg_feabfe102001YSc6qNV0MQf28X\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"type\":\"step-finish\",\"tokens\":{\"total\":74439,\"input\":15959,\"output\":101,\"reasoning\":11,\"cache\":{\"write\":0,\"read\":58368}},\"cost\":0.0012145252}}\r\n+{\"type\":\"step_start\",\"timestamp\":1786349890247,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feac02ac5001YXz7IAM7LzQnGR\",\"messageID\":\"msg_feabff3b8001bLuMZ9f58S189R\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"snapshot\":\"42f01e7412c793966762b479258eab221f9c3a67\",\"type\":\"step-start\"}}\r\n+{\"type\":\"tool_use\",\"timestamp\":1786349897726,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"type\":\"tool\",\"tool\":\"read\",\"callID\":\"call_00_g4ob0GFJRAg8DCm4995n1755\",\"state\":{\"status\":\"completed\",\"input\":{\"filePath\":\"C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\db-pool.selftest.ts\"},\"output\":\"<path>C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\db-pool.selftest.ts</path>\\n<type>file</type>\\n<content>\\n1: /**\\n2:  * Tests OF the database slot pool, not tests run BY it.\\n3:  *\\n4:  * THEY RUN WITH NO DOCKER, NO STACK AND NO SLOT DIRECTORY ON THIS MACHINE, because CI runs them\\n5:  * that way (no Docker step, either runner) and a test that quietly needs a live stack would be\\n6:  * green on the dev machine and absent everywhere else. So the pool root is a temporary directory\\n7:  * (`AT_DB_POOL_ROOT`), the claim directory is a temporary directory (`AT_LOCK_DIR`), and the only\\n8:  * thing that is real is the claim protocol and the configuration arithmetic â€” which is exactly\\n9:  * what these tests are about.\\n10:  *\\n11:  * WHAT THEY DO NOT CLAIM: nothing here proves the isolation wall. A Dockerless test cannot reset a\\n12:  * database, so it cannot prove that a reset lands where it was aimed. That proof is the committed\\n13:  * spike transcript, taken once on the dev machine against three real stacks.\\n14:  */\\n15: \\n16: import { spawn, spawnSync } from 'node:child_process';\\n17: import { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, symlinkSync, writeFileSync } from 'node:fs';\\n18: import { tmpdir } from 'node:os';\\n19: import { join } from 'node:path';\\n20: import { afterAll, beforeAll, describe, expect, it, vi } from 'vitest';\\n21: \\n22: import { REPO_ROOT } from './check.ts';\\n23: import { bunExecutable, stackLockPath, type StackStatus } from './runner.ts';\\n24: import {\\n25:   evidence,\\n26:   generateSlotConfig,\\n27:   itemFromBranch,\\n28:   mirrorItemTree,\\n29:   occupy,\\n30:   pathClosureProblems,\\n31:   personalBlockProblems,\\n32:   portMappings,\\n33:   release,\\n34:   reservationPath,\\n35:   slotClaimKey,\\n36:   slotConfigPath,\\n37:   slotDir,\\n38:   slotProjectId,\\n39:   type Occupancy,\\n40:   type PrepareResult,\\n41: } from './db-pool.ts';\\n42: \\n43: const REPO_CONFIG = readFileSync(join(REPO_ROOT, 'supabase', 'config.toml'), 'utf8');\\n44: \\n45: let poolTemp = '';\\n46: let lockTemp = '';\\n47: let previousPool: string | undefined;\\n48: let previousLocks: string | undefined;\\n49: \\n50: /** Write a slot's `config.toml` into the temporary pool, exactly as `setup` would. */\\n51: function installSlot(slot: number): void {\\n52:   mkdirSync(join(slotDir(slot), 'supabase'), { recursive: true });\\n53:   writeFileSync(slotConfigPath(slot), generateSlotConfig(REPO_CONFIG, slot), 'utf8');\\n54: }\\n55: \\n56: /**\\n57:  * Where the occupancy claim for a slot lives.\\n58:  *\\n59:  * IT IS DERIVED FROM THE SLOT NUMBER, never from the slot's current config (ruling T6). A test that\\n60:  * read the config for the api port would be asserting against a name `prepare` is allowed to move,\\n61:  * and would keep passing while the two runs it is meant to serialize held different files.\\n62:  */\\n63: function claimPath(slot: number): string {\\n64:   return stackLockPath(slotClaimKey(slot));\\n65: }\\n66: \\n67: /** A process id that is PROVABLY dead: a real child, started, waited for, and gone (ruling F9). */\\n68: function deadPid(): number {\\n69:   const child = spawnSync(bunExecutable(), ['--no-env-file', '-e', 'process.exit(0)'], { encoding: 'utf8' });\\n70:   expect(typeof child.pid, 'the probe child reported no process id, so nothing provably dead exists to plant').toBe('number');\\n71:   return child.pid as number;\\n72: }\\n73: \\n74: function writeReservation(slot: number, item: string): void {\\n75:   mkdirSync(join(poolTemp, 'reservations'), { recursive: true });\\n76:   writeFileSync(\\n77:     reservationPath(slot),\\n78:     JSON.stringify({ slot, item, branch: 'test', at: new Date().toISOString(), holder: 'selftest' }),\\n79:     'utf8',\\n80:   );\\n81: }\\n82: \\n83: function plantClaim(slot: number, holder: Record<string, unknown>): void {\\n84:   writeFileSync(claimPath(slot), JSON.stringify(holder), 'utf8');\\n85: }\\n86: \\n87: /** A claim file exactly as it looks mid-write, or after a crash: present, and saying nothing. */\\n88: function plantRawClaim(slot: number, text: string): void {\\n89:   writeFileSync(claimPath(slot), text, 'utf8');\\n90: }\\n91: \\n92: function scrubClaim(slot: number): void {\\n93:   rmSync(claimPath(slot), { force: true });\\n94: }\\n95: \\n96: beforeAll(() => {\\n97:   previousPool = process.env.AT_DB_POOL_ROOT;\\n98:   previousLocks = process.env.AT_LOCK_DIR;\\n99:   poolTemp = mkdtempSync(join(tmpdir(), 'at-db-pool-'));\\n100:   lockTemp = mkdtempSync(join(tmpdir(), 'at-db-locks-'));\\n101:   process.env.AT_DB_POOL_ROOT = poolTemp;\\n102:   process.env.AT_LOCK_DIR = lockTemp;\\n103: });\\n104: \\n105: afterAll(() => {\\n106:   if (previousPool === undefined) delete process.env.AT_DB_POOL_ROOT;\\n107:   else process.env.AT_DB_POOL_ROOT = previousPool;\\n108:   if (previousLocks === undefined) delete process.env.AT_LOCK_DIR;\\n109:   else process.env.AT_LOCK_DIR = previousLocks;\\n110:   rmSync(poolTemp, { recursive: true, force: true });\\n111:   rmSync(lockTemp, { recursive: true, force: true });\\n112: });\\n113: \\n114: describe('one slot has exactly one occupier', () => {\\n115:   it('two concurrent occupies on one slot end with exactly one winner', async () => {\\n116:     installSlot(1);\\n117:     const moduleUrl = new URL('./db-pool.ts', import.meta.url).href;\\n118:     const startAt = Date.now() + 800;\\n119: \\n120:     const contender = (): Promise<string> => {\\n121:       const code =\\n122:         `const { occupy } = await import(${JSON.stringify(moduleUrl)});\\\\n` +\\n123:         `while (Date.now() < ${startAt}) {}\\\\n` + // a barrier, so both attempt at the same instant\\n124:         `try {\\\\n` +\\n125:         `  const held = occupy('req-000', { slot: 1 });\\\\n` +\\n126:         `  console.log('ACQUIRED');\\\\n` +\\n127:         `  await Bun.sleep(600);\\\\n` + // hold it, so the loser meets a LIVE holder\\n128:         `  held.release();\\\\n` +\\n129:         `} catch { console.log('REFUSED'); }\\\\n`;\\n130:       // spawn, NOT spawnSync: a synchronous spawn would run the contenders one after the other,\\n131:       // and the second would find the claim already released â€” a race that never raced.\\n132:       return new Promise<string>((resolve) => {\\n133:         const child = spawn(bunExecutable(), ['--no-env-file', '-e', code], {\\n134:           env: { ...process.env, AT_DB_POOL_ROOT: poolTemp, AT_LOCK_DIR: lockTemp } as NodeJS.ProcessEnv,\\n135:           stdio: ['ignore', 'pipe', 'pipe'],\\n136:         });\\n137:         let out = '';\\n138:         child.stdout.on('data', (chunk: Buffer) => (out += chunk.toString('utf8')));\\n139:         child.stderr.on('data', (chunk: Buffer) => (out += chunk.toString('utf8')));\\n140:         child.once('error', (err) => resolve(`ERROR ${err.message}`));\\n141:         child.once('close', () => resolve(out));\\n142:       });\\n143:     };\\n144: \\n145:     const [a, b] = await Promise.all([contender(), contender()]);\\n146:     const outcomes = [a, b].map((out) => (out.includes('ACQUIRED') ? 'ACQUIRED' : out.includes('REFUSED') ? 'REFUSED' : `UNKNOWN(${out.trim()})`));\\n147: \\n148:     try {\\n149:       expect(outcomes.filter((o) => o === 'ACQUIRED'), `outcomes were ${JSON.stringify(outcomes)}`).toHaveLength(1);\\n150:       expect(outcomes.filter((o) => o === 'REFUSED'), `outcomes were ${JSON.stringify(outcomes)}`).toHaveLength(1);\\n151:       expect(existsSync(claimPath(1)), 'the winner did not release its claim').toBe(false);\\n152:     } finally {\\n153:       scrubClaim(1);\\n154:     }\\n155:   }, 60_000);\\n156: \\n157:   it('breaks a dead holder LOUDLY and records the takeover in the new claim', () => {\\n158:     installSlot(1);\\n159:     // A REAL process id, from a child that has already exited (ruling F9). A made-up large number\\n160:     // is only ASSUMED dead, and a busy machine can legitimately be holding it â€” which would make\\n161:     // the one test that guards the takeover rule fail for a reason that has nothing to do with it.\\n162:     const gone = deadPid();\\n163:     plantClaim(1, { pid: gone, host: 'gone', requirement: 'req-000', startedAt: new Date().toISOString() });\\n164:     const said = vi.spyOn(console, 'log').mockImplementation(() => undefined);\\n165:     try {\\n166:       const held = occupy('req-016', { slot: 1 });\\n167:       const claim = JSON.parse(readFileSync(held.claim.file, 'utf8')) as {\\n168:         pid?: number;\\n169:         tookOverFrom?: { pid?: number; requirement?: string };\\n170:       };\\n171:       expect(claim.pid, 'the takeover did not record this process as the holder').toBe(process.pid);\\n172:       expect(claim.tookOverFrom?.pid, 'the displaced holder was not recorded IN the claim').toBe(gone);\\n173:       expect(claim.tookOverFrom?.requirement).toBe('req-000');\\n174:       expect(said.mock.calls.flat().join(' '), 'the takeover was silent').toContain('took over a stale stack lock');\\n175:       held.release();\\n176:     } finally {\\n177:       said.mockRestore();\\n178:       scrubClaim(1);\\n179:     }\\n180:   });\\n181: \\n182:   it('never takes over a LIVE holder, at any age, and names it', () => {\\n183:     installSlot(1);\\n184:     // Alive (this very process) and old enough that the runner's own stale window would displace\\n185:     // it. The pool passes dead-pid-only, so it must not.\\n186:     plantClaim(1, {\\n187:       pid: process.pid,\\n188:       host: 'here',\\n189:       requirement: 'req-000',\\n190:       startedAt: new Date(Date.now() - 48 * 60 * 60 * 1000).toISOString(),\\n191:     });\\n192:     try {\\n193:       expect(() => occupy('req-016', { slot: 1 })).toThrow(new RegExp(`another at:verify run holds this stack \\\\\\\\(pid ${process.pid}`));\\n194:     } finally {\\n195:       scrubClaim(1);\\n196:     }\\n197:   });\\n198: \\n199:   it('never takes over a claim file it cannot identify, and names the file (ruling T1)', () => {\\n200:     installSlot(1);\\n201:     // AN EMPTY FILE IS WHAT A LIVE CLAIM LOOKS LIKE MID-WRITE. The exclusive create and the write\\n202:     // that fills it are two acts, and between them the file exists and says nothing. Under\\n203:     // dead-pid-only that must NEVER read as a dead holder: taking it over would delete a live\\n204:     // run's brand-new claim, which is the one thing this policy exists to make impossible.\\n205:     for (const planted of ['', '   \\\\n', '{\\\"pid\\\":', 'not json at all']) {\\n206:       plantRawClaim(1, planted);\\n207:       try {\\n208:         expect(() => occupy('req-016', { slot: 1 }), `a claim file containing ${JSON.stringify(planted)} was taken over`).toThrow(\\n209:           /names no process id that this run can read/,\\n210:         );\\n211:         expect(() => occupy('req-016', { slot: 1 })).toThrow(claimPath(1));\\n212:         expect(existsSync(claimPath(1)), 'the refusal deleted the file it could not identify').toBe(true);\\n213:       } finally {\\n214:         scrubClaim(1);\\n215:       }\\n216:     }\\n217:   }, 30_000);\\n218: \\n219:   it('releases from a `finally` when the caller throws', () => {\\n220:     installSlot(1);\\n221:     let held: Occupancy | null = null;\\n222:     expect(() => {\\n223:       try {\\n224:         held = occupy('req-016', { slot: 1 });\\n225:         throw new Error('the suite blew up');\\n226:       } finally {\\n227:         release(held);\\n228:       }\\n229:     }).toThrow('the suite blew up');\\n230:     expect(existsSync(claimPath(1)), 'a throwing caller stranded the occupancy claim').toBe(false);\\n231:   });\\n232: });\\n233: \\n234: describe('admission control belongs to the coordinator, not to the run', () => {\\n235:   it('refuses a run whose item holds no reservation, and names the helper that makes one', () => {\\n236:     rmSync(reservationPath(1), { force: true });\\n237:     rmSync(reservationPath(2), { force: true });\\n238:     expect(() => occupy('req-016', { item: 'AI4DEV-999' })).toThrow(/Reserve-DbSlot -Item AI4DEV-999/);\\n239:     expect(() => occupy('req-016', { item: 'AI4DEV-999' })).toThrow(/no fallback onto a free slot/);\\n240:   });\\n241: \\n242:   it('finds the slot the reservation names', () => {\\n243:     installSlot(2);\\n244:     writeReservation(2, 'AI4DEV-79');\\n245:     try {\\n246:       const held = occupy('req-016', { item: 'AI4DEV-79' });\\n247:       expect(held.slot).toBe(2);\\n248:       expect(held.via).toBe('reservation');\\n249:       held.release();\\n250:     } finally {\\n251:       rmSync(reservationPath(2), { force: true });\\n252:       scrubClaim(2);\\n253:     }\\n254:   });\\n255: \\n256:   it('refuses an AT_DB_SLOT run aimed at a slot another item holds (ruling T5)', () => {\\n257:     installSlot(2);\\n258:     writeReservation(2, 'AI4DEV-900');\\n259:     try {\\n260:       expect(() => occupy('req-016', { slot: 2, item: 'AI4DEV-79' })).toThrow(/reserved for AI4DEV-900/);\\n261:       expect(existsSync(claimPath(2)), 'the refusal still took the claim').toBe(false);\\n262:     } finally {\\n263:       rmSync(reservationPath(2), { force: true });\\n264:       scrubClaim(2);\\n265:     }\\n266:   });\\n267: \\n268:   it('lets an AT_DB_SLOT run take a slot reserved for its OWN item', () => {\\n269:     installSlot(2);\\n270:     writeReservation(2, 'AI4DEV-79');\\n271:     try {\\n272:       const held = occupy('req-016', { slot: 2, item: 'AI4DEV-79' });\\n273:       expect(held.via).toBe('override');\\n274:       expect(held.slot).toBe(2);\\n275:       held.release();\\n276:     } finally {\\n277:       rmSync(reservationPath(2), { force: true });\\n278:       scrubClaim(2);\\n279:     }\\n280:   });\\n281: });\\n282: \\n283: describe('the branch parser fails closed', () => {\\n284:   it('accepts exactly one item id', () => {\\n285:     expect(itemFromBranch('nirdrang/ai4dev-79-a-pool-of-local-database-slots')).toBe('AI4DEV-79');\\n286:     expect(itemFromBranch('feature/AI4PM-19-auth')).toBe('AI4PM-19');\\n287:   });\\n288: \\n289:   it('refuses zero ids, several ids, an empty name and a detached HEAD', () => {\\n290:     expect(() => itemFromBranch('main')).toThrow(/names no item id/);\\n291:     expect(() => itemFromBranch('nirdrang/ai4dev-79-and-ai4dev-80')).toThrow(/names 2 item ids/);\\n292:     expect(() => itemFromBranch('')).toThrow(/branch name is empty/);\\n293:     expect(() => itemFromBranch('HEAD')).toThrow(/HEAD is detached/);\\n294:   });\\n295: });\\n296: \\n297: describe('the personal stack is refused in code', () => {\\n298:   it('refuses the repo project id and any port in the personal block', () => {\\n299:     const personal = /project_id\\\\s*=\\\\s*\\\"([^\\\"]+)\\\"/.exec(REPO_CONFIG)?.[1] ?? '';\\n300:     expect(personal, 'the repository config carries no project_id to test against').not.toBe('');\\n301: \\n302:     const problems = personalBlockProblems(REPO_CONFIG, personal);\\n303:     expect(problems.join(' '), 'the repo config was not recognised as the personal identity').toContain(`project id \\\"${personal}\\\"`);\\n304:     expect(problems.join(' '), 'a 54321-block port was not refused').toMatch(/is inside the personal stack's port block/);\\n305:     expect(problems.join(' '), 'the personal inspector port was not refused').toContain('inspector_port');\\n306:   });\\n307: \\n308:   it('accepts a generated slot config, which is the same file wearing a slot identity', () => {\\n309:     const personal = /project_id\\\\s*=\\\\s*\\\"([^\\\"]+)\\\"/.exec(REPO_CONFIG)?.[1] ?? '';\\n310:     expect(personalBlockProblems(generateSlotConfig(REPO_CONFIG, 1), personal)).toEqual([]);\\n311:     expect(personalBlockProblems(generateSlotConfig(REPO_CONFIG, 2), personal)).toEqual([]);\\n312:   });\\n313: });\\n314: \\n315: describe('the identity overlay moves the identity and nothing else', () => {\\n316:   it('changes exactly the project id and the listener ports, byte for byte elsewhere', () => {\\n317:     const generated = generateSlotConfig(REPO_CONFIG, 1);\\n318:     const source = REPO_CONFIG.split('\\\\n');\\n319:     const slot = generated.split('\\\\n');\\n320:     expect(slot.length, 'the overlay changed the number of lines').toBe(source.length);\\n321: \\n322:     const changed = source.map((line, index) => (line === slot[index] ? -1 : index)).filter((index) => index >= 0);\\n323:     const { mappings } = portMappings(REPO_CONFIG, 1);\\n324:     expect(changed.length, 'the overlay changed lines that are not identity fields').toBe(mappings.length + 1);\\n325: \\n326:     for (const mapping of mappings) {\\n327:       expect(changed, `[${mapping.section}] ${mapping.key} was not rewritten`).toContain(mapping.line);\\n328:       expect(slot[mapping.line]).toContain(String(mapping.to));\\n329:     }\\n330:     expect(generated).toContain(`project_id = \\\"${slotProjectId(1)}\\\"`);\\n331:   });\\n332: \\n333:   it('maps an enabled smtp_port, passes a client port through, and refuses what it cannot place', () => {\\n334:     const withSmtp =\\n335:       'project_id = \\\"demo\\\"\\\\n[local_smtp]\\\\nport = 54324\\\\nsmtp_port = 54325\\\\n[auth.email.smtp]\\\\nport = 587\\\\nhost = \\\"smtp.example.com\\\"\\\\n';\\n336:     const mapped = portMappings(withSmtp, 1);\\n337:     expect(mapped.problems, 'a legitimate configuration was refused').toEqual([]);\\n338:     expect(mapped.mappings.map((m) => `${m.section}.${m.key}:${m.from}->${m.to}`)).toEqual([\\n339:       'local_smtp.port:54324->55324',\\n340:       'local_smtp.smtp_port:54325->55325',\\n341:     ]);\\n342:     // Ruling E4: a client-connection port is data. It is neither moved nor refused.\\n343:     expect(generateSlotConfig(withSmtp, 1)).toContain('port = 587');\\n344: \\n345:     const outOfBand = portMappings('project_id = \\\"demo\\\"\\\\n[api]\\\\nport = 9999\\\\n', 1);\\n346:     expect(outOfBand.problems.join(' '), 'a listener port outside the band was silently kept').toContain('does not know where to move it');\\n347: \\n348:     const strayLocal = portMappings('project_id = \\\"demo\\\"\\\\n[storage]\\\\nport = 54500\\\\n', 1);\\n349:     expect(strayLocal.problems.join(' '), 'an unrecognised port in the local band was treated as data').toContain('decide by hand');\\n350:   });\\n351: \\n352:   it('moves the ruled inspector port by ten and refuses to guess at any other (ruling T8)', () => {\\n353:     // 8083 is the RULED value, and +N*10 is the rule written for it. Applying that same arithmetic\\n354:     // to a value nobody ruled is a guess, and a guess about a port is a collision with software\\n355:     // nobody in this process knows about.\\n356:     const ruled = portMappings('project_id = \\\"demo\\\"\\\\n[edge_runtime]\\\\ninspector_port = 8083\\\\n', 1);\\n357:     expect(ruled.problems, 'the ruled inspector port was refused').toEqual([]);\\n358:     expect(ruled.mappings.map((m) => `${m.from}->${m.to}`)).toEqual(['8083->8093']);\\n359: \\n360:     const other = portMappings('project_id = \\\"demo\\\"\\\\n[edge_runtime]\\\\ninspector_port = 9229\\\\n', 1);\\n361:     expect(other.problems.join(' '), 'an unruled inspector port was moved by a guess').toContain('does not know where to move it');\\n362:     expect(other.mappings, 'an unruled inspector port was mapped anyway').toEqual([]);\\n363: \\n364:     // In the local stack's own band it is an ordinary listener again, and the generic rule places it.\\n365:     const inBand = portMappings('project_id = \\\"demo\\\"\\\\n[edge_runtime]\\\\ninspector_port = 54444\\\\n', 2);\\n366:     expect(inBand.problems).toEqual([]);\\n367:     expect(inBand.mappings.map((m) => `${m.from}->${m.to}`)).toEqual(['54444->56444']);\\n368:   });\\n369: });\\n370: \\n371: describe('the path closure fails closed on what it cannot deliver', () => {\\n372:   it('accepts this repository\\\\'s config as it stands', () => {\\n373:     expect(pathClosureProblems(REPO_CONFIG, REPO_ROOT)).toEqual([]);\\n374:   });\\n375: \\n376:   it('refuses a path key whose array does not close on the same line (ruling F5)', () => {\\n377:     // `scanConfig` reads one line per setting, so this value is `[` and no path is extracted. For\\n378:     // the overlay an unseen value is copied verbatim and is safe; for the closure it is a missed\\n379:     // refusal, which is the whole thing this check exists to prevent.\\n380:     const multiLine = 'project_id = \\\"demo\\\"\\\\n[db.seed]\\\\nsql_paths = [\\\\n  \\\"./seed.sql\\\"\\\\n]\\\\n';\\n381:     const problems = pathClosureProblems(multiLine, REPO_ROOT);\\n382:     expect(problems.join(' '), 'a value this check cannot see passed silently').toContain('does not close on the same line');\\n383:     expect(problems.join(' '), 'the refusal did not name the repair').toContain('write the value on one line');\\n384: \\n385:     // The same paths on one line are visible again, and are inside supabase/, so they pass.\\n386:     expect(pathClosureProblems('project_id = \\\"demo\\\"\\\\n[db.seed]\\\\nsql_paths = [\\\"./seed.sql\\\"]\\\\n', REPO_ROOT)).toEqual([]);\\n387:   });\\n388: \\n389:   it('refuses a path outside supabase/ and a path inside a directory the mirror excludes', () => {\\n390:     expect(pathClosureProblems('project_id = \\\"demo\\\"\\\\n[db.seed]\\\\nsql_paths = [\\\"../seed.sql\\\"]\\\\n', REPO_ROOT).join(' ')).toContain('outside supabase/');\\n391:     expect(pathClosureProblems('project_id = \\\"demo\\\"\\\\n[db.seed]\\\\nsql_paths = [\\\"/etc/seed.sql\\\"]\\\\n', REPO_ROOT).join(' ')).toContain('absolute path');\\n392:     expect(\\n393:       pathClosureProblems('project_id = \\\"demo\\\"\\\\n[db.seed]\\\\nsql_paths = [\\\"./.temp/seed.sql\\\"]\\\\n', REPO_ROOT).join(' '),\\n394:       'a path into the CLI runtime state the mirror leaves behind was accepted',\\n395:     ).toContain('supabase/.temp');\\n396:   });\\n397: });\\n398: \\n399: describe('the mirror carries the project source and nothing else', () => {\\n400:   it('leaves out the CLI runtime directories and the item tree config (rulings T3, F3, T11)', () => {\\n401:     const item = mkdtempSync(join(tmpdir(), 'at-item-tree-'));\\n402:     mkdirSync(join(item, 'supabase', 'migrations'), { recursive: true });\\n403:     mkdirSync(join(item, 'supabase', 'functions', 'hello'), { recursive: true });\\n404:     mkdirSync(join(item, 'supabase', '.temp', 'start-secrets'), { recursive: true });\\n405:     mkdirSync(join(item, 'supabase', '.branches'), { recursive: true });\\n406:     writeFileSync(join(item, 'supabase', 'config.toml'), 'project_id = \\\"the-personal-identity\\\"\\\\n', 'utf8');\\n407:     writeFileSync(join(item, 'supabase', 'migrations', '20260101000000_a.sql'), 'select 1;\\\\n', 'utf8');\\n408:     writeFileSync(join(item, 'supabase', 'functions', 'hello', 'index.ts'), 'export default 1;\\\\n', 'utf8');\\n409:     writeFileSync(join(item, 'supabase', '.temp', 'start-secrets', 'anon'), 'a secret\\\\n', 'utf8');\\n410:     writeFileSync(join(item, 'supabase', '.branches', '_current_branch'), 'main\\\\n', 'utf8');\\n411: \\n412:     try {\\n413:       mirrorItemTree(item, 1);\\n414:       const slot = join(slotDir(1), 'supabase');\\n415:       expect(existsSync(join(slot, 'migrations', '20260101000000_a.sql')), 'a migration did not reach the slot').toBe(true);\\n416:       expect(existsSync(join(slot, 'functions', 'hello', 'index.ts')), 'an edge function did not reach the slot').toBe(true);\\n417:       expect(existsSync(join(slot, 'config.toml')), 'the item tree config reached the slot, carrying the personal identity').toBe(false);\\n418:       expect(existsSync(join(slot, '.temp')), 'the CLI runtime state about another stack reached the slot').toBe(false);\\n419:       expect(existsSync(join(slot, '.branches')), 'the CLI branch state reached the slot').toBe(false);\\n420:     } finally {\\n421:       rmSync(item, { recursive: true, force: true });\\n422:       rmSync(join(slotDir(1), 'supabase'), { recursive: true, force: true });\\n423:     }\\n424:   });\\n425: \\n426:   it('refuses the whole mirror when a symlink sits under supabase/ (ruling T13)', () => {\\n427:     const item = mkdtempSync(join(tmpdir(), 'at-item-link-'));\\n428:     mkdirSync(join(item, 'supabase', 'migrations'), { recursive: true });\\n429:     mkdirSync(join(item, 'elsewhere'), { recursive: true });\\n430:     // A directory junction on Windows needs no privilege; on other systems this is a plain symlink.\\n431:     symlinkSync(join(item, 'elsewhere'), join(item, 'supabase', 'migrations', 'linked'), 'junction');\\n432: \\n433:     try {\\n434:       expect(() => mirrorItemTree(item, 1)).toThrow(/symlink/);\\n435:       expect(() => mirrorItemTree(item, 1)).toThrow(/Nothing was copied/);\\n436:     } finally {\\n437:       rmSync(item, { recursive: true, force: true });\\n438:       rmSync(join(slotDir(1), 'supabase'), { recursive: true, force: true });\\n439:     }\\n440:   });\\n441: });\\n442: \\n443: describe('the evidence names the slot it ran against', () => {\\n444:   it('carries the slot, the project id, the api port, the reset and the migration state', () => {\\n445:     const held = {\\n446:       slot: 2,\\n447:       dir: slotDir(2),\\n448:       config: { projectId: 'ai4good-slot-2', apiPort: 56321, dbPort: 56322 },\\n449:       item: 'AI4DEV-79',\\n450:       via: 'reservation',\\n451:       claim: { file: '', release: () => undefined },\\n452:       release: () => undefined,\\n453:     } as Occupancy;\\n454:     const result: PrepareResult = {\\n455:       status: {} as StackStatus,\\n456:       migrations: { expected: 2, applied: 2 },\\n457:       restarted: false,\\n458:     };\\n459: \\n460:     const line = evidence(held, result);\\n461:     expect(line).toContain('db slot 2');\\n462:     expect(line).toContain('ai4good-slot-2');\\n463:     expect(line).toContain('api 56321');\\n464:     expect(line).toContain('reset OK');\\n465:     expect(line).toContain('2 expected, 2 applied');\\n466:   });\\n467: });\\n\\n(End of file - total 467 lines)\\n</content>\",\"metadata\":{\"preview\":\"/**\\n * Tests OF the database slot pool, not tests run BY it.\\n *\\n * THEY RUN WITH NO DOCKER, NO STACK AND NO SLOT DIRECTORY ON THIS MACHINE, because CI runs them\\n * that way (no Docker step, either runner) and a test that quietly needs a live stack would be\\n * green on the dev machine and absent everywhere else. So the pool root is a temporary directory\\n * (`AT_DB_POOL_ROOT`), the claim directory is a temporary directory (`AT_LOCK_DIR`), and the only\\n * thing that is real is the claim protocol and the configuration arithmetic â€” which is exactly\\n * what these tests are about.\\n *\\n * WHAT THEY DO NOT CLAIM: nothing here proves the isolation wall. A Dockerless test cannot reset a\\n * database, so it cannot prove that a reset lands where it was aimed. That proof is the committed\\n * spike transcript, taken once on the dev machine against three real stacks.\\n */\\n\\nimport { spawn, spawnSync } from 'node:child_process';\\nimport { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, symlinkSync, writeFileSync } from 'node:fs';\\nimport { tmpdir } from 'node:os';\\nimport { join } from 'node:path';\\nimport { afterAll, beforeAll, describe, expect, it, vi } from 'vitest';\",\"truncated\":false,\"loaded\":[],\"display\":{\"type\":\"file\",\"path\":\"C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\db-pool.selftest.ts\",\"text\":\"/**\\n * Tests OF the database slot pool, not tests run BY it.\\n *\\n * THEY RUN WITH NO DOCKER, NO STACK AND NO SLOT DIRECTORY ON THIS MACHINE, because CI runs them\\n * that way (no Docker step, either runner) and a test that quietly needs a live stack would be\\n * green on the dev machine and absent everywhere else. So the pool root is a temporary directory\\n * (`AT_DB_POOL_ROOT`), the claim directory is a temporary directory (`AT_LOCK_DIR`), and the only\\n * thing that is real is the claim protocol and the configuration arithmetic â€” which is exactly\\n * what these tests are about.\\n *\\n * WHAT THEY DO NOT CLAIM: nothing here proves the isolation wall. A Dockerless test cannot reset a\\n * database, so it cannot prove that a reset lands where it was aimed. That proof is the committed\\n * spike transcript, taken once on the dev machine against three real stacks.\\n */\\n\\nimport { spawn, spawnSync } from 'node:child_process';\\nimport { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, symlinkSync, writeFileSync } from 'node:fs';\\nimport { tmpdir } from 'node:os';\\nimport { join } from 'node:path';\\nimport { afterAll, beforeAll, describe, expect, it, vi } from 'vitest';\\n\\nimport { REPO_ROOT } from './check.ts';\\nimport { bunExecutable, stackLockPath, type StackStatus } from './runner.ts';\\nimport {\\n  evidence,\\n  generateSlotConfig,\\n  itemFromBranch,\\n  mirrorItemTree,\\n  occupy,\\n  pathClosureProblems,\\n  personalBlockProblems,\\n  portMappings,\\n  release,\\n  reservationPath,\\n  slotClaimKey,\\n  slotConfigPath,\\n  slotDir,\\n  slotProjectId,\\n  type Occupancy,\\n  type PrepareResult,\\n} from './db-pool.ts';\\n\\nconst REPO_CONFIG = readFileSync(join(REPO_ROOT, 'supabase', 'config.toml'), 'utf8');\\n\\nlet poolTemp = '';\\nlet lockTemp = '';\\nlet previousPool: string | undefined;\\nlet previousLocks: string | undefined;\\n\\n/** Write a slot's `config.toml` into the temporary pool, exactly as `setup` would. */\\nfunction installSlot(slot: number): void {\\n  mkdirSync(join(slotDir(slot), 'supabase'), { recursive: true });\\n  writeFileSync(slotConfigPath(slot), generateSlotConfig(REPO_CONFIG, slot), 'utf8');\\n}\\n\\n/**\\n * Where the occupancy claim for a slot lives.\\n *\\n * IT IS DERIVED FROM THE SLOT NUMBER, never from the slot's current config (ruling T6). A test that\\n * read the config for the api port would be asserting against a name `prepare` is allowed to move,\\n * and would keep passing while the two runs it is meant to serialize held different files.\\n */\\nfunction claimPath(slot: number): string {\\n  return stackLockPath(slotClaimKey(slot));\\n}\\n\\n/** A process id that is PROVABLY dead: a real child, started, waited for, and gone (ruling F9). */\\nfunction deadPid(): number {\\n  const child = spawnSync(bunExecutable(), ['--no-env-file', '-e', 'process.exit(0)'], { encoding: 'utf8' });\\n  expect(typeof child.pid, 'the probe child reported no process id, so nothing provably dead exists to plant').toBe('number');\\n  return child.pid as number;\\n}\\n\\nfunction writeReservation(slot: number, item: string): void {\\n  mkdirSync(join(poolTemp, 'reservations'), { recursive: true });\\n  writeFileSync(\\n    reservationPath(slot),\\n    JSON.stringify({ slot, item, branch: 'test', at: new Date().toISOString(), holder: 'selftest' }),\\n    'utf8',\\n  );\\n}\\n\\nfunction plantClaim(slot: number, holder: Record<string, unknown>): void {\\n  writeFileSync(claimPath(slot), JSON.stringify(holder), 'utf8');\\n}\\n\\n/** A claim file exactly as it looks mid-write, or after a crash: present, and saying nothing. */\\nfunction plantRawClaim(slot: number, text: string): void {\\n  writeFileSync(claimPath(slot), text, 'utf8');\\n}\\n\\nfunction scrubClaim(slot: number): void {\\n  rmSync(claimPath(slot), { force: true });\\n}\\n\\nbeforeAll(() => {\\n  previousPool = process.env.AT_DB_POOL_ROOT;\\n  previousLocks = process.env.AT_LOCK_DIR;\\n  poolTemp = mkdtempSync(join(tmpdir(), 'at-db-pool-'));\\n  lockTemp = mkdtempSync(join(tmpdir(), 'at-db-locks-'));\\n  process.env.AT_DB_POOL_ROOT = poolTemp;\\n  process.env.AT_LOCK_DIR = lockTemp;\\n});\\n\\nafterAll(() => {\\n  if (previousPool === undefined) delete process.env.AT_DB_POOL_ROOT;\\n  else process.env.AT_DB_POOL_ROOT = previousPool;\\n  if (previousLocks === undefined) delete process.env.AT_LOCK_DIR;\\n  else process.env.AT_LOCK_DIR = previousLocks;\\n  rmSync(poolTemp, { recursive: true, force: true });\\n  rmSync(lockTemp, { recursive: true, force: true });\\n});\\n\\ndescribe('one slot has exactly one occupier', () => {\\n  it('two concurrent occupies on one slot end with exactly one winner', async () => {\\n    installSlot(1);\\n    const moduleUrl = new URL('./db-pool.ts', import.meta.url).href;\\n    const startAt = Date.now() + 800;\\n\\n    const contender = (): Promise<string> => {\\n      const code =\\n        `const { occupy } = await import(${JSON.stringify(moduleUrl)});\\\\n` +\\n        `while (Date.now() < ${startAt}) {}\\\\n` + // a barrier, so both attempt at the same instant\\n        `try {\\\\n` +\\n        `  const held = occupy('req-000', { slot: 1 });\\\\n` +\\n        `  console.log('ACQUIRED');\\\\n` +\\n        `  await Bun.sleep(600);\\\\n` + // hold it, so the loser meets a LIVE holder\\n        `  held.release();\\\\n` +\\n        `} catch { console.log('REFUSED'); }\\\\n`;\\n      // spawn, NOT spawnSync: a synchronous spawn would run the contenders one after the other,\\n      // and the second would find the claim already released â€” a race that never raced.\\n      return new Promise<string>((resolve) => {\\n        const child = spawn(bunExecutable(), ['--no-env-file', '-e', code], {\\n          env: { ...process.env, AT_DB_POOL_ROOT: poolTemp, AT_LOCK_DIR: lockTemp } as NodeJS.ProcessEnv,\\n          stdio: ['ignore', 'pipe', 'pipe'],\\n        });\\n        let out = '';\\n        child.stdout.on('data', (chunk: Buffer) => (out += chunk.toString('utf8')));\\n        child.stderr.on('data', (chunk: Buffer) => (out += chunk.toString('utf8')));\\n        child.once('error', (err) => resolve(`ERROR ${err.message}`));\\n        child.once('close', () => resolve(out));\\n      });\\n    };\\n\\n    const [a, b] = await Promise.all([contender(), contender()]);\\n    const outcomes = [a, b].map((out) => (out.includes('ACQUIRED') ? 'ACQUIRED' : out.includes('REFUSED') ? 'REFUSED' : `UNKNOWN(${out.trim()})`));\\n\\n    try {\\n      expect(outcomes.filter((o) => o === 'ACQUIRED'), `outcomes were ${JSON.stringify(outcomes)}`).toHaveLength(1);\\n      expect(outcomes.filter((o) => o === 'REFUSED'), `outcomes were ${JSON.stringify(outcomes)}`).toHaveLength(1);\\n      expect(existsSync(claimPath(1)), 'the winner did not release its claim').toBe(false);\\n    } finally {\\n      scrubClaim(1);\\n    }\\n  }, 60_000);\\n\\n  it('breaks a dead holder LOUDLY and records the takeover in the new claim', () => {\\n    installSlot(1);\\n    // A REAL process id, from a child that has already exited (ruling F9). A made-up large number\\n    // is only ASSUMED dead, and a busy machine can legitimately be holding it â€” which would make\\n    // the one test that guards the takeover rule fail for a reason that has nothing to do with it.\\n    const gone = deadPid();\\n    plantClaim(1, { pid: gone, host: 'gone', requirement: 'req-000', startedAt: new Date().toISOString() });\\n    const said = vi.spyOn(console, 'log').mockImplementation(() => undefined);\\n    try {\\n      const held = occupy('req-016', { slot: 1 });\\n      const claim = JSON.parse(readFileSync(held.claim.file, 'utf8')) as {\\n        pid?: number;\\n        tookOverFrom?: { pid?: number; requirement?: string };\\n      };\\n      expect(claim.pid, 'the takeover did not record this process as the holder').toBe(process.pid);\\n      expect(claim.tookOverFrom?.pid, 'the displaced holder was not recorded IN the claim').toBe(gone);\\n      expect(claim.tookOverFrom?.requirement).toBe('req-000');\\n      expect(said.mock.calls.flat().join(' '), 'the takeover was silent').toContain('took over a stale stack lock');\\n      held.release();\\n    } finally {\\n      said.mockRestore();\\n      scrubClaim(1);\\n    }\\n  });\\n\\n  it('never takes over a LIVE holder, at any age, and names it', () => {\\n    installSlot(1);\\n    // Alive (this very process) and old enough that the runner's own stale window would displace\\n    // it. The pool passes dead-pid-only, so it must not.\\n    plantClaim(1, {\\n      pid: process.pid,\\n      host: 'here',\\n      requirement: 'req-000',\\n      startedAt: new Date(Date.now() - 48 * 60 * 60 * 1000).toISOString(),\\n    });\\n    try {\\n      expect(() => occupy('req-016', { slot: 1 })).toThrow(new RegExp(`another at:verify run holds this stack \\\\\\\\(pid ${process.pid}`));\\n    } finally {\\n      scrubClaim(1);\\n    }\\n  });\\n\\n  it('never takes over a claim file it cannot identify, and names the file (ruling T1)', () => {\\n    installSlot(1);\\n    // AN EMPTY FILE IS WHAT A LIVE CLAIM LOOKS LIKE MID-WRITE. The exclusive create and the write\\n    // that fills it are two acts, and between them the file exists and says nothing. Under\\n    // dead-pid-only that must NEVER read as a dead holder: taking it over would delete a live\\n    // run's brand-new claim, which is the one thing this policy exists to make impossible.\\n    for (const planted of ['', '   \\\\n', '{\\\"pid\\\":', 'not json at all']) {\\n      plantRawClaim(1, planted);\\n      try {\\n        expect(() => occupy('req-016', { slot: 1 }), `a claim file containing ${JSON.stringify(planted)} was taken over`).toThrow(\\n          /names no process id that this run can read/,\\n        );\\n        expect(() => occupy('req-016', { slot: 1 })).toThrow(claimPath(1));\\n        expect(existsSync(claimPath(1)), 'the refusal deleted the file it could not identify').toBe(true);\\n      } finally {\\n        scrubClaim(1);\\n      }\\n    }\\n  }, 30_000);\\n\\n  it('releases from a `finally` when the caller throws', () => {\\n    installSlot(1);\\n    let held: Occupancy | null = null;\\n    expect(() => {\\n      try {\\n        held = occupy('req-016', { slot: 1 });\\n        throw new Error('the suite blew up');\\n      } finally {\\n        release(held);\\n      }\\n    }).toThrow('the suite blew up');\\n    expect(existsSync(claimPath(1)), 'a throwing caller stranded the occupancy claim').toBe(false);\\n  });\\n});\\n\\ndescribe('admission control belongs to the coordinator, not to the run', () => {\\n  it('refuses a run whose item holds no reservation, and names the helper that makes one', () => {\\n    rmSync(reservationPath(1), { force: true });\\n    rmSync(reservationPath(2), { force: true });\\n    expect(() => occupy('req-016', { item: 'AI4DEV-999' })).toThrow(/Reserve-DbSlot -Item AI4DEV-999/);\\n    expect(() => occupy('req-016', { item: 'AI4DEV-999' })).toThrow(/no fallback onto a free slot/);\\n  });\\n\\n  it('finds the slot the reservation names', () => {\\n    installSlot(2);\\n    writeReservation(2, 'AI4DEV-79');\\n    try {\\n      const held = occupy('req-016', { item: 'AI4DEV-79' });\\n      expect(held.slot).toBe(2);\\n      expect(held.via).toBe('reservation');\\n      held.release();\\n    } finally {\\n      rmSync(reservationPath(2), { force: true });\\n      scrubClaim(2);\\n    }\\n  });\\n\\n  it('refuses an AT_DB_SLOT run aimed at a slot another item holds (ruling T5)', () => {\\n    installSlot(2);\\n    writeReservation(2, 'AI4DEV-900');\\n    try {\\n      expect(() => occupy('req-016', { slot: 2, item: 'AI4DEV-79' })).toThrow(/reserved for AI4DEV-900/);\\n      expect(existsSync(claimPath(2)), 'the refusal still took the claim').toBe(false);\\n    } finally {\\n      rmSync(reservationPath(2), { force: true });\\n      scrubClaim(2);\\n    }\\n  });\\n\\n  it('lets an AT_DB_SLOT run take a slot reserved for its OWN item', () => {\\n    installSlot(2);\\n    writeReservation(2, 'AI4DEV-79');\\n    try {\\n      const held = occupy('req-016', { slot: 2, item: 'AI4DEV-79' });\\n      expect(held.via).toBe('override');\\n      expect(held.slot).toBe(2);\\n      held.release();\\n    } finally {\\n      rmSync(reservationPath(2), { force: true });\\n      scrubClaim(2);\\n    }\\n  });\\n});\\n\\ndescribe('the branch parser fails closed', () => {\\n  it('accepts exactly one item id', () => {\\n    expect(itemFromBranch('nirdrang/ai4dev-79-a-pool-of-local-database-slots')).toBe('AI4DEV-79');\\n    expect(itemFromBranch('feature/AI4PM-19-auth')).toBe('AI4PM-19');\\n  });\\n\\n  it('refuses zero ids, several ids, an empty name and a detached HEAD', () => {\\n    expect(() => itemFromBranch('main')).toThrow(/names no item id/);\\n    expect(() => itemFromBranch('nirdrang/ai4dev-79-and-ai4dev-80')).toThrow(/names 2 item ids/);\\n    expect(() => itemFromBranch('')).toThrow(/branch name is empty/);\\n    expect(() => itemFromBranch('HEAD')).toThrow(/HEAD is detached/);\\n  });\\n});\\n\\ndescribe('the personal stack is refused in code', () => {\\n  it('refuses the repo project id and any port in the personal block', () => {\\n    const personal = /project_id\\\\s*=\\\\s*\\\"([^\\\"]+)\\\"/.exec(REPO_CONFIG)?.[1] ?? '';\\n    expect(personal, 'the repository config carries no project_id to test against').not.toBe('');\\n\\n    const problems = personalBlockProblems(REPO_CONFIG, personal);\\n    expect(problems.join(' '), 'the repo config was not recognised as the personal identity').toContain(`project id \\\"${personal}\\\"`);\\n    expect(problems.join(' '), 'a 54321-block port was not refused').toMatch(/is inside the personal stack's port block/);\\n    expect(problems.join(' '), 'the personal inspector port was not refused').toContain('inspector_port');\\n  });\\n\\n  it('accepts a generated slot config, which is the same file wearing a slot identity', () => {\\n    const personal = /project_id\\\\s*=\\\\s*\\\"([^\\\"]+)\\\"/.exec(REPO_CONFIG)?.[1] ?? '';\\n    expect(personalBlockProblems(generateSlotConfig(REPO_CONFIG, 1), personal)).toEqual([]);\\n    expect(personalBlockProblems(generateSlotConfig(REPO_CONFIG, 2), personal)).toEqual([]);\\n  });\\n});\\n\\ndescribe('the identity overlay moves the identity and nothing else', () => {\\n  it('changes exactly the project id and the listener ports, byte for byte elsewhere', () => {\\n    const generated = generateSlotConfig(REPO_CONFIG, 1);\\n    const source = REPO_CONFIG.split('\\\\n');\\n    const slot = generated.split('\\\\n');\\n    expect(slot.length, 'the overlay changed the number of lines').toBe(source.length);\\n\\n    const changed = source.map((line, index) => (line === slot[index] ? -1 : index)).filter((index) => index >= 0);\\n    const { mappings } = portMappings(REPO_CONFIG, 1);\\n    expect(changed.length, 'the overlay changed lines that are not identity fields').toBe(mappings.length + 1);\\n\\n    for (const mapping of mappings) {\\n      expect(changed, `[${mapping.section}] ${mapping.key} was not rewritten`).toContain(mapping.line);\\n      expect(slot[mapping.line]).toContain(String(mapping.to));\\n    }\\n    expect(generated).toContain(`project_id = \\\"${slotProjectId(1)}\\\"`);\\n  });\\n\\n  it('maps an enabled smtp_port, passes a client port through, and refuses what it cannot place', () => {\\n    const withSmtp =\\n      'project_id = \\\"demo\\\"\\\\n[local_smtp]\\\\nport = 54324\\\\nsmtp_port = 54325\\\\n[auth.email.smtp]\\\\nport = 587\\\\nhost = \\\"smtp.example.com\\\"\\\\n';\\n    const mapped = portMappings(withSmtp, 1);\\n    expect(mapped.problems, 'a legitimate configuration was refused').toEqual([]);\\n    expect(mapped.mappings.map((m) => `${m.section}.${m.key}:${m.from}->${m.to}`)).toEqual([\\n      'local_smtp.port:54324->55324',\\n      'local_smtp.smtp_port:54325->55325',\\n    ]);\\n    // Ruling E4: a client-connection port is data. It is neither moved nor refused.\\n    expect(generateSlotConfig(withSmtp, 1)).toContain('port = 587');\\n\\n    const outOfBand = portMappings('project_id = \\\"demo\\\"\\\\n[api]\\\\nport = 9999\\\\n', 1);\\n    expect(outOfBand.problems.join(' '), 'a listener port outside the band was silently kept').toContain('does not know where to move it');\\n\\n    const strayLocal = portMappings('project_id = \\\"demo\\\"\\\\n[storage]\\\\nport = 54500\\\\n', 1);\\n    expect(strayLocal.problems.join(' '), 'an unrecognised port in the local band was treated as data').toContain('decide by hand');\\n  });\\n\\n  it('moves the ruled inspector port by ten and refuses to guess at any other (ruling T8)', () => {\\n    // 8083 is the RULED value, and +N*10 is the rule written for it. Applying that same arithmetic\\n    // to a value nobody ruled is a guess, and a guess about a port is a collision with software\\n    // nobody in this process knows about.\\n    const ruled = portMappings('project_id = \\\"demo\\\"\\\\n[edge_runtime]\\\\ninspector_port = 8083\\\\n', 1);\\n    expect(ruled.problems, 'the ruled inspector port was refused').toEqual([]);\\n    expect(ruled.mappings.map((m) => `${m.from}->${m.to}`)).toEqual(['8083->8093']);\\n\\n    const other = portMappings('project_id = \\\"demo\\\"\\\\n[edge_runtime]\\\\ninspector_port = 9229\\\\n', 1);\\n    expect(other.problems.join(' '), 'an unruled inspector port was moved by a guess').toContain('does not know where to move it');\\n    expect(other.mappings, 'an unruled inspector port was mapped anyway').toEqual([]);\\n\\n    // In the local stack's own band it is an ordinary listener again, and the generic rule places it.\\n    const inBand = portMappings('project_id = \\\"demo\\\"\\\\n[edge_runtime]\\\\ninspector_port = 54444\\\\n', 2);\\n    expect(inBand.problems).toEqual([]);\\n    expect(inBand.mappings.map((m) => `${m.from}->${m.to}`)).toEqual(['54444->56444']);\\n  });\\n});\\n\\ndescribe('the path closure fails closed on what it cannot deliver', () => {\\n  it('accepts this repository\\\\'s config as it stands', () => {\\n    expect(pathClosureProblems(REPO_CONFIG, REPO_ROOT)).toEqual([]);\\n  });\\n\\n  it('refuses a path key whose array does not close on the same line (ruling F5)', () => {\\n    // `scanConfig` reads one line per setting, so this value is `[` and no path is extracted. For\\n    // the overlay an unseen value is copied verbatim and is safe; for the closure it is a missed\\n    // refusal, which is the whole thing this check exists to prevent.\\n    const multiLine = 'project_id = \\\"demo\\\"\\\\n[db.seed]\\\\nsql_paths = [\\\\n  \\\"./seed.sql\\\"\\\\n]\\\\n';\\n    const problems = pathClosureProblems(multiLine, REPO_ROOT);\\n    expect(problems.join(' '), 'a value this check cannot see passed silently').toContain('does not close on the same line');\\n    expect(problems.join(' '), 'the refusal did not name the repair').toContain('write the value on one line');\\n\\n    // The same paths on one line are visible again, and are inside supabase/, so they pass.\\n    expect(pathClosureProblems('project_id = \\\"demo\\\"\\\\n[db.seed]\\\\nsql_paths = [\\\"./seed.sql\\\"]\\\\n', REPO_ROOT)).toEqual([]);\\n  });\\n\\n  it('refuses a path outside supabase/ and a path inside a directory the mirror excludes', () => {\\n    expect(pathClosureProblems('project_id = \\\"demo\\\"\\\\n[db.seed]\\\\nsql_paths = [\\\"../seed.sql\\\"]\\\\n', REPO_ROOT).join(' ')).toContain('outside supabase/');\\n    expect(pathClosureProblems('project_id = \\\"demo\\\"\\\\n[db.seed]\\\\nsql_paths = [\\\"/etc/seed.sql\\\"]\\\\n', REPO_ROOT).join(' ')).toContain('absolute path');\\n    expect(\\n      pathClosureProblems('project_id = \\\"demo\\\"\\\\n[db.seed]\\\\nsql_paths = [\\\"./.temp/seed.sql\\\"]\\\\n', REPO_ROOT).join(' '),\\n      'a path into the CLI runtime state the mirror leaves behind was accepted',\\n    ).toContain('supabase/.temp');\\n  });\\n});\\n\\ndescribe('the mirror carries the project source and nothing else', () => {\\n  it('leaves out the CLI runtime directories and the item tree config (rulings T3, F3, T11)', () => {\\n    const item = mkdtempSync(join(tmpdir(), 'at-item-tree-'));\\n    mkdirSync(join(item, 'supabase', 'migrations'), { recursive: true });\\n    mkdirSync(join(item, 'supabase', 'functions', 'hello'), { recursive: true });\\n    mkdirSync(join(item, 'supabase', '.temp', 'start-secrets'), { recursive: true });\\n    mkdirSync(join(item, 'supabase', '.branches'), { recursive: true });\\n    writeFileSync(join(item, 'supabase', 'config.toml'), 'project_id = \\\"the-personal-identity\\\"\\\\n', 'utf8');\\n    writeFileSync(join(item, 'supabase', 'migrations', '20260101000000_a.sql'), 'select 1;\\\\n', 'utf8');\\n    writeFileSync(join(item, 'supabase', 'functions', 'hello', 'index.ts'), 'export default 1;\\\\n', 'utf8');\\n    writeFileSync(join(item, 'supabase', '.temp', 'start-secrets', 'anon'), 'a secret\\\\n', 'utf8');\\n    writeFileSync(join(item, 'supabase', '.branches', '_current_branch'), 'main\\\\n', 'utf8');\\n\\n    try {\\n      mirrorItemTree(item, 1);\\n      const slot = join(slotDir(1), 'supabase');\\n      expect(existsSync(join(slot, 'migrations', '20260101000000_a.sql')), 'a migration did not reach the slot').toBe(true);\\n      expect(existsSync(join(slot, 'functions', 'hello', 'index.ts')), 'an edge function did not reach the slot').toBe(true);\\n      expect(existsSync(join(slot, 'config.toml')), 'the item tree config reached the slot, carrying the personal identity').toBe(false);\\n      expect(existsSync(join(slot, '.temp')), 'the CLI runtime state about another stack reached the slot').toBe(false);\\n      expect(existsSync(join(slot, '.branches')), 'the CLI branch state reached the slot').toBe(false);\\n    } finally {\\n      rmSync(item, { recursive: true, force: true });\\n      rmSync(join(slotDir(1), 'supabase'), { recursive: true, force: true });\\n    }\\n  });\\n\\n  it('refuses the whole mirror when a symlink sits under supabase/ (ruling T13)', () => {\\n    const item = mkdtempSync(join(tmpdir(), 'at-item-link-'));\\n    mkdirSync(join(item, 'supabase', 'migrations'), { recursive: true });\\n    mkdirSync(join(item, 'elsewhere'), { recursive: true });\\n    // A directory junction on Windows needs no privilege; on other systems this is a plain symlink.\\n    symlinkSync(join(item, 'elsewhere'), join(item, 'supabase', 'migrations', 'linked'), 'junction');\\n\\n    try {\\n      expect(() => mirrorItemTree(item, 1)).toThrow(/symlink/);\\n      expect(() => mirrorItemTree(item, 1)).toThrow(/Nothing was copied/);\\n    } finally {\\n      rmSync(item, { recursive: true, force: true });\\n      rmSync(join(slotDir(1), 'supabase'), { recursive: true, force: true });\\n    }\\n  });\\n});\\n\\ndescribe('the evidence names the slot it ran against', () => {\\n  it('carries the slot, the project id, the api port, the reset and the migration state', () => {\\n    const held = {\\n      slot: 2,\\n      dir: slotDir(2),\\n      config: { projectId: 'ai4good-slot-2', apiPort: 56321, dbPort: 56322 },\\n      item: 'AI4DEV-79',\\n      via: 'reservation',\\n      claim: { file: '', release: () => undefined },\\n      release: () => undefined,\\n    } as Occupancy;\\n    const result: PrepareResult = {\\n      status: {} as StackStatus,\\n      migrations: { expected: 2, applied: 2 },\\n      restarted: false,\\n    };\\n\\n    const line = evidence(held, result);\\n    expect(line).toContain('db slot 2');\\n    expect(line).toContain('ai4good-slot-2');\\n    expect(line).toContain('api 56321');\\n    expect(line).toContain('reset OK');\\n    expect(line).toContain('2 expected, 2 applied');\\n  });\\n});\",\"lineStart\":1,\"lineEnd\":467,\"totalLines\":467,\"truncated\":false}},\"title\":\"tests\\\\at\\\\harness\\\\db-pool.selftest.ts\",\"time\":{\"start\":1786349897696,\"end\":1786349897719}},\"id\":\"prt_feac046ef001X5oMXwATPr1MfT\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"messageID\":\"msg_feabff3b8001bLuMZ9f58S189R\"}}\r\n+{\"type\":\"text\",\"timestamp\":1786349897768,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feac04612001t5kNoTszpfSWIy\",\"messageID\":\"msg_feabff3b8001bLuMZ9f58S189R\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"type\":\"text\",\"text\":\"The runner seam and lock look right so far. Now the selftest and the PowerShell helpers.\",\"time\":{\"start\":1786349897234,\"end\":1786349897765}}}\r\n+{\"type\":\"step_finish\",\"timestamp\":1786349898180,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feac049b600166ciz1dIvCn8tm\",\"reason\":\"tool-calls\",\"snapshot\":\"bf0a88dd6bcb2268676b839763610545c2986225\",\"messageID\":\"msg_feabff3b8001bLuMZ9f58S189R\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"type\":\"step-finish\",\"tokens\":{\"total\":78033,\"input\":2720,\"output\":109,\"reasoning\":836,\"cache\":{\"write\":0,\"read\":74368}},\"cost\":0.0004268152}}\r\n+{\"type\":\"step_start\",\"timestamp\":1786349900233,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feac051c7001IR4eqhBLTFwZMM\",\"messageID\":\"msg_feac04b80001PC4AFK3cW6EF3F\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"snapshot\":\"b4253cdce748ea8cef6229f1c0c049a17c65b797\",\"type\":\"step-start\"}}\r\n+{\"type\":\"tool_use\",\"timestamp\":1786349903141,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"type\":\"tool\",\"tool\":\"read\",\"callID\":\"call_00_MqTHW9kFMHxHkDzxLPlR9748\",\"state\":{\"status\":\"completed\",\"input\":{\"filePath\":\"C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\loop\\\\work\\\\db-slots.ps1\"},\"output\":\"<path>C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\loop\\\\work\\\\db-slots.ps1</path>\\n<type>file</type>\\n<content>\\n1: # db-slots.ps1 - the coordinator's half of the local database slot pool (ASCII-only; PowerShell 5.1).\\n2: #\\n3: # A slot is one standing local Supabase stack. There are two of them, so two items can verify at\\n4: # the same time without resetting each other's database. The pool has two states and three owners:\\n5: #\\n6: #   RESERVED  - the coordinator takes a slot when an item starts. That is ADMISSION CONTROL: a full\\n7: #               pool means the next database-needing item is REJECTED at start, never queued.\\n8: #   OCCUPIED  - the harness runner takes the slot for each verify window, and releases it in a\\n9: #               finally. That claim is written by tests/at/harness/db-pool.ts, not by this file.\\n10: #   released  - the coordinator deletes the reservation at the item sweep.\\n11: #\\n12: # THIS FILE DOES FILE OPERATIONS ONLY - reserve, release, list. It reads no config.toml and writes\\n13: # no config.toml. All TOML lives in tests/at/harness/db-pool.ts, because two rules for one identity\\n14: # is how a slot ends up on a personal port.\\n15: \\n16: $ErrorActionPreference = 'Stop'\\n17: \\n18: $script:DbSlotPoolSize = 2\\n19: \\n20: # THE SAME BASE-RESOLUTION CHAIN AS THE HARNESS, all three steps of it: LOCALAPPDATA, then\\n21: # XDG_CACHE_HOME, then the system temp path. The harness resolves it that way (poolRoot and\\n22: # lockDir in tests/at/harness/), and two resolution rules for one pool is how the two halves stop\\n23: # seeing each other's files - this side would write a reservation the runner never reads.\\n24: function Get-DbSlotBaseDir([string]$leaf) {\\n25:     if ($env:LOCALAPPDATA) { $base = $env:LOCALAPPDATA }\\n26:     elseif ($env:XDG_CACHE_HOME) { $base = $env:XDG_CACHE_HOME }\\n27:     else { $base = [System.IO.Path]::GetTempPath() }\\n28:     return (Join-Path $base ('ai4good-build\\\\' + $leaf))\\n29: }\\n30: \\n31: # The pool lives beside the claims it cooperates with and outside every worktree.\\n32: # AT_DB_POOL_ROOT overrides it, for tests only.\\n33: function Get-DbSlotPoolRoot {\\n34:     if ($env:AT_DB_POOL_ROOT) { $root = $env:AT_DB_POOL_ROOT }\\n35:     else { $root = Get-DbSlotBaseDir 'db-slots' }\\n36:     if (-not (Test-Path $root)) { New-Item -ItemType Directory -Force $root | Out-Null }\\n37:     return $root\\n38: }\\n39: \\n40: function Get-DbSlotReservationDir {\\n41:     $d = Join-Path (Get-DbSlotPoolRoot) 'reservations'\\n42:     if (-not (Test-Path $d)) { New-Item -ItemType Directory -Force $d | Out-Null }\\n43:     return $d\\n44: }\\n45: \\n46: function Get-DbSlotReservationPath([int]$slot) {\\n47:     return Join-Path (Get-DbSlotReservationDir) ('slot-' + $slot + '.json')\\n48: }\\n49: \\n50: # Where the harness runner writes its occupancy claims. Same chain, same override, same reason.\\n51: function Get-DbSlotClaimDir {\\n52:     if ($env:AT_LOCK_DIR) { $d = $env:AT_LOCK_DIR }\\n53:     else { $d = Get-DbSlotBaseDir 'at-locks' }\\n54:     if (-not (Test-Path $d)) { New-Item -ItemType Directory -Force $d | Out-Null }\\n55:     return $d\\n56: }\\n57: \\n58: function Test-DbSlotItemId([string]$item) {\\n59:     return ($item -match '^(AI4DEV|AI4PM)-[0-9]+$')\\n60: }\\n61: \\n62: function Read-DbSlotReservation([int]$slot) {\\n63:     $p = Get-DbSlotReservationPath $slot\\n64:     if (-not (Test-Path $p)) { return $null }\\n65:     try { return (Get-Content $p -Raw | ConvertFrom-Json) } catch { return $null }\\n66: }\\n67: \\n68: # THE SAME READ, BUT IT WAITS OUT THE WRITE WINDOW.\\n69: #\\n70: # NOT RULED BY GATE 2. Ruling T10 asks the create-failure path in Reserve-DbSlot to re-read the\\n71: # reservation; measurement showed that re-read cannot see the winner's file, so the ruled fix alone\\n72: # left the defect open. This function and the block that calls it are the executor's completion of\\n73: # T10 and need the orchestrator's ratification. Reverting this one commit restores exactly the\\n74: # ruled text.\\n75: #\\n76: # THE MEASUREMENT, on this machine, 2026-08-10. A reservation file is created EXCLUSIVELY and\\n77: # filled a moment later. Between those two acts the file EXISTS and cannot be read at all: the\\n78: # creating handle holds it with no sharing, so a second reader gets a sharing violation, not an\\n79: # empty file. The loser of the race is inside that window by definition - it lost by microseconds.\\n80: # With the plain read above, five races out of five ended with one item holding BOTH slots; with\\n81: # this read, eight races out of eight ended with one item holding exactly one slot and the loser\\n82: # correctly told it already held it.\\n83: #\\n84: # One second of retries is thousands of times the window. It is the same remedy ruling T1 applies\\n85: # to the same window shape in the harness's own claim files.\\n86: function Read-DbSlotReservationWait([int]$slot) {\\n87:     $p = Get-DbSlotReservationPath $slot\\n88:     for ($try = 0; $try -lt 40; $try++) {\\n89:         if (-not (Test-Path $p)) { return $null }\\n90:         $raw = $null\\n91:         try { $raw = Get-Content $p -Raw -ErrorAction Stop } catch { $raw = $null }\\n92:         if ($raw -and $raw.Trim()) {\\n93:             try { return ($raw | ConvertFrom-Json) } catch { }\\n94:         }\\n95:         Start-Sleep -Milliseconds 25\\n96:     }\\n97:     return $null\\n98: }\\n99: \\n100: # The occupancy claim the harness writes, if one exists and its holder is still alive.\\n101: #\\n102: # The claim file name carries the slot's api port, which this file deliberately does not know - it\\n103: # reads no config.toml - so the lookup is a glob on the project id. A claim whose pid is gone is\\n104: # STALE, not live: the run that wrote it died, and the harness itself would take it over.\\n105: function Get-DbSlotOccupancy([int]$slot) {\\n106:     $pattern = 'at-verify-ai4good-slot-' + $slot + '-*.lock'\\n107:     $files = @(Get-ChildItem -Path (Get-DbSlotClaimDir) -Filter $pattern -File -ErrorAction SilentlyContinue)\\n108:     foreach ($f in $files) {\\n109:         $holder = $null\\n110:         try { $holder = (Get-Content $f.FullName -Raw | ConvertFrom-Json) } catch { $holder = $null }\\n111:         if (-not $holder) { continue }\\n112:         # NOT-FOUND MEANS DEAD; EVERY OTHER FAILURE MEANS ALIVE. Get-Process reports one specific\\n113:         # error when no process holds that id, and it can fail for other reasons - a process owned\\n114:         # by another user, for one. The harness's own liveness test treats a permission error as\\n115:         # ALIVE, and it has to: an occupancy misread as dead lets Release-DbSlot hand the slot away\\n116:         # under a running verify window. Fail closed, exactly as the harness does.\\n117:         $alive = $false\\n118:         if ($holder.pid) {\\n119:             try {\\n120:                 Get-Process -Id ([int]$holder.pid) -ErrorAction Stop | Out-Null\\n121:                 $alive = $true\\n122:             } catch {\\n123:                 if ($_.FullyQualifiedErrorId -like 'NoProcessFoundForGivenId*') { $alive = $false } else { $alive = $true }\\n124:             }\\n125:         }\\n126:         if ($alive) {\\n127:             return @{ file = $f.FullName; holderPid = [int]$holder.pid; requirement = [string]$holder.requirement; startedAt = [string]$holder.startedAt }\\n128:         }\\n129:     }\\n130:     return $null\\n131: }\\n132: \\n133: # What the pool looks like right now. Read-only.\\n134: function Get-DbSlotPool {\\n135:     $out = @()\\n136:     for ($slot = 1; $slot -le $script:DbSlotPoolSize; $slot++) {\\n137:         $r = Read-DbSlotReservation $slot\\n138:         $o = Get-DbSlotOccupancy $slot\\n139:         $item = ''\\n140:         if ($r) { $item = [string]$r.item }\\n141:         $out += @{ slot = $slot; reservedFor = $item; reservation = $r; occupancy = $o }\\n142:     }\\n143:     return $out\\n144: }\\n145: \\n146: # Take a slot for one item. Exclusive create, so two coordinators cannot take the same slot.\\n147: #\\n148: # A FULL POOL IS A REJECTION, NOT A WAIT. The ruled design says the next database-needing item is\\n149: # rejected at start; a wait here would turn admission control into a queue nobody can see.\\n150: function Reserve-DbSlot([string]$Item, [string]$Branch = '') {\\n151:     if (-not (Test-DbSlotItemId $Item)) { throw ('not a valid item id: ' + $Item) }\\n152: \\n153:     for ($slot = 1; $slot -le $script:DbSlotPoolSize; $slot++) {\\n154:         $r = Read-DbSlotReservation $slot\\n155:         if ($r -and ([string]$r.item) -eq $Item) {\\n156:             return @{ ok = $true; slot = $slot; alreadyHeld = $true }\\n157:         }\\n158:     }\\n159: \\n160:     $held = @()\\n161:     for ($slot = 1; $slot -le $script:DbSlotPoolSize; $slot++) {\\n162:         $path = Get-DbSlotReservationPath $slot\\n163:         $fs = $null\\n164:         try {\\n165:             $fs = [System.IO.File]::Open($path, [System.IO.FileMode]::CreateNew, [System.IO.FileAccess]::Write)\\n166:             $o = @{ slot = $slot; item = $Item; branch = $Branch; at = (Get-Date).ToUniversalTime().ToString('o'); holder = ('pid=' + $PID) }\\n167:             $bytes = [System.Text.Encoding]::UTF8.GetBytes(($o | ConvertTo-Json -Depth 4))\\n168:             $fs.Write($bytes, 0, $bytes.Length)\\n169:             return @{ ok = $true; slot = $slot; alreadyHeld = $false }\\n170:         } catch {\\n171:             # RE-READ, THEN DECIDE. Two calls for the SAME item can both pass the already-held scan\\n172:             # above; one wins slot 1, and without this the loser would read \\\"taken\\\", advance, and\\n173:             # win slot 2 - one item holding the whole pool of two. If the reservation that beat us\\n174:             # names this same item, this item already has the slot, so say so and stop.\\n175:             #\\n176:             # The read WAITS OUT THE WRITE WINDOW (see Read-DbSlotReservationWait; NOT ruled by\\n177:             # gate 2, the executor's completion of T10, awaiting ratification). A reservation still\\n178:             # unreadable after the wait REJECTS this item rather than giving it a second slot: a\\n179:             # false rejection is loud and costs one look, a silent double-take costs the pool.\\n180:             $r = Read-DbSlotReservationWait $slot\\n181:             if ($r) {\\n182:                 if (([string]$r.item) -eq $Item) { return @{ ok = $true; slot = $slot; alreadyHeld = $true } }\\n183:                 $held += ('slot ' + $slot + ' -> ' + [string]$r.item)\\n184:             } elseif (Test-Path (Get-DbSlotReservationPath $slot)) {\\n185:                 return @{ ok = $false; rejected = $true; reason = ('slot ' + $slot + ' holds a reservation this call cannot read, so it cannot tell whether that reservation belongs to ' + $Item + '. This item is REJECTED at start rather than given a second slot. Look at ' + (Get-DbSlotReservationPath $slot) + ' and run this again.') }\\n186:             } else {\\n187:                 $held += ('slot ' + $slot + ' -> taken')\\n188:             }\\n189:         } finally {\\n190:             if ($fs) { $fs.Dispose() }\\n191:         }\\n192:     }\\n193: \\n194:     return @{ ok = $false; rejected = $true; reason = ('the database slot pool is full (' + ($held -join '; ') + '). This item is REJECTED at start, not queued. Finish one of those items, or start an item that needs no database.') }\\n195: }\\n196: \\n197: # Give a slot back at the item sweep.\\n198: #\\n199: # TWO REFUSALS, both of them the point. A reservation is deleted only when it NAMES the item being\\n200: # swept, so a sweep can never hand another item's slot away. And a reservation is never deleted\\n201: # while a live occupancy claim sits on that slot, because the run holding it is about to reset\\n202: # that database and the next item would be given a stack under a running reset.\\n203: function Release-DbSlot([string]$Item, [int]$Slot = 0) {\\n204:     if (-not (Test-DbSlotItemId $Item)) { throw ('not a valid item id: ' + $Item) }\\n205: \\n206:     $target = 0\\n207:     if ($Slot -gt 0) {\\n208:         $r = Read-DbSlotReservation $Slot\\n209:         if (-not $r) { return @{ ok = $true; released = $false; reason = ('slot ' + $Slot + ' holds no reservation') } }\\n210:         if (([string]$r.item) -ne $Item) {\\n211:             return @{ ok = $false; released = $false; reason = ('REFUSING: slot ' + $Slot + ' is reserved for ' + [string]$r.item + ', not for ' + $Item) }\\n212:         }\\n213:         $target = $Slot\\n214:     } else {\\n215:         for ($slot = 1; $slot -le $script:DbSlotPoolSize; $slot++) {\\n216:             $r = Read-DbSlotReservation $slot\\n217:             if ($r -and ([string]$r.item) -eq $Item) { $target = $slot; break }\\n218:         }\\n219:         if ($target -eq 0) { return @{ ok = $true; released = $false; reason = ('no slot is reserved for ' + $Item) } }\\n220:     }\\n221: \\n222:     # RESIDUAL, ruled and accepted (gate-2 T9): the window between this check and the delete below\\n223:     # is real, and it changes nothing destructive. The serializer for destructive acts is the\\n224:     # OCCUPANCY CLAIM, which is dead-pid-only - a live holder is never displaced. A runner that\\n225:     # slips into this window still holds its own claim, so the worst outcome is the NEXT item's\\n226:     # occupy refusing loudly until the window closes: a loud refusal, never a reset under a live\\n227:     # run. An atomic two-file handoff here would buy no safety the claim does not already give.\\n228:     $o = Get-DbSlotOccupancy $target\\n229:     if ($o) {\\n230:         return @{ ok = $false; released = $false; slot = $target; reason = ('REFUSING: slot ' + $target + ' is OCCUPIED right now by pid ' + $o.holderPid + ' running ' + $o.requirement + ' since ' + $o.startedAt + '. A verify window is open on that database. Wait for it to finish.') }\\n231:     }\\n232: \\n233:     Remove-Item (Get-DbSlotReservationPath $target) -Force\\n234:     return @{ ok = $true; released = $true; slot = $target }\\n235: }\\n\\n(End of file - total 235 lines)\\n</content>\",\"metadata\":{\"preview\":\"# db-slots.ps1 - the coordinator's half of the local database slot pool (ASCII-only; PowerShell 5.1).\\n#\\n# A slot is one standing local Supabase stack. There are two of them, so two items can verify at\\n# the same time without resetting each other's database. The pool has two states and three owners:\\n#\\n#   RESERVED  - the coordinator takes a slot when an item starts. That is ADMISSION CONTROL: a full\\n#               pool means the next database-needing item is REJECTED at start, never queued.\\n#   OCCUPIED  - the harness runner takes the slot for each verify window, and releases it in a\\n#               finally. That claim is written by tests/at/harness/db-pool.ts, not by this file.\\n#   released  - the coordinator deletes the reservation at the item sweep.\\n#\\n# THIS FILE DOES FILE OPERATIONS ONLY - reserve, release, list. It reads no config.toml and writes\\n# no config.toml. All TOML lives in tests/at/harness/db-pool.ts, because two rules for one identity\\n# is how a slot ends up on a personal port.\\n\\n$ErrorActionPreference = 'Stop'\\n\\n$script:DbSlotPoolSize = 2\\n\\n# THE SAME BASE-RESOLUTION CHAIN AS THE HARNESS, all three steps of it: LOCALAPPDATA, then\",\"truncated\":false,\"loaded\":[],\"display\":{\"type\":\"file\",\"path\":\"C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\loop\\\\work\\\\db-slots.ps1\",\"text\":\"# db-slots.ps1 - the coordinator's half of the local database slot pool (ASCII-only; PowerShell 5.1).\\n#\\n# A slot is one standing local Supabase stack. There are two of them, so two items can verify at\\n# the same time without resetting each other's database. The pool has two states and three owners:\\n#\\n#   RESERVED  - the coordinator takes a slot when an item starts. That is ADMISSION CONTROL: a full\\n#               pool means the next database-needing item is REJECTED at start, never queued.\\n#   OCCUPIED  - the harness runner takes the slot for each verify window, and releases it in a\\n#               finally. That claim is written by tests/at/harness/db-pool.ts, not by this file.\\n#   released  - the coordinator deletes the reservation at the item sweep.\\n#\\n# THIS FILE DOES FILE OPERATIONS ONLY - reserve, release, list. It reads no config.toml and writes\\n# no config.toml. All TOML lives in tests/at/harness/db-pool.ts, because two rules for one identity\\n# is how a slot ends up on a personal port.\\n\\n$ErrorActionPreference = 'Stop'\\n\\n$script:DbSlotPoolSize = 2\\n\\n# THE SAME BASE-RESOLUTION CHAIN AS THE HARNESS, all three steps of it: LOCALAPPDATA, then\\n# XDG_CACHE_HOME, then the system temp path. The harness resolves it that way (poolRoot and\\n# lockDir in tests/at/harness/), and two resolution rules for one pool is how the two halves stop\\n# seeing each other's files - this side would write a reservation the runner never reads.\\nfunction Get-DbSlotBaseDir([string]$leaf) {\\n    if ($env:LOCALAPPDATA) { $base = $env:LOCALAPPDATA }\\n    elseif ($env:XDG_CACHE_HOME) { $base = $env:XDG_CACHE_HOME }\\n    else { $base = [System.IO.Path]::GetTempPath() }\\n    return (Join-Path $base ('ai4good-build\\\\' + $leaf))\\n}\\n\\n# The pool lives beside the claims it cooperates with and outside every worktree.\\n# AT_DB_POOL_ROOT overrides it, for tests only.\\nfunction Get-DbSlotPoolRoot {\\n    if ($env:AT_DB_POOL_ROOT) { $root = $env:AT_DB_POOL_ROOT }\\n    else { $root = Get-DbSlotBaseDir 'db-slots' }\\n    if (-not (Test-Path $root)) { New-Item -ItemType Directory -Force $root | Out-Null }\\n    return $root\\n}\\n\\nfunction Get-DbSlotReservationDir {\\n    $d = Join-Path (Get-DbSlotPoolRoot) 'reservations'\\n    if (-not (Test-Path $d)) { New-Item -ItemType Directory -Force $d | Out-Null }\\n    return $d\\n}\\n\\nfunction Get-DbSlotReservationPath([int]$slot) {\\n    return Join-Path (Get-DbSlotReservationDir) ('slot-' + $slot + '.json')\\n}\\n\\n# Where the harness runner writes its occupancy claims. Same chain, same override, same reason.\\nfunction Get-DbSlotClaimDir {\\n    if ($env:AT_LOCK_DIR) { $d = $env:AT_LOCK_DIR }\\n    else { $d = Get-DbSlotBaseDir 'at-locks' }\\n    if (-not (Test-Path $d)) { New-Item -ItemType Directory -Force $d | Out-Null }\\n    return $d\\n}\\n\\nfunction Test-DbSlotItemId([string]$item) {\\n    return ($item -match '^(AI4DEV|AI4PM)-[0-9]+$')\\n}\\n\\nfunction Read-DbSlotReservation([int]$slot) {\\n    $p = Get-DbSlotReservationPath $slot\\n    if (-not (Test-Path $p)) { return $null }\\n    try { return (Get-Content $p -Raw | ConvertFrom-Json) } catch { return $null }\\n}\\n\\n# THE SAME READ, BUT IT WAITS OUT THE WRITE WINDOW.\\n#\\n# NOT RULED BY GATE 2. Ruling T10 asks the create-failure path in Reserve-DbSlot to re-read the\\n# reservation; measurement showed that re-read cannot see the winner's file, so the ruled fix alone\\n# left the defect open. This function and the block that calls it are the executor's completion of\\n# T10 and need the orchestrator's ratification. Reverting this one commit restores exactly the\\n# ruled text.\\n#\\n# THE MEASUREMENT, on this machine, 2026-08-10. A reservation file is created EXCLUSIVELY and\\n# filled a moment later. Between those two acts the file EXISTS and cannot be read at all: the\\n# creating handle holds it with no sharing, so a second reader gets a sharing violation, not an\\n# empty file. The loser of the race is inside that window by definition - it lost by microseconds.\\n# With the plain read above, five races out of five ended with one item holding BOTH slots; with\\n# this read, eight races out of eight ended with one item holding exactly one slot and the loser\\n# correctly told it already held it.\\n#\\n# One second of retries is thousands of times the window. It is the same remedy ruling T1 applies\\n# to the same window shape in the harness's own claim files.\\nfunction Read-DbSlotReservationWait([int]$slot) {\\n    $p = Get-DbSlotReservationPath $slot\\n    for ($try = 0; $try -lt 40; $try++) {\\n        if (-not (Test-Path $p)) { return $null }\\n        $raw = $null\\n        try { $raw = Get-Content $p -Raw -ErrorAction Stop } catch { $raw = $null }\\n        if ($raw -and $raw.Trim()) {\\n            try { return ($raw | ConvertFrom-Json) } catch { }\\n        }\\n        Start-Sleep -Milliseconds 25\\n    }\\n    return $null\\n}\\n\\n# The occupancy claim the harness writes, if one exists and its holder is still alive.\\n#\\n# The claim file name carries the slot's api port, which this file deliberately does not know - it\\n# reads no config.toml - so the lookup is a glob on the project id. A claim whose pid is gone is\\n# STALE, not live: the run that wrote it died, and the harness itself would take it over.\\nfunction Get-DbSlotOccupancy([int]$slot) {\\n    $pattern = 'at-verify-ai4good-slot-' + $slot + '-*.lock'\\n    $files = @(Get-ChildItem -Path (Get-DbSlotClaimDir) -Filter $pattern -File -ErrorAction SilentlyContinue)\\n    foreach ($f in $files) {\\n        $holder = $null\\n        try { $holder = (Get-Content $f.FullName -Raw | ConvertFrom-Json) } catch { $holder = $null }\\n        if (-not $holder) { continue }\\n        # NOT-FOUND MEANS DEAD; EVERY OTHER FAILURE MEANS ALIVE. Get-Process reports one specific\\n        # error when no process holds that id, and it can fail for other reasons - a process owned\\n        # by another user, for one. The harness's own liveness test treats a permission error as\\n        # ALIVE, and it has to: an occupancy misread as dead lets Release-DbSlot hand the slot away\\n        # under a running verify window. Fail closed, exactly as the harness does.\\n        $alive = $false\\n        if ($holder.pid) {\\n            try {\\n                Get-Process -Id ([int]$holder.pid) -ErrorAction Stop | Out-Null\\n                $alive = $true\\n            } catch {\\n                if ($_.FullyQualifiedErrorId -like 'NoProcessFoundForGivenId*') { $alive = $false } else { $alive = $true }\\n            }\\n        }\\n        if ($alive) {\\n            return @{ file = $f.FullName; holderPid = [int]$holder.pid; requirement = [string]$holder.requirement; startedAt = [string]$holder.startedAt }\\n        }\\n    }\\n    return $null\\n}\\n\\n# What the pool looks like right now. Read-only.\\nfunction Get-DbSlotPool {\\n    $out = @()\\n    for ($slot = 1; $slot -le $script:DbSlotPoolSize; $slot++) {\\n        $r = Read-DbSlotReservation $slot\\n        $o = Get-DbSlotOccupancy $slot\\n        $item = ''\\n        if ($r) { $item = [string]$r.item }\\n        $out += @{ slot = $slot; reservedFor = $item; reservation = $r; occupancy = $o }\\n    }\\n    return $out\\n}\\n\\n# Take a slot for one item. Exclusive create, so two coordinators cannot take the same slot.\\n#\\n# A FULL POOL IS A REJECTION, NOT A WAIT. The ruled design says the next database-needing item is\\n# rejected at start; a wait here would turn admission control into a queue nobody can see.\\nfunction Reserve-DbSlot([string]$Item, [string]$Branch = '') {\\n    if (-not (Test-DbSlotItemId $Item)) { throw ('not a valid item id: ' + $Item) }\\n\\n    for ($slot = 1; $slot -le $script:DbSlotPoolSize; $slot++) {\\n        $r = Read-DbSlotReservation $slot\\n        if ($r -and ([string]$r.item) -eq $Item) {\\n            return @{ ok = $true; slot = $slot; alreadyHeld = $true }\\n        }\\n    }\\n\\n    $held = @()\\n    for ($slot = 1; $slot -le $script:DbSlotPoolSize; $slot++) {\\n        $path = Get-DbSlotReservationPath $slot\\n        $fs = $null\\n        try {\\n            $fs = [System.IO.File]::Open($path, [System.IO.FileMode]::CreateNew, [System.IO.FileAccess]::Write)\\n            $o = @{ slot = $slot; item = $Item; branch = $Branch; at = (Get-Date).ToUniversalTime().ToString('o'); holder = ('pid=' + $PID) }\\n            $bytes = [System.Text.Encoding]::UTF8.GetBytes(($o | ConvertTo-Json -Depth 4))\\n            $fs.Write($bytes, 0, $bytes.Length)\\n            return @{ ok = $true; slot = $slot; alreadyHeld = $false }\\n        } catch {\\n            # RE-READ, THEN DECIDE. Two calls for the SAME item can both pass the already-held scan\\n            # above; one wins slot 1, and without this the loser would read \\\"taken\\\", advance, and\\n            # win slot 2 - one item holding the whole pool of two. If the reservation that beat us\\n            # names this same item, this item already has the slot, so say so and stop.\\n            #\\n            # The read WAITS OUT THE WRITE WINDOW (see Read-DbSlotReservationWait; NOT ruled by\\n            # gate 2, the executor's completion of T10, awaiting ratification). A reservation still\\n            # unreadable after the wait REJECTS this item rather than giving it a second slot: a\\n            # false rejection is loud and costs one look, a silent double-take costs the pool.\\n            $r = Read-DbSlotReservationWait $slot\\n            if ($r) {\\n                if (([string]$r.item) -eq $Item) { return @{ ok = $true; slot = $slot; alreadyHeld = $true } }\\n                $held += ('slot ' + $slot + ' -> ' + [string]$r.item)\\n            } elseif (Test-Path (Get-DbSlotReservationPath $slot)) {\\n                return @{ ok = $false; rejected = $true; reason = ('slot ' + $slot + ' holds a reservation this call cannot read, so it cannot tell whether that reservation belongs to ' + $Item + '. This item is REJECTED at start rather than given a second slot. Look at ' + (Get-DbSlotReservationPath $slot) + ' and run this again.') }\\n            } else {\\n                $held += ('slot ' + $slot + ' -> taken')\\n            }\\n        } finally {\\n            if ($fs) { $fs.Dispose() }\\n        }\\n    }\\n\\n    return @{ ok = $false; rejected = $true; reason = ('the database slot pool is full (' + ($held -join '; ') + '). This item is REJECTED at start, not queued. Finish one of those items, or start an item that needs no database.') }\\n}\\n\\n# Give a slot back at the item sweep.\\n#\\n# TWO REFUSALS, both of them the point. A reservation is deleted only when it NAMES the item being\\n# swept, so a sweep can never hand another item's slot away. And a reservation is never deleted\\n# while a live occupancy claim sits on that slot, because the run holding it is about to reset\\n# that database and the next item would be given a stack under a running reset.\\nfunction Release-DbSlot([string]$Item, [int]$Slot = 0) {\\n    if (-not (Test-DbSlotItemId $Item)) { throw ('not a valid item id: ' + $Item) }\\n\\n    $target = 0\\n    if ($Slot -gt 0) {\\n        $r = Read-DbSlotReservation $Slot\\n        if (-not $r) { return @{ ok = $true; released = $false; reason = ('slot ' + $Slot + ' holds no reservation') } }\\n        if (([string]$r.item) -ne $Item) {\\n            return @{ ok = $false; released = $false; reason = ('REFUSING: slot ' + $Slot + ' is reserved for ' + [string]$r.item + ', not for ' + $Item) }\\n        }\\n        $target = $Slot\\n    } else {\\n        for ($slot = 1; $slot -le $script:DbSlotPoolSize; $slot++) {\\n            $r = Read-DbSlotReservation $slot\\n            if ($r -and ([string]$r.item) -eq $Item) { $target = $slot; break }\\n        }\\n        if ($target -eq 0) { return @{ ok = $true; released = $false; reason = ('no slot is reserved for ' + $Item) } }\\n    }\\n\\n    # RESIDUAL, ruled and accepted (gate-2 T9): the window between this check and the delete below\\n    # is real, and it changes nothing destructive. The serializer for destructive acts is the\\n    # OCCUPANCY CLAIM, which is dead-pid-only - a live holder is never displaced. A runner that\\n    # slips into this window still holds its own claim, so the worst outcome is the NEXT item's\\n    # occupy refusing loudly until the window closes: a loud refusal, never a reset under a live\\n    # run. An atomic two-file handoff here would buy no safety the claim does not already give.\\n    $o = Get-DbSlotOccupancy $target\\n    if ($o) {\\n        return @{ ok = $false; released = $false; slot = $target; reason = ('REFUSING: slot ' + $target + ' is OCCUPIED right now by pid ' + $o.holderPid + ' running ' + $o.requirement + ' since ' + $o.startedAt + '. A verify window is open on that database. Wait for it to finish.') }\\n    }\\n\\n    Remove-Item (Get-DbSlotReservationPath $target) -Force\\n    return @{ ok = $true; released = $true; slot = $target }\\n}\",\"lineStart\":1,\"lineEnd\":235,\"totalLines\":235,\"truncated\":false}},\"title\":\"loop\\\\work\\\\db-slots.ps1\",\"time\":{\"start\":1786349903122,\"end\":1786349903138}},\"id\":\"prt_feac05ce9001PnYaFe4qhvUz0e\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"messageID\":\"msg_feac04b80001PC4AFK3cW6EF3F\"}}\r\n+{\"type\":\"text\",\"timestamp\":1786349903209,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feac05c0d0015BfmvSDRLkd5b5\",\"messageID\":\"msg_feac04b80001PC4AFK3cW6EF3F\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"type\":\"text\",\"text\":\"Now the PowerShell helpers and the SKILL.md process lines.\",\"time\":{\"start\":1786349902861,\"end\":1786349903207}}}\r\n+{\"type\":\"step_finish\",\"timestamp\":1786349903608,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feac05ee1001oyOykBKSjPfW8z\",\"reason\":\"tool-calls\",\"snapshot\":\"406336b6e25d5335208c49e121cae5d4cb482d77\",\"messageID\":\"msg_feac04b80001PC4AFK3cW6EF3F\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"type\":\"step-finish\",\"tokens\":{\"total\":85734,\"input\":7410,\"output\":96,\"reasoning\":276,\"cache\":{\"write\":0,\"read\":77952}},\"cost\":0.0006799128}}\r\n+{\"type\":\"step_start\",\"timestamp\":1786349905675,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feac067