1220:     AT_SUPABASE_URL: status.apiUrl,
1221:     AT_SUPABASE_DB_URL: status.dbUrl,
1222:     AT_SUPABASE_ANON_KEY: status.anonKey,
1223:     AT_SUPABASE_SERVICE_ROLE_KEY: status.serviceRoleKey,
