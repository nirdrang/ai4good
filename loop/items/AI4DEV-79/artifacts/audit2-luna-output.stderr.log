 231: export interface PortMapping {
 232:   section: string;
 233:   key: string;
 234:   line: number;
 235:   from: number;
 236:   to: number;
 237: }
 238: 
 239: /**
 240:  * The identity overlay's port rule (ruling E4).
 241:  *
 242:  *   - a LISTENER port (see `LISTENER_PORTS`) in 54000â€“54999 moves by 1000 per slot;
 243:  *     `edge_runtime.inspector_port` set to EXACTLY 8083 moves by 10 per slot, because the ruled
 244:  *     inspector value is 8083 and it is not in that band. Any OTHER inspector value falls to the
 245:  *     generic rule below, so it maps when it is in band and refuses when it is not â€” a +10 applied
 246:  *     to a value nobody ruled is a guess, and D2 forbids guesses.
 247:  *   - a listener port outside those bands REFUSES loudly as unmappable. A guess here is a port
 248:  *     collision with software nobody in this process knows about, so a person decides.
 249:  *   - any OTHER port-valued key passes through unchanged: it addresses somebody else's service and
 250:  *     is data, not identity.
 251:  *   - except that a non-listener port sitting in 54000â€“54999 also REFUSES. It looks exactly like a
 252:  *     local stack port and this rule does not recognise it, and treating an unrecognised local port
 253:  *     as data would hand two slots the same socket. Fail closed, and a person decides.
 254:  *
 255:  * `personalBlockProblems` stays broad over EVERY port key regardless of this rule, so a port in the
 256:  * founder's own block can never reach a slot by being classified as data.
 257:  */
 258: export function portMappings(text: string, slot: number): { mappings: PortMapping[]; problems: string[] } {
 259:   assertSlotNumber(slot);
 260:   const mappings: PortMapping[] = [];
 261:   const problems: string[] = [];
 262: 
 263:   for (const entry of scanConfig(text)) {
 264:     if (!isPortKey(entry.key)) continue;
 265:     // WHOLE TOKEN, never a prefix (ruling A5): `54_321` is 54321 here, not 54.
 266:     const parsed = portValue(entry.value);
 267:     const from = parsed ?? NaN;
 268:     const listener = isListenerPort(entry.section, entry.key);
 269: 
 270:     if (!listener) {
 271:       if (Number.isFinite(from) && from >= MAPPABLE_PORT_LOW && from <= MAPPABLE_PORT_HIGH) {
 272:         problems.push(
 273:           `[${entry.section}] ${entry.key} = ${from} is not a listener port this rule knows, but it sits in the local ` +
 274:             `stack's band ${MAPPABLE_PORT_LOW}â€“${MAPPABLE_PORT_HIGH} â€” decide by hand whether the slot moves it`,
 275:         );
 276:       }
 277:       continue; // a client-connection port is data and travels unchanged
 278:     }
 279: 
 280:     if (parsed === null) {
 281:       problems.push(`[${entry.section}] ${entry.key} = ${entry.value} is not a plain port number, so the slot overlay cannot move it`);
 282:       continue;
 283:     }
 284:     if (entry.section === 'edge_runtime' && entry.key === 'inspector_port' && from === PERSONAL_INSPECTOR_PORT) {
 285:       mappings.push({ section: entry.section, key: entry.key, line: entry.line, from, to: from + slot * 10 });
 286:       continue;
 287:     }
 288:     if (from >= MAPPABLE_PORT_LOW && from <= MAPPABLE_PORT_HIGH) {
 289:       mappings.push({ section: entry.section, key: entry.key, line: entry.line, from, to: from + slot * 1000 });
 290:       continue;
 291:     }
 292:     problems.push(
 293:       `[${entry.section}] ${entry.key} = ${from} is outside ${MAPPABLE_PORT_LOW}â€“${MAPPABLE_PORT_HIGH}, so the slot ` +
 294:         `overlay does not know where to move it â€” decide the slot's port for this setting by hand`,
 295:     );
 296:   }
 297: 
 298:   return { mappings, problems };
 299: }
