1405: function dockerLines(args: string[]): string[] {
1406:   const res = spawnSync('docker', args, { env: childEnv(), encoding: 'utf8' });
1407:   if (res.error) throw new Error(`docker could not be run (${diagnostic((res.error as Error).message)})`);
1408:   if (res.status !== 0) throw new Error(`\`docker ${args.slice(0, 2).join(' ')}\` exited ${res.status}: ${diagnostic(res.stderr) || '(no error output)'}`);
