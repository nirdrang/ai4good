1442: function snapshotDifferences(before: DockerSnapshot, after: DockerSnapshot): string[] {
1443:   const differences: string[] = [];
1444:   const pairs = [
1445:     ['container', before.containers, after.containers],
1446:     ['volume', before.volumes, after.volumes],
1447:   ] as const;
1448:   for (const [what, first, second] of pairs) {
1449:     for (const line of first) if (!second.includes(line)) differences.push(`${what} recorded BEFORE and not after: ${line}`);
1450:     for (const line of second) if (!first.includes(line)) differences.push(`${what} recorded AFTER and not before: ${line}`);
1451:   }
1452:   return differences;
1453: }
