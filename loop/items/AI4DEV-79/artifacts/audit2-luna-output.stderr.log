 301: /**
 302:  * The item tree's own config, wearing the slot's identity. Everything that is not an identity
 303:  * field is returned byte for byte, including comments, blank lines and line endings â€” a
 304:  * regenerated config differing anywhere else would mean the slot grades different behaviour from
 305:  * the tree that asked for the run.
 306:  */
 307: export function generateSlotConfig(sourceText: string, slot: number): string {
