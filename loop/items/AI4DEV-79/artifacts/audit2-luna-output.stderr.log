 120: describe('one slot has exactly one occupier', () => {
 121:   it('two concurrent occupies on one slot end with exactly one winner', async () => {
 122:     installSlot(1);
 123:     const moduleUrl = new URL('./db-pool.ts', import.meta.url).href;
 124:     const startAt = Date.now() + 800;
 125: 
 126:     const contender = (): Promise<string> => {
 127:       const code =
 128:         `const { occupy } = await import(${JSON.stringify(moduleUrl)});\n` +
 129:         `while (Date.now() < ${startAt}) {}\n` + // a barrier, so both attempt at the same instant
 130:         `try {\n` +
 131:         `  const held = occupy('req-000', { slot: 1 });\n` +
 132:         `  console.log('ACQUIRED');\n` +
 133:         `  await Bun.sleep(600);\n` + // hold it, so the loser meets a LIVE holder
 134:         `  held.release();\n` +
 135:         `} catch { console.log('REFUSED'); }\n`;
 136:       // spawn, NOT spawnSync: a synchronous spawn would run the contenders one after the other,
 137:       // and the second would find the claim already released â€” a race that never raced.
 138:       return new Promise<string>((resolve) => {
 139:         const child = spawn(bunExecutable(), ['--no-env-file', '-e', code], {
 140:           env: { ...process.env, AT_DB_POOL_ROOT: poolTemp, AT_LOCK_DIR: lockTemp } as NodeJS.ProcessEnv,
 141:           stdio: ['ignore', 'pipe', 'pipe'],
 142:         });
 143:         let out = '';
 144:         child.stdout.on('data', (chunk: Buffer) => (out += chunk.toString('utf8')));
 145:         child.stderr.on('data', (chunk: Buffer) => (out += chunk.toString('utf8')));
 146:         child.once('error', (err) => resolve(`ERROR ${err.message}`));
 147:         child.once('close', () => resolve(out));
 148:       });
 149:     };
 150: 
 151:     const [a, b] = await Promise.all([contender(), contender()]);
 152:     const outcomes = [a, b].map((out) => (out.includes('ACQUIRED') ? 'ACQUIRED' : out.includes('REFUSED') ? 'REFUSED' : `UNKNOWN(${out.trim()})`));
 153: 
 154:     try {
 155:       expect(outcomes.filter((o) => o === 'ACQUIRED'), `outcomes were ${JSON.stringify(outcomes)}`).toHaveLength(1);
 156:       expect(outcomes.filter((o) => o === 'REFUSED'), `outcomes were ${JSON.stringify(outcomes)}`).toHaveLength(1);
 157:       expect(existsSync(claimPath(1)), 'the winner did not release its claim').toBe(false);
 158:     } finally {
 159:       scrubClaim(1);
 160:     }
 161:   }, 60_000);
 162: 
 163:   it('breaks a dead holder LOUDLY and records the takeover in the new claim', () => {
 164:     installSlot(1);
 165:     // A REAL process id, from a child that has already exited (ruling F9). A made-up large number
 166:     // is only ASSUMED dead, and a busy machine can legitimately be holding it â€” which would make
 167:     // the one test that guards the takeover rule fail for a reason that has nothing to do with it.
 168:     const gone = deadPid();
 169:     plantClaim(1, { pid: gone, host: 'gone', requirement: 'req-000', startedAt: new Date().toISOString() });
 170:     const said = vi.spyOn(console, 'log').mockImplementation(() => undefined);
 171:     try {
 172:       const held = occupy('req-016', { slot: 1 });
 173:       const claim = JSON.parse(readFileSync(held.claim.file, 'utf8')) as {
 174:         pid?: number;
 175:         tookOverFrom?: { pid?: number; requirement?: string };
 176:       };
 177:       expect(claim.pid, 'the takeover did not record this process as the holder').toBe(process.pid);
 178:       expect(claim.tookOverFrom?.pid, 'the displaced holder was not recorded IN the claim').toBe(gone);
 179:       expect(claim.tookOverFrom?.requirement).toBe('req-000');
 180:       expect(said.mock.calls.flat().join(' '), 'the takeover was silent').toContain('took over a stale stack lock');
 181:       held.release();
 182:     } finally {
 183:       said.mockRestore();
 184:       scrubClaim(1);
 185:     }
 186:   });
 187: 
 188:   it('never takes over a LIVE holder, at any age, and names it', () => {
 189:     installSlot(1);
 190:     // Alive (this very process) and old enough that the runner's own stale window would displace
 191:     // it. The pool passes dead-pid-only, so it must not.
 192:     plantClaim(1, {
 193:       pid: process.pid,
 194:       host: 'here',
 195:       requirement: 'req-000',
 196:       startedAt: new Date(Date.now() - 48 * 60 * 60 * 1000).toISOString(),
 197:     });
 198:     try {
 199:       expect(() => occupy('req-016', { slot: 1 })).toThrow(new RegExp(`another at:verify run holds this stack \\(pid ${process.pid}`));
 200:     } finally {
 201:       scrubClaim(1);
 202:     }
 203:   });
 204: 
 205:   it('never takes over a claim file it cannot identify, and names the file (ruling T1)', () => {
 206:     installSlot(1);
 207:     // AN EMPTY FILE IS WHAT A LIVE CLAIM LOOKS LIKE MID-WRITE. The exclusive create and the write
 208:     // that fills it are two acts, and between them the file exists and says nothing. Under
 209:     // dead-pid-only that must NEVER read as a dead holder: taking it over would delete a live
 210:     // run's brand-new claim, which is the one thing this policy exists to make impossible.
 211:     for (const planted of ['', '   \n', '{"pid":', 'not json at all']) {
 212:       plantRawClaim(1, planted);
 213:       try {
 214:         expect(() => occupy('req-016', { slot: 1 }), `a claim file containing ${JSON.stringify(planted)} was taken over`).toThrow(
 215:           /names no process id that this run can read/,
 216:         );
 217:         expect(() => occupy('req-016', { slot: 1 })).toThrow(claimPath(1));
 218:         expect(existsSync(claimPath(1)), 'the refusal deleted the file it could not identify').toBe(true);
 219:       } finally {
 220:         scrubClaim(1);
 221:       }
 222:     }
 223:   }, 30_000);
 224: 
 225:   it('releases from a `finally` when the caller throws', () => {
 226:     installSlot(1);
 227:     let held: Occupancy | null = null;
 228:     expect(() => {
 229:       try {
 230:         held = occupy('req-016', { slot: 1 });
 231:         throw new Error('the suite blew up');
 232:       } finally {
 233:         release(held);
 234:       }
 235:     }).toThrow('the suite blew up');
 236:     expect(existsSync(claimPath(1)), 'a throwing caller stranded the occupancy claim').toBe(false);
 237:   });
 238: });
