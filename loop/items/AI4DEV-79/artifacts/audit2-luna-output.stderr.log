1213:       throw new Error(`refusing to emit ${label}: it points at port ${port}, inside the founder's personal stack's port block`);
1214:     }
1215:   }
1216:   if (occupancy.config.projectId === personalProjectId()) {
1217:     throw new Error(`refusing to emit slot ${occupancy.slot}'s coordinates: its project id is the personal stack's`);
1218:   }
