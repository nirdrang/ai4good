\worktrees\\\\agent-a064eb77d7bb37dd7\\\\loop\\\\items\\\\AI4DEV-79\\\\artifacts\\\\audit-flash-output.pid\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\loop\\\\items\\\\AI4DEV-79\\\\artifacts\\\\audit-flash-output.events.jsonl\",\"metadata\":{\"count\":36,\"truncated\":false},\"title\":\"\",\"time\":{\"start\":1786349831076,\"end\":1786349831142}},\"id\":\"prt_feabf4334001xKkCrJ8YVMG4rW\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"messageID\":\"msg_feabeffb8001ZG6ZlgIwLjekMR\"}}\r\n+{\"type\":\"text\",\"timestamp\":1786349831312,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feabf42c7001K20gyYlfaqCyVC\",\"messageID\":\"msg_feabeffb8001ZG6ZlgIwLjekMR\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"type\":\"text\",\"text\":\"Now let me look at the git state and the diff scope.\",\"time\":{\"start\":1786349830855,\"end\":1786349831309}}}\r\n+{\"type\":\"tool_use\",\"timestamp\":1786349831321,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"type\":\"tool\",\"tool\":\"glob\",\"callID\":\"call_01_Jfo1tU7iRctJ2VWMtLu11145\",\"state\":{\"status\":\"completed\",\"input\":{\"pattern\":\"tests/at/harness/*\"},\"output\":\"C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\oracles.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\oracles.selftest.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\index.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\guards.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\fixtures.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\faults.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\registry.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\expected.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\expected.selftest.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\db-pool.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\db-pool.selftest.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\contracts.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\conformance.selftest.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\config.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\clock.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\check.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\capabilities.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\atconfig.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\record-oracles.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\runner.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\runner.selftest.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\runner-expect.selftest.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\runner-blackbox.selftest.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\vendors.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\vendors.selftest.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\type-invention.selftest.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\suite-adapters.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\shipped-verification.selftest.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\sentinels.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\req016-oracles.selftest.ts\",\"metadata\":{\"count\":30,\"truncated\":false},\"title\":\"\",\"time\":{\"start\":1786349831264,\"end\":1786349831318}},\"id\":\"prt_feabf43c60018PUnxyn6CTq7Zp\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"messageID\":\"msg_feabeffb8001ZG6ZlgIwLjekMR\"}}\r\n+{\"type\":\"step_finish\",\"timestamp\":1786349831751,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feabf462d001GLT5kWuslYDGDE\",\"reason\":\"tool-calls\",\"snapshot\":\"0d5714e6c95b562a54393b639047abb52ac16685\",\"messageID\":\"msg_feabeffb8001ZG6ZlgIwLjekMR\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"type\":\"step-finish\",\"tokens\":{\"total\":30013,\"input\":5239,\"output\":100,\"reasoning\":226,\"cache\":{\"write\":0,\"read\":24448}},\"cost\":0.0004465972}}\r\n+{\"type\":\"step_start\",\"timestamp\":1786349846536,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feabf8005001HnmhHsdBhWrYPa\",\"messageID\":\"msg_feabf480d001BtXcgLc77qaukr\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"snapshot\":\"a33fb8fef8490069461118f4ec11e40f6038c5fb\",\"type\":\"step-start\"}}\r\n+{\"type\":\"tool_use\",\"timestamp\":1786349850317,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"type\":\"tool\",\"tool\":\"read\",\"callID\":\"call_00_ZonrKmTIpFna9RwwUBg69109\",\"state\":{\"status\":\"completed\",\"input\":{\"filePath\":\"C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\db-pool.ts\"},\"output\":\"<path>C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\db-pool.ts</path>\\n<type>file</type>\\n<content>\\n1: /**\\n2:  * The local database slot pool — a small number of standing Supabase stacks (\\\"slots\\\") so that\\n3:  * several items can verify at the same time without resetting each other's database.\\n4:  *\\n5:  * THE SHAPE, as ruled:\\n6:  *\\n7:  *   - Two standing slots. Concurrency is the pool size; a full pool REJECTS the next\\n8:  *     database-needing item at start rather than queueing it.\\n9:  *   - The stack on the 54321 block is the founder's personal stack. It is OUTSIDE the pool and\\n10:  *     untouchable, and `personalBlockProblems` below makes that a check in code rather than a\\n11:  *     convention: no slot may carry the repo's project id, a port in 54320–54329, or inspector\\n12:  *     port 8083, and the check runs before anything destructive, every time.\\n13:  *   - One claim file per slot, two states, three owners: the coordinator RESERVES a slot when an\\n14:  *     item starts, the harness runner OCCUPIES it for each verify window, the coordinator\\n15:  *     RELEASES the reservation at the item sweep.\\n16:  *   - STATE IS NEVER INHERITED. The first act of every occupancy is to copy the item tree's own\\n17:  *     `supabase/` directory into the slot and reset the database from it. The previous holder is\\n18:  *     never trusted, including a crashed one.\\n19:  *   - IDENTITY IS PERMANENT, EVERYTHING ELSE IS DATA. A slot permanently owns its project id and\\n20:  *     its port block; every other setting comes from the item tree's own `config.toml` on every\\n21:  *     occupancy, because auth flags and seed paths change per item and a stack started with a\\n22:  *     stale one would grade the wrong behaviour.\\n23:  *\\n24:  * WHY THE CONFIG IS REGENERATED RATHER THAN COPIED OR FROZEN: a frozen slot config drifts from\\n25:  * the item tree, and a copied one carries the personal stack's identity straight into the slot.\\n26:  * Regeneration takes the item tree's file verbatim and overlays ONLY the identity fields, so a\\n27:  * slot is always the item's own configuration wearing the slot's identity.\\n28:  *\\n29:  * WHY THIS FILE OWNS ALL THE TOML: the PowerShell helpers in `loop/work/db-slots.ps1` do file\\n30:  * operations only — reserve, release, list. If both sides generated configs, the overlay rule\\n31:  * could fork, and two rules for one identity is how a slot ends up on a personal port.\\n32:  *\\n33:  * The import of `runner.ts` is deliberate and the cycle it forms with the runner's own import of\\n34:  * this file is safe: neither module calls the other at module scope, and both sides export\\n35:  * hoisted function declarations.\\n36:  */\\n37: \\n38: import { spawnSync } from 'node:child_process';\\n39: import { createHash } from 'node:crypto';\\n40: import { cpSync, existsSync, mkdirSync, readFileSync, readdirSync, rmSync, writeFileSync } from 'node:fs';\\n41: import { hostname, tmpdir } from 'node:os';\\n42: import { isAbsolute, join, relative, resolve } from 'node:path';\\n43: \\n44: import { REPO_ROOT } from './check.ts';\\n45: import {\\n46:   acquireStackLock,\\n47:   childEnv,\\n48:   diagnostic,\\n49:   localStackProblems,\\n50:   parseStackStatus,\\n51:   proveMigrationsReplayed,\\n52:   readLocalConfig,\\n53:   readStackStatus,\\n54:   resetLocalDatabase,\\n55:   runSupabaseCli,\\n56:   stackLockPath,\\n57:   waitForReady,\\n58:   type CliResult,\\n59:   type CliTarget,\\n60:   type Holder,\\n61:   type LocalConfig,\\n62:   type MigrationProof,\\n63:   type StackLock,\\n64:   type StackStatus,\\n65: } from './runner.ts';\\n66: \\n67: /** Ruled: two standing slots. Concurrency IS the pool size. */\\n68: export const POOL_SIZE = 2;\\n69: \\n70: /** The founder's personal stack. Nothing in the pool may carry any of these. */\\n71: const PERSONAL_PORT_LOW = 54320;\\n72: const PERSONAL_PORT_HIGH = 54329;\\n73: const PERSONAL_INSPECTOR_PORT = 8083;\\n74: \\n75: /** The band a port must sit in for the slot overlay to know how to move it. */\\n76: const MAPPABLE_PORT_LOW = 54000;\\n77: const MAPPABLE_PORT_HIGH = 54999;\\n78: \\n79: /* ------------------------------------------------------------------------------ pool locations */\\n80: \\n81: /**\\n82:  * The pool lives beside the locks it cooperates with and OUTSIDE every worktree: a slot outlives\\n83:  * the item that used it, and a directory inside a worktree dies with the worktree.\\n84:  *\\n85:  * `AT_DB_POOL_ROOT` overrides it for the selftests, the same pattern as `AT_REPO_ROOT`.\\n86:  */\\n87: export function poolRoot(): string {\\n88:   const override = process.env.AT_DB_POOL_ROOT?.trim();\\n89:   const dir = override\\n90:     ? override\\n91:     : join(process.env.LOCALAPPDATA ?? process.env.XDG_CACHE_HOME ?? tmpdir(), 'ai4good-build', 'db-slots');\\n92:   mkdirSync(dir, { recursive: true });\\n93:   return dir;\\n94: }\\n95: \\n96: /** Slot numbers are 1..POOL_SIZE. Anything else is a caller error, named rather than clamped. */\\n97: export function assertSlotNumber(slot: number): number {\\n98:   if (!Number.isInteger(slot) || slot < 1 || slot > POOL_SIZE) {\\n99:     throw new Error(`\\\"${slot}\\\" is not a slot in this pool — the slots are 1 to ${POOL_SIZE}`);\\n100:   }\\n101:   return slot;\\n102: }\\n103: \\n104: /** The directory that CONTAINS the slot's `supabase/` project folder — what `--workdir` names. */\\n105: export function slotDir(slot: number): string {\\n106:   return join(poolRoot(), `slot-${assertSlotNumber(slot)}`);\\n107: }\\n108: \\n109: export function slotConfigPath(slot: number): string {\\n110:   return join(slotDir(slot), 'supabase', 'config.toml');\\n111: }\\n112: \\n113: /** Written only after a successful start; see `prepare`. */\\n114: export function slotMarkerPath(slot: number): string {\\n115:   return join(slotDir(slot), '.last-start.json');\\n116: }\\n117: \\n118: export function reservationPath(slot: number): string {\\n119:   return join(poolRoot(), 'reservations', `slot-${assertSlotNumber(slot)}.json`);\\n120: }\\n121: \\n122: /** A distinct project id is what gives a slot distinct Docker containers and volumes. */\\n123: export function slotProjectId(slot: number): string {\\n124:   return `ai4good-slot-${assertSlotNumber(slot)}`;\\n125: }\\n126: \\n127: /**\\n128:  * A slot's PERMANENT identity, used for one purpose: naming the occupancy claim file (ruling T6).\\n129:  *\\n130:  * The runner's claim path is built from a project id and an api port, and for a repository stack\\n131:  * both are permanent. A SLOT's ports are not: `prepare` lawfully rewrites them from the item\\n132:  * tree's own config on every occupancy, so two runs bracketing a port change would hold two\\n133:  * DIFFERENT claim files for one slot and neither would see the other. The claim therefore keys on\\n134:  * the slot's project id — which never changes — and on a fixed sentinel in place of the port.\\n135:  *\\n136:  * The sentinel is 0, which is not a port. It only has to be constant. The PowerShell helper globs\\n137:  * `at-verify-ai4good-slot-N-*.lock`, so it matches this and every earlier name unchanged.\\n138:  */\\n139: export function slotClaimKey(slot: number): LocalConfig {\\n140:   return { projectId: slotProjectId(slot), apiPort: 0, dbPort: 0 };\\n141: }\\n142: \\n143: /* --------------------------------------------------------------------------- config.toml scan */\\n144: \\n145: interface ConfigEntry {\\n146:   line: number;\\n147:   section: string;\\n148:   key: string;\\n149:   value: string;\\n150: }\\n151: \\n152: /**\\n153:  * Every ACTIVE `key = value` in the file, with the section it sits in. Commented lines are not\\n154:  * settings and are skipped — which is the whole reason the scan is section-aware rather than a\\n155:  * set of regular expressions over the file: `port` appears in nine places and most of them are\\n156:  * examples in comments.\\n157:  *\\n158:  * Multi-line array values are not read as one value. Nothing in this repo's config uses one, and\\n159:  * a value this scanner cannot see is a value it never rewrites, so the failure mode is a config\\n160:  * that is copied verbatim rather than one that is silently mis-edited.\\n161:  */\\n162: export function scanConfig(text: string): ConfigEntry[] {\\n163:   const entries: ConfigEntry[] = [];\\n164:   let section = '';\\n165:   const lines = text.split('\\\\n');\\n166:   for (let index = 0; index < lines.length; index++) {\\n167:     const line = lines[index].trim();\\n168:     if (line.startsWith('#') || line === '') continue;\\n169:     const header = /^\\\\[([^\\\\]]+)\\\\]/.exec(line);\\n170:     if (header) {\\n171:       section = header[1];\\n172:       continue;\\n173:     }\\n174:     const setting = /^([A-Za-z_][A-Za-z0-9_]*)\\\\s*=\\\\s*(.*)$/.exec(line);\\n175:     if (setting) entries.push({ line: index, section, key: setting[1], value: setting[2].trim() });\\n176:   }\\n177:   return entries;\\n178: }\\n179: \\n180: function isPortKey(key: string): boolean {\\n181:   return key === 'port' || key.endsWith('_port');\\n182: }\\n183: \\n184: /**\\n185:  * THE LOCAL STACK'S OWN LISTENER PORTS — the only ports a slot's identity moves (ruling E4).\\n186:  *\\n187:  * A `config.toml` holds two kinds of port. A LISTENER port is a socket this machine opens for\\n188:  * this stack, so two stacks that share one collide, and the overlay must move it. A CLIENT port\\n189:  * is part of an address of somebody else's service — `[auth.email.smtp] port = 587` is Postmark's\\n190:  * port, not ours — so it is DATA, and moving it or refusing it would break a slot that is\\n191:  * configured exactly like the tree it grades.\\n192:  *\\n193:  * The list is exact section + key pairs, so `[api] port` moves while `[api.tls] port` (were one\\n194:  * added) does not silently inherit the rule.\\n195:  */\\n196: const LISTENER_PORTS: readonly { section: string; key: string }[] = [\\n197:   { section: 'api', key: 'port' },\\n198:   { section: 'db', key: 'port' },\\n199:   { section: 'db', key: 'shadow_port' },\\n200:   { section: 'db.pooler', key: 'port' },\\n201:   { section: 'studio', key: 'port' },\\n202:   { section: 'local_smtp', key: 'port' },\\n203:   { section: 'local_smtp', key: 'smtp_port' },\\n204:   { section: 'local_smtp', key: 'pop3_port' },\\n205:   { section: 'analytics', key: 'port' },\\n206:   { section: 'edge_runtime', key: 'inspector_port' },\\n207: ];\\n208: \\n209: function isListenerPort(section: string, key: string): boolean {\\n210:   return LISTENER_PORTS.some((listener) => listener.section === section && listener.key === key);\\n211: }\\n212: \\n213: export interface PortMapping {\\n214:   section: string;\\n215:   key: string;\\n216:   line: number;\\n217:   from: number;\\n218:   to: number;\\n219: }\\n220: \\n221: /**\\n222:  * The identity overlay's port rule (ruling E4).\\n223:  *\\n224:  *   - a LISTENER port (see `LISTENER_PORTS`) in 54000–54999 moves by 1000 per slot;\\n225:  *     `edge_runtime.inspector_port` set to EXACTLY 8083 moves by 10 per slot, because the ruled\\n226:  *     inspector value is 8083 and it is not in that band. Any OTHER inspector value falls to the\\n227:  *     generic rule below, so it maps when it is in band and refuses when it is not — a +10 applied\\n228:  *     to a value nobody ruled is a guess, and D2 forbids guesses.\\n229:  *   - a listener port outside those bands REFUSES loudly as unmappable. A guess here is a port\\n230:  *     collision with software nobody in this process knows about, so a person decides.\\n231:  *   - any OTHER port-valued key passes through unchanged: it addresses somebody else's service and\\n232:  *     is data, not identity.\\n233:  *   - except that a non-listener port sitting in 54000–54999 also REFUSES. It looks exactly like a\\n234:  *     local stack port and this rule does not recognise it, and treating an unrecognised local port\\n235:  *     as data would hand two slots the same socket. Fail closed, and a person decides.\\n236:  *\\n237:  * `personalBlockProblems` stays broad over EVERY port key regardless of this rule, so a port in the\\n238:  * founder's own block can never reach a slot by being classified as data.\\n239:  */\\n240: export function portMappings(text: string, slot: number): { mappings: PortMapping[]; problems: string[] } {\\n241:   assertSlotNumber(slot);\\n242:   const mappings: PortMapping[] = [];\\n243:   const problems: string[] = [];\\n244: \\n245:   for (const entry of scanConfig(text)) {\\n246:     if (!isPortKey(entry.key)) continue;\\n247:     const literal = /^(\\\\d+)/.exec(entry.value);\\n248:     const from = literal ? Number(literal[1]) : NaN;\\n249:     const listener = isListenerPort(entry.section, entry.key);\\n250: \\n251:     if (!listener) {\\n252:       if (Number.isFinite(from) && from >= MAPPABLE_PORT_LOW && from <= MAPPABLE_PORT_HIGH) {\\n253:         problems.push(\\n254:           `[${entry.section}] ${entry.key} = ${from} is not a listener port this rule knows, but it sits in the local ` +\\n255:             `stack's band ${MAPPABLE_PORT_LOW}–${MAPPABLE_PORT_HIGH} — decide by hand whether the slot moves it`,\\n256:         );\\n257:       }\\n258:       continue; // a client-connection port is data and travels unchanged\\n259:     }\\n260: \\n261:     if (!literal) {\\n262:       problems.push(`[${entry.section}] ${entry.key} = ${entry.value} is not a plain port number, so the slot overlay cannot move it`);\\n263:       continue;\\n264:     }\\n265:     if (entry.section === 'edge_runtime' && entry.key === 'inspector_port' && from === PERSONAL_INSPECTOR_PORT) {\\n266:       mappings.push({ section: entry.section, key: entry.key, line: entry.line, from, to: from + slot * 10 });\\n267:       continue;\\n268:     }\\n269:     if (from >= MAPPABLE_PORT_LOW && from <= MAPPABLE_PORT_HIGH) {\\n270:       mappings.push({ section: entry.section, key: entry.key, line: entry.line, from, to: from + slot * 1000 });\\n271:       continue;\\n272:     }\\n273:     problems.push(\\n274:       `[${entry.section}] ${entry.key} = ${from} is outside ${MAPPABLE_PORT_LOW}–${MAPPABLE_PORT_HIGH}, so the slot ` +\\n275:         `overlay does not know where to move it — decide the slot's port for this setting by hand`,\\n276:     );\\n277:   }\\n278: \\n279:   return { mappings, problems };\\n280: }\\n281: \\n282: /**\\n283:  * The item tree's own config, wearing the slot's identity. Everything that is not an identity\\n284:  * field is returned byte for byte, including comments, blank lines and line endings — a\\n285:  * regenerated config differing anywhere else would mean the slot grades different behaviour from\\n286:  * the tree that asked for the run.\\n287:  */\\n288: export function generateSlotConfig(sourceText: string, slot: number): string {\\n289:   assertSlotNumber(slot);\\n290:   const { mappings, problems } = portMappings(sourceText, slot);\\n291:   if (problems.length) {\\n292:     throw new Error(`the slot ${slot} config cannot be generated from this supabase/config.toml — ${problems.join('; ')}`);\\n293:   }\\n294: \\n295:   const projectIdEntry = scanConfig(sourceText).find((entry) => entry.section === '' && entry.key === 'project_id');\\n296:   if (!projectIdEntry) throw new Error('supabase/config.toml carries no top-level project_id, so a slot identity cannot be built from it');\\n297: \\n298:   const lines = sourceText.split('\\\\n');\\n299:   lines[projectIdEntry.line] = lines[projectIdEntry.line].replace(/^(\\\\s*project_id\\\\s*=\\\\s*)\\\"[^\\\"]*\\\"/, `$1\\\"${slotProjectId(slot)}\\\"`);\\n300:   for (const mapping of mappings) {\\n301:     const pattern = new RegExp(`^(\\\\\\\\s*${mapping.key}\\\\\\\\s*=\\\\\\\\s*)\\\\\\\\d+`);\\n302:     lines[mapping.line] = lines[mapping.line].replace(pattern, `$1${mapping.to}`);\\n303:   }\\n304:   return lines.join('\\\\n');\\n305: }\\n306: \\n307: /* ------------------------------------------------------- the personal stack, refused in code */\\n308: \\n309: /**\\n310:  * The \\\"untouchable\\\" ruling as an executable guard. Called before every destructive act and before\\n311:  * any env is emitted, because a convention that is only written down is one a later change can\\n312:  * step over without noticing.\\n313:  *\\n314:  * It scans EVERY active port-valued key, not a fixed list: the danger is a port in the personal\\n315:  * block reaching a slot, and it does not matter which setting carried it there.\\n316:  */\\n317: export function personalBlockProblems(slotConfigText: string, personalProjectId: string): string[] {\\n318:   const problems: string[] = [];\\n319:   const entries = scanConfig(slotConfigText);\\n320: \\n321:   const projectId = entries.find((entry) => entry.section === '' && entry.key === 'project_id');\\n322:   const value = /^\\\"([^\\\"]*)\\\"/.exec(projectId?.value ?? '')?.[1] ?? '';\\n323:   if (!value) problems.push('the slot config carries no project_id, so it cannot be told apart from the personal stack');\\n324:   else if (value === personalProjectId) problems.push(`the slot config carries the personal stack's project id \\\"${personalProjectId}\\\"`);\\n325: \\n326:   for (const entry of entries) {\\n327:     if (!isPortKey(entry.key)) continue;\\n328:     const port = Number(/^(\\\\d+)/.exec(entry.value)?.[1] ?? NaN);\\n329:     if (!Number.isFinite(port)) continue;\\n330:     if (port >= PERSONAL_PORT_LOW && port <= PERSONAL_PORT_HIGH) {\\n331:       problems.push(`[${entry.section}] ${entry.key} = ${port} is inside the personal stack's port block ${PERSONAL_PORT_LOW}–${PERSONAL_PORT_HIGH}`);\\n332:     }\\n333:     if (entry.key === 'inspector_port' && port === PERSONAL_INSPECTOR_PORT) {\\n334:       problems.push(`[${entry.section}] inspector_port = ${port} is the personal stack's inspector port`);\\n335:     }\\n336:   }\\n337: \\n338:   return problems;\\n339: }\\n340: \\n341: /** The identity the pool must never wear. Read from the item tree, never hard-coded. */\\n342: export function personalProjectId(itemRoot: string = REPO_ROOT): string {\\n343:   return readLocalConfig(itemRoot).projectId;\\n344: }\\n345: \\n346: function refusePersonal(slotConfigText: string, itemRoot: string, act: string): void {\\n347:   const problems = personalBlockProblems(slotConfigText, personalProjectId(itemRoot));\\n348:   if (problems.length) {\\n349:     throw new Error(\\n350:       `refusing to ${act}: this configuration is not provably outside the founder's personal stack. ` +\\n351:         `Failed checks: ${problems.join('; ')}. The personal stack is untouchable, so nothing was done.`,\\n352:     );\\n353:   }\\n354: }\\n355: \\n356: /**\\n357:  * The same guard, over a slot's config AS IT SITS ON DISK (rulings T7 and F1).\\n358:  *\\n359:  * `occupy` and `prepare` run the guard over text they hold in hand. The other three entry points —\\n360:  * reset, stop and the env emitter — are exported and reachable directly, so each runs the guard\\n361:  * for itself over the file. A guard that only the usual caller runs is a convention, not a guard.\\n362:  */\\n363: function refusePersonalSlotConfig(slot: number, itemRoot: string, act: string): void {\\n364:   const configPath = slotConfigPath(slot);\\n365:   if (!existsSync(configPath)) {\\n366:     throw new Error(\\n367:       `refusing to ${act} slot ${slot}: it has no config at ${configPath}, so it cannot be shown to be outside the ` +\\n368:         `founder's personal stack. Run \\\\`bun tests/at/harness/db-pool.ts setup\\\\`. Nothing was done.`,\\n369:     );\\n370:   }\\n371:   refusePersonal(readFileSync(configPath, 'utf8'), itemRoot, `${act} slot ${slot}`);\\n372: }\\n373: \\n374: /* ------------------------------------------------------------------------- the path closure */\\n375: \\n376: /** Config settings whose value names a file or directory the stack has to be able to read. */\\n377: const PATH_KEYS = new Set([\\n378:   'sql_paths',\\n379:   'schema_paths',\\n380:   'content_path',\\n381:   'cert_path',\\n382:   'key_path',\\n383:   'signing_keys_path',\\n384:   'objects_path',\\n385:   'declarative_schema_path',\\n386: ]);\\n387: \\n388: function stringValues(raw: string): string[] {\\n389:   const array = /^\\\\[(.*)\\\\]$/.exec(raw);\\n390:   const body = array ? array[1] : raw;\\n391:   return [...body.matchAll(/\\\"([^\\\"]*)\\\"/g)].map((match) => match[1]).filter((value) => value.trim() !== '');\\n392: }\\n393: \\n394: /**\\n395:  * Fail closed on what the config asks for but the mirror cannot deliver.\\n396:  *\\n397:  * `prepare` mirrors the item tree's whole `supabase/` directory into the slot, so every path\\n398:  * UNDER that directory is provided exactly as the item tree has it — present if present, absent\\n399:  * if absent. A configured path that is absent in the item tree is therefore not a problem: the\\n400:  * slot is then in the same state the repo-configured stack would be in, which is the state the\\n401:  * item asked for. (`[db.seed] sql_paths = [\\\"./seed.sql\\\"]` with no `seed.sql` in the tree is\\n402:  * exactly today's arrangement on the personal stack.)\\n403:  *\\n404:  * A path that points OUTSIDE `supabase/` is a different thing: the mirror cannot deliver it, so\\n405:  * the slot would start half-provisioned and grade against a file it does not have. That refuses\\n406:  * loudly and a person decides. The same applies to the two directories the mirror EXCLUDES\\n407:  * (`MIRROR_EXCLUSIONS`): a config that names a file inside the CLI's own runtime state is naming\\n408:  * something the slot will not have, so the closure stays honest about the exclusions.\\n409:  *\\n410:  * A VALUE THIS SCANNER CANNOT SEE REFUSES rather than passing. `scanConfig` reads one line per\\n411:  * setting, so a multi-line array — `sql_paths = [` on its own line — yields the value `[` and no\\n412:  * paths at all. For the OVERLAY an invisible value is harmless: it is copied verbatim. For the\\n413:  * CLOSURE it is a missed refusal, which is the failure this function exists to prevent.\\n414:  */\\n415: export function pathClosureProblems(configText: string, itemRoot: string): string[] {\\n416:   const problems: string[] = [];\\n417:   const base = resolve(join(itemRoot, 'supabase'));\\n418: \\n419:   for (const entry of scanConfig(configText)) {\\n420:     if (!PATH_KEYS.has(entry.key)) continue;\\n421:     if (entry.value.startsWith('[') && !entry.value.includes(']')) {\\n422:       problems.push(\\n423:         `[${entry.section}] ${entry.key} opens an array that does not close on the same line, so this check ` +\\n424:           `cannot see the paths it names — write the value on one line (${entry.key} = [\\\"./a.sql\\\", \\\"./b.sql\\\"]) ` +\\n425:           `and run this again`,\\n426:       );\\n427:       continue;\\n428:     }\\n429:     for (const value of stringValues(entry.value)) {\\n430:       if (/^[a-z][a-z0-9+.-]*:\\\\/\\\\//i.test(value)) {\\n431:         problems.push(`[${entry.section}] ${entry.key} names \\\"${value}\\\", which is a URL rather than a file the slot can be given`);\\n432:         continue;\\n433:       }\\n434:       if (isAbsolute(value)) {\\n435:         problems.push(`[${entry.section}] ${entry.key} names the absolute path \\\"${value}\\\", which the slot mirror cannot reproduce`);\\n436:         continue;\\n437:       }\\n438:       const target = resolve(base, value);\\n439:       const inside = relative(base, target);\\n440:       if (inside.startsWith('..')) {\\n441:         problems.push(\\n442:           `[${entry.section}] ${entry.key} names \\\"${value}\\\", which is outside supabase/ — the slot mirror copies supabase/ ` +\\n443:             `and nothing else, so this file would be missing from the slot`,\\n444:         );\\n445:         continue;\\n446:       }\\n447:       const first = inside.split(/[\\\\\\\\/]/)[0];\\n448:       if (MIRROR_EXCLUSIONS.includes(first)) {\\n449:         problems.push(\\n450:           `[${entry.section}] ${entry.key} names \\\"${value}\\\", which resolves into supabase/${first} — the slot mirror ` +\\n451:             `deliberately does not copy that directory (it is the CLI's own runtime state about another stack), so ` +\\n452:             `this file would be missing from the slot`,\\n453:         );\\n454:       }\\n455:     }\\n456:   }\\n457: \\n458:   return problems;\\n459: }\\n460: \\n461: /* -------------------------------------------------------------------------------- the mirror */\\n462: \\n463: /**\\n464:  * What the mirror does NOT carry into a slot (rulings T3, F3 and T11). Top-level entries of\\n465:  * `supabase/` only, so the list cannot quietly grow into a filter on file names.\\n466:  *\\n467:  *   - `.temp` and `.branches` are the CLI's OWN RUNTIME STATE, not project source. `.temp` holds\\n468:  *     the CLI's record of the stack it last ran — the founder's personal one — and `.gitignore`\\n469:  *     itself says its `start-secrets/**` \\\"must NEVER be committed\\\". Copying it carries another\\n470:  *     stack's identity residue and its secrets into every slot.\\n471:  *   - `config.toml` is the slot's IDENTITY, and the item tree's copy carries the personal\\n472:  *     identity. Excluding it means no slot config ever holds that identity, not even for the\\n473:  *     instant between the mirror and the regenerated write — and a crash in that instant leaves\\n474:  *     NO config rather than a personal one.\\n475:  */\\n476: export const MIRROR_EXCLUSIONS: readonly string[] = ['.temp', '.branches', 'config.toml'];\\n477: \\n478: /**\\n479:  * Every symlink under a directory tree. A pre-copy scan, because a symlink is not a file the\\n480:  * mirror can reproduce: `cpSync` would copy it as a link, and the link points wherever it likes —\\n481:  * including straight back at the personal stack's own directory.\\n482:  */\\n483: function symlinksUnder(dir: string): string[] {\\n484:   const found: string[] = [];\\n485:   const walk = (current: string): void => {\\n486:     for (const entry of readdirSync(current, { withFileTypes: true })) {\\n487:       const full = join(current, entry.name);\\n488:       if (entry.isSymbolicLink()) {\\n489:         found.push(full);\\n490:         continue; // never follow it — that is the whole point\\n491:       }\\n492:       if (entry.isDirectory()) walk(full);\\n493:     }\\n494:   };\\n495:   walk(dir);\\n496:   return found;\\n497: }\\n498: \\n499: /**\\n500:  * Copy the item tree's `supabase/` into the slot, having first removed the slot's copy.\\n501:  *\\n502:  * DELETE THEN COPY, never merge: the previous holder's leftover migration or leftover function is\\n503:  * exactly the state this pool exists to make impossible.\\n504:  *\\n505:  * THE PROJECT SOURCE ENTIRE, and nothing else (ruling E3 as narrowed by T3, F3 and T11). Every\\n506:  * path the config names under `supabase/` arrives in the slot exactly as the item tree has it —\\n507:  * present if present, absent if absent — and `pathClosureProblems` refuses any config path that\\n508:  * names one of the three excluded entries, so the closure guarantee stays honest about them.\\n509:  * (`README.md` and `.gitkeep` therefore travel into the slot's `migrations/` too. The CLI reads\\n510:  * only `<timestamp>_name.sql` there, and the runner's migration proof counts exactly those.)\\n511:  *\\n512:  * A SYMLINK ANYWHERE UNDER `supabase/` REFUSES THE WHOLE MIRROR (ruling T13). The tree carries\\n513:  * none today, so nothing breaks; one smuggled in later refuses loudly instead of being copied as\\n514:  * a link into a directory the pool then resets.\\n515:  */\\n516: export function mirrorItemTree(itemRoot: string, slot: number): void {\\n517:   const source = join(itemRoot, 'supabase');\\n518:   const destination = join(slotDir(slot), 'supabase');\\n519:   if (!existsSync(source)) throw new Error(`${source} does not exist — there is no project to give the slot`);\\n520: \\n521:   const links = symlinksUnder(source);\\n522:   if (links.length) {\\n523:     throw new Error(\\n524:       `refusing to mirror ${source} into slot ${slot}: it contains ${links.length} symlink(s) — ${links.join(', ')}. ` +\\n525:         `A symlink is not a file the mirror can reproduce, and a link copied into a slot points wherever it likes, ` +\\n526:         `including outside the pool. Replace them with real files, or decide by hand. Nothing was copied.`,\\n527:     );\\n528:   }\\n529: \\n530:   rmSync(destination, { recursive: true, force: true });\\n531:   mkdirSync(destination, { recursive: true });\\n532:   cpSync(source, destination, {\\n533:     recursive: true,\\n534:     filter: (from: string) => {\\n535:       const inside = relative(source, from);\\n536:       if (inside === '') return true;\\n537:       return !MIRROR_EXCLUSIONS.includes(inside.split(/[\\\\\\\\/]/)[0]);\\n538:     },\\n539:   });\\n540: }\\n541: \\n542: /* --------------------------------------------------------------------------- the reservation */\\n543: \\n544: export interface Reservation {\\n545:   slot: number;\\n546:   item: string;\\n547:   branch: string;\\n548:   at: string;\\n549:   holder: string;\\n550: }\\n551: \\n552: export function readReservation(slot: number): Reservation | null {\\n553:   try {\\n554:     return JSON.parse(readFileSync(reservationPath(slot), 'utf8')) as Reservation;\\n555:   } catch {\\n556:     return null;\\n557:   }\\n558: }\\n559: \\n560: /** The slot reserved for this item, or null. Derived from the file, never declared by a caller. */\\n561: export function slotForItem(item: string): number | null {\\n562:   for (let slot = 1; slot <= POOL_SIZE; slot++) {\\n563:     if (readReservation(slot)?.item === item) return slot;\\n564:   }\\n565:   return null;\\n566: }\\n567: \\n568: /**\\n569:  * The item id a branch names — a pure function over the branch string, and it FAILS CLOSED.\\n570:  *\\n571:  * Exactly one id, or it refuses naming the condition. Never the first match of several: a branch\\n572:  * carrying two ids is a question about which item is being verified, and answering it by\\n573:  * position would attach a run, a reservation and a database to the wrong item silently.\\n574:  */\\n575: export function itemFromBranch(branch: string): string {\\n576:   const raw = String(branch ?? '').trim();\\n577:   if (raw === '') throw new Error('the branch name is empty, so no item id can be derived from it');\\n578:   if (raw === 'HEAD') throw new Error('HEAD is detached, so the branch names no item — check out the item branch, or set AT_DB_SLOT');\\n579: \\n580:   const ids = [...new Set([...raw.matchAll(/\\\\b(ai4dev|ai4pm)-(\\\\d+)\\\\b/gi)].map((match) => `${match[1].toUpperCase()}-${Number(match[2])}`))];\\n581:   if (ids.length === 0) throw new Error(`the branch \\\"${raw}\\\" names no item id, so no reserved slot can be found for it`);\\n582:   if (ids.length > 1) throw new Error(`the branch \\\"${raw}\\\" names ${ids.length} item ids (${ids.join(', ')}) — a person decides which one this run verifies`);\\n583:   return ids[0];\\n584: }\\n585: \\n586: /** The branch this tree is on. A git failure refuses; it never falls back to a guess. */\\n587: export function currentBranch(root: string = REPO_ROOT): string {\\n588:   const res = spawnSync('git', ['-C', root, 'rev-parse', '--abbrev-ref', 'HEAD'], { encoding: 'utf8', env: childEnv() });\\n589:   if (res.error) throw new Error(`git could not be run to read the current branch (${diagnostic((res.error as Error).message)})`);\\n590:   if (res.status !== 0) throw new Error(`git could not report the current branch (exit ${res.status}): ${diagnostic(res.stderr) || '(no error output)'}`);\\n591:   return (res.stdout ?? '').trim();\\n592: }\\n593: \\n594: /* ------------------------------------------------------------------------------- the pool view */\\n595: \\n596: export interface PoolSlotView {\\n597:   slot: number;\\n598:   dir: string;\\n599:   configured: boolean;\\n600:   projectId: string | null;\\n601:   apiPort: number | null;\\n602:   dbPort: number | null;\\n603:   reservation: Reservation | null;\\n604:   occupiedBy: Holder | null;\\n605: }\\n606: \\n607: /** What the pool looks like right now — for the setup report, the helpers, and a person asking. */\\n608: export function readPool(): PoolSlotView[] {\\n609:   const views: PoolSlotView[] = [];\\n610:   for (let slot = 1; slot <= POOL_SIZE; slot++) {\\n611:     const dir = slotDir(slot);\\n612:     let config: LocalConfig | null = null;\\n613:     try {\\n614:       config = readLocalConfig(dir);\\n615:     } catch {\\n616:       config = null;\\n617:     }\\n618:     // The claim is keyed on the slot's PERMANENT identity (ruling T6), so this read finds it even\\n619:     // when the slot has no config yet and even after `prepare` has moved the slot's ports.\\n620:     let occupiedBy: Holder | null = null;\\n621:     try {\\n622:       occupiedBy = JSON.parse(readFileSync(stackLockPath(slotClaimKey(slot)), 'utf8')) as Holder;\\n623:     } catch {\\n624:       occupiedBy = null;\\n625:     }\\n626:     views.push({\\n627:       slot,\\n628:       dir,\\n629:       configured: config !== null,\\n630:       projectId: config?.projectId ?? null,\\n631:       apiPort: config?.apiPort ?? null,\\n632:       dbPort: config?.dbPort ?? null,\\n633:       reservation: readReservation(slot),\\n634:       occupiedBy,\\n635:     });\\n636:   }\\n637:   return views;\\n638: }\\n639: \\n640: /* ---------------------------------------------------------------------------------- occupancy */\\n641: \\n642: export interface Occupancy {\\n643:   slot: number;\\n644:   dir: string;\\n645:   config: LocalConfig;\\n646:   /** The item this occupancy belongs to, or `null` when it came from the AT_DB_SLOT override. */\\n647:   item: string | null;\\n648:   via: 'reservation' | 'override';\\n649:   claim: StackLock;\\n650:   release(): void;\\n651: }\\n652: \\n653: export interface OccupyOptions {\\n654:   /** The item id. Derived from the branch when absent. */\\n655:   item?: string;\\n656:   /** The AT_DB_SLOT override — for runs outside an item: the founder, the evidence gate, a spike. */\\n657:   slot?: number;\\n658: }\\n659: \\n660: /**\\n661:  * Take a slot for one verify window.\\n662:  *\\n663:  * ADMISSION CONTROL IS THE COORDINATOR'S, NOT THE RUNNER'S. A run whose item holds no reservation\\n664:  * refuses and names the helper that makes one; it never falls back onto a free slot, because a\\n665:  * silent fallback is how a pool of two quietly becomes a pool of one shared stack.\\n666:  *\\n667:  * The claim is the runner's existing stack lock, with the takeover policy the ruled text asks\\n668:  * for: a DEAD holder pid is broken loudly, a live holder is never displaced at any age.\\n669:  *\\n670:  * THE OVERRIDE SKIPS ADMISSION CONTROL, NOT OWNERSHIP (ruling T5). `AT_DB_SLOT` is ruled — the\\n671:  * founder, the evidence gate and the spike all use it — and slot STATE is disposable by design, so\\n672:  * the reservation is not what protects a slot; the occupancy claim is, and the override keeps it.\\n673:  * But taking a slot another item is holding is a silent collision and costs nothing to refuse, so\\n674:  * an override run refuses loudly when the target slot's reservation names a DIFFERENT item than\\n675:  * this run can derive. A run that can derive no item at all treats ANY reservation as foreign.\\n676:  */\\n677: export function occupy(requirement: string, options: OccupyOptions = {}): Occupancy {\\n678:   let slot: number;\\n679:   let item: string | null = null;\\n680:   let via: 'reservation' | 'override';\\n681: \\n682:   if (options.slot !== undefined) {\\n683:     slot = assertSlotNumber(options.slot);\\n684:     item = options.item ?? null;\\n685:     via = 'override';\\n686: \\n687:     let derived: string | null = options.item ?? null;\\n688:     if (derived === null) {\\n689:       try {\\n690:         derived = itemFromBranch(currentBranch());\\n691:       } catch {\\n692:         derived = null; // no item derivable — every reservation is then somebody else's\\n693:       }\\n694:     }\\n695:     const reserved = readReservation(slot);\\n696:     if (reserved && reserved.item !== derived) {\\n697:       throw new Error(\\n698:         `refusing to take slot ${slot} with AT_DB_SLOT: it is reserved for ${reserved.item} ` +\\n699:           `(branch ${reserved.branch || 'unrecorded'}, taken ${reserved.at}, holder ${reserved.holder}) and this run ` +\\n700:           `${derived === null ? 'can derive no item of its own' : `belongs to ${derived}`}. Every occupancy resets the ` +\\n701:           `slot's database from its own tree, so this run would rebuild that item's database under it. Use a slot the ` +\\n702:           `pool shows free, or release that reservation first.`,\\n703:       );\\n704:     }\\n705:   } else {\\n706:     item = options.item ?? itemFromBranch(currentBranch());\\n707:     const reserved = slotForItem(item);\\n708:     if (reserved === null) {\\n709:       throw new Error(\\n710:         `no database slot is reserved for ${item}. The coordinator reserves a slot when the item starts — ` +\\n711:           `run \\\\`Reserve-DbSlot -Item ${item}\\\\` from loop/work/db-slots.ps1, or set AT_DB_SLOT=<n> for a run ` +\\n712:           `outside an item. There is deliberately no fallback onto a free slot: admission control belongs to ` +\\n713:           `the coordinator, not to this run.`,\\n714:       );\\n715:     }\\n716:     slot = reserved;\\n717:     via = 'reservation';\\n718:   }\\n719: \\n720:   const dir = slotDir(slot);\\n721:   const configPath = slotConfigPath(slot);\\n722:   if (!existsSync(configPath)) {\\n723:     // TWO CAUSES, and the repair is the same one command (ruling T11). Either the pool was never\\n724:     // set up on this machine, or a `prepare` died between the mirror — which removes the slot's\\n725:     // config on purpose, so no slot ever holds the personal identity — and the regenerated write\\n726:     // that immediately follows it. A missing config is the safe end of that window, never a wrong\\n727:     // one, and it is not permanent.\\n728:     throw new Error(\\n729:       `slot ${slot} has no config at ${configPath}. Either the pool was never set up on this machine, or a ` +\\n730:         `previous run stopped between the mirror and the write that follows it — the mirror removes the slot's ` +\\n731:         `config on purpose, so a slot never carries the personal identity even for an instant. Either way the ` +\\n732:         `repair is one command: \\\\`bun tests/at/harness/db-pool.ts setup\\\\`.`,\\n733:     );\\n734:   }\\n735:   refusePersonal(readFileSync(configPath, 'utf8'), REPO_ROOT, `occupy slot ${slot}`);\\n736: \\n737:   const config = readLocalConfig(dir);\\n738:   // Keyed on the slot's PERMANENT identity, never on the config's current ports (ruling T6).\\n739:   const claim = acquireStackLock(slotClaimKey(slot), requirement, { takeover: 'dead-pid-only' });\\n740: \\n741:   // The reservation is re-read AFTER the claim. Between the lookup above and this line the\\n742:   // coordinator may have released the slot and given it to another item, and a run that resets a\\n743:   // database another item now owns is the exact collision this pool exists to prevent.\\n744:   if (via === 'reservation' && item !== null) {\\n745:     const still = readReservation(slot);\\n746:     if (still?.item !== item) {\\n747:       claim.release();\\n748:       throw new Error(\\n749:         `slot ${slot} was reserved for ${item} when this run started and now names ${still?.item ?? 'nobody'} — ` +\\n750:           `the reservation changed under the run, so nothing was reset and nothing was run.`,\\n751:       );\\n752:     }\\n753:   }\\n754: \\n755:   return {\\n756:     slot,\\n757:     dir,\\n758:     config,\\n759:     item,\\n760:     via,\\n761:     claim,\\n762:     release: () => claim.release(),\\n763:   };\\n764: }\\n765: \\n766: /** Release an occupancy. Null-safe so it can sit in a `finally` beside a claim that never happened. */\\n767: export function release(occupancy: Occupancy | null | undefined): void {\\n768:   occupancy?.release();\\n769: }\\n770: \\n771: /* ----------------------------------------------------------------------------------- prepare */\\n772: \\n773: export interface PrepareResult {\\n774:   status: StackStatus;\\n775:   migrations: MigrationProof;\\n776:   /** True when the slot's stack had to be restarted because its configuration changed. */\\n777:   restarted: boolean;\\n778: }\\n779: \\n780: interface StartMarker {\\n781:   configHash: string;\\n782:   at: string;\\n783:   pid: number;\\n784: }\\n785: \\n786: function hashConfig(text: string): string {\\n787:   return createHash('sha256').update(text, 'utf8').digest('hex');\\n788: }\\n789: \\n790: function readMarker(slot: number): StartMarker | null {\\n791:   try {\\n792:     return JSON.parse(readFileSync(slotMarkerPath(slot), 'utf8')) as StartMarker;\\n793:   } catch {\\n794:     return null;\\n795:   }\\n796: }\\n797: \\n798: /**\\n799:  * Run the pinned CLI against one slot. Raw output is never printed: `supabase start` prints keys.\\n800:  *\\n801:  * THIS IS THE ONE HELPER (ruling E1, decision D13). No role hand-writes a slot CLI command: the\\n802:  * incident of 2026-08-09 was a hand-written spike script that closed neither route the identity\\n803:  * override travels by, and it destroyed the founder's database. Everything the wall is made of\\n804:  * lives in `supabaseInvocation` in runner.ts — the positive `SUPABASE_PROJECT_ID`, the refusal of\\n805:  * any other `SUPABASE_*`, `bun --no-env-file`, and the working directory equal to `--workdir` —\\n806:  * and `slotTarget` is the only thing this file has to get right.\\n807:  *\\n808:  * It is for commands that must EXIT ZERO. `status` does not (the config disables imgproxy and the\\n809:  * pooler), so the identity read below runs the CLI through the same seam and parses the result\\n810:  * with the runner's own parser instead.\\n811:  */\\n812: function runSlotCli(slot: number, args: string[], what: string): void {\\n813:   const res = runSupabaseCli(slotTarget(slot), args);\\n814:   if (res.error) {\\n815:     throw new Error(`could not launch the Supabase CLI to ${what} slot ${slot} (${diagnostic(res.error.message)})`);\\n816:   }\\n817:   if (res.status !== 0) {\\n818:     throw new Error(`\\\\`supabase ${args.join(' ')}\\\\` could not ${what} slot ${slot} (exit ${res.status}): ${diagnostic(res.stderr) || diagnostic(res.stdout) || '(no error output)'}`);\\n819:   }\\n820: }\\n821: \\n822: /** Both halves of a slot's identity, in the shape the shared CLI seam takes. */\\n823: export function slotTarget(slot: number): CliTarget {\\n824:   return { workdir: slotDir(slot), projectId: slotProjectId(slot) };\\n825: }\\n826: \\n827: /**\\n828:  * The Supabase container names in a piece of CLI output that do NOT belong to this slot.\\n829:  *\\n830:  * The CLI names its containers `supabase_<service>_<project id>`, and it prints them: a healthy\\n831:  * `supabase status` opens with `Stopped services: [supabase_imgproxy_<id> supabase_pooler_<id>]`,\\n832:  * and its error paths say things like `No such container: supabase_db_<id>`. That line is the\\n833:  * CLI's own statement of WHICH PROJECT it resolved, and it is the instrument that would have\\n834:  * caught the incident: on 2026-08-10 a hybrid invocation reported the slot's ports beside\\n835:  * `supabase_imgproxy_poancmeitlmxejofwzuu` — the personal project — in the same output.\\n836:  *\\n837:  * The rule is a suffix match and it is deliberately strict: a `supabase_…` token that does not end\\n838:  * in this slot's project id is reported, whatever it is. A false report costs a loud refusal on a\\n839:  * read; a missed one costs a database.\\n840:  */\\n841: export function foreignContainerNames(text: string, slotProject: string): string[] {\\n842:   const names = [...String(text ?? '').matchAll(/\\\\bsupabase_[A-Za-z0-9][A-Za-z0-9_.-]*/g)].map((match) => match[0]);\\n843:   return [...new Set(names.filter((name) => !name.endsWith(`_${slotProject}`)))];\\n844: }\\n845: \\n846: /**\\n847:  * The Supabase container names in a piece of CLI output that DO belong to this slot — the positive\\n848:  * half of the same instrument (ruling T2).\\n849:  *\\n850:  * MEASURED BEFORE THIS WAS WRITTEN, 2026-08-10, read-only, both slots: `status -o json` through the\\n851:  * shared helper prints exactly two such tokens on stderr —\\n852:  * `Stopped services: [supabase_imgproxy_ai4good-slot-N supabase_pooler_ai4good-slot-N]` — and zero\\n853:  * tokens that belong to any other project. So the evidence this check demands is evidence the CLI\\n854:  * really does produce.\\n855:  *\\n856:  * Absence is not innocence: `foreignContainerNames` finds nothing in an output that names no\\n857:  * container at all, which is exactly the hybrid shape the 2026-08-09 incident wore (the slot's\\n858:  * ports beside another project's containers). A destructive act therefore requires at least one\\n859:  * name that IS this slot's, never merely the lack of one that is not.\\n860:  *\\n861:  * Residual, recorded rather than hidden: those two tokens exist because the tracked config disables\\n862:  * imgproxy and the pooler. A config that enables both would print no \\\"Stopped services\\\" line, this\\n863:  * check would find no evidence, and the destructive act would REFUSE. That is the fail-closed\\n864:  * direction (ruling E7) and it is loud, but it is a real coupling to the config and to the pinned\\n865:  * CLI's output shape (residual F4 in the plan).\\n866:  */\\n867: export function ownContainerNames(text: string, slotProject: string): string[] {\\n868:   const names = [...String(text ?? '').matchAll(/\\\\bsupabase_[A-Za-z0-9][A-Za-z0-9_.-]*/g)].map((match) => match[0]);\\n869:   return [...new Set(names.filter((name) => name.endsWith(`_${slotProject}`)))];\\n870: }\\n871: \\n872: /**\\n873:  * DOCKER'S OWN ANSWER, on the destructive path, every time (ruling T2).\\n874:  *\\n875:  * The CLI's status output is one instrument and it is coupled to the CLI's version. Docker is a\\n876:  * second, independent one: before a reset, docker must show this slot's OWN database container\\n877:  * running. A docker read is the only interaction anything here is permitted to have with the\\n878:  * founder's stack, and it is unrestricted on slots.\\n879:  *\\n880:  * It fails closed. If docker cannot be run, or reports no container of this slot's own, the reset\\n881:  * refuses: an instrument that cannot answer is not an answer of \\\"yes\\\".\\n882:  */\\n883: export function slotDbContainers(slot: number): string[] {\\n884:   const project = slotProjectId(slot);\\n885:   const res = spawnSync('docker', ['ps', '--filter', `name=supabase_db_${project}`, '--format', '{{.Names}}'], {\\n886:     env: childEnv(),\\n887:     encoding: 'utf8',\\n888:   });\\n889:   if (res.error) throw new Error(`docker could not be run to confirm slot ${slot}'s database container (${diagnostic((res.error as Error).message)})`);\\n890:   if (res.status !== 0) throw new Error(`\\\\`docker ps\\\\` exited ${res.status} while confirming slot ${slot}'s database container: ${diagnostic(res.stderr) || '(no error output)'}`);\\n891:   return (res.stdout ?? '')\\n892:     .split('\\\\n')\\n893:     .map((line) => line.trim())\\n894:     .filter(Boolean);\\n895: }\\n896: \\n897: function proveSlotDbContainer(slot: number, act: string): void {\\n898:   const project = slotProjectId(slot);\\n899:   const names = slotDbContainers(slot);\\n900:   const own = names.filter((name) => name.includes(project));\\n901:   if (own.length !== names.length || own.length === 0) {\\n902:     throw new Error(\\n903:       `REFUSING TO ${act.toUpperCase()} SLOT ${slot}: docker does not confirm this slot's own database container. ` +\\n904:         `\\\\`docker ps\\\\` named ${names.length ? names.join(', ') : 'no running container'} for ${project}. ` +\\n905:         `Start the slot (\\\\`bun tests/at/harness/db-pool.ts setup\\\\`) and try again. Nothing was done.`,\\n906:     );\\n907:   }\\n908:   console.log(`db-pool — docker confirms slot ${slot}'s own database container before the ${act}: ${own.join(', ')}`);\\n909: }\\n910: \\n911: export interface SlotIdentityRead {\\n912:   /** The stack's own report, when a stack answered. */\\n913:   status: StackStatus | null;\\n914:   /** Why no stack answered, when none did. Never a mismatch — a mismatch throws. */\\n915:   notRunning: string | null;\\n916: }\\n917: \\n918: /**\\n919:  * THE PRE-DESTRUCTIVE IDENTITY READ (ruling E1, decision D13).\\n920:  *\\n921:  * Before anything destructive, the CLI is asked — through the same helper, so the read and the\\n922:  * destructive act resolve identically — to say what it resolves. Three things must hold, and any\\n923:  * one of them failing refuses loudly and does nothing:\\n924:  *\\n925:  *   1. every Supabase container name in the output belongs to this slot's project;\\n926:  *   2. the founder's personal project id appears nowhere in the output;\\n927:  *   3. the ports and keys the stack reports are the slot's own, loopback, locally issued\\n928:  *      (`localStackProblems`, against the SLOT's config).\\n929:  *\\n930:  * A DESTRUCTIVE act adds a fourth, and it is the one that closes the vacuous pass (ruling T2):\\n931:  *\\n932:  *   4. at least one Supabase container name in the output IS this slot's own.\\n933:  *\\n934:  * The first three can all hold over an output that names no container at all, and an output that\\n935:  * names no container is precisely what the 2026-08-09 hybrid produced when it reported the slot's\\n936:  * ports while resolving another project. Absence of contrary evidence is not identity.\\n937:  *\\n938:  * A stack that is simply not running is not a mismatch: it is reported as `notRunning` so the\\n939:  * caller can decide (there is nothing to stop), and only a real disagreement throws.\\n940:  */\\n941: export function proveSlotTarget(slot: number, act: string, itemRoot: string = REPO_ROOT, destructive = false): SlotIdentityRead {\\n942:   const project = slotProjectId(slot);\\n943:   const res: CliResult = runSupabaseCli(slotTarget(slot), ['status', '-o', 'json']);\\n944:   if (res.error) {\\n945:     throw new Error(`refusing to ${act} slot ${slot}: the Supabase CLI could not be launched to read its identity (${diagnostic(res.error.message)})`);\\n946:   }\\n947: \\n948:   const raw = `${res.stdout}\\\\n${res.stderr}`;\\n949:   const personal = personalProjectId(itemRoot);\\n950:   const foreign = foreignContainerNames(raw, project);\\n951:   const carriesPersonal = personal !== '' && raw.includes(personal);\\n952:   if (foreign.length || carriesPersonal) {\\n953:     throw new Error(\\n954:       `REFUSING TO ${act.toUpperCase()} SLOT ${slot}: the identity read did not resolve to ${project}. ` +\\n955:         (foreign.length ? `The CLI named ${foreign.join(', ')}. ` : '') +\\n956:         (carriesPersonal ? `The founder's personal project id appears in the output. ` : '') +\\n957:         `Nothing was done.`,\\n958:     );\\n959:   }\\n960: \\n961:   let status: StackStatus;\\n962:   try {\\n963:     status = parseStackStatus(res);\\n964:   } catch (err) {\\n965:     return { status: null, notRunning: diagnostic((err as Error).message) };\\n966:   }\\n967: \\n968:   const config = readLocalConfig(slotDir(slot));\\n969:   const problems = localStackProblems(status, config);\\n970:   if (problems.length) {\\n971:     throw new Error(\\n972:       `REFUSING TO ${act.toUpperCase()} SLOT ${slot}: the stack that answered is not provably slot ${slot}'s own. ` +\\n973:         `Failed checks: ${problems.join('; ')}. (Values are deliberately not printed.) Nothing was done.`,\\n974:     );\\n975:   }\\n976: \\n977:   const own = ownContainerNames(raw, project);\\n978:   if (destructive && own.length === 0) {\\n979:     throw new Error(\\n980:       `REFUSING TO ${act.toUpperCase()} SLOT ${slot}: the identity read names no container belonging to ${project}, ` +\\n981:         `so it carries no positive evidence of which project the CLI resolved. The ports alone are not identity — ` +\\n982:         `the 2026-08-09 incident reported the right ports while resolving another project. Nothing was done.`,\\n983:     );\\n984:   }\\n985: \\n986:   console.log(\\n987:     `db-pool — slot ${slot} identity proven before the ${act}: project ${project}, api ${config.apiPort}, db ${config.dbPort}` +\\n988:       (own.length ? `, containers ${own.join(', ')}` : ''),\\n989:   );\\n990:   return { status, notRunning: null };\\n991: }\\n992: \\n993: /**\\n994:  * `db reset` on a slot. THE IDENTITY READ IS INSIDE, so no caller can reach the reset without it —\\n995:  * that is what \\\"structurally on the destructive path\\\" means, as opposed to a rule someone follows.\\n996:  */\\n997: export async function resetSlotDatabase(slot: number, itemRoot: string = REPO_ROOT): Promise<StackStatus> {\\n998:   // The BROAD guard first (rulings T7 and F1). D5's ruled sentence names \\\"occupy, prepare, reset or\\n999:   // emit env\\\", and this is an exported entry point a caller reaches directly — the spike does — so\\n1000:   // it runs the guard itself instead of trusting whoever called it to have run it.\\n1001:   refusePersonalSlotConfig(slot, itemRoot, 'reset');\\n1002:   const read = proveSlotTarget(slot, 'reset', itemRoot, true);\\n1003:   if (!read.status) {\\n1004:     throw new Error(\\n1005:       `refusing to reset slot ${slot}: it reported no running stack, so its identity could not be proven ` +\\n1006:         `(${read.notRunning}). Start the slot first; nothing was reset.`,\\n1007:     );\\n1008:   }\\n1009:   proveSlotDbContainer(slot, 'reset');\\n1010:   await resetLocalDatabase(slotTarget(slot));\\n1011:   return read.status;\\n1012: }\\n1013: \\n1014: /** `stop` on a slot, behind the same guard and the same read. A slot with no stack has nothing to stop. */\\n1015: export function stopSlotStack(slot: number, itemRoot: string = REPO_ROOT): void {\\n1016:   refusePersonalSlotConfig(slot, itemRoot, 'stop');\\n1017:   const read = proveSlotTarget(slot, 'stop', itemRoot, true);\\n1018:   if (!read.status) {\\n1019:     console.log(`db-pool — slot ${slot} reported no running stack (${read.notRunning}); there is nothing to stop`);\\n1020:     return;\\n1021:   }\\n1022:   runSlotCli(slot, ['stop'], 'stop');\\n1023: }\\n1024: \\n1025: /** `start` on a slot. Not destructive, and a stack that is down cannot be asked who it is first. */\\n1026: export function startSlotStack(slot: number): void {\\n1027:   runSlotCli(slot, ['start'], 'start');\\n1028: }\\n1029: \\n1030: /**\\n1031:  * Make the slot's database be the item tree's database, and prove it.\\n1032:  *\\n1033:  * The order is load-bearing: mirror the tree, regenerate the identity-overlaid config, restart the\\n1034:  * stack IF the configuration it was started with has changed, then read the stack, prove it is\\n1035:  * local, wait for readiness, reset, wait again, and prove the migration set replayed.\\n1036:  *\\n1037:  * WHY A MARKER RATHER THAN THE FILE ITSELF decides the restart: the file says what the slot SHOULD\\n1038:  * be running; only a marker written after a successful start says what it IS running. A crash\\n1039:  * between writing the config and restarting would otherwise leave equal text over a stack still\\n1040:  * serving the old auth behaviour, and the next occupancy would trust it.\\n1041:  */\\n1042: export async function prepare(occupancy: Occupancy, itemRoot: string = REPO_ROOT): Promise<PrepareResult> {\\n1043:   const { slot, dir } = occupancy;\\n1044:   const sourceText = readFileSync(join(itemRoot, 'supabase', 'config.toml'), 'utf8');\\n1045:   const generated = generateSlotConfig(sourceText, slot);\\n1046: \\n1047:   refusePersonal(generated, itemRoot, `prepare slot ${slot}`);\\n1048: \\n1049:   const closure = pathClosureProblems(generated, itemRoot);\\n1050:   if (closure.length) {\\n1051:     throw new Error(\\n1052:       `slot ${slot} would start half-provisioned: ${closure.join('; ')}. No stack was started and nothing was reset.`,\\n1053:     );\\n1054:   }\\n1055: \\n1056:   // THE MIRROR AND THE CONFIG WRITE ARE ONE STEP (ruling T11). The mirror excludes `config.toml`\\n1057:   // and removes the slot's copy, so between these two statements the slot has NO config — never the\\n1058:   // item tree's one, which carries the personal identity. A crash in the window leaves a slot with\\n1059:   // nothing, which `occupy` refuses loudly and one `setup` repairs. The write is unconditional:\\n1060:   // the mirror has just deleted whatever was there.\\n1061:   mirrorItemTree(itemRoot, slot);\\n1062:   const configPath = slotConfigPath(slot);\\n1063:   mkdirSync(join(dir, 'supabase'), { recursive: true });\\n1064:   writeFileSync(configPath, generated, 'utf8');\\n1065: \\n1066:   const hash = hashConfig(generated);\\n1067:   const marker = readMarker(slot);\\n1068:   const restarted = marker?.configHash !== hash;\\n1069:   if (restarted) {\\n1070:     // The auth container reads config at START, not at reset, so a changed config that is not\\n1071:     // restarted into would grade the previous item's auth behaviour.\\n1072:     console.log(`at:verify — db slot ${slot} configuration changed since its last start; restarting the slot's stack`);\\n1073:     stopSlotStack(slot, itemRoot);\\n1074:     startSlotStack(slot);\\n1075:     const proven: StartMarker = { configHash: hash, at: new Date().toISOString(), pid: process.pid };\\n1076:     writeFileSync(slotMarkerPath(slot), JSON.stringify(proven), 'utf8');\\n1077:   }\\n1078: \\n1079:   // The identity read doubles as the prove-local check against the SLOT's config, and it is the\\n1080:   // same read the reset performs again for itself immediately before acting.\\n1081:   const read = proveSlotTarget(slot, 'prepare', itemRoot);\\n1082:   if (!read.status) {\\n1083:     throw new Error(`slot ${slot} reported no running stack (${read.notRunning}), so nothing was reset and nothing was run`);\\n1084:   }\\n1085:   const status = read.status;\\n1086: \\n1087:   await waitForReady(status, `before the slot ${slot} reset`);\\n1088:   await resetSlotDatabase(slot, itemRoot);\\n1089:   await waitForReady(status, `after the slot ${slot} reset`);\\n1090:   const migrations = await proveMigrationsReplayed(status, itemRoot);\\n1091: \\n1092:   return { status, migrations, restarted };\\n1093: }\\n1094: \\n1095: /* ------------------------------------------------------------------------------- env and evidence */\\n1096: \\n1097: /**\\n1098:  * The coordinates a suite is allowed to see. Nothing else about the slot travels into the child,\\n\\n(Output capped at 50 KB. Showing lines 1-1098. Use offset=1099 to continue.)\\n</content>\",\"metadata\":{\"preview\":\"/**\\n * The local database slot pool — a small number of standing Supabase stacks (\\\"slots\\\") so that\\n * several items can verify at the same time without resetting each other's database.\\n *\\n * THE SHAPE, as ruled:\\n *\\n *   - Two standing slots. Concurrency is the pool size; a full pool REJECTS the next\\n *     database-needing item at start rather than queueing it.\\n *   - The stack on the 54321 block is the founder's personal stack. It is OUTSIDE the pool and\\n *     untouchable, and `personalBlockProblems` below makes that a check in code rather than a\\n *     convention: no slot may carry the repo's project id, a port in 54320–54329, or inspector\\n *     port 8083, and the check runs before anything destructive, every time.\\n *   - One claim file per slot, two states, three owners: the coordinator RESERVES a slot when an\\n *     item starts, the harness runner OCCUPIES it for each verify window, the coordinator\\n *     RELEASES the reservation at the item sweep.\\n *   - STATE IS NEVER INHERITED. The first act of every occupancy is to copy the item tree's own\\n *     `supabase/` directory into the slot and reset the database from it. The previous holder is\\n *     never trusted, including a crashed one.\\n *   - IDENTITY IS PERMANENT, EVERYTHING ELSE IS DATA. A slot permanently owns its project id and\\n *     its port block; every other setting comes from the item tree's own `config.toml` on every\",\"truncated\":true,\"loaded\":[],\"display\":{\"type\":\"file\",\"path\":\"C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\db-pool.ts\",\"text\":\"/**\\n * The local database slot pool — a small number of standing Supabase stacks (\\\"slots\\\") so that\\n * several items can verify at the same time without resetting each other's database.\\n *\\n * THE SHAPE, as ruled:\\n *\\n *   - Two standing slots. Concurrency is the pool size; a full pool REJECTS the next\\n *     database-needing item at start rather than queueing it.\\n *   - The stack on the 54321 block is the founder's personal stack. It is OUTSIDE the pool and\\n *     untouchable, and `personalBlockProblems` below makes that a check in code rather than a\\n *     convention: no slot may carry the repo's project id, a port in 54320–54329, or inspector\\n *     port 8083, and the check runs before anything destructive, every time.\\n *   - One claim file per slot, two states, three owners: the coordinator RESERVES a slot when an\\n *     item starts, the harness runner OCCUPIES it for each verify window, the coordinator\\n *     RELEASES the reservation at the item sweep.\\n *   - STATE IS NEVER INHERITED. The first act of every occupancy is to copy the item tree's own\\n *     `supabase/` directory into the slot and reset the database from it. The previous holder is\\n *     never trusted, including a crashed one.\\n *   - IDENTITY IS PERMANENT, EVERYTHING ELSE IS DATA. A slot permanently owns its project id and\\n *     its port block; every other setting comes from the item tree's own `config.toml` on every\\n *     occupancy, because auth flags and seed paths change per item and a stack started with a\\n *     stale one would grade the wrong behaviour.\\n *\\n * WHY THE CONFIG IS REGENERATED RATHER THAN COPIED OR FROZEN: a frozen slot config drifts from\\n * the item tree, and a copied one carries the personal stack's identity straight into the slot.\\n * Regeneration takes the item tree's file verbatim and overlays ONLY the identity fields, so a\\n * slot is always the item's own configuration wearing the slot's identity.\\n *\\n * WHY THIS FILE OWNS ALL THE TOML: the PowerShell helpers in `loop/work/db-slots.ps1` do file\\n * operations only — reserve, release, list. If both sides generated configs, the overlay rule\\n * could fork, and two rules for one identity is how a slot ends up on a personal port.\\n *\\n * The import of `runner.ts` is deliberate and the cycle it forms with the runner's own import of\\n * this file is safe: neither module calls the other at module scope, and both sides export\\n * hoisted function declarations.\\n */\\n\\nimport { spawnSync } from 'node:child_process';\\nimport { createHash } from 'node:crypto';\\nimport { cpSync, existsSync, mkdirSync, readFileSync, readdirSync, rmSync, writeFileSync } from 'node:fs';\\nimport { hostname, tmpdir } from 'node:os';\\nimport { isAbsolute, join, relative, resolve } from 'node:path';\\n\\nimport { REPO_ROOT } from './check.ts';\\nimport {\\n  acquireStackLock,\\n  childEnv,\\n  diagnostic,\\n  localStackProblems,\\n  parseStackStatus,\\n  proveMigrationsReplayed,\\n  readLocalConfig,\\n  readStackStatus,\\n  resetLocalDatabase,\\n  runSupabaseCli,\\n  stackLockPath,\\n  waitForReady,\\n  type CliResult,\\n  type CliTarget,\\n  type Holder,\\n  type LocalConfig,\\n  type MigrationProof,\\n  type StackLock,\\n  type StackStatus,\\n} from './runner.ts';\\n\\n/** Ruled: two standing slots. Concurrency IS the pool size. */\\nexport const POOL_SIZE = 2;\\n\\n/** The founder's personal stack. Nothing in the pool may carry any of these. */\\nconst PERSONAL_PORT_LOW = 54320;\\nconst PERSONAL_PORT_HIGH = 54329;\\nconst PERSONAL_INSPECTOR_PORT = 8083;\\n\\n/** The band a port must sit in for the slot overlay to know how to move it. */\\nconst MAPPABLE_PORT_LOW = 54000;\\nconst MAPPABLE_PORT_HIGH = 54999;\\n\\n/* ------------------------------------------------------------------------------ pool locations */\\n\\n/**\\n * The pool lives beside the locks it cooperates with and OUTSIDE every worktree: a slot outlives\\n * the item that used it, and a directory inside a worktree dies with the worktree.\\n *\\n * `AT_DB_POOL_ROOT` overrides it for the selftests, the same pattern as `AT_REPO_ROOT`.\\n */\\nexport function poolRoot(): string {\\n  const override = process.env.AT_DB_POOL_ROOT?.trim();\\n  const dir = override\\n    ? override\\n    : join(process.env.LOCALAPPDATA ?? process.env.XDG_CACHE_HOME ?? tmpdir(), 'ai4good-build', 'db-slots');\\n  mkdirSync(dir, { recursive: true });\\n  return dir;\\n}\\n\\n/** Slot numbers are 1..POOL_SIZE. Anything else is a caller error, named rather than clamped. */\\nexport function assertSlotNumber(slot: number): number {\\n  if (!Number.isInteger(slot) || slot < 1 || slot > POOL_SIZE) {\\n    throw new Error(`\\\"${slot}\\\" is not a slot in this pool — the slots are 1 to ${POOL_SIZE}`);\\n  }\\n  return slot;\\n}\\n\\n/** The directory that CONTAINS the slot's `supabase/` project folder — what `--workdir` names. */\\nexport function slotDir(slot: number): string {\\n  return join(poolRoot(), `slot-${assertSlotNumber(slot)}`);\\n}\\n\\nexport function slotConfigPath(slot: number): string {\\n  return join(slotDir(slot), 'supabase', 'config.toml');\\n}\\n\\n/** Written only after a successful start; see `prepare`. */\\nexport function slotMarkerPath(slot: number): string {\\n  return join(slotDir(slot), '.last-start.json');\\n}\\n\\nexport function reservationPath(slot: number): string {\\n  return join(poolRoot(), 'reservations', `slot-${assertSlotNumber(slot)}.json`);\\n}\\n\\n/** A distinct project id is what gives a slot distinct Docker containers and volumes. */\\nexport function slotProjectId(slot: number): string {\\n  return `ai4good-slot-${assertSlotNumber(slot)}`;\\n}\\n\\n/**\\n * A slot's PERMANENT identity, used for one purpose: naming the occupancy claim file (ruling T6).\\n *\\n * The runner's claim path is built from a project id and an api port, and for a repository stack\\n * both are permanent. A SLOT's ports are not: `prepare` lawfully rewrites them from the item\\n * tree's own config on every occupancy, so two runs bracketing a port change would hold two\\n * DIFFERENT claim files for one slot and neither would see the other. The claim therefore keys on\\n * the slot's project id — which never changes — and on a fixed sentinel in place of the port.\\n *\\n * The sentinel is 0, which is not a port. It only has to be constant. The PowerShell helper globs\\n * `at-verify-ai4good-slot-N-*.lock`, so it matches this and every earlier name unchanged.\\n */\\nexport function slotClaimKey(slot: number): LocalConfig {\\n  return { projectId: slotProjectId(slot), apiPort: 0, dbPort: 0 };\\n}\\n\\n/* --------------------------------------------------------------------------- config.toml scan */\\n\\ninterface ConfigEntry {\\n  line: number;\\n  section: string;\\n  key: string;\\n  value: string;\\n}\\n\\n/**\\n * Every ACTIVE `key = value` in the file, with the section it sits in. Commented lines are not\\n * settings and are skipped — which is the whole reason the scan is section-aware rather than a\\n * set of regular expressions over the file: `port` appears in nine places and most of them are\\n * examples in comments.\\n *\\n * Multi-line array values are not read as one value. Nothing in this repo's config uses one, and\\n * a value this scanner cannot see is a value it never rewrites, so the failure mode is a config\\n * that is copied verbatim rather than one that is silently mis-edited.\\n */\\nexport function scanConfig(text: string): ConfigEntry[] {\\n  const entries: ConfigEntry[] = [];\\n  let section = '';\\n  const lines = text.split('\\\\n');\\n  for (let index = 0; index < lines.length; index++) {\\n    const line = lines[index].trim();\\n    if (line.startsWith('#') || line === '') continue;\\n    const header = /^\\\\[([^\\\\]]+)\\\\]/.exec(line);\\n    if (header) {\\n      section = header[1];\\n      continue;\\n    }\\n    const setting = /^([A-Za-z_][A-Za-z0-9_]*)\\\\s*=\\\\s*(.*)$/.exec(line);\\n    if (setting) entries.push({ line: index, section, key: setting[1], value: setting[2].trim() });\\n  }\\n  return entries;\\n}\\n\\nfunction isPortKey(key: string): boolean {\\n  return key === 'port' || key.endsWith('_port');\\n}\\n\\n/**\\n * THE LOCAL STACK'S OWN LISTENER PORTS — the only ports a slot's identity moves (ruling E4).\\n *\\n * A `config.toml` holds two kinds of port. A LISTENER port is a socket this machine opens for\\n * this stack, so two stacks that share one collide, and the overlay must move it. A CLIENT port\\n * is part of an address of somebody else's service — `[auth.email.smtp] port = 587` is Postmark's\\n * port, not ours — so it is DATA, and moving it or refusing it would break a slot that is\\n * configured exactly like the tree it grades.\\n *\\n * The list is exact section + key pairs, so `[api] port` moves while `[api.tls] port` (were one\\n * added) does not silently inherit the rule.\\n */\\nconst LISTENER_PORTS: readonly { section: string; key: string }[] = [\\n  { section: 'api', key: 'port' },\\n  { section: 'db', key: 'port' },\\n  { section: 'db', key: 'shadow_port' },\\n  { section: 'db.pooler', key: 'port' },\\n  { section: 'studio', key: 'port' },\\n  { section: 'local_smtp', key: 'port' },\\n  { section: 'local_smtp', key: 'smtp_port' },\\n  { section: 'local_smtp', key: 'pop3_port' },\\n  { section: 'analytics', key: 'port' },\\n  { section: 'edge_runtime', key: 'inspector_port' },\\n];\\n\\nfunction isListenerPort(section: string, key: string): boolean {\\n  return LISTENER_PORTS.some((listener) => listener.section === section && listener.key === key);\\n}\\n\\nexport interface PortMapping {\\n  section: string;\\n  key: string;\\n  line: number;\\n  from: number;\\n  to: number;\\n}\\n\\n/**\\n * The identity overlay's port rule (ruling E4).\\n *\\n *   - a LISTENER port (see `LISTENER_PORTS`) in 54000–54999 moves by 1000 per slot;\\n *     `edge_runtime.inspector_port` set to EXACTLY 8083 moves by 10 per slot, because the ruled\\n *     inspector value is 8083 and it is not in that band. Any OTHER inspector value falls to the\\n *     generic rule below, so it maps when it is in band and refuses when it is not — a +10 applied\\n *     to a value nobody ruled is a guess, and D2 forbids guesses.\\n *   - a listener port outside those bands REFUSES loudly as unmappable. A guess here is a port\\n *     collision with software nobody in this process knows about, so a person decides.\\n *   - any OTHER port-valued key passes through unchanged: it addresses somebody else's service and\\n *     is data, not identity.\\n *   - except that a non-listener port sitting in 54000–54999 also REFUSES. It looks exactly like a\\n *     local stack port and this rule does not recognise it, and treating an unrecognised local port\\n *     as data would hand two slots the same socket. Fail closed, and a person decides.\\n *\\n * `personalBlockProblems` stays broad over EVERY port key regardless of this rule, so a port in the\\n * founder's own block can never reach a slot by being classified as data.\\n */\\nexport function portMappings(text: string, slot: number): { mappings: PortMapping[]; problems: string[] } {\\n  assertSlotNumber(slot);\\n  const mappings: PortMapping[] = [];\\n  const problems: string[] = [];\\n\\n  for (const entry of scanConfig(text)) {\\n    if (!isPortKey(entry.key)) continue;\\n    const literal = /^(\\\\d+)/.exec(entry.value);\\n    const from = literal ? Number(literal[1]) : NaN;\\n    const listener = isListenerPort(entry.section, entry.key);\\n\\n    if (!listener) {\\n      if (Number.isFinite(from) && from >= MAPPABLE_PORT_LOW && from <= MAPPABLE_PORT_HIGH) {\\n        problems.push(\\n          `[${entry.section}] ${entry.key} = ${from} is not a listener port this rule knows, but it sits in the local ` +\\n            `stack's band ${MAPPABLE_PORT_LOW}–${MAPPABLE_PORT_HIGH} — decide by hand whether the slot moves it`,\\n        );\\n      }\\n      continue; // a client-connection port is data and travels unchanged\\n    }\\n\\n    if (!literal) {\\n      problems.push(`[${entry.section}] ${entry.key} = ${entry.value} is not a plain port number, so the slot overlay cannot move it`);\\n      continue;\\n    }\\n    if (entry.section === 'edge_runtime' && entry.key === 'inspector_port' && from === PERSONAL_INSPECTOR_PORT) {\\n      mappings.push({ section: entry.section, key: entry.key, line: entry.line, from, to: from + slot * 10 });\\n      continue;\\n    }\\n    if (from >= MAPPABLE_PORT_LOW && from <= MAPPABLE_PORT_HIGH) {\\n      mappings.push({ section: entry.section, key: entry.key, line: entry.line, from, to: from + slot * 1000 });\\n      continue;\\n    }\\n    problems.push(\\n      `[${entry.section}] ${entry.key} = ${from} is outside ${MAPPABLE_PORT_LOW}–${MAPPABLE_PORT_HIGH}, so the slot ` +\\n        `overlay does not know where to move it — decide the slot's port for this setting by hand`,\\n    );\\n  }\\n\\n  return { mappings, problems };\\n}\\n\\n/**\\n * The item tree's own config, wearing the slot's identity. Everything that is not an identity\\n * field is returned byte for byte, including comments, blank lines and line endings — a\\n * regenerated config differing anywhere else would mean the slot grades different behaviour from\\n * the tree that asked for the run.\\n */\\nexport function generateSlotConfig(sourceText: string, slot: number): string {\\n  assertSlotNumber(slot);\\n  const { mappings, problems } = portMappings(sourceText, slot);\\n  if (problems.length) {\\n    throw new Error(`the slot ${slot} config cannot be generated from this supabase/config.toml — ${problems.join('; ')}`);\\n  }\\n\\n  const projectIdEntry = scanConfig(sourceText).find((entry) => entry.section === '' && entry.key === 'project_id');\\n  if (!projectIdEntry) throw new Error('supabase/config.toml carries no top-level project_id, so a slot identity cannot be built from it');\\n\\n  const lines = sourceText.split('\\\\n');\\n  lines[projectIdEntry.line] = lines[projectIdEntry.line].replace(/^(\\\\s*project_id\\\\s*=\\\\s*)\\\"[^\\\"]*\\\"/, `$1\\\"${slotProjectId(slot)}\\\"`);\\n  for (const mapping of mappings) {\\n    const pattern = new RegExp(`^(\\\\\\\\s*${mapping.key}\\\\\\\\s*=\\\\\\\\s*)\\\\\\\\d+`);\\n    lines[mapping.line] = lines[mapping.line].replace(pattern, `$1${mapping.to}`);\\n  }\\n  return lines.join('\\\\n');\\n}\\n\\n/* ------------------------------------------------------- the personal stack, refused in code */\\n\\n/**\\n * The \\\"untouchable\\\" ruling as an executable guard. Called before every destructive act and before\\n * any env is emitted, because a convention that is only written down is one a later change can\\n * step over without noticing.\\n *\\n * It scans EVERY active port-valued key, not a fixed list: the danger is a port in the personal\\n * block reaching a slot, and it does not matter which setting carried it there.\\n */\\nexport function personalBlockProblems(slotConfigText: string, personalProjectId: string): string[] {\\n  const problems: string[] = [];\\n  const entries = scanConfig(slotConfigText);\\n\\n  const projectId = entries.find((entry) => entry.section === '' && entry.key === 'project_id');\\n  const value = /^\\\"([^\\\"]*)\\\"/.exec(projectId?.value ?? '')?.[1] ?? '';\\n  if (!value) problems.push('the slot config carries no project_id, so it cannot be told apart from the personal stack');\\n  else if (value === personalProjectId) problems.push(`the slot config carries the personal stack's project id \\\"${personalProjectId}\\\"`);\\n\\n  for (const entry of entries) {\\n    if (!isPortKey(entry.key)) continue;\\n    const port = Number(/^(\\\\d+)/.exec(entry.value)?.[1] ?? NaN);\\n    if (!Number.isFinite(port)) continue;\\n    if (port >= PERSONAL_PORT_LOW && port <= PERSONAL_PORT_HIGH) {\\n      problems.push(`[${entry.section}] ${entry.key} = ${port} is inside the personal stack's port block ${PERSONAL_PORT_LOW}–${PERSONAL_PORT_HIGH}`);\\n    }\\n    if (entry.key === 'inspector_port' && port === PERSONAL_INSPECTOR_PORT) {\\n      problems.push(`[${entry.section}] inspector_port = ${port} is the personal stack's inspector port`);\\n    }\\n  }\\n\\n  return problems;\\n}\\n\\n/** The identity the pool must never wear. Read from the item tree, never hard-coded. */\\nexport function personalProjectId(itemRoot: string = REPO_ROOT): string {\\n  return readLocalConfig(itemRoot).projectId;\\n}\\n\\nfunction refusePersonal(slotConfigText: string, itemRoot: string, act: string): void {\\n  const problems = personalBlockProblems(slotConfigText, personalProjectId(itemRoot));\\n  if (problems.length) {\\n    throw new Error(\\n      `refusing to ${act}: this configuration is not provably outside the founder's personal stack. ` +\\n        `Failed checks: ${problems.join('; ')}. The personal stack is untouchable, so nothing was done.`,\\n    );\\n  }\\n}\\n\\n/**\\n * The same guard, over a slot's config AS IT SITS ON DISK (rulings T7 and F1).\\n *\\n * `occupy` and `prepare` run the guard over text they hold in hand. The other three entry points —\\n * reset, stop and the env emitter — are exported and reachable directly, so each runs the guard\\n * for itself over the file. A guard that only the usual caller runs is a convention, not a guard.\\n */\\nfunction refusePersonalSlotConfig(slot: number, itemRoot: string, act: string): void {\\n  const configPath = slotConfigPath(slot);\\n  if (!existsSync(configPath)) {\\n    throw new Error(\\n      `refusing to ${act} slot ${slot}: it has no config at ${configPath}, so it cannot be shown to be outside the ` +\\n        `founder's personal stack. Run \\\\`bun tests/at/harness/db-pool.ts setup\\\\`. Nothing was done.`,\\n    );\\n  }\\n  refusePersonal(readFileSync(configPath, 'utf8'), itemRoot, `${act} slot ${slot}`);\\n}\\n\\n/* ------------------------------------------------------------------------- the path closure */\\n\\n/** Config settings whose value names a file or directory the stack has to be able to read. */\\nconst PATH_KEYS = new Set([\\n  'sql_paths',\\n  'schema_paths',\\n  'content_path',\\n  'cert_path',\\n  'key_path',\\n  'signing_keys_path',\\n  'objects_path',\\n  'declarative_schema_path',\\n]);\\n\\nfunction stringValues(raw: string): string[] {\\n  const array = /^\\\\[(.*)\\\\]$/.exec(raw);\\n  const body = array ? array[1] : raw;\\n  return [...body.matchAll(/\\\"([^\\\"]*)\\\"/g)].map((match) => match[1]).filter((value) => value.trim() !== '');\\n}\\n\\n/**\\n * Fail closed on what the config asks for but the mirror cannot deliver.\\n *\\n * `prepare` mirrors the item tree's whole `supabase/` directory into the slot, so every path\\n * UNDER that directory is provided exactly as the item tree has it — present if present, absent\\n * if absent. A configured path that is absent in the item tree is therefore not a problem: the\\n * slot is then in the same state the repo-configured stack would be in, which is the state the\\n * item asked for. (`[db.seed] sql_paths = [\\\"./seed.sql\\\"]` with no `seed.sql` in the tree is\\n * exactly today's arrangement on the personal stack.)\\n *\\n * A path that points OUTSIDE `supabase/` is a different thing: the mirror cannot deliver it, so\\n * the slot would start half-provisioned and grade against a file it does not have. That refuses\\n * loudly and a person decides. The same applies to the two directories the mirror EXCLUDES\\n * (`MIRROR_EXCLUSIONS`): a config that names a file inside the CLI's own runtime state is naming\\n * something the slot will not have, so the closure stays honest about the exclusions.\\n *\\n * A VALUE THIS SCANNER CANNOT SEE REFUSES rather than passing. `scanConfig` reads one line per\\n * setting, so a multi-line array — `sql_paths = [` on its own line — yields the value `[` and no\\n * paths at all. For the OVERLAY an invisible value is harmless: it is copied verbatim. For the\\n * CLOSURE it is a missed refusal, which is the failure this function exists to prevent.\\n */\\nexport function pathClosureProblems(configText: string, itemRoot: string): string[] {\\n  const problems: string[] = [];\\n  const base = resolve(join(itemRoot, 'supabase'));\\n\\n  for (const entry of scanConfig(configText)) {\\n    if (!PATH_KEYS.has(entry.key)) continue;\\n    if (entry.value.startsWith('[') && !entry.value.includes(']')) {\\n      problems.push(\\n        `[${entry.section}] ${entry.key} opens an array that does not close on the same line, so this check ` +\\n          `cannot see the paths it names — write the value on one line (${entry.key} = [\\\"./a.sql\\\", \\\"./b.sql\\\"]) ` +\\n          `and run this again`,\\n      );\\n      continue;\\n    }\\n    for (const value of stringValues(entry.value)) {\\n      if (/^[a-z][a-z0-9+.-]*:\\\\/\\\\//i.test(value)) {\\n        problems.push(`[${entry.section}] ${entry.key} names \\\"${value}\\\", which is a URL rather than a file the slot can be given`);\\n        continue;\\n      }\\n      if (isAbsolute(value)) {\\n        problems.push(`[${entry.section}] ${entry.key} names the absolute path \\\"${value}\\\", which the slot mirror cannot reproduce`);\\n        continue;\\n      }\\n      const target = resolve(base, value);\\n      const inside = relative(base, target);\\n      if (inside.startsWith('..')) {\\n        problems.push(\\n          `[${entry.section}] ${entry.key} names \\\"${value}\\\", which is outside supabase/ — the slot mirror copies supabase/ ` +\\n            `and nothing else, so this file would be missing from the slot`,\\n        );\\n        continue;\\n      }\\n      const first = inside.split(/[\\\\\\\\/]/)[0];\\n      if (MIRROR_EXCLUSIONS.includes(first)) {\\n        problems.push(\\n          `[${entry.section}] ${entry.key} names \\\"${value}\\\", which resolves into supabase/${first} — the slot mirror ` +\\n            `deliberately does not copy that directory (it is the CLI's own runtime state about another stack), so ` +\\n            `this file would be missing from the slot`,\\n        );\\n      }\\n    }\\n  }\\n\\n  return problems;\\n}\\n\\n/* -------------------------------------------------------------------------------- the mirror */\\n\\n/**\\n * What the mirror does NOT carry into a slot (rulings T3, F3 and T11). Top-level entries of\\n * `supabase/` only, so the list cannot quietly grow into a filter on file names.\\n *\\n *   - `.temp` and `.branches` are the CLI's OWN RUNTIME STATE, not project source. `.temp` holds\\n *     the CLI's record of the stack it last ran — the founder's personal one — and `.gitignore`\\n *     itself says its `start-secrets/**` \\\"must NEVER be committed\\\". Copying it carries another\\n *     stack's identity residue and its secrets into every slot.\\n *   - `config.toml` is the slot's IDENTITY, and the item tree's copy carries the personal\\n *     identity. Excluding it means no slot config ever holds that identity, not even for the\\n *     instant between the mirror and the regenerated write — and a crash in that instant leaves\\n *     NO config rather than a personal one.\\n */\\nexport const MIRROR_EXCLUSIONS: readonly string[] = ['.temp', '.branches', 'config.toml'];\\n\\n/**\\n * Every symlink under a directory tree. A pre-copy scan, because a symlink is not a file the\\n * mirror can reproduce: `cpSync` would copy it as a link, and the link points wherever it likes —\\n * including straight back at the personal stack's own directory.\\n */\\nfunction symlinksUnder(dir: string): string[] {\\n  const found: string[] = [];\\n  const walk = (current: string): void => {\\n    for (const entry of readdirSync(current, { withFileTypes: true })) {\\n      const full = join(current, entry.name);\\n      if (entry.isSymbolicLink()) {\\n        found.push(full);\\n        continue; // never follow it — that is the whole point\\n      }\\n      if (entry.isDirectory()) walk(full);\\n    }\\n  };\\n  walk(dir);\\n  return found;\\n}\\n\\n/**\\n * Copy the item tree's `supabase/` into the slot, having first removed the slot's copy.\\n *\\n * DELETE THEN COPY, never merge: the previous holder's leftover migration or leftover function is\\n * exactly the state this pool exists to make impossible.\\n *\\n * THE PROJECT SOURCE ENTIRE, and nothing else (ruling E3 as narrowed by T3, F3 and T11). Every\\n * path the config names under `supabase/` arrives in the slot exactly as the item tree has it —\\n * present if present, absent if absent — and `pathClosureProblems` refuses any config path that\\n * names one of the three excluded entries, so the closure guarantee stays honest about them.\\n * (`README.md` and `.gitkeep` therefore travel into the slot's `migrations/` too. The CLI reads\\n * only `<timestamp>_name.sql` there, and the runner's migration proof counts exactly those.)\\n *\\n * A SYMLINK ANYWHERE UNDER `supabase/` REFUSES THE WHOLE MIRROR (ruling T13). The tree carries\\n * none today, so nothing breaks; one smuggled in later refuses loudly instead of being copied as\\n * a link into a directory the pool then resets.\\n */\\nexport function mirrorItemTree(itemRoot: string, slot: number): void {\\n  const source = join(itemRoot, 'supabase');\\n  const destination = join(slotDir(slot), 'supabase');\\n  if (!existsSync(source)) throw new Error(`${source} does not exist — there is no project to give the slot`);\\n\\n  const links = symlinksUnder(source);\\n  if (links.length) {\\n    throw new Error(\\n      `refusing to mirror ${source} into slot ${slot}: it contains ${links.length} symlink(s) — ${links.join(', ')}. ` +\\n        `A symlink is not a file the mirror can reproduce, and a link copied into a slot points wherever it likes, ` +\\n        `including outside the pool. Replace them with real files, or decide by hand. Nothing was copied.`,\\n    );\\n  }\\n\\n  rmSync(destination, { recursive: true, force: true });\\n  mkdirSync(destination, { recursive: true });\\n  cpSync(source, destination, {\\n    recursive: true,\\n    filter: (from: string) => {\\n      const inside = relative(source, from);\\n      if (inside === '') return true;\\n      return !MIRROR_EXCLUSIONS.includes(inside.split(/[\\\\\\\\/]/)[0]);\\n    },\\n  });\\n}\\n\\n/* --------------------------------------------------------------------------- the reservation */\\n\\nexport interface Reservation {\\n  slot: number;\\n  item: string;\\n  branch: string;\\n  at: string;\\n  holder: string;\\n}\\n\\nexport function readReservation(slot: number): Reservation | null {\\n  try {\\n    return JSON.parse(readFileSync(reservationPath(slot), 'utf8')) as Reservation;\\n  } catch {\\n    return null;\\n  }\\n}\\n\\n/** The slot reserved for this item, or null. Derived from the file, never declared by a caller. */\\nexport function slotForItem(item: string): number | null {\\n  for (let slot = 1; slot <= POOL_SIZE; slot++) {\\n    if (readReservation(slot)?.item === item) return slot;\\n  }\\n  return null;\\n}\\n\\n/**\\n * The item id a branch names — a pure function over the branch string, and it FAILS CLOSED.\\n *\\n * Exactly one id, or it refuses naming the condition. Never the first match of several: a branch\\n * carrying two ids is a question about which item is being verified, and answering it by\\n * position would attach a run, a reservation and a database to the wrong item silently.\\n */\\nexport function itemFromBranch(branch: string): string {\\n  const raw = String(branch ?? '').trim();\\n  if (raw === '') throw new Error('the branch name is empty, so no item id can be derived from it');\\n  if (raw === 'HEAD') throw new Error('HEAD is detached, so the branch names no item — check out the item branch, or set AT_DB_SLOT');\\n\\n  const ids = [...new Set([...raw.matchAll(/\\\\b(ai4dev|ai4pm)-(\\\\d+)\\\\b/gi)].map((match) => `${match[1].toUpperCase()}-${Number(match[2])}`))];\\n  if (ids.length === 0) throw new Error(`the branch \\\"${raw}\\\" names no item id, so no reserved slot can be found for it`);\\n  if (ids.length > 1) throw new Error(`the branch \\\"${raw}\\\" names ${ids.length} item ids (${ids.join(', ')}) — a person decides which one this run verifies`);\\n  return ids[0];\\n}\\n\\n/** The branch this tree is on. A git failure refuses; it never falls back to a guess. */\\nexport function currentBranch(root: string = REPO_ROOT): string {\\n  const res = spawnSync('git', ['-C', root, 'rev-parse', '--abbrev-ref', 'HEAD'], { encoding: 'utf8', env: childEnv() });\\n  if (res.error) throw new Error(`git could not be run to read the current branch (${diagnostic((res.error as Error).message)})`);\\n  if (res.status !== 0) throw new Error(`git could not report the current branch (exit ${res.status}): ${diagnostic(res.stderr) || '(no error output)'}`);\\n  return (res.stdout ?? '').trim();\\n}\\n\\n/* ------------------------------------------------------------------------------- the pool view */\\n\\nexport interface PoolSlotView {\\n  slot: number;\\n  dir: string;\\n  configured: boolean;\\n  projectId: string | null;\\n  apiPort: number | null;\\n  dbPort: number | null;\\n  reservation: Reservation | null;\\n  occupiedBy: Holder | null;\\n}\\n\\n/** What the pool looks like right now — for the setup report, the helpers, and a person asking. */\\nexport function readPool(): PoolSlotView[] {\\n  const views: PoolSlotView[] = [];\\n  for (let slot = 1; slot <= POOL_SIZE; slot++) {\\n    const dir = slotDir(slot);\\n    let config: LocalConfig | null = null;\\n    try {\\n      config = readLocalConfig(dir);\\n    } catch {\\n      config = null;\\n    }\\n    // The claim is keyed on the slot's PERMANENT identity (ruling T6), so this read finds it even\\n    // when the slot has no config yet and even after `prepare` has moved the slot's ports.\\n    let occupiedBy: Holder | null = null;\\n    try {\\n      occupiedBy = JSON.parse(readFileSync(stackLockPath(slotClaimKey(slot)), 'utf8')) as Holder;\\n    } catch {\\n      occupiedBy = null;\\n    }\\n    views.push({\\n      slot,\\n      dir,\\n      configured: config !== null,\\n      projectId: config?.projectId ?? null,\\n      apiPort: config?.apiPort ?? null,\\n      dbPort: config?.dbPort ?? null,\\n      reservation: readReservation(slot),\\n      occupiedBy,\\n    });\\n  }\\n  return views;\\n}\\n\\n/* ---------------------------------------------------------------------------------- occupancy */\\n\\nexport interface Occupancy {\\n  slot: number;\\n  dir: string;\\n  config: LocalConfig;\\n  /** The item this occupancy belongs to, or `null` when it came from the AT_DB_SLOT override. */\\n  item: string | null;\\n  via: 'reservation' | 'override';\\n  claim: StackLock;\\n  release(): void;\\n}\\n\\nexport interface OccupyOptions {\\n  /** The item id. Derived from the branch when absent. */\\n  item?: string;\\n  /** The AT_DB_SLOT override — for runs outside an item: the founder, the evidence gate, a spike. */\\n  slot?: number;\\n}\\n\\n/**\\n * Take a slot for one verify window.\\n *\\n * ADMISSION CONTROL IS THE COORDINATOR'S, NOT THE RUNNER'S. A run whose item holds no reservation\\n * refuses and names the helper that makes one; it never falls back onto a free slot, because a\\n * silent fallback is how a pool of two quietly becomes a pool of one shared stack.\\n *\\n * The claim is the runner's existing stack lock, with the takeover policy the ruled text asks\\n * for: a DEAD holder pid is broken loudly, a live holder is never displaced at any age.\\n *\\n * THE OVERRIDE SKIPS ADMISSION CONTROL, NOT OWNERSHIP (ruling T5). `AT_DB_SLOT` is ruled — the\\n * founder, the evidence gate and the spike all use it — and slot STATE is disposable by design, so\\n * the reservation is not what protects a slot; the occupancy claim is, and the override keeps it.\\n * But taking a slot another item is holding is a silent collision and costs nothing to refuse, so\\n * an override run refuses loudly when the target slot's reservation names a DIFFERENT item than\\n * this run can derive. A run that can derive no item at all treats ANY reservation as foreign.\\n */\\nexport function occupy(requirement: string, options: OccupyOptions = {}): Occupancy {\\n  let slot: number;\\n  let item: string | null = null;\\n  let via: 'reservation' | 'override';\\n\\n  if (options.slot !== undefined) {\\n    slot = assertSlotNumber(options.slot);\\n    item = options.item ?? null;\\n    via = 'override';\\n\\n    let derived: string | null = options.item ?? null;\\n    if (derived === null) {\\n      try {\\n        derived = itemFromBranch(currentBranch());\\n      } catch {\\n        derived = null; // no item derivable — every reservation is then somebody else's\\n      }\\n    }\\n    const reserved = readReservation(slot);\\n    if (reserved && reserved.item !== derived) {\\n      throw new Error(\\n        `refusing to take slot ${slot} with AT_DB_SLOT: it is reserved for ${reserved.item} ` +\\n          `(branch ${reserved.branch || 'unrecorded'}, taken ${reserved.at}, holder ${reserved.holder}) and this run ` +\\n          `${derived === null ? 'can derive no item of its own' : `belongs to ${derived}`}. Every occupancy resets the ` +\\n          `slot's database from its own tree, so this run would rebuild that item's database under it. Use a slot the ` +\\n          `pool shows free, or release that reservation first.`,\\n      );\\n    }\\n  } else {\\n    item = options.item ?? itemFromBranch(currentBranch());\\n    const reserved = slotForItem(item);\\n    if (reserved === null) {\\n      throw new Error(\\n        `no database slot is reserved for ${item}. The coordinator reserves a slot when the item starts — ` +\\n          `run \\\\`Reserve-DbSlot -Item ${item}\\\\` from loop/work/db-slots.ps1, or set AT_DB_SLOT=<n> for a run ` +\\n          `outside an item. There is deliberately no fallback onto a free slot: admission control belongs to ` +\\n          `the coordinator, not to this run.`,\\n      );\\n    }\\n    slot = reserved;\\n    via = 'reservation';\\n  }\\n\\n  const dir = slotDir(slot);\\n  const configPath = slotConfigPath(slot);\\n  if (!existsSync(configPath)) {\\n    // TWO CAUSES, and the repair is the same one command (ruling T11). Either the pool was never\\n    // set up on this machine, or a `prepare` died between the mirror — which removes the slot's\\n    // config on purpose, so no slot ever holds the personal identity — and the regenerated write\\n    // that immediately follows it. A missing config is the safe end of that window, never a wrong\\n    // one, and it is not permanent.\\n    throw new Error(\\n      `slot ${slot} has no config at ${configPath}. Either the pool was never set up on this machine, or a ` +\\n        `previous run stopped between the mirror and the write that follows it — the mirror removes the slot's ` +\\n        `config on purpose, so a slot never carries the personal identity even for an instant. Either way the ` +\\n        `repair is one command: \\\\`bun tests/at/harness/db-pool.ts setup\\\\`.`,\\n    );\\n  }\\n  refusePersonal(readFileSync(configPath, 'utf8'), REPO_ROOT, `occupy slot ${slot}`);\\n\\n  const config = readLocalConfig(dir);\\n  // Keyed on the slot's PERMANENT identity, never on the config's current ports (ruling T6).\\n  const claim = acquireStackLock(slotClaimKey(slot), requirement, { takeover: 'dead-pid-only' });\\n\\n  // The reservation is re-read AFTER the claim. Between the lookup above and this line the\\n  // coordinator may have released the slot and given it to another item, and a run that resets a\\n  // database another item now owns is the exact collision this pool exists to prevent.\\n  if (via === 'reservation' && item !== null) {\\n    const still = readReservation(slot);\\n    if (still?.item !== item) {\\n      claim.release();\\n      throw new Error(\\n        `slot ${slot} was reserved for ${item} when this run started and now names ${still?.item ?? 'nobody'} — ` +\\n          `the reservation changed under the run, so nothing was reset and nothing was run.`,\\n      );\\n    }\\n  }\\n\\n  return {\\n    slot,\\n    dir,\\n    config,\\n    item,\\n    via,\\n    claim,\\n    release: () => claim.release(),\\n  };\\n}\\n\\n/** Release an occupancy. Null-safe so it can sit in a `finally` beside a claim that never happened. */\\nexport function release(occupancy: Occupancy | null | undefined): void {\\n  occupancy?.release();\\n}\\n\\n/* ----------------------------------------------------------------------------------- prepare */\\n\\nexport interface PrepareResult {\\n  status: StackStatus;\\n  migrations: MigrationProof;\\n  /** True when the slot's stack had to be restarted because its configuration changed. */\\n  restarted: boolean;\\n}\\n\\ninterface StartMarker {\\n  configHash: string;\\n  at: string;\\n  pid: number;\\n}\\n\\nfunction hashConfig(text: string): string {\\n  return createHash('sha256').update(text, 'utf8').digest('hex');\\n}\\n\\nfunction readMarker(slot: number): StartMarker | null {\\n  try {\\n    return JSON.parse(readFileSync(slotMarkerPath(slot), 'utf8')) as StartMarker;\\n  } catch {\\n    return null;\\n  }\\n}\\n\\n/**\\n * Run the pinned CLI against one slot. Raw output is never printed: `supabase start` prints keys.\\n *\\n * THIS IS THE ONE HELPER (ruling E1, decision D13). No role hand-writes a slot CLI command: the\\n * incident of 2026-08-09 was a hand-written spike script that closed neither route the identity\\n * override travels by, and it destroyed the founder's database. Everything the wall is made of\\n * lives in `supabaseInvocation` in runner.ts — the positive `SUPABASE_PROJECT_ID`, the refusal of\\n * any other `SUPABASE_*`, `bun --no-env-file`, and the working directory equal to `--workdir` —\\n * and `slotTarget` is the only thing this file has to get right.\\n *\\n * It is for commands that must EXIT ZERO. `status` does not (the config disables imgproxy and the\\n * pooler), so the identity read below runs the CLI through the same seam and parses the result\\n * with the runner's own parser instead.\\n */\\nfunction runSlotCli(slot: number, args: string[], what: string): void {\\n  const res = runSupabaseCli(slotTarget(slot), args);\\n  if (res.error) {\\n    throw new Error(`could not launch the Supabase CLI to ${what} slot ${slot} (${diagnostic(res.error.message)})`);\\n  }\\n  if (res.status !== 0) {\\n    throw new Error(`\\\\`supabase ${args.join(' ')}\\\\` could not ${what} slot ${slot} (exit ${res.status}): ${diagnostic(res.stderr) || diagnostic(res.stdout) || '(no error output)'}`);\\n  }\\n}\\n\\n/** Both halves of a slot's identity, in the shape the shared CLI seam takes. */\\nexport function slotTarget(slot: number): CliTarget {\\n  return { workdir: slotDir(slot), projectId: slotProjectId(slot) };\\n}\\n\\n/**\\n * The Supabase container names in a piece of CLI output that do NOT belong to this slot.\\n *\\n * The CLI names its containers `supabase_<service>_<project id>`, and it prints them: a healthy\\n * `supabase status` opens with `Stopped services: [supabase_imgproxy_<id> supabase_pooler_<id>]`,\\n * and its error paths say things like `No such container: supabase_db_<id>`. That line is the\\n * CLI's own statement of WHICH PROJECT it resolved, and it is the instrument that would have\\n * caught the incident: on 2026-08-10 a hybrid invocation reported the slot's ports beside\\n * `supabase_imgproxy_poancmeitlmxejofwzuu` — the personal project — in the same output.\\n *\\n * The rule is a suffix match and it is deliberately strict: a `supabase_…` token that does not end\\n * in this slot's project id is reported, whatever it is. A false report costs a loud refusal on a\\n * read; a missed one costs a database.\\n */\\nexport function foreignContainerNames(text: string, slotProject: string): string[] {\\n  const names = [...String(text ?? '').matchAll(/\\\\bsupabase_[A-Za-z0-9][A-Za-z0-9_.-]*/g)].map((match) => match[0]);\\n  return [...new Set(names.filter((name) => !name.endsWith(`_${slotProject}`)))];\\n}\\n\\n/**\\n * The Supabase container names in a piece of CLI output that DO belong to this slot — the positive\\n * half of the same instrument (ruling T2).\\n *\\n * MEASURED BEFORE THIS WAS WRITTEN, 2026-08-10, read-only, both slots: `status -o json` through the\\n * shared helper prints exactly two such tokens on stderr —\\n * `Stopped services: [supabase_imgproxy_ai4good-slot-N supabase_pooler_ai4good-slot-N]` — and zero\\n * tokens that belong to any other project. So the evidence this check demands is evidence the CLI\\n * really does produce.\\n *\\n * Absence is not innocence: `foreignContainerNames` finds nothing in an output that names no\\n * container at all, which is exactly the hybrid shape the 2026-08-09 incident wore (the slot's\\n * ports beside another project's containers). A destructive act therefore requires at least one\\n * name that IS this slot's, never merely the lack of one that is not.\\n *\\n * Residual, recorded rather than hidden: those two tokens exist because the tracked config disables\\n * imgproxy and the pooler. A config that enables both would print no \\\"Stopped services\\\" line, this\\n * check would find no evidence, and the destructive act would REFUSE. That is the fail-closed\\n * direction (ruling E7) and it is loud, but it is a real coupling to the config and to the pinned\\n * CLI's output shape (residual F4 in the plan).\\n */\\nexport function ownContainerNames(text: string, slotProject: string): string[] {\\n  const names = [...String(text ?? '').matchAll(/\\\\bsupabase_[A-Za-z0-9][A-Za-z0-9_.-]*/g)].map((match) => match[0]);\\n  return [...new Set(names.filter((name) => name.endsWith(`_${slotProject}`)))];\\n}\\n\\n/**\\n * DOCKER'S OWN ANSWER, on the destructive path, every time (ruling T2).\\n *\\n * The CLI's status output is one instrument and it is coupled to the CLI's version. Docker is a\\n * second, independent one: before a reset, docker must show this slot's OWN database container\\n * running. A docker read is the only interaction anything here is permitted to have with the\\n * founder's stack, and it is unrestricted on slots.\\n *\\n * It fails closed. If docker cannot be run, or reports no container of this slot's own, the reset\\n * refuses: an instrument that cannot answer is not an answer of \\\"yes\\\".\\n */\\nexport function slotDbContainers(slot: number): string[] {\\n  const project = slotProjectId(slot);\\n  const res = spawnSync('docker', ['ps', '--filter', `name=supabase_db_${project}`, '--format', '{{.Names}}'], {\\n    env: childEnv(),\\n    encoding: 'utf8',\\n  });\\n  if (res.error) throw new Error(`docker could not be run to confirm slot ${slot}'s database container (${diagnostic((res.error as Error).message)})`);\\n  if (res.status !== 0) throw new Error(`\\\\`docker ps\\\\` exited ${res.status} while confirming slot ${slot}'s database container: ${diagnostic(res.stderr) || '(no error output)'}`);\\n  return (res.stdout ?? '')\\n    .split('\\\\n')\\n    .map((line) => line.trim())\\n    .filter(Boolean);\\n}\\n\\nfunction proveSlotDbContainer(slot: number, act: string): void {\\n  const project = slotProjectId(slot);\\n  const names = slotDbContainers(slot);\\n  const own = names.filter((name) => name.includes(project));\\n  if (own.length !== names.length || own.length === 0) {\\n    throw new Error(\\n      `REFUSING TO ${act.toUpperCase()} SLOT ${slot}: docker does not confirm this slot's own database container. ` +\\n        `\\\\`docker ps\\\\` named ${names.length ? names.join(', ') : 'no running container'} for ${project}. ` +\\n        `Start the slot (\\\\`bun tests/at/harness/db-pool.ts setup\\\\`) and try again. Nothing was done.`,\\n    );\\n  }\\n  console.log(`db-pool — docker confirms slot ${slot}'s own database container before the ${act}: ${own.join(', ')}`);\\n}\\n\\nexport interface SlotIdentityRead {\\n  /** The stack's own report, when a stack answered. */\\n  status: StackStatus | null;\\n  /** Why no stack answered, when none did. Never a mismatch — a mismatch throws. */\\n  notRunning: string | null;\\n}\\n\\n/**\\n * THE PRE-DESTRUCTIVE IDENTITY READ (ruling E1, decision D13).\\n *\\n * Before anything destructive, the CLI is asked — through the same helper, so the read and the\\n * destructive act resolve identically — to say what it resolves. Three things must hold, and any\\n * one of them failing refuses loudly and does nothing:\\n *\\n *   1. every Supabase container name in the output belongs to this slot's project;\\n *   2. the founder's personal project id appears nowhere in the output;\\n *   3. the ports and keys the stack reports are the slot's own, loopback, locally issued\\n *      (`localStackProblems`, against the SLOT's config).\\n *\\n * A DESTRUCTIVE act adds a fourth, and it is the one that closes the vacuous pass (ruling T2):\\n *\\n *   4. at least one Supabase container name in the output IS this slot's own.\\n *\\n * The first three can all hold over an output that names no container at all, and an output that\\n * names no container is precisely what the 2026-08-09 hybrid produced when it reported the slot's\\n * ports while resolving another project. Absence of contrary evidence is not identity.\\n *\\n * A stack that is simply not running is not a mismatch: it is reported as `notRunning` so the\\n * caller can decide (there is nothing to stop), and only a real disagreement throws.\\n */\\nexport function proveSlotTarget(slot: number, act: string, itemRoot: string = REPO_ROOT, destructive = false): SlotIdentityRead {\\n  const project = slotProjectId(slot);\\n  const res: CliResult = runSupabaseCli(slotTarget(slot), ['status', '-o', 'json']);\\n  if (res.error) {\\n    throw new Error(`refusing to ${act} slot ${slot}: the Supabase CLI could not be launched to read its identity (${diagnostic(res.error.message)})`);\\n  }\\n\\n  const raw = `${res.stdout}\\\\n${res.stderr}`;\\n  const personal = personalProjectId(itemRoot);\\n  const foreign = foreignContainerNames(raw, project);\\n  const carriesPersonal = personal !== '' && raw.includes(personal);\\n  if (foreign.length || carriesPersonal) {\\n    throw new Error(\\n      `REFUSING TO ${act.toUpperCase()} SLOT ${slot}: the identity read did not resolve to ${project}. ` +\\n        (foreign.length ? `The CLI named ${foreign.join(', ')}. ` : '') +\\n        (carriesPersonal ? `The founder's personal project id appears in the output. ` : '') +\\n        `Nothing was done.`,\\n    );\\n  }\\n\\n  let status: StackStatus;\\n  try {\\n    status = parseStackStatus(res);\\n  } catch (err) {\\n    return { status: null, notRunning: diagnostic((err as Error).message) };\\n  }\\n\\n  const config = readLocalConfig(slotDir(slot));\\n  const problems = localStackProblems(status, config);\\n  if (problems.length) {\\n    throw new Error(\\n      `REFUSING TO ${act.toUpperCase()} SLOT ${slot}: the stack that answered is not provably slot ${slot}'s own. ` +\\n        `Failed checks: ${problems.join('; ')}. (Values are deliberately not printed.) Nothing was done.`,\\n    );\\n  }\\n\\n  const own = ownContainerNames(raw, project);\\n  if (destructive && own.length === 0) {\\n    throw new Error(\\n      `REFUSING TO ${act.toUpperCase()} SLOT ${slot}: the identity read names no container belonging to ${project}, ` +\\n        `so it carries no positive evidence of which project the CLI resolved. The ports alone are not identity — ` +\\n        `the 2026-08-09 incident reported the right ports while resolving another project. Nothing was done.`,\\n    );\\n  }\\n\\n  console.log(\\n    `db-pool — slot ${slot} identity proven before the ${act}: project ${project}, api ${config.apiPort}, db ${config.dbPort}` +\\n      (own.length ? `, containers ${own.join(', ')}` : ''),\\n  );\\n  return { status, notRunning: null };\\n}\\n\\n/**\\n * `db reset` on a slot. THE IDENTITY READ IS INSIDE, so no caller can reach the reset without it —\\n * that is what \\\"structurally on the destructive path\\\" means, as opposed to a rule someone follows.\\n */\\nexport async function resetSlotDatabase(slot: number, itemRoot: string = REPO_ROOT): Promise<StackStatus> {\\n  // The BROAD guard first (rulings T7 and F1). D5's ruled sentence names \\\"occupy, prepare, reset or\\n  // emit env\\\", and this is an exported entry point a caller reaches directly — the spike does — so\\n  // it runs the guard itself instead of trusting whoever called it to have run it.\\n  refusePersonalSlotConfig(slot, itemRoot, 'reset');\\n  const read = proveSlotTarget(slot, 'reset', itemRoot, true);\\n  if (!read.status) {\\n    throw new Error(\\n      `refusing to reset slot ${slot}: it reported no running stack, so its identity could not be proven ` +\\n        `(${read.notRunning}). Start the slot first; nothing was reset.`,\\n    );\\n  }\\n  proveSlotDbContainer(slot, 'reset');\\n  await resetLocalDatabase(slotTarget(slot));\\n  return read.status;\\n}\\n\\n/** `stop` on a slot, behind the same guard and the same read. A slot with no stack has nothing to stop. */\\nexport function stopSlotStack(slot: number, itemRoot: string = REPO_ROOT): void {\\n  refusePersonalSlotConfig(slot, itemRoot, 'stop');\\n  const read = proveSlotTarget(slot, 'stop', itemRoot, true);\\n  if (!read.status) {\\n    console.log(`db-pool — slot ${slot} reported no running stack (${read.notRunning}); there is nothing to stop`);\\n    return;\\n  }\\n  runSlotCli(slot, ['stop'], 'stop');\\n}\\n\\n/** `start` on a slot. Not destructive, and a stack that is down cannot be asked who it is first. */\\nexport function startSlotStack(slot: number): void {\\n  runSlotCli(slot, ['start'], 'start');\\n}\\n\\n/**\\n * Make the slot's database be the item tree's database, and prove it.\\n *\\n * The order is load-bearing: mirror the tree, regenerate the identity-overlaid config, restart the\\n * stack IF the configuration it was started with has changed, then read the stack, prove it is\\n * local, wait for readiness, reset, wait again, and prove the migration set replayed.\\n *\\n * WHY A MARKER RATHER THAN THE FILE ITSELF decides the restart: the file says what the slot SHOULD\\n * be running; only a marker written after a successful start says what it IS running. A crash\\n * between writing the config and restarting would otherwise leave equal text over a stack still\\n * serving the old auth behaviour, and the next occupancy would trust it.\\n */\\nexport async function prepare(occupancy: Occupancy, itemRoot: string = REPO_ROOT): Promise<PrepareResult> {\\n  const { slot, dir } = occupancy;\\n  const sourceText = readFileSync(join(itemRoot, 'supabase', 'config.toml'), 'utf8');\\n  const generated = generateSlotConfig(sourceText, slot);\\n\\n  refusePersonal(generated, itemRoot, `prepare slot ${slot}`);\\n\\n  const closure = pathClosureProblems(generated, itemRoot);\\n  if (closure.length) {\\n    throw new Error(\\n      `slot ${slot} would start half-provisioned: ${closure.join('; ')}. No stack was started and nothing was reset.`,\\n    );\\n  }\\n\\n  // THE MIRROR AND THE CONFIG WRITE ARE ONE STEP (ruling T11). The mirror excludes `config.toml`\\n  // and removes the slot's copy, so between these two statements the slot has NO config — never the\\n  // item tree's one, which carries the personal identity. A crash in the window leaves a slot with\\n  // nothing, which `occupy` refuses loudly and one `setup` repairs. The write is unconditional:\\n  // the mirror has just deleted whatever was there.\\n  mirrorItemTree(itemRoot, slot);\\n  const configPath = slotConfigPath(slot);\\n  mkdirSync(join(dir, 'supabase'), { recursive: true });\\n  writeFileSync(configPath, generated, 'utf8');\\n\\n  const hash = hashConfig(generated);\\n  const marker = readMarker(slot);\\n  const restarted = marker?.configHash !== hash;\\n  if (restarted) {\\n    // The auth container reads config at START, not at reset, so a changed config that is not\\n    // restarted into would grade the previous item's auth behaviour.\\n    console.log(`at:verify — db slot ${slot} configuration changed since its last start; restarting the slot's stack`);\\n    stopSlotStack(slot, itemRoot);\\n    startSlotStack(slot);\\n    const proven: StartMarker = { configHash: hash, at: new Date().toISOString(), pid: process.pid };\\n    writeFileSync(slotMarkerPath(slot), JSON.stringify(proven), 'utf8');\\n  }\\n\\n  // The identity read doubles as the prove-local check against the SLOT's config, and it is the\\n  // same read the reset performs again for itself immediately before acting.\\n  const read = proveSlotTarget(slot, 'prepare', itemRoot);\\n  if (!read.status) {\\n    throw new Error(`slot ${slot} reported no running stack (${read.notRunning}), so nothing was reset and nothing was run`);\\n  }\\n  const status = read.status;\\n\\n  await waitForReady(status, `before the slot ${slot} reset`);\\n  await resetSlotDatabase(slot, itemRoot);\\n  await waitForReady(status, `after the slot ${slot} reset`);\\n  const migrations = await proveMigrationsReplayed(status, itemRoot);\\n\\n  return { status, migrations, restarted };\\n}\\n\\n/* ------------------------------------------------------------------------------- env and evidence */\\n\\n/**\\n * The coordinates a suite is allowed to see. Nothing else about the slot travels into the child,\",\"lineStart\":1,\"lineEnd\":1098,\"totalLines\":1099,\"truncated\":true}},\"title\":\"tests\\\\at\\\\harness\\\\db-pool.ts\",\"time\":{\"start\":1786349850291,\"end\":1786349850310}},\"id\":\"prt_feabf8db0001XdOdXbs39872jI\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"messageID\":\"msg_feabf480d001BtXcgLc77qaukr\"}}\r\n+{\"type\":\"text\",\"timestamp\":1786349850361,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feabf8cac001ddebcFGjzte5jG\",\"messageID\":\"msg_feabf480d001BtXcgLc77qaukr\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"type\":\"text\",\"text\":\"I have no shell tool, so I'll verify the diff scope by reading the declared changed files directly. Let me read the new pool module.\",\"time\":{\"start\":1786349849772,\"end\":1786349850359}}}\r\n+{\"type\":\"step_finish\",\"timestamp\":1786349850778,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feabf907d001F1RjS64v2LuTqq\",\"reason\":\"tool-calls\",\"snapshot\":\"435be3ef7ad0d4e3cf3a157e7242b72bd6019cf7\",\"messageID\":\"msg_feabf480d001BtXcgLc77qaukr\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"type\":\"step-finish\",\"tokens\":{\"total\":33724,\"input\":3279,\"output\":114,\"reasoning\":379,\"cache\":{\"write\":0,\"read\":29952}},\"cost\":0.0003404828}}\r\n+{\"type\":\"step_start\",\"timestamp\":1786349852592,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feabf97ae001PcqJR5Ht7mBHcK\",\"messageID\":\"msg_feabf923c001H1e2Z4vWGLd52O\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"snapshot\":\"49bbad20fb156985b7b2a841372bdc5257eccd08\",\"type\":\"step-start\"}}\r\n+{\"type\":\"tool_use\",\"timestamp\":1786349854100,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"type\":\"tool\",\"tool\":\"read\",\"callID\":\"call_00_jXd3erJY4EtFmYxeLKE25766\",\"state\":{\"status\":\"completed\",\"input\":{\"filePath\":\"C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\db-pool.ts\",\"offset\":1099},\"output\":\"<path>C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\db-pool.ts</path>\\n<type>file</type>\\n<content>\\n1099:  * and the personal guard runs here too: env is how a stack reaches a test, so emitting the wrong\\n1100:  * one is as destructive as resetting the wrong one.\\n1101:  *\\n1102:  * TWO CHECKS, and they see different things (rulings T7 and F1). The broad guard reads the slot's\\n1103:  * CONFIG, which is where a personal identity would arrive from; the inline checks below read the\\n1104:  * STATUS, which is what actually answered, and the config guard cannot see that.\\n1105:  */\\n1106: export function stackEnv(occupancy: Occupancy, status: StackStatus, itemRoot: string = REPO_ROOT): Record<string, string> {\\n1107:   refusePersonalSlotConfig(occupancy.slot, itemRoot, 'emit the coordinates of');\\n1108: \\n1109:   for (const [label, raw] of [\\n1110:     ['AT_SUPABASE_URL', status.apiUrl],\\n1111:     ['AT_SUPABASE_DB_URL', status.dbUrl],\\n1112:   ] as const) {\\n1113:     const port = Number(new URL(raw).port);\\n1114:     if (port >= PERSONAL_PORT_LOW && port <= PERSONAL_PORT_HIGH) {\\n1115:       throw new Error(`refusing to emit ${label}: it points at port ${port}, inside the founder's personal stack's port block`);\\n1116:     }\\n1117:   }\\n1118:   if (occupancy.config.projectId === personalProjectId()) {\\n1119:     throw new Error(`refusing to emit slot ${occupancy.slot}'s coordinates: its project id is the personal stack's`);\\n1120:   }\\n1121:   return {\\n1122:     AT_SUPABASE_URL: status.apiUrl,\\n1123:     AT_SUPABASE_DB_URL: status.dbUrl,\\n1124:     AT_SUPABASE_ANON_KEY: status.anonKey,\\n1125:     AT_SUPABASE_SERVICE_ROLE_KEY: status.serviceRoleKey,\\n1126:   };\\n1127: }\\n1128: \\n1129: /**\\n1130:  * The one line the verify transcript carries about the database it ran against: which slot, that\\n1131:  * the reset happened, and what the migration state was. A green that cannot name its reset ran\\n1132:  * against unknown state.\\n1133:  */\\n1134: export function evidence(occupancy: Occupancy, result: PrepareResult): string {\\n1135:   return (\\n1136:     `at:verify — db slot ${occupancy.slot} (${occupancy.config.projectId}, api ${occupancy.config.apiPort}) — ` +\\n1137:     `reset OK — migrations: ${result.migrations.expected} expected, ${result.migrations.applied} applied`\\n1138:   );\\n1139: }\\n1140: \\n1141: /* --------------------------------------------------------------------------------- setup CLI */\\n1142: \\n1143: /**\\n1144:  * The one-time bring-up: create both slot directories, generate both configs from the current\\n1145:  * tree, start both stacks, and report. It never resets and never touches the personal stack — the\\n1146:  * personal report at the end is a plain read, printed so the transcript shows the stack that must\\n1147:  * stay untouched was still on its own ports afterwards.\\n1148:  */\\n1149: async function setup(): Promise<number> {\\n1150:   const sourceText = readFileSync(join(REPO_ROOT, 'supabase', 'config.toml'), 'utf8');\\n1151:   console.log(`db-pool setup — pool root ${poolRoot()}`);\\n1152:   console.log(`db-pool setup — source configuration ${join(REPO_ROOT, 'supabase', 'config.toml')}`);\\n1153:   console.log(`db-pool setup — personal stack project id ${personalProjectId()} (read only; never started, stopped or reset here)`);\\n1154: \\n1155:   for (let slot = 1; slot <= POOL_SIZE; slot++) {\\n1156:     const dir = slotDir(slot);\\n1157:     console.log('');\\n1158:     console.log(`db-pool setup — slot ${slot} at ${dir}`);\\n1159:     const generated = generateSlotConfig(sourceText, slot);\\n1160:     refusePersonal(generated, REPO_ROOT, `set up slot ${slot}`);\\n1161: \\n1162:     const { mappings } = portMappings(sourceText, slot);\\n1163:     for (const mapping of mappings) console.log(`  port  [${mapping.section}] ${mapping.key}: ${mapping.from} -> ${mapping.to}`);\\n1164: \\n1165:     mirrorItemTree(REPO_ROOT, slot);\\n1166:     mkdirSync(join(dir, 'supabase'), { recursive: true });\\n1167:     writeFileSync(slotConfigPath(slot), generated, 'utf8');\\n1168:     mkdirSync(join(poolRoot(), 'reservations'), { recursive: true });\\n1169:     console.log(`  wrote ${slotConfigPath(slot)} (project_id ${slotProjectId(slot)})`);\\n1170: \\n1171:     // STOP BEFORE START (ruling F6). The marker written below means \\\"the stack was started with\\n1172:     // exactly this config\\\", and S2's own transcript measured that `supabase start` on an\\n1173:     // already-running project exits zero having started nothing. A no-op start would write a\\n1174:     // marker that says the slot runs a config it has never read. Stopping first removes the\\n1175:     // condition instead of measuring around it; on a slot that is down this only prints a line.\\n1176:     console.log(`  stopping slot ${slot} first, so the start below is a real one`);\\n1177:     stopSlotStack(slot, REPO_ROOT);\\n1178:     console.log(`  starting slot ${slot} — this pulls container images on a first run`);\\n1179:     startSlotStack(slot);\\n1180:     writeFileSync(slotMarkerPath(slot), JSON.stringify({ configHash: hashConfig(generated), at: new Date().toISOString(), pid: process.pid }), 'utf8');\\n1181: \\n1182:     const read = proveSlotTarget(slot, 'status report', REPO_ROOT);\\n1183:     if (!read.status) throw new Error(`slot ${slot} started but reported no running stack: ${read.notRunning}`);\\n1184:     const status = read.status;\\n1185:     console.log(`  slot ${slot} API_URL ${status.apiUrl}`);\\n1186:     console.log(`  slot ${slot} DB_URL  ${redactDbUrl(status.dbUrl)}`);\\n1187:     console.log(`  slot ${slot} keys    issued (values deliberately not printed)`);\\n1188:   }\\n1189: \\n1190:   console.log('');\\n1191:   console.log('db-pool setup — reading the personal stack (a read; nothing is written to it)');\\n1192:   try {\\n1193:     const personal = readStackStatus();\\n1194:     console.log(`  personal API_URL ${personal.apiUrl}`);\\n1195:     console.log(`  personal DB_URL  ${redactDbUrl(personal.dbUrl)}`);\\n1196:   } catch (err) {\\n1197:     console.log(`  personal stack did not report: ${diagnostic((err as Error).message)}`);\\n1198:   }\\n1199: \\n1200:   console.log('');\\n1201:   for (const view of readPool()) {\\n1202:     console.log(\\n1203:       `db-pool setup — slot ${view.slot}: ${view.configured ? `${view.projectId}, api ${view.apiPort}, db ${view.dbPort}` : 'NOT CONFIGURED'}` +\\n1204:         `, reservation ${view.reservation ? view.reservation.item : 'none'}, occupancy ${view.occupiedBy ? `pid ${view.occupiedBy.pid}` : 'none'}`,\\n1205:     );\\n1206:   }\\n1207:   return 0;\\n1208: }\\n1209: \\n1210: /** The database URL carries the password. Print the coordinates, never the credential. */\\n1211: function redactDbUrl(url: string): string {\\n1212:   return url.replace(/(postgres(?:ql)?:\\\\/\\\\/)[^@\\\\s/]+@/i, '$1<redacted>@');\\n1213: }\\n1214: \\n1215: /* ---------------------------------------------------------------------------------- spike CLI */\\n1216: \\n1217: /**\\n1218:  * THE ISOLATION SPIKE, step S3 as amended by ruling E5 — a CLI entry of this module, never a\\n1219:  * hand-written script. The first spike WAS a hand-written script; it closed neither route the\\n1220:  * identity override travels by, and it destroyed the founder's personal database. So the thing\\n1221:  * that proves the wall is now the thing that IS the wall: every CLI call below goes through the\\n1222:  * same helper the runner uses.\\n1223:  *\\n1224:  * IT TOUCHES THE PERSONAL STACK NOT AT ALL. Its instrument for the personal stack is a docker-level\\n1225:  * identity snapshot — a read — taken before and after, and compared on identity fields only. The\\n1226:  * breach signature was RECREATION (a new container id, a new volume timestamp), so identity-field\\n1227:  * equality is the direct negative of the breach. Run state is excluded on purpose: one container\\n1228:  * (`vector`) restart-loops on all three stacks by itself.\\n1229:  *\\n1230:  * THE HOSTILE CONDITION IS MANDATORY. The spike refuses to run unless its own process carries\\n1231:  * `SUPABASE_PROJECT_ID=<the personal project id>` — the exact override that caused the incident.\\n1232:  * A pass therefore proves the helper closes the route WHILE the route is loaded, rather than\\n1233:  * proving the route happened to be empty that day.\\n1234:  */\\n1235: \\n1236: /** bun's SQL client. Described here rather than imported: the runner keeps its own private copy. */\\n1237: interface BunSqlClient {\\n1238:   (strings: TemplateStringsArray, ...values: unknown[]): Promise<unknown>;\\n1239:   close(): Promise<void>;\\n1240: }\\n1241: type BunSqlCtor = new (url: string) => BunSqlClient;\\n1242: \\n1243: /** A canary connection may only ever reach a slot; the personal block is refused at the socket. */\\n1244: async function withSlotSql<T>(slot: number, status: StackStatus, fn: (sql: BunSqlClient) => Promise<T>): Promise<T> {\\n1245:   const port = Number(new URL(status.dbUrl).port);\\n1246:   if (!Number.isFinite(port) || (port >= PERSONAL_PORT_LOW && port <= PERSONAL_PORT_HIGH)) {\\n1247:     throw new Error(`refusing to open a connection for slot ${slot}: port ${port} is inside the founder's personal port block`);\\n1248:   }\\n1249:   const SQL = (globalThis as { Bun?: { SQL?: BunSqlCtor } }).Bun?.SQL;\\n1250:   if (!SQL) throw new Error('this runtime has no SQL client (expected bun)');\\n1251:   const sql = new SQL(status.dbUrl);\\n1252:   try {\\n1253:     return await fn(sql);\\n1254:   } finally {\\n1255:     await sql.close().catch(() => undefined);\\n1256:   }\\n1257: }\\n1258: \\n1259: /**\\n1260:  * DROP AND RECREATE, never `create table if not exists`: the first spike left a `spike_canary`\\n1261:  * table of its own shape in slot 1, and an insert against somebody else's columns fails on a\\n1262:  * constraint rather than writing the canary. The canary has to be this run's own table.\\n1263:  */\\n1264: async function writeCanary(slot: number, status: StackStatus, note: string): Promise<void> {\\n1265:   await withSlotSql(slot, status, async (sql) => {\\n1266:     await sql`drop table if exists public.spike_canary`;\\n1267:     await sql`create table public.spike_canary (note text)`;\\n1268:     await sql`insert into public.spike_canary (note) values (${note})`;\\n1269:   });\\n1270: }\\n1271: \\n1272: /** The canary's note, or null when the table or the row is gone — which is what a reset does. */\\n1273: async function readCanary(slot: number, status: StackStatus): Promise<string | null> {\\n1274:   return withSlotSql(slot, status, async (sql) => {\\n1275:     try {\\n1276:       const rows = (await sql`select note from public.spike_canary`) as { note?: unknown }[];\\n1277:       return rows.length ? String(rows[0].note) : null;\\n1278:     } catch (err) {\\n1279:       const message = (err as Error).message ?? '';\\n1280:       if (/spike_canary/.test(message) && /does not exist/i.test(message)) return null;\\n1281:       throw err;\\n1282:     }\\n1283:   });\\n1284: }\\n1285: \\n1286: function dockerLines(args: string[]): string[] {\\n1287:   const res = spawnSync('docker', args, { env: childEnv(), encoding: 'utf8' });\\n1288:   if (res.error) throw new Error(`docker could not be run (${diagnostic((res.error as Error).message)})`);\\n1289:   if (res.status !== 0) throw new Error(`\\\\`docker ${args.slice(0, 2).join(' ')}\\\\` exited ${res.status}: ${diagnostic(res.stderr) || '(no error output)'}`);\\n1290:   return (res.stdout ?? '')\\n1291:     .split('\\\\n')\\n1292:     .map((line) => line.trim())\\n1293:     .filter(Boolean);\\n1294: }\\n1295: \\n1296: interface DockerSnapshot {\\n1297:   containers: string[];\\n1298:   volumes: string[];\\n1299: }\\n1300: \\n1301: /**\\n1302:  * A READ-ONLY identity record of the personal stack's docker objects. Only `ps`, `inspect`,\\n1303:  * `volume ls` and `volume inspect` are used, and only identity fields are recorded: container id,\\n1304:  * created timestamp, image and port bindings; volume name and CreatedAt. No run state.\\n1305:  */\\n1306: function personalDockerSnapshot(personal: string): DockerSnapshot {\\n1307:   const containerNames = dockerLines(['ps', '-a', '--filter', `name=${personal}`, '--format', '{{.Names}}']).sort();\\n1308:   const containers = containerNames.length\\n1309:     ? dockerLines([\\n1310:         'inspect',\\n1311:         '--format',\\n1312:         '{{.Name}} | id {{.Id}} | created {{.Created}} | image {{.Config.Image}} | ports {{json .HostConfig.PortBindings}}',\\n1313:         ...containerNames,\\n1314:       ]).sort()\\n1315:     : [];\\n1316:   const volumeNames = dockerLines(['volume', 'ls', '--filter', `name=${personal}`, '--format', '{{.Name}}']).sort();\\n1317:   const volumes = volumeNames.length\\n1318:     ? dockerLines(['volume', 'inspect', '--format', '{{.Name}} | created {{.CreatedAt}}', ...volumeNames]).sort()\\n1319:     : [];\\n1320:   return { containers, volumes };\\n1321: }\\n1322: \\n1323: function snapshotDifferences(before: DockerSnapshot, after: DockerSnapshot): string[] {\\n1324:   const differences: string[] = [];\\n1325:   const pairs = [\\n1326:     ['container', before.containers, after.containers],\\n1327:     ['volume', before.volumes, after.volumes],\\n1328:   ] as const;\\n1329:   for (const [what, first, second] of pairs) {\\n1330:     for (const line of first) if (!second.includes(line)) differences.push(`${what} recorded BEFORE and not after: ${line}`);\\n1331:     for (const line of second) if (!first.includes(line)) differences.push(`${what} recorded AFTER and not before: ${line}`);\\n1332:   }\\n1333:   return differences;\\n1334: }\\n1335: \\n1336: function gitHead(): string {\\n1337:   const res = spawnSync('git', ['-C', REPO_ROOT, 'rev-parse', 'HEAD'], { encoding: 'utf8', env: childEnv() });\\n1338:   return (res.stdout ?? '').trim() || '(git could not report the head)';\\n1339: }\\n1340: \\n1341: async function spike(): Promise<number> {\\n1342:   const personal = personalProjectId();\\n1343:   const hostile = process.env.SUPABASE_PROJECT_ID ?? '';\\n1344: \\n1345:   console.log('');\\n1346:   console.log('AI4DEV-79 (parallel DB slot pool) - step S3 as amended by ruling E5, the isolation re-proof.');\\n1347:   console.log('');\\n1348:   console.log('REDACTION: database passwords and any key-shaped token are replaced before printing.');\\n1349:   console.log('Container names, project ids and ports are kept: they are the evidence.');\\n1350:   console.log('');\\n1351:   console.log(`date      : ${new Date().toISOString()}`);\\n1352:   console.log(`machine   : ${hostname()}`);\\n1353:   console.log(`worktree  : ${REPO_ROOT}`);\\n1354:   console.log(`branch    : ${(() => { try { return currentBranch(); } catch { return '(unreadable)'; } })()}`);\\n1355:   console.log(`head      : ${gitHead()}`);\\n1356:   console.log(`pool root : ${poolRoot()}`);\\n1357:   console.log('');\\n1358: \\n1359:   console.log('=== the hostile condition, mandatory ===');\\n1360:   if (hostile !== personal) {\\n1361:     console.log(`REFUSING TO RUN. The parent process carries SUPABASE_PROJECT_ID=\\\"${hostile}\\\" and the proof needs \\\"${personal}\\\".`);\\n1362:     console.log('Run this entry so the tracked .env loads into the parent, or set the variable in the parent shell.');\\n1363:     console.log('A pass under a clean environment would prove nothing: the route this helper closes would not be loaded.');\\n1364:     return 2;\\n1365:   }\\n1366:   console.log(`SUPABASE_PROJECT_ID IS PRESENT IN THIS PROCESS: \\\"${hostile}\\\".`);\\n1367:   console.log('That is the founder\\\\'s personal project id, and it is the exact override that destroyed the personal');\\n1368:   console.log('database on 2026-08-09. It stays in this process for the whole run. Every CLI call below is made');\\n1369:   console.log('through the shared helper, which states the slot identity positively in the child environment.');\\n1370:   console.log('');\\n1371: \\n1372:   console.log('=== (a) BEFORE: docker identity snapshot of the personal stack (a READ; nothing is written) ===');\\n1373:   const before = personalDockerSnapshot(personal);\\n1374:   for (const line of before.containers) console.log(`  ${line}`);\\n1375:   for (const line of before.volumes) console.log(`  ${line}`);\\n1376:   console.log(`  ${before.containers.length} containers, ${before.volumes.length} volumes recorded`);\\n1377:   console.log('');\\n1378: \\n1379:   let failure: string | null = null;\\n1380:   let slot1Canary: string | null = null;\\n1381:   let slot2Canary: string | null = null;\\n1382:   let preReadShown = false;\\n1383:   let resetDone = false;\\n1384:   let held1: Occupancy | null = null;\\n1385:   let held2: Occupancy | null = null;\\n1386: \\n1387:   try {\\n1388:     // THE SPIKE TAKES BOTH SLOTS FIRST (ruling T4). D6's own sentence — \\\"the occupancy claim still\\n1389:     // applies\\\" for override runs — binds this run too: it writes to slot 1 and resets slot 2, so a\\n1390:     // verify window opening on either one under it would be exactly the collision the pool exists\\n1391:     // to prevent. Both claims are released in the `finally` below.\\n1392:     console.log('=== (a2) occupying both slots, dead-pid-only, before anything is touched ===');\\n1393:     held1 = occupy('spike', { slot: 1 });\\n1394:     held2 = occupy('spike', { slot: 2 });\\n1395:     console.log(`  slot 1 claim ${held1.claim.file}`);\\n1396:     console.log(`  slot 2 claim ${held2.claim.file}`);\\n1397:     console.log('');\\n1398: \\n1399:     console.log('=== (b) preflight: both slots answer on their own port block, through the helper ===');\\n1400:     const statuses = new Map<number, StackStatus>();\\n1401:     for (const slot of [1, 2]) {\\n1402:       let read = proveSlotTarget(slot, `preflight of slot ${slot}`);\\n1403:       if (!read.status) {\\n1404:         console.log(`  slot ${slot} reported no running stack (${read.notRunning}); starting it — slots are pool property`);\\n1405:         startSlotStack(slot);\\n1406:         read = proveSlotTarget(slot, `preflight of slot ${slot}`);\\n1407:       }\\n1408:       if (!read.status) throw new Error(`slot ${slot} still reports no running stack: ${read.notRunning}`);\\n1409:       statuses.set(slot, read.status);\\n1410:       console.log(`  slot ${slot}  API ${read.status.apiUrl}  DB ${redactDbUrl(read.status.dbUrl)}`);\\n1411:     }\\n1412:     const slot1 = statuses.get(1) as StackStatus;\\n1413:     const slot2 = statuses.get(2) as StackStatus;\\n1414:     console.log('');\\n1415: \\n1416:     console.log('=== (c) canary row in slot 1 — the bystander that must SURVIVE ===');\\n1417:     await writeCanary(1, slot1, 'slot-1 canary');\\n1418:     console.log(`  slot 1 canary written: ${JSON.stringify(await readCanary(1, slot1))}`);\\n1419:     console.log('');\\n1420: \\n1421:     console.log('=== (d) canary row in slot 2 — the row the reset must DESTROY ===');\\n1422:     await writeCanary(2, slot2, 'slot-2 canary');\\n1423:     console.log(`  slot 2 canary written: ${JSON.stringify(await readCanary(2, slot2))}`);\\n1424:     console.log('');\\n1425: \\n1426:     console.log('=== (e) the pre-destructive identity read on slot 2 ===');\\n1427:     const read = proveSlotTarget(2, 'reset', REPO_ROOT, true);\\n1428:     if (!read.status) throw new Error(`slot 2 reported no running stack: ${read.notRunning}`);\\n1429:     preReadShown = true;\\n1430:     console.log('  the line above is the helper stating which project the CLI resolved, before anything destructive.');\\n1431:     console.log('');\\n1432: \\n1433:     console.log('=== (f) supabase db reset, aimed at slot 2, through the helper, hostile variable present ===');\\n1434:     await resetSlotDatabase(2);\\n1435:     resetDone = true;\\n1436:     console.log('  the reset exited zero.');\\n1437:     console.log('');\\n1438: \\n1439:     console.log('=== (g) the canaries after the reset ===');\\n1440:     slot1Canary = await readCanary(1, slot1);\\n1441:     slot2Canary = await readCanary(2, slot2);\\n1442:     console.log(`  slot 1 canary: ${JSON.stringify(slot1Canary)}`);\\n1443:     console.log(`  slot 2 canary: ${JSON.stringify(slot2Canary)}`);\\n1444:     console.log('');\\n1445:   } catch (err) {\\n1446:     failure = diagnostic((err as Error).message, 2000);\\n1447:     console.log('');\\n1448:     console.log(`STOPPED: ${failure}`);\\n1449:     console.log('');\\n1450:   } finally {\\n1451:     release(held2);\\n1452:     release(held1);\\n1453:     console.log('=== both slot claims released ===');\\n1454:     console.log('');\\n1455:   }\\n1456: \\n1457:   console.log('=== (h) AFTER: the same docker identity snapshot, compared on identity fields only ===');\\n1458:   const after = personalDockerSnapshot(personal);\\n1459:   for (const line of after.containers) console.log(`  ${line}`);\\n1460:   for (const line of after.volumes) console.log(`  ${line}`);\\n1461:   const differences = snapshotDifferences(before, after);\\n1462:   if (differences.length === 0) console.log('  IDENTICAL: same container ids, created timestamps, images, port bindings, volumes and volume CreatedAt.');\\n1463:   else for (const line of differences) console.log(`  DIFFERENT: ${line}`);\\n1464:   console.log('');\\n1465: \\n1466:   const criteria: [string, boolean][] = [\\n1467:     ['the hostile variable was present in the parent process', hostile === personal],\\n1468:     // Ruling F2: without this, a slot 2 canary READ that throws after a good reset is swallowed by\\n1469:     // the catch, and every remaining criterion passes with the canary never read at all.\\n1470:     ['the spike body completed without an exception', failure === null],\\n1471:     ['the identity pre-read named slot 2 before the reset', preReadShown],\\n1472:     ['the reset ran through the helper and exited zero', resetDone],\\n1473:     ['the slot 2 canary is GONE — the reset acted on slot 2', resetDone && slot2Canary === null],\\n1474:     ['the slot 1 canary SURVIVES — the reset acted on nothing else', slot1Canary === 'slot-1 canary'],\\n1475:     // Ruling T12: two empty docker queries compare EQUAL, so the central instrument would report\\n1476:     // IDENTICAL while having observed nothing at all.\\n1477:     [\\n1478:       'the BEFORE snapshot recorded at least one personal container and one personal volume',\\n1479:       before.containers.length > 0 && before.volumes.length > 0,\\n1480:     ],\\n1481:     ['the personal docker snapshots are equal on every identity field', differences.length === 0],\\n1482:   ];\\n1483:   console.log('=== the done-criterion, item by item ===');\\n1484:   for (const [what, met] of criteria) console.log(`  ${met ? 'PASS' : 'FAIL'}  ${what}`);\\n1485:   const passed = criteria.every(([, met]) => met);\\n1486:   console.log('');\\n1487:   console.log(passed ? 'THE SPIKE PASSED: the wall holds under the exact condition that broke it.' : 'THE SPIKE FAILED. The wall is NOT proven.');\\n1488:   console.log('');\\n1489:   console.log('Residue: slot 1 keeps a public.spike_canary table until its next occupancy, which resets it.');\\n1490:   console.log('END OF S3 TRANSCRIPT (re-proof)');\\n1491:   return passed ? 0 : 1;\\n1492: }\\n1493: \\n1494: function usage(): void {\\n1495:   console.error('usage: bun tests/at/harness/db-pool.ts <setup|status|spike>');\\n1496: }\\n1497: \\n1498: async function main(argv: string[]): Promise<number> {\\n1499:   const command = argv[0] ?? '';\\n1500:   if (command === 'setup') return setup();\\n1501:   if (command === 'spike') return spike();\\n1502:   if (command === 'status') {\\n1503:     for (const view of readPool()) {\\n1504:       console.log(\\n1505:         `slot ${view.slot}: ${view.configured ? `${view.projectId}, api ${view.apiPort}` : 'NOT CONFIGURED'}` +\\n1506:           `, reservation ${view.reservation ? `${view.reservation.item} (${view.reservation.at})` : 'none'}` +\\n1507:           `, occupancy ${view.occupiedBy ? `pid ${view.occupiedBy.pid} for ${view.occupiedBy.requirement}` : 'none'}`,\\n1508:       );\\n1509:     }\\n1510:     return 0;\\n1511:   }\\n1512:   usage();\\n1513:   return 2;\\n1514: }\\n1515: \\n1516: if (import.meta.main) {\\n1517:   try {\\n1518:     process.exit(await main(process.argv.slice(2)));\\n1519:   } catch (err) {\\n1520:     console.error(`db-pool — ${(err as Error).message}`);\\n1521:     process.exit(3);\\n1522:   }\\n1523: }\\n\\n(End of file - total 1523 lines)\\n</content>\",\"metadata\":{\"preview\":\" * and the personal guard runs here too: env is how a stack reaches a test, so emitting the wrong\\n * one is as destructive as resetting the wrong one.\\n *\\n * TWO CHECKS, and they see different things (rulings T7 and F1). The broad guard reads the slot's\\n * CONFIG, which is where a personal identity would arrive from; the inline checks below read the\\n * STATUS, which is what actually answered, and the config guard cannot see that.\\n */\\nexport function stackEnv(occupancy: Occupancy, status: StackStatus, itemRoot: string = REPO_ROOT): Record<string, string> {\\n  refusePersonalSlotConfig(occupancy.slot, itemRoot, 'emit the coordinates of');\\n\\n  for (const [label, raw] of [\\n    ['AT_SUPABASE_URL', status.apiUrl],\\n    ['AT_SUPABASE_DB_URL', status.dbUrl],\\n  ] as const) {\\n    const port = Number(new URL(raw).port);\\n    if (port >= PERSONAL_PORT_LOW && port <= PERSONAL_PORT_HIGH) {\\n      throw new Error(`refusing to emit ${label}: it points at port ${port}, inside the founder's personal stack's port block`);\\n    }\\n  }\\n  if (occupancy.config.projectId === personalProjectId()) {\",\"truncated\":false,\"loaded\":[],\"display\":{\"type\":\"file\",\"path\":\"C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\db-pool.ts\",\"text\":\" * and the personal guard runs here too: env is how a stack reaches a test, so emitting the wrong\\n * one is as destructive as resetting the wrong one.\\n *\\n * TWO CHECKS, and they see different things (rulings T7 and F1). The broad guard reads the slot's\\n * CONFIG, which is where a personal identity would arrive from; the inline checks below read the\\n * STATUS, which is what actually answered, and the config guard cannot see that.\\n */\\nexport function stackEnv(occupancy: Occupancy, status: StackStatus, itemRoot: string = REPO_ROOT): Record<string, string> {\\n  refusePersonalSlotConfig(occupancy.slot, itemRoot, 'emit the coordinates of');\\n\\n  for (const [label, raw] of [\\n    ['AT_SUPABASE_URL', status.apiUrl],\\n    ['AT_SUPABASE_DB_URL', status.dbUrl],\\n  ] as const) {\\n    const port = Number(new URL(raw).port);\\n    if (port >= PERSONAL_PORT_LOW && port <= PERSONAL_PORT_HIGH) {\\n      throw new Error(`refusing to emit ${label}: it points at port ${port}, inside the founder's personal stack's port block`);\\n    }\\n  }\\n  if (occupancy.config.projectId === personalProjectId()) {\\n    throw new Error(`refusing to emit slot ${occupancy.slot}'s coordinates: its project id is the personal stack's`);\\n  }\\n  return {\\n    AT_SUPABASE_URL: status.apiUrl,\\n    AT_SUPABASE_DB_URL: status.dbUrl,\\n    AT_SUPABASE_ANON_KEY: status.anonKey,\\n    AT_SUPABASE_SERVICE_ROLE_KEY: status.serviceRoleKey,\\n  };\\n}\\n\\n/**\\n * The one line the verify transcript carries about the database it ran against: which slot, that\\n * the reset happened, and what the migration state was. A green that cannot name its reset ran\\n * against unknown state.\\n */\\nexport function evidence(occupancy: Occupancy, result: PrepareResult): string {\\n  return (\\n    `at:verify — db slot ${occupancy.slot} (${occupancy.config.projectId}, api ${occupancy.config.apiPort}) — ` +\\n    `reset OK — migrations: ${result.migrations.expected} expected, ${result.migrations.applied} applied`\\n  );\\n}\\n\\n/* --------------------------------------------------------------------------------- setup CLI */\\n\\n/**\\n * The one-time bring-up: create both slot directories, generate both configs from the current\\n * tree, start both stacks, and report. It never resets and never touches the personal stack — the\\n * personal report at the end is a plain read, printed so the transcript shows the stack that must\\n * stay untouched was still on its own ports afterwards.\\n */\\nasync function setup(): Promise<number> {\\n  const sourceText = readFileSync(join(REPO_ROOT, 'supabase', 'config.toml'), 'utf8');\\n  console.log(`db-pool setup — pool root ${poolRoot()}`);\\n  console.log(`db-pool setup — source configuration ${join(REPO_ROOT, 'supabase', 'config.toml')}`);\\n  console.log(`db-pool setup — personal stack project id ${personalProjectId()} (read only; never started, stopped or reset here)`);\\n\\n  for (let slot = 1; slot <= POOL_SIZE; slot++) {\\n    const dir = slotDir(slot);\\n    console.log('');\\n    console.log(`db-pool setup — slot ${slot} at ${dir}`);\\n    const generated = generateSlotConfig(sourceText, slot);\\n    refusePersonal(generated, REPO_ROOT, `set up slot ${slot}`);\\n\\n    const { mappings } = portMappings(sourceText, slot);\\n    for (const mapping of mappings) console.log(`  port  [${mapping.section}] ${mapping.key}: ${mapping.from} -> ${mapping.to}`);\\n\\n    mirrorItemTree(REPO_ROOT, slot);\\n    mkdirSync(join(dir, 'supabase'), { recursive: true });\\n    writeFileSync(slotConfigPath(slot), generated, 'utf8');\\n    mkdirSync(join(poolRoot(), 'reservations'), { recursive: true });\\n    console.log(`  wrote ${slotConfigPath(slot)} (project_id ${slotProjectId(slot)})`);\\n\\n    // STOP BEFORE START (ruling F6). The marker written below means \\\"the stack was started with\\n    // exactly this config\\\", and S2's own transcript measured that `supabase start` on an\\n    // already-running project exits zero having started nothing. A no-op start would write a\\n    // marker that says the slot runs a config it has never read. Stopping first removes the\\n    // condition instead of measuring around it; on a slot that is down this only prints a line.\\n    console.log(`  stopping slot ${slot} first, so the start below is a real one`);\\n    stopSlotStack(slot, REPO_ROOT);\\n    console.log(`  starting slot ${slot} — this pulls container images on a first run`);\\n    startSlotStack(slot);\\n    writeFileSync(slotMarkerPath(slot), JSON.stringify({ configHash: hashConfig(generated), at: new Date().toISOString(), pid: process.pid }), 'utf8');\\n\\n    const read = proveSlotTarget(slot, 'status report', REPO_ROOT);\\n    if (!read.status) throw new Error(`slot ${slot} started but reported no running stack: ${read.notRunning}`);\\n    const status = read.status;\\n    console.log(`  slot ${slot} API_URL ${status.apiUrl}`);\\n    console.log(`  slot ${slot} DB_URL  ${redactDbUrl(status.dbUrl)}`);\\n    console.log(`  slot ${slot} keys    issued (values deliberately not printed)`);\\n  }\\n\\n  console.log('');\\n  console.log('db-pool setup — reading the personal stack (a read; nothing is written to it)');\\n  try {\\n    const personal = readStackStatus();\\n    console.log(`  personal API_URL ${personal.apiUrl}`);\\n    console.log(`  personal DB_URL  ${redactDbUrl(personal.dbUrl)}`);\\n  } catch (err) {\\n    console.log(`  personal stack did not report: ${diagnostic((err as Error).message)}`);\\n  }\\n\\n  console.log('');\\n  for (const view of readPool()) {\\n    console.log(\\n      `db-pool setup — slot ${view.slot}: ${view.configured ? `${view.projectId}, api ${view.apiPort}, db ${view.dbPort}` : 'NOT CONFIGURED'}` +\\n        `, reservation ${view.reservation ? view.reservation.item : 'none'}, occupancy ${view.occupiedBy ? `pid ${view.occupiedBy.pid}` : 'none'}`,\\n    );\\n  }\\n  return 0;\\n}\\n\\n/** The database URL carries the password. Print the coordinates, never the credential. */\\nfunction redactDbUrl(url: string): string {\\n  return url.replace(/(postgres(?:ql)?:\\\\/\\\\/)[^@\\\\s/]+@/i, '$1<redacted>@');\\n}\\n\\n/* ---------------------------------------------------------------------------------- spike CLI */\\n\\n/**\\n * THE ISOLATION SPIKE, step S3 as amended by ruling E5 — a CLI entry of this module, never a\\n * hand-written script. The first spike WAS a hand-written script; it closed neither route the\\n * identity override travels by, and it destroyed the founder's personal database. So the thing\\n * that proves the wall is now the thing that IS the wall: every CLI call below goes through the\\n * same helper the runner uses.\\n *\\n * IT TOUCHES THE PERSONAL STACK NOT AT ALL. Its instrument for the personal stack is a docker-level\\n * identity snapshot — a read — taken before and after, and compared on identity fields only. The\\n * breach signature was RECREATION (a new container id, a new volume timestamp), so identity-field\\n * equality is the direct negative of the breach. Run state is excluded on purpose: one container\\n * (`vector`) restart-loops on all three stacks by itself.\\n *\\n * THE HOSTILE CONDITION IS MANDATORY. The spike refuses to run unless its own process carries\\n * `SUPABASE_PROJECT_ID=<the personal project id>` — the exact override that caused the incident.\\n * A pass therefore proves the helper closes the route WHILE the route is loaded, rather than\\n * proving the route happened to be empty that day.\\n */\\n\\n/** bun's SQL client. Described here rather than imported: the runner keeps its own private copy. */\\ninterface BunSqlClient {\\n  (strings: TemplateStringsArray, ...values: unknown[]): Promise<unknown>;\\n  close(): Promise<void>;\\n}\\ntype BunSqlCtor = new (url: string) => BunSqlClient;\\n\\n/** A canary connection may only ever reach a slot; the personal block is refused at the socket. */\\nasync function withSlotSql<T>(slot: number, status: StackStatus, fn: (sql: BunSqlClient) => Promise<T>): Promise<T> {\\n  const port = Number(new URL(status.dbUrl).port);\\n  if (!Number.isFinite(port) || (port >= PERSONAL_PORT_LOW && port <= PERSONAL_PORT_HIGH)) {\\n    throw new Error(`refusing to open a connection for slot ${slot}: port ${port} is inside the founder's personal port block`);\\n  }\\n  const SQL = (globalThis as { Bun?: { SQL?: BunSqlCtor } }).Bun?.SQL;\\n  if (!SQL) throw new Error('this runtime has no SQL client (expected bun)');\\n  const sql = new SQL(status.dbUrl);\\n  try {\\n    return await fn(sql);\\n  } finally {\\n    await sql.close().catch(() => undefined);\\n  }\\n}\\n\\n/**\\n * DROP AND RECREATE, never `create table if not exists`: the first spike left a `spike_canary`\\n * table of its own shape in slot 1, and an insert against somebody else's columns fails on a\\n * constraint rather than writing the canary. The canary has to be this run's own table.\\n */\\nasync function writeCanary(slot: number, status: StackStatus, note: string): Promise<void> {\\n  await withSlotSql(slot, status, async (sql) => {\\n    await sql`drop table if exists public.spike_canary`;\\n    await sql`create table public.spike_canary (note text)`;\\n    await sql`insert into public.spike_canary (note) values (${note})`;\\n  });\\n}\\n\\n/** The canary's note, or null when the table or the row is gone — which is what a reset does. */\\nasync function readCanary(slot: number, status: StackStatus): Promise<string | null> {\\n  return withSlotSql(slot, status, async (sql) => {\\n    try {\\n      const rows = (await sql`select note from public.spike_canary`) as { note?: unknown }[];\\n      return rows.length ? String(rows[0].note) : null;\\n    } catch (err) {\\n      const message = (err as Error).message ?? '';\\n      if (/spike_canary/.test(message) && /does not exist/i.test(message)) return null;\\n      throw err;\\n    }\\n  });\\n}\\n\\nfunction dockerLines(args: string[]): string[] {\\n  const res = spawnSync('docker', args, { env: childEnv(), encoding: 'utf8' });\\n  if (res.error) throw new Error(`docker could not be run (${diagnostic((res.error as Error).message)})`);\\n  if (res.status !== 0) throw new Error(`\\\\`docker ${args.slice(0, 2).join(' ')}\\\\` exited ${res.status}: ${diagnostic(res.stderr) || '(no error output)'}`);\\n  return (res.stdout ?? '')\\n    .split('\\\\n')\\n    .map((line) => line.trim())\\n    .filter(Boolean);\\n}\\n\\ninterface DockerSnapshot {\\n  containers: string[];\\n  volumes: string[];\\n}\\n\\n/**\\n * A READ-ONLY identity record of the personal stack's docker objects. Only `ps`, `inspect`,\\n * `volume ls` and `volume inspect` are used, and only identity fields are recorded: container id,\\n * created timestamp, image and port bindings; volume name and CreatedAt. No run state.\\n */\\nfunction personalDockerSnapshot(personal: string): DockerSnapshot {\\n  const containerNames = dockerLines(['ps', '-a', '--filter', `name=${personal}`, '--format', '{{.Names}}']).sort();\\n  const containers = containerNames.length\\n    ? dockerLines([\\n        'inspect',\\n        '--format',\\n        '{{.Name}} | id {{.Id}} | created {{.Created}} | image {{.Config.Image}} | ports {{json .HostConfig.PortBindings}}',\\n        ...containerNames,\\n      ]).sort()\\n    : [];\\n  const volumeNames = dockerLines(['volume', 'ls', '--filter', `name=${personal}`, '--format', '{{.Name}}']).sort();\\n  const volumes = volumeNames.length\\n    ? dockerLines(['volume', 'inspect', '--format', '{{.Name}} | created {{.CreatedAt}}', ...volumeNames]).sort()\\n    : [];\\n  return { containers, volumes };\\n}\\n\\nfunction snapshotDifferences(before: DockerSnapshot, after: DockerSnapshot): string[] {\\n  const differences: string[] = [];\\n  const pairs = [\\n    ['container', before.containers, after.containers],\\n    ['volume', before.volumes, after.volumes],\\n  ] as const;\\n  for (const [what, first, second] of pairs) {\\n    for (const line of first) if (!second.includes(line)) differences.push(`${what} recorded BEFORE and not after: ${line}`);\\n    for (const line of second) if (!first.includes(line)) differences.push(`${what} recorded AFTER and not before: ${line}`);\\n  }\\n  return differences;\\n}\\n\\nfunction gitHead(): string {\\n  const res = spawnSync('git', ['-C', REPO_ROOT, 'rev-parse', 'HEAD'], { encoding: 'utf8', env: childEnv() });\\n  return (res.stdout ?? '').trim() || '(git could not report the head)';\\n}\\n\\nasync function spike(): Promise<number> {\\n  const personal = personalProjectId();\\n  const hostile = process.env.SUPABASE_PROJECT_ID ?? '';\\n\\n  console.log('');\\n  console.log('AI4DEV-79 (parallel DB slot pool) - step S3 as amended by ruling E5, the isolation re-proof.');\\n  console.log('');\\n  console.log('REDACTION: database passwords and any key-shaped token are replaced before printing.');\\n  console.log('Container names, project ids and ports are kept: they are the evidence.');\\n  console.log('');\\n  console.log(`date      : ${new Date().toISOString()}`);\\n  console.log(`machine   : ${hostname()}`);\\n  console.log(`worktree  : ${REPO_ROOT}`);\\n  console.log(`branch    : ${(() => { try { return currentBranch(); } catch { return '(unreadable)'; } })()}`);\\n  console.log(`head      : ${gitHead()}`);\\n  console.log(`pool root : ${poolRoot()}`);\\n  console.log('');\\n\\n  console.log('=== the hostile condition, mandatory ===');\\n  if (hostile !== personal) {\\n    console.log(`REFUSING TO RUN. The parent process carries SUPABASE_PROJECT_ID=\\\"${hostile}\\\" and the proof needs \\\"${personal}\\\".`);\\n    console.log('Run this entry so the tracked .env loads into the parent, or set the variable in the parent shell.');\\n    console.log('A pass under a clean environment would prove nothing: the route this helper closes would not be loaded.');\\n    return 2;\\n  }\\n  console.log(`SUPABASE_PROJECT_ID IS PRESENT IN THIS PROCESS: \\\"${hostile}\\\".`);\\n  console.log('That is the founder\\\\'s personal project id, and it is the exact override that destroyed the personal');\\n  console.log('database on 2026-08-09. It stays in this process for the whole run. Every CLI call below is made');\\n  console.log('through the shared helper, which states the slot identity positively in the child environment.');\\n  console.log('');\\n\\n  console.log('=== (a) BEFORE: docker identity snapshot of the personal stack (a READ; nothing is written) ===');\\n  const before = personalDockerSnapshot(personal);\\n  for (const line of before.containers) console.log(`  ${line}`);\\n  for (const line of before.volumes) console.log(`  ${line}`);\\n  console.log(`  ${before.containers.length} containers, ${before.volumes.length} volumes recorded`);\\n  console.log('');\\n\\n  let failure: string | null = null;\\n  let slot1Canary: string | null = null;\\n  let slot2Canary: string | null = null;\\n  let preReadShown = false;\\n  let resetDone = false;\\n  let held1: Occupancy | null = null;\\n  let held2: Occupancy | null = null;\\n\\n  try {\\n    // THE SPIKE TAKES BOTH SLOTS FIRST (ruling T4). D6's own sentence — \\\"the occupancy claim still\\n    // applies\\\" for override runs — binds this run too: it writes to slot 1 and resets slot 2, so a\\n    // verify window opening on either one under it would be exactly the collision the pool exists\\n    // to prevent. Both claims are released in the `finally` below.\\n    console.log('=== (a2) occupying both slots, dead-pid-only, before anything is touched ===');\\n    held1 = occupy('spike', { slot: 1 });\\n    held2 = occupy('spike', { slot: 2 });\\n    console.log(`  slot 1 claim ${held1.claim.file}`);\\n    console.log(`  slot 2 claim ${held2.claim.file}`);\\n    console.log('');\\n\\n    console.log('=== (b) preflight: both slots answer on their own port block, through the helper ===');\\n    const statuses = new Map<number, StackStatus>();\\n    for (const slot of [1, 2]) {\\n      let read = proveSlotTarget(slot, `preflight of slot ${slot}`);\\n      if (!read.status) {\\n        console.log(`  slot ${slot} reported no running stack (${read.notRunning}); starting it — slots are pool property`);\\n        startSlotStack(slot);\\n        read = proveSlotTarget(slot, `preflight of slot ${slot}`);\\n      }\\n      if (!read.status) throw new Error(`slot ${slot} still reports no running stack: ${read.notRunning}`);\\n      statuses.set(slot, read.status);\\n      console.log(`  slot ${slot}  API ${read.status.apiUrl}  DB ${redactDbUrl(read.status.dbUrl)}`);\\n    }\\n    const slot1 = statuses.get(1) as StackStatus;\\n    const slot2 = statuses.get(2) as StackStatus;\\n    console.log('');\\n\\n    console.log('=== (c) canary row in slot 1 — the bystander that must SURVIVE ===');\\n    await writeCanary(1, slot1, 'slot-1 canary');\\n    console.log(`  slot 1 canary written: ${JSON.stringify(await readCanary(1, slot1))}`);\\n    console.log('');\\n\\n    console.log('=== (d) canary row in slot 2 — the row the reset must DESTROY ===');\\n    await writeCanary(2, slot2, 'slot-2 canary');\\n    console.log(`  slot 2 canary written: ${JSON.stringify(await readCanary(2, slot2))}`);\\n    console.log('');\\n\\n    console.log('=== (e) the pre-destructive identity read on slot 2 ===');\\n    const read = proveSlotTarget(2, 'reset', REPO_ROOT, true);\\n    if (!read.status) throw new Error(`slot 2 reported no running stack: ${read.notRunning}`);\\n    preReadShown = true;\\n    console.log('  the line above is the helper stating which project the CLI resolved, before anything destructive.');\\n    console.log('');\\n\\n    console.log('=== (f) supabase db reset, aimed at slot 2, through the helper, hostile variable present ===');\\n    await resetSlotDatabase(2);\\n    resetDone = true;\\n    console.log('  the reset exited zero.');\\n    console.log('');\\n\\n    console.log('=== (g) the canaries after the reset ===');\\n    slot1Canary = await readCanary(1, slot1);\\n    slot2Canary = await readCanary(2, slot2);\\n    console.log(`  slot 1 canary: ${JSON.stringify(slot1Canary)}`);\\n    console.log(`  slot 2 canary: ${JSON.stringify(slot2Canary)}`);\\n    console.log('');\\n  } catch (err) {\\n    failure = diagnostic((err as Error).message, 2000);\\n    console.log('');\\n    console.log(`STOPPED: ${failure}`);\\n    console.log('');\\n  } finally {\\n    release(held2);\\n    release(held1);\\n    console.log('=== both slot claims released ===');\\n    console.log('');\\n  }\\n\\n  console.log('=== (h) AFTER: the same docker identity snapshot, compared on identity fields only ===');\\n  const after = personalDockerSnapshot(personal);\\n  for (const line of after.containers) console.log(`  ${line}`);\\n  for (const line of after.volumes) console.log(`  ${line}`);\\n  const differences = snapshotDifferences(before, after);\\n  if (differences.length === 0) console.log('  IDENTICAL: same container ids, created timestamps, images, port bindings, volumes and volume CreatedAt.');\\n  else for (const line of differences) console.log(`  DIFFERENT: ${line}`);\\n  console.log('');\\n\\n  const criteria: [string, boolean][] = [\\n    ['the hostile variable was present in the parent process', hostile === personal],\\n    // Ruling F2: without this, a slot 2 canary READ that throws after a good reset is swallowed by\\n    // the catch, and every remaining criterion passes with the canary never read at all.\\n    ['the spike body completed without an exception', failure === null],\\n    ['the identity pre-read named slot 2 before the reset', preReadShown],\\n    ['the reset ran through the helper and exited zero', resetDone],\\n    ['the slot 2 canary is GONE — the reset acted on slot 2', resetDone && slot2Canary === null],\\n    ['the slot 1 canary SURVIVES — the reset acted on nothing else', slot1Canary === 'slot-1 canary'],\\n    // Ruling T12: two empty docker queries compare EQUAL, so the central instrument would report\\n    // IDENTICAL while having observed nothing at all.\\n    [\\n      'the BEFORE snapshot recorded at least one personal container and one personal volume',\\n      before.containers.length > 0 && before.volumes.length > 0,\\n    ],\\n    ['the personal docker snapshots are equal on every identity field', differences.length === 0],\\n  ];\\n  console.log('=== the done-criterion, item by item ===');\\n  for (const [what, met] of criteria) console.log(`  ${met ? 'PASS' : 'FAIL'}  ${what}`);\\n  const passed = criteria.every(([, met]) => met);\\n  console.log('');\\n  console.log(passed ? 'THE SPIKE PASSED: the wall holds under the exact condition that broke it.' : 'THE SPIKE FAILED. The wall is NOT proven.');\\n  console.log('');\\n  console.log('Residue: slot 1 keeps a public.spike_canary table until its next occupancy, which resets it.');\\n  console.log('END OF S3 TRANSCRIPT (re-proof)');\\n  return passed ? 0 : 1;\\n}\\n\\nfunction usage(): void {\\n  console.error('usage: bun tests/at/harness/db-pool.ts <setup|status|spike>');\\n}\\n\\nasync function main(argv: string[]): Promise<number> {\\n  const command = argv[0] ?? '';\\n  if (command === 'setup') return setup();\\n  if (command === 'spike') return spike();\\n  if (command === 'status') {\\n    for (const view of readPool()) {\\n      console.log(\\n        `slot ${view.slot}: ${view.configured ? `${view.projectId}, api ${view.apiPort}` : 'NOT CONFIGURED'}` +\\n          `, reservation ${view.reservation ? `${view.reservation.item} (${view.reservation.at})` : 'none'}` +\\n          `, occupancy ${view.occupiedBy ? `pid ${view.occupiedBy.pid} for ${view.occupiedBy.requirement}` : 'none'}`,\\n      );\\n    }\\n    return 0;\\n  }\\n  usage();\\n  return 2;\\n}\\n\\nif (import.meta.main) {\\n  try {\\n    process.exit(await main(process.argv.slice(2)));\\n  } catch (err) {\\n    console.error(`db-pool — ${(err as Error).message}`);\\n    process.exit(3);\\n  }\\n}\",\"lineStart\":1099,\"lineEnd\":1523,\"totalLines\":1523,\"truncated\":false}},\"title\":\"tests\\\\at\\\\harness\\\\db-pool.ts\",\"time\":{\"start\":1786349854079,\"end\":1786349854096}},\"id\":\"prt_feabf9c52001FJd40WHtsVf7Ne\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"messageID\":\"msg_feabf923c001H1e2Z4vWGLd52O\"}}\r\n+{\"type\":\"step_finish\",\"timestamp\":1786349854591,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feabf9f73001cFoG9kgks5MTmJ\",\"reason\":\"tool-calls\",\"snapshot\":\"14300a84ba352d3c5bf13238e30244f5f404984e\",\"messageID\":\"msg_feabf923c001H1e2Z4vWGLd52O\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"type\":\"step-finish\",\"tokens\":{\"total\":49529,\"input\":15748,\"output\":103,\"reasoning\":14,\"cache\":{\"write\":0,\"read\":33664}},\"cost\":0.0011658696}}\r\n+{\"type\":\"step_start\",\"timestamp\":1786349856525,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feabfa70b0010v9ZPjF0NvCYpz\",\"messageID\":\"msg_feabfa15c001HaL0Lu1Rq80kHK\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"snapshot\":\"9967df925a36559b9acad45a45dc57b62ffd8b55\",\"type\":\"step-start\"}}\r\n+{\"type\":\"tool_use\",\"timestamp\":1786349870399,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"type\":\"tool\",\"tool\":\"read\",\"callID\":\"call_00_g0tw813zme7PCLdC09T26461\",\"state\":{\"status\":\"completed\",\"input\":{\"filePath\":\"C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\runner.ts\"},\"output\":\"<path>C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\runner.ts</path>\\n<type>file</type>\\n<content>\\n1: /**\\n2:  * The AT runner — `bun run at:verify req-0NN --tier <loop|integration|drill>`.\\n3:  *\\n4:  * The command shape is fixed: all 30 decomposition manifests cite it verbatim in their done\\n5:  * contracts, and the skills (`/dev-start`'s inner loop, `/dev-end`, `/pm-done`'s gate) call it.\\n6:  * It resolves the requirement's suite, runs it under vitest with the tier passed through\\n7:  * `AT_TIER`, and reports PER AT ID — green / red / missing — because \\\"3 failed\\\" tells a gate\\n8:  * nothing about which acceptance criterion is unmet.\\n9:  *\\n10:  * The `integration` tier needs a real database, and that database is a SLOT out of the local\\n11:  * database pool (`db-pool.ts`) — never a shared hosted project, because every run wipes and\\n12:  * rebuilds it, and never the stack described by this repository's own `supabase/config.toml`,\\n13:  * because that one is the founder's personal stack and is untouchable. The sequence is\\n14:  * deliberately paranoid:\\n15:  *\\n16:  *   1. occupy the slot the coordinator reserved for this item — a machine-wide claim keyed by the\\n17:  *      slot's project id + api port, so two runs cannot reset under each other;\\n18:  *   2. prepare the slot: mirror this tree's `supabase/` into it, overlay the slot's permanent\\n19:  *      identity, PROVE the stack that answers is that slot — loopback host, the slot's own ports,\\n20:  *      keys issued by the local development issuer — reset it, and prove the migration set\\n21:  *      replayed. Every step of that lives in `db-pool.ts`;\\n22:  *   3. print the evidence line naming the slot, so a green can always name the database it graded;\\n23:  *   4. run the suite with an ALLOWLISTED environment — the child gets the platform minimum plus\\n24:  *      the validated slot coordinates, and nothing else, so a secret sitting in a developer's\\n25:  *      `.env.local` can never reach a test (and a test can never reach the hosted project).\\n26:  *\\n27:  * The `drill` tier resolves no database at all until an item decides which stack it should use.\\n28:  *\\n29:  * Any failure in that sequence is an INFRASTRUCTURE failure: non-zero exit, no tests run, a\\n30:  * message naming what failed. The runner never falls back to the loop tier's stubs and never\\n31:  * runs against a database whose state it could not establish — a gate grading a stand-in, or an\\n32:  * unknown database, is worse than a gate that refuses to run. Secrets are never printed: raw CLI\\n33:  * output is redacted, and validation reports which check failed, never the value that failed it.\\n34:  */\\n35: \\n36: import { spawn, spawnSync } from 'node:child_process';\\n37: import { closeSync, existsSync, mkdirSync, mkdtempSync, openSync, readdirSync, readFileSync, rmSync, writeSync } from 'node:fs';\\n38: import { hostname, tmpdir } from 'node:os';\\n39: import { join } from 'node:path';\\n40: \\n41: import { INSTALL_ROOT, inspectBijection, normalizeRequirement, REPO_ROOT, suiteDir } from './check.ts';\\n42: // The cycle with db-pool.ts is deliberate and safe: neither module calls the other at module\\n43: // scope, and both sides export hoisted function declarations.\\n44: import { evidence, occupy, prepare, stackEnv as slotStackEnv, type Occupancy, type PrepareResult } from './db-pool.ts';\\n45: import {\\n46:   expectationDeviations,\\n47:   expectedManifestPath,\\n48:   loadTierExpectation,\\n49:   reportAccountingDeviations,\\n50:   type TierExpectation,\\n51: } from './expected.ts';\\n52: \\n53: const TIERS = ['loop', 'integration', 'drill'] as const;\\n54: type Tier = (typeof TIERS)[number];\\n55: \\n56: const USAGE = 'usage: bun run at:verify req-0NN --tier <loop|integration|drill> [--wired] [--expect]';\\n57: \\n58: /** How long the stack gets to become genuinely ready before the run is called off. */\\n59: const READY_TIMEOUT_MS = Number(process.env.AT_READY_TIMEOUT_MS ?? 120_000);\\n60: /** How long `supabase db reset` gets before it is assumed wedged and its process tree killed. */\\n61: const RESET_TIMEOUT_MS = Number(process.env.AT_RESET_TIMEOUT_MS ?? 600_000);\\n62: /** A lock older than this, or held by a process that is gone, is taken over. */\\n63: const LOCK_STALE_MINUTES = Number(process.env.AT_LOCK_STALE_MINUTES ?? 60);\\n64: /** The takeover gate is held for milliseconds; anything this old was abandoned by a dead process. */\\n65: const GATE_STALE_MINUTES = Number(process.env.AT_LOCK_GATE_STALE_MINUTES ?? 2);\\n66: \\n67: /** `supabase status` reports these two as stopped because config.toml disables them. Benign. */\\n68: const DISABLED_SERVICES = /^supabase_(imgproxy|pooler)_/;\\n69: \\n70: /**\\n71:  * The pinned CLI, invoked directly — no shell, no PATH lookup, no globally installed version.\\n72:  * Resolved from the INSTALL root, never the (overridable) data root: the pinned versions live in\\n73:  * the real checkout's `node_modules` wherever the acceptance files being read happen to be.\\n74:  */\\n75: const SUPABASE_ENTRY = join(INSTALL_ROOT, 'node_modules', 'supabase', 'dist', 'supabase.js');\\n76: \\n77: interface Args {\\n78:   requirement: string;\\n79:   tier: Tier;\\n80:   wired: boolean;\\n81:   /** Named `expectDeclared`, not `expect`, so nobody later reads it as vitest's `expect`. */\\n82:   expectDeclared: boolean;\\n83: }\\n84: \\n85: function parseArgs(argv: string[]): Args {\\n86:   let requirement = '';\\n87:   let tier = '';\\n88:   let wired = false;\\n89:   let expectDeclared = false;\\n90: \\n91:   for (let i = 0; i < argv.length; i++) {\\n92:     const arg = argv[i];\\n93:     if (arg === '--wired') wired = true;\\n94:     else if (arg === '--expect') expectDeclared = true;\\n95:     else if (arg === '--tier') tier = argv[++i] ?? '';\\n96:     else if (arg.startsWith('--tier=')) tier = arg.slice('--tier='.length);\\n97:     else if (arg.startsWith('--')) throw new Error(`unknown option \\\"${arg}\\\"`);\\n98:     else if (!requirement) requirement = arg;\\n99:     else throw new Error(`unexpected argument \\\"${arg}\\\"`);\\n100:   }\\n101: \\n102:   if (!requirement) throw new Error('no requirement given');\\n103:   if (!tier) throw new Error('--tier is required — there is no default tier, by design');\\n104:   if (!TIERS.includes(tier as Tier)) throw new Error(`unknown tier \\\"${tier}\\\" — expected one of ${TIERS.join('|')}`);\\n105:   // Refused here rather than later: `--wired` runs no tests at all, so there would be no report\\n106:   // for a declaration to be checked against, and a declaration refusal must never be reported as\\n107:   // the wired refusal. A usage error exits 2, which is what a `--expect` command that cannot be\\n108:   // honoured is required to do.\\n109:   if (wired && expectDeclared) {\\n110:     throw new Error('--expect and --wired cannot be combined: --wired runs no tests, so there is no report for a declaration to be checked against');\\n111:   }\\n112: \\n113:   return { requirement: normalizeRequirement(requirement), tier: tier as Tier, wired, expectDeclared };\\n114: }\\n115: \\n116: /* --------------------------------------------------------------- the child environment (leak) */\\n117: \\n118: /**\\n119:  * The ONLY variables a child process inherits. Everything else is dropped.\\n120:  *\\n121:  * WHY AN ALLOWLIST: bun auto-loads `.env` and `.env.local` into this process, and `.env.example`\\n122:  * tells developers to put their real secrets in `.env.local`. Spreading `process.env` into the\\n123:  * test process would hand every one of those to every test — and a test reading a conventional\\n124:  * name like `SUPABASE_SERVICE_ROLE_KEY` would then be pointed at the HOSTED project, which the\\n125:  * acceptance suites must never touch. The child gets the platform minimum plus exactly the\\n126:  * values this runner validated. Children are additionally launched with bun's `--no-env-file`,\\n127:  * so a child does not re-read the env files for itself.\\n128:  */\\n129: const ENV_ALLOWLIST = [\\n130:   // process/platform basics\\n131:   'PATH',\\n132:   'PATHEXT',\\n133:   'COMSPEC',\\n134:   'SystemRoot',\\n135:   'SystemDrive',\\n136:   'windir',\\n137:   'OS',\\n138:   'NUMBER_OF_PROCESSORS',\\n139:   'PROCESSOR_ARCHITECTURE',\\n140:   'PROCESSOR_IDENTIFIER',\\n141:   'USERNAME',\\n142:   'LANG',\\n143:   'LC_ALL',\\n144:   'TZ',\\n145:   // temp + home, which bun, vitest and the Supabase CLI all need in order to write caches\\n146:   'TEMP',\\n147:   'TMP',\\n148:   'TMPDIR',\\n149:   'HOME',\\n150:   'HOMEDRIVE',\\n151:   'HOMEPATH',\\n152:   'USERPROFILE',\\n153:   'APPDATA',\\n154:   'LOCALAPPDATA',\\n155:   'PROGRAMDATA',\\n156:   'PROGRAMFILES',\\n157:   'PROGRAMFILES(X86)',\\n158:   'PROGRAMW6432',\\n159:   'XDG_CACHE_HOME',\\n160:   'BUN_INSTALL',\\n161:   // how the Supabase CLI finds the container runtime (never a credential)\\n162:   'DOCKER_HOST',\\n163:   'DOCKER_CONTEXT',\\n164:   'DOCKER_CONFIG',\\n165:   'DOCKER_CERT_PATH',\\n166: ];\\n167: \\n168: /** Windows environment names are case-insensitive, so match that way and keep the parent's casing. */\\n169: export function childEnv(extra: Record<string, string> = {}): Record<string, string> {\\n170:   const wanted = new Set(ENV_ALLOWLIST.map((name) => name.toLowerCase()));\\n171:   const env: Record<string, string> = {};\\n172:   for (const [key, value] of Object.entries(process.env)) {\\n173:     if (value !== undefined && wanted.has(key.toLowerCase())) env[key] = value;\\n174:   }\\n175:   return { ...env, ...extra };\\n176: }\\n177: \\n178: /**\\n179:  * The bun binary. Children are launched under bun deliberately — `--no-env-file` is a bun flag,\\n180:  * and it is what stops a child from re-reading `.env`/`.env.local` for itself. Normally this\\n181:  * process IS bun, so its own path is the answer; the PATH lookup only matters when something\\n182:  * else (a test runner's node worker, say) is asking.\\n183:  */\\n184: export function bunExecutable(): string {\\n185:   if (/[\\\\\\\\/]bun(\\\\.exe)?$/i.test(process.execPath)) return process.execPath;\\n186:   const lookup = spawnSync(process.platform === 'win32' ? 'where' : 'which', ['bun'], {\\n187:     encoding: 'utf8',\\n188:     env: childEnv(),\\n189:   });\\n190:   const found = (lookup.stdout ?? '')\\n191:     .split('\\\\n')\\n192:     .map((line) => line.trim())\\n193:     .find(Boolean);\\n194:   if (!found) throw new Error('bun was not found on PATH — the harness runs its children under bun');\\n195:   return found;\\n196: }\\n197: \\n198: /* --------------------------------------------------------------------------------- redaction */\\n199: \\n200: /** Strip anything key-shaped out of text that is about to be printed. */\\n201: export function redact(text: string): string {\\n202:   return String(text ?? '')\\n203:     .replace(/eyJ[A-Za-z0-9_-]{5,}\\\\.[A-Za-z0-9_-]{5,}\\\\.[A-Za-z0-9_-]{5,}/g, '<redacted-jwt>')\\n204:     .replace(/\\\\bsb_[a-z]+_[A-Za-z0-9_-]{8,}/g, '<redacted-key>')\\n205:     .replace(/(postgres(?:ql)?:\\\\/\\\\/)[^@\\\\s/]+@/gi, '$1<redacted>@')\\n206:     .replace(/[A-Za-z0-9_-]{40,}/g, '<redacted-token>');\\n207: }\\n208: \\n209: /** First non-empty line, redacted and length-capped — enough to diagnose, not enough to leak. */\\n210: export function diagnostic(text: string | undefined, limit = 400): string {\\n211:   const line =\\n212:     redact(text ?? '')\\n213:       .split('\\\\n')\\n214:       .map((l) => l.trim())\\n215:       .find((l) => l.length > 0) ?? '';\\n216:   return line.length > limit ? `${line.slice(0, limit)}…` : line;\\n217: }\\n218: \\n219: /* ------------------------------------------------------------------------ config.toml reading */\\n220: \\n221: export interface LocalConfig {\\n222:   projectId: string;\\n223:   apiPort: number;\\n224:   dbPort: number;\\n225: }\\n226: \\n227: /**\\n228:  * Ports and project id come from `supabase/config.toml` — never guessed, never hard-coded.\\n229:  *\\n230:  * The root is a parameter so the database-slot pool can read a SLOT's own config with this exact\\n231:  * scanner instead of a second copy of it. Unset — every ordinary run — it reads the repo tree, so\\n232:  * the loop and integration call sites behave as they did before the parameter existed.\\n233:  */\\n234: export function readLocalConfig(root: string = REPO_ROOT): LocalConfig {\\n235:   const file = join(root, 'supabase', 'config.toml');\\n236:   const text = readFileSync(file, 'utf8');\\n237:   let section = '';\\n238:   let projectId = '';\\n239:   let apiPort = 0;\\n240:   let dbPort = 0;\\n241: \\n242:   for (const raw of text.split('\\\\n')) {\\n243:     const line = raw.trim();\\n244:     const header = /^\\\\[([^\\\\]]+)\\\\]/.exec(line);\\n245:     if (header) {\\n246:       section = header[1];\\n247:       continue;\\n248:     }\\n249:     const port = /^port\\\\s*=\\\\s*(\\\\d+)/.exec(line);\\n250:     if (section === '' && /^project_id\\\\s*=/.test(line)) projectId = /\\\"([^\\\"]+)\\\"/.exec(line)?.[1] ?? '';\\n251:     else if (section === 'api' && port && !apiPort) apiPort = Number(port[1]);\\n252:     else if (section === 'db' && port && !dbPort) dbPort = Number(port[1]);\\n253:   }\\n254: \\n255:   const missing = [projectId ? '' : 'project_id', apiPort ? '' : '[api] port', dbPort ? '' : '[db] port'].filter(Boolean);\\n256:   if (missing.length) throw new Error(`${file} is missing ${missing.join(' and ')}`);\\n257:   return { projectId, apiPort, dbPort };\\n258: }\\n259: \\n260: /* ---------------------------------------------------------------------- the machine-wide lock */\\n261: \\n262: export interface StackLock {\\n263:   file: string;\\n264:   release(): void;\\n265: }\\n266: \\n267: /**\\n268:  * Where the machine-wide claim files live.\\n269:  *\\n270:  * `AT_LOCK_DIR` overrides it, the same pattern and the same reason as `AT_REPO_ROOT`: a test that\\n271:  * exercises the claim protocol must not write into the directory a real run reads, or a selftest\\n272:  * and a live `at:verify` could take each other's lock. Unset — every ordinary run — the answer is\\n273:  * unchanged.\\n274:  */\\n275: function lockDir(): string {\\n276:   const override = process.env.AT_LOCK_DIR?.trim();\\n277:   const dir = override ? override : join(process.env.LOCALAPPDATA ?? process.env.XDG_CACHE_HOME ?? tmpdir(), 'ai4good-build', 'at-locks');\\n278:   mkdirSync(dir, { recursive: true });\\n279:   return dir;\\n280: }\\n281: \\n282: function processIsAlive(pid: number): boolean {\\n283:   try {\\n284:     process.kill(pid, 0);\\n285:     return true;\\n286:   } catch (err) {\\n287:     // EPERM means it exists but belongs to someone else; ESRCH means it is gone.\\n288:     return (err as NodeJS.ErrnoException).code === 'EPERM';\\n289:   }\\n290: }\\n291: \\n292: /** The lock path for one stack. Machine-wide, and deliberately carries no folder component. */\\n293: export function stackLockPath(config: LocalConfig): string {\\n294:   return join(lockDir(), `at-verify-${config.projectId}-${config.apiPort}.lock`);\\n295: }\\n296: \\n297: export interface Holder {\\n298:   pid?: number;\\n299:   host?: string;\\n300:   requirement?: string;\\n301:   startedAt?: string;\\n302:   /** Set only on a claim that replaced a stale one, so the takeover is recorded IN the claim. */\\n303:   tookOverFrom?: { pid?: number; startedAt?: string; requirement?: string };\\n304: }\\n305: \\n306: /**\\n307:  * Which holders a caller is allowed to displace.\\n308:  *\\n309:  * `stale-or-dead` is the runner's own long-standing rule: a dead process, or a live one whose\\n310:  * claim is older than `LOCK_STALE_MINUTES`. `dead-pid-only` never displaces a running process at\\n311:  * any age — the database-slot pool passes it, because a slot's occupancy is ruled to break on a\\n312:  * dead holder pid and on nothing else. A run that legitimately lasts longer than the stale window\\n313:  * must not have its database reset under it.\\n314:  */\\n315: export type TakeoverPolicy = 'stale-or-dead' | 'dead-pid-only';\\n316: \\n317: export interface StackLockOptions {\\n318:   takeover?: TakeoverPolicy;\\n319: }\\n320: \\n321: /** Live = a holder this policy may not displace. */\\n322: function holderIsLive(holder: Holder, policy: TakeoverPolicy = 'stale-or-dead'): boolean {\\n323:   if (typeof holder.pid !== 'number' || !processIsAlive(holder.pid)) return false;\\n324:   if (policy === 'dead-pid-only') return true;\\n325:   const startedAt = holder.startedAt ? Date.parse(holder.startedAt) : NaN;\\n326:   const ageMinutes = Number.isFinite(startedAt) ? (Date.now() - startedAt) / 60_000 : Infinity;\\n327:   return ageMinutes < LOCK_STALE_MINUTES;\\n328: }\\n329: \\n330: function heldByAnotherRun(holder: Holder, file: string): Error {\\n331:   return new Error(\\n332:     `another at:verify run holds this stack (pid ${holder.pid} on ${holder.host ?? 'this machine'}, ` +\\n333:       `requirement ${holder.requirement ?? 'unknown'}, started ${holder.startedAt ?? 'unknown'}). ` +\\n334:       `Two runs against one stack destroy each other: the second would reset the first's database ` +\\n335:       `mid-run. Wait for it to finish. If that process is definitely gone, delete ${file}.`,\\n336:   );\\n337: }\\n338: \\n339: /**\\n340:  * A gate left behind by a process that died mid-takeover. The section lasts milliseconds, so\\n341:  * anything this old is certainly abandoned; removing one wrongly costs at most two processes in\\n342:  * the section, which is the behaviour we had before the gate existed.\\n343:  */\\n344: function clearStrandedGate(gate: string): void {\\n345:   try {\\n346:     const held = JSON.parse(readFileSync(gate, 'utf8')) as { pid?: number; at?: string };\\n347:     const at = held.at ? Date.parse(held.at) : NaN;\\n348:     const ageMinutes = Number.isFinite(at) ? (Date.now() - at) / 60_000 : Infinity;\\n349:     const alive = typeof held.pid === 'number' && processIsAlive(held.pid);\\n350:     if (!alive || ageMinutes > GATE_STALE_MINUTES) rmSync(gate, { force: true });\\n351:   } catch {\\n352:     // unreadable or already gone — the next pass finds out\\n353:   }\\n354: }\\n355: \\n356: /**\\n357:  * Serialize every destructive run against one stack. The key is project id + api port because\\n358:  * that pair IS the stack's identity: a second checkout carrying the same `project_id` shares the\\n359:  * same Docker containers and the same ports, so its `at:verify` would reset this run's database\\n360:  * out from under it. Mirrors `Acquire-WorkLock` in loop/work/work-lib.ps1 — exclusive create,\\n361:  * holder recorded, stale takeover.\\n362:  *\\n363:  * TAKEOVER IS THE WHOLE DIFFICULTY. Two processes can both read the same leftover lock and both\\n364:  * conclude it is stale; if each then removed it and created its own, the second removal would take\\n365:  * out the FIRST one's brand-new live lock and both would run — the precise failure this exists to\\n366:  * prevent. Moving the stale file aside with an atomic rename does NOT fix that: the winner\\n367:  * repopulates the path microseconds later, so the loser's rename succeeds against a LIVE lock,\\n368:  * which is just as destructive as unlinking it. (Proved with a two-contender race, not reasoned\\n369:  * about; the race is in runner.selftest.ts.)\\n370:  *\\n371:  * So the takeover DECISION is serialized by a second exclusive-create lock — the gate. Only one\\n372:  * process is ever inside it, and it re-reads the holder INSIDE, so:\\n373:  *   - no other process can be taking over concurrently (the gate is exclusive);\\n374:  *   - no ordinary claim can have slipped in, because the stale file occupies the path continuously\\n375:  *     until the gate holder removes it, and an exclusive create only succeeds on a free path;\\n376:  *   - if a third process wins the claim in the instant after removal, the gate holder's own create\\n377:  *     simply fails and it restarts, having deleted nothing further.\\n378:  * A gate stranded by a killed process is cleared on age. The section lasts milliseconds, so a live\\n379:  * holder never reaches that threshold, and clearing one wrongly degrades to two takers in the\\n380:  * section — today's behaviour, not worse.\\n381:  */\\n382: export function acquireStackLock(config: LocalConfig, requirement: string, options: StackLockOptions = {}): StackLock {\\n383:   const file = stackLockPath(config);\\n384:   const policy: TakeoverPolicy = options.takeover ?? 'stale-or-dead';\\n385: \\n386:   const claim = (displaced?: Holder): StackLock | null => {\\n387:     let fd: number;\\n388:     try {\\n389:       fd = openSync(file, 'wx');\\n390:     } catch (err) {\\n391:       if ((err as NodeJS.ErrnoException).code === 'EEXIST') return null;\\n392:       throw err;\\n393:     }\\n394:     try {\\n395:       writeSync(\\n396:         fd,\\n397:         JSON.stringify({\\n398:           pid: process.pid,\\n399:           host: hostname(),\\n400:           requirement,\\n401:           startedAt: new Date().toISOString(),\\n402:           // A takeover recorded ONLY on the console is lost the moment the terminal scrolls. The\\n403:           // claim file outlives the run that wrote it, so whoever reads it later can see that this\\n404:           // occupancy began by displacing an abandoned one, and whose.\\n405:           ...(displaced\\n406:             ? {\\n407:                 tookOverFrom: {\\n408:                   pid: displaced.pid,\\n409:                   startedAt: displaced.startedAt,\\n410:                   requirement: displaced.requirement,\\n411:                 },\\n412:               }\\n413:             : {}),\\n414:         }),\\n415:       );\\n416:     } finally {\\n417:       closeSync(fd);\\n418:     }\\n419:     return {\\n420:       file,\\n421:       release: () => {\\n422:         try {\\n423:           const held = JSON.parse(readFileSync(file, 'utf8')) as { pid?: number };\\n424:           if (held.pid === process.pid) rmSync(file, { force: true });\\n425:         } catch {\\n426:           // already removed, or unreadable — nothing of ours left to release\\n427:         }\\n428:       },\\n429:     };\\n430:   };\\n431: \\n432:   const gate = `${file}.takeover`;\\n433: \\n434:   /** The recorded holder, or null if the lock is gone. */\\n435:   const readHolder = (): Holder | null => {\\n436:     try {\\n437:       return JSON.parse(readFileSync(file, 'utf8')) as Holder;\\n438:     } catch (err) {\\n439:       if ((err as NodeJS.ErrnoException).code === 'ENOENT') return null;\\n440:       return {}; // unreadable or half-written: treat as an unidentifiable holder, judged below\\n441:     }\\n442:   };\\n443: \\n444:   /** Bounded synchronous pause; a gate is held for milliseconds, so this is all the wait needed. */\\n445:   const pause = (ms: number) => {\\n446:     const until = Date.now() + ms;\\n447:     while (Date.now() < until) {\\n448:       /* spin */\\n449:     }\\n450:   };\\n451: \\n452:   /**\\n453:    * UNDER `dead-pid-only`, AN UNIDENTIFIABLE HOLDER IS NEVER TAKEOVER-ELIGIBLE.\\n454:    *\\n455:    * `readHolder` returns `{}` for a file it cannot read or parse, and `holderIsLive({})` is false\\n456:    * under every policy — so without this guard a claim file that is empty or half written looks\\n457:    * exactly like a dead holder and is deleted. The window is real and small: it is the microseconds\\n458:    * between `openSync(file, 'wx')` and the `writeSync` that fills the file, so a second occupier\\n459:    * arriving in that instant would remove a LIVE process's brand-new claim. That is the one thing\\n460:    * this policy exists to make impossible.\\n461:    *\\n462:    * One bounded re-read skates over the write window. A holder that STILL has no parseable pid is\\n463:    * not a dead holder — it is a file nobody in this process can account for — so it refuses loudly\\n464:    * and names the manual repair. `stale-or-dead` keeps its long-standing behaviour: that path\\n465:    * predates the slot pool and is another item's business.\\n466:    *\\n467:    * Returns the identified holder, or null when the file went away and the loop should retry.\\n468:    */\\n469:   const identified = (holder: Holder, where: string): Holder | null => {\\n470:     if (typeof holder.pid === 'number') return holder;\\n471:     if (policy !== 'dead-pid-only') return holder;\\n472: \\n473:     pause(50);\\n474:     const again = readHolder();\\n475:     if (again === null) return null; // released while we looked; the loop takes the free path\\n476:     if (typeof again.pid === 'number') return again;\\n477: \\n478:     throw new Error(\\n479:       `refusing to take over the claim at ${file}: it names no process id that this run can read, ` +\\n480:         `so it cannot be shown to be dead — and a claim file being written right now looks exactly ` +\\n481:         `like this. Nothing was taken over. If no run holds that stack, delete ${file} by hand ` +\\n482:         `(checked ${where}).`,\\n483:     );\\n484:   };\\n485: \\n486:   // Bounded: every retry follows another process winning the gate, which cannot repeat forever.\\n487:   for (let attempt = 0; attempt < 20; attempt++) {\\n488:     const claimed = claim();\\n489:     if (claimed) return claimed;\\n490: \\n491:     const read = readHolder();\\n492:     if (read === null) continue; // released between the failed claim and the read\\n493:     const holder = identified(read, 'before the takeover gate');\\n494:     if (holder === null) continue;\\n495:     if (holderIsLive(holder, policy)) throw heldByAnotherRun(holder, file);\\n496: \\n497:     // Stale. Enter the takeover gate — the only place the live lock path may be removed.\\n498:     let gateFd: number;\\n499:     try {\\n500:       gateFd = openSync(gate, 'wx');\\n501:     } catch (err) {\\n502:       if ((err as NodeJS.ErrnoException).code !== 'EEXIST') throw err;\\n503:       clearStrandedGate(gate);\\n504:       pause(10);\\n505:       continue;\\n506:     }\\n507: \\n508:     try {\\n509:       writeSync(gateFd, JSON.stringify({ pid: process.pid, at: new Date().toISOString() }));\\n510:       const readInside = readHolder();\\n511:       if (readInside === null) continue; // released while we were entering; the next claim takes it\\n512:       // The same guard as above: the gate must not be able to remove an unidentifiable file either.\\n513:       const inside = identified(readInside, 'inside the takeover gate');\\n514:       if (inside === null) continue;\\n515:       if (holderIsLive(inside, policy)) continue; // refreshed under us; the next pass refuses it properly\\n516: \\n517:       rmSync(file, { force: true });\\n518:       const takeover = claim(inside);\\n519:       if (!takeover) continue; // a third process claimed the free path first — delete nothing more\\n520: \\n521:       console.log(\\n522:         `at:verify — took over a stale stack lock (holder pid ${inside.pid ?? 'unknown'} ` +\\n523:           `${typeof inside.pid === 'number' && processIsAlive(inside.pid) ? `is older than ${LOCK_STALE_MINUTES} minutes` : 'is no longer running'})`,\\n524:       );\\n525:       return takeover;\\n526:     } finally {\\n527:       closeSync(gateFd);\\n528:       rmSync(gate, { force: true });\\n529:     }\\n530:   }\\n531: \\n532:   throw new Error(`could not acquire the stack lock at ${file} — it kept changing hands; try again`);\\n533: }\\n534: \\n535: /* -------------------------------------------------------------------- the stack's own report */\\n536: \\n537: export interface StackStatus {\\n538:   apiUrl: string;\\n539:   dbUrl: string;\\n540:   anonKey: string;\\n541:   serviceRoleKey: string;\\n542: }\\n543: \\n544: const REQUIRED_STATUS_FIELDS: Record<keyof StackStatus, string> = {\\n545:   apiUrl: 'API_URL',\\n546:   dbUrl: 'DB_URL',\\n547:   anonKey: 'ANON_KEY',\\n548:   serviceRoleKey: 'SERVICE_ROLE_KEY',\\n549: };\\n550: \\n551: export function supabaseArgs(...args: string[]): string[] {\\n552:   if (!existsSync(SUPABASE_ENTRY)) throw new Error(`the Supabase CLI is not installed at ${SUPABASE_ENTRY} — run \\\\`bun install\\\\``);\\n553:   return ['--no-env-file', SUPABASE_ENTRY, ...args];\\n554: }\\n555: \\n556: /**\\n557:  * WHICH PROJECT an invocation acts on. A target names both halves of an identity, because either\\n558:  * half alone is a hybrid.\\n559:  */\\n560: export interface CliTarget {\\n561:   /** The directory that CONTAINS the `supabase/` project folder — what `--workdir` names. */\\n562:   workdir: string;\\n563:   /** The project id the invocation must resolve, stated POSITIVELY in `SUPABASE_PROJECT_ID`. */\\n564:   projectId: string;\\n565: }\\n566: \\n567: export interface CliInvocation {\\n568:   args: string[];\\n569:   cwd: string;\\n570:   env: Record<string, string>;\\n571: }\\n572: \\n573: /**\\n574:  * THE ONE SEAM every Supabase CLI invocation is built at. Nothing in this repository assembles a\\n575:  * CLI command line, working directory or environment anywhere else, and that single seam is the\\n576:  * whole wall — a wall with two builders is a wall with a gap.\\n577:  *\\n578:  * THREE THINGS HAVE TO AGREE, and the reason each is here was measured, not reasoned about:\\n579:  *\\n580:  *   1. `SUPABASE_PROJECT_ID`, set POSITIVELY to the target's project id. The CLI treats that\\n581:  *      variable as an OVERRIDE of `project_id` in `config.toml`. The repo's tracked `.env` carries\\n582:  *      it, bun loads `.env` into this process, and on 2026-08-09 a `db reset` aimed at slot 2\\n583:  *      destroyed the founder's personal database because the environment supplied the identity\\n584:  *      while the slot's config supplied the ports. The wall is stating the identity, never merely\\n585:  *      avoiding an override: an absence can be reintroduced by any parent process, a positive\\n586:  *      value cannot.\\n587:  *   2. NO OTHER `SUPABASE_*` variable. `childEnv` is an allowlist that carries none, and this\\n588:  *      function asserts that rather than trusting it, because the allowlist is edited by people.\\n589:  *   3. The WORKING DIRECTORY, equal to `--workdir`. Measured 2026-08-10: when the CLI's working\\n590:  *      directory is itself a Supabase project, `--workdir <other>` produces a hybrid — the other\\n591:  *      project's ports beside the working directory's project's containers. Run from a directory\\n592:  *      that is not a project, the same command correctly says\\n593:  *      `No such container: supabase_db_ai4good-slot-1`.\\n594:  *\\n595:  * `bun --no-env-file` (in `supabaseArgs`) closes the fourth route: a child that re-reads `.env`\\n596:  * for itself.\\n597:  *\\n598:  * No target means the repository's own project, exactly as every call site behaved before targets\\n599:  * existed: no `--workdir`, the repo root, and an environment carrying no `SUPABASE_*` at all.\\n600:  */\\n601: export function supabaseInvocation(target: CliTarget | undefined, args: string[]): CliInvocation {\\n602:   if (!target) return { args: supabaseArgs(...args), cwd: REPO_ROOT, env: childEnv() };\\n603: \\n604:   const env = childEnv({ SUPABASE_PROJECT_ID: target.projectId });\\n605:   const foreign = Object.keys(env).filter((name) => /^SUPABASE_/i.test(name) && name.toUpperCase() !== 'SUPABASE_PROJECT_ID');\\n606:   if (foreign.length) {\\n607:     throw new Error(\\n608:       `refusing to run the Supabase CLI against ${target.projectId}: the child environment would also carry ` +\\n609:         `${foreign.join(', ')}, and a second SUPABASE_* variable can override the identity this invocation states.`,\\n610:     );\\n611:   }\\n612:   if (env.SUPABASE_PROJECT_ID !== target.projectId) {\\n613:     throw new Error(`refusing to run the Supabase CLI: SUPABASE_PROJECT_ID would not be \\\"${target.projectId}\\\"`);\\n614:   }\\n615:   return { args: supabaseArgs('--workdir', target.workdir, ...args), cwd: target.workdir, env };\\n616: }\\n617: \\n618: export interface CliResult {\\n619:   status: number | null;\\n620:   signal?: NodeJS.Signals | null;\\n621:   stdout: string;\\n622:   stderr: string;\\n623:   error?: Error;\\n624: }\\n625: \\n626: /** Run the pinned CLI through the seam and hand back the RAW result. The caller decides what to\\n627:  * read and what may be printed — raw output carries every key the stack issues. */\\n628: export function runSupabaseCli(target: CliTarget | undefined, args: string[]): CliResult {\\n629:   const invocation = supabaseInvocation(target, args);\\n630:   const res = spawnSync(bunExecutable(), invocation.args, { cwd: invocation.cwd, env: invocation.env, encoding: 'utf8' });\\n631:   return {\\n632:     status: res.status,\\n633:     signal: res.signal,\\n634:     stdout: res.stdout ?? '',\\n635:     stderr: res.stderr ?? '',\\n636:     error: res.error as Error | undefined,\\n637:   };\\n638: }\\n639: \\n640: /**\\n641:  * Ask the running stack to describe itself. The raw output is NEVER printed: it contains every\\n642:  * key the stack issues. Only field names travel into error messages.\\n643:  */\\n644: export function readStackStatus(target?: CliTarget): StackStatus {\\n645:   return parseStackStatus(runSupabaseCli(target, ['status', '-o', 'json']));\\n646: }\\n647: \\n648: /**\\n649:  * The status parser, separate from the invocation so that a caller which needs the RAW output for\\n650:  * its own checks (the slot pool's identity read) reads it once and parses the same result, rather\\n651:  * than running the CLI twice or keeping a second copy of this parser.\\n652:  */\\n653: export function parseStackStatus(res: CliResult): StackStatus {\\n654:   if (res.error) {\\n655:     const err = res.error as NodeJS.ErrnoException;\\n656:     throw new Error(`could not launch the Supabase CLI (${err.code ?? 'spawn error'}): ${diagnostic(err.message)}`);\\n657:   }\\n658: \\n659:   const stdout = res.stdout ?? '';\\n660:   const open = stdout.indexOf('{');\\n661:   const close = stdout.lastIndexOf('}');\\n662:   if (open < 0 || close <= open) {\\n663:     throw new Error(\\n664:       `\\\\`supabase status\\\\` reported no JSON (exit ${res.status}${res.signal ? `, signal ${res.signal}` : ''}): ` +\\n665:         `${diagnostic(res.stderr) || '(no error output)'}`,\\n666:     );\\n667:   }\\n668: \\n669:   // The CLI exits non-zero merely because config.toml disables imgproxy and the pooler. That is\\n670:   // not a failure; anything ELSE reported stopped is.\\n671:   const notice = `${stdout.slice(0, open)}\\\\n${res.stderr ?? ''}`;\\n672:   const stopped = /Stopped services:\\\\s*\\\\[([^\\\\]]*)\\\\]/.exec(notice)?.[1] ?? '';\\n673:   const unexpectedStopped = stopped.split(/\\\\s+/).filter((name) => name && !DISABLED_SERVICES.test(name));\\n674:   if (unexpectedStopped.length) {\\n675:     throw new Error(`the stack reports stopped services: ${unexpectedStopped.join(', ')} — start them before running the suite`);\\n676:   }\\n677: \\n678:   let parsed: Record<string, unknown>;\\n679:   try {\\n680:     parsed = JSON.parse(stdout.slice(open, close + 1)) as Record<string, unknown>;\\n681:   } catch (err) {\\n682:     throw new Error(`\\\\`supabase status\\\\` produced unparseable JSON: ${(err as Error).message}`);\\n683:   }\\n684: \\n685:   const status: Partial<StackStatus> = {};\\n686:   const missing: string[] = [];\\n687:   for (const [field, key] of Object.entries(REQUIRED_STATUS_FIELDS) as [keyof StackStatus, string][]) {\\n688:     const value = parsed[key];\\n689:     if (typeof value !== 'string' || value.trim() === '') missing.push(key);\\n690:     else status[field] = value;\\n691:   }\\n692:   if (missing.length) throw new Error(`\\\\`supabase status\\\\` reported no ${missing.join(', no ')}`);\\n693:   return status as StackStatus;\\n694: }\\n695: \\n696: /* --------------------------------------------------------- proving the stack is the LOCAL one */\\n697: \\n698: const LOOPBACK = new Set(['127.0.0.1', 'localhost', '::1', '[::1]']);\\n699: \\n700: function decodeJwtClaims(token: string): Record<string, unknown> | null {\\n701:   const parts = token.split('.');\\n702:   if (parts.length !== 3) return null;\\n703:   try {\\n704:     return JSON.parse(Buffer.from(parts[1], 'base64url').toString('utf8')) as Record<string, unknown>;\\n705:   } catch {\\n706:     return null;\\n707:   }\\n708: }\\n709: \\n710: /**\\n711:  * Refuse to touch anything that is not demonstrably the local development stack. Returns the\\n712:  * names of the checks that failed — never the values, which are keys and connection strings.\\n713:  */\\n714: export function localStackProblems(status: StackStatus, config: LocalConfig): string[] {\\n715:   const problems: string[] = [];\\n716: \\n717:   const checkUrl = (label: string, raw: string, expectedPort: number) => {\\n718:     let url: URL;\\n719:     try {\\n720:       url = new URL(raw);\\n721:     } catch {\\n722:       problems.push(`${label} is not a URL`);\\n723:       return;\\n724:     }\\n725:     if (!LOOPBACK.has(url.hostname)) problems.push(`${label} does not point at the loopback address`);\\n726:     if (url.port !== String(expectedPort)) problems.push(`${label} port is not the ${expectedPort} configured in supabase/config.toml`);\\n727:   };\\n728: \\n729:   checkUrl('API_URL', status.apiUrl, config.apiPort);\\n730:   checkUrl('DB_URL', status.dbUrl, config.dbPort);\\n731: \\n732:   const checkKey = (label: string, token: string, expectedRole: string) => {\\n733:     const claims = decodeJwtClaims(token);\\n734:     if (!claims) {\\n735:       problems.push(`${label} is not a decodable local development JWT`);\\n736:       return;\\n737:     }\\n738:     if (claims.iss !== 'supabase-demo') problems.push(`${label} was not issued by the local development issuer`);\\n739:     if (claims.role !== expectedRole) problems.push(`${label} does not carry the ${expectedRole} role`);\\n740:     if (typeof claims.ref === 'string') problems.push(`${label} carries a hosted project reference`);\\n741:   };\\n742: \\n743:   checkKey('ANON_KEY', status.anonKey, 'anon');\\n744:   checkKey('SERVICE_ROLE_KEY', status.serviceRoleKey, 'service_role');\\n745: \\n746:   return problems;\\n747: }\\n748: \\n749: /* --------------------------------------------------------------------------------- readiness */\\n750: \\n751: interface BunSqlClient {\\n752:   (strings: TemplateStringsArray, ...values: unknown[]): Promise<unknown>;\\n753:   close(): Promise<void>;\\n754: }\\n755: type BunSqlCtor = new (url: string) => BunSqlClient;\\n756: \\n757: /** Postgres itself answers a query — not \\\"the port is open\\\", which a half-started stack satisfies. */\\n758: async function databaseAnswers(dbUrl: string): Promise<string | null> {\\n759:   const SQL = (globalThis as { Bun?: { SQL?: BunSqlCtor } }).Bun?.SQL;\\n760:   if (!SQL) return 'this runtime has no SQL client (expected bun)';\\n761:   let sql: BunSqlClient | null = null;\\n762:   try {\\n763:     sql = new SQL(dbUrl);\\n764:     await sql`select 1`;\\n765:     return null;\\n766:   } catch (err) {\\n767:     return diagnostic((err as Error).message);\\n768:   } finally {\\n769:     await sql?.close().catch(() => undefined);\\n770:   }\\n771: }\\n772: \\n773: /** One request that only succeeds if Kong routed it, PostgREST served it, and Postgres answered. */\\n774: async function gatewayAnswers(status: StackStatus): Promise<string | null> {\\n775:   try {\\n776:     const res = await fetch(`${status.apiUrl.replace(/\\\\/$/, '')}/rest/v1/`, {\\n777:       headers: { apikey: status.anonKey, Authorization: `Bearer ${status.anonKey}` },\\n778:       signal: AbortSignal.timeout(5000),\\n779:     });\\n780:     if (!res.ok) return `the API gateway answered ${res.status}`;\\n781:     const type = res.headers.get('content-type') ?? '';\\n782:     if (!type.includes('json')) return `the API gateway answered 200 but served ${type || 'no content type'}`;\\n783:     return null;\\n784:   } catch (err) {\\n785:     return diagnostic((err as Error).message);\\n786:   }\\n787: }\\n788: \\n789: /**\\n790:  * Wait until the stack is genuinely usable, or give up. \\\"Something answered on the port\\\" is not\\n791:  * readiness: a half-started stack answers 502/503, and a run launched against it fails in ways\\n792:  * that look like test failures instead of infrastructure failures.\\n793:  */\\n794: export async function waitForReady(status: StackStatus, phase: string): Promise<void> {\\n795:   const deadline = Date.now() + READY_TIMEOUT_MS;\\n796:   let lastProblem = 'not attempted';\\n797:   let delay = 250;\\n798: \\n799:   while (Date.now() < deadline) {\\n800:     const db = await databaseAnswers(status.dbUrl);\\n801:     if (db === null) {\\n802:       const gateway = await gatewayAnswers(status);\\n803:       if (gateway === null) return;\\n804:       lastProblem = gateway;\\n805:     } else {\\n806:       lastProblem = `the database did not answer: ${db}`;\\n807:     }\\n808:     await new Promise((resolve) => setTimeout(resolve, delay));\\n809:     delay = Math.min(delay * 2, 2000);\\n810:   }\\n811: \\n812:   throw new Error(`the stack was still not ready ${phase} after ${Math.round(READY_TIMEOUT_MS / 1000)}s — last problem: ${lastProblem}`);\\n813: }\\n814: \\n815: /* --------------------------------------------------------------------- the migration-set proof */\\n816: \\n817: /** Counted, not just proved — the pool's evidence line has to state the migration state it saw. */\\n818: export interface MigrationProof {\\n819:   expected: number;\\n820:   applied: number;\\n821: }\\n822: \\n823: /**\\n824:  * The migrations the reset is supposed to replay, read from disk. The CLI names them\\n825:  * `<timestamp>_name.sql` and records the timestamp as the applied version, so the timestamp is\\n826:  * the identity. `.gitkeep` and `README.md` are not migrations and are ignored.\\n827:  */\\n828: export function expectedMigrations(root: string = REPO_ROOT): string[] {\\n829:   const dir = join(root, 'supabase', 'migrations');\\n830:   if (!existsSync(dir)) return [];\\n831:   return readdirSync(dir)\\n832:     .map((name) => /^(\\\\d{14})_.*\\\\.sql$/.exec(name)?.[1])\\n833:     .filter((version): version is string => Boolean(version))\\n834:     .sort();\\n835: }\\n836: \\n837: /** What the database says it actually replayed. */\\n838: async function appliedMigrations(dbUrl: string): Promise<string[]> {\\n839:   const SQL = (globalThis as { Bun?: { SQL?: BunSqlCtor } }).Bun?.SQL;\\n840:   if (!SQL) throw new Error('this runtime has no SQL client (expected bun)');\\n841:   let sql: BunSqlClient | null = null;\\n842:   try {\\n843:     sql = new SQL(dbUrl);\\n844:     const rows = (await sql`select version from supabase_migrations.schema_migrations order by version`) as {\\n845:       version: string;\\n846:     }[];\\n847:     return rows.map((row) => String(row.version)).sort();\\n848:   } catch (err) {\\n849:     // A database that has never had a migration applied has no history table at all. \\\"No table\\\"\\n850:     // and \\\"empty table\\\" mean the same thing — nothing was applied — and saying so lets the\\n851:     // comparison below name exactly which migrations are missing instead of reporting a SQL error.\\n852:     const message = (err as Error).message ?? '';\\n853:     if (/schema_migrations/.test(message) && /does not exist/i.test(message)) return [];\\n854:     throw new Error(`could not read the migration history: ${diagnostic(message)}`);\\n855:   } finally {\\n856:     await sql?.close().catch(() => undefined);\\n857:   }\\n858: }\\n859: \\n860: /** Exact set equality, both directions, named plainly. */\\n861: export function migrationSetProblems(expected: string[], applied: string[]): string[] {\\n862:   const missing = expected.filter((version) => !applied.includes(version));\\n863:   const extra = applied.filter((version) => !expected.includes(version));\\n864:   const problems: string[] = [];\\n865:   if (missing.length) problems.push(`never applied: ${missing.join(', ')}`);\\n866:   if (extra.length) problems.push(`applied but not in supabase/migrations: ${extra.join(', ')}`);\\n867:   return problems;\\n868: }\\n869: \\n870: /**\\n871:  * Prove the rebuild actually replayed the migration set — the promise `supabase/migrations/README.md`\\n872:  * makes. \\\"The reset command exited zero\\\" is not that proof: a reset that replays NOTHING also exits\\n873:  * zero, and a suite then grades an empty schema while believing it graded the real one.\\n874:  *\\n875:  * An empty expected set is legitimate today (no migrations have been written yet) and is allowed —\\n876:  * but it is STATED on every run, so an empty rebuild can never be silently mistaken for a real one.\\n877:  */\\n878: export async function proveMigrationsReplayed(status: StackStatus, root: string = REPO_ROOT): Promise<MigrationProof> {\\n879:   const expected = expectedMigrations(root);\\n880:   const applied = await appliedMigrations(status.dbUrl);\\n881:   const problems = migrationSetProblems(expected, applied);\\n882: \\n883:   const summary = `${expected.length} migration${expected.length === 1 ? '' : 's'} expected, ${applied.length} applied`;\\n884:   if (problems.length) {\\n885:     throw new Error(`the rebuilt database does not match supabase/migrations (${summary}) — ${problems.join('; ')}`);\\n886:   }\\n887:   console.log(\\n888:     expected.length === 0\\n889:       ? `at:verify — ${summary} — the schema is empty by design at this stage`\\n890:       : `at:verify — ${summary} — the rebuilt schema matches supabase/migrations exactly`,\\n891:   );\\n892:   return { expected: expected.length, applied: applied.length };\\n893: }\\n894: \\n895: /* ------------------------------------------------------------------------------------- reset */\\n896: \\n897: /**\\n898:  * Rebuild the local database from `supabase/migrations` — the same work `bun run db:reset` does,\\n899:  * invoked at the pinned CLI so failures are catchable and bounded.\\n900:  *\\n901:  * WHY EVERY RUN: without it the second run works on the first run's leftover rows, and on a\\n902:  * schema missing whatever migration landed since — a suite grading a database nobody established.\\n903:  */\\n904: export async function resetLocalDatabase(target?: CliTarget): Promise<void> {\\n905:   const invocation = supabaseInvocation(target, ['db', 'reset', '--local']);\\n906:   const child = spawn(bunExecutable(), invocation.args, {\\n907:     cwd: invocation.cwd,\\n908:     env: invocation.env,\\n909:     // progress is worth watching (a reset replays every migration); stderr is captured so a\\n910:     // failure can be reported in our own words rather than scrolling past.\\n911:     stdio: ['ignore', 'inherit', 'pipe'],\\n912:   });\\n913: \\n914:   let stderr = '';\\n915:   child.stderr?.on('data', (chunk: Buffer) => {\\n916:     stderr = (stderr + chunk.toString('utf8')).slice(-8000);\\n917:   });\\n918: \\n919:   let timedOut = false;\\n920:   const timer = setTimeout(() => {\\n921:     timedOut = true;\\n922:     // Kill the TREE: the CLI shells out to the container runtime, and killing only the parent\\n923:     // leaves a migration running against the database this run is about to test.\\n924:     if (child.pid && process.platform === 'win32') spawnSync('taskkill', ['/PID', String(child.pid), '/T', '/F'], { stdio: 'ignore' });\\n925:     else child.kill('SIGKILL');\\n926:   }, RESET_TIMEOUT_MS);\\n927: \\n928:   try {\\n929:     await new Promise<void>((resolve, reject) => {\\n930:       child.once('error', (err) => {\\n931:         const e = err as NodeJS.ErrnoException;\\n932:         reject(new Error(`the reset process could not be launched (${e.code ?? 'spawn error'}): ${diagnostic(e.message)}`));\\n933:       });\\n934:       child.once('close', (code, signal) => {\\n935:         if (timedOut) {\\n936:           reject(new Error(`the reset did not finish within ${Math.round(RESET_TIMEOUT_MS / 1000)}s and its process tree was killed`));\\n937:         } else if (code === 0) {\\n938:           resolve();\\n939:         } else {\\n940:           const how = code === null ? `was killed by signal ${signal}` : `exited ${code}`;\\n941:           reject(new Error(`\\\\`supabase db reset\\\\` ${how}: ${diagnostic(stderr) || '(no error output)'}`));\\n942:         }\\n943:       });\\n944:     });\\n945:   } finally {\\n946:     clearTimeout(timer);\\n947:   }\\n948: }\\n949: \\n950: /* --------------------------------------------------------------------------- vitest json shape */\\n951: \\n952: export interface AssertionResult {\\n953:   title?: string;\\n954:   fullName?: string;\\n955:   status?: string;\\n956:   failureMessages?: string[];\\n957: }\\n958: \\n959: /**\\n960:  * The report's own arithmetic, alongside the per-test results. `--expect` needs both: the id\\n961:  * parser only sees tests whose titles carry an AT id, so an untagged `it()` that fails is\\n962:  * invisible to it and visible in these counts. Optional because this describes a file on disk —\\n963:  * a missing field is validated at runtime (see `reportAccountingDeviations`), not asserted here.\\n964:  */\\n965: interface VitestJson {\\n966:   /**\\n967:    * One entry per test FILE. `status` and `message` are kept alongside the assertions because a\\n968:    * file that fails to import, or whose hook throws, changes no test's status: that failure is\\n969:    * visible here and nowhere else in the report.\\n970:    */\\n971:   testResults?: { name?: string; status?: string; message?: string; assertionResults?: AssertionResult[] }[];\\n972:   numTotalTests?: number;\\n973:   numPassedTests?: number;\\n974:   numFailedTests?: number;\\n975:   numPendingTests?: number;\\n976:   numTodoTests?: number;\\n977:   success?: boolean;\\n978: }\\n979: \\n980: export interface IdRow {\\n981:   id: string;\\n982:   status: 'green' | 'red' | 'missing';\\n983:   detail: string;\\n984: }\\n985: \\n986: export interface RuntimeRegistration {\\n987:   atId: string;\\n988:   title: string;\\n989:   surface: string;\\n990: }\\n991: \\n992: export interface ReportAnalysis {\\n993:   rows: IdRow[];\\n994:   unexpected: string[];\\n995: }\\n996: \\n997: function assertionId(assertion: AssertionResult): string | null {\\n998:   return /^(AT-[\\\\d.]+[a-z]?)\\\\s+—/.exec(assertion.title ?? assertion.fullName ?? '')?.[1] ?? null;\\n999: }\\n1000: \\n1001: export function analyzeReportedTests(\\n1002:   expected: string[],\\n1003:   registrations: RuntimeRegistration[],\\n1004:   assertions: AssertionResult[],\\n1005: ): ReportAnalysis {\\n1006:   const registrationGroups = new Map<string, RuntimeRegistration[]>();\\n1007:   for (const registration of registrations) {\\n1008:     const group = registrationGroups.get(registration.atId) ?? [];\\n1009:     group.push(registration);\\n1010:     registrationGroups.set(registration.atId, group);\\n1011:   }\\n1012: \\n1013:   const assertionGroups = new Map<string, AssertionResult[]>();\\n1014:   for (const assertion of assertions) {\\n1015:     const id = assertionId(assertion);\\n1016:     if (!id) continue;\\n1017:     const group = assertionGroups.get(id) ?? [];\\n1018:     group.push(assertion);\\n1019:     assertionGroups.set(id, group);\\n1020:   }\\n1021: \\n1022:   const rows: IdRow[] = expected.map((id) => {\\n1023:     const runtime = registrationGroups.get(id) ?? [];\\n1024:     const results = assertionGroups.get(id) ?? [];\\n1025:     if (runtime.length !== 1) {\\n1026:       return {\\n1027:         id,\\n1028:         status: 'red',\\n1029:         detail:\\n1030:           runtime.length === 0\\n1031:             ? 'no runtime registration emitted by atTest'\\n1032:             : `${runtime.length} runtime registrations emitted by atTest; expected exactly 1`,\\n1033:       };\\n1034:     }\\n1035:     if (results.length !== 1) {\\n1036:       return {\\n1037:         id,\\n1038:         status: 'red',\\n1039:         detail: `${results.length} Vitest results reported; expected exactly 1`,\\n1040:       };\\n1041:     }\\n1042: \\n1043:     const result = results[0];\\n1044:     const expectedTitle = `${id} — ${runtime[0].title}`;\\n1045:     if (result.title !== expectedTitle) {\\n1046:       return {\\n1047:         id,\\n1048:         status: 'red',\\n1049:         detail: `Vitest title ${JSON.stringify(result.title)} does not match runtime registration ${JSON.stringify(expectedTitle)}`,\\n1050:       };\\n1051:     }\\n1052:     if (result.status !== 'passed') {\\n1053:       return {\\n1054:         id,\\n1055:         status: 'red',\\n1056:         detail: firstLine(result.failureMessages?.join('\\\\n'), `status \\\"${result.status}\\\"`),\\n1057:       };\\n1058:     }\\n1059:     return { id, status: 'green', detail: runtime[0].title };\\n1060:   });\\n1061: \\n1062:   const observed = new Set([...registrationGroups.keys(), ...assertionGroups.keys()]);\\n1063:   const unexpected = [...observed].filter((id) => !expected.includes(id)).sort();\\n1064:   return { rows, unexpected };\\n1065: }\\n1066: \\n1067: function runtimeRegistrations(dir: string): RuntimeRegistration[] {\\n1068:   const registrations: RuntimeRegistration[] = [];\\n1069:   for (const file of readdirSync(dir, { withFileTypes: true })) {\\n1070:     if (!file.isFile() || !file.name.endsWith('.jsonl')) continue;\\n1071:     const lines = readFileSync(join(dir, file.name), 'utf8').split(/\\\\r?\\\\n/).filter(Boolean);\\n1072:     for (const line of lines) registrations.push(JSON.parse(line) as RuntimeRegistration);\\n1073:   }\\n1074:   return registrations;\\n1075: }\\n1076: \\n1077: export interface ProcessOutcome {\\n1078:   error?: unknown;\\n1079:   status: number | null;\\n1080:   signal?: NodeJS.Signals | null;\\n1081: }\\n1082: \\n1083: /**\\n1084:  * The verdict is NOT \\\"did every row go green\\\". A vitest process can report twelve green\\n1085:  * assertions and still exit non-zero — a global teardown that threw, an unhandled rejection, a\\n1086:  * worker that died after its last test. Treating that as success is exactly the false green this\\n1087:  * harness exists to prevent, so the process's own exit is part of the verdict, and a discrepancy\\n1088:  * between green rows and a non-zero exit is called out rather than smoothed over.\\n1089:  */\\n1090: export function runVerdict(rows: IdRow[], unexpected: string[], run: ProcessOutcome): string[] {\\n1091:   const problems: string[] = [];\\n1092:   const red = rows.filter((r) => r.status === 'red').length;\\n1093:   const missing = rows.filter((r) => r.status === 'missing').length;\\n1094: \\n1095:   if (red) problems.push(`${red} id${red === 1 ? '' : 's'} red`);\\n1096:   if (missing) problems.push(`${missing} id${missing === 1 ? '' : 's'} missing`);\\n1097:   if (unexpected.length) {\\n1098:     problems.push(`${unexpected.length} registered id${unexpected.length === 1 ? '' : 's'} not P0 of this requirement`);\\n1099:   }\\n1100: \\n1101:   if (run.error) {\\n1102:     const err = run.error as NodeJS.ErrnoException;\\n1103:     problems.push(`the test process could not be launched (${err.code ?? 'spawn error'}): ${diagnostic(err.message)}`);\\n1104:   } else if (run.status !== 0) {\\n1105:     const how = run.status === null ? `was killed by signal ${run.signal}` : `exited ${run.status}`;\\n1106:     problems.push(\\n1107:       red || missing\\n1108:         ? `the test process ${how}`\\n1109:         : `the test process ${how} even though every id reported green — something failed outside the ` +\\n1110:             `assertions (a teardown, an unhandled rejection, a worker that died). This run is a FAILURE.`,\\n1111:     );\\n1112:   }\\n1113: \\n1114:   return problems;\\n1115: }\\n1116: \\n1117: /**\\n1118:  * End-of-run housekeeping. The lock release lives in a `finally` of its OWN so that it cannot be\\n1119:  * skipped: on Windows, removing the report directory can throw EPERM while a file in it is still\\n1120:  * open, and if that throw escaped, the stack lock would be stranded and every later run would\\n1121:  * find a leftover it has to reason about. A lost temp directory is untidy; a stranded lock blocks\\n1122:  * work, so the release always wins and the cleanup failure is reported instead of hidden.\\n1123:  */\\n1124: export function cleanupRun(reportDir: string, lock: { release(): void } | null): void {\\n1125:   try {\\n1126:     rmSync(reportDir, { recursive: true, force: true });\\n1127:   } catch (err) {\\n1128:     console.error(`at:verify — could not remove the report directory ${reportDir}: ${diagnostic((err as Error).message)}`);\\n1129:   } finally {\\n1130:     lock?.release();\\n1131:   }\\n1132: }\\n1133: \\n1134: function firstLine(text: string | undefined, fallback: string): string {\\n1135:   const line = redact(text ?? '')\\n1136:     .split('\\\\n')\\n1137:     .map((l) => l.trim())\\n1138:     .find((l) => l.length > 0);\\n1139:   return line ?? fallback;\\n1140: }\\n1141: \\n1142: /* --------------------------------------------------------------------------------------- main */\\n1143: \\n1144: async function main(argv: string[]): Promise<number> {\\n1145:   let args: Args;\\n1146:   try {\\n1147:     args = parseArgs(argv);\\n1148:   } catch (err) {\\n1149:     console.error(`at:verify — ${(err as Error).message}`);\\n1150:     console.error(USAGE);\\n1151:     return 2;\\n1152:   }\\n1153: \\n1154:   const { requirement, tier, wired, expectDeclared } = args;\\n1155: \\n1156:   if (wired) {\\n1157:     console.error(\\n1158:       `at:verify req-${requirement} --wired — the screen driver does not exist yet. Wired re-runs ` +\\n1159:         `drive the ui-marked ids through real screens; that driver is a later AI4DEV-3 slice, so ` +\\n1160:         `there is nothing to re-run against and a silent fixture run would be a false green.`,\\n1161:     );\\n1162:     return 3;\\n1163:   }\\n1164: \\n1165:   const dir = suiteDir(requirement);\\n1166:   if (!existsSync(dir)) {\\n1167:     console.error(`at:verify req-${requirement} — no suite at ${dir}`);\\n1168:     return 2;\\n1169:   }\\n1170: \\n1171:   let expected: string[];\\n1172:   try {\\n1173:     const preflight = inspectBijection(requirement);\\n1174:     expected = preflight.expected;\\n1175:     if (preflight.problems.length) {\\n1176:       console.error(`at:verify req-${requirement} — AT↔code preflight refused the run: ${preflight.problems.join('; ')}`);\\n1177:       return 2;\\n1178:     }\\n1179:   } catch (err) {\\n1180:     console.error(`at:verify req-${requirement} — ${(err as Error).message}`);\\n1181:     return 2;\\n1182:   }\\n1183: \\n1184:   // The declaration preflight sits HERE for two reasons, both load-bearing. It needs the\\n1185:   // acceptance file's P0 id set, which only exists after the bijection preflight above; and every\\n1186:   // refusal must run NO tests, so it must precede the vitest spawn. Placing it before the stack\\n1187:   // sequence as well means a bad declaration never takes the machine-wide lock, never talks to\\n1188:   // Docker and never resets a database — the refusal costs nothing at any tier.\\n1189:   let expectation: TierExpectation | null = null;\\n1190:   if (expectDeclared) {\\n1191:     try {\\n1192:       expectation = loadTierExpectation(requirement, tier, expected);\\n1193:     } catch (err) {\\n1194:       console.error(`at:verify req-${requirement} --tier ${tier} --expect — DECLARATION REFUSED: ${(err as Error).message}`);\\n\\n(Output capped at 50 KB. Showing lines 1-1194. Use offset=1195 to continue.)\\n</content>\",\"metadata\":{\"preview\":\"/**\\n * The AT runner — `bun run at:verify req-0NN --tier <loop|integration|drill>`.\\n *\\n * The command shape is fixed: all 30 decomposition manifests cite it verbatim in their done\\n * contracts, and the skills (`/dev-start`'s inner loop, `/dev-end`, `/pm-done`'s gate) call it.\\n * It resolves the requirement's suite, runs it under vitest with the tier passed through\\n * `AT_TIER`, and reports PER AT ID — green / red / missing — because \\\"3 failed\\\" tells a gate\\n * nothing about which acceptance criterion is unmet.\\n *\\n * The `integration` tier needs a real database, and that database is a SLOT out of the local\\n * database pool (`db-pool.ts`) — never a shared hosted project, because every run wipes and\\n * rebuilds it, and never the stack described by this repository's own `supabase/config.toml`,\\n * because that one is the founder's personal stack and is untouchable. The sequence is\\n * deliberately paranoid:\\n *\\n *   1. occupy the slot the coordinator reserved for this item — a machine-wide claim keyed by the\\n *      slot's project id + api port, so two runs cannot reset under each other;\\n *   2. prepare the slot: mirror this tree's `supabase/` into it, overlay the slot's permanent\\n *      identity, PROVE the stack that answers is that slot — loopback host, the slot's own ports,\\n *      keys issued by the local development issuer — reset it, and prove the migration set\",\"truncated\":true,\"loaded\":[],\"display\":{\"type\":\"file\",\"path\":\"C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\runner.ts\",\"text\":\"/**\\n * The AT runner — `bun run at:verify req-0NN --tier <loop|integration|drill>`.\\n *\\n * The command shape is fixed: all 30 decomposition manifests cite it verbatim in their done\\n * contracts, and the skills (`/dev-start`'s inner loop, `/dev-end`, `/pm-done`'s gate) call it.\\n * It resolves the requirement's suite, runs it under vitest with the tier passed through\\n * `AT_TIER`, and reports PER AT ID — green / red / missing — because \\\"3 failed\\\" tells a gate\\n * nothing about which acceptance criterion is unmet.\\n *\\n * The `integration` tier needs a real database, and that database is a SLOT out of the local\\n * database pool (`db-pool.ts`) — never a shared hosted project, because every run wipes and\\n * rebuilds it, and never the stack described by this repository's own `supabase/config.toml`,\\n * because that one is the founder's personal stack and is untouchable. The sequence is\\n * deliberately paranoid:\\n *\\n *   1. occupy the slot the coordinator reserved for this item — a machine-wide claim keyed by the\\n *      slot's project id + api port, so two runs cannot reset under each other;\\n *   2. prepare the slot: mirror this tree's `supabase/` into it, overlay the slot's permanent\\n *      identity, PROVE the stack that answers is that slot — loopback host, the slot's own ports,\\n *      keys issued by the local development issuer — reset it, and prove the migration set\\n *      replayed. Every step of that lives in `db-pool.ts`;\\n *   3. print the evidence line naming the slot, so a green can always name the database it graded;\\n *   4. run the suite with an ALLOWLISTED environment — the child gets the platform minimum plus\\n *      the validated slot coordinates, and nothing else, so a secret sitting in a developer's\\n *      `.env.local` can never reach a test (and a test can never reach the hosted project).\\n *\\n * The `drill` tier resolves no database at all until an item decides which stack it should use.\\n *\\n * Any failure in that sequence is an INFRASTRUCTURE failure: non-zero exit, no tests run, a\\n * message naming what failed. The runner never falls back to the loop tier's stubs and never\\n * runs against a database whose state it could not establish — a gate grading a stand-in, or an\\n * unknown database, is worse than a gate that refuses to run. Secrets are never printed: raw CLI\\n * output is redacted, and validation reports which check failed, never the value that failed it.\\n */\\n\\nimport { spawn, spawnSync } from 'node:child_process';\\nimport { closeSync, existsSync, mkdirSync, mkdtempSync, openSync, readdirSync, readFileSync, rmSync, writeSync } from 'node:fs';\\nimport { hostname, tmpdir } from 'node:os';\\nimport { join } from 'node:path';\\n\\nimport { INSTALL_ROOT, inspectBijection, normalizeRequirement, REPO_ROOT, suiteDir } from './check.ts';\\n// The cycle with db-pool.ts is deliberate and safe: neither module calls the other at module\\n// scope, and both sides export hoisted function declarations.\\nimport { evidence, occupy, prepare, stackEnv as slotStackEnv, type Occupancy, type PrepareResult } from './db-pool.ts';\\nimport {\\n  expectationDeviations,\\n  expectedManifestPath,\\n  loadTierExpectation,\\n  reportAccountingDeviations,\\n  type TierExpectation,\\n} from './expected.ts';\\n\\nconst TIERS = ['loop', 'integration', 'drill'] as const;\\ntype Tier = (typeof TIERS)[number];\\n\\nconst USAGE = 'usage: bun run at:verify req-0NN --tier <loop|integration|drill> [--wired] [--expect]';\\n\\n/** How long the stack gets to become genuinely ready before the run is called off. */\\nconst READY_TIMEOUT_MS = Number(process.env.AT_READY_TIMEOUT_MS ?? 120_000);\\n/** How long `supabase db reset` gets before it is assumed wedged and its process tree killed. */\\nconst RESET_TIMEOUT_MS = Number(process.env.AT_RESET_TIMEOUT_MS ?? 600_000);\\n/** A lock older than this, or held by a process that is gone, is taken over. */\\nconst LOCK_STALE_MINUTES = Number(process.env.AT_LOCK_STALE_MINUTES ?? 60);\\n/** The takeover gate is held for milliseconds; anything this old was abandoned by a dead process. */\\nconst GATE_STALE_MINUTES = Number(process.env.AT_LOCK_GATE_STALE_MINUTES ?? 2);\\n\\n/** `supabase status` reports these two as stopped because config.toml disables them. Benign. */\\nconst DISABLED_SERVICES = /^supabase_(imgproxy|pooler)_/;\\n\\n/**\\n * The pinned CLI, invoked directly — no shell, no PATH lookup, no globally installed version.\\n * Resolved from the INSTALL root, never the (overridable) data root: the pinned versions live in\\n * the real checkout's `node_modules` wherever the acceptance files being read happen to be.\\n */\\nconst SUPABASE_ENTRY = join(INSTALL_ROOT, 'node_modules', 'supabase', 'dist', 'supabase.js');\\n\\ninterface Args {\\n  requirement: string;\\n  tier: Tier;\\n  wired: boolean;\\n  /** Named `expectDeclared`, not `expect`, so nobody later reads it as vitest's `expect`. */\\n  expectDeclared: boolean;\\n}\\n\\nfunction parseArgs(argv: string[]): Args {\\n  let requirement = '';\\n  let tier = '';\\n  let wired = false;\\n  let expectDeclared = false;\\n\\n  for (let i = 0; i < argv.length; i++) {\\n    const arg = argv[i];\\n    if (arg === '--wired') wired = true;\\n    else if (arg === '--expect') expectDeclared = true;\\n    else if (arg === '--tier') tier = argv[++i] ?? '';\\n    else if (arg.startsWith('--tier=')) tier = arg.slice('--tier='.length);\\n    else if (arg.startsWith('--')) throw new Error(`unknown option \\\"${arg}\\\"`);\\n    else if (!requirement) requirement = arg;\\n    else throw new Error(`unexpected argument \\\"${arg}\\\"`);\\n  }\\n\\n  if (!requirement) throw new Error('no requirement given');\\n  if (!tier) throw new Error('--tier is required — there is no default tier, by design');\\n  if (!TIERS.includes(tier as Tier)) throw new Error(`unknown tier \\\"${tier}\\\" — expected one of ${TIERS.join('|')}`);\\n  // Refused here rather than later: `--wired` runs no tests at all, so there would be no report\\n  // for a declaration to be checked against, and a declaration refusal must never be reported as\\n  // the wired refusal. A usage error exits 2, which is what a `--expect` command that cannot be\\n  // honoured is required to do.\\n  if (wired && expectDeclared) {\\n    throw new Error('--expect and --wired cannot be combined: --wired runs no tests, so there is no report for a declaration to be checked against');\\n  }\\n\\n  return { requirement: normalizeRequirement(requirement), tier: tier as Tier, wired, expectDeclared };\\n}\\n\\n/* --------------------------------------------------------------- the child environment (leak) */\\n\\n/**\\n * The ONLY variables a child process inherits. Everything else is dropped.\\n *\\n * WHY AN ALLOWLIST: bun auto-loads `.env` and `.env.local` into this process, and `.env.example`\\n * tells developers to put their real secrets in `.env.local`. Spreading `process.env` into the\\n * test process would hand every one of those to every test — and a test reading a conventional\\n * name like `SUPABASE_SERVICE_ROLE_KEY` would then be pointed at the HOSTED project, which the\\n * acceptance suites must never touch. The child gets the platform minimum plus exactly the\\n * values this runner validated. Children are additionally launched with bun's `--no-env-file`,\\n * so a child does not re-read the env files for itself.\\n */\\nconst ENV_ALLOWLIST = [\\n  // process/platform basics\\n  'PATH',\\n  'PATHEXT',\\n  'COMSPEC',\\n  'SystemRoot',\\n  'SystemDrive',\\n  'windir',\\n  'OS',\\n  'NUMBER_OF_PROCESSORS',\\n  'PROCESSOR_ARCHITECTURE',\\n  'PROCESSOR_IDENTIFIER',\\n  'USERNAME',\\n  'LANG',\\n  'LC_ALL',\\n  'TZ',\\n  // temp + home, which bun, vitest and the Supabase CLI all need in order to write caches\\n  'TEMP',\\n  'TMP',\\n  'TMPDIR',\\n  'HOME',\\n  'HOMEDRIVE',\\n  'HOMEPATH',\\n  'USERPROFILE',\\n  'APPDATA',\\n  'LOCALAPPDATA',\\n  'PROGRAMDATA',\\n  'PROGRAMFILES',\\n  'PROGRAMFILES(X86)',\\n  'PROGRAMW6432',\\n  'XDG_CACHE_HOME',\\n  'BUN_INSTALL',\\n  // how the Supabase CLI finds the container runtime (never a credential)\\n  'DOCKER_HOST',\\n  'DOCKER_CONTEXT',\\n  'DOCKER_CONFIG',\\n  'DOCKER_CERT_PATH',\\n];\\n\\n/** Windows environment names are case-insensitive, so match that way and keep the parent's casing. */\\nexport function childEnv(extra: Record<string, string> = {}): Record<string, string> {\\n  const wanted = new Set(ENV_ALLOWLIST.map((name) => name.toLowerCase()));\\n  const env: Record<string, string> = {};\\n  for (const [key, value] of Object.entries(process.env)) {\\n    if (value !== undefined && wanted.has(key.toLowerCase())) env[key] = value;\\n  }\\n  return { ...env, ...extra };\\n}\\n\\n/**\\n * The bun binary. Children are launched under bun deliberately — `--no-env-file` is a bun flag,\\n * and it is what stops a child from re-reading `.env`/`.env.local` for itself. Normally this\\n * process IS bun, so its own path is the answer; the PATH lookup only matters when something\\n * else (a test runner's node worker, say) is asking.\\n */\\nexport function bunExecutable(): string {\\n  if (/[\\\\\\\\/]bun(\\\\.exe)?$/i.test(process.execPath)) return process.execPath;\\n  const lookup = spawnSync(process.platform === 'win32' ? 'where' : 'which', ['bun'], {\\n    encoding: 'utf8',\\n    env: childEnv(),\\n  });\\n  const found = (lookup.stdout ?? '')\\n    .split('\\\\n')\\n    .map((line) => line.trim())\\n    .find(Boolean);\\n  if (!found) throw new Error('bun was not found on PATH — the harness runs its children under bun');\\n  return found;\\n}\\n\\n/* --------------------------------------------------------------------------------- redaction */\\n\\n/** Strip anything key-shaped out of text that is about to be printed. */\\nexport function redact(text: string): string {\\n  return String(text ?? '')\\n    .replace(/eyJ[A-Za-z0-9_-]{5,}\\\\.[A-Za-z0-9_-]{5,}\\\\.[A-Za-z0-9_-]{5,}/g, '<redacted-jwt>')\\n    .replace(/\\\\bsb_[a-z]+_[A-Za-z0-9_-]{8,}/g, '<redacted-key>')\\n    .replace(/(postgres(?:ql)?:\\\\/\\\\/)[^@\\\\s/]+@/gi, '$1<redacted>@')\\n    .replace(/[A-Za-z0-9_-]{40,}/g, '<redacted-token>');\\n}\\n\\n/** First non-empty line, redacted and length-capped — enough to diagnose, not enough to leak. */\\nexport function diagnostic(text: string | undefined, limit = 400): string {\\n  const line =\\n    redact(text ?? '')\\n      .split('\\\\n')\\n      .map((l) => l.trim())\\n      .find((l) => l.length > 0) ?? '';\\n  return line.length > limit ? `${line.slice(0, limit)}…` : line;\\n}\\n\\n/* ------------------------------------------------------------------------ config.toml reading */\\n\\nexport interface LocalConfig {\\n  projectId: string;\\n  apiPort: number;\\n  dbPort: number;\\n}\\n\\n/**\\n * Ports and project id come from `supabase/config.toml` — never guessed, never hard-coded.\\n *\\n * The root is a parameter so the database-slot pool can read a SLOT's own config with this exact\\n * scanner instead of a second copy of it. Unset — every ordinary run — it reads the repo tree, so\\n * the loop and integration call sites behave as they did before the parameter existed.\\n */\\nexport function readLocalConfig(root: string = REPO_ROOT): LocalConfig {\\n  const file = join(root, 'supabase', 'config.toml');\\n  const text = readFileSync(file, 'utf8');\\n  let section = '';\\n  let projectId = '';\\n  let apiPort = 0;\\n  let dbPort = 0;\\n\\n  for (const raw of text.split('\\\\n')) {\\n    const line = raw.trim();\\n    const header = /^\\\\[([^\\\\]]+)\\\\]/.exec(line);\\n    if (header) {\\n      section = header[1];\\n      continue;\\n    }\\n    const port = /^port\\\\s*=\\\\s*(\\\\d+)/.exec(line);\\n    if (section === '' && /^project_id\\\\s*=/.test(line)) projectId = /\\\"([^\\\"]+)\\\"/.exec(line)?.[1] ?? '';\\n    else if (section === 'api' && port && !apiPort) apiPort = Number(port[1]);\\n    else if (section === 'db' && port && !dbPort) dbPort = Number(port[1]);\\n  }\\n\\n  const missing = [projectId ? '' : 'project_id', apiPort ? '' : '[api] port', dbPort ? '' : '[db] port'].filter(Boolean);\\n  if (missing.length) throw new Error(`${file} is missing ${missing.join(' and ')}`);\\n  return { projectId, apiPort, dbPort };\\n}\\n\\n/* ---------------------------------------------------------------------- the machine-wide lock */\\n\\nexport interface StackLock {\\n  file: string;\\n  release(): void;\\n}\\n\\n/**\\n * Where the machine-wide claim files live.\\n *\\n * `AT_LOCK_DIR` overrides it, the same pattern and the same reason as `AT_REPO_ROOT`: a test that\\n * exercises the claim protocol must not write into the directory a real run reads, or a selftest\\n * and a live `at:verify` could take each other's lock. Unset — every ordinary run — the answer is\\n * unchanged.\\n */\\nfunction lockDir(): string {\\n  const override = process.env.AT_LOCK_DIR?.trim();\\n  const dir = override ? override : join(process.env.LOCALAPPDATA ?? process.env.XDG_CACHE_HOME ?? tmpdir(), 'ai4good-build', 'at-locks');\\n  mkdirSync(dir, { recursive: true });\\n  return dir;\\n}\\n\\nfunction processIsAlive(pid: number): boolean {\\n  try {\\n    process.kill(pid, 0);\\n    return true;\\n  } catch (err) {\\n    // EPERM means it exists but belongs to someone else; ESRCH means it is gone.\\n    return (err as NodeJS.ErrnoException).code === 'EPERM';\\n  }\\n}\\n\\n/** The lock path for one stack. Machine-wide, and deliberately carries no folder component. */\\nexport function stackLockPath(config: LocalConfig): string {\\n  return join(lockDir(), `at-verify-${config.projectId}-${config.apiPort}.lock`);\\n}\\n\\nexport interface Holder {\\n  pid?: number;\\n  host?: string;\\n  requirement?: string;\\n  startedAt?: string;\\n  /** Set only on a claim that replaced a stale one, so the takeover is recorded IN the claim. */\\n  tookOverFrom?: { pid?: number; startedAt?: string; requirement?: string };\\n}\\n\\n/**\\n * Which holders a caller is allowed to displace.\\n *\\n * `stale-or-dead` is the runner's own long-standing rule: a dead process, or a live one whose\\n * claim is older than `LOCK_STALE_MINUTES`. `dead-pid-only` never displaces a running process at\\n * any age — the database-slot pool passes it, because a slot's occupancy is ruled to break on a\\n * dead holder pid and on nothing else. A run that legitimately lasts longer than the stale window\\n * must not have its database reset under it.\\n */\\nexport type TakeoverPolicy = 'stale-or-dead' | 'dead-pid-only';\\n\\nexport interface StackLockOptions {\\n  takeover?: TakeoverPolicy;\\n}\\n\\n/** Live = a holder this policy may not displace. */\\nfunction holderIsLive(holder: Holder, policy: TakeoverPolicy = 'stale-or-dead'): boolean {\\n  if (typeof holder.pid !== 'number' || !processIsAlive(holder.pid)) return false;\\n  if (policy === 'dead-pid-only') return true;\\n  const startedAt = holder.startedAt ? Date.parse(holder.startedAt) : NaN;\\n  const ageMinutes = Number.isFinite(startedAt) ? (Date.now() - startedAt) / 60_000 : Infinity;\\n  return ageMinutes < LOCK_STALE_MINUTES;\\n}\\n\\nfunction heldByAnotherRun(holder: Holder, file: string): Error {\\n  return new Error(\\n    `another at:verify run holds this stack (pid ${holder.pid} on ${holder.host ?? 'this machine'}, ` +\\n      `requirement ${holder.requirement ?? 'unknown'}, started ${holder.startedAt ?? 'unknown'}). ` +\\n      `Two runs against one stack destroy each other: the second would reset the first's database ` +\\n      `mid-run. Wait for it to finish. If that process is definitely gone, delete ${file}.`,\\n  );\\n}\\n\\n/**\\n * A gate left behind by a process that died mid-takeover. The section lasts milliseconds, so\\n * anything this old is certainly abandoned; removing one wrongly costs at most two processes in\\n * the section, which is the behaviour we had before the gate existed.\\n */\\nfunction clearStrandedGate(gate: string): void {\\n  try {\\n    const held = JSON.parse(readFileSync(gate, 'utf8')) as { pid?: number; at?: string };\\n    const at = held.at ? Date.parse(held.at) : NaN;\\n    const ageMinutes = Number.isFinite(at) ? (Date.now() - at) / 60_000 : Infinity;\\n    const alive = typeof held.pid === 'number' && processIsAlive(held.pid);\\n    if (!alive || ageMinutes > GATE_STALE_MINUTES) rmSync(gate, { force: true });\\n  } catch {\\n    // unreadable or already gone — the next pass finds out\\n  }\\n}\\n\\n/**\\n * Serialize every destructive run against one stack. The key is project id + api port because\\n * that pair IS the stack's identity: a second checkout carrying the same `project_id` shares the\\n * same Docker containers and the same ports, so its `at:verify` would reset this run's database\\n * out from under it. Mirrors `Acquire-WorkLock` in loop/work/work-lib.ps1 — exclusive create,\\n * holder recorded, stale takeover.\\n *\\n * TAKEOVER IS THE WHOLE DIFFICULTY. Two processes can both read the same leftover lock and both\\n * conclude it is stale; if each then removed it and created its own, the second removal would take\\n * out the FIRST one's brand-new live lock and both would run — the precise failure this exists to\\n * prevent. Moving the stale file aside with an atomic rename does NOT fix that: the winner\\n * repopulates the path microseconds later, so the loser's rename succeeds against a LIVE lock,\\n * which is just as destructive as unlinking it. (Proved with a two-contender race, not reasoned\\n * about; the race is in runner.selftest.ts.)\\n *\\n * So the takeover DECISION is serialized by a second exclusive-create lock — the gate. Only one\\n * process is ever inside it, and it re-reads the holder INSIDE, so:\\n *   - no other process can be taking over concurrently (the gate is exclusive);\\n *   - no ordinary claim can have slipped in, because the stale file occupies the path continuously\\n *     until the gate holder removes it, and an exclusive create only succeeds on a free path;\\n *   - if a third process wins the claim in the instant after removal, the gate holder's own create\\n *     simply fails and it restarts, having deleted nothing further.\\n * A gate stranded by a killed process is cleared on age. The section lasts milliseconds, so a live\\n * holder never reaches that threshold, and clearing one wrongly degrades to two takers in the\\n * section — today's behaviour, not worse.\\n */\\nexport function acquireStackLock(config: LocalConfig, requirement: string, options: StackLockOptions = {}): StackLock {\\n  const file = stackLockPath(config);\\n  const policy: TakeoverPolicy = options.takeover ?? 'stale-or-dead';\\n\\n  const claim = (displaced?: Holder): StackLock | null => {\\n    let fd: number;\\n    try {\\n      fd = openSync(file, 'wx');\\n    } catch (err) {\\n      if ((err as NodeJS.ErrnoException).code === 'EEXIST') return null;\\n      throw err;\\n    }\\n    try {\\n      writeSync(\\n        fd,\\n        JSON.stringify({\\n          pid: process.pid,\\n          host: hostname(),\\n          requirement,\\n          startedAt: new Date().toISOString(),\\n          // A takeover recorded ONLY on the console is lost the moment the terminal scrolls. The\\n          // claim file outlives the run that wrote it, so whoever reads it later can see that this\\n          // occupancy began by displacing an abandoned one, and whose.\\n          ...(displaced\\n            ? {\\n                tookOverFrom: {\\n                  pid: displaced.pid,\\n                  startedAt: displaced.startedAt,\\n                  requirement: displaced.requirement,\\n                },\\n              }\\n            : {}),\\n        }),\\n      );\\n    } finally {\\n      closeSync(fd);\\n    }\\n    return {\\n      file,\\n      release: () => {\\n        try {\\n          const held = JSON.parse(readFileSync(file, 'utf8')) as { pid?: number };\\n          if (held.pid === process.pid) rmSync(file, { force: true });\\n        } catch {\\n          // already removed, or unreadable — nothing of ours left to release\\n        }\\n      },\\n    };\\n  };\\n\\n  const gate = `${file}.takeover`;\\n\\n  /** The recorded holder, or null if the lock is gone. */\\n  const readHolder = (): Holder | null => {\\n    try {\\n      return JSON.parse(readFileSync(file, 'utf8')) as Holder;\\n    } catch (err) {\\n      if ((err as NodeJS.ErrnoException).code === 'ENOENT') return null;\\n      return {}; // unreadable or half-written: treat as an unidentifiable holder, judged below\\n    }\\n  };\\n\\n  /** Bounded synchronous pause; a gate is held for milliseconds, so this is all the wait needed. */\\n  const pause = (ms: number) => {\\n    const until = Date.now() + ms;\\n    while (Date.now() < until) {\\n      /* spin */\\n    }\\n  };\\n\\n  /**\\n   * UNDER `dead-pid-only`, AN UNIDENTIFIABLE HOLDER IS NEVER TAKEOVER-ELIGIBLE.\\n   *\\n   * `readHolder` returns `{}` for a file it cannot read or parse, and `holderIsLive({})` is false\\n   * under every policy — so without this guard a claim file that is empty or half written looks\\n   * exactly like a dead holder and is deleted. The window is real and small: it is the microseconds\\n   * between `openSync(file, 'wx')` and the `writeSync` that fills the file, so a second occupier\\n   * arriving in that instant would remove a LIVE process's brand-new claim. That is the one thing\\n   * this policy exists to make impossible.\\n   *\\n   * One bounded re-read skates over the write window. A holder that STILL has no parseable pid is\\n   * not a dead holder — it is a file nobody in this process can account for — so it refuses loudly\\n   * and names the manual repair. `stale-or-dead` keeps its long-standing behaviour: that path\\n   * predates the slot pool and is another item's business.\\n   *\\n   * Returns the identified holder, or null when the file went away and the loop should retry.\\n   */\\n  const identified = (holder: Holder, where: string): Holder | null => {\\n    if (typeof holder.pid === 'number') return holder;\\n    if (policy !== 'dead-pid-only') return holder;\\n\\n    pause(50);\\n    const again = readHolder();\\n    if (again === null) return null; // released while we looked; the loop takes the free path\\n    if (typeof again.pid === 'number') return again;\\n\\n    throw new Error(\\n      `refusing to take over the claim at ${file}: it names no process id that this run can read, ` +\\n        `so it cannot be shown to be dead — and a claim file being written right now looks exactly ` +\\n        `like this. Nothing was taken over. If no run holds that stack, delete ${file} by hand ` +\\n        `(checked ${where}).`,\\n    );\\n  };\\n\\n  // Bounded: every retry follows another process winning the gate, which cannot repeat forever.\\n  for (let attempt = 0; attempt < 20; attempt++) {\\n    const claimed = claim();\\n    if (claimed) return claimed;\\n\\n    const read = readHolder();\\n    if (read === null) continue; // released between the failed claim and the read\\n    const holder = identified(read, 'before the takeover gate');\\n    if (holder === null) continue;\\n    if (holderIsLive(holder, policy)) throw heldByAnotherRun(holder, file);\\n\\n    // Stale. Enter the takeover gate — the only place the live lock path may be removed.\\n    let gateFd: number;\\n    try {\\n      gateFd = openSync(gate, 'wx');\\n    } catch (err) {\\n      if ((err as NodeJS.ErrnoException).code !== 'EEXIST') throw err;\\n      clearStrandedGate(gate);\\n      pause(10);\\n      continue;\\n    }\\n\\n    try {\\n      writeSync(gateFd, JSON.stringify({ pid: process.pid, at: new Date().toISOString() }));\\n      const readInside = readHolder();\\n      if (readInside === null) continue; // released while we were entering; the next claim takes it\\n      // The same guard as above: the gate must not be able to remove an unidentifiable file either.\\n      const inside = identified(readInside, 'inside the takeover gate');\\n      if (inside === null) continue;\\n      if (holderIsLive(inside, policy)) continue; // refreshed under us; the next pass refuses it properly\\n\\n      rmSync(file, { force: true });\\n      const takeover = claim(inside);\\n      if (!takeover) continue; // a third process claimed the free path first — delete nothing more\\n\\n      console.log(\\n        `at:verify — took over a stale stack lock (holder pid ${inside.pid ?? 'unknown'} ` +\\n          `${typeof inside.pid === 'number' && processIsAlive(inside.pid) ? `is older than ${LOCK_STALE_MINUTES} minutes` : 'is no longer running'})`,\\n      );\\n      return takeover;\\n    } finally {\\n      closeSync(gateFd);\\n      rmSync(gate, { force: true });\\n    }\\n  }\\n\\n  throw new Error(`could not acquire the stack lock at ${file} — it kept changing hands; try again`);\\n}\\n\\n/* -------------------------------------------------------------------- the stack's own report */\\n\\nexport interface StackStatus {\\n  apiUrl: string;\\n  dbUrl: string;\\n  anonKey: string;\\n  serviceRoleKey: string;\\n}\\n\\nconst REQUIRED_STATUS_FIELDS: Record<keyof StackStatus, string> = {\\n  apiUrl: 'API_URL',\\n  dbUrl: 'DB_URL',\\n  anonKey: 'ANON_KEY',\\n  serviceRoleKey: 'SERVICE_ROLE_KEY',\\n};\\n\\nexport function supabaseArgs(...args: string[]): string[] {\\n  if (!existsSync(SUPABASE_ENTRY)) throw new Error(`the Supabase CLI is not installed at ${SUPABASE_ENTRY} — run \\\\`bun install\\\\``);\\n  return ['--no-env-file', SUPABASE_ENTRY, ...args];\\n}\\n\\n/**\\n * WHICH PROJECT an invocation acts on. A target names both halves of an identity, because either\\n * half alone is a hybrid.\\n */\\nexport interface CliTarget {\\n  /** The directory that CONTAINS the `supabase/` project folder — what `--workdir` names. */\\n  workdir: string;\\n  /** The project id the invocation must resolve, stated POSITIVELY in `SUPABASE_PROJECT_ID`. */\\n  projectId: string;\\n}\\n\\nexport interface CliInvocation {\\n  args: string[];\\n  cwd: string;\\n  env: Record<string, string>;\\n}\\n\\n/**\\n * THE ONE SEAM every Supabase CLI invocation is built at. Nothing in this repository assembles a\\n * CLI command line, working directory or environment anywhere else, and that single seam is the\\n * whole wall — a wall with two builders is a wall with a gap.\\n *\\n * THREE THINGS HAVE TO AGREE, and the reason each is here was measured, not reasoned about:\\n *\\n *   1. `SUPABASE_PROJECT_ID`, set POSITIVELY to the target's project id. The CLI treats that\\n *      variable as an OVERRIDE of `project_id` in `config.toml`. The repo's tracked `.env` carries\\n *      it, bun loads `.env` into this process, and on 2026-08-09 a `db reset` aimed at slot 2\\n *      destroyed the founder's personal database because the environment supplied the identity\\n *      while the slot's config supplied the ports. The wall is stating the identity, never merely\\n *      avoiding an override: an absence can be reintroduced by any parent process, a positive\\n *      value cannot.\\n *   2. NO OTHER `SUPABASE_*` variable. `childEnv` is an allowlist that carries none, and this\\n *      function asserts that rather than trusting it, because the allowlist is edited by people.\\n *   3. The WORKING DIRECTORY, equal to `--workdir`. Measured 2026-08-10: when the CLI's working\\n *      directory is itself a Supabase project, `--workdir <other>` produces a hybrid — the other\\n *      project's ports beside the working directory's project's containers. Run from a directory\\n *      that is not a project, the same command correctly says\\n *      `No such container: supabase_db_ai4good-slot-1`.\\n *\\n * `bun --no-env-file` (in `supabaseArgs`) closes the fourth route: a child that re-reads `.env`\\n * for itself.\\n *\\n * No target means the repository's own project, exactly as every call site behaved before targets\\n * existed: no `--workdir`, the repo root, and an environment carrying no `SUPABASE_*` at all.\\n */\\nexport function supabaseInvocation(target: CliTarget | undefined, args: string[]): CliInvocation {\\n  if (!target) return { args: supabaseArgs(...args), cwd: REPO_ROOT, env: childEnv() };\\n\\n  const env = childEnv({ SUPABASE_PROJECT_ID: target.projectId });\\n  const foreign = Object.keys(env).filter((name) => /^SUPABASE_/i.test(name) && name.toUpperCase() !== 'SUPABASE_PROJECT_ID');\\n  if (foreign.length) {\\n    throw new Error(\\n      `refusing to run the Supabase CLI against ${target.projectId}: the child environment would also carry ` +\\n        `${foreign.join(', ')}, and a second SUPABASE_* variable can override the identity this invocation states.`,\\n    );\\n  }\\n  if (env.SUPABASE_PROJECT_ID !== target.projectId) {\\n    throw new Error(`refusing to run the Supabase CLI: SUPABASE_PROJECT_ID would not be \\\"${target.projectId}\\\"`);\\n  }\\n  return { args: supabaseArgs('--workdir', target.workdir, ...args), cwd: target.workdir, env };\\n}\\n\\nexport interface CliResult {\\n  status: number | null;\\n  signal?: NodeJS.Signals | null;\\n  stdout: string;\\n  stderr: string;\\n  error?: Error;\\n}\\n\\n/** Run the pinned CLI through the seam and hand back the RAW result. The caller decides what to\\n * read and what may be printed — raw output carries every key the stack issues. */\\nexport function runSupabaseCli(target: CliTarget | undefined, args: string[]): CliResult {\\n  const invocation = supabaseInvocation(target, args);\\n  const res = spawnSync(bunExecutable(), invocation.args, { cwd: invocation.cwd, env: invocation.env, encoding: 'utf8' });\\n  return {\\n    status: res.status,\\n    signal: res.signal,\\n    stdout: res.stdout ?? '',\\n    stderr: res.stderr ?? '',\\n    error: res.error as Error | undefined,\\n  };\\n}\\n\\n/**\\n * Ask the running stack to describe itself. The raw output is NEVER printed: it contains every\\n * key the stack issues. Only field names travel into error messages.\\n */\\nexport function readStackStatus(target?: CliTarget): StackStatus {\\n  return parseStackStatus(runSupabaseCli(target, ['status', '-o', 'json']));\\n}\\n\\n/**\\n * The status parser, separate from the invocation so that a caller which needs the RAW output for\\n * its own checks (the slot pool's identity read) reads it once and parses the same result, rather\\n * than running the CLI twice or keeping a second copy of this parser.\\n */\\nexport function parseStackStatus(res: CliResult): StackStatus {\\n  if (res.error) {\\n    const err = res.error as NodeJS.ErrnoException;\\n    throw new Error(`could not launch the Supabase CLI (${err.code ?? 'spawn error'}): ${diagnostic(err.message)}`);\\n  }\\n\\n  const stdout = res.stdout ?? '';\\n  const open = stdout.indexOf('{');\\n  const close = stdout.lastIndexOf('}');\\n  if (open < 0 || close <= open) {\\n    throw new Error(\\n      `\\\\`supabase status\\\\` reported no JSON (exit ${res.status}${res.signal ? `, signal ${res.signal}` : ''}): ` +\\n        `${diagnostic(res.stderr) || '(no error output)'}`,\\n    );\\n  }\\n\\n  // The CLI exits non-zero merely because config.toml disables imgproxy and the pooler. That is\\n  // not a failure; anything ELSE reported stopped is.\\n  const notice = `${stdout.slice(0, open)}\\\\n${res.stderr ?? ''}`;\\n  const stopped = /Stopped services:\\\\s*\\\\[([^\\\\]]*)\\\\]/.exec(notice)?.[1] ?? '';\\n  const unexpectedStopped = stopped.split(/\\\\s+/).filter((name) => name && !DISABLED_SERVICES.test(name));\\n  if (unexpectedStopped.length) {\\n    throw new Error(`the stack reports stopped services: ${unexpectedStopped.join(', ')} — start them before running the suite`);\\n  }\\n\\n  let parsed: Record<string, unknown>;\\n  try {\\n    parsed = JSON.parse(stdout.slice(open, close + 1)) as Record<string, unknown>;\\n  } catch (err) {\\n    throw new Error(`\\\\`supabase status\\\\` produced unparseable JSON: ${(err as Error).message}`);\\n  }\\n\\n  const status: Partial<StackStatus> = {};\\n  const missing: string[] = [];\\n  for (const [field, key] of Object.entries(REQUIRED_STATUS_FIELDS) as [keyof StackStatus, string][]) {\\n    const value = parsed[key];\\n    if (typeof value !== 'string' || value.trim() === '') missing.push(key);\\n    else status[field] = value;\\n  }\\n  if (missing.length) throw new Error(`\\\\`supabase status\\\\` reported no ${missing.join(', no ')}`);\\n  return status as StackStatus;\\n}\\n\\n/* --------------------------------------------------------- proving the stack is the LOCAL one */\\n\\nconst LOOPBACK = new Set(['127.0.0.1', 'localhost', '::1', '[::1]']);\\n\\nfunction decodeJwtClaims(token: string): Record<string, unknown> | null {\\n  const parts = token.split('.');\\n  if (parts.length !== 3) return null;\\n  try {\\n    return JSON.parse(Buffer.from(parts[1], 'base64url').toString('utf8')) as Record<string, unknown>;\\n  } catch {\\n    return null;\\n  }\\n}\\n\\n/**\\n * Refuse to touch anything that is not demonstrably the local development stack. Returns the\\n * names of the checks that failed — never the values, which are keys and connection strings.\\n */\\nexport function localStackProblems(status: StackStatus, config: LocalConfig): string[] {\\n  const problems: string[] = [];\\n\\n  const checkUrl = (label: string, raw: string, expectedPort: number) => {\\n    let url: URL;\\n    try {\\n      url = new URL(raw);\\n    } catch {\\n      problems.push(`${label} is not a URL`);\\n      return;\\n    }\\n    if (!LOOPBACK.has(url.hostname)) problems.push(`${label} does not point at the loopback address`);\\n    if (url.port !== String(expectedPort)) problems.push(`${label} port is not the ${expectedPort} configured in supabase/config.toml`);\\n  };\\n\\n  checkUrl('API_URL', status.apiUrl, config.apiPort);\\n  checkUrl('DB_URL', status.dbUrl, config.dbPort);\\n\\n  const checkKey = (label: string, token: string, expectedRole: string) => {\\n    const claims = decodeJwtClaims(token);\\n    if (!claims) {\\n      problems.push(`${label} is not a decodable local development JWT`);\\n      return;\\n    }\\n    if (claims.iss !== 'supabase-demo') problems.push(`${label} was not issued by the local development issuer`);\\n    if (claims.role !== expectedRole) problems.push(`${label} does not carry the ${expectedRole} role`);\\n    if (typeof claims.ref === 'string') problems.push(`${label} carries a hosted project reference`);\\n  };\\n\\n  checkKey('ANON_KEY', status.anonKey, 'anon');\\n  checkKey('SERVICE_ROLE_KEY', status.serviceRoleKey, 'service_role');\\n\\n  return problems;\\n}\\n\\n/* --------------------------------------------------------------------------------- readiness */\\n\\ninterface BunSqlClient {\\n  (strings: TemplateStringsArray, ...values: unknown[]): Promise<unknown>;\\n  close(): Promise<void>;\\n}\\ntype BunSqlCtor = new (url: string) => BunSqlClient;\\n\\n/** Postgres itself answers a query — not \\\"the port is open\\\", which a half-started stack satisfies. */\\nasync function databaseAnswers(dbUrl: string): Promise<string | null> {\\n  const SQL = (globalThis as { Bun?: { SQL?: BunSqlCtor } }).Bun?.SQL;\\n  if (!SQL) return 'this runtime has no SQL client (expected bun)';\\n  let sql: BunSqlClient | null = null;\\n  try {\\n    sql = new SQL(dbUrl);\\n    await sql`select 1`;\\n    return null;\\n  } catch (err) {\\n    return diagnostic((err as Error).message);\\n  } finally {\\n    await sql?.close().catch(() => undefined);\\n  }\\n}\\n\\n/** One request that only succeeds if Kong routed it, PostgREST served it, and Postgres answered. */\\nasync function gatewayAnswers(status: StackStatus): Promise<string | null> {\\n  try {\\n    const res = await fetch(`${status.apiUrl.replace(/\\\\/$/, '')}/rest/v1/`, {\\n      headers: { apikey: status.anonKey, Authorization: `Bearer ${status.anonKey}` },\\n      signal: AbortSignal.timeout(5000),\\n    });\\n    if (!res.ok) return `the API gateway answered ${res.status}`;\\n    const type = res.headers.get('content-type') ?? '';\\n    if (!type.includes('json')) return `the API gateway answered 200 but served ${type || 'no content type'}`;\\n    return null;\\n  } catch (err) {\\n    return diagnostic((err as Error).message);\\n  }\\n}\\n\\n/**\\n * Wait until the stack is genuinely usable, or give up. \\\"Something answered on the port\\\" is not\\n * readiness: a half-started stack answers 502/503, and a run launched against it fails in ways\\n * that look like test failures instead of infrastructure failures.\\n */\\nexport async function waitForReady(status: StackStatus, phase: string): Promise<void> {\\n  const deadline = Date.now() + READY_TIMEOUT_MS;\\n  let lastProblem = 'not attempted';\\n  let delay = 250;\\n\\n  while (Date.now() < deadline) {\\n    const db = await databaseAnswers(status.dbUrl);\\n    if (db === null) {\\n      const gateway = await gatewayAnswers(status);\\n      if (gateway === null) return;\\n      lastProblem = gateway;\\n    } else {\\n      lastProblem = `the database did not answer: ${db}`;\\n    }\\n    await new Promise((resolve) => setTimeout(resolve, delay));\\n    delay = Math.min(delay * 2, 2000);\\n  }\\n\\n  throw new Error(`the stack was still not ready ${phase} after ${Math.round(READY_TIMEOUT_MS / 1000)}s — last problem: ${lastProblem}`);\\n}\\n\\n/* --------------------------------------------------------------------- the migration-set proof */\\n\\n/** Counted, not just proved — the pool's evidence line has to state the migration state it saw. */\\nexport interface MigrationProof {\\n  expected: number;\\n  applied: number;\\n}\\n\\n/**\\n * The migrations the reset is supposed to replay, read from disk. The CLI names them\\n * `<timestamp>_name.sql` and records the timestamp as the applied version, so the timestamp is\\n * the identity. `.gitkeep` and `README.md` are not migrations and are ignored.\\n */\\nexport function expectedMigrations(root: string = REPO_ROOT): string[] {\\n  const dir = join(root, 'supabase', 'migrations');\\n  if (!existsSync(dir)) return [];\\n  return readdirSync(dir)\\n    .map((name) => /^(\\\\d{14})_.*\\\\.sql$/.exec(name)?.[1])\\n    .filter((version): version is string => Boolean(version))\\n    .sort();\\n}\\n\\n/** What the database says it actually replayed. */\\nasync function appliedMigrations(dbUrl: string): Promise<string[]> {\\n  const SQL = (globalThis as { Bun?: { SQL?: BunSqlCtor } }).Bun?.SQL;\\n  if (!SQL) throw new Error('this runtime has no SQL client (expected bun)');\\n  let sql: BunSqlClient | null = null;\\n  try {\\n    sql = new SQL(dbUrl);\\n    const rows = (await sql`select version from supabase_migrations.schema_migrations order by version`) as {\\n      version: string;\\n    }[];\\n    return rows.map((row) => String(row.version)).sort();\\n  } catch (err) {\\n    // A database that has never had a migration applied has no history table at all. \\\"No table\\\"\\n    // and \\\"empty table\\\" mean the same thing — nothing was applied — and saying so lets the\\n    // comparison below name exactly which migrations are missing instead of reporting a SQL error.\\n    const message = (err as Error).message ?? '';\\n    if (/schema_migrations/.test(message) && /does not exist/i.test(message)) return [];\\n    throw new Error(`could not read the migration history: ${diagnostic(message)}`);\\n  } finally {\\n    await sql?.close().catch(() => undefined);\\n  }\\n}\\n\\n/** Exact set equality, both directions, named plainly. */\\nexport function migrationSetProblems(expected: string[], applied: string[]): string[] {\\n  const missing = expected.filter((version) => !applied.includes(version));\\n  const extra = applied.filter((version) => !expected.includes(version));\\n  const problems: string[] = [];\\n  if (missing.length) problems.push(`never applied: ${missing.join(', ')}`);\\n  if (extra.length) problems.push(`applied but not in supabase/migrations: ${extra.join(', ')}`);\\n  return problems;\\n}\\n\\n/**\\n * Prove the rebuild actually replayed the migration set — the promise `supabase/migrations/README.md`\\n * makes. \\\"The reset command exited zero\\\" is not that proof: a reset that replays NOTHING also exits\\n * zero, and a suite then grades an empty schema while believing it graded the real one.\\n *\\n * An empty expected set is legitimate today (no migrations have been written yet) and is allowed —\\n * but it is STATED on every run, so an empty rebuild can never be silently mistaken for a real one.\\n */\\nexport async function proveMigrationsReplayed(status: StackStatus, root: string = REPO_ROOT): Promise<MigrationProof> {\\n  const expected = expectedMigrations(root);\\n  const applied = await appliedMigrations(status.dbUrl);\\n  const problems = migrationSetProblems(expected, applied);\\n\\n  const summary = `${expected.length} migration${expected.length === 1 ? '' : 's'} expected, ${applied.length} applied`;\\n  if (problems.length) {\\n    throw new Error(`the rebuilt database does not match supabase/migrations (${summary}) — ${problems.join('; ')}`);\\n  }\\n  console.log(\\n    expected.length === 0\\n      ? `at:verify — ${summary} — the schema is empty by design at this stage`\\n      : `at:verify — ${summary} — the rebuilt schema matches supabase/migrations exactly`,\\n  );\\n  return { expected: expected.length, applied: applied.length };\\n}\\n\\n/* ------------------------------------------------------------------------------------- reset */\\n\\n/**\\n * Rebuild the local database from `supabase/migrations` — the same work `bun run db:reset` does,\\n * invoked at the pinned CLI so failures are catchable and bounded.\\n *\\n * WHY EVERY RUN: without it the second run works on the first run's leftover rows, and on a\\n * schema missing whatever migration landed since — a suite grading a database nobody established.\\n */\\nexport async function resetLocalDatabase(target?: CliTarget): Promise<void> {\\n  const invocation = supabaseInvocation(target, ['db', 'reset', '--local']);\\n  const child = spawn(bunExecutable(), invocation.args, {\\n    cwd: invocation.cwd,\\n    env: invocation.env,\\n    // progress is worth watching (a reset replays every migration); stderr is captured so a\\n    // failure can be reported in our own words rather than scrolling past.\\n    stdio: ['ignore', 'inherit', 'pipe'],\\n  });\\n\\n  let stderr = '';\\n  child.stderr?.on('data', (chunk: Buffer) => {\\n    stderr = (stderr + chunk.toString('utf8')).slice(-8000);\\n  });\\n\\n  let timedOut = false;\\n  const timer = setTimeout(() => {\\n    timedOut = true;\\n    // Kill the TREE: the CLI shells out to the container runtime, and killing only the parent\\n    // leaves a migration running against the database this run is about to test.\\n    if (child.pid && process.platform === 'win32') spawnSync('taskkill', ['/PID', String(child.pid), '/T', '/F'], { stdio: 'ignore' });\\n    else child.kill('SIGKILL');\\n  }, RESET_TIMEOUT_MS);\\n\\n  try {\\n    await new Promise<void>((resolve, reject) => {\\n      child.once('error', (err) => {\\n        const e = err as NodeJS.ErrnoException;\\n        reject(new Error(`the reset process could not be launched (${e.code ?? 'spawn error'}): ${diagnostic(e.message)}`));\\n      });\\n      child.once('close', (code, signal) => {\\n        if (timedOut) {\\n          reject(new Error(`the reset did not finish within ${Math.round(RESET_TIMEOUT_MS / 1000)}s and its process tree was killed`));\\n        } else if (code === 0) {\\n          resolve();\\n        } else {\\n          const how = code === null ? `was killed by signal ${signal}` : `exited ${code}`;\\n          reject(new Error(`\\\\`supabase db reset\\\\` ${how}: ${diagnostic(stderr) || '(no error output)'}`));\\n        }\\n      });\\n    });\\n  } finally {\\n    clearTimeout(timer);\\n  }\\n}\\n\\n/* --------------------------------------------------------------------------- vitest json shape */\\n\\nexport interface AssertionResult {\\n  title?: string;\\n  fullName?: string;\\n  status?: string;\\n  failureMessages?: string[];\\n}\\n\\n/**\\n * The report's own arithmetic, alongside the per-test results. `--expect` needs both: the id\\n * parser only sees tests whose titles carry an AT id, so an untagged `it()` that fails is\\n * invisible to it and visible in these counts. Optional because this describes a file on disk —\\n * a missing field is validated at runtime (see `reportAccountingDeviations`), not asserted here.\\n */\\ninterface VitestJson {\\n  /**\\n   * One entry per test FILE. `status` and `message` are kept alongside the assertions because a\\n   * file that fails to import, or whose hook throws, changes no test's status: that failure is\\n   * visible here and nowhere else in the report.\\n   */\\n  testResults?: { name?: string; status?: string; message?: string; assertionResults?: AssertionResult[] }[];\\n  numTotalTests?: number;\\n  numPassedTests?: number;\\n  numFailedTests?: number;\\n  numPendingTests?: number;\\n  numTodoTests?: number;\\n  success?: boolean;\\n}\\n\\nexport interface IdRow {\\n  id: string;\\n  status: 'green' | 'red' | 'missing';\\n  detail: string;\\n}\\n\\nexport interface RuntimeRegistration {\\n  atId: string;\\n  title: string;\\n  surface: string;\\n}\\n\\nexport interface ReportAnalysis {\\n  rows: IdRow[];\\n  unexpected: string[];\\n}\\n\\nfunction assertionId(assertion: AssertionResult): string | null {\\n  return /^(AT-[\\\\d.]+[a-z]?)\\\\s+—/.exec(assertion.title ?? assertion.fullName ?? '')?.[1] ?? null;\\n}\\n\\nexport function analyzeReportedTests(\\n  expected: string[],\\n  registrations: RuntimeRegistration[],\\n  assertions: AssertionResult[],\\n): ReportAnalysis {\\n  const registrationGroups = new Map<string, RuntimeRegistration[]>();\\n  for (const registration of registrations) {\\n    const group = registrationGroups.get(registration.atId) ?? [];\\n    group.push(registration);\\n    registrationGroups.set(registration.atId, group);\\n  }\\n\\n  const assertionGroups = new Map<string, AssertionResult[]>();\\n  for (const assertion of assertions) {\\n    const id = assertionId(assertion);\\n    if (!id) continue;\\n    const group = assertionGroups.get(id) ?? [];\\n    group.push(assertion);\\n    assertionGroups.set(id, group);\\n  }\\n\\n  const rows: IdRow[] = expected.map((id) => {\\n    const runtime = registrationGroups.get(id) ?? [];\\n    const results = assertionGroups.get(id) ?? [];\\n    if (runtime.length !== 1) {\\n      return {\\n        id,\\n        status: 'red',\\n        detail:\\n          runtime.length === 0\\n            ? 'no runtime registration emitted by atTest'\\n            : `${runtime.length} runtime registrations emitted by atTest; expected exactly 1`,\\n      };\\n    }\\n    if (results.length !== 1) {\\n      return {\\n        id,\\n        status: 'red',\\n        detail: `${results.length} Vitest results reported; expected exactly 1`,\\n      };\\n    }\\n\\n    const result = results[0];\\n    const expectedTitle = `${id} — ${runtime[0].title}`;\\n    if (result.title !== expectedTitle) {\\n      return {\\n        id,\\n        status: 'red',\\n        detail: `Vitest title ${JSON.stringify(result.title)} does not match runtime registration ${JSON.stringify(expectedTitle)}`,\\n      };\\n    }\\n    if (result.status !== 'passed') {\\n      return {\\n        id,\\n        status: 'red',\\n        detail: firstLine(result.failureMessages?.join('\\\\n'), `status \\\"${result.status}\\\"`),\\n      };\\n    }\\n    return { id, status: 'green', detail: runtime[0].title };\\n  });\\n\\n  const observed = new Set([...registrationGroups.keys(), ...assertionGroups.keys()]);\\n  const unexpected = [...observed].filter((id) => !expected.includes(id)).sort();\\n  return { rows, unexpected };\\n}\\n\\nfunction runtimeRegistrations(dir: string): RuntimeRegistration[] {\\n  const registrations: RuntimeRegistration[] = [];\\n  for (const file of readdirSync(dir, { withFileTypes: true })) {\\n    if (!file.isFile() || !file.name.endsWith('.jsonl')) continue;\\n    const lines = readFileSync(join(dir, file.name), 'utf8').split(/\\\\r?\\\\n/).filter(Boolean);\\n    for (const line of lines) registrations.push(JSON.parse(line) as RuntimeRegistration);\\n  }\\n  return registrations;\\n}\\n\\nexport interface ProcessOutcome {\\n  error?: unknown;\\n  status: number | null;\\n  signal?: NodeJS.Signals | null;\\n}\\n\\n/**\\n * The verdict is NOT \\\"did every row go green\\\". A vitest process can report twelve green\\n * assertions and still exit non-zero — a global teardown that threw, an unhandled rejection, a\\n * worker that died after its last test. Treating that as success is exactly the false green this\\n * harness exists to prevent, so the process's own exit is part of the verdict, and a discrepancy\\n * between green rows and a non-zero exit is called out rather than smoothed over.\\n */\\nexport function runVerdict(rows: IdRow[], unexpected: string[], run: ProcessOutcome): string[] {\\n  const problems: string[] = [];\\n  const red = rows.filter((r) => r.status === 'red').length;\\n  const missing = rows.filter((r) => r.status === 'missing').length;\\n\\n  if (red) problems.push(`${red} id${red === 1 ? '' : 's'} red`);\\n  if (missing) problems.push(`${missing} id${missing === 1 ? '' : 's'} missing`);\\n  if (unexpected.length) {\\n    problems.push(`${unexpected.length} registered id${unexpected.length === 1 ? '' : 's'} not P0 of this requirement`);\\n  }\\n\\n  if (run.error) {\\n    const err = run.error as NodeJS.ErrnoException;\\n    problems.push(`the test process could not be launched (${err.code ?? 'spawn error'}): ${diagnostic(err.message)}`);\\n  } else if (run.status !== 0) {\\n    const how = run.status === null ? `was killed by signal ${run.signal}` : `exited ${run.status}`;\\n    problems.push(\\n      red || missing\\n        ? `the test process ${how}`\\n        : `the test process ${how} even though every id reported green — something failed outside the ` +\\n            `assertions (a teardown, an unhandled rejection, a worker that died). This run is a FAILURE.`,\\n    );\\n  }\\n\\n  return problems;\\n}\\n\\n/**\\n * End-of-run housekeeping. The lock release lives in a `finally` of its OWN so that it cannot be\\n * skipped: on Windows, removing the report directory can throw EPERM while a file in it is still\\n * open, and if that throw escaped, the stack lock would be stranded and every later run would\\n * find a leftover it has to reason about. A lost temp directory is untidy; a stranded lock blocks\\n * work, so the release always wins and the cleanup failure is reported instead of hidden.\\n */\\nexport function cleanupRun(reportDir: string, lock: { release(): void } | null): void {\\n  try {\\n    rmSync(reportDir, { recursive: true, force: true });\\n  } catch (err) {\\n    console.error(`at:verify — could not remove the report directory ${reportDir}: ${diagnostic((err as Error).message)}`);\\n  } finally {\\n    lock?.release();\\n  }\\n}\\n\\nfunction firstLine(text: string | undefined, fallback: string): string {\\n  const line = redact(text ?? '')\\n    .split('\\\\n')\\n    .map((l) => l.trim())\\n    .find((l) => l.length > 0);\\n  return line ?? fallback;\\n}\\n\\n/* --------------------------------------------------------------------------------------- main */\\n\\nasync function main(argv: string[]): Promise<number> {\\n  let args: Args;\\n  try {\\n    args = parseArgs(argv);\\n  } catch (err) {\\n    console.error(`at:verify — ${(err as Error).message}`);\\n    console.error(USAGE);\\n    return 2;\\n  }\\n\\n  const { requirement, tier, wired, expectDeclared } = args;\\n\\n  if (wired) {\\n    console.error(\\n      `at:verify req-${requirement} --wired — the screen driver does not exist yet. Wired re-runs ` +\\n        `drive the ui-marked ids through real screens; that driver is a later AI4DEV-3 slice, so ` +\\n        `there is nothing to re-run against and a silent fixture run would be a false green.`,\\n    );\\n    return 3;\\n  }\\n\\n  const dir = suiteDir(requirement);\\n  if (!existsSync(dir)) {\\n    console.error(`at:verify req-${requirement} — no suite at ${dir}`);\\n    return 2;\\n  }\\n\\n  let expected: string[];\\n  try {\\n    const preflight = inspectBijection(requirement);\\n    expected = preflight.expected;\\n    if (preflight.problems.length) {\\n      console.error(`at:verify req-${requirement} — AT↔code preflight refused the run: ${preflight.problems.join('; ')}`);\\n      return 2;\\n    }\\n  } catch (err) {\\n    console.error(`at:verify req-${requirement} — ${(err as Error).message}`);\\n    return 2;\\n  }\\n\\n  // The declaration preflight sits HERE for two reasons, both load-bearing. It needs the\\n  // acceptance file's P0 id set, which only exists after the bijection preflight above; and every\\n  // refusal must run NO tests, so it must precede the vitest spawn. Placing it before the stack\\n  // sequence as well means a bad declaration never takes the machine-wide lock, never talks to\\n  // Docker and never resets a database — the refusal costs nothing at any tier.\\n  let expectation: TierExpectation | null = null;\\n  if (expectDeclared) {\\n    try {\\n      expectation = loadTierExpectation(requirement, tier, expected);\\n    } catch (err) {\\n      console.error(`at:verify req-${requirement} --tier ${tier} --expect — DECLARATION REFUSED: ${(err as Error).message}`);\",\"lineStart\":1,\"lineEnd\":1194,\"totalLines\":1195,\"truncated\":true}},\"title\":\"tests\\\\at\\\\harness\\\\runner.ts\",\"time\":{\"start\":1786349870370,\"end\":1786349870390}},\"id\":\"prt_feabfdc17001zJgaHkKR53f6Io\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"messageID\":\"msg_feabfa15c001HaL0Lu1Rq80kHK\"}}\r\n+{\"type\":\"text\",\"timestamp\":1786349870511,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feabfdb1d001ftMF80t1Ex8dTr\",\"messageID\":\"msg_feabfa15c001HaL0Lu1Rq80kHK\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"type\":\"text\",\"text\":\"Now let me read the runner.ts — the shared seam, takeover policy, and the integration hook.\",\"time\":{\"start\":1786349869853,\"end\":1786349870507}}}\r\n+{\"type\":\"step_finish\",\"timestamp\":1786349870901,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feabfdf280013mYkXwD4UgyhkA\",\"reason\":\"tool-calls\",\"snapshot\":\"e7feb1bc624098c742c3768936fdbefb56ba090d\",\"messageID\":\"msg_feabfa15c001HaL0Lu1Rq80kHK\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"type\":\"step-finish\",\"tokens\":{\"total\":58391,\"input\":6959,\"output\":103,\"reasoning\":1921,\"cache\":{\"write\":0,\"read\":49408}},\"cost\":0.0008396612}}\r\n+{\"type\":\"step_start\",\"timestamp\":1786349873203,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feabfe82e001ftfYWySmCCt37P\",\"messageID\":\"msg_feabfe102001YSc6qNV0MQf28X\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"snapshot\":\"4473f0fda603534134c08bf1d8139406a47f1e05\",\"type\":\"step-start\"}}\r\n+{\"type\":\"tool_use\",\"timestamp\":1786349875271,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"type\":\"tool\",\"tool\":\"read\",\"callID