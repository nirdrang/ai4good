 573: /* --------------------------------------------------------------------------- the reservation */
 574: 
 575: export interface Reservation {
 576:   slot: number;
 577:   item: string;
 578:   branch: string;
 579:   at: string;
 580:   holder: string;
 581: }
 582: 
 583: /**
 584:  * The reservation as a VIEW reads it: anything this run cannot read is reported as nothing.
 585:  *
 586:  * This read is for rendering a picture of the pool, never for deciding whether a slot may be
 587:  * taken. A view that refuses to render is no safety. Decision paths use `readReservationStrict`.
 588:  */
 589: export function readReservation(slot: number): Reservation | null {
 590:   try {
 591:     return JSON.parse(readFileSync(reservationPath(slot), 'utf8')) as Reservation;
 592:   } catch {
 593:     return null;
 594:   }
 595: }
 596: 
 597: /** One second of small steps â€” thousands of times the write window, and the same remedy T1 uses. */
 598: const RESERVATION_READ_TRIES = 40;
 599: const RESERVATION_READ_STEP_MS = 25;
 600: 
 601: /** Bounded synchronous pause, the same shape `acquireStackLock` uses for the same window. */
 602: function pause(ms: number): void {
 603:   const until = Date.now() + ms;
 604:   while (Date.now() < until) {
 605:     /* spin */
 606:   }
 607: }
 608: 
 609: /**
 610:  * THE RESERVATION AS A DECISION PATH MUST READ IT (audit ruling A2).
 611:  *
 612:  * Three outcomes, and the middle one is the whole point:
 613:  *
 614:  *   - the file is ABSENT â€” there is no reservation, and the caller proceeds;
 615:  *   - the file EXISTS but this run cannot read or parse it â€” it waits out the write window and
 616:  *     reads again, because `Reserve-DbSlot` creates the file exclusively and fills it a moment
 617:  *     later, and in between the file exists and says nothing (measured on this machine, T10);
 618:  *   - the file is STILL unreadable after the wait â€” it REFUSES, naming the file. A reservation
 619:  *     nobody can read is not the same thing as no reservation, and treating it as absent lets a
 620:  *     run take a slot another item holds.
 621:  */
 622: export function readReservationStrict(slot: number): Reservation | null {
 623:   const path = reservationPath(slot);
 624:   for (let attempt = 0; attempt < RESERVATION_READ_TRIES; attempt++) {
 625:     if (attempt > 0) pause(RESERVATION_READ_STEP_MS);
 626:     let raw: string;
 627:     try {
 628:       raw = readFileSync(path, 'utf8');
 629:     } catch (err) {
 630:       if ((err as NodeJS.ErrnoException).code === 'ENOENT') return null;
 631:       continue; // present, and held by its writer â€” look again in a moment
 632:     }
 633:     if (raw.trim() === '') continue; // created, not yet filled
 634:     try {
 635:       return JSON.parse(raw) as Reservation;
 636:     } catch {
 637:       continue; // half written
 638:     }
 639:   }
 640:   throw new Error(
 641:     `refusing to decide about slot ${slot}: it holds a reservation at ${path} that this run cannot read after ` +
 642:       `${(RESERVATION_READ_TRIES * RESERVATION_READ_STEP_MS) / 1000} seconds of trying. A reservation nobody can read is ` +
 643:       `NOT the same thing as no reservation, and reading it as absent would let this run take a slot another item ` +
 644:       `holds. Nothing was done. Look at that file, and delete it by hand if no item holds this slot.`,
 645:   );
 646: }
 647: 
 648: /** The slot reserved for this item, or null. Derived from the file, never declared by a caller. */
 649: export function slotForItem(item: string): number | null {
 650:   for (let slot = 1; slot <= POOL_SIZE; slot++) {
 651:     if (readReservation(slot)?.item === item) return slot;
 652:   }
 653:   return null;
 654: }
 655: 
 656: /**
 657:  * The item id a branch names â€” a pure function over the branch string, and it FAILS CLOSED.
 658:  *
 659:  * Exactly one id, or it refuses naming the condition. Never the first match of several: a branch
 660:  * carrying two ids is a question about which item is being verified, and answering it by
 661:  * position would attach a run, a reservation and a database to the wrong item silently.
 662:  */
 663: export function itemFromBranch(branch: string): string {
 664:   const raw = String(branch ?? '').trim();
 665:   if (raw === '') throw new Error('the branch name is empty, so no item id can be derived from it');
 666:   if (raw === 'HEAD') throw new Error('HEAD is detached, so the branch names no item â€” check out the item branch, or set AT_DB_SLOT');
 667: 
 668:   const ids = [...new Set([...raw.matchAll(/\b(ai4dev|ai4pm)-(\d+)\b/gi)].map((match) => `${match[1].toUpperCase()}-${Number(match[2])}`))];
 669:   if (ids.length === 0) throw new Error(`the branch "${raw}" names no item id, so no reserved slot can be found for it`);
 670:   if (ids.length > 1) throw new Error(`the branch "${raw}" names ${ids.length} item ids (${ids.join(', ')}) â€” a person decides which one this run verifies`);
 671:   return ids[0];
 672: }
 673: 
 674: /** The branch this tree is on. A git failure refuses; it never falls back to a guess. */
 675: export function currentBranch(root: string = REPO_ROOT): string {
 676:   const res = spawnSync('git', ['-C', root, 'rev-parse', '--abbrev-ref', 'HEAD'], { encoding: 'utf8', env: childEnv() });
 677:   if (res.error) throw new Error(`git could not be run to read the current branch (${diagnostic((res.error as Error).message)})`);
 678:   if (res.status !== 0) throw new Error(`git could not report the current branch (exit ${res.status}): ${diagnostic(res.stderr) || '(no error output)'}`);
 679:   return (res.stdout ?? '').trim();
 680: }
 681: 
 682: /* ------------------------------------------------------------------------------- the pool view */
 683: 
 684: export interface PoolSlotView {
 685:   slot: number;
 686:   dir: string;
 687:   configured: boolean;
 688:   projectId: string | null;
 689:   apiPort: number | null;
 690:   dbPort: number | null;
 691:   reservation: Reservation | null;
 692:   occupiedBy: Holder | null;
 693: }
 694: 
 695: /** What the pool looks like right now â€” for the setup report, the helpers, and a person asking. */
 696: export function readPool(): PoolSlotView[] {
 697:   const views: PoolSlotView[] = [];
 698:   for (let slot = 1; slot <= POOL_SIZE; slot++) {
 699:     const dir = slotDir(slot);
 700:     let config: LocalConfig | null = null;
 701:     try {
 702:       config = readLocalConfig(dir);
 703:     } catch {
 704:       config = null;
 705:     }
 706:     // The claim is keyed on the slot's PERMANENT identity (ruling T6), so this read finds it even
 707:     // when the slot has no config yet and even after `prepare` has moved the slot's ports.
 708:     let occupiedBy: Holder | null = null;
 709:     try {
 710:       occupiedBy = JSON.parse(readFileSync(stackLockPath(slotClaimKey(slot)), 'utf8')) as Holder;
 711:     } catch {
 712:       occupiedBy = null;
 713:     }
 714:     views.push({
 715:       slot,
 716:       dir,
 717:       configured: config !== null,
 718:       projectId: config?.projectId ?? null,
 719:       apiPort: config?.apiPort ?? null,
 720:       dbPort: config?.dbPort ?? null,
 721:       reservation: readReservation(slot),
 722:       occupiedBy,
 723:     });
 724:   }
 725:   return views;
 726: }
 727: 
 728: /* ---------------------------------------------------------------------------------- occupancy */
 729: 
 730: export interface Occupancy {
 731:   slot: number;
 732:   dir: string;
 733:   config: LocalConfig;
 734:   /** The item this occupancy belongs to, or `null` when it came from the AT_DB_SLOT override. */
 735:   item: string | null;
 736:   via: 'reservation' | 'override';
 737:   claim: StackLock;
 738:   release(): void;
 739: }
 740: 
 741: export interface OccupyOptions {
 742:   /** The item id. Derived from the branch when absent. */
 743:   item?: string;
 744:   /** The AT_DB_SLOT override â€” for runs outside an item: the founder, the evidence gate, a spike. */
 745:   slot?: number;
 746: }
 747: 
 748: /**
 749:  * Take a slot for one verify window.
 750:  *
 751:  * ADMISSION CONTROL IS THE COORDINATOR'S, NOT THE RUNNER'S. A run whose item holds no reservation
 752:  * refuses and names the helper that makes one; it never falls back onto a free slot, because a
 753:  * silent fallback is how a pool of two quietly becomes a pool of one shared stack.
 754:  *
 755:  * The claim is the runner's existing stack lock, with the takeover policy the ruled text asks
 756:  * for: a DEAD holder pid is broken loudly, a live holder is never displaced at any age.
 757:  *
 758:  * THE OVERRIDE SKIPS ADMISSION CONTROL, NOT OWNERSHIP (ruling T5). `AT_DB_SLOT` is ruled â€” the
 759:  * founder, the evidence gate and the spike all use it â€” and slot STATE is disposable by design, so
 760:  * the reservation is not what protects a slot; the occupancy claim is, and the override keeps it.
 761:  * But taking a slot another item is holding is a silent collision and costs nothing to refuse, so
 762:  * an override run refuses loudly when the target slot's reservation names a DIFFERENT item than
 763:  * this run can derive. A run that can derive no item at all treats ANY reservation as foreign.
 764:  */
 765: export function occupy(requirement: string, options: OccupyOptions = {}): Occupancy {
 766:   let slot: number;
 767:   let item: string | null = null;
 768:   let via: 'reservation' | 'override';
 769: 
 770:   if (options.slot !== undefined) {
 771:     slot = assertSlotNumber(options.slot);
 772:     item = options.item ?? null;
 773:     via = 'override';
 774: 
 775:     let derived: string | null = options.item ?? null;
 776:     if (derived === null) {
 777:       try {
 778:         derived = itemFromBranch(currentBranch());
 779:       } catch {
 780:         derived = null; // no item derivable â€” every reservation is then somebody else's
 781:       }
 782:     }
 783:     // STRICT (ruling A2): an unreadable reservation refuses here rather than reading as absent.
 784:     const reserved = readReservationStrict(slot);
 785:     if (reserved && reserved.item !== derived) {
 786:       throw new Error(
 787:         `refusing to take slot ${slot} with AT_DB_SLOT: it is reserved for ${reserved.item} ` +
