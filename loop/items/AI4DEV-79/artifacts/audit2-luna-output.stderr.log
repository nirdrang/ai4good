xpectation) {\\n1339:       const verdict = runVerdict(rows, unexpected, run as ProcessOutcome);\\n1340:       if (verdict.length === 0) return 0;\\n1341:       for (const problem of verdict) console.log(`  FAILURE: ${problem}`);\\n1342:       return 1;\\n1343:     }\\n1344: \\n1345:     // Both deviation sets are computed and printed: an id-level and a report-level problem in the\\n1346:     // same run are two facts an author needs at once, and printing only the first costs a second\\n1347:     // run to find the second.\\n1348:     const deviations = [\\n1349:       ...expectationDeviations(rows, unexpected, expectation),\\n1350:       ...reportAccountingDeviations(report, run as ProcessOutcome, expectation),\\n1351:     ];\\n1352:     if (deviations.length === 0) {\\n1353:       console.log(\\n1354:         `  EXPECTED: the run matches ${expectedManifestPath(requirement)} exactly ` +\\n1355:           `(${expectation.green.length} declared green, ${Object.keys(expectation.red).length} declared red)`,\\n1356:       );\\n1357:       return 0;\\n1358:     }\\n1359:     for (const deviation of deviations) console.log(`  DEVIATION: ${deviation}`);\\n1360:     console.log(\\n1361:       `  EXPECT FAILURE: ${deviations.length} deviation(s) from the declaration. A red that turned green is a ` +\\n1362:         `failure too — if reality improved, update the declaration in the same change.`,\\n1363:     );\\n1364:     return 1;\\n1365:   } finally {\\n1366:     process.off('SIGINT', onSignal);\\n1367:     process.off('SIGTERM', onSignal);\\n1368:     cleanup();\\n1369:   }\\n1370: }\\n1371: \\n1372: if (import.meta.main) process.exit(await main(process.argv.slice(2)));\\n\\n(End of file - total 1372 lines)\\n</content>\",\"metadata\":{\"preview\":\"      console.error(`No tests were run. The declaration is the contract; fix ${expectedManifestPath(requirement)}.`);\\n      return 2;\\n    }\\n  }\\n\\n  const infra = (message: string): number => {\\n    console.error(`at:v