 103:   previousPool = process.env.AT_DB_POOL_ROOT;
 104:   previousLocks = process.env.AT_LOCK_DIR;
 105:   poolTemp = mkdtempSync(join(tmpdir(), 'at-db-pool-'));
 106:   lockTemp = mkdtempSync(join(tmpdir(), 'at-db-locks-'));
 107:   process.env.AT_DB_POOL_ROOT = poolTemp;
 108:   process.env.AT_LOCK_DIR = lockTemp;
 109: });
 110: 
 111: afterAll(() => {
 112:   if (previousPool === undefined) delete process.env.AT_DB_POOL_ROOT;
 113:   else process.env.AT_DB_POOL_ROOT = previousPool;
 114:   if (previousLocks === undefined) delete process.env.AT_LOCK_DIR;
 115:   else process.env.AT_LOCK_DIR = previousLocks;
 116:   rmSync(poolTemp, { recursive: true, force: true });
 117:   rmSync(lockTemp, { recursive: true, force: true });
 118: });
