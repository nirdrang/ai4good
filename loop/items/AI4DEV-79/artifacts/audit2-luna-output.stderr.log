 145: interface ConfigEntry {
 146:   line: number;
 147:   section: string;
 148:   key: string;
 149:   value: string;
 150: }
 151: 
 152: /**
 153:  * Every ACTIVE `key = value` in the file, with the section it sits in. Commented lines are not
 154:  * settings and are skipped â€” which is the whole reason the scan is section-aware rather than a
 155:  * set of regular expressions over the file: `port` appears in nine places and most of them are
 156:  * examples in comments.
 157:  *
 158:  * Multi-line array values are not read as one value. Nothing in this repo's config uses one, and
 159:  * a value this scanner cannot see is a value it never rewrites, so the failure mode is a config
 160:  * that is copied verbatim rather than one that is silently mis-edited.
 161:  */
 162: export function scanConfig(text: string): ConfigEntry[] {
 163:   const entries: ConfigEntry[] = [];
 164:   let section = '';
 165:   const lines = text.split('\n');
 166:   for (let index = 0; index < lines.length; index++) {
 167:     const line = lines[index].trim();
 168:     if (line.startsWith('#') || line === '') continue;
 169:     const header = /^\[([^\]]+)\]/.exec(line);
 170:     if (header) {
 171:       section = header[1];
 172:       continue;
 173:     }
 174:     const setting = /^([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)$/.exec(line);
 175:     if (setting) entries.push({ line: index, section, key: setting[1], value: setting[2].trim() });
 176:   }
 177:   return entries;
 178: }
 179: 
 180: function isPortKey(key: string): boolean {
 181:   return key === 'port' || key.endsWith('_port');
 182: }
 183: 
 184: /**
 185:  * A PORT VALUE, PARSED WHOLE (audit ruling A5).
 186:  *
 187:  * The rule is the ENTIRE value token, never a prefix of it. TOML writes an integer with optional
 188:  * underscores between digits, so `54_321` is a perfectly ordinary way to write a personal-block
 189:  * port â€” and a prefix parse reads it as `54`, which is in no band anybody checks. That is a hole
 190:  * in the wall's own guard, so the whole token must be an integer or this returns `null` and the
 191:  * caller treats the value as a PROBLEM.
 192:  *
 193:  * A trailing `# comment` is not part of the value and is dropped before the token is judged;
 194:  * anything else left beside the digits â€” quotes, an `env()` call, a second number â€” fails.
 195:  */
 196: function portValue(raw: string): number | null {
 197:   const token = raw.split('#')[0].trim();
 198:   if (!/^\d(?:_?\d)*$/.test(token)) return null;
 199:   return Number(token.replace(/_/g, ''));
 200: }
 201: 
 202: /**
 203:  * THE LOCAL STACK'S OWN LISTENER PORTS â€” the only ports a slot's identity moves (ruling E4).
 204:  *
 205:  * A `config.toml` holds two kinds of port. A LISTENER port is a socket this machine opens for
 206:  * this stack, so two stacks that share one collide, and the overlay must move it. A CLIENT port
 207:  * is part of an address of somebody else's service â€” `[auth.email.smtp] port = 587` is Postmark's
 208:  * port, not ours â€” so it is DATA, and moving it or refusing it would break a slot that is
 209:  * configured exactly like the tree it grades.
 210:  *
 211:  * The list is exact section + key pairs, so `[api] port` moves while `[api.tls] port` (were one
 212:  * added) does not silently inherit the rule.
 213:  */
 214: const LISTENER_PORTS: readonly { section: string; key: string }[] = [
 215:   { section: 'api', key: 'port' },
 216:   { section: 'db', key: 'port' },
 217:   { section: 'db', key: 'shadow_port' },
 218:   { section: 'db.pooler', key: 'port' },
 219:   { section: 'studio', key: 'port' },
 220:   { section: 'local_smtp', key: 'port' },
 221:   { section: 'local_smtp', key: 'smtp_port' },
 222:   { section: 'local_smtp', key: 'pop3_port' },
 223:   { section: 'analytics', key: 'port' },
 224:   { section: 'edge_runtime', key: 'inspector_port' },
 225: ];
 226: 
 227: function isListenerPort(section: string, key: string): boolean {
 228:   return LISTENER_PORTS.some((listener) => listener.section === section && listener.key === key);
 229: }
