1172:     startSlotStack(slot);
1173:     const proven: StartMarker = { configHash: hash, at: new Date().toISOString(), pid: process.pid };
1174:     writeFileSync(slotMarkerPath(slot), JSON.stringify(proven), 'utf8');
1175:   }
1176: 
1177:   // The identity read doubles as the prove-local check against the SLOT's config, and it is the
1178:   // same read the reset performs again for itself immediately before acting.
1179:   const read = proveSlotTarget(slot, 'prepare', itemRoot);
1180:   if (!read.status) {
1181:     throw new Error(`slot ${slot} reported no running stack (${read.notRunning}), so nothing was reset and nothing was run`);
1182:   }
1183:   const status = read.status;
1184: 
1185:   await waitForReady(status, `before the slot ${slot} reset`);
1186:   await resetSlotDatabase(slot, itemRoot);
1187:   await waitForReady(status, `after the slot ${slot} reset`);
1188:   const migrations = await proveMigrationsReplayed(status, itemRoot);
