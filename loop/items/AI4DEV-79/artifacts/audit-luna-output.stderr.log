67: /** Ruled: two standing slots. Concurrency IS the pool size. */
68: export const POOL_SIZE = 2;
69: 
70: /** The founder's personal stack. Nothing in the pool may carry any of these. */
71: const PERSONAL_PORT_LOW = 54320;
72: const PERSONAL_PORT_HIGH = 54329;
73: const PERSONAL_INSPECTOR_PORT = 8083;
74: 
75: /** The band a port must sit in for the slot overlay to know how to move it. */
76: const MAPPABLE_PORT_LOW = 54000;
77: const MAPPABLE_PORT_HIGH = 54999;
