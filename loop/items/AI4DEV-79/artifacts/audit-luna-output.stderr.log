993: /**
994:  * `db reset` on a slot. THE IDENTITY READ IS INSIDE, so no caller can reach the reset without it —
995:  * that is what "structurally on the destructive path" means, as opposed to a rule someone follows.
996:  */
997: export async function resetSlotDatabase(slot: number, itemRoot: string = REPO_ROOT): Promise<StackStatus> {
998:   // The BROAD guard first (rulings T7 and F1). D5's ruled sentence names "occupy, prepare, reset or
999:   // emit env", and this is an exported entry point a caller reaches directly — the spike does — so
1000:   // it runs the guard itself instead of trusting whoever called it to have run it.
1001:   refusePersonalSlotConfig(slot, itemRoot, 'reset');
1002:   const read = proveSlotTarget(slot, 'reset', itemRoot, true);
1003:   if (!read.status) {
1004:     throw new Error(
1005:       `refusing to reset slot ${slot}: it reported no running stack, so its identity could not be proven ` +
1006:         `(${read.notRunning}). Start the slot first; nothing was reset.`,
1007:     );
1008:   }
1009:   proveSlotDbContainer(slot, 'reset');
1010:   await resetLocalDatabase(slotTarget(slot));
1011:   return read.status;
1012: }
1013: 
1014: /** `stop` on a slot, behind the same guard and the same read. A slot with no stack has nothing to stop. */
1015: export function stopSlotStack(slot: number, itemRoot: string = REPO_ROOT): void {
1016:   refusePersonalSlotConfig(slot, itemRoot, 'stop');
1017:   const read = proveSlotTarget(slot, 'stop', itemRoot, true);
1018:   if (!read.status) {
1019:     console.log(`db-pool — slot ${slot} reported no running stack (${read.notRunning}); there is nothing to stop`);
1020:     return;
1021:   }
1022:   runSlotCli(slot, ['stop'], 'stop');
1023: }
1024: 
1025: /** `start` on a slot. Not destructive, and a stack that is down cannot be asked who it is first. */
1026: export function startSlotStack(slot: number): void {
1027:   runSlotCli(slot, ['start'], 'start');
1028: }
1029: 
1030: /**
1031:  * Make the slot's database be the item tree's database, and prove it.
1032:  *
1033:  * The order is load-bearing: mirror the tree, regenerate the identity-overlaid config, restart the
1034:  * stack IF the configuration it was started with has changed, then read the stack, prove it is
1035:  * local, wait for readiness, reset, wait again, and prove the migration set replayed.
1036:  *
1037:  * WHY A MARKER RATHER THAN THE FILE ITSELF decides the restart: the file says what the slot SHOULD
1038:  * be running; only a marker written after a successful start says what it IS running. A crash
1039:  * between writing the config and restarting would otherwise leave equal text over a stack still
1040:  * serving the old auth behaviour, and the next occupancy would trust it.
1041:  */
1042: export async function prepare(occupancy: Occupancy, itemRoot: string = REPO_ROOT): Promise<PrepareResult> {
1043:   const { slot, dir } = occupancy;
1044:   const sourceText = readFileSync(join(itemRoot, 'supabase', 'config.toml'), 'utf8');
1045:   const generated = generateSlotConfig(sourceText, slot);
1046: 
1047:   refusePersonal(generated, itemRoot, `prepare slot ${slot}`);
1048: 
1049:   const closure = pathClosureProblems(generated, itemRoot);
1050:   if (closure.length) {
1051:     throw new Error(
1052:       `slot ${slot} would start half-provisioned: ${closure.join('; ')}. No stack was started and nothing was reset.`,
1053:     );
1054:   }
1055: 
1056:   // THE MIRROR AND THE CONFIG WRITE ARE ONE STEP (ruling T11). The mirror excludes `config.toml`
1057:   // and removes the slot's copy, so between these two statements the slot has NO config — never the
1058:   // item tree's one, which carries the personal identity. A crash in the window leaves a slot with
1059:   // nothing, which `occupy` refuses loudly and one `setup` repairs. The write is unconditional:
1060:   // the mirror has just deleted whatever was there.
1061:   mirrorItemTree(itemRoot, slot);
1062:   const configPath = slotConfigPath(slot);
1063:   mkdirSync(join(dir, 'supabase'), { recursive: true });
1064:   writeFileSync(configPath, generated, 'utf8');
1065: 
1066:   const hash = hashConfig(generated);
1067:   const marker = readMarker(slot);
1068:   const restarted = marker?.configHash !== hash;
1069:   if (restarted) {
1070:     // The auth container reads config at START, not at reset, so a changed config that is not
1071:     // restarted into would grade the previous item's auth behaviour.
1072:     console.log(`at:verify — db slot ${slot} configuration changed since its last start; restarting the slot's stack`);
1073:     stopSlotStack(slot, itemRoot);
1074:     startSlotStack(slot);
1075:     const proven: StartMarker = { configHash: hash, at: new Date().toISOString(), pid: process.pid };
1076:     writeFileSync(slotMarkerPath(slot), JSON.stringify(proven), 'utf8');
1077:   }
1078: 
1079:   // The identity read doubles as the prove-local check against the SLOT's config, and it is the
1080:   // same read the reset performs again for itself immediately before acting.
1081:   const read = proveSlotTarget(slot, 'prepare', itemRoot);
1082:   if (!read.status) {
1083:     throw new Error(`slot ${slot} reported no running stack (${read.notRunning}), so nothing was reset and nothing was run`);
1084:   }
1085:   const status = read.status;
1086: 
1087:   await waitForReady(status, `before the slot ${slot} reset`);
1088:   await resetSlotDatabase(slot, itemRoot);
1089:   await waitForReady(status, `after the slot ${slot} reset`);
1090:   const migrations = await proveMigrationsReplayed(status, itemRoot);
1091: 
1092:   return { status, migrations, restarted };
1093: }
