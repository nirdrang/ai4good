872: /**
873:  * DOCKER'S OWN ANSWER, on the destructive path, every time (ruling T2).
874:  *
875:  * The CLI's status output is one instrument and it is coupled to the CLI's version. Docker is a
876:  * second, independent one: before a reset, docker must show this slot's OWN database container
877:  * running. A docker read is the only interaction anything here is permitted to have with the
878:  * founder's stack, and it is unrestricted on slots.
879:  *
880:  * It fails closed. If docker cannot be run, or reports no container of this slot's own, the reset
881:  * refuses: an instrument that cannot answer is not an answer of "yes".
882:  */
883: export function slotDbContainers(slot: number): string[] {
884:   const project = slotProjectId(slot);
885:   const res = spawnSync('docker', ['ps', '--filter', `name=supabase_db_${project}`, '--format', '{{.Names}}'], {
886:     env: childEnv(),
887:     encoding: 'utf8',
888:   });
889:   if (res.error) throw new Error(`docker could not be run to confirm slot ${slot}'s database container (${diagnostic((res.error as Error).message)})`);
890:   if (res.status !== 0) throw new Error(`\`docker ps\` exited ${res.status} while confirming slot ${slot}'s database container: ${diagnostic(res.stderr) || '(no error output)'}`);
891:   return (res.stdout ?? '')
892:     .split('\n')
893:     .map((line) => line.trim())
894:     .filter(Boolean);
895: }
