{\\n1231:     // THE DRILL TIER RESOLVES NO DATABASE. It used to reach the stack described by the repository's\\n1232:     // own `supabase/config.toml` — which is the founder's personal stack — and reset it. Nothing in\\n1233:     // this tree invokes the tier, so refusing costs nothing, and it closes the last path in the\\n1234:     // harness that could reset that stack. The item that decides drill's stack replaces this.\\n1235:     if (tier === 'drill') {\\n1236:       return infra(\\n1237:         `the drill tier's stack is not yet decided, so this tier resolves no database at all. It used ` +\\n1238:           `to reset the stack described by the repository's own supabase/config.toml, which is the ` +\\n1239:           `founder's personal stack, and that stack is untouchable.`,\\n1240:       );\\n1241:     }\\n1242: \\n1243:     if (tier === 'integration') {\\n1244:       // THE STACK IS RESOLVED ONLY THROUGH THE POOL. Occupy a slot, make its database be this\\n1245:       // tree's database, and hand the suite the slot's coordinates. The repo-configured stack is\\n1246:       // never read, never locked and never reset from here.\\n1247:       let occupancy: Occupancy;\\n1248:       try {\\n1249:         const override = process.env.AT_DB_SLOT?.trim();\\n1250:         occupancy = occupy(`req-${requirement}`, override ? { slot: Number(override) } : {});\\n1251:       } catch (err) {\\n1252:         return infra((err as Error).message);\\n1253:       }\\n1254:       // The claim goes into the SAME `lock` variable `cleanupRun` already releases, so the release\\n1255:       // stays in the one `finally` chain that exists rather than in a second one nobody can see.\\n1256:       lock = occupancy.claim;\\n1257: \\n1258:       let prepared: PrepareResult;\\n1259:       try {\\n1260:         // prepare() mirrors this tree into the slot, regenerates the slot's identity, proves the\\n1261:         // stack that answers is the slot's own, resets it, and proves the migration set replayed.\\n1262:         prepared = await prepare(occupancy);\\n1263:       } catch (err) {\\n1264:         return infra(\\n1265:           `slot ${occupancy.slot} could not be prepared: ${(err as Error).message}\\\\n` +\\n1266:             `The integration tier rebuilds its slot's database from supabase/migrations on every run, ` +\\n1267:             `so that a suite never grades leftover rows or a schema missing a migration; if that ` +\\n1268:             `rebuild fails, the state under test is unknown and the run stops here.\\\\n${stackHelp}`,\\n1269:         );\\n1270:       }\\n1271: \\n1272:       // The ruled evidence line: which slot, that the reset happened, and the migration state.\\n1273:       console.log(evidence(occupancy, prepared));\\n1274:       Object.assign(stackEnv, slotStackEnv(occupancy, prepared.status));\\n1275:     }\\n1276: \\n1277:     // The suites and their vitest root come from the DATA root; vitest itself comes from the\\n1278:     // install root, so a run pointed at a disposable tree still runs the pinned test framework.\\n1279:     const atRoot = join(REPO_ROOT, 'tests', 'at');\\n1280:     const outputFile = join(reportDir, 'vitest-report.json');\\n1281:     const rootOverride: Record<string, string> = {};\\n1282:     if (process.env.AT_REPO_ROOT?.trim()) rootOverride.AT_REPO_ROOT = process.env.AT_REPO_ROOT.trim();\\n1283: \\n1284:     const run = spawnSync(\\n1285:       bunExecutable(),\\n1286:       [\\n1287:         '--no-env-file',\\n1288:         join(INSTALL_ROOT, 'node_modules', 'vitest', 'vitest.mjs'),\\n1289:         'run',\\n1290:         '--root',\\n1291:         atRoot,\\n1292:         '--config',\\n1293:         join(atRoot, 'vitest.config.ts'),\\n1294:         '--reporter=json',\\n1295:         `--outputFile=${outputFile}`,\\n1296:         `suites/req-${requirement}/`,\\n1297:       ],\\n1298:       {\\n1299:         cwd: INSTALL_ROOT,\\n1300:         env: childEnv({ ...stackEnv, ...rootOverride, AT_TIER: 