374: /* ------------------------------------------------------------------------- the path closure */
375: 
376: /** Config settings whose value names a file or directory the stack has to be able to read. */
377: const PATH_KEYS = new Set([
378:   'sql_paths',
379:   'schema_paths',
380:   'content_path',
381:   'cert_path',
382:   'key_path',
383:   'signing_keys_path',
384:   'objects_path',
385:   'declarative_schema_path',
386: ]);
387: 
388: function stringValues(raw: string): string[] {
389:   const array = /^\[(.*)\]$/.exec(raw);
390:   const body = array ? array[1] : raw;
391:   return [...body.matchAll(/"([^"]*)"/g)].map((match) => match[1]).filter((value) => value.trim() !== '');
392: }
393: 
394: /**
395:  * Fail closed on what the config asks for but the mirror cannot deliver.
396:  *
397:  * `prepare` mirrors the item tree's whole `supabase/` directory into the slot, so every path
398:  * UNDER that directory is provided exactly as the item tree has it — present if present, absent
399:  * if absent. A configured path that is absent in the item tree is therefore not a problem: the
400:  * slot is then in the same state the repo-configured stack would be in, which is the state the
401:  * item asked for. (`[db.seed] sql_paths = ["./seed.sql"]` with no `seed.sql` in the tree is
402:  * exactly today's arrangement on the personal stack.)
403:  *
404:  * A path that points OUTSIDE `supabase/` is a different thing: the mirror cannot deliver it, so
405:  * the slot would start half-provisioned and grade against a file it does not have. That refuses
406:  * loudly and a person decides. The same applies to the two directories the mirror EXCLUDES
407:  * (`MIRROR_EXCLUSIONS`): a config that names a file inside the CLI's own runtime state is naming
408:  * something the slot will not have, so the closure stays honest about the exclusions.
409:  *
410:  * A VALUE THIS SCANNER CANNOT SEE REFUSES rather than passing. `scanConfig` reads one line per
411:  * setting, so a multi-line array — `sql_paths = [` on its own line — yields the value `[` and no
412:  * paths at all. For the OVERLAY an invisible value is harmless: it is copied verbatim. For the
413:  * CLOSURE it is a missed refusal, which is the failure this function exists to prevent.
414:  */
415: export function pathClosureProblems(configText: string, itemRoot: string): string[] {
416:   const problems: string[] = [];
417:   const base = resolve(join(itemRoot, 'supabase'));
418: 
419:   for (const entry of scanConfig(configText)) {
420:     if (!PATH_KEYS.has(entry.key)) continue;
421:     if (entry.value.startsWith('[') && !entry.value.includes(']')) {
422:       problems.push(
423:         `[${entry.section}] ${entry.key} opens an array that does not close on the same line, so this check ` +
424:           `cannot see the paths it names — write the value on one line (${entry.key} = ["./a.sql", "./b.sql"]) ` +
425:           `and run this again`,
426:       );
427:       continue;
428:     }
429:     for (const value of stringValues(entry.value)) {
430:       if (/^[a-z][a-z0-9+.-]*:\/\//i.test(value)) {
431:         problems.push(`[${entry.section}] ${entry.key} names "${value}", which is a URL rather than a file the slot can be given`);
432:         continue;
433:       }
434:       if (isAbsolute(value)) {
435:         problems.push(`[${entry.section}] ${entry.key} names the absolute path "${value}", which the slot mirror cannot reproduce`);
436:         continue;
437:       }
438:       const target = resolve(base, value);
439:       const inside = relative(base, target);
440:       if (inside.startsWith('..')) {
441:         problems.push(
442:           `[${entry.section}] ${entry.key} names "${value}", which is outside supabase/ — the slot mirror copies supabase/ ` +
443:             `and nothing else, so this file would be missing from the slot`,
444:         );
445:         continue;
446:       }
447:       const first = inside.split(/[\\/]/)[0];
448:       if (MIRROR_EXCLUSIONS.includes(first)) {
449:         problems.push(
450:           `[${entry.section}] ${entry.key} names "${value}", which resolves into supabase/${first} — the slot mirror ` +
451:             `deliberately does not copy that directory (it is the CLI's own runtime state about another stack), so ` +
452:             `this file would be missing from the slot`,
453:         );
454:       }
455:     }
456:   }
457: 
458:   return problems;
459: }
