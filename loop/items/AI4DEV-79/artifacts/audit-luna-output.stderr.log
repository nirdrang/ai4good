477: 
478: /**
479:  * Every symlink under a directory tree. A pre-copy scan, because a symlink is not a file the
480:  * mirror can reproduce: `cpSync` would copy it as a link, and the link points wherever it likes —
481:  * including straight back at the personal stack's own directory.
482:  */
483: function symlinksUnder(dir: string): string[] {
484:   const found: string[] = [];
485:   const walk = (current: string): void => {
486:     for (const entry of readdirSync(current, { withFileTypes: true })) {
487:       const full = join(current, entry.name);
488:       if (entry.isSymbolicLink()) {
489:         found.push(full);
490:         continue; // never follow it — that is the whole point
491:       }
492:       if (entry.isDirectory()) walk(full);
493:     }
494:   };
495:   walk(dir);
496:   return found;
