1215: /* ---------------------------------------------------------------------------------- spike CLI */
1216: 
1217: /**
1218:  * THE ISOLATION SPIKE, step S3 as amended by ruling E5 — a CLI entry of this module, never a
1219:  * hand-written script. The first spike WAS a hand-written script; it closed neither route the
1220:  * identity override travels by, and it destroyed the founder's personal database. So the thing
1221:  * that proves the wall is now the thing that IS the wall: every CLI call below goes through the
1222:  * same helper the runner uses.
1223:  *
1224:  * IT TOUCHES THE PERSONAL STACK NOT AT ALL. Its instrument for the personal stack is a docker-level
1225:  * identity snapshot — a read — taken before and after, and compared on identity fields only. The
1226:  * breach signature was RECREATION (a new container id, a new volume timestamp), so identity-field
1227:  * equality is the direct negative of the breach. Run state is excluded on purpose: one container
1228:  * (`vector`) restart-loops on all three stacks by itself.
1229:  *
1230:  * THE HOSTILE CONDITION IS MANDATORY. The spike refuses to run unless its own process carries

 succeeded in 921ms:
1231:  * `SUPABASE_PROJECT_ID=<the personal project id>` — the exact override that caused the incident.
1232:  * A pass therefore proves the helper closes the route WHILE the route is loaded, rather than
1233:  * proving the route happened to be empty that day.
1234:  */
1235: 
1236: /** bun's SQL client. Described here rather than imported: the runner keeps its own private copy. */
1237: interface BunSqlClient {
1238:   (strings: TemplateStringsArray, ...values: unknown[]): Promise<unknown>;
1239:   close(): Promise<void>;
1240: }
1241: type BunSqlCtor = new (url: string) => BunSqlClient;
1242: 
1243: /** A canary connection may only ever reach a slot; the personal block is refused at the socket. */
1244: async function withSlotSql<T>(slot: number, status: StackStatus, fn: (sql: BunSqlClient) => Promise<T>): Promise<T> {
1245:   const port = Number(new URL(status.dbUrl).port);
1246:   if (!Number.isFinite(port) || (port >= PERSONAL_PORT_LOW && port <= PERSONAL_PORT_HIGH)) {
1247:     throw new Error(`refusing to open a connection for slot ${slot}: port ${port} is inside the founder's personal port block`);
1248:   }
1249:   const SQL = (globalThis as { Bun?: { SQL?: BunSqlCtor } }).Bun?.SQL;
1250:   if (!SQL) throw new Error('this runtime has no SQL client (expected bun)');
1251:   const sql = new SQL(status.dbUrl);
1252:   try {
1253:     return await fn(sql);
1254:   } finally {
1255:     await sql.close().catch(() => undefined);
1256:   }
1257: }
1258: 
1259: /**
1260:  * DROP AND RECREATE, never `create table if not exists`: the first spike left a `spike_canary`
1261:  * table of its own shape in slot 1, and an insert against somebody else's columns fails on a
1262:  * constraint rather than writing the canary. The canary has to be this run's own table.
1263:  */
1264: async function writeCanary(slot: number, status: StackStatus, note: string): Promise<void> {
1265:   await withSlotSql(slot, status, async (sql) => {
1266:     await sql`drop table if exists public.spike_canary`;
1267:     await sql`create table public.spike_canary (note text)`;
1268:     await sql`insert into public.spike_canary (note) values (${note})`;
1269:   });
1270: }
1271: 
1272: /** The canary's note, or null when the table or the row is gone — which is what a reset does. */
1273: async function readCanary(slot: number, status: StackStatus): Promise<string | null> {
1274:   return withSlotSql(slot, status, async (sql) => {
1275:     try {
1276:       const rows = (await sql`select note from public.spike_canary`) as { note?: unknown }[];
1277:       return rows.length ? String(rows[0].note) : null;
1278:     } catch (err) {
1279:       const message = (err as Error).message ?? '';
1280:       if (/spike_canary/.test(message) && /does not exist/i.test(message)) return null;
1281:       throw err;
1282:     }
1283:   });
1284: }
