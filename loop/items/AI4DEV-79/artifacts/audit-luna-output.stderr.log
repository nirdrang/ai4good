648: /**
649:  * The status parser, separate from the invocation so that a caller which needs the RAW output for
650:  * its own checks (the slot pool's identity read) reads it once and parses the same result, rather
651:  * than running the CLI twice or keeping a second copy of this parser.
652:  */
653: export function parseStackStatus(res: CliResult): StackStatus {
654:   if (res.error) {
655:     const err = res.error as NodeJS.ErrnoException;
656:     throw new Error(`could not launch the Supabase CLI (${err.code ?? 'spawn error'}): ${diagnostic(err.message)}`);
657:   }
658: 
659:   const stdout = res.stdout ?? '';
660:   const open = stdout.indexOf('{');
661:   const close = stdout.lastIndexOf('}');
662:   if (open < 0 || close <= open) {
663:     throw new Error(
664:       `\`supabase status\` reported no JSON (exit ${res.status}${res.signal ? `, signal ${res.signal}` : ''}): ` +
665:         `${diagnostic(res.stderr) || '(no error output)'}`,
666:     );
667:   }
668: 
669:   // The CLI exits non-zero merely because config.toml disables imgproxy and the pooler. That is
670:   // not a failure; anything ELSE reported stopped is.
671:   const notice = `${stdout.slice(0, open)}\n${res.stderr ?? ''}`;
672:   const stopped = /Stopped services:\s*\[([^\]]*)\]/.exec(notice)?.[1] ?? '';
673:   const unexpectedStopped = stopped.split(/\s+/).filter((name) => name && !DISABLED_SERVICES.test(name));
674:   if (unexpectedStopped.length) {
675:     throw new Error(`the stack reports stopped services: ${unexpectedStopped.join(', ')} — start them before running the suite`);
676:   }
677: 
678:   let parsed: Record<string, unknown>;
679:   try {
680:     parsed = JSON.parse(stdout.slice(open, close + 1)) as Record<string, unknown>;
681:   } catch (err) {
682:     throw new Error(`\`supabase status\` produced unparseable JSON: ${(err as Error).message}`);
683:   }
684: 
685:   const status: Partial<StackStatus> = {};
686:   const missing: string[] = [];
687:   for (const [field, key] of Object.entries(REQUIRED_STATUS_FIELDS) as [keyof StackStatus, string][]) {
688:     const value = parsed[key];
689:     if (typeof value !== 'string' || value.trim() === '') missing.push(key);
690:     else status[field] = value;
691:   }
692:   if (missing.length) throw new Error(`\`supabase status\` reported no ${missing.join(', no ')}`);
693:   return status as StackStatus;
694: }
