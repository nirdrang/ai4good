846: /**
847:  * The Supabase container names in a piece of CLI output that DO belong to this slot — the positive
848:  * half of the same instrument (ruling T2).
849:  *
850:  * MEASURED BEFORE THIS WAS WRITTEN, 2026-08-10, read-only, both slots: `status -o json` through the
851:  * shared helper prints exactly two such tokens on stderr —
852:  * `Stopped services: [supabase_imgproxy_ai4good-slot-N supabase_pooler_ai4good-slot-N]` — and zero
853:  * tokens that belong to any other project. So the evidence this check demands is evidence the CLI
854:  * really does produce.
855:  *
856:  * Absence is not innocence: `foreignContainerNames` finds nothing in an output that names no
857:  * container at all, which is exactly the hybrid shape the 2026-08-09 incident wore (the slot's
858:  * ports beside another project's containers). A destructive act therefore requires at least one
859:  * name that IS this slot's, never merely the lack of one that is not.
860:  *
861:  * Residual, recorded rather than hidden: those two tokens exist because the tracked config disables
862:  * imgproxy and the pooler. A config that enables both would print no "Stopped services" line, this
863:  * check would find no evidence, and the destructive act would REFUSE. That is the fail-closed
864:  * direction (ruling E7) and it is loud, but it is a real coupling to the config and to the pinned
865:  * CLI's output shape (residual F4 in the plan).
866:  */
867: export function ownContainerNames(text: string, slotProject: string): string[] {
868:   const names = [...String(text ?? '').matchAll(/\bsupabase_[A-Za-z0-9][A-Za-z0-9_.-]*/g)].map((match) => match[0]);
869:   return [...new Set(names.filter((name) => name.endsWith(`_${slotProject}`)))];
870: }
