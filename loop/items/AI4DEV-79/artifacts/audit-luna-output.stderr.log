1097: /**
1098:  * The coordinates a suite is allowed to see. Nothing else about the slot travels into the child,
1099:  * and the personal guard runs here too: env is how a stack reaches a test, so emitting the wrong
1100:  * one is as destructive as resetting the wrong one.
1101:  *
1102:  * TWO CHECKS, and they see different things (rulings T7 and F1). The broad guard reads the slot's
1103:  * CONFIG, which is where a personal identity would arrive from; the inline checks below read the
1104:  * STATUS, which is what actually answered, and the config guard cannot see that.
1105:  */
1106: export function stackEnv(occupancy: Occupancy, status: StackStatus, itemRoot: string = REPO_ROOT): Record<string, string> {
1107:   refusePersonalSlotConfig(occupancy.slot, itemRoot, 'emit the coordinates of');
1108: 
1109:   for (const [label, raw] of [
1110:     ['AT_SUPABASE_URL', status.apiUrl],
1111:     ['AT_SUPABASE_DB_URL', status.dbUrl],
1112:   ] as const) {
1113:     const port = Number(new URL(raw).port);
1114:     if (port >= PERSONAL_PORT_LOW && port <= PERSONAL_PORT_HIGH) {
1115:       throw new Error(`refusing to emit ${label}: it points at port ${port}, inside the founder's personal stack's port block`);
1116:     }
1117:   }
1118:   if (occupancy.config.projectId === personalProjectId()) {
1119:     throw new Error(`refusing to emit slot ${occupancy.slot}'s coordinates: its project id is the personal stack's`);
1120:   }
1121:   return {
1122:     AT_SUPABASE_URL: status.apiUrl,
1123:     AT_SUPABASE_DB_URL: status.dbUrl,
1124:     AT_SUPABASE_ANON_KEY: status.anonKey,
1125:     AT_SUPABASE_SERVICE_ROLE_KEY: status.serviceRoleKey,
1126:   };
1127: }
