1210: /** The database URL carries the password. Print the coordinates, never the credential. */
1211: function redactDbUrl(url: string): string {
1212:   return url.replace(/(postgres(?:ql)?:\/\/)[^@\s/]+@/i, '$1<redacted>@');
1213: }
