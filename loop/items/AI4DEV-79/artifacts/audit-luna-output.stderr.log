1286: function dockerLines(args: string[]): string[] {
1287:   const res = spawnSync('docker', args, { env: childEnv(), encoding: 'utf8' });
1288:   if (res.error) throw new Error(`docker could not be run (${diagnostic((res.error as Error).message)})`);
1289:   if (res.status !== 0) throw new Error(`\`docker ${args.slice(0, 2).join(' ')}\` exited ${res.status}: ${diagnostic(res.stderr) || '(no error output)'}`);
1290:   return (res.stdout ?? '')
1291:     .split('\n')
1292:     .map((line) => line.trim())
1293:     .filter(Boolean);
1294: }
1295: 
1296: interface DockerSnapshot {
1297:   containers: string[];
1298:   volumes: string[];
1299: }
1300: 
1301: /**
1302:  * A READ-ONLY identity record of the personal stack's docker objects. Only `ps`, `inspect`,
1303:  * `volume ls` and `volume inspect` are used, and only identity fields are recorded: container id,
1304:  * created timestamp, image and port bindings; volume name and CreatedAt. No run state.
1305:  */
1306: function personalDockerSnapshot(personal: string): DockerSnapshot {
1307:   const containerNames = dockerLines(['ps', '-a', '--filter', `name=${personal}`, '--format', '{{.Names}}']).sort();
1308:   const containers = containerNames.length
1309:     ? dockerLines([
1310:         'inspect',
1311:         '--format',
1312:         '{{.Name}} | id {{.Id}} | created {{.Created}} | image {{.Config.Image}} | ports {{json .HostConfig.PortBindings}}',
1313:         ...containerNames,
1314:       ]).sort()
1315:     : [];
1316:   const volumeNames = dockerLines(['volume', 'ls', '--filter', `name=${personal}`, '--format', '{{.Name}}']).sort();
1317:   const volumes = volumeNames.length
1318:     ? dockerLines(['volume', 'inspect', '--format', '{{.Name}} | created {{.CreatedAt}}', ...volumeNames]).sort()
1319:     : [];
1320:   return { containers, volumes };
1321: }
1322: 
1323: function snapshotDifferences(before: DockerSnapshot, after: DockerSnapshot): string[] {
1324:   const differences: string[] = [];
1325:   const pairs = [
1326:     ['container', before.containers, after.containers],
1327:     ['volume', before.volumes, after.volumes],
1328:   ] as const;
1329:   for (const [what, first, second] of pairs) {
1330:     for (const line of first) if (!second.includes(line)) differences.push(`${what} recorded BEFORE and not after: ${line}`);
1331:     for (const line of second) if (!first.includes(line)) differences.push(`${what} recorded AFTER and not before: ${line}`);
1332:   }
1333:   return differences;
1334: }
1335: 
1336: function gitHead(): string {
1337:   const res = spawnSync('git', ['-C', REPO_ROOT, 'rev-parse', 'HEAD'], { encoding: 'utf8', env: childEnv() });
1338:   return (res.stdout ?? '').trim() || '(git could not report the head)';
1339: }
