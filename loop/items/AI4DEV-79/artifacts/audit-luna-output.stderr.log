601: export function supabaseInvocation(target: CliTarget | undefined, args: string[]): CliInvocation {
602:   if (!target) return { args: supabaseArgs(...args), cwd: REPO_ROOT, env: childEnv() };
603: 
604:   const env = childEnv({ SUPABASE_PROJECT_ID: target.projectId });
605:   const foreign = Object.keys(env).filter((name) => /^SUPABASE_/i.test(name) && name.toUpperCase() !== 'SUPABASE_PROJECT_ID');
606:   if (foreign.length) {
607:     throw new Error(
608:       `refusing to run the Supabase CLI against ${target.projectId}: the child environment would also carry ` +
609:         `${foreign.join(', ')}, and a second SUPABASE_* variable can override the identity this invocation states.`,
610:     );
611:   }
612:   if (env.SUPABASE_PROJECT_ID !== target.projectId) {
613:     throw new Error(`refusing to run the Supabase CLI: SUPABASE_PROJECT_ID would not be "${target.projectId}"`);
614:   }
615:   return { args: supabaseArgs('--workdir', target.workdir, ...args), cwd: target.workdir, env };
616: }
