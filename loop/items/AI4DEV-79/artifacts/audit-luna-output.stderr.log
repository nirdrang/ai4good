911: export interface SlotIdentityRead {
912:   /** The stack's own report, when a stack answered. */
913:   status: StackStatus | null;
914:   /** Why no stack answered, when none did. Never a mismatch — a mismatch throws. */
915:   notRunning: string | null;
916: }
917: 
918: /**
919:  * THE PRE-DESTRUCTIVE IDENTITY READ (ruling E1, decision D13).
920:  *
921:  * Before anything destructive, the CLI is asked — through the same helper, so the read and the
922:  * destructive act resolve identically — to say what it resolves. Three things must hold, and any
923:  * one of them failing refuses loudly and does nothing:
924:  *
925:  *   1. every Supabase container name in the output belongs to this slot's project;
926:  *   2. the founder's personal project id appears nowhere in the output;
927:  *   3. the ports and keys the stack reports are the slot's own, loopback, locally issued
928:  *      (`localStackProblems`, against the SLOT's config).
929:  *
930:  * A DESTRUCTIVE act adds a fourth, and it is the one that closes the vacuous pass (ruling T2):
931:  *
932:  *   4. at least one Supabase container name in the output IS this slot's own.
933:  *
934:  * The first three can all hold over an output that names no container at all, and an output that
935:  * names no container is precisely what the 2026-08-09 hybrid produced when it reported the slot's
936:  * ports while resolving another project. Absence of contrary evidence is not identity.
937:  *
938:  * A stack that is simply not running is not a mismatch: it is reported as `notRunning` so the
939:  * caller can decide (there is nothing to stop), and only a real disagreement throws.
940:  */
941: export function proveSlotTarget(slot: number, act: string, itemRoot: string = REPO_ROOT, destructive = false): SlotIdentityRead {
942:   const project = slotProjectId(slot);
943:   const res: CliResult = runSupabaseCli(slotTarget(slot), ['status', '-o', 'json']);
944:   if (res.error) {
945:     throw new Error(`refusing to ${act} slot ${slot}: the Supabase CLI could not be launched to read its identity (${diagnostic(res.error.message)})`);
946:   }
947: 
948:   const raw = `${res.stdout}\n${res.stderr}`;
949:   const personal = personalProjectId(itemRoot);
950:   const foreign = foreignContainerNames(raw, project);
951:   const carriesPersonal = personal !== '' && raw.includes(personal);
952:   if (foreign.length || carriesPersonal) {
953:     throw new Error(
954:       `REFUSING TO ${act.toUpperCase()} SLOT ${slot}: the identity read did not resolve to ${project}. ` +
955:         (foreign.length ? `The CLI named ${foreign.join(', ')}. ` : '') +
956:         (carriesPersonal ? `The founder's personal project id appears in the output. ` : '') +
957:         `Nothing was done.`,
958:     );
959:   }
960: 
961:   let status: StackStatus;
962:   try {
963:     status = parseStackStatus(res);
964:   } catch (err) {
965:     return { status: null, notRunning: diagnostic((err as Error).message) };
966:   }
967: 
968:   const config = readLocalConfig(slotDir(slot));
969:   const problems = localStackProblems(status, config);
970:   if (problems.length) {
971:     throw new Error(
972:       `REFUSING TO ${act.toUpperCase()} SLOT ${slot}: the stack that answered is not provably slot ${slot}'s own. ` +
973:         `Failed checks: ${problems.join('; ')}. (Values are deliberately not printed.) Nothing was done.`,
974:     );
975:   }
976: 
977:   const own = ownContainerNames(raw, project);
978:   if (destructive && own.length === 0) {
979:     throw new Error(
980:       `REFUSING TO ${act.toUpperCase()} SLOT ${slot}: the identity read names no container belonging to ${project}, ` +
981:         `so it carries no positive evidence of which project the CLI resolved. The ports alone are not identity — ` +
982:         `the 2026-08-09 incident reported the right ports while resolving another project. Nothing was done.`,
983:     );
984:   }
985: 
986:   console.log(
987:     `db-pool — slot ${slot} identity proven before the ${act}: project ${project}, api ${config.apiPort}, db ${config.dbPort}` +
988:       (own.length ? `, containers ${own.join(', ')}` : ''),
989:   );
990:   return { status, notRunning: null };
991: }
