463: /**
464:  * What the mirror does NOT carry into a slot (rulings T3, F3 and T11). Top-level entries of
465:  * `supabase/` only, so the list cannot quietly grow into a filter on file names.
466:  *
467:  *   - `.temp` and `.branches` are the CLI's OWN RUNTIME STATE, not project source. `.temp` holds
468:  *     the CLI's record of the stack it last ran — the founder's personal one — and `.gitignore`
469:  *     itself says its `start-secrets/**` "must NEVER be committed". Copying it carries another
470:  *     stack's identity residue and its secrets into every slot.
471:  *   - `config.toml` is the slot's IDENTITY, and the item tree's copy carries the personal
472:  *     identity. Excluding it means no slot config ever holds that identity, not even for the
473:  *     instant between the mirror and the regenerated write — and a crash in that instant leaves
474:  *     NO config rather than a personal one.
475:  */
476: export const MIRROR_EXCLUSIONS: readonly string[] = ['.temp', '.branches', 'config.toml'];
477: 
478: /**
479:  * Every symlink under a directory tree. A pre-copy scan, because a symlink is not a file the
480:  * mirror can reproduce: `cpSync` would copy it as a link, and the link points wherever it likes —
481:  * including straight back at the personal stack's own directory.
482:  */
483: function symlinksUnder(dir: string): string[] {
484:   const found: string[] = [];
485:   const walk = (current: string): void => {
486:     for (const entry of readdirSync(current, { withFileTypes: true })) {
487:       const full = join(current, entry.name);
488:       if (entry.isSymbolicLink()) {
489:         found.push(full);
490:         continue; // never follow it — that is the whole point
491:       }
492:       if (entry.isDirectory()) walk(full);
493:     }
494:   };
495:   walk(dir);
496:   return found;
497: }
498: 
499: /**
500:  * Copy the item tree's `supabase/` into the slot, having first removed the slot's copy.
501:  *
502:  * DELETE THEN COPY, never merge: the previous holder's leftover migration or leftover function is
503:  * exactly the state this pool exists to make impossible.
504:  *
505:  * THE PROJECT SOURCE ENTIRE, and nothing else (ruling E3 as narrowed by T3, F3 and T11). Every
506:  * path the config names under `supabase/` arrives in the slot exactly as the item tree has it —
507:  * present if present, absent if absent — and `pathClosureProblems` refuses any config path that
508:  * names one of the three excluded entries, so the closure guarantee stays honest about them.
509:  * (`README.md` and `.gitkeep` therefore travel into the slot's `migrations/` too. The CLI reads
510:  * only `<timestamp>_name.sql` there, and the runner's migration proof counts exactly those.)
511:  *
512:  * A SYMLINK ANYWHERE UNDER `supabase/` REFUSES THE WHOLE MIRROR (ruling T13). The tree carries
513:  * none today, so nothing breaks; one smuggled in later refuses loudly instead of being copied as
514:  * a link into a directory the pool then resets.
515:  */
516: export function mirrorItemTree(itemRoot: string, slot: number): void {
517:   const source = join(itemRoot, 'supabase');
518:   const destination = join(slotDir(slot), 'supabase');
519:   if (!existsSync(source)) throw new Error(`${source} does not exist — there is no project to give the slot`);
520: 
521:   const links = symlinksUnder(source);
522:   if (links.length) {
523:     throw new Error(
524:       `refusing to mirror ${source} into slot ${slot}: it contains ${links.length} symlink(s) — ${links.join(', ')}. ` +
525:         `A symlink is not a file the mirror can reproduce, and a link copied into a slot points wherever it likes, ` +
526:         `including outside the pool. Replace them with real files, or decide by hand. Nothing was copied.`,
527:     );
528:   }
529: 
530:   rmSync(destination, { recursive: true, force: true });
531:   mkdirSync(destination, { recursive: true });
532:   cpSync(source, destination, {
533:     recursive: true,
534:     filter: (from: string) => {
535:       const inside = relative(source, from);
536:       if (inside === '') return true;
537:       return !MIRROR_EXCLUSIONS.includes(inside.split(/[\\/]/)[0]);
538:     },
539:   });
540: }
