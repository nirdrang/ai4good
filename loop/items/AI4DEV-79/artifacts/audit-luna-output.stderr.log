:\\\"http://127.0.0.1:54321/graphql/v1\\\",\\\"FUNCTIONS_URL\\\":\\\"http://127.0.0.1:54321/functions/v1\\\",\\\"MCP_URL\\\":\\\"http://127.0.0.1:54321/mcp\\\",\\\"STUDIO_URL\\\":\\\"http://127.0.0.1:54323\\\",\\\"PUBLISHABLE_KEY\\\":\\\"<redacted-key>\\\",\\\"SECRET_KEY\\\":\\\"<redacted-key>\\\",\\\"JWT_SECRET\\\":\\\"<redacted>\\\",\\\"ANON_KEY\\\":\\\"<redacted-jwt>\\\",\\\"SERVICE_ROLE_KEY\\\":\\\"<redacted-jwt>\\\",\\\"MAILPIT_URL\\\":\\\"http://127.0.0.1:54324\\\",\\\"INBUCKET_URL\\\":\\\"http://127.0.0.1:54324\\\",\\\"STORAGE_S3_URL\\\":\\\"http://127.0.0.1:54321/storage/v1/s3\\\",\\\"S3_PROTOCOL_ACCESS_KEY_ID\\\":\\\"<redacted>\\\",\\\"S3_PROTOCOL_ACCESS_KEY_SECRET\\\":\\\"<redacted>\\\",\\\"S3_PROTOCOL_REGION\\\":\\\"local\\\",\\\"message\\\":\\\"\\\"}\\n\\n=== containers running AFTER setup ===\\nai4good-runner | Up 3 days\\nsupabase_analytics_ai4good-slot-1 | Up About a minute (healthy)\\nsupabase_analytics_ai4good-slot-2 | Up 25 seconds (healthy)\\nsupabase_analytics_poancmeitlmxejofwzuu | Up 7 hours (healthy)\\nsupabase_auth_ai4good-slot-1 | Up About a minute (healthy)\\nsupabase_auth_ai4good-slot-2 | Up 23 seconds (healthy)\\nsupabase_auth_poancmeitlmxejofwzuu | Up 7 hours (healthy)\\nsupabase_db_ai4good-slot-1 | Up About a minute (healthy)\\nsupabase_db_ai4good-slot-2 | Up 46 seconds (healthy)\\nsupabase_db_poancmeitlmxejofwzuu | Up 7 hours (healthy)\\nsupabase_edge_runtime_ai4good-slot-1 | Up About a minute\\nsupabase_edge_runtime_ai4good-slot-2 | Up 20 seconds\\nsupabase_edge_runtime_poancmeitlmxejofwzuu | Up 6 hours\\nsupabase_inbucket_ai4good-slot-1 | Up About a minute (healthy)\\nsupabase_inbucket_ai4good-slot-2 | Up 23 seconds (healthy)\\nsupabase_inbucket_poancmeitlmxejofwzuu | Up 7 hours (healthy)\\nsupabase_kong_ai4good-slot-1 | Up About a minute (healthy)\\nsupabase_kong_ai4good-slot-2 | Up 24 seconds (healthy)\\nsupabase_kong_poancmeitlmxejofwzuu | Up 7 hours (unhealthy)\\nsupabase_pg_meta_ai4good-slot-1 | Up About a minute (healthy)\\nsup