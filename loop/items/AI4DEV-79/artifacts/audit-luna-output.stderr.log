143: /* --------------------------------------------------------------------------- config.toml scan */
144: 
145: interface ConfigEntry {
146:   line: number;
147:   section: string;
148:   key: string;
149:   value: string;
150: }
151: 
152: /**
153:  * Every ACTIVE `key = value` in the file, with the section it sits in. Commented lines are not
154:  * settings and are skipped — which is the whole reason the scan is section-aware rather than a
155:  * set of regular expressions over the file: `port` appears in nine places and most of them are
156:  * examples in comments.
157:  *
158:  * Multi-line array values are not read as one value. Nothing in this repo's config uses one, and
159:  * a value this scanner cannot see is a value it never rewrites, so the failure mode is a config
160:  * that is copied verbatim rather than one that is silently mis-edited.
161:  */
162: export function scanConfig(text: string): ConfigEntry[] {
163:   const entries: ConfigEntry[] = [];
164:   let section = '';
165:   const lines = text.split('\n');
166:   for (let index = 0; index < lines.length; index++) {
167:     const line = lines[index].trim();
168:     if (line.startsWith('#') || line === '') continue;
169:     const header = /^\[([^\]]+)\]/.exec(line);
170:     if (header) {
171:       section = header[1];
172:       continue;
173:     }
174:     const setting = /^([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)$/.exec(line);
175:     if (setting) entries.push({ line: index, section, key: setting[1], value: setting[2].trim() });
176:   }
177:   return entries;
178: }
179: 
180: function isPortKey(key: string): boolean {
181:   return key === 'port' || key.endsWith('_port');
182: }
183: 
184: /**
185:  * THE LOCAL STACK'S OWN LISTENER PORTS — the only ports a slot's identity moves (ruling E4).
186:  *
187:  * A `config.toml` holds two kinds of port. A LISTENER port is a socket this machine opens for
188:  * this stack, so two stacks that share one collide, and the overlay must move it. A CLIENT port
189:  * is part of an address of somebody else's service — `[auth.email.smtp] port = 587` is Postmark's
190:  * port, not ours — so it is DATA, and moving it or refusing it would break a slot that is
191:  * configured exactly like the tree it grades.
192:  *
193:  * The list is exact section + key pairs, so `[api] port` moves while `[api.tls] port` (were one
194:  * added) does not silently inherit the rule.
195:  */
196: const LISTENER_PORTS: readonly { section: string; key: string }[] = [
197:   { section: 'api', key: 'port' },
198:   { section: 'db', key: 'port' },
199:   { section: 'db', key: 'shadow_port' },
200:   { section: 'db.pooler', key: 'port' },
201:   { section: 'studio', key: 'port' },
202:   { section: 'local_smtp', key: 'port' },
203:   { section: 'local_smtp', key: 'smtp_port' },
204:   { section: 'local_smtp', key: 'pop3_port' },
205:   { section: 'analytics', key: 'port' },
206:   { section: 'edge_runtime', key: 'inspector_port' },
207: ];
208: 
209: function isListenerPort(section: string, key: string): boolean {
210:   return LISTENER_PORTS.some((listener) => listener.section === section && listener.key === key);
211: }
212: 
213: export interface PortMapping {
214:   section: string;
215:   key: string;
216:   line: number;
217:   from: number;
218:   to: number;
219: }
220: 
221: /**
222:  * The identity overlay's port rule (ruling E4).
223:  *
224:  *   - a LISTENER port (see `LISTENER_PORTS`) in 54000–54999 moves by 1000 per slot;
225:  *     `edge_runtime.inspector_port` set to EXACTLY 8083 moves by 10 per slot, because the ruled
226:  *     inspector value is 8083 and it is not in that band. Any OTHER inspector value falls to the
227:  *     generic rule below, so it maps when it is in band and refuses when it is not — a +10 applied
228:  *     to a value nobody ruled is a guess, and D2 forbids guesses.
229:  *   - a listener port outside those bands REFUSES loudly as unmappable. A guess here is a port
230:  *     collision with software nobody in this process knows about, so a person decides.
231:  *   - any OTHER port-valued key passes through unchanged: it addresses somebody else's service and
232:  *     is data, not identity.
233:  *   - except that a non-listener port sitting in 54000–54999 also REFUSES. It looks exactly like a
234:  *     local stack port and this rule does not recognise it, and treating an unrecognised local port
235:  *     as data would hand two slots the same socket. Fail closed, and a person decides.
236:  *
237:  * `personalBlockProblems` stays broad over EVERY port key regardless of this rule, so a port in the
238:  * founder's own block can never reach a slot by being classified as data.
239:  */
240: export function portMappings(text: string, slot: number): { mappings: PortMapping[]; problems: string[] } {
241:   assertSlotNumber(slot);
242:   const mappings: PortMapping[] = [];
243:   const problems: string[] = [];
244: 
245:   for (const entry of scanConfig(text)) {
246:     if (!isPortKey(entry.key)) continue;
247:     const literal = /^(\d+)/.exec(entry.value);
248:     const from = literal ? Number(literal[1]) : NaN;
249:     const listener = isListenerPort(entry.section, entry.key);
250: 
251:     if (!listener) {
252:       if (Number.isFinite(from) && from >= MAPPABLE_PORT_LOW && from <= MAPPABLE_PORT_HIGH) {
253:         problems.push(
254:           `[${entry.section}] ${entry.key} = ${from} is not a listener port this rule knows, but it sits in the local ` +
255:             `stack's band ${MAPPABLE_PORT_LOW}–${MAPPABLE_PORT_HIGH} — decide by hand whether the slot moves it`,
256:         );
257:       }
258:       continue; // a client-connection port is data and travels unchanged
259:     }
260: 
261:     if (!literal) {
262:       problems.push(`[${entry.section}] ${entry.key} = ${entry.value} is not a plain port number, so the slot overlay cannot move it`);
263:       continue;
264:     }
265:     if (entry.section === 'edge_runtime' && entry.key === 'inspector_port' && from === PERSONAL_INSPECTOR_PORT) {
266:       mappings.push({ section: entry.section, key: entry.key, line: entry.line, from, to: from + slot * 10 });
267:       continue;
268:     }
269:     if (from >= MAPPABLE_PORT_LOW && from <= MAPPABLE_PORT_HIGH) {
270:       mappings.push({ section: entry.section, key: entry.key, line: entry.line, from, to: from + slot * 1000 });
271:       continue;
272:     }
273:     problems.push(
274:       `[${entry.section}] ${entry.key} = ${from} is outside ${MAPPABLE_PORT_LOW}–${MAPPABLE_PORT_HIGH}, so the slot ` +
275:         `overlay does not know where to move it — decide the slot's port for this setting by hand`,
276:     );
277:   }
278: 
279:   return { mappings, problems };
280: }
281: 
282: /**
283:  * The item tree's own config, wearing the slot's identity. Everything that is not an identity
284:  * field is returned byte for byte, including comments, blank lines and line endings — a
285:  * regenerated config differing anywhere else would mean the slot grades different behaviour from
286:  * the tree that asked for the run.
287:  */
288: export function generateSlotConfig(sourceText: string, slot: number): string {
289:   assertSlotNumber(slot);
290:   const { mappings, problems } = portMappings(sourceText, slot);
291:   if (problems.length) {
292:     throw new Error(`the slot ${slot} config cannot be generated from this supabase/config.toml — ${problems.join('; ')}`);
293:   }
294: 
295:   const projectIdEntry = scanConfig(sourceText).find((entry) => entry.section === '' && entry.key === 'project_id');
296:   if (!projectIdEntry) throw new Error('supabase/config.toml carries no top-level project_id, so a slot identity cannot be built from it');
297: 
298:   const lines = sourceText.split('\n');
299:   lines[projectIdEntry.line] = lines[projectIdEntry.line].replace(/^(\s*project_id\s*=\s*)"[^"]*"/, `$1"${slotProjectId(slot)}"`);
300:   for (const mapping of mappings) {
301:     const pattern = new RegExp(`^(\\s*${mapping.key}\\s*=\\s*)\\d+`);
302:     lines[mapping.line] = lines[mapping.line].replace(pattern, `$1${mapping.to}`);
303:   }
304:   return lines.join('\n');
305: }
306: 
307: /* ------------------------------------------------------- the personal stack, refused in code */
308: 
309: /**
310:  * The "untouchable" ruling as an executable guard. Called before every destructive act and before
311:  * any env is emitted, because a convention that is only written down is one a later change can
312:  * step over without noticing.
313:  *
314:  * It scans EVERY active port-valued key, not a fixed list: the danger is a port in the personal
315:  * block reaching a slot, and it does not matter which setting carried it there.
316:  */
317: export function personalBlockProblems(slotConfigText: string, personalProjectId: string): string[] {
318:   const problems: string[] = [];
319:   const entries = scanConfig(slotConfigText);
320: 
321:   const projectId = entries.find((entry) => entry.section === '' && entry.key === 'project_id');
322:   const value = /^"([^"]*)"/.exec(projectId?.value ?? '')?.[1] ?? '';
323:   if (!value) problems.push('the slot config carries no project_id, so it cannot be told apart from the personal stack');
324:   else if (value === personalProjectId) problems.push(`the slot config carries the personal stack's project id "${personalProjectId}"`);
325: 
326:   for (const entry of entries) {
327:     if (!isPortKey(entry.key)) continue;
328:     const port = Number(/^(\d+)/.exec(entry.value)?.[1] ?? NaN);
329:     if (!Number.isFinite(port)) continue;
330:     if (port >= PERSONAL_PORT_LOW && port <= PERSONAL_PORT_HIGH) {
331:       problems.push(`[${entry.section}] ${entry.key} = ${port} is inside the personal stack's port block ${PERSONAL_PORT_LOW}–${PERSONAL_PORT_HIGH}`);
332:     }
333:     if (entry.key === 'inspector_port' && port === PERSONAL_INSPECTOR_PORT) {
334:       problems.push(`[${entry.section}] inspector_port = ${port} is the personal stack's inspector port`);
335:     }
336:   }
337: 
338:   return problems;
339: }
340: 
341: /** The identity the pool must never wear. Read from the item tree, never hard-coded. */
342: export function personalProjectId(itemRoot: string = REPO_ROOT): string {
343:   return readLocalConfig(itemRoot).projectId;
344: }
345: 
346: function refusePersonal(slotConfigText: string, itemRoot: string, act: string): void {
347:   const problems = personalBlockProblems(slotConfigText, personalProjectId(itemRoot));
348:   if (problems.length) {
349:     throw new Error(
350:       `refusing to ${act}: this configuration is not provably outside the founder's personal stack. ` +
351:         `Failed checks: ${problems.join('; ')}. The personal stack is untouchable, so nothing was done.`,
352:     );
353:   }
354: }
355: 
356: /**
357:  * The same guard, over a slot's config AS IT SITS ON DISK (rulings T7 and F1).
358:  *
359:  * `occupy` and `prepare` run the guard over text they hold in hand. The other three entry points —
360:  * reset, stop and the env emitter — are exported and reachable directly, so each runs the guard
361:  * for itself over the file. A guard that only the usual caller runs is a convention, not a guard.
362:  */
363: function refusePersonalSlotConfig(slot: number, itemRoot: string, act: string): void {
364:   const configPath = slotConfigPath(slot);
365:   if (!existsSync(configPath)) {
366:     throw new Error(
367:       `refusing to ${act} slot ${slot}: it has no config at ${configPath}, so it cannot be shown to be outside the ` +
368:         `founder's personal stack. Run \`bun tests/at/harness/db-pool.ts setup\`. Nothing was done.`,
369:     );
370:   }
371:   refusePersonal(readFileSync(configPath, 'utf8'), itemRoot, `${act} slot ${slot}`);
372: }
