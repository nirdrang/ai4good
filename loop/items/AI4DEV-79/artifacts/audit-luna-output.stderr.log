1136:     `at:verify — db slot ${occupancy.slot} (${occupancy.config.projectId}, api ${occupancy.config.apiPort}) — ` +
1137:     `reset OK — migrations: ${result.migrations.expected} expected, ${result.migrations.applied} applied`
1138:   );
1139: }
