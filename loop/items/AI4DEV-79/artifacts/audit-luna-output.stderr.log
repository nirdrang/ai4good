127: /**
128:  * A slot's PERMANENT identity, used for one purpose: naming the occupancy claim file (ruling T6).
129:  *
130:  * The runner's claim path is built from a project id and an api port, and for a repository stack
131:  * both are permanent. A SLOT's ports are not: `prepare` lawfully rewrites them from the item
132:  * tree's own config on every occupancy, so two runs bracketing a port change would hold two
133:  * DIFFERENT claim files for one slot and neither would see the other. The claim therefore keys on
134:  * the slot's project id — which never changes — and on a fixed sentinel in place of the port.
135:  *
136:  * The sentinel is 0, which is not a port. It only has to be constant. The PowerShell helper globs
137:  * `at-verify-ai4good-slot-N-*.lock`, so it matches this and every earlier name unchanged.
138:  */
139: export function slotClaimKey(slot: number): LocalConfig {
140:   return { projectId: slotProjectId(slot), apiPort: 0, dbPort: 0 };
141: }
