96: /** Slot numbers are 1..POOL_SIZE. Anything else is a caller error, named rather than clamped. */
97: export function assertSlotNumber(slot: number): number {
98:   if (!Number.isInteger(slot) || slot < 1 || slot > POOL_SIZE) {
99:     throw new Error(`"${slot}" is not a slot in this pool — the slots are 1 to ${POOL_SIZE}`);
100:   }
101:   return slot;
102: }
103: 
104: /** The directory that CONTAINS the slot's `supabase/` project folder — what `--workdir` names. */
105: export function slotDir(slot: number): string {
106:   return join(poolRoot(), `slot-${assertSlotNumber(slot)}`);
107: }
108: 
109: export function slotConfigPath(slot: number): string {
110:   return join(slotDir(slot), 'supabase', 'config.toml');
111: }
112: 
113: /** Written only after a successful start; see `prepare`. */
114: export function slotMarkerPath(slot: number): string {
