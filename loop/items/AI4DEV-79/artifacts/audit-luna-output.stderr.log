710: /**
711:  * Refuse to touch anything that is not demonstrably the local development stack. Returns the
712:  * names of the checks that failed — never the values, which are keys and connection strings.
713:  */
714: export function localStackProblems(status: StackStatus, config: LocalConfig): string[] {
715:   const problems: string[] = [];
716: 
717:   const checkUrl = (label: string, raw: string, expectedPort: number) => {
718:     let url: URL;
719:     try {
720:       url = new URL(raw);
721:     } catch {
722:       problems.push(`${label} is not a URL`);
723:       return;
724:     }
725:     if (!LOOPBACK.has(url.hostname)) problems.push(`${label} does not point at the loopback address`);
726:     if (url.port !== String(expectedPort)) problems.push(`${label} port is not the ${expectedPort} configured in supabase/config.toml`);
727:   };
728: 
729:   checkUrl('API_URL', status.apiUrl, config.apiPort);
730:   checkUrl('DB_URL', status.dbUrl, config.dbPort);
731: 
732:   const checkKey = (label: string, token: string, expectedRole: string) => {
733:     const claims = decodeJwtClaims(token);
734:     if (!claims) {
735:       problems.push(`${label} is not a decodable local development JWT`);
736:       return;
737:     }
738:     if (claims.iss !== 'supabase-demo') problems.push(`${label} was not issued by the local development issuer`);
739:     if (claims.role !== expectedRole) problems.push(`${label} does not carry the ${expectedRole} role`);
740:     if (typeof claims.ref === 'string') problems.push(`${label} carries a hosted project reference`);
741:   };
742: 
743:   checkKey('ANON_KEY', status.anonKey, 'anon');
744:   checkKey('SERVICE_ROLE_KEY', status.serviceRoleKey, 'service_role');
745: 
746:   return problems;
747: }
748: 
749: /* --------------------------------------------------------------------------------- readiness */
750: 
751: interface BunSqlClient {
752:   (strings: TemplateStringsArray, ...values: unknown[]): Promise<unknown>;
753:   close(): Promise<void>;
754: }
755: type BunSqlCtor = new (url: string) => BunSqlClient;
756: 
757: /** Postgres itself answers a query — not "the port is open", which a half-started stack satisfies. */
758: async function databaseAnswers(dbUrl: string): Promise<string | null> {
759:   const SQL = (globalThis as { Bun?: { SQL?: BunSqlCtor } }).Bun?.SQL;
760:   if (!SQL) return 'this runtime has no SQL client (expected bun)';
761:   let sql: BunSqlClient | null = null;
762:   try {
763:     sql = new SQL(dbUrl);
764:     await sql`select 1`;
765:     return null;
766:   } catch (err) {
767:     return diagnostic((err as Error).message);
768:   } finally {
769:     await sql?.close().catch(() => undefined);
770:   }
771: }
772: 
773: /** One request that only succeeds if Kong routed it, PostgREST served it, and Postgres answered. */
774: async function gatewayAnswers(status: StackStatus): Promise<string | null> {
775:   try {
776:     const res = await fetch(`${status.apiUrl.replace(/\/$/, '')}/rest/v1/`, {
777:       headers: { apikey: status.anonKey, Authorization: `Bearer ${status.anonKey}` },
778:       signal: AbortSignal.timeout(5000),
779:     });
780:     if (!res.ok) return `the API gateway answered ${res.status}`;
781:     const type = res.headers.get('content-type') ?? '';
782:     if (!type.includes('json')) return `the API gateway answered 200 but served ${type || 'no content type'}`;
783:     return null;
784:   } catch (err) {
785:     return diagnostic((err as Error).message);
786:   }
787: }
788: 
789: /**
790:  * Wait until the stack is genuinely usable, or give up. "Something answered on the port" is not
791:  * readiness: a half-started stack answers 502/503, and a run launched against it fails in ways
792:  * that look like test failures instead of infrastructure failures.
793:  */
794: export async function waitForReady(status: StackStatus, phase: string): Promise<void> {
795:   const deadline = Date.now() + READY_TIMEOUT_MS;
796:   let lastProblem = 'not attempted';
797:   let delay = 250;
798: 
799:   while (Date.now() < deadline) {
800:     const db = await databaseAnswers(status.dbUrl);
801:     if (db === null) {
802:       const gateway = await gatewayAnswers(status);
803:       if (gateway === null) return;
804:       lastProblem = gateway;
805:     } else {
806:       lastProblem = `the database did not answer: ${db}`;
807:     }
808:     await new Promise((resolve) => setTimeout(resolve, delay));
809:     delay = Math.min(delay * 2, 2000);
810:   }
811: 
812:   throw new Error(`the stack was still not ready ${phase} after ${Math.round(READY_TIMEOUT_MS / 1000)}s — last problem: ${lastProblem}`);
813: }
