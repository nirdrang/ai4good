902:     throw new Error(
903:       `REFUSING TO ${act.toUpperCase()} SLOT ${slot}: docker does not confirm this slot's own database container. ` +
904:         `\`docker ps\` named ${names.length ? names.join(', ') : 'no running container'} for ${project}. ` +
905:         `Start the slot (\`bun tests/at/harness/db-pool.ts setup\`) and try again. Nothing was done.`,
906:     );
907:   }
908:   console.log(`db-pool — docker confirms slot ${slot}'s own database container before the ${act}: ${own.join(', ')}`);
