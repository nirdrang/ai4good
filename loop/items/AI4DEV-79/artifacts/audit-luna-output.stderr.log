81: /**
82:  * The pool lives beside the locks it cooperates with and OUTSIDE every worktree: a slot outlives
83:  * the item that used it, and a directory inside a worktree dies with the worktree.
84:  *
85:  * `AT_DB_POOL_ROOT` overrides it for the selftests, the same pattern as `AT_REPO_ROOT`.
86:  */
87: export function poolRoot(): string {
88:   const override = process.env.AT_DB_POOL_ROOT?.trim();
89:   const dir = override
90:     ? override
91:     : join(process.env.LOCALAPPDATA ?? process.env.XDG_CACHE_HOME ?? tmpdir(), 'ai4good-build', 'db-slots');
92:   mkdirSync(dir, { recursive: true });
93:   return dir;
94: }
