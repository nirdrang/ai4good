  195: # Machine-wide lock serializing state-changing verbs. Exclusive-create lock file with stale takeover.
  196: function Acquire-WorkLock([int]$staleMinutes = 30) {
  197:     $lock = Join-Path (Get-StateDir) 'locks\verb.lock'
  198:     if (Test-Path $lock) {
  199:         $age = (Get-Date) - (Get-Item $lock).LastWriteTime
  200:         if ($age.TotalMinutes -lt $staleMinutes) {
  201:             $holder = Get-Content $lock -Raw -ErrorAction SilentlyContinue
  202:             return @{ ok = $false; holder = $holder }
  203:         }
  204:         Remove-Item $lock -Force   # stale: takeover
  205:     }
  206:     $fs = $null
  207:     try {
  208:         $fs = [System.IO.File]::Open($lock, [System.IO.FileMode]::CreateNew, [System.IO.FileAccess]::Write)
  209:         $info = ('pid=' + $PID + ' worktree=' + (Get-WorktreeId) + ' at=' + (Get-Date).ToUniversalTime().ToString('o'))
  210:         $bytes = [System.Text.Encoding]::UTF8.GetBytes($info)
  211:         $fs.Write($bytes, 0, $bytes.Length)
  212:         return @{ ok = $true }
  213:     } catch {
  214:         return @{ ok = $false; holder = 'concurrent-create' }
  215:     } finally {
  216:         if ($fs) { $fs.Dispose() }
  217:     }
  218: }
  219: 
  220: function Release-WorkLock {
  221:     $lock = Join-Path (Get-StateDir) 'locks\verb.lock'
  222:     if (Test-Path $lock) { Remove-Item $lock -Force }
  223: }
  224: 
  225: # Manifest identity: the last commit touching it + a content digest. Pinned in the pull record.
  226: function Get-ManifestIdentity([string]$req) {
  227:     $root = Get-RepoRoot
  228:     $rel = 'loop/decomp/req-' + $req + '.md'
  229:     $file = Join-Path $root $rel
  230:     if (-not (Test-Path $file)) { throw ('manifest not found: ' + $rel) }
  231:     $rev = (& git -C $root log -1 --format=%h -- $rel).Trim()
  232:     $sha = [System.Security.Cryptography.SHA256]::Create()
  233:     $digest = ([System.BitConverter]::ToString($sha.ComputeHash([System.IO.File]::ReadAllBytes($file))) -replace '-','').Substring(0,16).ToLower()
  234:     return @{ rel = $rel; revision = $rev; digest = $digest }
  235: }
