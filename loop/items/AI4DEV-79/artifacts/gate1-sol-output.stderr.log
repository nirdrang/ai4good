  197:             echo "::error::${#uncovered[@]} suite(s) have no declaration manifest, so none of their tests were run: ${uncovered[*]} â€” write tests/at/expected/<req>.json for each"
  198:             status=1
  199:           else
  200:             echo "every discovered suite has a declaration manifest"
  201:           fi
  202:           exit $status
  203: 
  204:       # One pull request may not change both territories. Lovable owns src/; Claude owns
  205:       # supabase/, tests/, loop/, .claude/ and .github/. Anything else is neither, and is ignored.
  206:       # The changed-file list comes from the pull request itself, which IS the base-to-head diff â€”
  207:       # so the guard never depends on how deep the checkout fetched.
  208:       - name: Guard against a pull request that changes both territories
  209:         if: github.event_name == 'pull_request'
  210:         shell: bash
  211:         env:
  212:           GH_TOKEN: ${{ github.token }}
  213:           REPOSITORY: ${{ github.repository }}
  214:           PR_NUMBER: ${{ github.event.pull_request.number }}
  215:         run: |
  216:           # ONE LINE PER CHANGED FILE, carrying both of its paths: a file MOVED out of src/ into
  217:           # tests/ changes both territories, and the API reports only its destination under
  218:           # `filename`. One line per FILE (not per path) is what makes the count below an entry
  219:           # count, so a pull request full of renames cannot falsely trip the ceiling.
  220:           if ! files=$(gh api "repos/${REPOSITORY}/pulls/${PR_NUMBER}/files" --paginate \
  221:               --jq '.[] | [.filename, (.previous_filename // "")] | @tsv'); then
  222:             echo "::error::the pull request's changed files could not be read from the GitHub API â€” the guard does not pass a change set it could not read"
  223:             exit 1
  224:           fi
  225: 
  226:           count=$(printf '%s\n' "$files" | grep -c . || true)
  227:           echo "the pull request changes $count file(s)"
  228:           if [ "$count" -eq 0 ]; then
  229:             echo "::error::the GitHub API reported no changed files for this pull request â€” the guard does not pass a change set it could not read"
  230:             exit 1
  231:           fi
  232:           if [ "$count" -ge 3000 ]; then
  233:             echo "::error::the changed-file listing reached the GitHub API's 3000-file ceiling, so it is truncated and the guard cannot prove the two territories are separate"
  234:             exit 1
  235:           fi
  236: 
  237:           # Both fields of every line are matched; the empty second field of an ordinary
  238:           # (non-renamed) file drops out here.
  239:           paths=$(printf '%s\n' "$files" | tr '\t' '\n' | grep . || true)
  240:           lovable=$(printf '%s\n' "$paths" | grep -E '^src/' || true)
  241:           claude=$(printf '%s\n' "$paths" | grep -E '^(supabase|tests|loop|\.claude|\.github)/' || true)
  242: 
  243:           if [ -n "$lovable" ] && [ -n "$claude" ]; then
