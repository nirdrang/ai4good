  208:       .map((l) => l.trim())
  209:       .find((l) => l.length > 0) ?? '';
  210:   return line.length > limit ? `${line.slice(0, limit)}â€¦` : line;
  211: }
  212: 
  213: /* ------------------------------------------------------------------------ config.toml reading */
  214: 
  215: export interface LocalConfig {
  216:   projectId: string;
  217:   apiPort: number;
  218:   dbPort: number;
  219: }
  220: 
  221: /** Ports and project id come from `supabase/config.toml` â€” never guessed, never hard-coded. */
  222: function readLocalConfig(): LocalConfig {
  223:   const file = join(REPO_ROOT, 'supabase', 'config.toml');
  224:   const text = readFileSync(file, 'utf8');
  225:   let section = '';
  226:   let projectId = '';
  227:   let apiPort = 0;
  228:   let dbPort = 0;
  229: 
  230:   for (const raw of text.split('\n')) {
  231:     const line = raw.trim();
  232:     const header = /^\[([^\]]+)\]/.exec(line);
  233:     if (header) {
  234:       section = header[1];
  235:       continue;
  236:     }
  237:     const port = /^port\s*=\s*(\d+)/.exec(line);
  238:     if (section === '' && /^project_id\s*=/.test(line)) projectId = /"([^"]+)"/.exec(line)?.[1] ?? '';
  239:     else if (section === 'api' && port && !apiPort) apiPort = Number(port[1]);
  240:     else if (section === 'db' && port && !dbPort) dbPort = Number(port[1]);
  241:   }
  242: 
  243:   const missing = [projectId ? '' : 'project_id', apiPort ? '' : '[api] port', dbPort ? '' : '[db] port'].filter(Boolean);
  244:   if (missing.length) throw new Error(`${file} is missing ${missing.join(' and ')}`);
  245:   return { projectId, apiPort, dbPort };
  246: }
  247: 
  248: /* ---------------------------------------------------------------------- the machine-wide lock */
  249: 
  250: interface StackLock {
  251:   file: string;
  252:   release(): void;
  253: }
  254: 
  255: function lockDir(): string {
  256:   const base = process.env.LOCALAPPDATA ?? process.env.XDG_CACHE_HOME ?? tmpdir();
  257:   const dir = join(base, 'ai4good-build', 'at-locks');
  258:   mkdirSync(dir, { recursive: true });
  259:   return dir;
  260: }
  261: 
  262: function processIsAlive(pid: number): boolean {
  263:   try {
  264:     process.kill(pid, 0);
  265:     return true;
  266:   } catch (err) {
  267:     // EPERM means it exists but belongs to someone else; ESRCH means it is gone.
  268:     return (err as NodeJS.ErrnoException).code === 'EPERM';
  269:   }
  270: }
  271: 
  272: /** The lock path for one stack. Machine-wide, and deliberately carries no folder component. */
  273: export function stackLockPath(config: LocalConfig): string {
  274:   return join(lockDir(), `at-verify-${config.projectId}-${config.apiPort}.lock`);
  275: }
  276: 
  277: interface Holder {
  278:   pid?: number;
  279:   host?: string;
  280:   requirement?: string;
  281:   startedAt?: string;
  282: }
  283: 
  284: /** Live = the recorded process still exists AND the lock is young enough to be a real run. */
  285: function holderIsLive(holder: Holder): boolean {
  286:   const startedAt = holder.startedAt ? Date.parse(holder.startedAt) : NaN;
  287:   const ageMinutes = Number.isFinite(startedAt) ? (Date.now() - startedAt) / 60_000 : Infinity;
  288:   return typeof holder.pid === 'number' && processIsAlive(holder.pid) && ageMinutes < LOCK_STALE_MINUTES;
  289: }
  290: 
  291: function heldByAnotherRun(holder: Holder, file: string): Error {
  292:   return new Error(
  293:     `another at:verify run holds this stack (pid ${holder.pid} on ${holder.host ?? 'this machine'}, ` +
  294:       `requirement ${holder.requirement ?? 'unknown'}, started ${holder.startedAt ?? 'unknown'}). ` +
  295:       `Two runs against one stack destroy each other: the second would reset the first's database ` +
  296:       `mid-run. Wait for it to finish. If that process is definitely gone, delete ${file}.`,
  297:   );
  298: }
