 228: /**
 229:  * The address the request came from â€” AT-001.01 records it on the acknowledgment.
 230:  *
 231:  * `x-forwarded-for` may carry a chain; the FIRST entry is the original client and the rest are
 232:  * proxies. `null` rather than a placeholder when there is nothing to record:
 233:  * `public.acknowledgments` permits a null `ip`, and inventing `0.0.0.0` would put a value in the
 234:  * column that reads like a measurement and is not one.
 235:  *
 236:  * IT IS VALIDATED BEFORE IT LEAVES HERE, because `public.complete_signup`'s fifth parameter is
 237:  * `p_ip inet` and the header is a client-supplied string. An unparseable value made PostgREST fail
 238:  * the cast, which arrived as a 4xx, which `complete-signup` maps to 409 with the database's message
 239:  * â€” so a perfectly well-formed signup was refused with something that read like a signup conflict.
 240:  * Anything that is not a well-formed IPv4 or IPv6 address therefore records nothing at all, which
 241:  * is honest, rather than breaking a signup.
 242:  *
 243:  * THE TRUST BOUNDARY, stated because the column looks like a measurement: this is what the gateway
 244:  * chain REPORTED, and it is NOT authenticated. On any path where no trusted proxy overwrites the
 245:  * header, a caller chooses it. Which entry of the chain a deployment should believe depends on the
 246:  * proxies actually in front of it, which is not observable from this tree; whoever lands the hosted
 247:  * deployment settles it with that chain in view. Until then the acknowledgment records AN address,
 248:  * never a verified source address, and the plan's per-id table says so in those words.
 249:  */
 250: export function callerIp(request: Request): string | null {
 251:   const forwarded = request.headers.get('x-forwarded-for');
 252:   const first = forwarded?.split(',')[0]?.trim();
 253:   if (!first || first === '') return null;
 254:   const candidate = first.startsWith('[') && first.endsWith(']') ? first.slice(1, -1) : first;
 255:   return isIpv4(candidate) || isIpv6(candidate) ? candidate : null;
 256: }
