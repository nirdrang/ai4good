 109:       // The two orders together cover both readings of "account", and neither contradicts any
 110:       // criterion.
 111:       for (const accountType of PUBLIC_SIGNUP_ACCOUNT_TYPES) {
 112:         const email = w.email(`verify-${accountType}`);
 113:   
 114:         // (1) A FRESH SIGNUP IS UNVERIFIED. This is the half that fails against an implementation
 115:         // which confirms addresses at registration, and it has to be read BEFORE anything else
 116:         // happens to the account.
 117:         const session = await sut.registerWithEmailPassword(email, PASSWORD);
 118:         expect(
