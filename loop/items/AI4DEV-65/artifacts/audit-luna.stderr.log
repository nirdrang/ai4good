 301: atTest(
 302:   'AT-001.38',
 303:   'sign-in with the correct email and a wrong password is rejected and creates no session',
 304:   { surface: 'ui' },
 305:   {
 306:     default: async ({ open }) => {
 307:       const { w, sut } = await open();
 308:   
 309:       const { email, accountId } = await registerAndConfirm(sut, w.email('wrong-password'), PASSWORD);
 310:   
 311:       // (1) THE CONTROL, AND IT COMES FIRST. Without it, a refusal below would be evidence of an
 312:       // account that cannot sign in at all rather than of a password being checked.
 313:       //
 314:       // THE COUNT IS READ ON BOTH SIDES OF THIS SIGN-IN, and the pair is what makes the control a
 315:       // control. A count above zero would prove nothing here: the fixture mints a session at
 316:       // registration â€” the divergence this file's header names â€” so a `signInWithEmailPassword` that
 317:       // minted nothing at all would still leave sessions behind. Exactly one more than before is the
 318:       // assertion, and only a sign-in that mints satisfies it. The after-reading is also what the
 319:       // failed attempt below is compared with.
 320:       const sessionsBeforeGoodSignIn = await sut.sessionsOf(accountId);
 321:   
 322:       const good = await sut.signInWithEmailPassword(email, PASSWORD);
 323:       expect(good.ok, 'the correct password was refused â€” nothing below would be about AT-001.38').toBe(true);
 324:       if (!good.ok) return;
 325:   
 326:       const sessionsAfterGoodSignIn = await sut.sessionsOf(good.session.accountId);
 327:       expect(
 328:         sessionsAfterGoodSignIn.length,
 329:         'a successful sign-in must mint exactly one new session, or the second clause below has no oracle',
 330:       ).toBe(sessionsBeforeGoodSignIn.length + 1);
 331:   
 332:       // (2) THE CRITERION'S FIRST CLAUSE: correct email, incorrect password, rejected.
 333:       const bad = await sut.signInWithEmailPassword(email, 'not the password');
 334:       expect(bad.ok, 'sign-in with the correct email and a WRONG password was accepted').toBe(false);
 335:   
 336:       // THE REFUSAL CARRIES NO EXISTENCE ORACLE, AND THAT IS THE FIXTURE'S STATED FACT RATHER THAN
 337:       // THIS BODY'S ASSERTION. `_fixture.ts`'s `signInWithEmailPassword` answers both branches â€” no
 338:       // such account, and wrong password â€” from ONE reason, deliberately and with the reason written
 339:       // beside the code. The criterion that owns no-existence-oracle behaviour is AT-001.21, another
 340:       // leaf's, so no line here compares one refusal's text with another's: an implementation that
 341:       // satisfied both of THIS id's clauses must not fail this body on response-text policy.
 342:       if (bad.ok) return;
 343:   
 344:       // (3) THE CRITERION'S SECOND CLAUSE: "no authenticated session is created". The refusal's own
 345:       // return value cannot show this â€” it hands back no handle â€” so it is read as a count across the
 346:       // failed attempt. Compared against the reading taken after the SUCCESSFUL sign-in, so a fixture
 347:       // that minted nothing at all would fail (1) instead of passing here by accident.
 348:       expect(
 349:         await sut.sessionsOf(good.session.accountId),
 350:         'the rejected sign-in created a session',
