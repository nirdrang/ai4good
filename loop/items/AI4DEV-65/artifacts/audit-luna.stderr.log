 257:   atTest(
 258:     'AT-001.03',
 259:     'a session established by Google completes signup through the same path, with the same result as email',
 260:     { surface: 'ui' },
 261:     async ({ open }) => {
 262:       const { w, sut } = await open();
 263: 
 264:       // WHAT THIS TEST ASSERTS, AND WHAT IT REFUSES TO PRETEND.
 265:       //
 266:       // The shipped code in this leaf is the decision module, and it never reads the provider â€” it
 267:       // is never GIVEN one. `CompleteSignupRequest` has no provider field, and the adapter's
 268:       // `completeSignup` passes the account id together with ONE fact about the caller â€” whether a
 269:       // GitHub identity is linked â€” and nothing else, so the comparison below establishes that the
 270:       // shipped path ignores the provider BECAUSE IT NEVER RECEIVES ONE.
 271:       //
 272:       // A LINKED-GITHUB FACT IS NOT THE SESSION PROVIDER, and the distinction is why this paragraph
 273:       // survived the GitHub leaf unchanged in substance. The decision path still cannot tell an
 274:       // email-established session from a Google-established one â€” that is what makes this test's
 275:       // equivalence claim exactly as narrow now as it was before, no narrower and no wider.
 276:       //
 277:       // WHICH MEANS THIS COMPARISON WOULD NOT CATCH A PROVIDER BRANCH, and an earlier version of
 278:       // this comment claimed it would. A branch treating Google differently would have to live in
 279:       // an edge function or in Auth, and no code this test drives can express one; both halves of
 280:       // the comparison would keep agreeing while the shipped behaviour diverged. What carries the
 281:       // weight here is the PINNED-VALUE block below â€” two identically wrong results satisfy an
 282:       // equality check, and the pinned expectations are what refuse them.
 283:       //
 284:       // IT SIMULATES NO HANDSHAKE. There is no fabricated authorization code, no token exchange and
 285:       // no fake redirect anywhere in the adapter; `registerWithProvider` produces the state Auth is
 286:       // in AFTER a consent round trip, which is the only part of the story reachable without a
 287:       // person. AT-001.03's other clause â€” "sign-in via Google succeeds on return visits" â€” is a
 288:       // real consent round trip, is NOT proved by this test or anywhere in this item, and is named
 289:       // unproved in the plan's per-id table and in the merge ruling.
 290:       const googleSession = await sut.registerWithProvider('google', w.email('google-ngo'));
 291:       expect(
 292:         googleSession.provider,
 293:         'this test compares a google-established session against an email one; if it is not google, it compares nothing',
 294:       ).toBe('google');
 295: 
 296:       const emailSession = await sut.registerWithEmailPassword(w.email('email-ngo'), 'correct horse battery staple');
 297:       expect(emailSession.provider).toBe('email');
 298: 
 299:       const request = {
 300:         accountType: 'ngo' as const,
 301:         organizationName: 'Riverside Shelter',
 302:         acknowledgmentTextVersion: TEXT_VERSION,
 303:         ...SIGNER,
 304:       };
 305: 
 306:       const viaGoogle = await sut.completeSignup(googleSession, request, CLIENT_IP);
 307:       const viaEmail = await sut.completeSignup(emailSession, request, CLIENT_IP);
 308:       expect(viaGoogle, 'a signup whose session came from Google was refused').toMatchObject({ ok: true });
 309:       expect(viaEmail, 'the email control signup was refused, so there is nothing to compare against').toMatchObject({ ok: true });
 310:       if (!viaGoogle.ok || !viaEmail.ok) return;
 311: 
 312:       // EVERY OBSERVABLE, COMPARED â€” not just "both succeeded". Identifiers differ by construction
 313:       // and are excluded on purpose; everything the criterion cares about must match.
 314:       const observable = async (accountId: string, organizationId: string | null) => {
 315:         const acknowledgments = await sut.acknowledgments(accountId);
 316:         return {
 317:           accountType: (await sut.account(accountId))?.accountType ?? null,
 318:           organizationName: organizationId ? ((await sut.organization(organizationId))?.name ?? null) : null,
 319:           membershipRole: organizationId ? ((await sut.membership(organizationId, accountId))?.role ?? null) : null,
 320:           acknowledgmentCount: acknowledgments.length,
 321:           acknowledgmentTextVersion: acknowledgments[0]?.textVersion ?? null,
 322:           acknowledgmentIp: acknowledgments[0]?.ip ?? null,
 323:           holdsPlatformAcknowledgment: await sut.hasPlatformAcknowledgment(accountId),
 324:         };
 325:       };
 326: 
 327:       const googleResult = await observable(viaGoogle.accountId, viaGoogle.organizationId);
 328:       expect(googleResult, 'signup via Google produced a different result from signup via email').toEqual(
 329:         await observable(viaEmail.accountId, viaEmail.organizationId),
 330:       );
 331:       // Pinned rather than left to the comparison alone: two identically WRONG results would satisfy
 332:       // an equality check on its own.
 333:       expect(googleResult).toMatchObject({
 334:         accountType: 'ngo',
 335:         membershipRole: 'admin',
 336:         acknowledgmentCount: 1,
 337:         acknowledgmentTextVersion: TEXT_VERSION,
 338:         holdsPlatformAcknowledgment: true,
 339:       });
 340: 
 341:       // "as either account type" â€” the volunteer half of the criterion, through the same path.
 342:       //
 343:       // THE LINK IS A PRECONDITION HERE, NOT AN ASSERTION. Since the GitHub leaf, a volunteer cannot
 344:       // complete signup without a linked GitHub identity (AT-001.04, which owns that rule and tests
 345:       // it). Adding the link is what keeps THIS test about what it has always been about â€” that a
 346:       // Google-established session completes through the same path as an email one â€” instead of
 347:       // silently becoming a second, worse test of the GitHub gate. Nothing below this line changed.
 348:       const googleVolunteer = await sut.registerWithProvider('google', w.email('google-volunteer'));
 349:       await sut.linkGithubIdentity(googleVolunteer, 'google-volunteer-handle');
 350:       const volunteerCompletion = await sut.completeSignup(
 351:         googleVolunteer,
 352:         { accountType: 'volunteer', acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
 353:         CLIENT_IP,
 354:       );
 355:       expect(volunteerCompletion, 'a volunteer signup whose session came from Google was refused').toMatchObject({ ok: true });
 356:       if (!volunteerCompletion.ok) return;
 357:       expect(await sut.account(volunteerCompletion.accountId)).toMatchObject({ accountType: 'volunteer' });
 358:       expect(volunteerCompletion.organizationId, 'a volunteer completion must create no organisation').toBeNull();
 359:     },
 360:   );
