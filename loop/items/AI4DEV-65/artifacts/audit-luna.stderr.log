 258: /** The result of a database function call: its value, or the database's own refusal. */
 259: export type RpcOutcome = { ok: true; value: unknown } | { ok: false; status: number; message: string };
 260: 
 261: /**
 262:  * Call one `public.` function, with the service role, in ONE round trip.
 263:  *
 264:  * One round trip is one implicit transaction, which is the whole reason the signup writes live
 265:  * inside a database function rather than being issued as separate Data API calls from here. Four
 266:  * calls would be four transactions, and a failure partway would leave an account with no
 267:  * organisation, membership or acknowledgment.
 268:  *
 269:  * The service role bypasses row-level security, which is why the database functions perform their
 270:  * own checks: nothing else is standing on this path.
 271:  */
 272: export async function callDatabaseFunction(
 273:   supabaseUrl: string,
 274:   serviceRoleKey: string,
 275:   name: string,
 276:   args: Record<string, unknown>,
 277: ): Promise<RpcOutcome> {
 278:   const response = await fetch(`${supabaseUrl}/rest/v1/rpc/${name}`, {
 279:     method: 'POST',
 280:     headers: {
 281:       'content-type': 'application/json',
 282:       apikey: serviceRoleKey,
 283:       Authorization: `Bearer ${serviceRoleKey}`,
 284:     },
 285:     body: JSON.stringify(args),
 286:   });
 287: 
 288:   const text = await response.text();
 289:   if (!response.ok) {
 290:     // PostgREST wraps a raised exception as `{ message, code, details, hint }`. The message is the
 291:     // sentence the database function chose, so it is passed through rather than replaced with a
 292:     // generic one â€” those functions raise sentences precisely so a caller can act on them.
 293:     let message = text;
 294:     try {
 295:       const body = JSON.parse(text) as { message?: unknown };
 296:       if (typeof body.message === 'string') message = body.message;
 297:     } catch {
 298:       // A non-JSON body from PostgREST means something other than a raised exception went wrong;
 299:       // the raw text is then the most informative thing available.
 300:     }
 301:     return { ok: false, status: response.status, message };
 302:   }
 303: 
 304:   return { ok: true, value: text === '' ? null : (JSON.parse(text) as unknown) };
 305: }
 306: 
 307: /** Read a JSON request body, or refuse â€” a malformed body must not read as an empty one. */
 308: export async function readJsonBody(request: Request): Promise<{ ok: true; value: Record<string, unknown> } | { ok: false; reason: string }> {
 309:   let text: string;
 310:   try {
 311:     text = await request.text();
 312:   } catch {
 313:     return { ok: false, reason: 'the request body could not be read' };
 314:   }
 315:   if (text.trim() === '') return { ok: true, value: {} };
 316:   try {
 317:     const parsed = JSON.parse(text) as unknown;
 318:     if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) {
 319:       return { ok: false, reason: 'the request body must be a JSON object' };
 320:     }
 321:     return { ok: true, value: parsed as Record<string, unknown> };
 322:   } catch {
 323:     return { ok: false, reason: 'the request body is not valid JSON' };
 324:   }
 325: }

