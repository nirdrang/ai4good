 114: async function realClient(url: string, anonKey: string): Promise<RealClient> {
 115:   const specifier = '@supabase/supabase-js';
 116:   const module = (await import(/* @vite-ignore */ specifier)) as {
 117:     createClient?: (url: string, key: string, opts: unknown) => RealClient;
 118:   };
 119:   if (typeof module.createClient !== 'function') {
 120:     throw new Error(`${specifier} exports no createClient() â€” AT-001.13's whole claim is about a real client`);
 121:   }
 122:   return module.createClient(url, anonKey, {
 123:     auth: { autoRefreshToken: true, persistSession: false, detectSessionInUrl: false },
 124:   });
 125: }
