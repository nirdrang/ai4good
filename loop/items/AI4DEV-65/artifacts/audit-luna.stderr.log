 454:   atTest(
 455:     'AT-001.05',
 456:     'linking GitHub fires volunteer onboarding with the public stats observably imported',
 457:     {
 458:       default: async ({ open }) => {
 459:         const { w, sut } = await open();
 460:   
 461:         // WHERE THE STATS COME FROM, STATED BEFORE THEY ARE ASSERTED SO NO GREEN CAN BE MISREAD.
 462:         //
 463:         // `stubGithubStatsFor` is a STUB. It calls nothing, fetches nothing, and reaches no part of
 464:         // GitHub. It is the "stub import fixture until W3" the decomposition manifest's own
 465:         // cross-contract ratifies, and the real import belongs to the volunteer-profile requirement in
 466:         // a later wave. So this test may NEVER be reported as "profile import from GitHub works".
 467:         //
 468:         // ASSERTING THE STUB'S EXACT VALUES IS NEVERTHELESS THE HONEST STRONG ORACLE HERE, because the
 469:         // stub IS the declared source: what the criterion puts under test is that onboarding FIRES and
 470:         // that what it produced arrives POPULATED on the profile, not that any statistic is true of a
 471:         // real person. A weaker "something non-empty is there" would pass against an implementation
 472:         // that wrote a placeholder, which is precisely the "queued-but-empty" state the criterion's
 473:         // last sentence forbids. Both strengths are asserted below: the structural non-emptiness AND
 474:         // the by-value equality.
 475:         const HANDLE = 'riverside-contributor';
 476:         const expected = stubGithubStatsFor(HANDLE);
 477:   
 478:         const session = await sut.registerWithEmailPassword(w.email('volunteer-import'), PASSWORD);
 479:         await sut.linkGithubIdentity(session, HANDLE);
 480:   
 481:         // THE PRE-COMPLETION NEGATIVE. The identity is linked and the signup has NOT completed, and at
 482:         // this instant there must be no profile at all.
 483:         //
 484:         // It is what makes the causal claim testable rather than merely stated. Without it, an
 485:         // implementation that populated the profile at link time â€” or one that had queued an empty row
 486:         // waiting to be filled â€” would satisfy every assertion after the completion below, and the
 487:         // criterion's "when the link completes, onboarding fires" would be untested. With it, the
 488:         // population is provably CAUSED by the completion and nothing sits queued in between.
 489:         expect(
 490:           await sut.volunteerProfile(session.accountId),
 491:           'a profile existed after linking and BEFORE completion â€” the import is not caused by completion, or an empty row is queued',
 492:         ).toBeNull();
 493:   
 494:         const completion = await sut.completeSignup(
 495:           session,
 496:           { accountType: 'volunteer', acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
 497:           CLIENT_IP,
 498:         );
 499:         expect(completion, 'the linked volunteer signup was refused, so onboarding had nothing to fire from').toMatchObject({
 500:           ok: true,
 501:         });
 502:         if (!completion.ok) return;
 503:   
 504:         // IMMEDIATELY â€” the very next read after completion returns, with no retry, no polling and no
 505:         // queue to drain. If the import were deferred to a job, this read would find nothing, which is
 506:         // exactly the failure the criterion's last sentence describes.
 507:         const profile = await sut.volunteerProfile(completion.accountId);
 508:         expect(profile, 'volunteer onboarding did not fire: no profile exists after a linked completion').not.toBeNull();
 509:         if (!profile) return;
 510:   
 511:         // "the linked handle AND the imported public stats â€¦ are observably populated on the profile"
 512:         // â€” all four values, each by its own assertion, because a row with three empty fields in it
 513:         // records nothing while looking like a record.
 514:         expect(profile.githubHandle, 'the profile does not carry the handle that was linked').toBe(HANDLE);
 515:   
 516:         expect(
