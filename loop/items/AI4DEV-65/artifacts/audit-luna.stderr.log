 130:  * IT ASSERTS AS IT GOES, because a helper that swallowed a failure would report the wrong cause for
 131:  * the right red: "no session" three assertions later, rather than "no confirmation email arrived".
 132:  */
 133: async function registerConfirmAndSignIn(
 134:   sut: Awaited<ReturnType<Ctx['open']>>['sut'],
 135:   email: string,
 136:   password = PASSWORD,
 137: ): Promise<Session> {
 138:   const registered = await sut.registerWithEmailPassword(email, password);
 139:   expect(registered.sessionId, 'the live registration issued a session, which under confirmations it must not').toBe('');
 140: 
 141:   const link = await sut.emailedVerificationLink(email);
 142:   expect(link, `no confirmation email reached the slot's mail catcher for ${email}`).not.toBeNull();
 143:   const used = await sut.useVerificationLink(link!);
 144:   expect(used.ok, 'following the emailed confirmation link was refused').toBe(true);
 145: 
 146:   const signedIn = await sut.signInWithEmailPassword(email, password);
 147:   expect(signedIn, `sign-in after confirmation failed for ${email}`).toMatchObject({ ok: true });
 148:   if (!signedIn.ok) throw new Error('unreachable: the assertion above fails first');
 149:   expect(signedIn.session.accountId, 'sign-in resolved to a different account than the registration created').toBe(
 150:     registered.accountId,
 151:   );
 152:   return signedIn.session;
 153: }
