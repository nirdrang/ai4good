  24:  * the manifest's wiring leaf (D2.LW) re-runs the ui-marked ids with `--wired` rather than adding new
  25:  * ones. `registry.ts` defaults an omitted surface to `backend`, so an unmarked suite would leave
  26:  * that leaf nothing to re-run, and this leaf's whole decision to build no screens rests on that leaf
  27:  * finding these tests. AT-001.06 stays `backend` because it is an authorization boundary rather than
  28:  * one of the four auth screens the manifest names, and AT-001.05 stays `backend` because its
  29:  * observable is row contents â€” provider- and screen-independent, so a wired re-run would drive the
  30:  * same assertions through a screen that contributes nothing to them.
  31:  */
  32: 
  33: import { describe, expect } from 'vitest';
  34: import { atTest } from './_bind.ts';
  35: // The INTEGRATION-tier procedures for the ids whose criteria are proved differently against a real
  36: // stack. Same criterion, same id, one registration; only the procedure differs. See _integration.ts.
  37: import { at00101, at00105, at00106, at00107 } from './_integration.ts';
  38: // `LEAF`/`notLanded` are no longer imported here: this file's last declared stub was replaced with a
  39: // real body by the GitHub leaf, and an import kept for a stub that no longer exists is an orphan.
  40: // The other five suite files still declare their leaves' ids and import both.
  41: // THE STUB IMPORT FIXTURE, imported rather than restated. AT-001.05 asserts the profile's stats BY
  42: // VALUE, and the value it compares against has to be the shipped judgement â€” a literal copied into
  43: // this file would drift from `stubGithubStatsFor` the first time either changed, and the test would
  44: // then be grading a copy. See that test's own comment for why asserting the stub's exact output is
  45: // honest here and what it does and does not claim.
  46: import { stubGithubStatsFor } from '../../../../supabase/functions/_shared/github.ts';
  47: // THE SHIPPED AUTHORITY STATEMENT, imported for the reason the stub stats are: the server accepts
  48: // exactly one statement, and a literal copied into this file would drift from it silently.
  49: import { ACKNOWLEDGMENT_IDENTITY_COPY } from '../../../../supabase/functions/_shared/acknowledgment-copy.ts';
  50: 
  51: /** The version string of the ToS + Platform Promise text these tests accept on the user's behalf. */
  52: const TEXT_VERSION = 'tos-2026-01+promise-2026-01';
  53: /**
  54:  * WHO IS SIGNING â€” AT-001.19's three fields, which every completion that must SUCCEED now carries.
  55:  *
  56:  * A completion whose refusal is pinned to an EARLIER check does NOT carry them, and that is
  57:  * deliberate rather than an oversight: `validateCompleteSignup` runs the identity checks last, so
  58:  * AT-001.01's no-acknowledgment request and AT-001.07's `platform_admin` request keep refusing for
  59:  * the reasons those criteria name. AT-001.19 and AT-001.39 own these fields and test them.
  60:  */
  61: const SIGNER = {
  62:   signerName: 'Dana Okonkwo',
  63:   signerTitle: 'Executive Director',
  64:   authorityAttestation: ACKNOWLEDGMENT_IDENTITY_COPY.authorityStatement,
  65: } as const;
  66: /** The address the acknowledgment must record â€” AT-001.01 names IP among the three fields. */
  67: const CLIENT_IP = '203.0.113.7';
  68: /** The password every email/password registration in this file uses. */
  69: const PASSWORD = 'correct horse battery staple';
  70: 
  71: describe('AT-REQ-001 A â€” signup and sign-in', () => {
  72:   atTest(
  73:     'AT-001.01',
  74:     'NGO email/password signup creates the account, org, admin membership and acknowledgment; sign-in returns',
  75:     { surface: 'ui' },
  76:     {
  77:       default: async ({ open }) => {
  78:         const { w, sut } = await open();
  79:         const email = w.email('ngo-signup');
  80:         const password = 'correct horse battery staple';
  81:   
  82:         const session = await sut.registerWithEmailPassword(email, password);
  83:   
  84:         // THE PREDICATE MUST DISCRIMINATE, and this is the assertion that makes that true rather than
  85:         // stated. AT-001.01 requires the acknowledgment "before any project creation is possible";
  86:         // `has_platform_acknowledgment` is the observable form of that clause, and a constant-true
  87:         // implementation would satisfy every other assertion in this test. Asserting FALSE first, on
  88:         // a user who has authenticated and not completed signup, is what fails such an implementation.
  89:         //
  90:         // WHICH implementation, exactly: at this tier the assertion reaches the fixture adapter's
  91:         // storage query, so what it establishes is the rule and that storage. The shipped SQL
  92:         // predicate `public.has_platform_acknowledgment` is NOT reached from here and could return
  93:         // true unconditionally without turning this red. Step 7(h) of the plan is what proves that
  94:         // one, against the live database, and it is the only thing in this item that does.
  95:         expect(
  96:           await sut.hasPlatformAcknowledgment(session.accountId),
  97:           'a user who has authenticated but not completed signup must NOT hold the platform acknowledgment',
  98:         ).toBe(false);
  99:   
 100:         const completion = await sut.completeSignup(
 101:           session,
 102:           {
 103:             accountType: 'ngo',
 104:             organizationName: 'Riverside Shelter',
 105:             acknowledgmentTextVersion: TEXT_VERSION,
 106:             ...SIGNER,
 107:           },
 108:           CLIENT_IP,
 109:         );
 110:         expect(completion, 'the NGO completion was refused').toMatchObject({ ok: true });
 111:         if (!completion.ok) return;
 112:         expect(completion.organizationId, 'an NGO completion produced no organisation').not.toBeNull();
 113:   
 114:         // (1) the global account type
 115:         expect(await sut.account(completion.accountId)).toEqual({
 116:           id: session.accountId,
 117:           accountType: 'ngo',
 118:         });
 119:   
 120:         // (2) the organisation, by the name that was asked for â€” not merely that one exists
 121:         expect(await sut.organization(completion.organizationId!)).toMatchObject({ name: 'Riverside Shelter' });
 122:   
 123:         // (3) the membership, AND ITS ROLE. "an org membership with the admin role is created" is one
 124:         // clause with two halves, and a membership at the wrong role satisfies neither.
 125:         expect(await sut.membership(completion.organizationId!, completion.accountId)).toEqual({
 126:           organizationId: completion.organizationId,
 127:           accountId: completion.accountId,
 128:           role: 'admin',
 129:         });
 130:   
 131:         // (4) the acknowledgment, carrying ALL THREE fields the criterion names. Each is asserted for
 132:         // its value, because a row with three empty strings in it records nothing while looking like
 133:         // a record.
 134:         const acknowledgments = await sut.acknowledgments(completion.accountId);
 135:         expect(acknowledgments, 'exactly one platform acknowledgment is recorded by one completion').toHaveLength(1);
 136:         const acknowledgment = acknowledgments[0];
 137:         expect(acknowledgment.textVersion, 'the acknowledgment must say WHICH text was accepted').toBe(TEXT_VERSION);
 138:         // The address as REPORTED, never a verified source address: on the live stack a spoofed
 139:         // header is stored verbatim. What this pins is that the reported value reaches the row intact.
 140:         expect(acknowledgment.ip, 'the acknowledgment must record the reported address').toBe(CLIENT_IP);
 141:         expect(
 142:           Number.isFinite(Date.parse(acknowledgment.acknowledgedAt)),
 143:           `the acknowledgment timestamp ${JSON.stringify(acknowledgment.acknowledgedAt)} is not a readable instant`,
 144:         ).toBe(true);
 145:   
 146:         // The other half of the discriminating pair.
 147:         expect(
 148:           await sut.hasPlatformAcknowledgment(completion.accountId),
 149:           'the platform acknowledgment must be held once signup has completed',
 150:         ).toBe(true);
 151:   
 152:         // "a later sign-in with the same email/password succeeds" â€” and returns to the SAME account,
 153:         // which is the part that would not hold if signup had minted a second identity.
 154:         const returning = await sut.signInWithEmailPassword(email, password);
 155:         expect(returning, 'the same credentials did not sign in again').toMatchObject({ ok: true });
 156:         if (!returning.ok) return;
 157:         expect(returning.session.accountId).toBe(session.accountId);
 158:   
 159:         // THE ACKNOWLEDGMENT IS *REQUIRED*, and the happy path above does not establish that. An
 160:         // implementation that records the acknowledgment when one is offered and completes signup
 161:         // anyway when none is would satisfy every assertion so far â€” so the criterion's word
 162:         // "required" would be untested, which is the same as unmet. The refusal is asserted here, and
 163:         // with it that nothing was left behind: a completion that refuses AFTER writing the account
 164:         // row has not refused, it has half-succeeded.
 165:         const withoutAcknowledgment = await sut.registerWithEmailPassword(w.email('no-acknowledgment'), password);
 166:         const refused = await sut.completeSignup(
 167:           withoutAcknowledgment,
 168:           { accountType: 'ngo', organizationName: 'Riverside Shelter Annexe' },
 169:           CLIENT_IP,
 170:         );
 171:         expect(refused.ok, 'signup completed with no acknowledgment of the ToS and Platform Promise').toBe(false);
 172:         if (refused.ok) return;
 173:         expect(refused.reason, 'the refusal does not say the acknowledgment is what is missing').toMatch(/acknowledgment/i);
 174:         expect(
 175:           await sut.account(withoutAcknowledgment.accountId),
 176:           'the refused completion left an account row behind',
 177:         ).toBeNull();
 178:         expect(
 179:           await sut.hasPlatformAcknowledgment(withoutAcknowledgment.accountId),
 180:           'the refused completion recorded an acknowledgment anyway',
 181:         ).toBe(false);
 182:       },
 183:       integration: at00101,
 184:     },
 185:   );
 186: 
 187:   atTest(
 188:     'AT-001.02',
 189:     'GitHub OAuth volunteer signup links the identity and returns to the same account',
 190:     { surface: 'ui' },
 191:     async ({ open }) => {
 192:       const { w, sut } = await open();
 193: 
 194:       // THE CRITERION HAS THREE CLAUSES and each gets its own observable below: an account of global
 195:       // type `volunteer` is created, the GitHub identity is LINKED to it, and a later sign-in via
 196:       // GitHub returns to the SAME account.
 197:       //
 198:       // WHAT IS NOT PROVED, said before the first assertion rather than in a footnote: the OAuth
 199:       // handshake. `registerWithGithub` is the state Auth is in after a consent round trip â€” no
 200:       // authorization code, no token exchange, no redirect. Consent is a person pressing a button,
 201:       // which no agent performs, and the GitHub OAuth app is a founder-manual step that may not
 202:       // exist yet. Everything downstream of the round trip is this leaf's code and is what runs here.
 203:       const email = w.email('github-volunteer');
 204:       const HANDLE = 'riverside-octocat';
 205: 
 206:       const session = await sut.registerWithGithub(email, HANDLE);
 207:       // A CONTROL, not decoration: if the session is not github-established, every clause below is
 208:       // being asserted about some other signup path and the test compares nothing.
 209:       expect(
 210:         session.provider,
 211:         'this test is about a github-established session; if it is not github, nothing below is about AT-001.02',
 212:       ).toBe('github');
 213: 
 214:       const completion = await sut.completeSignup(
 215:         session,
 216:         { accountType: 'volunteer', acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
 217:         CLIENT_IP,
 218:       );
 219:       expect(completion, 'a GitHub volunteer signup was refused at completion').toMatchObject({ ok: true });
 220:       if (!completion.ok) return;
 221: 
 222:       // Clause one: "an account with global type `volunteer` is created".
 223:       expect(await sut.account(completion.accountId)).toEqual({
 224:         id: session.accountId,
 225:         accountType: 'volunteer',
 226:       });
 227:       expect(completion.organizationId, 'a volunteer completion must create no organisation').toBeNull();
 228: 
 229:       // Clause two: "the GitHub identity is linked to it". The link lives in Supabase Auth, which
 230:       // this leaf does not own; what it CAN observe â€” and what makes the link consequential rather
 231:       // than merely asserted â€” is that the account's own row carries the handle that was linked. A
 232:       // signup that accepted a GitHub session and recorded nothing about the identity would fail
 233:       // here while passing clause one.
 234:       const profile = await sut.volunteerProfile(completion.accountId);
 235:       expect(profile, 'the completed GitHub volunteer signup carries no linked handle anywhere').not.toBeNull();
 236:       if (!profile) return;
 237:       expect(profile.githubHandle, 'the recorded handle is not the one that signed up').toBe(HANDLE);
 238: 
 239:       // Clause three: "a later sign-in via GitHub returns to the same account". The SAME account is
 240:       // the whole content of the clause â€” a path that minted a second account on the return visit
 241:       // would satisfy "sign-in succeeds" and fail the criterion.
 242:       const returning = await sut.signInWithProvider('github', email);
 243:       expect(returning, 'a later sign-in via GitHub did not succeed').toMatchObject({ ok: true });
 244:       if (!returning.ok) return;
 245:       expect(
 246:         returning.session.accountId,
 247:         'the GitHub return visit resolved to a DIFFERENT account than the one it signed up',
 248:       ).toBe(session.accountId);
 249:       expect(returning.session.provider).toBe('github');
 250: 
 251:       // And the returned-to account is still the same one, with the same type â€” asserted rather than
 252:       // assumed, because "same id" and "same account" come apart if anything re-typed the row.
 253:       expect(await sut.account(returning.session.accountId)).toMatchObject({ accountType: 'volunteer' });
 254:     },
 255:   );
