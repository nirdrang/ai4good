 102: type RealClient = {
 103:   auth: {
 104:     signInWithPassword(credentials: { email: string; password: string }): Promise<{
 105:       data: { session: { access_token: string } | null };
 106:       error: unknown;
 107:     }>;
 108:     getSession(): Promise<{ data: { session: { access_token: string } | null } }>;
 109:     getUser(): Promise<{ data: { user: { id: string } | null } }>;
 110:     stopAutoRefresh(): Promise<void>;
 111:   };
 112: };
