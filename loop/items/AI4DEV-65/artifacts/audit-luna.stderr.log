 550:   atTest(
 551:     'AT-001.06',
 552:     'a volunteer is refused the NGO-only action while an NGO account performs it successfully',
 553:     {
 554:       default: async ({ open }) => {
 555:         const { w, sut } = await open();
 556:   
 557:         // THE CONTROL IS NOT OPTIONAL. A rejection with no working control proves only that the path
 558:         // is broken â€” an operation that refuses everybody would pass the negative half on its own. So
 559:         // the NGO succeeds FIRST, and the volunteer's refusal is then attributable to the account
 560:         // type and to nothing else.
 561:         const ngoSession = await sut.registerWithEmailPassword(w.email('ngo-actor'), 'correct horse battery staple');
 562:         const ngoCompletion = await sut.completeSignup(
 563:           ngoSession,
 564:           { accountType: 'ngo', organizationName: 'Riverside Shelter', acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
 565:           CLIENT_IP,
 566:         );
 567:         expect(ngoCompletion, 'the NGO control could not complete signup').toMatchObject({ ok: true });
 568:         if (!ngoCompletion.ok) return;
 569:   
 570:         const ngoAction = await sut.createOrganization(ngoSession, 'Riverside Shelter Second Programme');
 571:         expect(ngoAction, 'the NGO control was refused the NGO-only action, so the refusal below proves nothing').toMatchObject({
 572:           ok: true,
 573:         });
 574:         if (!ngoAction.ok) return;
 575:         // The control SUCCEEDED, observably: the organisation exists and the actor is its admin.
 576:         expect(await sut.organization(ngoAction.organizationId)).toMatchObject({
 577:           name: 'Riverside Shelter Second Programme',
 578:         });
 579:         expect(await sut.membership(ngoAction.organizationId, ngoCompletion.accountId)).toMatchObject({ role: 'admin' });
 580:   
 581:         // Now the volunteer, driven through THE SAME BOUNDARY â€” the `create-organization` operation,
 582:         // not the helper behind it. Calling `ngoOnlyActionAllowed` here would prove a helper behaves
 583:         // and say nothing about whether the application enforces it.
 584:         const volunteerSession = await sut.registerWithEmailPassword(w.email('volunteer-actor'), PASSWORD);
 585:         // A PRECONDITION, not part of what this test asserts: since the GitHub leaf a volunteer cannot
 586:         // complete signup without a linked GitHub identity. The refusal under test below is the
 587:         // NGO-only one, and it must be attributable to the account type â€” so the volunteer has to
 588:         // reach the state of being a fully signed-up volunteer first. AT-001.04 owns the link rule and
 589:         // tests it; the assertions in this test are unchanged.
 590:         await sut.linkGithubIdentity(volunteerSession, 'volunteer-actor-handle');
 591:         const volunteerCompletion = await sut.completeSignup(
 592:           volunteerSession,
 593:           { accountType: 'volunteer', acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
 594:           CLIENT_IP,
 595:         );
 596:         expect(volunteerCompletion, 'the volunteer could not complete signup, so the refusal below is not the one under test').toMatchObject({
 597:           ok: true,
 598:         });
 599:         if (!volunteerCompletion.ok) return;
 600:   
 601:         const REFUSED_NAME = 'Riverside Shelter Copy';
 602:         const volunteerAction = await sut.createOrganization(volunteerSession, REFUSED_NAME);
 603:         expect(volunteerAction.ok, 'a volunteer account performed an NGO-only action').toBe(false);
 604:         if (volunteerAction.ok) return;
 605:   
 606:         // "THE ACTION IS REJECTED" INCLUDES ITS WRITES NOT HAPPENING. The weakest implementation that
 607:         // passes the assertion above writes the organisation and its membership and then reports a
 608:         // refusal, which is not a rejection â€” it is a success with a rude message. So: the volunteer
 609:         // holds no membership anywhere, and no organisation by the attempted name exists.
 610:         const organizations = await sut.organizationsNamed(REFUSED_NAME);
 611:         expect(organizations, `the refused action created an organisation named ${JSON.stringify(REFUSED_NAME)}`).toEqual([]);
 612:         expect(
 613:           await sut.membershipsOf(volunteerCompletion.accountId),
 614:           'the refused action left the volunteer holding a membership',
 615:         ).toEqual([]);
 616:         // The refusal must STATE why. A bare failure leaves the caller unable to act, and the
 617:         // criterion's own wording â€” "one account holds exactly one global type; the NGO path requires
 618:         // a separate account" â€” is what the reason has to convey.
 619:         expect(volunteerAction.reason).toMatch(/NGO accounts only/i);
 620:         expect(volunteerAction.reason).toMatch(/volunteer/i);
 621:       },
 622:       integration: at00106,
 623:     },
 624:   );
