 121:         ).toBe(false);
 122:   
 123:         // The volunteer branch needs a linked GitHub identity before completion â€” that is AT-001.04's
 124:         // requirement, not this one's, and it is satisfied here rather than tested.
 125:         if (accountType === 'volunteer') {
 126:           await sut.linkGithubIdentity(session, 'riverside-verifier');
 127:         }
 128:   
 129:         // (2) THE ACCOUNT IS TYPED, and the row says which type. Without this the loop would prove
 130:         // the same thing twice about two indistinguishable accounts, and "either account type" would
 131:         // be a claim in the test's name rather than a fact of the run.
 132:         const completion = await sut.completeSignup(
 133:           session,
 134:           {
 135:             accountType,
 136:             organizationName: accountType === 'ngo' ? 'Riverside Shelter' : undefined,
 137:             acknowledgmentTextVersion: TEXT_VERSION,
 138:             ...SIGNER,
 139:           },
 140:           CLIENT_IP,
 141:         );
 142:         expect(completion, `the ${accountType} completion was refused`).toMatchObject({ ok: true });
 143:         if (!completion.ok) return;
