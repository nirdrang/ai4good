 128: atTest(
 129:   'AT-001.39',
 130:   'an acknowledgment missing any of name, title or attestation is rejected and records nothing',
 131:   {
 132:     default: async ({ open }) => {
 133:       const { w, sut } = await open();
 134: 
 135:       const omitting = (field: keyof typeof SIGNER): Record<string, unknown> => {
 136:         const identity: Record<string, unknown> = { ...SIGNER };
 137:         delete identity[field];
 138:         return identity;
 139:       };
 140:       // WHITESPACE IS NOT A VALUE. A blank field passes any "was it sent?" check and records
 141:       // nobody, so the criterion's "omitted" has to cover it or the guard is one `'   '` wide.
 142:       const blanking = (field: keyof typeof SIGNER): Record<string, unknown> => ({ ...SIGNER, [field]: '   ' });
 143: 
 144:       // SEVEN VARIANTS. Three omissions and three blanks are the criterion's own negative path. The
 145:       // seventh is the one a presence check cannot catch: an attestation that is present, non-blank
 146:       // and says the opposite of what it must attest. A rule that only asked "is it non-empty?"
 147:       // would store `'I am not authorized'` AS an attestation of authority.
 148:       const variants = [
 149:         { slug: 'omitted-name', identity: omitting('signerName'), names: /signer name/i, mismatch: false },
 150:         { slug: 'omitted-title', identity: omitting('signerTitle'), names: /signer title/i, mismatch: false },
 151:         {
 152:           slug: 'omitted-attestation',
 153:           identity: omitting('authorityAttestation'),
 154:           names: /authority attestation/i,
 155:           mismatch: false,
 156:         },
 157:         { slug: 'blank-name', identity: blanking('signerName'), names: /signer name/i, mismatch: false },
 158:         { slug: 'blank-title', identity: blanking('signerTitle'), names: /signer title/i, mismatch: false },
 159:         {
 160:           slug: 'blank-attestation',
 161:           identity: blanking('authorityAttestation'),
 162:           names: /authority attestation/i,
 163:           mismatch: false,
 164:         },
 165:         {
 166:           slug: 'wrong-attestation',
 167:           identity: { ...SIGNER, authorityAttestation: 'I am not authorized' },
 168:           names: /authority attestation/i,
 169:           mismatch: true,
 170:         },
 171:       ];
 172: 
 173:       for (const variant of variants) {
 174:         const session = await sut.registerWithEmailPassword(w.email(variant.slug), PASSWORD);
 175:         const organizationName = `Riverside Shelter ${variant.slug}`;
 176:         const refused = await sut.completeSignup(
 177:           session,
 178:           { accountType: 'ngo', organizationName, acknowledgmentTextVersion: TEXT_VERSION, ...variant.identity },
 179:           CLIENT_IP,
 180:         );
 181: 
 182:         expect(refused.ok, `signup completed with ${variant.slug}`).toBe(false);
 183:         if (refused.ok) return;
 184: 
 185:         // THE REFUSAL NAMES ITS FIELD. A caller told only that "something is missing" has nothing to
 186:         // correct, and the screen a later leaf builds would have nothing to display.
 187:         expect(refused.reason, `the refusal does not name the field at fault (${variant.slug})`).toMatch(variant.names);
 188:         if (variant.mismatch) {
 189:           expect(
 190:             refused.reason,
 191:             'the refusal does not say the attestation is not the shipped authority statement',
 192:           ).toMatch(/does not match the shipped authority statement/i);
 193:         } else {
 194:           // WHICH CHECK REFUSED, pinned. A missing or blank field must be refused for BEING missing,
 195:           // not by the content comparison further down â€” otherwise the two checks are one and a
 196:           // future reordering could not be noticed.
 197:           expect(
 198:             refused.reason,
 199:             `a missing or blank field was refused by the content check rather than the presence check (${variant.slug})`,
 200:           ).not.toMatch(/does not match/i);
 201:         }
 202: 
 203:         // "NO ACKNOWLEDGMENT RECORD IS CREATED" INCLUDES EVERY OTHER WRITE THE COMPLETION MAKES. The
 204:         // weakest implementation that passes the assertions above writes the account, the
 205:         // organisation and the membership and then reports a refusal, which is not a rejection â€” it
 206:         // is a half-completed signup with a rude message. The organisation is looked for BY THE NAME
 207:         // that was attempted, and the memberships by the account, because a refusal hands back no
 208:         // identifier to look either of them up by.
 209:         expect(await sut.account(session.accountId), `the refused completion left an account row behind (${variant.slug})`).toBeNull();
 210:         expect(
 211:           await sut.acknowledgments(session.accountId),
 212:           `the refused completion recorded an acknowledgment anyway (${variant.slug})`,
 213:         ).toEqual([]);
 214:         expect(
 215:           await sut.hasPlatformAcknowledgment(session.accountId),
 216:           `the refused completion left the account holding the platform acknowledgment (${variant.slug})`,
 217:         ).toBe(false);
 218:         expect(
 219:           await sut.organizationsNamed(organizationName),
 220:           `the refused completion created the organisation anyway (${variant.slug})`,
 221:         ).toEqual([]);
 222:         expect(
 223:           await sut.membershipsOf(session.accountId),
 224:           `the refused completion left a membership behind (${variant.slug})`,
 225:         ).toEqual([]);
 226:       }
 227: 
 228:       // THE CONTROL, AND IT IS NOT OPTIONAL. A completion path that refused everything would satisfy
 229:       // all seven refusals above. A request differing ONLY in that it carries all three fields, as
 230:       // shipped, must succeed â€” which is what makes each refusal attributable to its own field.
 231:       const control = await sut.registerWithEmailPassword(w.email('all-three'), PASSWORD);
 232:       const completed = await sut.completeSignup(
 233:         control,
 234:         {
 235:           accountType: 'ngo',
 236:           organizationName: 'Riverside Shelter All Three',
 237:           acknowledgmentTextVersion: TEXT_VERSION,
 238:           ...SIGNER,
 239:         },
 240:         CLIENT_IP,
 241:       );
 242:       expect(completed, 'the control completion carrying all three fields was refused, so the refusals prove nothing').toMatchObject(
 243:         { ok: true },
 244:       );
 245:       if (!completed.ok) return;
 246:       expect(
 247:         await sut.acknowledgments(completed.accountId),
 248:         'the control completion recorded no acknowledgment',
 249:       ).toHaveLength(1);
 250:     },
 251:     integration: at00139,
 252:   },
 253: );
