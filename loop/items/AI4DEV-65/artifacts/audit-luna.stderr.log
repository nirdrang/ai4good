 274: /**
 275:  * The registered address these four bodies start from, brought to the state the live public path
 276:  * leaves it in: created, and confirmed through the emailed link.
 277:  *
 278:  * IT EXISTS SO THE ORDER IS WRITTEN ONCE. Every one of the four opens the same way, and an order
 279:  * repeated four times is an order three of them can drift out of.
 280:  *
 281:  * IT RETURNS THE ADDRESS AND THE ACCOUNT ID, AND STILL NEVER THE REGISTRATION HANDLE. Withholding
 282:  * the handle is the point: the live stack with confirmations on issues no session at signup, so no
 283:  * body below may take one from here. The account id is a different kind of fact and is
 284:  * LIVE-FAITHFUL â€” a registered, unconfirmed user exists on the real stack and has an id there, and
 285:  * an operator reading `auth.sessions` needs exactly that id to read anything at all. AT-001.38 uses
 286:  * it to count sessions BEFORE the first sign-in, which is what turns "a sign-in mints a session"
 287:  * from a count above zero into a count that grew by one.
 288:  */
 289: const registerAndConfirm = async (
 290:   sut: AccountsSut,
 291:   email: string,
 292:   password: string,
 293: ): Promise<{ email: string; accountId: string }> => {
 294:   const registration = await sut.registerWithEmailPassword(email, password);
 295:   const link = await sut.emailedVerificationLink(email);
 296:   expect(link, `no verification link was emailed to ${email}`).not.toBeNull();
 297:   expect((await sut.useVerificationLink(link!)).ok, 'the emailed verification link was refused').toBe(true);
 298:   return { email, accountId: registration.accountId };
 299: };
