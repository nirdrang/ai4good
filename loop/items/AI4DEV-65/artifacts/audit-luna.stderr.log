 351: /**
 352:  * AT-001.09 â€” email verification, PARAMETERIZED OVER BOTH email-capable account types.
 353:  *
 354:  * Gate 1's finding 8 is what makes this body cover two types rather than one: the criterion says
 355:  * "EITHER account type â€¦ (NGO and volunteer)" and carries the acceptance file's own
 356:  * "parameterized over account types" note, and the migrated NGO-only set proved half of it.
 357:  *
 358:  * AND EACH ITERATION REALLY IS ITS TYPE (gate-2 ruling S2-4). The first version of this body labelled
 359:  * the two iterations `ngo` and `volunteer` and differed only in the email address it used â€” neither
 360:  * one ever created an account of either type, so the parameterization was nominal and a
 361:  * type-specific verification regression would have gone unnoticed by both halves. Each iteration now
 362:  * COMPLETES SIGNUP as its type after verification â€” the NGO with an organisation, the volunteer with
 363:  * a linked GitHub identity, both with the acknowledgment â€” and asserts the account row carries that
 364:  * global type.
 365:  *
 366:  * WHAT IS LIVE HERE: the message is the one GoTrue really sent, held by the slot's own mail catcher;
 367:  * the link is followed by HTTP; and the verified fact is judged by the SHIPPED extractor over the
 368:  * real row rather than read as a boolean.
 369:  */
 370: export async function at00109(ctx: Ctx): Promise<void> {
 371:   const { w, sut } = await ctx.open();
 372: 
 373:   for (const kind of ['ngo', 'volunteer'] as const) {
 374:     const email = w.email(`${kind}-verify`);
 375:     const registered = await sut.registerWithEmailPassword(email, PASSWORD);
 376:     expect(registered.sessionId, 'the live registration issued a session, which under confirmations it must not').toBe('');
 377: 
 378:     // UNVERIFIED FIRST, and it must DISCRIMINATE: an extractor that answered true unconditionally
 379:     // would satisfy every assertion after the link is used.
 380:     expect(
 381:       await sut.emailVerified(registered.accountId),
 382:       `a fresh ${kind} registration is already reported verified â€” nothing below would then mean anything`,
 383:     ).toBe(false);
 384: 
 385:     // Auth itself refuses sign-in before confirmation, which is the state the criterion describes.
 386:     const early = await sut.signInWithEmailPassword(email, PASSWORD);
 387:     expect(early.ok, `an unconfirmed ${kind} account signed in`).toBe(false);
 388: 
 389:     const link = await sut.emailedVerificationLink(email);
 390:     expect(link, `no confirmation email reached the slot's mail catcher for the ${kind} address`).not.toBeNull();
 391: 
 392:     const used = await sut.useVerificationLink(link!);
 393:     expect(used.ok, `following the emailed ${kind} confirmation link was refused`).toBe(true);
 394:     expect(
 395:       await sut.emailVerified(registered.accountId),
 396:       `using the emailed link did not flip the ${kind} account to verified`,
 397:     ).toBe(true);
 398: 
 399:     const after = await sut.signInWithEmailPassword(email, PASSWORD);
 400:     expect(after, `a confirmed ${kind} account could not sign in`).toMatchObject({ ok: true });
 401:     if (!after.ok) return;
 402: 
 403:     // THE COMPLETION AS THIS TYPE, which is what makes the two iterations two different runs of the
 404:     // criterion rather than the same run under two labels. The volunteer's linked GitHub identity is
 405:     // a GIVEN written by the operator â€” AT-001.04 owns the link rule and is red at this tier â€” and
 406:     // without it the deployed path refuses a volunteer completion, correctly.
 407:     const request =
 408:       kind === 'ngo'
 409:         ? {
 410:             accountType: 'ngo' as const,
 411:             organizationName: `Riverside Shelter ${kind}-verify`,
 412:             acknowledgmentTextVersion: TEXT_VERSION,
 413:             ...SIGNER,
 414:           }
 415:         : { accountType: 'volunteer' as const, acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER };
 416:     if (kind === 'volunteer') await sut.linkGithubIdentity(after.session, `verify-${registered.accountId.slice(0, 8)}`);
 417: 
 418:     const completion = await sut.completeSignup(after.session, request, CLIENT_IP);
 419:     expect(completion, `the verified ${kind} could not complete signup as a ${kind}`).toMatchObject({ ok: true });
 420:     if (!completion.ok) return;
 421:     expect(
 422:       await sut.account(completion.accountId),
 423:       `the completed ${kind} account does not carry the ${kind} global type`,
 424:     ).toEqual({ id: registered.accountId, accountType: kind });
 425:   }
 426: }
