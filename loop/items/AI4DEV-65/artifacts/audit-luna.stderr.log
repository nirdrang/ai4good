 207:       // on, GoTrue issues no session at signup, so a completed-but-unverified account cannot be
 208:       // produced by a visitor. The gate exists anyway, and the reason is decision-8: verification is
 209:       // "the floor for any Discovery message" â€” the write path's own rule, not one borrowed from the
 210:       // session layer. Non-public paths and configuration history reach this state, and the live
 211:       // auth-layer block is measured separately in the item's proof script, check (c).
 212:       const email = w.email('unverified-ngo');
 213:       const session = await sut.registerWithEmailPassword(email, PASSWORD);
 214:       const completion = await sut.completeSignup(
 215:         session,
 216:         {
 217:           accountType: 'ngo',
 218:           organizationName: 'Riverside Shelter',
 219:           acknowledgmentTextVersion: TEXT_VERSION,
 220:           ...SIGNER,
 221:         },
 222:         CLIENT_IP,
 223:       );
 224:       expect(completion, 'the NGO completion was refused').toMatchObject({ ok: true });
 225:       if (!completion.ok) return;
 226:   
 227:       // The control that makes the refusal below attributable. If the account were already verified,
 228:       // a refusal would be evidence of a broken gate rather than of a working one.
 229:       expect(
 230:         await sut.emailVerified(session.accountId),
 231:         'this test is about an UNVERIFIED account; if it is verified, nothing below is about AT-001.10',
 232:       ).toBe(false);
 233:   
 234:       const MESSAGE = 'Hello â€” we would like to talk about your project.';
 235:   
 236:       // (1) THE BLOCK, AND THE REMEDY IT NAMES. "the attempt is blocked with verification named as
 237:       // the remedy": a refusal saying only "forbidden" would satisfy a weaker reading of the
 238:       // criterion and would tell the sender nothing about what to do next.
 239:       const blocked = await sut.sendDiscoveryMessage(session, MESSAGE);
 240:       expect(blocked.ok, 'an unverified account was allowed to send a Discovery message').toBe(false);
 241:       if (blocked.ok) return;
 242:       expect(blocked.reason, 'the refusal does not name verification').toMatch(/verif/i);
 243:       expect(blocked.reason, 'the refusal does not name the email address as what needs verifying').toMatch(/email/i);
 244:   
 245:       // (2) THE BLOCKED ATTEMPT WROTE NOTHING. A block whose write happened anyway is not a block,
 246:       // and the refusal's own return value cannot show this â€” only a read-back can.
 247:       expect(
 248:         await sut.discoveryMessagesBy(session.accountId),
 249:         'the blocked Discovery message was recorded anyway',
 250:       ).toEqual([]);
 251:   
 252:       // (3) THE DISCRIMINATING CONTROL. Verification is proved to be THE REMEDY by being the exact
 253:       // change that unblocks the exact same send. Without this half, a gate that refused everybody
 254:       // unconditionally would pass every assertion above.
 255:       const link = await sut.emailedVerificationLink(email);
 256:       expect(link, 'no verification link was emailed to the NGO address').not.toBeNull();
 257:       expect((await sut.useVerificationLink(link!)).ok, 'the emailed verification link was refused').toBe(true);
 258:       expect(
 259:         await sut.emailVerified(session.accountId),
 260:         'using the emailed verification link did not flip the account to verified',
 261:       ).toBe(true);
 262:   
 263:       const allowed = await sut.sendDiscoveryMessage(session, MESSAGE);
 264:       expect(allowed.ok, 'the SAME Discovery message was still refused after verification').toBe(true);
 265:       expect(
 266:         await sut.discoveryMessagesBy(session.accountId),
 267:         'the allowed Discovery message was not recorded',
 268:       ).toEqual([MESSAGE]);
