 357: atTest(
 358:   'AT-001.12',
 359:   'an expired or revoked session ends access â€” the next request re-authenticates',
 360:   // THE INTEGRATION BODY WAITS OUT A REAL ACCESS TOKEN, so it gets a bounded raise at that tier and
 361:   // at no other; the loop body advances a controlled clock and keeps vitest's own 30 seconds.
 362:   { surface: 'backend', timeoutMs: { integration: INTEGRATION_TIMEOUT_MS } },
 363:   {
 364:     default: async ({ open }) => {
 365:       const { h, w, sut } = await open();
 366:   
 367:       // THE WRITE THIS BODY USES IS `createOrganization`, and the choice is load-bearing: no
 368:       // verification gate sits on it, so every refusal below is unambiguously the session layer's
 369:       // rather than the Discovery floor's. Each attempt uses a FRESH name, so `organizationsNamed`
 370:       // can say whether that particular attempt wrote anything.
 371:       const { email } = await registerAndConfirm(sut, w.email('session-expiry'), PASSWORD);
 372:   
 373:       // SIGN-IN PRECEDES COMPLETION â€” the live public order. The registration handle is not used for
 374:       // anything, here or below: on the real stack with confirmations on it does not exist.
 375:       const first = await sut.signInWithEmailPassword(email, PASSWORD);
 376:       expect(first.ok, 'the confirmed account could not sign in').toBe(true);
 377:       if (!first.ok) return;
 378:   
 379:       const completion = await sut.completeSignup(
 380:         first.session,
 381:         { accountType: 'ngo', organizationName: 'Riverside Shelter', acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
 382:         CLIENT_IP,
 383:       );
 384:       expect(completion, 'the NGO completion was refused').toMatchObject({ ok: true });
 385:       if (!completion.ok) return;
 386:   
 387:       // (1) THE CONTROL. A live session writes. Without it every refusal below could be a write path
 388:       // that never worked at all.
 389:       const CONTROL_NAME = 'Riverside Shelter Control Programme';
 390:       expect(
 391:         (await sut.createOrganization(first.session, CONTROL_NAME)).ok,
 392:         'a live session could not write â€” nothing below would be about the session layer',
 393:       ).toBe(true);
 394:   
 395:       // (2) EXPIRY. The clock is the only thing that changes across this line: the same session, the
 396:       // same account, the same shape of write.
 397:       //
 398:       // THE ADVANCE IS EXACTLY THE TTL, AND EXACTLY IS THE WHOLE POINT. One hour is
 399:       // `jwt_expiry = 3600` in `supabase/config.toml`, which the fixture mirrors, and this lands the
 400:       // clock ON the expiry instant rather than past it. The fixture's `sessionIsLive` compares with
 401:       // a strict `<`, so at this instant the session is already dead and the write below is refused;
 402:       // an inclusive `<=` would admit it and this body would fail. That boundary was a promise with
 403:       // no oracle until this line pinned it. AT-001.13 keeps its just-under/just-past pair, which
 404:       // discriminates the refresh rather than the boundary.
 405:       await h.clock.advance(3600 * 1000);
 406:   
 407:       const EXPIRED_NAME = 'Riverside Shelter Expired Programme';
 408:       const afterExpiry = await sut.createOrganization(first.session, EXPIRED_NAME);
 409:       expect(afterExpiry.ok, 'an EXPIRED session was allowed to write').toBe(false);
 410:       // A STALE-SESSION WRITE THAT HAPPENED ANYWAY IS NOT A BLOCK. The refusal hands back no
 411:       // identifier, so the row that must not exist is looked for by the name that was attempted.
 412:       expect(
 413:         await sut.organizationsNamed(EXPIRED_NAME),
 414:         'the refused write of an expired session created the organisation anyway',
 415:       ).toEqual([]);
 416:   
 417:       // (3) RE-AUTHENTICATION IS THE REMEDY, proved by being the exact change that unblocks. The same
 418:       // write, the same name, under a session obtained by signing in again.
 419:       const second = await sut.signInWithEmailPassword(email, PASSWORD);
 420:       expect(second.ok, 'the account could not sign in again after its session expired').toBe(true);
 421:       if (!second.ok) return;
 422:       expect(second.session.accountId, 're-authentication returned a different account').toBe(first.session.accountId);
 423:   
 424:       expect(
 425:         (await sut.createOrganization(second.session, EXPIRED_NAME)).ok,
 426:         're-authentication did not restore the ability to write',
 427:       ).toBe(true);
 428:       expect(
 429:         (await sut.organizationsNamed(EXPIRED_NAME)).length,
 430:         'the write after re-authentication did not create the organisation',
 431:       ).toBe(1);
 432:   
 433:       // (4) REVOCATION, the criterion's other half, on a session that is live at the moment it is
 434:       // revoked â€” so the clock plays no part in this half and the two causes stay distinguishable.
 435:       await sut.signOut(second.session);
 436:   
 437:       const REVOKED_NAME = 'Riverside Shelter Revoked Programme';
 438:       const afterRevocation = await sut.createOrganization(second.session, REVOKED_NAME);
 439:       expect(afterRevocation.ok, 'a REVOKED session was allowed to write').toBe(false);
 440:       expect(
 441:         await sut.organizationsNamed(REVOKED_NAME),
 442:         'the refused write of a revoked session created the organisation anyway',
 443:       ).toEqual([]);
 444:   
 445:       // (5) AND RE-AUTHENTICATION IS THE REMEDY FOR REVOCATION TOO. Revoking one session must not end
 446:       // the account's access â€” that difference is what makes "the next request re-authenticates" a
 447:       // remedy rather than a wall.
 448:       const third = await sut.signInWithEmailPassword(email, PASSWORD);
 449:       expect(third.ok, 'the account could not sign in again after its session was revoked').toBe(true);
 450:       if (!third.ok) return;
 451:       expect(
 452:         (await sut.createOrganization(third.session, REVOKED_NAME)).ok,
 453:         'signing in again after revocation did not restore the ability to write',
 454:       ).toBe(true);
 455:       expect(
 456:         (await sut.organizationsNamed(REVOKED_NAME)).length,
 457:         'the write after re-authentication did not create the organisation',
 458:       ).toBe(1);
 459:     },
 460:     integration: at00112,
 461:   },
