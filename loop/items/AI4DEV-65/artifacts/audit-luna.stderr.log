 464: atTest(
 465:   'AT-001.13',
 466:   'a session in continuous use refreshes without a forced mid-work re-login',
 467:   // Same reason as the id above: the integration body polls a real client for a rotation it must not
 468:   // ask for, which takes minutes rather than seconds. The loop body is unaffected.
 469:   { surface: 'ui', timeoutMs: { integration: INTEGRATION_TIMEOUT_MS } },
 470:   {
 471:     default: async ({ open }) => {
 472:       const { h, w, sut } = await open();
 473:   
 474:       /**
 475:        * WHICH HALF OF THIS CRITERION THIS TIER PROVES, said before the first assertion.
 476:        *
 477:        * PROVED HERE: a refresh takes NO credentials, extends the session it was given, and keeps work
 478:        * going past the instant the session would otherwise have died â€” while an unrefreshed sibling
 479:        * opened at the same instant dies exactly then. That pair is the discriminator: without the
 480:        * sibling, a fixture that never expired anything would pass every assertion below.
 481:        *
 482:        * NOT PROVED HERE: the word "automatically". Scheduling a refresh is the supabase-js client's
 483:        * job and no client exists in this tree; a fixture that scheduled its own would be grading
 484:        * itself. That half is handed to the manifest's wiring leaf by this id's `ui` mark, and the
 485:        * requirement's integration-tier gate binds it above that.
 486:        */
 487:       const { email } = await registerAndConfirm(sut, w.email('continuous-work'), PASSWORD);
 488:   
 489:       // TWO SESSIONS OPENED AT THE SAME INSTANT. The clock does not move between them, so they share
 490:       // an expiry â€” which is what makes the divergence later attributable to the refresh and to
 491:       // nothing else.
 492:       const refreshedSignIn = await sut.signInWithEmailPassword(email, PASSWORD);
 493:       const controlSignIn = await sut.signInWithEmailPassword(email, PASSWORD);
 494:       expect(refreshedSignIn.ok && controlSignIn.ok, 'the confirmed account could not open two sessions').toBe(true);
 495:       if (!refreshedSignIn.ok || !controlSignIn.ok) return;
 496:   
 497:       const refreshed = refreshedSignIn.session;
 498:       const control = controlSignIn.session;
 499:       expect(refreshed.sessionId, 'two sign-ins returned ONE session â€” the pair below would prove nothing').not.toBe(control.sessionId);
 500:       expect(control.accountId, 'the two sessions belong to different accounts').toBe(refreshed.accountId);
 501:   
 502:       // Sign-in precedes completion, the live public order. The account is completed once and serves
 503:       // both sessions, which is what the paired writes need.
 504:       const completion = await sut.completeSignup(
 505:         refreshed,
 506:         { accountType: 'ngo', organizationName: 'Riverside Shelter', acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
 507:         CLIENT_IP,
 508:       );
 509:       expect(completion, 'the NGO completion was refused').toMatchObject({ ok: true });
 510:       if (!completion.ok) return;
 511:   
 512:       // (1) BOTH SESSIONS WORK. One write each, so neither is assumed to work from the other's
 513:       // success.
 514:       expect((await sut.createOrganization(refreshed, 'Riverside Programme One')).ok, 'the refreshed session could not write at the start').toBe(true);
 515:       expect((await sut.createOrganization(control, 'Riverside Programme Two')).ok, 'the control session could not write at the start').toBe(true);
 516:   
 517:       // (2) WORK CONTINUES, and the clock moves to just inside the expiry both sessions share. Both
 518:       // still work, so the divergence in (4) cannot be blamed on this advance.
 519:       await h.clock.advance(3599 * 1000);
 520:       expect((await sut.createOrganization(refreshed, 'Riverside Programme Three')).ok, 'the refreshed session died before its expiry').toBe(true);
 521:       expect((await sut.createOrganization(control, 'Riverside Programme Four')).ok, 'the control session died before its expiry').toBe(true);
 522:   
 523:       // (3) THE REFRESH. NO CREDENTIALS PASS THROUGH THIS CALL â€” there is no parameter for one, so
 524:       // this body could not sign in here even by mistake. That is the criterion's "without forced
 525:       // re-login", written as a fact of the interface rather than as a claim in a test name.
 526:       const refreshOutcome = await sut.refreshSession(refreshed);
 527:       expect(refreshOutcome.ok, 'refreshing a live session was refused').toBe(true);
 528:       if (!refreshOutcome.ok) return;
 529:       expect(
 530:         refreshOutcome.session.sessionId,
 531:         'the refresh opened a NEW session instead of extending the one it was given',
 532:       ).toBe(refreshed.sessionId);
 533:       expect(refreshOutcome.session.accountId, 'the refresh returned a different account').toBe(refreshed.accountId);
 534:   
 535:       // (4) PAST THE INSTANT BOTH SESSIONS WOULD HAVE DIED. The refreshed one keeps working; the
 536:       // sibling that was not refreshed is refused, and its attempted write left nothing behind.
 537:       await h.clock.advance(2 * 1000);
 538:   
 539:       const AFTER_NAME = 'Riverside Programme Five';
 540:       const refreshedWrite = await sut.createOrganization(refreshOutcome.session, AFTER_NAME);
 541:       expect(refreshedWrite.ok, 'the REFRESHED session was refused after its original expiry â€” refresh did nothing').toBe(true);
 542:   
 543:       const CONTROL_NAME = 'Riverside Programme Six';
 544:       const controlWrite = await sut.createOrganization(control, CONTROL_NAME);
 545:       expect(
 546:         controlWrite.ok,
 547:         'the UNREFRESHED sibling still worked past its expiry â€” nothing above is attributable to the refresh',
 548:       ).toBe(false);
 549:       expect(
 550:         await sut.organizationsNamed(CONTROL_NAME),
 551:         'the refused write of the unrefreshed session created the organisation anyway',
 552:       ).toEqual([]);
 553:       expect(
 554:         (await sut.organizationsNamed(AFTER_NAME)).length,
 555:         'the refreshed session said it wrote and did not',
 556:       ).toBe(1);
 557:     },
 558:     integration: at00113,
 559:   },
 560: );
