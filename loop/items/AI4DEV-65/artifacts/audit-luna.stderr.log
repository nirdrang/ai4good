 362:   atTest(
 363:     'AT-001.04',
 364:     'volunteer signup cannot complete without a linked GitHub account',
 365:     { surface: 'ui' },
 366:     async ({ open }) => {
 367:       const { w, sut } = await open();
 368: 
 369:       // THE CRITERION NAMES BOTH ESTABLISHING PROVIDERS â€” "completing volunteer signup by email or
 370:       // Google (no GitHub identity yet)" â€” so both are driven. That is not redundancy: the gate reads
 371:       // a LINKED identity, and if it had accidentally been written against the SESSION provider
 372:       // instead, an email session and a Google session would behave differently and only running
 373:       // both would show it.
 374:       const request = { accountType: 'volunteer' as const, acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER };
 375: 
 376:       const byEmail = await sut.registerWithEmailPassword(w.email('email-volunteer'), PASSWORD);
 377:       const byGoogle = await sut.registerWithProvider('google', w.email('google-volunteer'));
 378:       expect(byEmail.provider).toBe('email');
 379:       expect(byGoogle.provider, 'the google half of this criterion is not being driven by a google session').toBe('google');
 380: 
 381:       for (const session of [byEmail, byGoogle]) {
 382:         const refused = await sut.completeSignup(session, request, CLIENT_IP);
 383:         expect(
 384:           refused.ok,
 385:           `a ${session.provider}-established volunteer completed signup with no linked GitHub account`,
 386:         ).toBe(false);
 387:         if (refused.ok) return;
 388: 
 389:         // "BLOCKED WITH THE GITHUB-LINK REQUIREMENT STATED" â€” the reason is half the criterion. A
 390:         // bare refusal leaves the caller with nothing to do differently, and the screen the wiring
 391:         // leaf builds has nothing to display.
 392:         expect(refused.reason, 'the refusal does not name GitHub').toMatch(/github/i);
 393:         expect(refused.reason, 'the refusal does not say that LINKING is what is required').toMatch(/link/i);
 394: 
 395:         // NO PARTIAL STATE. The weakest implementation that passes the assertions above writes the
 396:         // account row and then reports a refusal, which is not a refusal â€” it is a half-completed
 397:         // signup with a rude message. All four observables of a completion must be absent.
 398:         expect(await sut.account(session.accountId), 'the blocked completion left an account row behind').toBeNull();
 399:         expect(
 400:           await sut.volunteerProfile(session.accountId),
 401:           'the blocked completion imported a GitHub profile anyway',
 402:         ).toBeNull();
 403:         expect(
 404:           await sut.acknowledgments(session.accountId),
 405:           'the blocked completion recorded an acknowledgment anyway',
 406:         ).toEqual([]);
 407:         expect(
 408:           await sut.hasPlatformAcknowledgment(session.accountId),
 409:           'the blocked completion left the account holding the platform acknowledgment',
 410:         ).toBe(false);
 411:       }
 412: 
 413:       // "LINKING COMPLETES SIGNUP" â€” and the request is byte-identical to the one just refused. That
 414:       // is what makes the link the cause: if anything else about the request had changed, the
 415:       // success would be attributable to that instead.
 416:       for (const session of [byEmail, byGoogle]) {
 417:         await sut.linkGithubIdentity(session, `${session.provider}-volunteer-handle`);
 418:         const completion = await sut.completeSignup(session, request, CLIENT_IP);
 419:         expect(
 420:           completion,
 421:           `linking GitHub did not unblock the ${session.provider}-established volunteer's completion`,
 422:         ).toMatchObject({ ok: true });
 423:         if (!completion.ok) return;
 424:         expect(await sut.account(completion.accountId)).toMatchObject({ accountType: 'volunteer' });
 425:         expect(
 426:           await sut.hasPlatformAcknowledgment(completion.accountId),
 427:           'the completion that the link unblocked recorded no acknowledgment',
 428:         ).toBe(true);
 429:       }
 430: 
 431:       // THE NGO CONTROL, AND IT IS NOT OPTIONAL. A gate that refused EVERY completion would satisfy
 432:       // both refusals above, and the two successes after linking would not catch it either if the
 433:       // gate had simply been written as "refuse until any identity is linked". The criterion scopes
 434:       // itself to VOLUNTEER signup, so an NGO must still complete with no GitHub identity at all â€”
 435:       // that is the assertion which makes the gate's shape, and not merely its existence, correct.
 436:       const ngoSession = await sut.registerWithEmailPassword(w.email('ngo-control'), PASSWORD);
 437:       const ngoCompletion = await sut.completeSignup(
 438:         ngoSession,
 439:         { accountType: 'ngo', organizationName: 'Riverside Shelter', acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
 440:         CLIENT_IP,
 441:       );
 442:       expect(
 443:         ngoCompletion,
 444:         'the GitHub gate leaked onto NGO signup, which links no GitHub account and is outside this criterion',
 445:       ).toMatchObject({ ok: true });
 446:       if (!ngoCompletion.ok) return;
 447:       expect(
 448:         await sut.volunteerProfile(ngoCompletion.accountId),
 449:         'an NGO completion wrote a volunteer GitHub profile',
 450:       ).toBeNull();
 451:     },
 452:   );
