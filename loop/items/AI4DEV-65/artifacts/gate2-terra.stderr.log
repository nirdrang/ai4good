0c389c633b9867b93b1466a77c75d5bc9df66f56:loop/items/AI4DEV-81/artifacts/audit-luna.stderr.log:24437:HEAD:loop/items/AI4DEV-59/artifacts/audit-luna.stderr.log:10252:C:\Users\nirdr\Downloads\ai4good\.claude\worktrees\agent-aa95110cbeab31aa7\loop\items\AI4DEV-59\artifacts\audit-flash.events.jsonl:33:{"type":"tool_use","timestamp":1786290444182,"sessionID":"ses_018cbdef8ffeIiDUqdR6dh2IlP","part":{"type":"tool","tool":"read","callID":"call_00_wof8OsVw4YgOgoFgxgmI3660","state":{"status":"completed","input":{"filePath":"C:\\Users\\nirdr\\Downloads\\ai4good\\.claude\\worktrees\\agent-aa95110cbeab31aa7\\tests\\at\\suites\\req-001\\_contract.ts"},"output":"<path>C:\\Users\\nirdr\\Downloads\\ai4good\\.claude\\worktrees\\agent-aa95110cbeab31aa7\\tests\\at\\suites\\req-001\\_contract.ts</path>\n<type>file</type>\n<content>\n1: /**\n2:  * What REQ-001 adds to the shared harness contract.\n3:  *\n4:  * The generic seams — tier, clock, fixture worlds, sentinels, faults, static scan, config, vendor\n5:  * sims, the harness shape itself — live in `tests/at/harness/contracts.ts` and are re-exported here\n6:  * so a test body imports one file. What is genuinely REQ-001's is below: the accounts system under\n7:  * test, the row shapes its assertions read back, and what this requirement's fixture world can do.\n8:  *\n9:  * TYPE ALIASES, NOT INTERFACES, throughout — the rule `harness/contracts.ts` states and gives its\n10:  * reasons for. Nothing reachable from the objects `open()` hands a test body may be an interface,\n11:  * because an interface can be reopened with `declare module` and an OPTIONAL member merged into it\n12:  * reads `undefined` at run time while every type-check stays green.\n13:  *\n14:  * THE JUDGEMENT TYPES ARE IMPORTED FROM THE SHIPPED MODULE, not restated here. `AccountType`,\n15:  * `CompleteSignupRequest` and the rest come from `supabase/functions/_shared/accounts.ts`, which is\n16:  * the same module the two edge functions import. Restating them would be two independent statements\n17:  * about one thing with nothing able to notice them diverging — and that is the defect this whole\n18:  * harness exists to delete, not a shape to reproduce inside it.\n19:  */\n20: \n21: import type { WorldSeam } from '../../harness/contracts.ts';\n22: import type {\n23:   AccountType,\n24:   CompleteSignupRequest,\n25: } from '../../../../supabase/functions/_shared/accounts.ts';\n26: \n27: export type {\n28:   Clock,\n29:   ConfigRegistry,\n30:   FaultHandle,\n31:   Faults,\n32:   Fixtures,\n33:   ProviderOutcome,\n34:   Sentinel,\n35:   Sentinels,\n36:   StaticScan,\n37:   Tier,\n38:   WorldSeam,\n39: } from '../../harness/contracts.ts';\n40: export { TIERS } from '../../harness/contracts.ts';\n41: \n42: export type { AccountType, CompleteSignupRequest };\n43: \n44: /* ------------------------------------------------------------------------- what gets read back */\n45: \n46: /** One row of `public.accounts` — one per authenticated user, holding exactly one global type. */\n47: export type AccountRow = {\n48:   id: string;\n49:   accountType: AccountType;\n50: };\n51: \n52: /** One row of `public.organizations`. */\n53: export type OrganizationRow = {\n54:   id: string;\n55:   name: string;\n56: };\n57: \n58: /** One row of `public.org_memberships` — the per-NGO role, which is NOT the global account type. */\n59: export type MembershipRow = {\n60:   organizationId: string;\n61:   accountId: string;\n62:   role: 'admin' | 'member';\n63: };\n64: \n65: /**\n66:  * One row of `public.acknowledgments` — EXACTLY the three fields AT-001.01 names recorded, plus the\n67:  * account and kind that identify it.\n68:  *\n69:  * Name, title and authority attestation are AT-001.19's fields and belong to the acknowledgment-\n70:  * identity deliverable (`loop/decomp/req-001.md` D4.L1), which is declared red by this leaf. They\n71:  * are deliberately absent here: adding columns for a criterion this leaf does not test would be\n72:  * speculation, and a reader would have no way to tell it from work that had been done.\n73:  */\n74: export type AcknowledgmentRow = {\n75:   accountId: string;\n76:   kind: string;\n77:   /** ISO-8601 instant — AT-001.01's \"timestamp\" */\n78:   acknowledgedAt: string;\n79:   /**\n80:    * AT-001.01's \"IP\": the address the gateway chain REPORTED, never a verified source address.\n81:    * Measured on the live local stack — a spoofed `x-forwarded-for` is stored verbatim, and with no\n82:    * header at all the stored value is the gateway's own hop. See `callerIp` in\n83:    * `supabase/functions/_shared/edge.ts`.\n84:    */\n85:   ip: string;\n86:   /** which version of the ToS + Platform Promise text was accepted — AT-001.01's \"text version\" */\n87:   textVersion: string;\n88: };\n89: \n90: /**\n91:  * One row of `public.volunteer_profiles` — AT-001.05's \"profile\", and every column of it.\n92:  *\n93:  * THE STATS ARE THE STUB IMPORT FIXTURE'S, NOT GITHUB'S. `stubGithubStatsFor` in\n94:  * `supabase/functions/_shared/github.ts` produces them, the decomposition manifest's cross-contract\n95:  * ratifies that stand-in (\"stub import fixture until W3\"), and no code in this item calls\n96:  * api.github.com. What the row proves is that onboarding FIRED and landed POPULATED — the\n97:  * criterion's \"a queued-but-empty import fails this test\" — and not that any statistic is real.\n98:  */\n99: export type VolunteerProfileRow = {\n100:   accountId: string;\n101:   /** the handle of the GitHub identity linked to the account — AT-001.05's \"linked handle\" */\n102:   githubHandle: string;\n103:   /** AT-001.05's \"top languages\"; never empty, in the schema by CHECK and here by assertion */\n104:   topLanguages: string[];\n105:   /** AT-001.05's \"repository count\" */\n106:   repositoryCount: number;\n107:   /** AT-001.05's \"contribution summary\" */\n108:   contributionSummary: string;\n109:   /** ISO-8601 instant the import landed */\n110:   importedAt: string;\n111: };\n112: \n113: /* --------------------------------------------------------------------------------- the session */\n114: \n115: /**\n116:  * An authenticated session, and WHICH PROVIDER ESTABLISHED IT.\n117:  *\n118:  * `provider` is recorded, never simulated. Supabase Auth records the provider that produced a\n119:  * session; how the session was obtained — an email and a password, or a completed Google consent\n120:  * round trip — happens entirely upstream of anything this requirement's leaf ships. AT-001.03's\n121:  * body asserts that `completeSignup` behaves identically for `'google'` and `'email'`, which is a\n122:  * real property of the shipped decision module (it never reads this field). It is NOT a claim that a\n123:  * Google round trip works: see the suite's own note on AT-001.03, and the plan's per-id table.\n124:  *\n125:  * `'github'` joins the two for AT-001.02 and carries exactly the same caveat: a github-established\n126:  * session is the state Auth is in AFTER a consent round trip, and no handshake is simulated to reach\n127:  * it. The establishing provider still participates in NO decision the shipped modules make — the\n128:  * volunteer gate reads a LINKED IDENTITY, which is a different fact (see `linkGithubIdentity`).\n129:  */\n130: export type SessionProvider = 'email' | 'google' | 'github';\n131: \n132: export type Session = {\n133:   /** the auth user id, which is also the `public.accounts` primary key once signup completes */\n134:   accountId: string;\n135:   email: string;\n136:   provider: SessionProvider;\n137: };\n138: \n139: /* -------------------------------------------------------------------------------- the outcomes */\n140: \n141: export type SignInOutcome = { ok: true; session: Session } | { ok: false; reason: string };\n142: \n143: export type CompleteSignupOutcome =\n144:   | { ok: true; accountId: string; organizationId: string | null }\n145:   | { ok: false; reason: string };\n146: \n147: export type CreateOrganizationOutcome = { ok: true; organizationId: string } | { ok: false; reason: string };\n148: \n149: /**\n150:  * The outcome of an attempted Discovery message — and the refusal carries WHY, for the reason\n151:  * `Decision` in the shipped module gives: AT-001.10 asserts that the block NAMES verification as\n152:  * the remedy, so a bare boolean would make the criterion untestable.\n153:  */\n154: export type SendDiscoveryMessageOutcome = { ok: true } | { ok: false; reason: string };\n155: \n156: /* ------------------------------------------------------------------------------------ the SUT */\n157: \n158: /**\n159:  * REQ-001's accounts system under test.\n160:  *\n161:  * The split is the point, and there are now FOUR kinds of member here rather than three:\n162:  *\n163:  *   1. THE TWO PRODUCT OPERATIONS — `completeSignup` and `createOrganization`. At loop tier the\n164:  *      adapter runs them over its own storage but delegates every judgement to\n165:  *      `supabase/functions/_shared/accounts.ts`, the module the edge functions import; at\n166:  *      integration tier they would be the deployed edge functions.\n167:  *   2. SUPABASE AUTH'S HALF — registration, sign-in, identity linking, and the verification state\n168:  *      (`emailVerified`, `emailedVerificationLink`, `useVerificationLink`). None of it is this\n169:  *      requirement's code. It is what produces the states the product operations judge.\n170:  *   3. READ-BACK — the row shapes an assertion reads after the fact.\n171:  *   4. ONE STAND-IN SURFACE, AND IT IS THE ONLY ONE — `sendDiscoveryMessage`, with\n172:  *      `discoveryMessagesBy` reading it back.\n173:  *\n174:  * THE FOURTH KIND NEEDS ITS OWN SENTENCE, because it is the one that could be misread. NO\n175:  * DISCOVERY ROUTE EXISTS IN THIS TREE. The Discovery message route is REQ-002/004's, and what\n176:  * this requirement's leaf ships is the DECISION that route must consult —\n177:  * `discoveryMessageAllowed` in `supabase/functions/_shared/verification.ts`. So\n178:  * `sendDiscoveryMessage` is not a deployed operation being tested; it is a stand-in surface whose\n179:  * only job is to put the shipped decision on a tested path, exactly as\n180:  * `hasPlatformAcknowledgment` below is the hook a project-creation leaf must call. A green over\n181:  * it says the DECISION is right. It says nothing about enforcement anywhere, because there is\n182:  * nowhere yet to enforce it.\n183:  */\n184: export type AccountsSut = {\n185:   /** AT-001.07's second clause: which types the PUBLIC signup surface offers. */\n186:   publicSignupAccountTypes(): Promise<readonly string[]>;\n187: \n188:   /* --- Supabase Auth's half. Not this leaf's code; it is what produces a session to complete. --- */\n189: \n190:   /**\n191:    * Register an auth user with an email and a password, and return the resulting session.\n192:    *\n193:    * IT STILL RETURNS A SESSION, AND THE HONEST GAP THAT LEAVES IS STATED HERE RATHER THAN HIDDEN.\n194:    * With `enable_confirmations = true` the live GoTrue issues NO session at signup, so on the real\n195:    * stack a completed-but-unverified account is not reachable by the public path. This fixture's\n196:    * `Session` has always been an identity handle rather than an access token, and session ISSUANCE\n197:    * is D2.L2's subject (AT-001.12, .13 — declared red). So at the loop tier such an account IS\n198:    * constructible, and AT-001.10's body constructs one deliberately: the gate exists because\n199:    * decision-8 makes verification the write path's own floor, not a property borrowed from the\n200:    * session layer. The live-stack behaviour is measured in `loop/items/AI4DEV-59/proof-local.ts`\n201:    * checks (a) and (c), and nowhere else in this item.\n202:    */\n203:   registerWithEmailPassword(email: string, password: string): Promise<Session>;\n204:   /**\n205:    * A session Auth recorded as having come from an external provider.\n206:    *\n207:    * It performs NO handshake and fabricates no authorization code or token exchange: it is the state\n208:    * Auth is in AFTER a consent round trip, which is the only part of the story any agent can reach.\n209:    */\n210:   registerWithProvider(provider: SessionProvider, email: string): Promise<Session>;\n211:   /**\n212:    * A GitHub OAuth signup, as Auth records it: a session established by GitHub whose account already\n213:    * carries the linked GitHub identity — AT-001.02's \"signs up via GitHub OAuth\".\n214:    *\n215:    * Like `registerWithProvider` it performs NO handshake. It is `registerWithProvider('github', …)`\n216:    * plus the fact that a GitHub signup necessarily links the GitHub identity it signed up with, and\n217:    * it is a separate member rather than an argument because that second half is what AT-001.02's\n218:    * \"the GitHub identity is linked to it\" clause is about.\n219:    */\n220:   registerWithGithub(email: string, githubHandle: string): Promise<Session>;\n221:   /**\n222:    * The state Auth is in after a `linkIdentity` round trip — AT-001.04's \"linking completes signup\".\n223:    *\n224:    * A LINKED IDENTITY IS NOT THE ESTABLISHING PROVIDER, and keeping the two apart is the point of\n225:    * this member existing at all: an email- or Google-established volunteer links GitHub and their\n226:    * session's `provider` does not change. The gate in\n227:    * `supabase/functions/_shared/accounts.ts` reads the link; nothing shipped reads the provider.\n228:    *\n229:    * Same posture as every other Auth member here — no handshake, no fabricated authorization code.\n230:    */\n231:   linkGithubIdentity(session: Session, githubHandle: string): Promise<void>;\n232:   /** Return sign-in with the same credentials — AT-001.01's final clause. */\n233:   signInWithEmailPassword(email: string, password: string): Promise<SignInOutcome>;\n234:   /**\n235:    * The return visit through an external provider — AT-001.02's \"a later sign-in via GitHub returns\n236:    * to the same account\".\n237:    *\n238:    * What it asserts is IDENTITY CONTINUITY, which is the half of that clause reachable without a\n239:    * person: an existing user whose account carries that provider's identity signs in to the SAME\n240:    * account rather than to a second one. The consent round trip itself is not performed and is named\n241:    * unproved in the plan's per-id table.\n242:    */\n243:   signInWithProvider(provider: SessionProvider, email: string): Promise<SignInOutcome>;\n244: \n245:   /* ------------------------- Supabase Auth's verification state ------------------------------- */\n246: \n247:   /**\n248:    * Whether Supabase Auth reports this account's email address confirmed — AT-001.09's observable.\n249:    *\n250:    * IT IS DERIVED, NOT STORED-AND-READ. The adapter renders the account's stored Auth state as the\n251:    * canonical GoTrue `/auth/v1/user` shape and judges the answer out of it with the SHIPPED\n252:    * `emailVerifiedFromUser`. That is the same pattern `completeSignup` uses for the GitHub handle\n253:    * (the GitHub leaf's gate-2 ruling R3), and it exists so the shipped extractor sits on the tested\n254:    * path rather than being a function no test ever runs — which is exactly how the future Discovery\n255:    * route will resolve the same fact from the same response.\n256:    *\n257:    * WHAT NO LOOP-TIER GREEN OVER IT PROVES: that the rendered shape is the shape GoTrue really\n258:    * sends. Only `loop/items/AI4DEV-59/proof-local.ts` check (d) touches that, by feeding a real\n259:    * response to the same shipped function.\n260:    */\n261:   emailVerified(accountId: string): Promise<boolean>;\n262:   /**\n263:    * The verification link emailed to this address, or `null` when none was emailed.\n264:    *\n265:    * `null` is a real answer rather than only the empty case: a provider registration is confirmed\n266:    * by the provider and no confirmation email is sent for it.\n267:    */\n268:   emailedVerificationLink(email: string): Promise<string | null>;\n269:   /**\n270:    * Use a verification link. Using the link Auth emailed for an address confirms that address; a\n271:    * link that was never issued returns `ok: false` and flips nothing.\n272:    *\n273:    * NO EXPIRY, NO SINGLE USE AND NO RESEND IS MODELLED OR ASSERTED. AT-001.11 is retired — the\n274:    * acceptance file's own words are that \"verification-link expiry/single-use/resend semantics are\n275:    * not stated in REQ-001\" — so building any of them here would be asserting a criterion that was\n276:    * deliberately withdrawn.\n277:    *\n278:    * THE NEVER-ISSUED NEGATIVE IS NOT AT-001.11 GROUND, and the difference is worth being exact\n279:    * about. It is not a claim about a link's lifetime; it guards this test's own oracle. A\n280:    * link-shaped string that verified an account it never belonged to would make \"using the emailed\n281:    * link is what flips it\" mean nothing at all, because any string would flip anything.\n282:    */\n283:   useVerificationLink(link: string): Promise<{ ok: boolean }>;\n284: \n285:   /* ----------------------------------- the two product operations ----------------------------- */\n286: \n287:   /** `supabase/functions/complete-signup` — turns an authenticated auth user into a typed account. */\n288:   completeSignup(session: Session, request: CompleteSignupRequest, ip: string): Promise<CompleteSignupOutcome>;\n289:   /** `supabase/functions/create-organization` — the NGO-only action AT-001.06 drives. */\n290:   createOrganization(session: Session, organizationName: string): Promise<CreateOrganizationOutcome>;\n291: \n292:   /* --------------------------- the Discovery gate's stand-in surface -------------------------- */\n293: \n294:   /**\n295:    * Attempt to send a Discovery message — AT-001.10's action.\n296:    *\n297:    * THERE IS NO DEPLOYED ROUTE BEHIND THIS, at either tier. See the fourth kind in this type's own\n298:    * header: the Discovery route is REQ-002/004's and does not exist, so this member is a stand-in\n299:    * surface that exists to put the SHIPPED `discoveryMessageAllowed` on a tested path. At loop\n300:    * tier the adapter derives the caller's verified fact through the shipped\n301:    * `emailVerifiedFromUser`, consults the shipped gate, and refuses with the GATE's own reason.\n302:    *\n303:    * THE BODY IS AN OPAQUE STRING AND NOTHING ELSE. Recipients, threads, attachments and message\n304:    * state are REQ-002/004's semantics; inventing any of them here to make this member look real\n305:    * would be building another requirement's surface early. What AT-001.10 needs is an attempted\n306:    * write and a way to see whether it happened, and one string supplies both.\n307:    */\n308:   sendDiscoveryMessage(session: Session, body: string): Promise<SendDiscoveryMessageOutcome>;\n309:   /**\n310:    * The Discovery message bodies this account has sent — read-back, and it is not optional.\n311:    *\n312:    * A BLOCK WHOSE WRITE HAPPENED ANYWAY IS NOT A BLOCK. The refusal's own return value cannot show\n313:    * that nothing was written, for the same reason `organizationsNamed` exists: a refusal hands\n314:    * back no identifier, so the row that must NOT be there can only be looked for by who would have\n315:    * written it.\n316:    */\n317:   discoveryMessagesBy(accountId: string): Promise<string[]>;\n318: \n319:   /* ------------------------------------------- read-back -------------------------------------- */\n320: \n321:   account(accountId: string): Promise<AccountRow | null>;\n322:   organization(organizationId: string): Promise<OrganizationRow | null>;\n323:   membership(organizationId: string, accountId: string): Promise<MembershipRow | null>;\n324:   acknowledgments(accountId: string): Promise<AcknowledgmentRow[]>;\n325:   /**\n326:    * The volunteer's imported GitHub profile, or `null` — AT-001.05's observable.\n327:    *\n328:    * `null` is a real and asserted answer, not merely the empty case: AT-001.05's pre-completion\n329:    * negative reads it AFTER the identity is linked and BEFORE the signup completes, and requires\n330:    * null there. That is what proves the population is CAUSED by completion rather than sitting in a\n331:    * queue somewhere waiting to be drained.\n332:    */\n333:   volunteerProfile(accountId: string): Promise<VolunteerProfileRow | null>;\n334: \n335:   /**\n336:    * The two read-backs a REFUSED action needs, which the keyed ones above cannot serve.\n337:    *\n338:    * Asserting that a rejection wrote nothing means looking for rows whose identifiers were never\n339:    * handed out — a refused `createOrganization` returns no organisation id. So one search by the\n340:    * name that was attempted, and one listing of everything an account is a member of. Without them\n341:    * the strongest statement available is \"the call said no\", and an implementation that writes both\n342:    * rows and then says no would satisfy it.\n343:    */\n344:   organizationsNamed(name: string): Promise<OrganizationRow[]>;\n345:   membershipsOf(accountId: string): Promise<MembershipRow[]>;\n346:   /**\n347:    * `public.has_platform_acknowledgment(account_id)` — the observable form of AT-001.01's \"before\n348:    * any project creation is possible\".\n349:    *\n350:    * It MUST DISCRIMINATE: false for an authenticated user who has not completed signup, true after.\n351:    * The body asserts both halves for exactly that reason.\n352:    *\n353:    * WHICH IMPLEMENTATION THAT ASSERTION REACHES depends on the tier, and the difference matters. At\n354:    * loop tier it reaches the fixture adapter's storage query, so what goes green is the RULE and the\n355:    * adapter's storage — the shipped SQL function could return true unconditionally and the loop tier\n356:    * would not notice. `public.has_platform_acknowledgment` itself is proved by step 7(h) of the\n357:    * plan, against the live database, and by nothing else in this item.\n358:    *\n359:    * What this leaf cannot do at either tier is ENFORCE the clause — nothing in the tree creates a\n360:    * project, and building project creation belongs to another requirement. This is the hook the leaf\n361:    * that lands project creation must call.\n362:    */\n363:   hasPlatformAcknowledgment(accountId: string): Promise<boolean>;\n364: \n365:   /* ------------------------------------ the provisioned admin --------------------------------- */\n366: \n367:   /**\n368:    * Provision a `platform_admin` — the ONLY legal way one exists, because the public path refuses\n369:    * the type. It sits apart from `completeSignup` rather than being one of its options for that\n370:    * reason.\n371:    *\n372:    * ON THE LIVE STACK THIS IS **NOT** A SERVICE-ROLE WRITE, and the correction matters more than\n373:    * most: this comment used to say it was, and a later reader following it would have granted the\n374:    * service role an INSERT on `public.accounts` — a write path straight past `complete_signup`'s\n375:    * `platform_admin` refusal, which is the one guard that sits on the only write path. The service\n376:    * role holds no INSERT anywhere in this schema, by measurement and by decision. Provisioning is a\n377:    * direct database operation by an operator: a NARROWER authority than the service role, not a\n378:    * wider one, and not one any running service holds.\n379:    */\n380:   provisionPlatformAdmin(email: string, password: string): Promise<Session>;\n381: };\n382: \n383: /* -------------------------------------------------------------------------------- the world */\n384: \n385: /**\n386:  * What REQ-001's fixture world adds to the shared seam.\n387:  *\n388:  * An INTERSECTION, not `interface World extends WorldSeam`, for the alias reason above.\n389:  *\n390:  * One member, and it earns its place: every test in this suite registers auth users, and two tests\n391:  * that happened to pick the same address would interfere in a way that looks like a product defect.\n392:  * `email()` namespaces an address to the world that issued it, so isolation is structural rather\n393:  * than a convention each body has to remember.\n394:  */\n395: export type World = WorldSeam & {\n396:   /** a mail address unique to THIS world, e.g. `email('ngo')` */\n397:   email(local: string): string;\n398: };\n\n(End of file - total 398 lines)\n</content>","metadata":{"preview":"/**\n * What REQ-001 adds to the shared harness contract.\n *\n * The generic seams — tier, clock, fixture worlds, sentinels, faults, static scan, config, vendor\n * sims, the harness shape itself — live in `tests/at/harness/contracts.ts` and are re-exported here\n * so a test body imports one file. What is genuinely REQ-001's is below: the accounts system under\n * test, the row shapes its assertions read back, and what this requirement's fixture world can do.\n *\n * TYPE ALIASES, NOT INTERFACES, throughout — the rule `harness/contracts.ts` states and gives its\n * reasons for. Nothing reachable from the objects `open()` hands a test body may be an interface,\n * because an interface can be reopened with `declare module` and an OPTIONAL member merged into it\n * reads `undefined` at run time while every type-check stays green.\n *\n * THE JUDGEMENT TYPES ARE IMPORTED FROM THE SHIPPED MODULE, not restated here. `AccountType`,\n * `CompleteSignupRequest` and the rest come from `supabase/functions/_shared/accounts.ts`, which is\n * the same module the two edge functions import. Restating them would be two independent statements\n * about one thing with nothing able to notice them diverging — and that is the defect this whole\n * harness exists to delete, not a shape to reproduce inside it.\n */\n","truncated":false,"loaded":[],"display":{"type":"file","path":"C:\\Users\\nirdr\\Downloads\\ai4good\\.claude\\worktrees\\agent-aa95110cbeab31aa7\\tests\\at\\suites\\req-001\\_contract.ts","text":"/**\n * What REQ-001 adds to the shared harness contract.\n *\n * The generic seams — tier, clock, fixture worlds, sentinels, faults, static scan, config, vendor\n * sims, the harness shape itself — live in `tests/at/harness/contracts.ts` and are re-exported here\n * so a test body imports one file. What is genuinely REQ-001's is below: the accounts system under\n * test, the row shapes its assertions read back, and what this requirement's fixture world can do.\n *\n * TYPE ALIASES, NOT INTERFACES, throughout — the rule `harness/contracts.ts` states and gives its\n * reasons for. Nothing reachable from the objects `open()` hands a test body may be an interface,\n * because an interface can be reopened with `declare module` and an OPTIONAL member merged into it\n * reads `undefined` at run time while every type-check stays green.\n *\n * THE JUDGEMENT TYPES ARE IMPORTED FROM THE SHIPPED MODULE, not restated here. `AccountType`,\n * `CompleteSignupRequest` and the rest come from `supabase/functions/_shared/accounts.ts`, which is\n * the same module the two edge functions import. Restating them would be two independent statements\n * about one thing with nothing able to notice them diverging — and that is the defect this whole\n * harness exists to delete, not a shape to reproduce inside it.\n */\n\nimport type { WorldSeam } from '../../harness/contracts.ts';\nimport type {\n  AccountType,\n  CompleteSignupRequest,\n} from '../../../../supabase/functions/_shared/accounts.ts';\n\nexport type {\n  Clock,\n  ConfigRegistry,\n  FaultHandle,\n  Faults,\n  Fixtures,\n  ProviderOutcome,\n  Sentinel,\n  Sentinels,\n  StaticScan,\n  Tier,\n  WorldSeam,\n} from '../../harness/contracts.ts';\nexport { TIERS } from '../../harness/contracts.ts';\n\nexport type { AccountType, CompleteSignupRequest };\n\n/* ------------------------------------------------------------------------- what gets read back */\n\n/** One row of `public.accounts` — one per authenticated user, holding exactly one global type. */\nexport type AccountRow = {\n  id: string;\n  accountType: AccountType;\n};\n\n/** One row of `public.organizations`. */\nexport type OrganizationRow = {\n  id: string;\n  name: string;\n};\n\n/** One row of `public.org_memberships` — the per-NGO role, which is NOT the global account type. */\nexport type MembershipRow = {\n  organizationId: string;\n  accountId: string;\n  role: 'admin' | 'member';\n};\n\n/**\n * One row of `public.acknowledgments` — EXACTLY the three fields AT-001.01 names recorded, plus the\n * account and kind that identify it.\n *\n * Name, title and authority attestation are AT-001.19's fields and belong to the acknowledgment-\n * identity deliverable (`loop/decomp/req-001.md` D4.L1), which is declared red by this leaf. They\n * are deliberately absent here: adding columns for a criterion this leaf does not test would be\n * speculation, and a reader would have no way to tell it from work that had been done.\n */\nexport type AcknowledgmentRow = {\n  accountId: string;\n  kind: string;\n  /** ISO-8601 instant — AT-001.01's \"timestamp\" */\n  acknowledgedAt: string;\n  /**\n   * AT-001.01's \"IP\": the address the gateway chain REPORTED, never a verified source address.\n   * Measured on the live local stack — a spoofed `x-forwarded-for` is stored verbatim, and with no\n   * header at all the stored value is the gateway's own hop. See `callerIp` in\n   * `supabase/functions/_shared/edge.ts`.\n   */\n  ip: string;\n  /** which version of the ToS + Platform Promise text was accepted — AT-001.01's \"text version\" */\n  textVersion: string;\n};\n\n/**\n * One row of `public.volunteer_profiles` — AT-001.05's \"profile\", and every column of it.\n *\n * THE STATS ARE THE STUB IMPORT FIXTURE'S, NOT GITHUB'S. `stubGithubStatsFor` in\n * `supabase/functions/_shared/github.ts` produces them, the decomposition manifest's cross-contract\n * ratifies that stand-in (\"stub import fixture until W3\"), and no code in this item calls\n * api.github.com. What the row proves is that onboarding FIRED and landed POPULATED — the\n * criterion's \"a queued-but-empty import fails this test\" — and not that any statistic is real.\n */\nexport type VolunteerProfileRow = {\n  accountId: string;\n  /** the handle of the GitHub identity linked to the account — AT-001.05's \"linked handle\" */\n  githubHandle: string;\n  /** AT-001.05's \"top languages\"; never empty, in the schema by CHECK and here by assertion */\n  topLanguages: string[];\n  /** AT-001.05's \"repository count\" */\n  repositoryCount: number;\n  /** AT-001.05's \"contribution summary\" */\n  contributionSummary: string;\n  /** ISO-8601 instant the import landed */\n  importedAt: string;\n};\n\n/* --------------------------------------------------------------------------------- the session */\n\n/**\n * An authenticated session, and WHICH PROVIDER ESTABLISHED IT.\n *\n * `provider` is recorded, never simulated. Supabase Auth records the provider that produced a\n * session; how the session was obtained — an email and a password, or a completed Google consent\n * round trip — happens entirely upstream of anything this requirement's leaf ships. AT-001.03's\n * body asserts that `completeSignup` behaves identically for `'google'` and `'email'`, which is a\n * real property of the shipped decision module (it never reads this field). It is NOT a claim that a\n * Google round trip works: see the suite's own note on AT-001.03, and the plan's per-id table.\n *\n * `'github'` joins the two for AT-001.02 and carries exactly the same caveat: a github-established\n * session is the state Auth is in AFTER a consent round trip, and no handshake is simulated to reach\n * it. The establishing provider still participates in NO decision the shipped modules make — the\n * volunteer gate reads a LINKED IDENTITY, which is a different fact (see `linkGithubIdentity`).\n */\nexport type SessionProvider = 'email' | 'google' | 'github';\n\nexport type Session = {\n  /** the auth user id, which is also the `public.accounts` primary key once signup completes */\n  accountId: string;\n  email: string;\n  provider: SessionProvider;\n};\n\n/* -------------------------------------------------------------------------------- the outcomes */\n\nexport type SignInOutcome = { ok: true; session: Session } | { ok: false; reason: string };\n\nexport type CompleteSignupOutcome =\n  | { ok: true; accountId: string; organizationId: string | null }\n  | { ok: false; reason: string };\n\nexport type CreateOrganizationOutcome = { ok: true; organizationId: string } | { ok: false; reason: string };\n\n/**\n * The outcome of an attempted Discovery message — and the refusal carries WHY, for the reason\n * `Decision` in the shipped module gives: AT-001.10 asserts that the block NAMES verification as\n * the remedy, so a bare boolean would make the criterion untestable.\n */\nexport type SendDiscoveryMessageOutcome = { ok: true } | { ok: false; reason: string };\n\n/* ------------------------------------------------------------------------------------ the SUT */\n\n/**\n * REQ-001's accounts system under test.\n *\n * The split is the point, and there are now FOUR kinds of member here rather than three:\n *\n *   1. THE TWO PRODUCT OPERATIONS — `completeSignup` and `createOrganization`. At loop tier the\n *      adapter runs them over its own storage but delegates every judgement to\n *      `supabase/functions/_shared/accounts.ts`, the module the edge functions import; at\n *      integration tier they would be the deployed edge functions.\n *   2. SUPABASE AUTH'S HALF — registration, sign-in, identity linking, and the verification state\n *      (`emailVerified`, `emailedVerificationLink`, `useVerificationLink`). None of it is this\n *      requirement's code. It is what produces the states the product operations judge.\n *   3. READ-BACK — the row shapes an assertion reads after the fact.\n *   4. ONE STAND-IN SURFACE, AND IT IS THE ONLY ONE — `sendDiscoveryMessage`, with\n *      `discoveryMessagesBy` reading it back.\n *\n * THE FOURTH KIND NEEDS ITS OWN SENTENCE, because it is the one that could be misread. NO\n * DISCOVERY ROUTE EXISTS IN THIS TREE. The Discovery message route is REQ-002/004's, and what\n * this requirement's leaf ships is the DECISION that route must consult —\n * `discoveryMessageAllowed` in `supabase/functions/_shared/verification.ts`. So\n * `sendDiscoveryMessage` is not a deployed operation being tested; it is a stand-in surface whose\n * only job is to put the shipped decision on a tested path, exactly as\n * `hasPlatformAcknowledgment` below is the hook a project-creation leaf must call. A green over\n * it says the DECISION is right. It says nothing about enforcement anywhere, because there is\n * nowhere yet to enforce it.\n */\nexport type AccountsSut = {\n  /** AT-001.07's second clause: which types the PUBLIC signup surface offers. */\n  publicSignupAccountTypes(): Promise<readonly string[]>;\n\n  /* --- Supabase Auth's half. Not this leaf's code; it is what produces a session to complete. --- */\n\n  /**\n   * Register an auth user with an email and a password, and return the resulting session.\n   *\n   * IT STILL RETURNS A SESSION, AND THE HONEST GAP THAT LEAVES IS STATED HERE RATHER THAN HIDDEN.\n   * With `enable_confirmations = true` the live GoTrue issues NO session at signup, so on the real\n   * stack a completed-but-unverified account is not reachable by the public path. This fixture's\n   * `Session` has always been an identity handle rather than an access token, and session ISSUANCE\n   * is D2.L2's subject (AT-001.12, .13 — declared red). So at the loop tier such an account IS\n   * constructible, and AT-001.10's body constructs one deliberately: the gate exists because\n   * decision-8 makes verification the write path's own floor, not a property borrowed from the\n   * session layer. The live-stack behaviour is measured in `loop/items/AI4DEV-59/proof-local.ts`\n   * checks (a) and (c), and nowhere else in this item.\n   */\n  registerWithEmailPassword(email: string, password: string): Promise<Session>;\n  /**\n   * A session Auth recorded as having come from an external provider.\n   *\n   * It performs NO handshake and fabricates no authorization code or token exchange: it is the state\n   * Auth is in AFTER a consent round trip, which is the only part of the story any agent can reach.\n   */\n  registerWithProvider(provider: SessionProvider, email: string): Promise<Session>;\n  /**\n   * A GitHub OAuth signup, as Auth records it: a session established by GitHub whose account already\n   * carries the linked GitHub identity — AT-001.02's \"signs up via GitHub OAuth\".\n   *\n   * Like `registerWithProvider` it performs NO handshake. It is `registerWithProvider('github', …)`\n   * plus the fact that a GitHub signup necessarily links the GitHub identity it signed up with, and\n   * it is a separate member rather than an argument because that second half is what AT-001.02's\n   * \"the GitHub identity is linked to it\" clause is about.\n   */\n  registerWithGithub(email: string, githubHandle: string): Promise<Session>;\n  /**\n   * The state Auth is in after a `linkIdentity` round trip — AT-001.04's \"linking completes signup\".\n   *\n   * A LINKED IDENTITY IS NOT THE ESTABLISHING PROVIDER, and keeping the two apart is the point of\n   * this member existing at all: an email- or Google-established volunteer links GitHub and their\n   * session's `provider` does not change. The gate in\n   * `supabase/functions/_shared/accounts.ts` reads the link; nothing shipped reads the provider.\n   *\n   * Same posture as every other Auth member here — no handshake, no fabricated authorization code.\n   */\n  linkGithubIdentity(session: Session, githubHandle: string): Promise<void>;\n  /** Return sign-in with the same credentials — AT-001.01's final clause. */\n  signInWithEmailPassword(email: string, password: string): Promise<SignInOutcome>;\n  /**\n   * The return visit through an external provider — AT-001.02's \"a later sign-in via GitHub returns\n   * to the same account\".\n   *\n   * What it asserts is IDENTITY CONTINUITY, which is the half of that clause reachable without a\n   * person: an existing user whose account carries that provider's identity signs in to the SAME\n   * account rather than to a second one. The consent round trip itself is not performed and is named\n   * unproved in the plan's per-id table.\n   */\n  signInWithProvider(provider: SessionProvider, email: string): Promise<SignInOutcome>;\n\n  /* ------------------------- Supabase Auth's verification state ------------------------------- */\n\n  /**\n   * Whether Supabase Auth reports this account's email address confirmed — AT-001.09's observable.\n   *\n   * IT IS DERIVED, NOT STORED-AND-READ. The adapter renders the account's stored Auth state as the\n   * canonical GoTrue `/auth/v1/user` shape and judges the answer out of it with the SHIPPED\n   * `emailVerifiedFromUser`. That is the same pattern `completeSignup` uses for the GitHub handle\n   * (the GitHub leaf's gate-2 ruling R3), and it exists so the shipped extractor sits on the tested\n   * path rather than being a function no test ever runs — which is exactly how the future Discovery\n   * route will resolve the same fact from the same response.\n   *\n   * WHAT NO LOOP-TIER GREEN OVER IT PROVES: that the rendered shape is the shape GoTrue really\n   * sends. Only `loop/items/AI4DEV-59/proof-local.ts` check (d) touches that, by feeding a real\n   * response to the same shipped function.\n   */\n  emailVerified(accountId: string): Promise<boolean>;\n  /**\n   * The verification link emailed to this address, or `null` when none was emailed.\n   *\n   * `null` is a real answer rather than only the empty case: a provider registration is confirmed\n   * by the provider and no confirmation email is sent for it.\n   */\n  emailedVerificationLink(email: string): Promise<string | null>;\n  /**\n   * Use a verification link. Using the link Auth emailed for an address confirms that address; a\n   * link that was never issued returns `ok: false` and flips nothing.\n   *\n   * NO EXPIRY, NO SINGLE USE AND NO RESEND IS MODELLED OR ASSERTED. AT-001.11 is retired — the\n   * acceptance file's own words are that \"verification-link expiry/single-use/resend semantics are\n   * not stated in REQ-001\" — so building any of them here would be asserting a criterion that was\n   * deliberately withdrawn.\n   *\n   * THE NEVER-ISSUED NEGATIVE IS NOT AT-001.11 GROUND, and the difference is worth being exact\n   * about. It is not a claim about a link's lifetime; it guards this test's own oracle. A\n   * link-shaped string that verified an account it never belonged to would make \"using the emailed\n   * link is what flips it\" mean nothing at all, because any string would flip anything.\n   */\n  useVerificationLink(link: string): Promise<{ ok: boolean }>;\n\n  /* ----------------------------------- the two product operations ----------------------------- */\n\n  /** `supabase/functions/complete-signup` — turns an authenticated auth user into a typed account. */\n  completeSignup(session: Session, request: CompleteSignupRequest, ip: string): Promise<CompleteSignupOutcome>;\n  /** `supabase/functions/create-organization` — the NGO-only action AT-001.06 drives. */\n  createOrganization(session: Session, organizationName: string): Promise<CreateOrganizationOutcome>;\n\n  /* --------------------------- the Discovery gate's stand-in surface -------------------------- */\n\n  /**\n   * Attempt to send a Discovery message — AT-001.10's action.\n   *\n   * THERE IS NO DEPLOYED ROUTE BEHIND THIS, at either tier. See the fourth kind in this type's own\n   * header: the Discovery route is REQ-002/004's and does not exist, so this member is a stand-in\n   * surface that exists to put the SHIPPED `discoveryMessageAllowed` on a tested path. At loop\n   * tier the adapter derives the caller's verified fact through the shipped\n   * `emailVerifiedFromUser`, consults the shipped gate, and refuses with the GATE's own reason.\n   *\n   * THE BODY IS AN OPAQUE STRING AND NOTHING ELSE. Recipients, threads, attachments and message\n   * state are REQ-002/004's semantics; inventing any of them here to make this member look real\n   * would be building another requirement's surface early. What AT-001.10 needs is an attempted\n   * write and a way to see whether it happened, and one string supplies both.\n   */\n  sendDiscoveryMessage(session: Session, body: string): Promise<SendDiscoveryMessageOutcome>;\n  /**\n   * The Discovery message bodies this account has sent — read-back, and it is not optional.\n   *\n   * A BLOCK WHOSE WRITE HAPPENED ANYWAY IS NOT A BLOCK. The refusal's own return value cannot show\n   * that nothing was written, for the same reason `organizationsNamed` exists: a refusal hands\n   * back no identifier, so the row that must NOT be there can only be looked for by who would have\n   * written it.\n   */\n  discoveryMessagesBy(accountId: string): Promise<string[]>;\n\n  /* ------------------------------------------- read-back -------------------------------------- */\n\n  account(accountId: string): Promise<AccountRow | null>;\n  organization(organizationId: string): Promise<OrganizationRow | null>;\n  membership(organizationId: string, accountId: string): Promise<MembershipRow | null>;\n  acknowledgments(accountId: string): Promise<AcknowledgmentRow[]>;\n  /**\n   * The volunteer's imported GitHub profile, or `null` — AT-001.05's observable.\n   *\n   * `null` is a real and asserted answer, not merely the empty case: AT-001.05's pre-completion\n   * negative reads it AFTER the identity is linked and BEFORE the signup completes, and requires\n   * null there. That is what proves the population is CAUSED by completion rather than sitting in a\n   * queue somewhere waiting to be drained.\n   */\n  volunteerProfile(accountId: string): Promise<VolunteerProfileRow | null>;\n\n  /**\n   * The two read-backs a REFUSED action needs, which the keyed ones above cannot serve.\n   *\n   * Asserting that a rejection wrote nothing means looking for rows whose identifiers were never\n   * handed out — a refused `createOrganization` returns no organisation id. So one search by the\n   * name that was attempted, and one listing of everything an account is a member of. Without them\n   * the strongest statement available is \"the call said no\", and an implementation that writes both\n   * rows and then says no would satisfy it.\n   */\n  organizationsNamed(name: string): Promise<OrganizationRow[]>;\n  membershipsOf(accountId: string): Promise<MembershipRow[]>;\n  /**\n   * `public.has_platform_acknowledgment(account_id)` — the observable form of AT-001.01's \"before\n   * any project creation is possible\".\n   *\n   * It MUST DISCRIMINATE: false for an authenticated user who has not completed signup, true after.\n   * The body asserts both halves for exactly that reason.\n   *\n   * WHICH IMPLEMENTATION THAT ASSERTION REACHES depends on the tier, and the difference matters. At\n   * loop tier it reaches the fixture adapter's storage query, so what goes green is the RULE and the\n   * adapter's storage — the shipped SQL function could return true unconditionally and the loop tier\n   * would not notice. `public.has_platform_acknowledgment` itself is proved by step 7(h) of the\n   * plan, against the live database, and by nothing else in this item.\n   *\n   * What this leaf cannot do at either tier is ENFORCE the clause — nothing in the tree creates a\n   * project, and building project creation belongs to another requirement. This is the hook the leaf\n   * that lands project creation must call.\n   */\n  hasPlatformAcknowledgment(accountId: string): Promise<boolean>;\n\n  /* ------------------------------------ the provisioned admin --------------------------------- */\n\n  /**\n   * Provision a `platform_admin` — the ONLY legal way one exists, because the public path refuses\n   * the type. It sits apart from `completeSignup` rather than being one of its options for that\n   * reason.\n   *\n   * ON THE LIVE STACK THIS IS **NOT** A SERVICE-ROLE WRITE, and the correction matters more than\n   * most: this comment used to say it was, and a later reader following it would have granted the\n   * service role an INSERT on `public.accounts` — a write path straight past `complete_signup`'s\n   * `platform_admin` refusal, which is the one guard that sits on the only write path. The service\n   * role holds no INSERT anywhere in this schema, by measurement and by decision. Provisioning is a\n   * direct database operation by an operator: a NARROWER authority than the service role, not a\n   * wider one, and not one any running service holds.\n   */\n  provisionPlatformAdmin(email: string, password: string): Promise<Session>;\n};\n\n/* -------------------------------------------------------------------------------- the world */\n\n/**\n * What REQ-001's fixture world adds to the shared seam.\n *\n * An INTERSECTION, not `interface World extends WorldSeam`, for the alias reason above.\n *\n * One member, and it earns its place: every test in this suite registers auth users, and two tests\n * that happened to pick the same address would interfere in a way that looks like a product defect.\n * `email()` namespaces an address to the world that issued it, so isolation is structural rather\n * than a convention each body has to remember.\n */\nexport type World = WorldSeam & {\n  /** a mail address unique to THIS world, e.g. `email('ngo')` */\n  email(local: string): string;\n};","lineStart":1,"lineEnd":398,"totalLines":398,"truncated":false}},"title":"tests\\at\\suites\\req-001\\_contract.ts","time":{"start":1786290444173,"end":1786290444180}},"id":"prt_fe73516700016zNhGScdblPGXC","sessionID":"ses_018cbdef8ffeIiDUqdR6dh2IlP","messageID":"msg_fe734f578001LZ7j7nF32EROiX"}}
0c389c633b9867b93b1466a77c75d5bc9df66f56:loop/items/AI4DEV-81/artifacts/audit-luna.stderr.log:24843:466880d:loop/items/AI4DEV-59/artifacts/audit-luna.stderr.log:10252:C:\Users\nirdr\Downloads\ai4good\.claude\worktrees\agent-aa95110cbeab31aa7\loop\items\AI4DEV-59\artifacts\audit-flash.events.jsonl:33:{"type":"tool_use","timestamp":1786290444182,"sessionID":"ses_018cbdef8ffeIiDUqdR6dh2IlP","part":{"type":"tool","tool":"read","callID":"call_00_wof8OsVw4YgOgoFgxgmI3660","state":{"status":"completed","input":{"filePath":"C:\\Users\\nirdr\\Downloads\\ai4good\\.claude\\worktrees\\agent-aa95110cbeab31aa7\\tests\\at\\suites\\req-001\\_contract.ts"},"output":"<path>C:\\Users\\nirdr\\Downloads\\ai4good\\.claude\\worktrees\\agent-aa95110cbeab31aa7\\tests\\at\\suites\\req-001\\_contract.ts</path>\n<type>file</type>\n<content>\n1: /**\n2:  * What REQ-001 adds to the shared harness contract.\n3:  *\n4:  * The generic seams — tier, clock, fixture worlds, sentinels, faults, static scan, config, vendor\n5:  * sims, the harness shape itself — live in `tests/at/harness/contracts.ts` and are re-exported here\n6:  * so a test body imports one file. What is genuinely REQ-001's is below: the accounts system under\n7:  * test, the row shapes its assertions read back, and what this requirement's fixture world can do.\n8:  *\n9:  * TYPE ALIASES, NOT INTERFACES, throughout — the rule `harness/contracts.ts` states and gives its\n10:  * reasons for. Nothing reachable from the objects `open()` hands a test body may be an interface,\n11:  * because an interface can be reopened with `declare module` and an OPTIONAL member merged into it\n12:  * reads `undefined` at run time while every type-check stays green.\n13:  *\n14:  * THE JUDGEMENT TYPES ARE IMPORTED FROM THE SHIPPED MODULE, not restated here. `AccountType`,\n15:  * `CompleteSignupRequest` and the rest come from `supabase/functions/_shared/accounts.ts`, which is\n16:  * the same module the two edge functions import. Restating them would be two independent statements\n17:  * about one thing with nothing able to notice them diverging — and that is the defect this whole\n18:  * harness exists to delete, not a shape to reproduce inside it.\n19:  */\n20: \n21: import type { WorldSeam } from '../../harness/contracts.ts';\n22: import type {\n23:   AccountType,\n24:   CompleteSignupRequest,\n25: } from '../../../../supabase/functions/_shared/accounts.ts';\n26: \n27: export type {\n28:   Clock,\n29:   ConfigRegistry,\n30:   FaultHandle,\n31:   Faults,\n32:   Fixtures,\n33:   ProviderOutcome,\n34:   Sentinel,\n35:   Sentinels,\n36:   StaticScan,\n37:   Tier,\n38:   WorldSeam,\n39: } from '../../harness/contracts.ts';\n40: export { TIERS } from '../../harness/contracts.ts';\n41: \n42: export type { AccountType, CompleteSignupRequest };\n43: \n44: /* ------------------------------------------------------------------------- what gets read back */\n45: \n46: /** One row of `public.accounts` — one per authenticated user, holding exactly one global type. */\n47: export type AccountRow = {\n48:   id: string;\n49:   accountType: AccountType;\n50: };\n51: \n52: /** One row of `public.organizations`. */\n53: export type OrganizationRow = {\n54:   id: string;\n55:   name: string;\n56: };\n57: \n58: /** One row of `public.org_memberships` — the per-NGO role, which is NOT the global account type. */\n59: export type MembershipRow = {\n60:   organizationId: string;\n61:   accountId: string;\n62:   role: 'admin' | 'member';\n63: };\n64: \n65: /**\n66:  * One row of `public.acknowledgments` — EXACTLY the three fields AT-001.01 names recorded, plus the\n67:  * account and kind that identify it.\n68:  *\n69:  * Name, title and authority attestation are AT-001.19's fields and belong to the acknowledgment-\n70:  * identity deliverable (`loop/decomp/req-001.md` D4.L1), which is declared red by this leaf. They\n71:  * are deliberately absent here: adding columns for a criterion this leaf does not test would be\n72:  * speculation, and a reader would have no way to tell it from work that had been done.\n73:  */\n74: export type AcknowledgmentRow = {\n75:   accountId: string;\n76:   kind: string;\n77:   /** ISO-8601 instant — AT-001.01's \"timestamp\" */\n78:   acknowledgedAt: string;\n79:   /**\n80:    * AT-001.01's \"IP\": the address the gateway chain REPORTED, never a verified source address.\n81:    * Measured on the live local stack — a spoofed `x-forwarded-for` is stored verbatim, and with no\n82:    * header at all the stored value is the gateway's own hop. See `callerIp` in\n83:    * `supabase/functions/_shared/edge.ts`.\n84:    */\n85:   ip: string;\n86:   /** which version of the ToS + Platform Promise text was accepted — AT-001.01's \"text version\" */\n87:   textVersion: string;\n88: };\n89: \n90: /**\n91:  * One row of `public.volunteer_profiles` — AT-001.05's \"profile\", and every column of it.\n92:  *\n93:  * THE STATS ARE THE STUB IMPORT FIXTURE'S, NOT GITHUB'S. `stubGithubStatsFor` in\n94:  * `supabase/functions/_shared/github.ts` produces them, the decomposition manifest's cross-contract\n95:  * ratifies that stand-in (\"stub import fixture until W3\"), and no code in this item calls\n96:  * api.github.com. What the row proves is that onboarding FIRED and landed POPULATED — the\n97:  * criterion's \"a queued-but-empty import fails this test\" — and not that any statistic is real.\n98:  */\n99: export type VolunteerProfileRow = {\n100:   accountId: string;\n101:   /** the handle of the GitHub identity linked to the account — AT-001.05's \"linked handle\" */\n102:   githubHandle: string;\n103:   /** AT-001.05's \"top languages\"; never empty, in the schema by CHECK and here by assertion */\n104:   topLanguages: string[];\n105:   /** AT-001.05's \"repository count\" */\n106:   repositoryCount: number;\n107:   /** AT-001.05's \"contribution summary\" */\n108:   contributionSummary: string;\n109:   /** ISO-8601 instant the import landed */\n110:   importedAt: string;\n111: };\n112: \n113: /* --------------------------------------------------------------------------------- the session */\n114: \n115: /**\n116:  * An authenticated session, and WHICH PROVIDER ESTABLISHED IT.\n117:  *\n118:  * `provider` is recorded, never simulated. Supabase Auth records the provider that produced a\n119:  * session; how the session was obtained — an email and a password, or a completed Google consent\n120:  * round trip — happens entirely upstream of anything this requirement's leaf ships. AT-001.03's\n121:  * body asserts that `completeSignup` behaves identically for `'google'` and `'email'`, which is a\n122:  * real property of the shipped decision module (it never reads this field). It is NOT a claim that a\n123:  * Google round trip works: see the suite's own note on AT-001.03, and the plan's per-id table.\n124:  *\n125:  * `'github'` joins the two for AT-001.02 and carries exactly the same caveat: a github-established\n126:  * session is the state Auth is in AFTER a consent round trip, and no handshake is simulated to reach\n127:  * it. The establishing provider still participates in NO decision the shipped modules make — the\n128:  * volunteer gate reads a LINKED IDENTITY, which is a different fact (see `linkGithubIdentity`).\n129:  */\n130: export type SessionProvider = 'email' | 'google' | 'github';\n131: \n132: export type Session = {\n133:   /** the auth user id, which is also the `public.accounts` primary key once signup completes */\n134:   accountId: string;\n135:   email: string;\n136:   provider: SessionProvider;\n137: };\n138: \n139: /* -------------------------------------------------------------------------------- the outcomes */\n140: \n141: export type SignInOutcome = { ok: true; session: Session } | { ok: false; reason: string };\n142: \n143: export type CompleteSignupOutcome =\n144:   | { ok: true; accountId: string; organizationId: string | null }\n145:   | { ok: false; reason: string };\n146: \n147: export type CreateOrganizationOutcome = { ok: true; organizationId: string } | { ok: false; reason: string };\n148: \n149: /**\n150:  * The outcome of an attempted Discovery message — and the refusal carries WHY, for the reason\n151:  * `Decision` in the shipped module gives: AT-001.10 asserts that the block NAMES verification as\n152:  * the remedy, so a bare boolean would make the criterion untestable.\n153:  */\n154: export type SendDiscoveryMessageOutcome = { ok: true } | { ok: false; reason: string };\n155: \n156: /* ------------------------------------------------------------------------------------ the SUT */\n157: \n158: /**\n159:  * REQ-001's accounts system under test.\n160:  *\n161:  * The split is the point, and there are now FOUR kinds of member here rather than three:\n162:  *\n163:  *   1. THE TWO PRODUCT OPERATIONS — `completeSignup` and `createOrganization`. At loop tier the\n164:  *      adapter runs them over its own storage but delegates every judgement to\n165:  *      `supabase/functions/_shared/accounts.ts`, the module the edge functions import; at\n166:  *      integration tier they would be the deployed edge functions.\n167:  *   2. SUPABASE AUTH'S HALF — registration, sign-in, identity linking, and the verification state\n168:  *      (`emailVerified`, `emailedVerificationLink`, `useVerificationLink`). None of it is this\n169:  *      requirement's code. It is what produces the states the product operations judge.\n170:  *   3. READ-BACK — the row shapes an assertion reads after the fact.\n171:  *   4. ONE STAND-IN SURFACE, AND IT IS THE ONLY ONE — `sendDiscoveryMessage`, with\n172:  *      `discoveryMessagesBy` reading it back.\n173:  *\n174:  * THE FOURTH KIND NEEDS ITS OWN SENTENCE, because it is the one that could be misread. NO\n175:  * DISCOVERY ROUTE EXISTS IN THIS TREE. The Discovery message route is REQ-002/004's, and what\n176:  * this requirement's leaf ships is the DECISION that route must consult —\n177:  * `discoveryMessageAllowed` in `supabase/functions/_shared/verification.ts`. So\n178:  * `sendDiscoveryMessage` is not a deployed operation being tested; it is a stand-in surface whose\n179:  * only job is to put the shipped decision on a tested path, exactly as\n180:  * `hasPlatformAcknowledgment` below is the hook a project-creation leaf must call. A green over\n181:  * it says the DECISION is right. It says nothing about enforcement anywhere, because there is\n182:  * nowhere yet to enforce it.\n183:  */\n184: export type AccountsSut = {\n185:   /** AT-001.07's second clause: which types the PUBLIC signup surface offers. */\n186:   publicSignupAccountTypes(): Promise<readonly string[]>;\n187: \n188:   /* --- Supabase Auth's half. Not this leaf's code; it is what produces a session to complete. --- */\n189: \n190:   /**\n191:    * Register an auth user with an email and a password, and return the resulting session.\n192:    *\n193:    * IT STILL RETURNS A SESSION, AND THE HONEST GAP THAT LEAVES IS STATED HERE RATHER THAN HIDDEN.\n194:    * With `enable_confirmations = true` the live GoTrue issues NO session at signup, so on the real\n195:    * stack a completed-but-unverified account is not reachable by the public path. This fixture's\n196:    * `Session` has always been an identity handle rather than an access token, and session ISSUANCE\n197:    * is D2.L2's subject (AT-001.12, .13 — declared red). So at the loop tier such an account IS\n198:    * constructible, and AT-001.10's body constructs one deliberately: the gate exists because\n199:    * decision-8 makes verification the write path's own floor, not a property borrowed from the\n200:    * session layer. The live-stack behaviour is measured in `loop/items/AI4DEV-59/proof-local.ts`\n201:    * checks (a) and (c), and nowhere else in this item.\n202:    */\n203:   registerWithEmailPassword(email: string, password: string): Promise<Session>;\n204:   /**\n205:    * A session Auth recorded as having come from an external provider.\n206:    *\n207:    * It performs NO handshake and fabricates no authorization code or token exchange: it is the state\n208:    * Auth is in AFTER a consent round trip, which is the only part of the story any agent can reach.\n209:    */\n210:   registerWithProvider(provider: SessionProvider, email: string): Promise<Session>;\n211:   /**\n212:    * A GitHub OAuth signup, as Auth records it: a session established by GitHub whose account already\n213:    * carries the linked GitHub identity — AT-001.02's \"signs up via GitHub OAuth\".\n214:    *\n215:    * Like `registerWithProvider` it performs NO handshake. It is `registerWithProvider('github', …)`\n216:    * plus the fact that a GitHub signup necessarily links the GitHub identity it signed up with, and\n217:    * it is a separate member rather than an argument because that second half is what AT-001.02's\n218:    * \"the GitHub identity is linked to it\" clause is about.\n219:    */\n220:   registerWithGithub(email: string, githubHandle: string): Promise<Session>;\n221:   /**\n222:    * The state Auth is in after a `linkIdentity` round trip — AT-001.04's \"linking completes signup\".\n223:    *\n224:    * A LINKED IDENTITY IS NOT THE ESTABLISHING PROVIDER, and keeping the two apart is the point of\n225:    * this member existing at all: an email- or Google-established volunteer links GitHub and their\n226:    * session's `provider` does not change. The gate in\n227:    * `supabase/functions/_shared/accounts.ts` reads the link; nothing shipped reads the provider.\n228:    *\n229:    * Same posture as every other Auth member here — no handshake, no fabricated authorization code.\n230:    */\n231:   linkGithubIdentity(session: Session, githubHandle: string): Promise<void>;\n232:   /** Return sign-in with the same credentials — AT-001.01's final clause. */\n233:   signInWithEmailPassword(email: string, password: string): Promise<SignInOutcome>;\n234:   /**\n235:    * The return visit through an external provider — AT-001.02's \"a later sign-in via GitHub returns\n236:    * to the same account\".\n237:    *\n238:    * What it asserts is IDENTITY CONTINUITY, which is the half of that clause reachable without a\n239:    * person: an existing user whose account carries that provider's identity signs in to the SAME\n240:    * account rather than to a second one. The consent round trip itself is not performed and is named\n241:    * unproved in the plan's per-id table.\n242:    */\n243:   signInWithProvider(provider: SessionProvider, email: string): Promise<SignInOutcome>;\n244: \n245:   /* ------------------------- Supabase Auth's verification state ------------------------------- */\n246: \n247:   /**\n248:    * Whether Supabase Auth reports this account's email address confirmed — AT-001.09's observable.\n249:    *\n250:    * IT IS DERIVED, NOT STORED-AND-READ. The adapter renders the account's stored Auth state as the\n251:    * canonical GoTrue `/auth/v1/user` shape and judges the answer out of it with the SHIPPED\n252:    * `emailVerifiedFromUser`. That is the same pattern `completeSignup` uses for the GitHub handle\n253:    * (the GitHub leaf's gate-2 ruling R3), and it exists so the shipped extractor sits on the tested\n254:    * path rather than being a function no test ever runs — which is exactly how the future Discovery\n255:    * route will resolve the same fact from the same response.\n256:    *\n257:    * WHAT NO LOOP-TIER GREEN OVER IT PROVES: that the rendered shape is the shape GoTrue really\n258:    * sends. Only `loop/items/AI4DEV-59/proof-local.ts` check (d) touches that, by feeding a real\n259:    * response to the same shipped function.\n260:    */\n261:   emailVerified(accountId: string): Promise<boolean>;\n262:   /**\n263:    * The verification link emailed to this address, or `null` when none was emailed.\n264:    *\n265:    * `null` is a real answer rather than only the empty case: a provider registration is confirmed\n266:    * by the provider and no confirmation email is sent for it.\n267:    */\n268:   emailedVerificationLink(email: string): Promise<string | null>;\n269:   /**\n270:    * Use a verification link. Using the link Auth emailed for an address confirms that address; a\n271:    * link that was never issued returns `ok: false` and flips nothing.\n272:    *\n273:    * NO EXPIRY, NO SINGLE USE AND NO RESEND IS MODELLED OR ASSERTED. AT-001.11 is retired — the\n274:    * acceptance file's own words are that \"verification-link expiry/single-use/resend semantics are\n275:    * not stated in REQ-001\" — so building any of them here would be asserting a criterion that was\n276:    * deliberately withdrawn.\n277:    *\n278:    * THE NEVER-ISSUED NEGATIVE IS NOT AT-001.11 GROUND, and the difference is worth being exact\n279:    * about. It is not a claim about a link's lifetime; it guards this test's own oracle. A\n280:    * link-shaped string that verified an account it never belonged to would make \"using the emailed\n281:    * link is what flips it\" mean nothing at all, because any string would flip anything.\n282:    */\n283:   useVerificationLink(link: string): Promise<{ ok: boolean }>;\n284: \n285:   /* ----------------------------------- the two product operations ----------------------------- */\n286: \n287:   /** `supabase/functions/complete-signup` — turns an authenticated auth user into a typed account. */\n288:   completeSignup(session: Session, request: CompleteSignupRequest, ip: string): Promise<CompleteSignupOutcome>;\n289:   /** `supabase/functions/create-organization` — the NGO-only action AT-001.06 drives. */\n290:   createOrganization(session: Session, organizationName: string): Promise<CreateOrganizationOutcome>;\n291: \n292:   /* --------------------------- the Discovery gate's stand-in surface -------------------------- */\n293: \n294:   /**\n295:    * Attempt to send a Discovery message — AT-001.10's action.\n296:    *\n297:    * THERE IS NO DEPLOYED ROUTE BEHIND THIS, at either tier. See the fourth kind in this type's own\n298:    * header: the Discovery route is REQ-002/004's and does not exist, so this member is a stand-in\n299:    * surface that exists to put the SHIPPED `discoveryMessageAllowed` on a tested path. At loop\n300:    * tier the adapter derives the caller's verified fact through the shipped\n301:    * `emailVerifiedFromUser`, consults the shipped gate, and refuses with the GATE's own reason.\n302:    *\n303:    * THE BODY IS AN OPAQUE STRING AND NOTHING ELSE. Recipients, threads, attachments and message\n304:    * state are REQ-002/004's semantics; inventing any of them here to make this member look real\n305:    * would be building another requirement's surface early. What AT-001.10 needs is an attempted\n306:    * write and a way to see whether it happened, and one string supplies both.\n307:    */\n308:   sendDiscoveryMessage(session: Session, body: string): Promise<SendDiscoveryMessageOutcome>;\n309:   /**\n310:    * The Discovery message bodies this account has sent — read-back, and it is not optional.\n311:    *\n312:    * A BLOCK WHOSE WRITE HAPPENED ANYWAY IS NOT A BLOCK. The refusal's own return value cannot show\n313:    * that nothing was written, for the same reason `organizationsNamed` exists: a refusal hands\n314:    * back no identifier, so the row that must NOT be there can only be looked for by who would have\n315:    * written it.\n316:    */\n317:   discoveryMessagesBy(accountId: string): Promise<string[]>;\n318: \n319:   /* ------------------------------------------- read-back -------------------------------------- */\n320: \n321:   account(accountId: string): Promise<AccountRow | null>;\n322:   organization(organizationId: string): Promise<OrganizationRow | null>;\n323:   membership(organizationId: string, accountId: string): Promise<MembershipRow | null>;\n324:   acknowledgments(accountId: string): Promise<AcknowledgmentRow[]>;\n325:   /**\n326:    * The volunteer's imported GitHub profile, or `null` — AT-001.05's observable.\n327:    *\n328:    * `null` is a real and asserted answer, not merely the empty case: AT-001.05's pre-completion\n329:    * negative reads it AFTER the identity is linked and BEFORE the signup completes, and requires\n330:    * null there. That is what proves the population is CAUSED by completion rather than sitting in a\n331:    * queue somewhere waiting to be drained.\n332:    */\n333:   volunteerProfile(accountId: string): Promise<VolunteerProfileRow | null>;\n334: \n335:   /**\n336:    * The two read-backs a REFUSED action needs, which the keyed ones above cannot serve.\n337:    *\n338:    * Asserting that a rejection wrote nothing means looking for rows whose identifiers were never\n339:    * handed out — a refused `createOrganization` returns no organisation id. So one search by the\n340:    * name that was attempted, and one listing of everything an account is a member of. Without them\n341:    * the strongest statement available is \"the call said no\", and an implementation that writes both\n342:    * rows and then says no would satisfy it.\n343:    */\n344:   organizationsNamed(name: string): Promise<OrganizationRow[]>;\n345:   membershipsOf(accountId: string): Promise<MembershipRow[]>;\n346:   /**\n347:    * `public.has_platform_acknowledgment(account_id)` — the observable form of AT-001.01's \"before\n348:    * any project creation is possible\".\n349:    *\n350:    * It MUST DISCRIMINATE: false for an authenticated user who has not completed signup, true after.\n351:    * The body asserts both halves for exactly that reason.\n352:    *\n353:    * WHICH IMPLEMENTATION THAT ASSERTION REACHES depends on the tier, and the difference matters. At\n354:    * loop tier it reaches the fixture adapter's storage query, so what goes green is the RULE and the\n355:    * adapter's storage — the shipped SQL function could return true unconditionally and the loop tier\n356:    * would not notice. `public.has_platform_acknowledgment` itself is proved by step 7(h) of the\n357:    * plan, against the live database, and by nothing else in this item.\n358:    *\n359:    * What this leaf cannot do at either tier is ENFORCE the clause — nothing in the tree creates a\n360:    * project, and building project creation belongs to another requirement. This is the hook the leaf\n361:    * that lands project creation must call.\n362:    */\n363:   hasPlatformAcknowledgment(accountId: string): Promise<boolean>;\n364: \n365:   /* ------------------------------------ the provisioned admin --------------------------------- */\n366: \n367:   /**\n368:    * Provision a `platform_admin` — the ONLY legal way one exists, because the public path refuses\n369:    * the type. It sits apart from `completeSignup` rather than being one of its options for that\n370:    * reason.\n371:    *\n372:    * ON THE LIVE STACK THIS IS **NOT** A SERVICE-ROLE WRITE, and the correction matters more than\n373:    * most: this comment used to say it was, and a later reader following it would have granted the\n374:    * service role an INSERT on `public.accounts` — a write path straight past `complete_signup`'s\n375:    * `platform_admin` refusal, which is the one guard that sits on the only write path. The service\n376:    * role holds no INSERT anywhere in this schema, by measurement and by decision. Provisioning is a\n377:    * direct database operation by an operator: a NARROWER authority than the service role, not a\n378:    * wider one, and not one any running service holds.\n379:    */\n380:   provisionPlatformAdmin(email: string, password: string): Promise<Session>;\n381: };\n382: \n383: /* -------------------------------------------------------------------------------- the world */\n384: \n385: /**\n386:  * What REQ-001's fixture world adds to the shared seam.\n387:  *\n388:  * An INTERSECTION, not `interface World extends WorldSeam`, for the alias reason above.\n389:  *\n390:  * One member, and it earns its place: every test in this suite registers auth users, and two tests\n391:  * that happened to pick the same address would interfere in a way that looks like a product defect.\n392:  * `email()` namespaces an address to the world that issued it, so isolation is structural rather\n393:  * than a convention each body has to remember.\n394:  */\n395: export type World = WorldSeam & {\n396:   /** a mail address unique to THIS world, e.g. `email('ngo')` */\n397:   email(local: string): string;\n398: };\n\n(End of file - total 398 lines)\n</content>","metadata":{"preview":"/**\n * What REQ-001 adds to the shared harness contract.\n *\n * The generic seams — tier, clock, fixture worlds, sentinels, faults, static scan, config, vendor\n * sims, the harness shape itself — live in `tests/at/harness/contracts.ts` and are re-exported here\n * so a test body imports one file. What is genuinely REQ-001's is below: the accounts system under\n * test, the row shapes its assertions read back, and what this requirement's fixture world can do.\n *\n * TYPE ALIASES, NOT INTERFACES, throughout — the rule `harness/contracts.ts` states and gives its\n * reasons for. Nothing reachable from the objects `open()` hands a test body may be an interface,\n * because an interface can be reopened with `declare module` and an OPTIONAL member merged into it\n * reads `undefined` at run time while every type-check stays green.\n *\n * THE JUDGEMENT TYPES ARE IMPORTED FROM THE SHIPPED MODULE, not restated here. `AccountType`,\n * `CompleteSignupRequest` and the rest come from `supabase/functions/_shared/accounts.ts`, which is\n * the same module the two edge functions import. Restating them would be two independent statements\n * about one thing with nothing able to notice them diverging — and that is the defect this whole\n * harness exists to delete, not a shape to reproduce inside it.\n */\n","truncated":false,"loaded":[],"display":{"type":"file","path":"C:\\Users\\nirdr\\Downloads\\ai4good\\.claude\\worktrees\\agent-aa95110cbeab31aa7\\tests\\at\\suites\\req-001\\_contract.ts","text":"/**\n * What REQ-001 adds to the shared harness contract.\n *\n * The generic seams — tier, clock, fixture worlds, sentinels, faults, static scan, config, vendor\n * sims, the harness shape itself — live in `tests/at/harness/contracts.ts` and are re-exported here\n * so a test body imports one file. What is genuinely REQ-001's is below: the accounts system under\n * test, the row shapes its assertions read back, and what this requirement's fixture world can do.\n *\n * TYPE ALIASES, NOT INTERFACES, throughout — the rule `harness/contracts.ts` states and gives its\n * reasons for. Nothing reachable from the objects `open()` hands a test body may be an interface,\n * because an interface can be reopened with `declare module` and an OPTIONAL member merged into it\n * reads `undefined` at run time while every type-check stays green.\n *\n * THE JUDGEMENT TYPES ARE IMPORTED FROM THE SHIPPED MODULE, not restated here. `AccountType`,\n * `CompleteSignupRequest` and the rest come from `supabase/functions/_shared/accounts.ts`, which is\n * the same module the two edge functions import. Restating them would be two independent statements\n * about one thing with nothing able to notice them diverging — and that is the defect this whole\n * harness exists to delete, not a shape to reproduce inside it.\n */\n\nimport type { WorldSeam } from '../../harness/contracts.ts';\nimport type {\n  AccountType,\n  CompleteSignupRequest,\n} from '../../../../supabase/functions/_shared/accounts.ts';\n\nexport type {\n  Clock,\n  ConfigRegistry,\n  FaultHandle,\n  Faults,\n  Fixtures,\n  ProviderOutcome,\n  Sentinel,\n  Sentinels,\n  StaticScan,\n  Tier,\n  WorldSeam,\n} from '../../harness/contracts.ts';\nexport { TIERS } from '../../harness/contracts.ts';\n\nexport type { AccountType, CompleteSignupRequest };\n\n/* ------------------------------------------------------------------------- what gets read back */\n\n/** One row of `public.accounts` — one per authenticated user, holding exactly one global type. */\nexport type AccountRow = {\n  id: string;\n  accountType: AccountType;\n};\n\n/** One row of `public.organizations`. */\nexport type OrganizationRow = {\n  id: string;\n  name: string;\n};\n\n/** One row of `public.org_memberships` — the per-NGO role, which is NOT the global account type. */\nexport type MembershipRow = {\n  organizationId: string;\n  accountId: string;\n  role: 'admin' | 'member';\n};\n\n/**\n * One row of `public.acknowledgments` — EXACTLY the three fields AT-001.01 names recorded, plus the\n * account and kind that identify it.\n *\n * Name, title and authority attestation are AT-001.19's fields and belong to the acknowledgment-\n * identity deliverable (`loop/decomp/req-001.md` D4.L1), which is declared red by this leaf. They\n * are deliberately absent here: adding columns for a criterion this leaf does not test would be\n * speculation, and a reader would have no way to tell it from work that had been done.\n */\nexport type AcknowledgmentRow = {\n  accountId: string;\n  kind: string;\n  /** ISO-8601 instant — AT-001.01's \"timestamp\" */\n  acknowledgedAt: string;\n  /**\n   * AT-001.01's \"IP\": the address the gateway chain REPORTED, never a verified source address.\n   * Measured on the live local stack — a spoofed `x-forwarded-for` is stored verbatim, and with no\n   * header at all the stored value is the gateway's own hop. See `callerIp` in\n   * `supabase/functions/_shared/edge.ts`.\n   */\n  ip: string;\n  /** which version of the ToS + Platform Promise text was accepted — AT-001.01's \"text version\" */\n  textVersion: string;\n};\n\n/**\n * One row of `public.volunteer_profiles` — AT-001.05's \"profile\", and every column of it.\n *\n * THE STATS ARE THE STUB IMPORT FIXTURE'S, NOT GITHUB'S. `stubGithubStatsFor` in\n * `supabase/functions/_shared/github.ts` produces them, the decomposition manifest's cross-contract\n * ratifies that stand-in (\"stub import fixture until W3\"), and no code in this item calls\n * api.github.com. What the row proves is that onboarding FIRED and landed POPULATED — the\n * criterion's \"a queued-but-empty import fails this test\" — and not that any statistic is real.\n */\nexport type VolunteerProfileRow = {\n  accountId: string;\n  /** the handle of the GitHub identity linked to the account — AT-001.05's \"linked handle\" */\n  githubHandle: string;\n  /** AT-001.05's \"top languages\"; never empty, in the schema by CHECK and here by assertion */\n  topLanguages: string[];\n  /** AT-001.05's \"repository count\" */\n  repositoryCount: number;\n  /** AT-001.05's \"contribution summary\" */\n  contributionSummary: string;\n  /** ISO-8601 instant the import landed */\n  importedAt: string;\n};\n\n/* --------------------------------------------------------------------------------- the session */\n\n/**\n * An authenticated session, and WHICH PROVIDER ESTABLISHED IT.\n *\n * `provider` is recorded, never simulated. Supabase Auth records the provider that produced a\n * session; how the session was obtained — an email and a password, or a completed Google consent\n * round trip — happens entirely upstream of anything this requirement's leaf ships. AT-001.03's\n * body asserts that `completeSignup` behaves identically for `'google'` and `'email'`, which is a\n * real property of the shipped decision module (it never reads this field). It is NOT a claim that a\n * Google round trip works: see the suite's own note on AT-001.03, and the plan's per-id table.\n *\n * `'github'` joins the two for AT-001.02 and carries exactly the same caveat: a github-established\n * session is the state Auth is in AFTER a consent round trip, and no handshake is simulated to reach\n * it. The establishing provider still participates in NO decision the shipped modules make — the\n * volunteer gate reads a LINKED IDENTITY, which is a different fact (see `linkGithubIdentity`).\n */\nexport type SessionProvider = 'email' | 'google' | 'github';\n\nexport type Session = {\n  /** the auth user id, which is also the `public.accounts` primary key once signup completes */\n  accountId: string;\n  email: string;\n  provider: SessionProvider;\n};\n\n/* -------------------------------------------------------------------------------- the outcomes */\n\nexport type SignInOutcome = { ok: true; session: Session } | { ok: false; reason: string };\n\nexport type CompleteSignupOutcome =\n  | { ok: true; accountId: string; organizationId: string | null }\n  | { ok: false; reason: string };\n\nexport type CreateOrganizationOutcome = { ok: true; organizationId: string } | { ok: false; reason: string };\n\n/**\n * The outcome of an attempted Discovery message — and the refusal carries WHY, for the reason\n * `Decision` in the shipped module gives: AT-001.10 asserts that the block NAMES verification as\n * the remedy, so a bare boolean would make the criterion untestable.\n */\nexport type SendDiscoveryMessageOutcome = { ok: true } | { ok: false; reason: string };\n\n/* ------------------------------------------------------------------------------------ the SUT */\n\n/**\n * REQ-001's accounts system under test.\n *\n * The split is the point, and there are now FOUR kinds of member here rather than three:\n *\n *   1. THE TWO PRODUCT OPERATIONS — `completeSignup` and `createOrganization`. At loop tier the\n *      adapter runs them over its own storage but delegates every judgement to\n *      `supabase/functions/_shared/accounts.ts`, the module the edge functions import; at\n *      integration tier they would be the deployed edge functions.\n *   2. SUPABASE AUTH'S HALF — registration, sign-in, identity linking, and the verification state\n *      (`emailVerified`, `emailedVerificationLink`, `useVerificationLink`). None of it is this\n *      requirement's code. It is what produces the states the product operations judge.\n *   3. READ-BACK — the row shapes an assertion reads after the fact.\n *   4. ONE STAND-IN SURFACE, AND IT IS THE ONLY ONE — `sendDiscoveryMessage`, with\n *      `discoveryMessagesBy` reading it back.\n *\n * THE FOURTH KIND NEEDS ITS OWN SENTENCE, because it is the one that could be misread. NO\n * DISCOVERY ROUTE EXISTS IN THIS TREE. The Discovery message route is REQ-002/004's, and what\n * this requirement's leaf ships is the DECISION that route must consult —\n * `discoveryMessageAllowed` in `supabase/functions/_shared/verification.ts`. So\n * `sendDiscoveryMessage` is not a deployed operation being tested; it is a stand-in surface whose\n * only job is to put the shipped decision on a tested path, exactly as\n * `hasPlatformAcknowledgment` below is the hook a project-creation leaf must call. A green over\n * it says the DECISION is right. It says nothing about enforcement anywhere, because there is\n * nowhere yet to enforce it.\n */\nexport type AccountsSut = {\n  /** AT-001.07's second clause: which types the PUBLIC signup surface offers. */\n  publicSignupAccountTypes(): Promise<readonly string[]>;\n\n  /* --- Supabase Auth's half. Not this leaf's code; it is what produces a session to complete. --- */\n\n  /**\n   * Register an auth user with an email and a password, and return the resulting session.\n   *\n   * IT STILL RETURNS A SESSION, AND THE HONEST GAP THAT LEAVES IS STATED HERE RATHER THAN HIDDEN.\n   * With `enable_confirmations = true` the live GoTrue issues NO session at signup, so on the real\n   * stack a completed-but-unverified account is not reachable by the public path. This fixture's\n   * `Session` has always been an identity handle rather than an access token, and session ISSUANCE\n   * is D2.L2's subject (AT-001.12, .13 — declared red). So at the loop tier such an account IS\n   * constructible, and AT-001.10's body constructs one deliberately: the gate exists because\n   * decision-8 makes verification the write path's own floor, not a property borrowed from the\n   * session layer. The live-stack behaviour is measured in `loop/items/AI4DEV-59/proof-local.ts`\n   * checks (a) and (c), and nowhere else in this item.\n   */\n  registerWithEmailPassword(email: string, password: string): Promise<Session>;\n  /**\n   * A session Auth recorded as having come from an external provider.\n   *\n   * It performs NO handshake and fabricates no authorization code or token exchange: it is the state\n   * Auth is in AFTER a consent round trip, which is the only part of the story any agent can reach.\n   */\n  registerWithProvider(provider: SessionProvider, email: string): Promise<Session>;\n  /**\n   * A GitHub OAuth signup, as Auth records it: a session established by GitHub whose account already\n   * carries the linked GitHub identity — AT-001.02's \"signs up via GitHub OAuth\".\n   *\n   * Like `registerWithProvider` it performs NO handshake. It is `registerWithProvider('github', …)`\n   * plus the fact that a GitHub signup necessarily links the GitHub identity it signed up with, and\n   * it is a separate member rather than an argument because that second half is what AT-001.02's\n   * \"the GitHub identity is linked to it\" clause is about.\n   */\n  registerWithGithub(email: string, githubHandle: string): Promise<Session>;\n  /**\n   * The state Auth is in after a `linkIdentity` round trip — AT-001.04's \"linking completes signup\".\n   *\n   * A LINKED IDENTITY IS NOT THE ESTABLISHING PROVIDER, and keeping the two apart is the point of\n   * this member existing at all: an email- or Google-established volunteer links GitHub and their\n   * session's `provider` does not change. The gate in\n   * `supabase/functions/_shared/accounts.ts` reads the link; nothing shipped reads the provider.\n   *\n   * Same posture as every other Auth member here — no handshake, no fabricated authorization code.\n   */\n  linkGithubIdentity(session: Session, githubHandle: string): Promise<void>;\n  /** Return sign-in with the same credentials — AT-001.01's final clause. */\n  signInWithEmailPassword(email: string, password: string): Promise<SignInOutcome>;\n  /**\n   * The return visit through an external provider — AT-001.02's \"a later sign-in via GitHub returns\n   * to the same account\".\n   *\n   * What it asserts is IDENTITY CONTINUITY, which is the half of that clause reachable without a\n   * person: an existing user whose account carries that provider's identity signs in to the SAME\n   * account rather than to a second one. The consent round trip itself is not performed and is named\n   * unproved in the plan's per-id table.\n   */\n  signInWithProvider(provider: SessionProvider, email: string): Promise<SignInOutcome>;\n\n  /* ------------------------- Supabase Auth's verification state ------------------------------- */\n\n  /**\n   * Whether Supabase Auth reports this account's email address confirmed — AT-001.09's observable.\n   *\n   * IT IS DERIVED, NOT STORED-AND-READ. The adapter renders the account's stored Auth state as the\n   * canonical GoTrue `/auth/v1/user` shape and judges the answer out of it with the SHIPPED\n   * `emailVerifiedFromUser`. That is the same pattern `completeSignup` uses for the GitHub handle\n   * (the GitHub leaf's gate-2 ruling R3), and it exists so the shipped extractor sits on the tested\n   * path rather than being a function no test ever runs — which is exactly how the future Discovery\n   * route will resolve the same fact from the same response.\n   *\n   * WHAT NO LOOP-TIER GREEN OVER IT PROVES: that the rendered shape is the shape GoTrue really\n   * sends. Only `loop/items/AI4DEV-59/proof-local.ts` check (d) touches that, by feeding a real\n   * response to the same shipped function.\n   */\n  emailVerified(accountId: string): Promise<boolean>;\n  /**\n   * The verification link emailed to this address, or `null` when none was emailed.\n   *\n   * `null` is a real answer rather than only the empty case: a provider registration is confirmed\n   * by the provider and no confirmation email is sent for it.\n   */\n  emailedVerificationLink(email: string): Promise<string | null>;\n  /**\n   * Use a verification link. Using the link Auth emailed for an address confirms that address; a\n   * link that was never issued returns `ok: false` and flips nothing.\n   *\n   * NO EXPIRY, NO SINGLE USE AND NO RESEND IS MODELLED OR ASSERTED. AT-001.11 is retired — the\n   * acceptance file's own words are that \"verification-link expiry/single-use/resend semantics are\n   * not stated in REQ-001\" — so building any of them here would be asserting a criterion that was\n   * deliberately withdrawn.\n   *\n   * THE NEVER-ISSUED NEGATIVE IS NOT AT-001.11 GROUND, and the difference is worth being exact\n   * about. It is not a claim about a link's lifetime; it guards this test's own oracle. A\n   * link-shaped string that verified an account it never belonged to would make \"using the emailed\n   * link is what flips it\" mean nothing at all, because any string would flip anything.\n   */\n  useVerificationLink(link: string): Promise<{ ok: boolean }>;\n\n  /* ----------------------------------- the two product operations ----------------------------- */\n\n  /** `supabase/functions/complete-signup` — turns an authenticated auth user into a typed account. */\n  completeSignup(session: Session, request: CompleteSignupRequest, ip: string): Promise<CompleteSignupOutcome>;\n  /** `supabase/functions/create-organization` — the NGO-only action AT-001.06 drives. */\n  createOrganization(session: Session, organizationName: string): Promise<CreateOrganizationOutcome>;\n\n  /* --------------------------- the Discovery gate's stand-in surface -------------------------- */\n\n  /**\n   * Attempt to send a Discovery message — AT-001.10's action.\n   *\n   * THERE IS NO DEPLOYED ROUTE BEHIND THIS, at either tier. See the fourth kind in this type's own\n   * header: the Discovery route is REQ-002/004's and does not exist, so this member is a stand-in\n   * surface that exists to put the SHIPPED `discoveryMessageAllowed` on a tested path. At loop\n   * tier the adapter derives the caller's verified fact through the shipped\n   * `emailVerifiedFromUser`, consults the shipped gate, and refuses with the GATE's own reason.\n   *\n   * THE BODY IS AN OPAQUE STRING AND NOTHING ELSE. Recipients, threads, attachments and message\n   * state are REQ-002/004's semantics; inventing any of them here to make this member look real\n   * would be building another requirement's surface early. What AT-001.10 needs is an attempted\n   * write and a way to see whether it happened, and one string supplies both.\n   */\n  sendDiscoveryMessage(session: Session, body: string): Promise<SendDiscoveryMessageOutcome>;\n  /**\n   * The Discovery message bodies this account has sent — read-back, and it is not optional.\n   *\n   * A BLOCK WHOSE WRITE HAPPENED ANYWAY IS NOT A BLOCK. The refusal's own return value cannot show\n   * that nothing was written, for the same reason `organizationsNamed` exists: a refusal hands\n   * back no identifier, so the row that must NOT be there can only be looked for by who would have\n   * written it.\n   */\n  discoveryMessagesBy(accountId: string): Promise<string[]>;\n\n  /* ------------------------------------------- read-back -------------------------------------- */\n\n  account(accountId: string): Promise<AccountRow | null>;\n  organization(organizationId: string): Promise<OrganizationRow | null>;\n  membership(organizationId: string, accountId: string): Promise<MembershipRow | null>;\n  acknowledgments(accountId: string): Promise<AcknowledgmentRow[]>;\n  /**\n   * The volunteer's imported GitHub profile, or `null` — AT-001.05's observable.\n   *\n   * `null` is a real and asserted answer, not merely the empty case: AT-001.05's pre-completion\n   * negative reads it AFTER the identity is linked and BEFORE the signup completes, and requires\n   * null there. That is what proves the population is CAUSED by completion rather than sitting in a\n   * queue somewhere waiting to be drained.\n   */\n  volunteerProfile(accountId: string): Promise<VolunteerProfileRow | null>;\n\n  /**\n   * The two read-backs a REFUSED action needs, which the keyed ones above cannot serve.\n   *\n   * Asserting that a rejection wrote nothing means looking for rows whose identifiers were never\n   * handed out — a refused `createOrganization` returns no organisation id. So one search by the\n   * name that was attempted, and one listing of everything an account is a member of. Without them\n   * the strongest statement available is \"the call said no\", and an implementation that writes both\n   * rows and then says no would satisfy it.\n   */\n  organizationsNamed(name: string): Promise<OrganizationRow[]>;\n  membershipsOf(accountId: string): Promise<MembershipRow[]>;\n  /**\n   * `public.has_platform_acknowledgment(account_id)` — the observable form of AT-001.01's \"before\n   * any project creation is possible\".\n   *\n   * It MUST DISCRIMINATE: false for an authenticated user who has not completed signup, true after.\n   * The body asserts both halves for exactly that reason.\n   *\n   * WHICH IMPLEMENTATION THAT ASSERTION REACHES depends on the tier, and the difference matters. At\n   * loop tier it reaches the fixture adapter's storage query, so what goes green is the RULE and the\n   * adapter's storage — the shipped SQL function could return true unconditionally and the loop tier\n   * would not notice. `public.has_platform_acknowledgment` itself is proved by step 7(h) of the\n   * plan, against the live database, and by nothing else in this item.\n   *\n   * What this leaf cannot do at either tier is ENFORCE the clause — nothing in the tree creates a\n   * project, and building project creation belongs to another requirement. This is the hook the leaf\n   * that lands project creation must call.\n   */\n  hasPlatformAcknowledgment(accountId: string): Promise<boolean>;\n\n  /* ------------------------------------ the provisioned admin --------------------------------- */\n\n  /**\n   * Provision a `platform_admin` — the ONLY legal way one exists, because the public path refuses\n   * the type. It sits apart from `completeSignup` rather than being one of its options for that\n   * reason.\n   *\n   * ON THE LIVE STACK THIS IS **NOT** A SERVICE-ROLE WRITE, and the correction matters more than\n   * most: this comment used to say it was, and a later reader following it would have granted the\n   * service role an INSERT on `public.accounts` — a write path straight past `complete_signup`'s\n   * `platform_admin` refusal, which is the one guard that sits on the only write path. The service\n   * role holds no INSERT anywhere in this schema, by measurement and by decision. Provisioning is a\n   * direct database operation by an operator: a NARROWER authority than the service role, not a\n   * wider one, and not one any running service holds.\n   */\n  provisionPlatformAdmin(email: string, password: string): Promise<Session>;\n};\n\n/* -------------------------------------------------------------------------------- the world */\n\n/**\n * What REQ-001's fixture world adds to the shared seam.\n *\n * An INTERSECTION, not `interface World extends WorldSeam`, for the alias reason above.\n *\n * One member, and it earns its place: every test in this suite registers auth users, and two tests\n * that happened to pick the same address would interfere in a way that looks like a product defect.\n * `email()` namespaces an address to the world that issued it, so isolation is structural rather\n * than a convention each body has to remember.\n */\nexport type World = WorldSeam & {\n  /** a mail address unique to THIS world, e.g. `email('ngo')` */\n  email(local: string): string;\n};","lineStart":1,"lineEnd":398,"totalLines":398,"truncated":false}},"title":"tests\\at\\suites\\req-001\\_contract.ts","time":{"start":1786290444173,"end":1786290444180}},"id":"prt_fe73516700016zNhGScdblPGXC","sessionID":"ses_018cbdef8ffeIiDUqdR6dh2IlP","messageID":"msg_fe734f578001LZ7j7nF32EROiX"}}
