 428: /**
 429:  * AT-001.12 — access ends when a session expires OR is revoked, and re-authentication is the remedy.
 430:  *
 431:  * TWO ARMS, BOTH AGAINST REAL TIME AND A REAL AUTH.
 432:  *
 433:  *   REVOCATION — a scoped logout ends THIS session while a SIBLING session of the same account keeps
 434:  *   working. The sibling is the control that separates "this session ended" from "the account's
 435:  *   access ended", and without it the criterion's remedy clause is untested.
 436:  *
 437:  *   EXPIRY — the body WAITS OUT a real access token. There is nothing to command: the slot's config
 438:  *   pins a standing low `jwt_expiry` precisely so this wait is two minutes rather than an hour, and
 439:  *   no test edits configuration or restarts anything. The loop body advances a controlled clock,
 440:  *   which is a different procedure proving the same clause.
 441:  */
 442: export async function at00112(ctx: Ctx): Promise<void> {
 443:   const { w, sut } = await ctx.open();
 444:   const email = w.email('sessions');
 445:   const session = await registerConfirmAndSignIn(sut, email);
 446: 
 447:   const completion = await sut.completeSignup(
 448:     session,
 449:     { accountType: 'ngo', organizationName: 'Riverside Shelter', acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
 450:     CLIENT_IP,
 451:   );
 452:   expect(completion, 'the session under test could not complete signup, so nothing below is about a working session').toMatchObject({
 453:     ok: true,
 454:   });
 455: 
 456:   // A SIBLING SESSION, opened before the logout, standing as the control.
 457:   const sibling = await sut.signInWithEmailPassword(email, PASSWORD);
 458:   expect(sibling, 'a second sign-in for the same account failed').toMatchObject({ ok: true });
 459:   if (!sibling.ok) return;
 460:   const before = await sut.sessionsOf(session.accountId);
 461:   expect(before.length, 'the account does not hold the two sessions this arm needs').toBeGreaterThanOrEqual(2);
 462: 
 463:   await sut.signOut(session);
 464:   const after = await sut.sessionsOf(session.accountId);
 465:   expect(after.map((row) => row.sessionId), 'the signed-out session row is still there').not.toContain(session.sessionId);
 466:   expect(after.map((row) => row.sessionId), 'the scoped logout took the sibling session with it').toContain(sibling.session.sessionId);
 467: 
 468:   // THE REVOKED SESSION CANNOT WRITE. `create-organization` is the write, because no verification
 469:   // gate sits on it — so a refusal here is unambiguously the session layer's.
 470:   const revokedWrite = await sut.createOrganization(session, 'Riverside Shelter After Logout');
 471:   expect(revokedWrite.ok, 'a revoked session performed a write').toBe(false);
 472:   expect(await sut.organizationsNamed('Riverside Shelter After Logout'), 'the revoked write happened anyway').toEqual([]);
 473: 
 474:   // RE-AUTHENTICATION IS THE REMEDY, not a wall: a fresh sign-in works at once.
 475:   const again = await sut.signInWithEmailPassword(email, PASSWORD);
 476:   expect(again, 're-authentication after revocation was refused, so revocation ended the account rather than the session').toMatchObject(
 477:     { ok: true },
 478:   );
 479:   if (!again.ok) return;
 480: 
 481:   // THE EXPIRY ARM. Wait past the slot's standing token lifetime and assert the same write is
 482:   // refused — with the margin on the far side, so a token that is merely close to expiry is not
 483:   // mistaken for one that has passed it.
 484:   await wait(SLOT_JWT_EXPIRY_MS + 15_000);
 485:   const expiredWrite = await sut.createOrganization(again.session, 'Riverside Shelter After Expiry');
 486:   expect(expiredWrite.ok, 'an expired access token performed a write').toBe(false);
 487:   expect(await sut.organizationsNamed('Riverside Shelter After Expiry'), 'the expired write happened anyway').toEqual([]);
 488: 
 489:   // And the refresh token re-establishes access with NO credentials — which is what makes expiry a
 490:   // pause rather than a logout, and is the mechanism AT-001.13 builds its own claim on.
 491:   const refreshed = await sut.refreshSession(again.session);
 492:   expect(refreshed, 'the same session could not be refreshed after its access token expired').toMatchObject({ ok: true });
 493:   if (!refreshed.ok) return;
 494:   const afterRefresh = await sut.createOrganization(refreshed.session, 'Riverside Shelter After Refresh');
 495:   expect(afterRefresh, 'a refreshed session still could not write').toMatchObject({ ok: true });
 496: }
