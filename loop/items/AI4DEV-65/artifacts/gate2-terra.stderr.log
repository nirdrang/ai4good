 338:     if p_github_handle is not null
 339:        or p_github_top_languages is not null
 340:        or p_github_repository_count is not null
 341:        or p_github_contribution_summary is not null then
 342:       raise exception
 343:         'complete_signup refuses GitHub import parameters on a % completion: the GitHub link and its onboarding import belong to volunteer signup',
 344:         v_account_type
 345:         using errcode = '22023';
 346:     end if;
 347:   end if;
 348: 
 349:   -- (1) the account. The primary key does the "already completed" refusal on its own; catching it
 350:   -- turns a raw unique-violation into a sentence a caller can pass on.
 351:   begin
 352:     insert into public.accounts (id, account_type)
 353:     values (p_account_id, v_account_type);
 354:   exception
 355:     when unique_violation then
 356:       raise exception 'complete_signup refuses %: this account has already completed signup', p_account_id
 357:         using errcode = '23505';
 358:   end;
 359: 
 360:   -- (2) and (3) the organisation and its admin membership, for an NGO only.
 361:   if v_account_type = 'ngo' then
 362:     insert into public.organizations (name)
 363:     values (btrim(p_organization_name))
 364:     returning id into v_organization_id;
 365: 
 366:     insert into public.org_memberships (org_id, account_id, role)
 367:     values (v_organization_id, p_account_id, 'admin');
 368:   end if;
 369: 
 370:   -- (3b) the volunteer's imported GitHub profile, for a volunteer only — AT-001.05's "onboarding
 371:   -- fires". It is written HERE, between the account and the acknowledgment, because that is what
 372:   -- makes the firing part of the completion rather than a consequence of it: there is no queue, no
 373:   -- job and no second request, so the profile is observable the instant completion returns.
 374:   if v_account_type = 'volunteer' then
 375:     insert into public.volunteer_profiles (
 376:       account_id, github_handle, top_languages, repository_count, contribution_summary
 377:     )
 378:     values (
 379:       p_account_id,
 380:       v_github_handle,
 381:       p_github_top_languages,
 382:       p_github_repository_count,
 383:       v_contribution_summary
 384:     );
 385:   end if;
 386: 
 387:   -- (4) the ToS + Platform Promise acknowledgment.
 388:   --
 389:   -- RECORDED FOR BOTH ACCOUNT TYPES, and this is a reading of the plan rather than a copy of it.
 390:   -- AT-001.01 states the criterion for an NGO, but the completion request requires an
 391:   -- acknowledgment text version from every caller (see `validateCompleteSignup`), and requiring a
 392:   -- field and then discarding it for one of the two types is not defensible: it would mean a
 393:   -- volunteer accepted the terms and the platform kept no record of which terms. The organisation
 394:   -- and the membership stay NGO-only.
 395:   --
 396:   -- IT STAYS LAST, and that placement is depended upon: the atomicity proof makes this write fail
 397:   -- after the earlier ones have succeeded, which is how "all or none" is demonstrated rather than
 398:   -- asserted. A volunteer profile inserted above it is part of what must disappear.
 399:   insert into public.acknowledgments (account_id, kind, ip, text_version)
 400:   values (p_account_id, 'platform_tos_and_promise', p_ip, p_acknowledgment_text_version);
 401: 
 402:   return jsonb_build_object(
 403:     'account_id', p_account_id,
 404:     'account_type', v_account_type,
 405:     'organization_id', v_organization_id
 406:   );
 407: end;
