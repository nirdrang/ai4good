 315:       raise exception
 316:         'complete_signup refuses a volunteer completion whose imported top languages contain a null or blank entry: a list of empty slots is not a list of languages'
 317:         using errcode = '22023';
 318:     end if;
 319: 
 320:     if p_github_repository_count is null or p_github_repository_count < 0 then
 321:       raise exception
 322:         'complete_signup refuses a volunteer completion whose imported repository count is missing or negative'
 323:         using errcode = '22023';
