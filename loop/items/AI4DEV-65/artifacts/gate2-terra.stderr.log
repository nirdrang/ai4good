 101:   // therefore into the same transaction — there is no queue and no second request, which is what
 102:   // makes AT-001.05's "a queued-but-empty import fails this test" unrepresentable rather than merely
 103:   // untested. `null` throughout for an NGO, which the database function requires.
 104:   const githubStats = githubHandle === null ? null : stubGithubStatsFor(githubHandle);
