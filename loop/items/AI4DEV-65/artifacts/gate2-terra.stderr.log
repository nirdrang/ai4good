 187: create function public.complete_signup(
 188:   p_account_id uuid,
 189:   p_account_type text,
 190:   p_organization_name text,
 191:   p_acknowledgment_text_version text,
 192:   p_ip inet,
 193:   -- `default null` ON ALL FOUR IS THE DEPLOYMENT BRIDGE described above the drop, not a convenience:
 194:   -- it is what lets a five-named-argument call from an edge function that has not rolled yet still
 195:   -- resolve to this function. It changes nothing for a caller that passes all nine.
 196:   p_github_handle text default null,
 197:   p_github_top_languages text[] default null,
 198:   p_github_repository_count integer default null,
 199:   p_github_contribution_summary text default null
 200: )
