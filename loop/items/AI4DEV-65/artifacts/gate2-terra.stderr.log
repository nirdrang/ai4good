 264:     if v_github_handle is null or length(v_github_handle) = 0 then
 265:       raise exception
 266:         'complete_signup refuses a volunteer completion with no linked GitHub handle: linking a GitHub account is required to complete volunteer signup'
 267:         using errcode = '42501';
