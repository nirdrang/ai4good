+
+  const completion = await sut.completeSignup(
+    session,
+    {
+      accountType: 'ngo',
+      organizationName: 'Riverside Shelter Who Signed',
+      acknowledgmentTextVersion: TEXT_VERSION,
+      ...SIGNER,
+    },
