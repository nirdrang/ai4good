  86:   const {
  87:     accountType,
  88:     organizationName,
  89:     acknowledgmentTextVersion,
  90:     githubHandle,
  91:     signerName,
  92:     signerTitle,
  93:     authorityAttestation,
  94:   } = decision.value;
  95: 
  96:   // THE ONBOARDING IMPORT, FIRED HERE — AT-001.05. The handle is the JUDGED one, so the stats are
  97:   // computed for the identity the gate actually accepted rather than for one this function re-derived.
  98:   //
  99:   // It is a STUB SOURCE and the module says so at length: no request leaves this process to reach
