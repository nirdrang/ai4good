 209: -- `set search_path = ''` is mandatory on a definer function and every name below is
 210: -- schema-qualified for it, INCLUDING `auth.identities`.
 211: security definer
 212: set search_path = ''
 213: as $$
 214: declare
 215:   v_account_type public.account_type;
 216:   v_organization_id uuid := null;
 217:   -- THE TRIM SET IS SPELLED OUT, because `btrim(x)` with no second argument strips THE SPACE
 218:   -- CHARACTER ONLY — so a tab-only handle used to arrive here, survive the trim, compare unequal to
 219:   -- '' and be stored. The set below is the whitespace class the table's `^\s*$` constraints refuse,
 220:   -- written character by character so the two agree: space, tab, newline, carriage return, vertical
 221:   -- tab, form feed. `\013` IS THE VERTICAL TAB IN OCTAL and is written that way on purpose:
 222:   -- PostgreSQL's escape-string syntax has no `\v`, and a backslash before an unrecognised letter is
 223:   -- dropped — `E'\v'` is the letter "v", so spelling it that way would have stripped every "v" out
 224:   -- of volunteers' handles instead of stripping whitespace.
 225:   v_github_handle text := btrim(p_github_handle, E' \t\n\r\013\f');
