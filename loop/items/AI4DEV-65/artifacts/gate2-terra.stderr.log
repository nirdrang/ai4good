  83:    */
  84:   ip: string;
  85:   /** which version of the ToS + Platform Promise text was accepted — AT-001.01's "text version" */
  86:   textVersion: string;
  87:   /** who made the acknowledgment — AT-001.19's "name" */
  88:   signerName: string;
  89:   /** the title they held when they made it — AT-001.19's "title" */
