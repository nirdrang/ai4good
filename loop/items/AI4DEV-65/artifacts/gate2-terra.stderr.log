 339:        or p_github_top_languages is not null
 340:        or p_github_repository_count is not null
 341:        or p_github_contribution_summary is not null then
 342:       raise exception
 343:         'complete_signup refuses GitHub import parameters on a % completion: the GitHub link and its onboarding import belong to volunteer signup',
 344:         v_account_type
