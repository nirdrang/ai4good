 282:     -- differently when a real OAuth app first arrives, the change is a two-place change: the
 283:     -- extractor, and a follow-up migration recreating this function.
 284:     if not exists (
 285:       select 1
 286:         from auth.identities
 287:        where user_id = p_account_id
 288:          and provider = 'github'
 289:          and identity_data->>'user_name' = v_github_handle
