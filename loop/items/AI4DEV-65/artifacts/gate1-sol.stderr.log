  227:     // signup's, so an NGO completion carries no handle onward and writes no volunteer profile.
  228:     githubHandle: accountType === 'volunteer' ? linkedGithubHandle : null,
  229:   });
  230: }
  231: 
  232: /* --------------------------------------------------------- 2b. is this organisation name usable */
  233: 
  234: /**
  235:  * An organisation's name, trimmed, or a refusal naming why â€” the SAME rule `validateCompleteSignup`
  236:  * applies to the name arriving on an NGO signup, stated once.
  237:  *
  238:  * WHY IT IS HERE AND NOT AT ITS TWO CALL SITES, because that is where it used to be. The rule was
  239:  * written twice â€” once in `create-organization/index.ts`, a file no type-checker covers, and once
  240:  * in `tests/at/suites/req-001/_fixture.ts` â€” so the acceptance suite graded the adapter's copy and
  241:  * said nothing about the shipped one. Two independent statements of one rule with nothing able to
  242:  * notice them diverging is the exact defect this module exists to delete; it does not get an
  243:  * exception for being three lines long.
  244:  */
  245: export function validateOrganizationName(raw: unknown): Decision<string> {
  246:   if (typeof raw !== 'string' || raw.trim() === '') {
  247:     return refuse('an organisation needs a non-empty name');
  248:   }
  249:   return accept(raw.trim());
  250: }
  251: 
  252: /* ---------------------------------------------------------------- 3. may this account do NGO work */
  253: 
  254: /**
  255:  * AT-001.06, as a decision: an NGO-only action is permitted to an `ngo` account and to nothing else.
  256:  *
  257:  * A `platform_admin` is refused here too, and that is a deliberate reading of the criterion rather
  258:  * than an accident of the implementation. AT-001.06's clause is "one account holds exactly one
  259:  * global type; the NGO path requires a separate account", and creating an organisation as an NGO is
