 362: /**
 363:  * Every way the RUN ITSELF is not fully accounted for by the declaration. PURE.
 364:  *
 365:  * WHY THE ID COMPARISON IS NOT ENOUGH: with reds declared, vitest necessarily exits non-zero, so
 366:  * the process's exit code stops carrying information and an extra failure hides behind an expected
 367:  * one. The id parser only sees tests whose titles carry an AT id, so an untagged `it()` that fails
 368:  * is invisible to it â€” but not to the report's own arithmetic. Every failing, passing, pending and
 369:  * todo test must add up against the declaration; anything unaccounted for is a failure.
 370:  *
 371:  * KNOWN RESIDUAL GAP, stated exactly (it was measured, not reasoned about): a hook that throws in
 372:  * a file which ALSO contains a failing test is serialised identically to a healthy run of that
 373:  * file â€” same file status, same counts, same `success` â€” so while a red is declared in that same
 374:  * file, such a failure is invisible here. A hook that throws in a file whose tests all passed IS
 375:  * caught, by `suiteFileDeviations`. Closing the remainder needs a reporter-side envelope, which is
 376:  * filed, not built here.
 377:  */
 378: export function reportAccountingDeviations(totals: ReportTotals, run: ProcessOutcome, expectation: TierExpectation): string[] {
 379:   const green = expectation.green.length;
 380:   const red = Object.keys(expectation.red).length;
 381:   const deviations: string[] = [];
 382: 
 383:   // A launch failure always fails, whatever the declaration says. No message text is quoted: the
 384:   // code is enough to diagnose a spawn failure, and this module does no redaction of its own.
 385:   if (run.error) {
 386:     const err = run.error as NodeJS.ErrnoException;
 387:     deviations.push(`the test process could not be launched (${err.code ?? 'spawn error'})`);
 388:   }
 389: 
 390:   const counts: Record<string, unknown> = {
 391:     numTotalTests: totals.numTotalTests,
 392:     numPassedTests: totals.numPassedTests,
 393:     numFailedTests: totals.numFailedTests,
 394:     numPendingTests: totals.numPendingTests,
 395:     numTodoTests: totals.numTodoTests,
 396:   };
 397:   const unusable: string[] = [];
 398:   for (const [field, value] of Object.entries(counts)) {
 399:     if (typeof value !== 'number' || !Number.isInteger(value) || value < 0) {
 400:       unusable.push(`the report carries no usable ${field}, so the run cannot be accounted for`);
 401:     }
 402:   }
 403:   if (typeof totals.success !== 'boolean') {
 404:     unusable.push('the report carries no usable success flag, so the run cannot be accounted for');
 405:   }
 406:   if (!Array.isArray(totals.testResults)) {
 407:     unusable.push('the report carries no usable testResults array, so suite-level failures cannot be accounted for');
 408:   }
 409:   // Comparing against a field that is missing would be arithmetic on nonsense: report the unusable
 410:   // fields and stop. Under --expect that is a failure, never a skipped check.
 411:   if (unusable.length) return [...deviations, ...unusable];
 412: 
 413:   const total = counts.numTotalTests as number;
 414:   const passed = counts.numPassedTests as number;
 415:   const failed = counts.numFailedTests as number;
 416:   const pending = counts.numPendingTests as number;
 417:   const todo = counts.numTodoTests as number;
 418: 
 419:   if (failed !== red) {
 420:     deviations.push(
 421:       `the report counts ${failed} failed test${failed === 1 ? '' : 's'} but the declaration declares ${red} red${red === 1 ? '' : 's'} 
â€” ` +
 422:         `a failure outside the declared ids (an untagged test, a failing hook) looks exactly like this`,
 423:     );
 424:   }
 425:   if (passed !== green) {
 426:     deviations.push(`the report counts ${passed} passed test${passed === 1 ? '' : 's'} but the declaration declares ${green} 
green${green === 1 ? '' : 's'}`);
 427:   }
 428:   if (total !== green + red) {
 429:     deviations.push(`the report counts ${total} test${total === 1 ? '' : 's'} in total but the declaration accounts for ${green + red} 
(${green} green + ${red} red) â€” an extra test ran`);
 430:   }
 431:   if (pending !== 0) deviations.push(`the report counts ${pending} pending (skipped) test${pending === 1 ? '' : 's'} â€” a skip must 
never hide inside a declared red`);
 432:   if (todo !== 0) deviations.push(`the report counts ${todo} todo test${todo === 1 ? '' : 's'} â€” a todo must never hide inside a 
declared red`);
 433: 
 434:   if (totals.success !== (red === 0)) {
 435:     deviations.push(
 436:       red === 0
 437:         ? 'the report says the run did not succeed while the declaration declares no red'
 438:         : `the report says the whole run succeeded while the declaration declares ${red} red${red === 1 ? '' : 's'} â€” ` +
 439:             `vitest should have reported those failures, so a clean run means the suite did not do what the declaration says`,
 440:     );
 441:   }
 442: 
 443:   // With no red declared the process's own exit is still the plain rule it has always been.
 444:   if (red === 0 && !run.error && run.status !== 0) {
 445:     const how = run.status === null ? `was killed by signal ${run.signal}` : `exited ${run.status}`;
 446:     deviations.push(`the test process ${how} while the declaration declares no red`);
 447:   }
 448: 
 449:   deviations.push(...suiteFileDeviations(totals.testResults as ReportSuiteFile[]));
 450: 
 451:   return deviations;
 452: }
