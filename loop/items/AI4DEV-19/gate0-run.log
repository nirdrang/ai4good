 204:           eventId,
 205:           type: event,
 206:           role: recipient.role,
 207:           recipientId: recipient.recipientId,
 208:           channel,
 209:           state: 'pending',
 210:           emittedBy: 'notifications.emitter',
 211:           payload: clone(payload),
 212:           body: bodyFor(row, payload),
 213:         });
