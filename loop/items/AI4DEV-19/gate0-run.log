 182:     params: Record<string, unknown> = {},
 183:   ): Promise<{ eventId: string }> => {
 184:     const row = TAXONOMY.find((candidate) => candidate.event === event);
 185:     if (!row) throw new Error(`fixture cannot fire unregistered notification event ${JSON.stringify(event)}`);
 186:     const eventId = `event-${state.nextId++}`;
