+        ('unattOut=' + $rUnatt.OutputTok + '/' + $expUnattOut + ' pct=' + $j.totals.unattributedPct + ' recomputed=' + $recomputed + ' printed=' + $printed)
+
+    # -----------------------------------------------------------------------------------------
