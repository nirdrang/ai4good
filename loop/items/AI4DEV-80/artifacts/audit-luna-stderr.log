   23:     if ($ok) { Write-Output ('PASS ' + $id + ' - ' + $what) }
   24:     else {
   25:         Write-Output ('FAIL ' + $id + ' - ' + $what + ' :: ' + $detail)
   26:         $script:failures = $script:failures + 1
   27:     }
   28: }
