   98: # whose directory holds the file), `toolUseId` (the spawn call inside the parent) and `spawnDepth`.
   99: #
  100: # So the role comes from the spawn call, and the parent edge comes from the spawn call. An earlier
  101: # version paired a `subagent_type` line with an `agentId:` line by their shared tool_use id and
  102: # read the role from the file name; the meta file states both directly, at any nesting depth.
  103: # A transcript with no meta file reads role `unmarked agent`, builds no edge, and is counted in
  104: # the floor note - never silently.
  105: #
  106: # THE META FILES ARE ALWAYS ALL READ, whatever -Days says: they are tiny, and an edge must exist
  107: # even when the parent's transcript falls outside the window.
  108: $metaOf = @{}
  109: foreach ($d in (Get-ChildItem $projDir -Directory -ErrorAction SilentlyContinue)) {
  110:     $sub = Join-Path $d.FullName 'subagents'
  111:     if (-not (Test-Path $sub)) { continue }
  112:     foreach ($mf in (Get-ChildItem $sub -Filter 'agent-*.meta.json' -File -Recurse -ErrorAction SilentlyContinue)) {
  113:         $id = $mf.Name -replace '^agent-', '' -replace '\.meta\.json$', ''
  114:         try {
  115:             $mj = Get-Content $mf.FullName -Raw | ConvertFrom-Json
  116:             $metaOf[$id] = @{
  117:                 agentType     = [string]$mj.agentType
  118:                 parentAgentId = [string]$mj.parentAgentId
  119:                 toolUseId     = [string]$mj.toolUseId
  120:                 # The agent's session, DERIVED from where the file sits, never declared: an agent
  121:                 # transcript lives under <projDir>\<sessionId>\subagents\. The spawn-context key
  122:                 # needs it (see the pre-pass below).
  123:                 session       = $d.Name
  124:             }
  125:         } catch { }
  126:     }
  127: }
  128: 
  129: # The tag is still read as a FALLBACK for old sessions whose branches predate the id convention.
  130: # Quotes arrive escaped (\") because a transcript is JSONL; the original pattern was written
  131: # against the tag as it renders on screen and therefore matched nothing from the day it was
  132: # written. Matches containing braces are refused - a transcript that READ this hook's source
  133: # contains the tag's own format template, and it attributed real tokens to buckets named {0}.
  134: $stampNew = [regex]'<ai4good-attribution pm=\\?"([^"\\]*)\\?" dev=\\?"([^"\\]*)\\?"/>'
  135: $stampOld = [regex]'<ai4good-attribution wave=\\?"([^"\\]*)\\?" project=\\?"([^"\\]*)\\?" bucket=\\?"([^"\\]*)\\?"/>'
  136: $branchRe = [regex]'"gitBranch":"([^"]*)"'
  137: # Same tokeniser the stamp uses: strict boundaries, zero-padding normalised, ALL matches collected
  138: # so a branch naming two items is unresolved rather than "take the first".
  139: # CASE-INSENSITIVE, and that is not a detail: Linear's branch names are lower-case
  140: # (`nirdrang/ai4dev-48-...`), so a case-sensitive pattern matches NOTHING and every response
  141: # silently falls back to the stamp - which is the same shape of failure this file already carries
  142: # two scars from. Verified against a real branch before being believed.
  143: $idRe = New-Object System.Text.RegularExpressions.Regex(
  144:     '(?<![A-Za-z0-9])AI4(DEV|PM)-0*([0-9]{1,7})(?![A-Za-z0-9])',
  145:     ([System.Text.RegularExpressions.RegexOptions]::IgnoreCase -bor [System.Text.RegularExpressions.RegexOptions]::CultureInvariant))
  146: 
  147: function Get-BranchItems([string]$branch) {
  148:     $ids = @()
  149:     foreach ($m in $idRe.Matches($branch)) {
  150:         $id = 'AI4' + $m.Groups[1].Value.ToUpperInvariant() + '-' + [string][int]$m.Groups[2].Value
  151:         if ($ids -notcontains $id) { $ids += $id }
  152:     }
  153:     return $ids
  154: }
  155: 
  156: # One stamp rule, used by both passes below, so they can never disagree.
  157: function Get-StampValue([string]$line, [string]$current) {
  158:     $m = $stampNew.Match($line)
  159:     if ($m.Success -and ($m.Value -notmatch '[{}]')) {
  160:         $d = $m.Groups[2].Value
  161:         if ($d -and $d -ne 'none' -and $d -ne '-') { return $d }
  162:         return ''
  163:     }
  164:     $m = $stampOld.Match($line)
  165:     if ($m.Success -and ($m.Value -notmatch '[{}]')) {
  166:         $b = $m.Groups[3].Value
  167:         if ($b) { return ('legacy:' + $b) }
  168:         return ''
  169:     }
  170:     return $current
  171: }
  172: 
  173: # ---------------------------------------------------------------------------------------------
  174: # PROPAGATION DOWN THE SPAWN TREE (the ruled design, founder 2026-08-11).
  175: #
  176: # Most agent records name the item branch themselves, and those need nothing. The rest are the
  177: # records an agent wrote before its worktree branch existed, or on `main`, or on a generated
  178: # `worktree-agent-*` branch. Today they all fall to unattributed. They belong to whatever item
  179: # their nearest ancestor was working on, and the spawn forest says who that ancestor is.
  180: #
  181: # This pre-pass collects the two facts the walk needs:
  182: #   - for each agent transcript, the distinct items its OWN records name;
  183: #   - for each session, the item it had resolved at each spawn call, keyed by the SESSION plus
  184: #     the tool_use id that the child's meta file names. State at the CALL, not at the end of the
  185: #     file: one session holds different items at different times, and each child inherits what
  186: #     was held when it was spawned.
  187: #
  188: # THE KEY CARRIES THE SESSION, and that is measured rather than assumed. A tool_use id alone was
  189: # not unique on this store: 580 ids appear in two session files, all of them in ONE pair, because
  190: # a resumed session writes a copy of the earlier session's records. The ids are not reused - the
  191: # records are copied. Five of those 580 resolve a DIFFERENT item in the two files, so a global key
  192: # lets whichever file is scanned first answer for the other. The session is derived from the file
  193: # for a session transcript and from the directory path for an agent, so nothing is declared.
  194: # (Measured 2026-08-11: loop/items/AI4DEV-80/artifacts/g2-3-probe.txt.)
  195: #
  196: # Both reads use the SAME unescaped-only branch match as the counting pass. An escaped
  197: # \"gitBranch\" inside a quoted tool result is another transcript being read, never a branch fact.
  198: $fileItems = @{}   # bare agent id -> the distinct items its own records name
  199: $spawnCtx  = @{}   # "<sessionId>|<tool_use id>" -> the item that session had resolved at that call
  200: $tuIdRe = [regex]'"(?:id|tool_use_id)"\s*:\s*"(toolu_[A-Za-z0-9]+)"'
  201: foreach ($f in $files) {
  202:     try {
  203:         $fs = New-Object System.IO.FileStream($f.FullName, [System.IO.FileMode]::Open, [System.IO.FileAccess]::Read, ([System.IO.FileShare]::ReadWrite -bor [System.IO.FileShare]::Delete))
  204:         $rd = New-Object System.IO.StreamReader($fs)
  205:     } catch { continue }
  206:     try {
  207:         if ($f.Name.StartsWith('agent-')) {
  208:             $aid = [System.IO.Path]::GetFileNameWithoutExtension($f.Name) -replace '^agent-', ''
  209:             $own = @()
  210:             while ($null -ne ($line = $rd.ReadLine())) {
  211:                 if ($line.IndexOf('"gitBranch"') -lt 0) { continue }
  212:                 $bm = $branchRe.Match($line)
  213:                 if (-not $bm.Success) { continue }
  214:                 foreach ($id in (Get-BranchItems $bm.Groups[1].Value)) { if ($own -notcontains $id) { $own += $id } }
  215:             }
  216:             $fileItems[$aid] = $own
  217:         }
  218:         else {
  219:             $cb = ''
  220:             $cs = ''
  221:             # A session file IS its session: the file's base name is the session id, and the
  222:             # agent directory beside it carries the same name (7 of 7 measured).
  223:             $sessId = [System.IO.Path]::GetFileNameWithoutExtension($f.Name)
  224:             while ($null -ne ($line = $rd.ReadLine())) {
  225:                 if ($line.IndexOf('"gitBranch"') -ge 0) {
  226:                     $bm = $branchRe.Match($line)
  227:                     if ($bm.Success) { $cb = $bm.Groups[1].Value }
  228:                 }
  229:                 if ($line.IndexOf('ai4good-attribution') -ge 0) { $cs = Get-StampValue $line $cs }
  230:                 if ($line.IndexOf('toolu_') -lt 0) { continue }
  231:                 foreach ($m in $tuIdRe.Matches($line)) {
  232:                     $tid = $sessId + '|' + $m.Groups[1].Value
  233:                     # FIRST sighting wins WITHIN THE SESSION: the spawn call comes before its own
  234:                     # tool result. Another session's copy of the same id is a different key.
  235:                     if ($spawnCtx.ContainsKey($tid)) { continue }
  236:                     $bids = @(Get-BranchItems $cb)
  237:                     if ($bids.Count -eq 1) { $spawnCtx[$tid] = $bids[0] }
  238:                     elseif ($bids.Count -eq 0 -and $cs) {
  239:                         $sids = @(Get-BranchItems $cs)
  240:                         if ($sids.Count -eq 1) { $spawnCtx[$tid] = $sids[0] }
  241:                     }
  242:                 }
  243:             }
  244:         }
  245:     }
  246:     finally { $rd.Dispose() }
  247: }
  248: 
  249: $ambiguousAgents = 0
  250: foreach ($k in $fileItems.Keys) { if (@($fileItems[$k]).Count -gt 1) { $ambiguousAgents++ } }
  251: 
  252: # TREE-ITEM(agent), in the ruled order:
  253: #   (a) the single distinct item the agent's own records name;
  254: #   (b) ONLY when (a) finds ZERO items, the parent agent's tree item, walking parentAgentId
  255: #       upward. A file naming TWO items is ambiguous and inherits NOTHING - degrade, never guess;
  256: #   (c) at a session root, the item the session had resolved at this agent's own spawn call.
  257: #
  258: # THERE IS NO DEPTH CAP. The VISITED SET is the only guard and must stay: a cap would truncate a
  259: # valid deep chain, while a parentAgentId cycle would recurse for ever without the set.
  260: $treeItem = @{}
  261: function Get-TreeItem([string]$agentId, [hashtable]$visited) {
  262:     if ($treeItem.ContainsKey($agentId)) { return $treeItem[$agentId] }
  263:     if ($visited.ContainsKey($agentId)) { return '' }
  264:     $visited[$agentId] = $true
  265:     $result = ''
  266:     $own = @()
  267:     if ($fileItems.ContainsKey($agentId)) { $own = @($fileItems[$agentId]) }
  268:     if ($own.Count -eq 1) { $result = $own[0] }
  269:     elseif ($own.Count -eq 0 -and $metaOf.ContainsKey($agentId)) {
  270:         $meta = $metaOf[$agentId]
  271:         if ($meta.parentAgentId) { $result = [string](Get-TreeItem $meta.parentAgentId $visited) }
  272:         elseif ($meta.toolUseId -and $meta.session) {
  273:             $ctxKey = [string]$meta.session + '|' + [string]$meta.toolUseId
  274:             if ($spawnCtx.ContainsKey($ctxKey)) { $result = $spawnCtx[$ctxKey] }
  275:         }
  276:     }
  277:     $treeItem[$agentId] = $result
  278:     return $result
  279: }
  280: 
  281: # ---- the chains, from the cache /work writes (never a Linear call from a report)
  282: $chains = @{}
  283: $attrDir = $AttrDir
  284: foreach ($f in (Get-ChildItem $attrDir -Filter 'chain-*.json' -File -ErrorAction SilentlyContinue)) {
  285:     try {
  286:         $j = Get-Content $f.FullName -Raw | ConvertFrom-Json
  287:         $item = [string]$j.item
  288:         $nodes = @($j.chain | ForEach-Object { [string]$_.id })
  289:         # Duplicates exist (the same item resolved in two worktrees). Keep the LONGEST chain: a
  290:         # shorter one is a walk that stopped early, and claiming a nearer root than the real one
  291:         # is the confident-wrong answer this design forbids.
  292:         if ($item -and $nodes.Count -gt 0) {
  293:             if (-not $chains.ContainsKey($item) -or $nodes.Count -gt $chains[$item].Count) { $chains[$item] = $nodes }
  294:         }
  295:     } catch { }
  296: }
  297: 
  298: $agg = @{}   # key "item|source" -> counters
  299: $roleAgg = @{}  # key "item|role" -> counters
  300: $agentItem = @{}  # agent id (the task file's base name) -> the item it worked on
  301: function Add-Usage([string]$key, $usage, [hashtable]$agg) {
  302:     if (-not $agg.ContainsKey($key)) {
  303:         $agg[$key] = @{ responses = 0; inTok = [long]0; outTok = [long]0; cacheRead = [long]0; cacheWrite = [long]0 }
  304:     }
  305:     $a = $agg[$key]
  306:     $a.responses++
  307:     if ($usage.input_tokens)                { $a.inTok      += [long]$usage.input_tokens }
  308:     if ($usage.output_tokens)               { $a.outTok     += [long]$usage.output_tokens }
  309:     if ($usage.cache_read_input_tokens)     { $a.cacheRead  += [long]$usage.cache_read_input_tokens }
  310:     if ($usage.cache_creation_input_tokens) { $a.cacheWrite += [long]$usage.cache_creation_input_tokens }
  311: }
  312: 
  313: $sessions = 0
  314: $skipped = 0
  315: $unmarkedAgents = 0
  316: foreach ($f in $files) {
  317:     $curBranch = ''          # derived, primary
  318:     $curStamp = ''           # declared, fallback only
  319:     # Which kind of transcript this is comes from the platform's own naming, declared by nobody:
  320:     # an agent transcript is `agent-<agentId>.jsonl` at any depth, and a session file is named by
  321:     # its session id. A session was spawned by nobody and is the coordinator.
  322:     $base = [System.IO.Path]::GetFileNameWithoutExtension($f.Name)
  323:     $isAgent = $f.Name.StartsWith('agent-')
  324:     $joinKey = $base
  325:     $curRole = 'coordinator'
  326:     $curTree = ''
  327:     $curAmbiguous = $false
  328:     if ($isAgent) {
  329:         $joinKey = $base -replace '^agent-', ''
  330:         if ($metaOf.ContainsKey($joinKey) -and $metaOf[$joinKey].agentType) { $curRole = $metaOf[$joinKey].agentType }
  331:         else { $curRole = 'unmarked agent'; $unmarkedAgents++ }
  332:         $curTree = [string](Get-TreeItem $joinKey (New-Object 'System.Collections.Hashtable'))
  333:         # An agent whose own records name TWO OR MORE items is ambiguous. Per-record attribution
  334:         # to two items is a fact; per-AGENT vendor spend credited wholly to one of them is a guess.
  335:         if ($fileItems.ContainsKey($joinKey) -and @($fileItems[$joinKey]).Count -gt 1) { $curAmbiguous = $true }
  336:     }
  337:     # Shared read: a transcript belonging to a RUNNING agent or background task is locked, and a
  338:     # report that dies on a live file can never be run while anything is working - which is
  339:     # exactly when it is most worth running.
  340:     try {
  341:         $fs = New-Object System.IO.FileStream($f.FullName, [System.IO.FileMode]::Open, [System.IO.FileAccess]::Read, ([System.IO.FileShare]::ReadWrite -bor [System.IO.FileShare]::Delete))
  342:         $reader = New-Object System.IO.StreamReader($fs)
  343:     }
  344:     catch { $skipped++; continue }
  345:     $sessions++
  346:     try {
  347:         while ($null -ne ($line = $reader.ReadLine())) {
  348:             if ($line.IndexOf('"gitBranch"') -ge 0) {
  349:                 $bm = $branchRe.Match($line)
  350:                 if ($bm.Success) { $curBranch = $bm.Groups[1].Value }
  351:             }
  352:             if ($line.IndexOf('ai4good-attribution') -ge 0) { $curStamp = Get-StampValue $line $curStamp }
  353:             if ($line.IndexOf('"usage"') -ge 0 -and $line.IndexOf('"output_tokens"') -ge 0) {
  354:                 try {
  355:                     $o = $line | ConvertFrom-Json
  356:                     $u = $null
  357:                     if ($o.message -and $o.message.usage) { $u = $o.message.usage }
  358:                     elseif ($o.usage) { $u = $o.usage }
  359:                     if ($u -and $o.type -eq 'assistant') {
  360:                         # Own record branch first, exactly as before. The tree is a FALLBACK for a
  361:                         # record that resolves nothing on its own - it never overrides a branch.
  362:                         #
  363:                         # THE STAMP FALLBACK IS FOR SESSION FILES ONLY. The stamp regex matches the
  364:                         # escaped form on purpose, so an agent transcript that QUOTES a stamp - in
  365:                         # a spawn prompt or a tool result - would otherwise set $curStamp and let an
  366:                         # unresolvable agent guess an item from text it merely read. An agent
  367:                         # resolves branch, then tree, then nothing.
  368:                         $ids = @(Get-BranchItems $curBranch)
  369:                         if ($ids.Count -eq 1)                  { Add-Usage ($ids[0] + '|branch')  $u $agg }
  370:                         elseif ($ids.Count -gt 1)              { Add-Usage ('unresolved|branch')  $u $agg }
  371:                         elseif ($curTree)                      { Add-Usage ($curTree + '|tree')   $u $agg }
  372:                         elseif ($curStamp -and (-not $isAgent)) { Add-Usage ($curStamp + '|stamp') $u $agg }
  373:                         else                                   { Add-Usage ('unattributed|none')  $u $agg }
  374:                         # A tree-resolved response feeds the role table and the vendor join key
  375:                         # exactly as a branch-resolved one does.
  376:                         #
  377:                         # THE VENDOR JOIN KEY DEGRADES LIKE THE TREE WALK. An ambiguous agent gets
  378:                         # no $agentItem entry, so its kimi spend stays unjoined rather than being
  379:                         # credited whole to whichever of its items its last branch record named.
  380:                         # The tree-fed assignment below needs no such guard: an ambiguous agent
  381:                         # never has a tree item.
  382:                         if ($ids.Count -eq 1) {
  383:                             Add-Usage ($ids[0] + '|' + $curRole) $u $roleAgg
  384:                             if (-not $curAmbiguous) { $agentItem[$joinKey] = $ids[0] }
  385:                         }
  386:                         elseif ($ids.Count -eq 0 -and $curTree) {
  387:                             Add-Usage ($curTree + '|' + $curRole) $u $roleAgg
  388:                             $agentItem[$joinKey] = $curTree
  389:                         }
  390:                     }
  391:                 } catch { }
  392:             }
  393:         }
  394:     }
  395:     finally { $reader.Dispose() }
  396: }
  397: 
  398: # ---- per item
  399: $rows = @()
  400: foreach ($k in $agg.Keys) {
  401:     $item, $src = $k -split '\|'
  402:     $a = $agg[$k]
  403:     $rows += [pscustomobject]@{ Item=$item; From=$src; Responses=$a.responses; OutputTok=$a.outTok; InputTok=$a.inTok; CacheRead=$a.cacheRead; CacheWrite=$a.cacheWrite }
  404: }
  405: $rows = $rows | Sort-Object -Property @{e='OutputTok';Descending=$true}
  406: 
  407: # ---- rolled up the chain: every ancestor carries its descendants' cost, and the item carries its own
  408: $roll = @{}
  409: function Add-Roll([string]$node, $r, [hashtable]$roll) {
  410:     if (-not $roll.ContainsKey($node)) { $roll[$node] = @{ responses = 0; outTok = [long]0; items = @() } }
  411:     $roll[$node].responses += $r.Responses
  412:     $roll[$node].outTok    += $r.OutputTok
  413:     if ($roll[$node].items -notcontains $r.Item) { $roll[$node].items += $r.Item }
  414: }
  415: foreach ($r in $rows) {
  416:     if ($r.Item -notmatch '^AI4(DEV|PM)-[0-9]+$') { continue }
  417:     if ($chains.ContainsKey($r.Item)) { foreach ($n in $chains[$r.Item]) { Add-Roll $n $r $roll } }
  418:     else { Add-Roll '(chain not cached)' $r $roll; Add-Roll $r.Item $r $roll }
  419: }
  420: $rollRows = @()
  421: foreach ($k in $roll.Keys) {
  422:     $rollRows += [pscustomobject]@{ Node=$k; Covers=$roll[$k].items.Count; Responses=$roll[$k].responses; OutputTok=$roll[$k].outTok }
  423: }
  424: $rollRows = $rollRows | Sort-Object -Property @{e='OutputTok';Descending=$true}
  425: 
  426: # ---- vendor spend (codex), joined by the session id the reviewer printed into its own log
  427: #
  428: # Every codex run writes a header containing `session id: <uuid>`, and we COMMIT those logs into
  429: # loop/items/<ITEM>/ - so the ids live in the repository and survive the artifact sweep. Codex
  430: # stores each run as sessions/<y>/<m>/<d>/rollout-<timestamp>-<uuid>.jsonl carrying real token
  431: # counts. Joining the two attributes reviewer spend to the item whose folder holds the log:
  432: # derived from what the tool emitted and what the item recorded, declared by nobody.
  433: #
  434: # KIMI IS INCLUDED, and an earlier version of this file claimed it could not be. That claim was
  435: # FALSE and was written after a search that used `-SimpleMatch` with a pattern containing `|`,
  436: # so it looked for the literal pipes instead of the alternatives and found nothing. The founder
  437: # pointed at the real location. Kimi keeps
  438: # ~/.kimi-code/sessions/wd_agent-<agentId>_*/session_*/agents/*/wire.jsonl, whose usage records
  439: # read {inputOther, output, inputCacheRead, inputCacheCreation} and are PER TURN - so they are
  440: # summed, unlike codex's cumulative total. The directory name embeds the id of the agent that
  441: # launched it, and that agent's own transcript gives the item, so the join needs nothing declared.
  442: $vendor = @{}
  443: $itemsDir = $ItemsDir
  444: $sessRe = [regex]'session id:\s*([0-9a-fA-F-]{36})'
  445: $rollouts = @{}
  446: $codexSessions = $CodexSessions
  447: if (Test-Path $codexSessions) {
  448:     foreach ($rf in (Get-ChildItem $codexSessions -Recurse -File -Filter 'rollout-*.jsonl' -ErrorAction SilentlyContinue)) {
  449:         $mm = [regex]::Match($rf.Name, '([0-9a-fA-F-]{36})\.jsonl$')
  450:         if ($mm.Success) { $rollouts[$mm.Groups[1].Value.ToLower()] = $rf.FullName }
  451:     }
  452: }
  453: if (Test-Path $itemsDir) {
  454:     foreach ($dir in (Get-ChildItem $itemsDir -Directory -ErrorAction SilentlyContinue)) {
  455:         $item = $dir.Name
  456:         # -Recurse: since 2026-08-09 reviewer logs land in loop/items/<ITEM>/artifacts/, one level down
  457:         foreach ($log in (Get-ChildItem $dir.FullName -File -Filter '*stderr*' -Recurse -ErrorAction SilentlyContinue)) {
  458:             foreach ($sm in $sessRe.Matches([System.IO.File]::ReadAllText($log.FullName))) {
  459:                 $sid = $sm.Groups[1].Value.ToLower()
  460:                 if (-not $rollouts.ContainsKey($sid)) { continue }
  461:                 if (-not $vendor.ContainsKey($item)) { $vendor[$item] = @{ runs = 0; inTok = [long]0; outTok = [long]0; cached = [long]0 } }
  462:                 $v = $vendor[$item]; $v.runs++
  463:                 foreach ($l in [System.IO.File]::ReadLines($rollouts[$sid])) {
  464:                     if ($l.IndexOf('"output_tokens"') -lt 0) { continue }
  465:                     try {
  466:                         $o = $l | ConvertFrom-Json
  467:                         $tu = $null
  468:                         if ($o.payload -and $o.payload.info -and $o.payload.info.total_token_usage) { $tu = $o.payload.info.total_token_usage }
  469:                         elseif ($o.info -and $o.info.total_token_usage) { $tu = $o.info.total_token_usage }
  470:                         if ($tu) {
  471:                             # total_token_usage is CUMULATIVE for the session, so the last one wins
  472:                             # rather than being summed - adding them would multiply the real cost.
  473:                             $v.inTok = [long]$tu.input_tokens; $v.outTok = [long]$tu.output_tokens
  474:                             if ($tu.cached_input_tokens) { $v.cached = [long]$tu.cached_input_tokens }
  475:                         }
  476:                     } catch { }
  477:                 }
  478:             }
  479:         }
  480:     }
  481: }
  482: 
  483: $kimi = @{}
  484: $kimiRoot = $KimiRoot
  485: if (Test-Path $kimiRoot) {
  486:     foreach ($wd in (Get-ChildItem $kimiRoot -Directory -ErrorAction SilentlyContinue)) {
  487:         $am = [regex]::Match($wd.Name, 'wd_agent-([A-Za-z0-9]+)_')
  488:         if (-not $am.Success) { continue }
  489:         $agentId = $am.Groups[1].Value
  490:         if (-not $agentItem.ContainsKey($agentId)) { continue }
  491:         $item = $agentItem[$agentId]
  492:         foreach ($wire in (Get-ChildItem $wd.FullName -Recurse -File -Filter 'wire.jsonl' -ErrorAction SilentlyContinue)) {
  493:             if (-not $kimi.ContainsKey($item)) { $kimi[$item] = @{ sessions = 0; inTok = [long]0; outTok = [long]0; cached = [long]0 } }
  494:             $kimi[$item].sessions++
  495:             foreach ($l in [System.IO.File]::ReadLines($wire.FullName)) {
  496:                 if ($l.IndexOf('"usage"') -lt 0) { continue }
  497:                 try {
  498:                     $o = $l | ConvertFrom-Json
  499:                     $u2 = $o.usage
  500:                     if ($u2) {
  501:                         if ($u2.inputOther)         { $kimi[$item].inTok  += [long]$u2.inputOther }
  502:                         if ($u2.output)             { $kimi[$item].outTok += [long]$u2.output }
  503:                         if ($u2.inputCacheRead)     { $kimi[$item].cached += [long]$u2.inputCacheRead }
  504:                     }
  505:                 } catch { }
  506:             }
  507:         }
  508:     }
  509: }
  510: 
  511: $totOut  = ($rows | Measure-Object OutputTok -Sum).Sum
  512: $totResp = ($rows | Measure-Object Responses -Sum).Sum
  513: $unatt   = ($rows | Where-Object { $_.Item -eq 'unattributed' } | Measure-Object OutputTok -Sum).Sum
  514: if (-not $totOut) { $totOut = 0 }
  515: if (-not $unatt) { $unatt = 0 }
  516: $pct = if ($totOut -gt 0) { [math]::Round(100.0 * $unatt / $totOut, 1) } else { 0 }
  517: 
  518: # -Item scopes every section to one item (and, for the rollup, to nodes that cover it).
  519: $scopeNote = if ($ItemFilter) { ' - SCOPED to ' + $ItemFilter } else { '' }
  520: if ($ItemFilter) {
  521:     $rows     = @($rows     | Where-Object { $_.Item -eq $ItemFilter })
  522:     $rollRows = @($rollRows | Where-Object { $_.Node -eq $ItemFilter -or $chains[$ItemFilter] -contains $_.Node })
  523: }
  524: 
  525: # Every row set is built here, BEFORE any output, so the JSON oracle and the printed tables
  526: # describe exactly the same aggregates - one derivation, two renderings.
  527: $roleRows = @()
  528: foreach ($k in $roleAgg.Keys) {
  529:     $it, $rl = $k -split '\|'
  530:     if ($ItemFilter -and $it -ne $ItemFilter) { continue }
  531:     $a = $roleAgg[$k]
  532:     $roleRows += [pscustomobject]@{ Item=$it; Role=$rl; Responses=$a.responses; InputTok=$a.inTok; OutputTok=$a.outTok; CacheRead=$a.cacheRead; CacheWrite=$a.cacheWrite }
  533: }
  534: $roleRows = @($roleRows | Sort-Object Item, @{e='OutputTok';Descending=$true})
  535: 
  536: $vRows = @()
  537: foreach ($k in $vendor.Keys) {
  538:     if ($ItemFilter -and $k -ne $ItemFilter) { continue }
  539:     $vRows += [pscustomobject]@{ Item=$k; Runs=$vendor[$k].runs; InputTok=$vendor[$k].inTok; OutputTok=$vendor[$k].outTok; CachedIn=$vendor[$k].cached }
  540: }
  541: $vRows = @($vRows | Sort-Object OutputTok -Descending)
  542: 
  543: $kRows = @()
  544: foreach ($k in $kimi.Keys) {
  545:     if ($ItemFilter -and $k -ne $ItemFilter) { continue }
  546:     $kRows += [pscustomobject]@{ Item=$k; Sessions=$kimi[$k].sessions; InputTok=$kimi[$k].inTok; OutputTok=$kimi[$k].outTok; CacheRead=$kimi[$k].cached }
  547: }
  548: $kRows = @($kRows | Sort-Object OutputTok -Descending)
  549: 
  550: # -Json emits the aggregates instead of the tables, so a test asserts on numbers rather than on
  551: # Format-Table whitespace. Windows PowerShell 5.1 needs an explicit -Depth.
  552: if ($Json) {
  553:     $out = [pscustomobject]@{
  554:         rows      = @($rows)
  555:         roleRows  = $roleRows
  556:         rollRows  = @($rollRows)
  557:         codexRows = $vRows
  558:         kimiRows  = $kRows
  559:         totals    = [pscustomobject]@{
  560:             responses             = $totResp
  561:             outputTok             = $totOut
  562:             unattributedOutputTok = $unatt
  563:             unattributedPct       = $pct
  564:             transcriptFiles       = $sessions
  565:             skippedFiles          = $skipped
  566:             item                  = $ItemFilter
  567:             days                  = $Days
  568:         }
  569:     }
  570:     $out | ConvertTo-Json -Depth 6
  571:     exit 0
  572: }
  573: 
  574: Write-Output ('ai4good buildout burn report - ' + (Get-Date -Format 'yyyy-MM-dd') + ' - ' + $sessions + ' transcript file(s), sessions and agents' + $(if ($Days -gt 0) { ' (last ' + $Days + ' days)' } else { '' }) + $scopeNote)
  575: Write-Output 'units: provider-echoed tokens per response (REQ-034 model); money lives elsewhere'
  576: Write-Output 'attribution DERIVED from each record''s own git branch, and from the spawn tree where the record names none; role DERIVED from the spawn call'
  577: Write-Output ''
  578: Write-Output ('== PER ITEM ==' + $scopeNote)
  579: if ($rows.Count -eq 0) { Write-Output ('  no responses attributed to ' + $ItemFilter + ' in this window') }
  580: else { $rows | Format-Table Item, From, Responses, OutputTok, InputTok, CacheRead, CacheWrite -AutoSize | Out-String -Width 200 | Write-Output }
  581: Write-Output ('== PER ROLE WITHIN EACH ITEM (role from the spawn call, not any ROLE: text)' + $scopeNote + ' ==')
  582: if ($roleRows.Count -eq 0) { Write-Output '  no role-attributed responses in scope' }
  583: else { $roleRows | Format-Table -AutoSize | Out-String -Width 200 | Write-Output }
  584: Write-Output 'InputTok is nearly always tiny next to CacheRead: almost everything an agent reads arrives from cache, so input alone understates what was consumed by orders of magnitude.'
  585: Write-Output ''
  586: Write-Output '== REVIEWER SPEND (codex, joined by the session id in each item''s committed logs) =='
  587: if ($vendor.Count -eq 0) { Write-Output '  none joined - no committed reviewer log matched a stored codex session' }
  588: elseif ($vRows.Count -eq 0) { Write-Output '  none in scope' }
  589: else { $vRows | Format-Table -AutoSize | Out-String -Width 200 | Write-Output }
  590: Write-Output ''
  591: Write-Output '== REVIEWER SPEND (kimi, joined by the launching agent id in its session directory) =='
  592: if ($kimi.Count -eq 0) { Write-Output '  none joined - no kimi session directory named an agent this run resolved to an item' }
  593: elseif ($kRows.Count -eq 0) { Write-Output '  none in scope' }
  594: else { $kRows | Format-Table -AutoSize | Out-String -Width 200 | Write-Output }
  595: Write-Output ''
  596: Write-Output '== ROLLED UP THE CHAIN (each node includes everything beneath it) =='
  597: $rollRows | Format-Table Node, Covers, Responses, OutputTok -AutoSize | Out-String -Width 200 | Write-Output
  598: Write-Output ('TOTAL: ' + $totResp + ' responses, ' + $totOut + ' output tokens. The PER ITEM table reconciles to this total by construction; the rollup deliberately double-counts, because a parent includes its children.')
  599: Write-Output ('COORDINATOR SIGNAL - unattributed share of output tokens: ' + $pct + '%')
  600: if ($skipped -gt 0) { Write-Output ($skipped.ToString() + ' transcript file(s) could not be opened and are NOT counted - said out loud rather than silently dropped') }
  601: Write-Output ''
  602: Write-Output 'Still a FLOOR, for named reasons. A nested sitting no longer falls to unattributed: that gap is closed, because the agent transcripts are now scanned and an agent that resolves no item of its own inherits its nearest ancestor''s item. What remains:'
  603: Write-Output '  - Coordinator work on main that holds no item resolves to nothing, and neither do the agents beneath it: the tree has no item to hand down.'
  604: Write-Output ('  - ' + $ambiguousAgents + ' agent transcript(s) name TWO OR MORE items in their own records. Their branchless responses stay unattributed rather than being guessed, and their vendor spend stays unjoined for the same reason.')
  605: Write-Output ('  - ' + $unmarkedAgents + ' agent transcript(s) have no meta file beside them, so their role reads "unmarked agent" and they build no edge.')
  606: Write-Output '  - Reviewer spend is only partly joined. The codex and kimi tables above cover the runs whose logs this repository holds. The flash and opencode reviewer spend is not joined at all; that work is filed separately and is not built here.'
  607: Write-Output '  - A -Days window that excludes an ancestor transcript loses the item that ancestor would have handed down. The default, all history, has no such gap.'
--- SELFTEST ---
    1: # attribution-report.selftest.ps1 - the executable criteria of AI4DEV-80 (attribution by spawn tree).
    2: #
    3: # It builds a SYNTHETIC transcript store in a temp directory, points attribution-report.ps1 at it
    4: # with the root override parameters, and asserts on the -Json aggregates. The oracle is numbers,
    5: # never Format-Table whitespace.
    6: #
    7: # Every expected number is COMPUTED from the bytes the fixture wrote, with the same counting
    8: # predicate the report uses. Nothing is hard-coded, so a fixture edit cannot silently make an
    9: # assert vacuous.
   10: #
   11: #   powershell -File loop/work/attribution-report.selftest.ps1
   12: #   exit 0 = every assert green; exit 1 = at least one assert red.
   13: $ErrorActionPreference = 'Stop'
   14: 
   15: $report = Join-Path $PSScriptRoot 'attribution-report.ps1'
   16: if (-not (Test-Path $report)) { throw ('report script not found: ' + $report) }
   17: 
   18: # ---------------------------------------------------------------------------------------------
   19: # assert bookkeeping
   20: # ---------------------------------------------------------------------------------------------
   21: $script:failures = 0
   22: function Assert-That([string]$id, [string]$what, [bool]$ok, [string]$detail) {
   23:     if ($ok) { Write-Output ('PASS ' + $id + ' - ' + $what) }
   24:     else {
   25:         Write-Output ('FAIL ' + $id + ' - ' + $what + ' :: ' + $detail)
   26:         $script:failures = $script:failures + 1
   27:     }
   28: }
   29: 
   30: # ---------------------------------------------------------------------------------------------
   31: # fixture writers
   32: # ---------------------------------------------------------------------------------------------
   33: function Write-Lines([string]$path, [string[]]$lines) {
   34:     $dir = Split-Path -Parent $path
   35:     if (-not (Test-Path $dir)) { New-Item -ItemType Directory -Path $dir -Force | Out-Null }
   36:     [System.IO.File]::WriteAllLines($path, $lines)
   37: }
   38: 
   39: # One assistant response with provider-echoed usage, carrying its own record branch.
   40: function New-UsageLine([string]$branch, [int]$outTok) {
   41:     return '{"type":"assistant","gitBranch":"' + $branch + '","message":{"usage":{"input_tokens":5,"output_tokens":' + $outTok + ',"cache_read_input_tokens":1000,"cache_creation_input_tokens":10}}}'
   42: }
   43: 
   44: # The stamp as it really lands in a JSONL record: the quotes arrive escaped.
   45: function New-StampLine([string]$item) {
   46:     return '{"type":"user","gitBranch":"main","message":{"content":"WORKING ON <ai4good-attribution pm=\"none\" dev=\"' + $item + '\"/> fixture stamp"}}'
   47: }
   48: 
   49: # A spawn call in the parent session. It carries the tool_use id the child meta names.
   50: function New-SpawnLine([string]$toolUseId, [string]$agentType) {
   51:     return '{"type":"assistant","gitBranch":"main","message":{"content":[{"type":"tool_use","id":"' + $toolUseId + '","name":"Task","input":{"subagent_type":"' + $agentType + '"}}]}}'
   52: }
   53: 
   54: # A tool result that QUOTES another transcript. Its gitBranch is escaped, so it is not a branch
   55: # fact - the decoy of G1-10.
   56: function New-DecoyLine([string]$decoyBranch) {
   57:     return '{"type":"user","gitBranch":"","message":{"content":"tool result: {\"type\":\"assistant\",\"gitBranch\":\"' + $decoyBranch + '\"}"}}'
   58: }
   59: 
   60: function New-MetaJson([hashtable]$fields) {
   61:     $parts = @()
   62:     foreach ($k in $fields.Keys) {
   63:         $v = $fields[$k]
   64:         if ($v -is [int]) { $parts += ('"' + $k + '":' + $v) }
   65:         else { $parts += ('"' + $k + '":"' + $v + '"') }
   66:     }
   67:     return '{' + ($parts -join ',') + '}'
   68: }
   69: 
   70: # The same counting predicate the report uses, applied to the fixture's own lines.
   71: function Measure-Lines([string[]]$lines) {
   72:     $n = 0
   73:     $o = [long]0
   74:     foreach ($l in $lines) {
   75:         if ($l.IndexOf('"usage"') -lt 0) { continue }
   76:         if ($l.IndexOf('"output_tokens"') -lt 0) { continue }
   77:         $j = $null
   78:         try { $j = $l | ConvertFrom-Json } catch { continue }
   79:         if ($j.type -ne 'assistant') { continue }
   80:         $u = $null
   81:         if ($j.message -and $j.message.usage) { $u = $j.message.usage }
   82:         elseif ($j.usage) { $u = $j.usage }
   83:         if (-not $u) { continue }
   84:         $n = $n + 1
   85:         $o = $o + [long]$u.output_tokens
   86:     }
   87:     return [pscustomobject]@{ Responses = $n; OutputTok = $o }
   88: }
   89: function Measure-File([string]$path) { return (Measure-Lines ([System.IO.File]::ReadAllLines($path))) }
   90: 
   91: # ---------------------------------------------------------------------------------------------
   92: # aggregate lookups over the -Json oracle
   93: # ---------------------------------------------------------------------------------------------
   94: function Get-Row($j, [string]$item, [string]$from) {
   95:     $r = @($j.rows | Where-Object { $_.Item -eq $item -and $_.From -eq $from })
   96:     if ($r.Count -eq 0) { return [pscustomobject]@{ Item=$item; From=$from; Responses=0; OutputTok=[long]0; Missing=$true } }
   97:     return $r[0]
   98: }
   99: function Get-RoleRow($j, [string]$item, [string]$role) {
  100:     $r = @($j.roleRows | Where-Object { $_.Item -eq $item -and $_.Role -eq $role })
  101:     if ($r.Count -eq 0) { return [pscustomobject]@{ Item=$item; Role=$role; Responses=0; OutputTok=[long]0; Missing=$true } }
  102:     return $r[0]
  103: }
  104: function Get-RollRow($j, [string]$node) {
  105:     $r = @($j.rollRows | Where-Object { $_.Node -eq $node })
  106:     if ($r.Count -eq 0) { return [pscustomobject]@{ Node=$node; Responses=0; OutputTok=[long]0; Missing=$true } }
  107:     return $r[0]
  108: }
  109: function Sum-Of($rows, [string]$prop) {
  110:     $s = [long]0
  111:     foreach ($r in @($rows)) { $s = $s + [long]$r.$prop }
  112:     return $s
  113: }
  114: 
  115: # ---------------------------------------------------------------------------------------------
  116: # the fixture store
  117: # ---------------------------------------------------------------------------------------------
  118: $root       = Join-Path ([System.IO.Path]::GetTempPath()) ('attr-selftest-' + [guid]::NewGuid().ToString('N'))
  119: $projects   = Join-Path $root 'projects'
  120: $sessionId  = '11111111-2222-3333-4444-555555555555'
  121: $sessionFile= Join-Path $projects ($sessionId + '.jsonl')
  122: $sessionDir = Join-Path $projects $sessionId
  123: $subagents  = Join-Path $sessionDir 'subagents'
  124: $tasksDir   = Join-Path $sessionDir 'tasks'
  125: $attrDir    = Join-Path $root 'attr'
  126: $itemsDir   = Join-Path $root 'items'
  127: $codexDir   = Join-Path $root 'codex'
  128: $kimiDir    = Join-Path $root 'kimi'
  129: 
  130: $ITEM_A = 'AI4DEV-901'   # the item the coordinator holds first; chained under AI4DEV-900
  131: $ITEM_B = 'AI4DEV-902'   # the item it holds later; deliberately chainless
  132: $ROOT_A = 'AI4DEV-900'
  133: $DECOY  = 'AI4DEV-999'
  134: 
  135: try {
  136:     New-Item -ItemType Directory -Path $projects  -Force | Out-Null
  137:     New-Item -ItemType Directory -Path $subagents -Force | Out-Null
  138:     New-Item -ItemType Directory -Path $tasksDir  -Force | Out-Null
  139:     New-Item -ItemType Directory -Path $attrDir   -Force | Out-Null
  140:     New-Item -ItemType Directory -Path $itemsDir  -Force | Out-Null
  141:     New-Item -ItemType Directory -Path $codexDir  -Force | Out-Null
  142:     New-Item -ItemType Directory -Path $kimiDir   -Force | Out-Null
  143: 
  144:     # --- the coordinator session: it holds ITEM_A, spawns C1 and U1, THEN moves to ITEM_B and
  145:     # spawns U2. A latest-wins or file-wide implementation cannot satisfy both U1 and U2.
  146:     $sessionA = @(
  147:         (New-StampLine $ITEM_A),
  148:         (New-UsageLine 'main' 11),
  149:         (New-UsageLine 'main' 11)
  150:     )
  151:     $sessionSpawns = @(
  152:         (New-SpawnLine 'toolu_01FixtureCONDUCTOR' 'conductor'),
  153:         (New-SpawnLine 'toolu_01FixtureUTILONE'   'general-purpose')
  154:     )
  155:     $sessionB = @(
  156:         (New-StampLine $ITEM_B),
  157:         (New-UsageLine 'main' 13)
  158:     )
  159:     $sessionSpawnB = @( (New-SpawnLine 'toolu_01FixtureUTILTWO' 'general-purpose') )
  160:     Write-Lines $sessionFile ($sessionA + $sessionSpawns + $sessionB + $sessionSpawnB)
  161: 
  162:     # --- C1, the conductor: its OWN records name the item branch (the common case).
  163:     $c1Lines = @(
  164:         (New-UsageLine 'nirdrang/ai4dev-901-fixture' 21),
  165:         (New-UsageLine 'nirdrang/ai4dev-901-fixture' 21),
  166:         (New-UsageLine 'nirdrang/ai4dev-901-fixture' 21)
  167:     )
  168:     Write-Lines (Join-Path $subagents 'agent-C1.jsonl') $c1Lines
  169:     Write-Lines (Join-Path $subagents 'agent-C1.meta.json') @((New-MetaJson @{ agentType='conductor'; description='fixture conductor'; toolUseId='toolu_01FixtureCONDUCTOR'; spawnDepth=1; model='sonnet' }))
  170: 
  171:     # --- O1 and O2, orchestrator sittings under C1: branchless records, so they resolve only
  172:     # through the spawn tree. O1 also carries the escaped decoy.
  173:     $o1Lines = @(
  174:         (New-DecoyLine 'nirdrang/ai4dev-999-decoy'),
  175:         (New-UsageLine '' 31),
  176:         (New-UsageLine '' 31)
  177:     )
  178:     Write-Lines (Join-Path $subagents 'agent-O1.jsonl') $o1Lines
  179:     Write-Lines (Join-Path $subagents 'agent-O1.meta.json') @((New-MetaJson @{ agentType='orchestrator'; description='fixture sitting one'; toolUseId='toolu_01FixtureORCHONE'; parentAgentId='C1'; spawnDepth=2; model='opus' }))
  180: 
  181:     $o2Lines = @(
  182:         (New-UsageLine '' 41),
  183:         (New-UsageLine '' 41)
  184:     )
  185:     Write-Lines (Join-Path $subagents 'agent-O2.jsonl') $o2Lines
  186:     Write-Lines (Join-Path $subagents 'agent-O2.meta.json') @((New-MetaJson @{ agentType='orchestrator'; description='fixture sitting two'; toolUseId='toolu_01FixtureORCHTWO'; parentAgentId='C1'; spawnDepth=2; model='opus' }))
  187: 
  188:     # --- E1, the executor under O1: a TWO-level walk, E1 -> O1 -> C1. Its file is backdated for
  189:     # the -Days assert.
  190:     $e1Lines = @(
  191:         (New-UsageLine '' 51),
  192:         (New-UsageLine '' 51)
  193:     )
  194:     $e1Path = Join-Path $subagents 'agent-E1.jsonl'
  195:     Write-Lines $e1Path $e1Lines
  196:     Write-Lines (Join-Path $subagents 'agent-E1.meta.json') @((New-MetaJson @{ agentType='executor'; description='fixture executor'; toolUseId='toolu_01FixtureEXEC'; parentAgentId='O1'; spawnDepth=3; model='opus' }))
  197:     (Get-Item $e1Path).LastWriteTime = (Get-Date).AddDays(-40)
  198: 
  199:     # --- U1 and U2, utility agents spawned by the SESSION itself. They have no parent agent, so
  200:     # they resolve through the session's spawn context at their own tool_use id.
  201:     $u1Lines = @( (New-UsageLine '' 61) )
  202:     Write-Lines (Join-Path $subagents 'agent-U1.jsonl') $u1Lines
  203:     Write-Lines (Join-Path $subagents 'agent-U1.meta.json') @((New-MetaJson @{ agentType='general-purpose'; description='fixture utility one'; toolUseId='toolu_01FixtureUTILONE'; spawnDepth=1; model='sonnet' }))
  204: 
  205:     $u2Lines = @( (New-UsageLine '' 71) )
  206:     Write-Lines (Join-Path $subagents 'agent-U2.jsonl') $u2Lines
  207:     Write-Lines (Join-Path $subagents 'agent-U2.meta.json') @((New-MetaJson @{ agentType='general-purpose'; description='fixture utility two'; toolUseId='toolu_01FixtureUTILTWO'; spawnDepth=1; model='sonnet' }))
  208: 
  209:     # --- W1, one level DEEPER in the subagents tree: subagents\workflows\wf_1\. Most real agent
  210:     # transcripts live at this depth, so a flat direct-child scan must not satisfy the suite.
  211:     # Branch-less, so it resolves only through the tree, W1 -> C1.
  212:     $w1Lines = @(
  213:         (New-UsageLine '' 101),
  214:         (New-UsageLine '' 101)
  215:     )
  216:     $wfDir = Join-Path $subagents 'workflows\wf_1'
  217:     Write-Lines (Join-Path $wfDir 'agent-W1.jsonl') $w1Lines
  218:     Write-Lines (Join-Path $wfDir 'agent-W1.meta.json') @((New-MetaJson @{ agentType='reviewer-runner'; description='fixture nested runner'; toolUseId='toolu_01FixtureRUNNER'; parentAgentId='C1'; spawnDepth=2; model='sonnet' }))
  219: 
  220:     # --- M1, the ambiguity case: its own records name TWO items, so its branchless lines must
  221:     # stay unattributed rather than inherit C1's item.
  222:     #
  223:     # The stamp line between them is the second door: the stamp regex matches the escaped form,
  224:     # so an agent transcript that merely QUOTES a stamp would let the branchless lines below it
  225:     # be guessed as AI4DEV-902. The stamp fallback belongs to session files only.
  226:     $m1BranchA   = @( (New-UsageLine 'nirdrang/ai4dev-901-mixed' 81) )
  227:     $m1BranchB   = @( (New-UsageLine 'nirdrang/ai4dev-902-mixed' 83) )
  228:     $m1Stamp     = @( (New-StampLine $ITEM_B) )
  229:     $m1Branchless= @( (New-UsageLine '' 85), (New-UsageLine '' 85) )
  230:     Write-Lines (Join-Path $subagents 'agent-M1.jsonl') ($m1BranchA + $m1BranchB + $m1Stamp + $m1Branchless)
  231:     Write-Lines (Join-Path $subagents 'agent-M1.meta.json') @((New-MetaJson @{ agentType='mechanical'; description='fixture mechanical'; toolUseId='toolu_01FixtureMECH'; parentAgentId='C1'; spawnDepth=2; model='haiku' }))
  232: 
  233:     # --- X1, the metaless agent: no role, no edge, unattributed BY DESIGN.
  234:     $x1Lines = @(
  235:         (New-UsageLine '' 91),
  236:         (New-UsageLine '' 91)
  237:     )
  238:     Write-Lines (Join-Path $subagents 'agent-X1.jsonl') $x1Lines
  239: 
  240:     # --- a background task INSIDE the scanned projects root. Transcript-shaped, and it must
  241:     # never reach a row.
  242:     $bgLines = @(
  243:         (New-UsageLine '' 999),
  244:         (New-UsageLine '' 999),
  245:         (New-UsageLine '' 999)
  246:     )
  247:     Write-Lines (Join-Path $tasksDir 'bg.output') $bgLines
  248: 
  249:     # --- the chain cache /work writes: ITEM_A hangs under ROOT_A; ITEM_B stays chainless.
  250:     Write-Lines (Join-Path $attrDir ('chain-' + $ITEM_A + '.json')) @('{"item":"' + $ITEM_A + '","chain":[{"id":"' + $ROOT_A + '"},{"id":"' + $ITEM_A + '"}]}')
  251: 
  252:     # --- the kimi store, keyed by the BARE agent id O1 (the report must strip the agent- prefix
  253:     # from the transcript file name before joining). Shape copied from the real store: the
  254:     # usage.record lines carry usage at the top level.
  255:     $kimiWire = @(
