476: $totOut  = ($rows | Measure-Object OutputTok -Sum).Sum
477: $totResp = ($rows | Measure-Object Responses -Sum).Sum
478: $unatt   = ($rows | Where-Object { $_.Item -eq 'unattributed' } | Measure-Object OutputTok -Sum).Sum
479: if (-not $totOut) { $totOut = 0 }
480: if (-not $unatt) { $unatt = 0 }
481: $pct = if ($totOut -gt 0) { [math]::Round(100.0 * $unatt / $totOut, 1) } else { 0 }
