331: $totOut  = ($rows | Measure-Object OutputTok -Sum).Sum
332: $totResp = ($rows | Measure-Object Responses -Sum).Sum
333: $unatt   = ($rows | Where-Object { $_.Item -eq 'unattributed' } | Measure-Object OutputTok -Sum).Sum
334: if (-not $totOut) { $totOut = 0 }
335: if (-not $unatt) { $unatt = 0 }
336: $pct = if ($totOut -gt 0) { [math]::Round(100.0 * $unatt / $totOut, 1) } else { 0 }
