39: # One assistant response with provider-echoed usage, carrying its own record branch.
40: function New-UsageLine([string]$branch, [int]$outTok) {
41:     return '{"type":"assistant","gitBranch":"' + $branch + '","message":{"usage":{"input_tokens":5,"output_tokens":' + $outTok + ',"cache_read_input_tokens":1000,"cache_creation_input_tokens":10}}}'
42: }
