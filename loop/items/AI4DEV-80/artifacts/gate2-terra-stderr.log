501: $vRows = @()
502: foreach ($k in $vendor.Keys) {
503:     if ($ItemFilter -and $k -ne $ItemFilter) { continue }
504:     $vRows += [pscustomobject]@{ Item=$k; Runs=$vendor[$k].runs; InputTok=$vendor[$k].inTok; OutputTok=$vendor[$k].outTok; CachedIn=$vendor[$k].cached }
505: }
506: $vRows = @($vRows | Sort-Object OutputTok -Descending)
507: 
508: $kRows = @()
509: foreach ($k in $kimi.Keys) {
510:     if ($ItemFilter -and $k -ne $ItemFilter) { continue }
511:     $kRows += [pscustomobject]@{ Item=$k; Sessions=$kimi[$k].sessions; InputTok=$kimi[$k].inTok; OutputTok=$kimi[$k].outTok; CacheRead=$kimi[$k].cached }
512: }
513: $kRows = @($kRows | Sort-Object OutputTok -Descending)
514: 
515: # -Json emits the aggregates instead of the tables, so a test asserts on numbers rather than on
516: # Format-Table whitespace. Windows PowerShell 5.1 needs an explicit -Depth.
517: if ($Json) {
518:     $out = [pscustomobject]@{
519:         rows      = @($rows)
520:         roleRows  = $roleRows
521:         rollRows  = @($rollRows)
522:         codexRows = $vRows
523:         kimiRows  = $kRows
524:         totals    = [pscustomobject]@{
525:             responses             = $totResp
526:             outputTok             = $totOut
527:             unattributedOutputTok = $unatt
528:             unattributedPct       = $pct
529:             transcriptFiles       = $sessions
530:             skippedFiles          = $skipped
531:             item                  = $ItemFilter
532:             days                  = $Days
533:         }
534:     }
535:     $out | ConvertTo-Json -Depth 6
536:     exit 0
