70: # The same counting predicate the report uses, applied to the fixture's own lines.
71: function Measure-Lines([string[]]$lines) {
72:     $n = 0
73:     $o = [long]0
74:     foreach ($l in $lines) {
75:         if ($l.IndexOf('"usage"') -lt 0) { continue }
76:         if ($l.IndexOf('"output_tokens"') -lt 0) { continue }
77:         $j = $null
78:         try { $j = $l | ConvertFrom-Json } catch { continue }
79:         if ($j.type -ne 'assistant') { continue }
80:         $u = $null
81:         if ($j.message -and $j.message.usage) { $u = $j.message.usage }
82:         elseif ($j.usage) { $u = $j.usage }
83:         if (-not $u) { continue }
84:         $n = $n + 1
85:         $o = $o + [long]$u.output_tokens
86:     }
87:     return [pscustomobject]@{ Responses = $n; OutputTok = $o }
88: }
89: function Measure-File([string]$path) { return (Measure-Lines ([System.IO.File]::ReadAllLines($path))) }
