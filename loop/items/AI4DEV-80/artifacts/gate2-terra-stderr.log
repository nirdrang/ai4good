363: # ---- per item
364: $rows = @()
365: foreach ($k in $agg.Keys) {
366:     $item, $src = $k -split '\|'
367:     $a = $agg[$k]
368:     $rows += [pscustomobject]@{ Item=$item; From=$src; Responses=$a.responses; OutputTok=$a.outTok; InputTok=$a.inTok; CacheRead=$a.cacheRead; CacheWrite=$a.cacheWrite }
369: }
370: $rows = $rows | Sort-Object -Property @{e='OutputTok';Descending=$true}
371: 
372: # ---- rolled up the chain: every ancestor carries its descendants' cost, and the item carries its own
373: $roll = @{}
374: function Add-Roll([string]$node, $r, [hashtable]$roll) {
375:     if (-not $roll.ContainsKey($node)) { $roll[$node] = @{ responses = 0; outTok = [long]0; items = @() } }
376:     $roll[$node].responses += $r.Responses
377:     $roll[$node].outTok    += $r.OutputTok
378:     if ($roll[$node].items -notcontains $r.Item) { $roll[$node].items += $r.Item }
379: }
380: foreach ($r in $rows) {
381:     if ($r.Item -notmatch '^AI4(DEV|PM)-[0-9]+$') { continue }
382:     if ($chains.ContainsKey($r.Item)) { foreach ($n in $chains[$r.Item]) { Add-Roll $n $r $roll } }
383:     else { Add-Roll '(chain not cached)' $r $roll; Add-Roll $r.Item $r $roll }
384: }
385: $rollRows = @()
386: foreach ($k in $roll.Keys) {
387:     $rollRows += [pscustomobject]@{ Node=$k; Covers=$roll[$k].items.Count; Responses=$roll[$k].responses; OutputTok=$roll[$k].outTok }
388: }
389: $rollRows = $rollRows | Sort-Object -Property @{e='OutputTok';Descending=$true}
