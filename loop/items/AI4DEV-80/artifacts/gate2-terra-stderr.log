458:             if (-not $kimi.ContainsKey($item)) { $kimi[$item] = @{ sessions = 0; inTok = [long]0; outTok = [long]0; cached = [long]0 } }
459:             $kimi[$item].sessions++
460:             foreach ($l in [System.IO.File]::ReadLines($wire.FullName)) {
