279: $agg = @{}   # key "item|source" -> counters
280: $roleAgg = @{}  # key "item|role" -> counters
281: $agentItem = @{}  # agent id (the task file's base name) -> the item it worked on
282: function Add-Usage([string]$key, $usage, [hashtable]$agg) {
283:     if (-not $agg.ContainsKey($key)) {
284:         $agg[$key] = @{ responses = 0; inTok = [long]0; outTok = [long]0; cacheRead = [long]0; cacheWrite = [long]0 }
285:     }
286:     $a = $agg[$key]
287:     $a.responses++
288:     if ($usage.input_tokens)                { $a.inTok      += [long]$usage.input_tokens }
289:     if ($usage.output_tokens)               { $a.outTok     += [long]$usage.output_tokens }
290:     if ($usage.cache_read_input_tokens)     { $a.cacheRead  += [long]$usage.cache_read_input_tokens }
291:     if ($usage.cache_creation_input_tokens) { $a.cacheWrite += [long]$usage.cache_creation_input_tokens }
292: }
