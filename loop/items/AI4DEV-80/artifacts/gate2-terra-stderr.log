246: # ---- vendor spend (codex), joined by the session id the reviewer printed into its own log
247: #
248: # Every codex run writes a header containing `session id: <uuid>`, and we COMMIT those logs into
249: # loop/items/<ITEM>/ - so the ids live in the repository and survive the artifact sweep. Codex
250: # stores each run as sessions/<y>/<m>/<d>/rollout-<timestamp>-<uuid>.jsonl carrying real token
251: # counts. Joining the two attributes reviewer spend to the item whose folder holds the log:
252: # derived from what the tool emitted and what the item recorded, declared by nobody.
253: #
254: # KIMI IS INCLUDED, and an earlier version of this file claimed it could not be. That claim was
255: # FALSE and was written after a search that used `-SimpleMatch` with a pattern containing `|`,
256: # so it looked for the literal pipes instead of the alternatives and found nothing. The founder
257: # pointed at the real location. Kimi keeps
258: # ~/.kimi-code/sessions/wd_agent-<agentId>_*/session_*/agents/*/wire.jsonl, whose usage records
259: # read {inputOther, output, inputCacheRead, inputCacheCreation} and are PER TURN - so they are
260: # summed, unlike codex's cumulative total. The directory name embeds the id of the agent that
261: # launched it, and that agent's own transcript gives the item, so the join needs nothing declared.
262: $vendor = @{}
263: $itemsDir = Join-Path (Split-Path -Parent (Split-Path -Parent $PSScriptRoot)) 'loop\items'
264: $sessRe = [regex]'session id:\s*([0-9a-fA-F-]{36})'
265: $rollouts = @{}
266: $codexSessions = Join-Path $env:USERPROFILE '.codex\sessions'
267: if (Test-Path $codexSessions) {
268:     foreach ($rf in (Get-ChildItem $codexSessions -Recurse -File -Filter 'rollout-*.jsonl' -ErrorAction SilentlyContinue)) {
269:         $mm = [regex]::Match($rf.Name, '([0-9a-fA-F-]{36})\.jsonl$')
270:         if ($mm.Success) { $rollouts[$mm.Groups[1].Value.ToLower()] = $rf.FullName }
271:     }
272: }
273: if (Test-Path $itemsDir) {
274:     foreach ($dir in (Get-ChildItem $itemsDir -Directory -ErrorAction SilentlyContinue)) {
275:         $item = $dir.Name
276:         # -Recurse: since 2026-08-09 reviewer logs land in loop/items/<ITEM>/artifacts/, one level down
277:         foreach ($log in (Get-ChildItem $dir.FullName -File -Filter '*stderr*' -Recurse -ErrorAction SilentlyContinue)) {
278:             foreach ($sm in $sessRe.Matches([System.IO.File]::ReadAllText($log.FullName))) {
279:                 $sid = $sm.Groups[1].Value.ToLower()
280:                 if (-not $rollouts.ContainsKey($sid)) { continue }
281:                 if (-not $vendor.ContainsKey($item)) { $vendor[$item] = @{ runs = 0; inTok = [long]0; outTok = [long]0; cached = [long]0 } }
282:                 $v = $vendor[$item]; $v.runs++
283:                 foreach ($l in [System.IO.File]::ReadLines($rollouts[$sid])) {
284:                     if ($l.IndexOf('"output_tokens"') -lt 0) { continue }
285:                     try {
286:                         $o = $l | ConvertFrom-Json
287:                         $tu = $null
288:                         if ($o.payload -and $o.payload.info -and $o.payload.info.total_token_usage) { $tu = $o.payload.info.total_token_usage }
289:                         elseif ($o.info -and $o.info.total_token_usage) { $tu = $o.info.total_token_usage }
290:                         if ($tu) {
291:                             # total_token_usage is CUMULATIVE for the session, so the last one wins
292:                             # rather than being summed - adding them would multiply the real cost.
293:                             $v.inTok = [long]$tu.input_tokens; $v.outTok = [long]$tu.output_tokens
294:                             if ($tu.cached_input_tokens) { $v.cached = [long]$tu.cached_input_tokens }
295:                         }
296:                     } catch { }
297:                 }
298:             }
299:         }
300:     }
301: }
302: 
303: $kimi = @{}
304: $kimiRoot = Join-Path $env:USERPROFILE '.kimi-code\sessions'
305: if (Test-Path $kimiRoot) {
306:     foreach ($wd in (Get-ChildItem $kimiRoot -Directory -ErrorAction SilentlyContinue)) {
307:         $am = [regex]::Match($wd.Name, 'wd_agent-([A-Za-z0-9]+)_')
308:         if (-not $am.Success) { continue }
309:         $agentId = $am.Groups[1].Value
310:         if (-not $agentItem.ContainsKey($agentId)) { continue }
311:         $item = $agentItem[$agentId]
312:         foreach ($wire in (Get-ChildItem $wd.FullName -Recurse -File -Filter 'wire.jsonl' -ErrorAction SilentlyContinue)) {
313:             if (-not $kimi.ContainsKey($item)) { $kimi[$item] = @{ sessions = 0; inTok = [long]0; outTok = [long]0; cached = [long]0 } }
314:             $kimi[$item].sessions++
315:             foreach ($l in [System.IO.File]::ReadLines($wire.FullName)) {
316:                 if ($l.IndexOf('"usage"') -lt 0) { continue }
317:                 try {
318:                     $o = $l | ConvertFrom-Json
319:                     $u2 = $o.usage
320:                     if ($u2) {
321:                         if ($u2.inputOther)         { $kimi[$item].inTok  += [long]$u2.inputOther }
322:                         if ($u2.output)             { $kimi[$item].outTok += [long]$u2.output }
323:                         if ($u2.inputCacheRead)     { $kimi[$item].cached += [long]$u2.inputCacheRead }
324:                     }
325:                 } catch { }
326:             }
327:         }
328:     }
329: }
