391: # ---- vendor spend (codex), joined by the session id the reviewer printed into its own log
392: #
393: # Every codex run writes a header containing `session id: <uuid>`, and we COMMIT those logs into
394: # loop/items/<ITEM>/ - so the ids live in the repository and survive the artifact sweep. Codex
395: # stores each run as sessions/<y>/<m>/<d>/rollout-<timestamp>-<uuid>.jsonl carrying real token
396: # counts. Joining the two attributes reviewer spend to the item whose folder holds the log:
397: # derived from what the tool emitted and what the item recorded, declared by nobody.
398: #
399: # KIMI IS INCLUDED, and an earlier version of this file claimed it could not be. That claim was
400: # FALSE and was written after a search that used `-SimpleMatch` with a pattern containing `|`,
401: # so it looked for the literal pipes instead of the alternatives and found nothing. The founder
402: # pointed at the real location. Kimi keeps
403: # ~/.kimi-code/sessions/wd_agent-<agentId>_*/session_*/agents/*/wire.jsonl, whose usage records
404: # read {inputOther, output, inputCacheRead, inputCacheCreation} and are PER TURN - so they are
405: # summed, unlike codex's cumulative total. The directory name embeds the id of the agent that
406: # launched it, and that agent's own transcript gives the item, so the join needs nothing declared.
407: $vendor = @{}
408: $itemsDir = $ItemsDir
409: $sessRe = [regex]'session id:\s*([0-9a-fA-F-]{36})'
410: $rollouts = @{}
411: $codexSessions = $CodexSessions
412: if (Test-Path $codexSessions) {
413:     foreach ($rf in (Get-ChildItem $codexSessions -Recurse -File -Filter 'rollout-*.jsonl' -ErrorAction SilentlyContinue)) {
414:         $mm = [regex]::Match($rf.Name, '([0-9a-fA-F-]{36})\.jsonl$')
415:         if ($mm.Success) { $rollouts[$mm.Groups[1].Value.ToLower()] = $rf.FullName }
416:     }
417: }
418: if (Test-Path $itemsDir) {
419:     foreach ($dir in (Get-ChildItem $itemsDir -Directory -ErrorAction SilentlyContinue)) {
420:         $item = $dir.Name
421:         # -Recurse: since 2026-08-09 reviewer logs land in loop/items/<ITEM>/artifacts/, one level down
422:         foreach ($log in (Get-ChildItem $dir.FullName -File -Filter '*stderr*' -Recurse -ErrorAction SilentlyContinue)) {
423:             foreach ($sm in $sessRe.Matches([System.IO.File]::ReadAllText($log.FullName))) {
424:                 $sid = $sm.Groups[1].Value.ToLower()
425:                 if (-not $rollouts.ContainsKey($sid)) { continue }
426:                 if (-not $vendor.ContainsKey($item)) { $vendor[$item] = @{ runs = 0; inTok = [long]0; outTok = [long]0; cached = [long]0 } }
427:                 $v = $vendor[$item]; $v.runs++
428:                 foreach ($l in [System.IO.File]::ReadLines($rollouts[$sid])) {
429:                     if ($l.IndexOf('"output_tokens"') -lt 0) { continue }
430:                     try {
431:                         $o = $l | ConvertFrom-Json
432:                         $tu = $null
433:                         if ($o.payload -and $o.payload.info -and $o.payload.info.total_token_usage) { $tu = $o.payload.info.total_token_usage }
434:                         elseif ($o.info -and $o.info.total_token_usage) { $tu = $o.info.total_token_usage }
435:                         if ($tu) {
436:                             # total_token_usage is CUMULATIVE for the session, so the last one wins
437:                             # rather than being summed - adding them would multiply the real cost.
438:                             $v.inTok = [long]$tu.input_tokens; $v.outTok = [long]$tu.output_tokens
439:                             if ($tu.cached_input_tokens) { $v.cached = [long]$tu.cached_input_tokens }
440:                         }
441:                     } catch { }
442:                 }
443:             }
444:         }
445:     }
446: }
