294: $sessions = 0
295: $skipped = 0
296: $unmarkedAgents = 0
297: foreach ($f in $files) {
298:     $curBranch = ''          # derived, primary
299:     $curStamp = ''           # declared, fallback only
300:     # Which kind of transcript this is comes from the platform's own naming, declared by nobody:
301:     # an agent transcript is `agent-<agentId>.jsonl` at any depth, and a session file is named by
302:     # its session id. A session was spawned by nobody and is the coordinator.
303:     $base = [System.IO.Path]::GetFileNameWithoutExtension($f.Name)
304:     $isAgent = $f.Name.StartsWith('agent-')
305:     $joinKey = $base
306:     $curRole = 'coordinator'
307:     $curTree = ''
308:     if ($isAgent) {
309:         $joinKey = $base -replace '^agent-', ''
310:         if ($metaOf.ContainsKey($joinKey) -and $metaOf[$joinKey].agentType) { $curRole = $metaOf[$joinKey].agentType }
311:         else { $curRole = 'unmarked agent'; $unmarkedAgents++ }
312:         $curTree = [string](Get-TreeItem $joinKey (New-Object 'System.Collections.Hashtable'))
313:     }
314:     # Shared read: a transcript belonging to a RUNNING agent or background task is locked, and a
315:     # report that dies on a live file can never be run while anything is working - which is
316:     # exactly when it is most worth running.
317:     try {
318:         $fs = New-Object System.IO.FileStream($f.FullName, [System.IO.FileMode]::Open, [System.IO.FileAccess]::Read, ([System.IO.FileShare]::ReadWrite -bor [System.IO.FileShare]::Delete))
319:         $reader = New-Object System.IO.StreamReader($fs)
320:     }
321:     catch { $skipped++; continue }
322:     $sessions++
323:     try {
324:         while ($null -ne ($line = $reader.ReadLine())) {
325:             if ($line.IndexOf('"gitBranch"') -ge 0) {
326:                 $bm = $branchRe.Match($line)
327:                 if ($bm.Success) { $curBranch = $bm.Groups[1].Value }
328:             }
329:             if ($line.IndexOf('ai4good-attribution') -ge 0) { $curStamp = Get-StampValue $line $curStamp }
330:             if ($line.IndexOf('"usage"') -ge 0 -and $line.IndexOf('"output_tokens"') -ge 0) {
331:                 try {
332:                     $o = $line | ConvertFrom-Json
333:                     $u = $null
334:                     if ($o.message -and $o.message.usage) { $u = $o.message.usage }
335:                     elseif ($o.usage) { $u = $o.usage }
336:                     if ($u -and $o.type -eq 'assistant') {
337:                         # Own record branch first, exactly as before. The tree is a FALLBACK for a
338:                         # record that resolves nothing on its own - it never overrides a branch.
339:                         $ids = @(Get-BranchItems $curBranch)
340:                         if ($ids.Count -eq 1)      { Add-Usage ($ids[0] + '|branch')  $u $agg }
341:                         elseif ($ids.Count -gt 1)  { Add-Usage ('unresolved|branch')  $u $agg }
342:                         elseif ($curTree)          { Add-Usage ($curTree + '|tree')   $u $agg }
343:                         elseif ($curStamp)         { Add-Usage ($curStamp + '|stamp') $u $agg }
344:                         else                       { Add-Usage ('unattributed|none')  $u $agg }
345:                         # A tree-resolved response feeds the role table and the vendor join key
346:                         # exactly as a branch-resolved one does.
347:                         if ($ids.Count -eq 1) {
348:                             Add-Usage ($ids[0] + '|' + $curRole) $u $roleAgg
349:                             $agentItem[$joinKey] = $ids[0]
350:                         }
351:                         elseif ($ids.Count -eq 0 -and $curTree) {
352:                             Add-Usage ($curTree + '|' + $curRole) $u $roleAgg
353:                             $agentItem[$joinKey] = $curTree
354:                         }
355:                     }
356:                 } catch { }
357:             }
358:         }
359:     }
360:     finally { $reader.Dispose() }
361: }
