44: # The stamp as it really lands in a JSONL record: the quotes arrive escaped.
45: function New-StampLine([string]$item) {
46:     return '{"type":"user","gitBranch":"main","message":{"content":"WORKING ON <ai4good-attribution pm=\"none\" dev=\"' + $item + '\"/> fixture stamp"}}'
47: }
48: 
49: # A spawn call in the parent session. It carries the tool_use id the child meta names.
50: function New-SpawnLine([string]$toolUseId, [string]$agentType) {
51:     return '{"type":"assistant","gitBranch":"main","message":{"content":[{"type":"tool_use","id":"' + $toolUseId + '","name":"Task","input":{"subagent_type":"' + $agentType + '"}}]}}'
52: }
53: 
54: # A tool result that QUOTES another transcript. Its gitBranch is escaped, so it is not a branch
55: # fact - the decoy of G1-10.
56: function New-DecoyLine([string]$decoyBranch) {
57:     return '{"type":"user","gitBranch":"","message":{"content":"tool result: {\"type\":\"assistant\",\"gitBranch\":\"' + $decoyBranch + '\"}"}}'
