152: # One stamp rule, used by both passes below, so they can never disagree.
153: function Get-StampValue([string]$line, [string]$current) {
154:     $m = $stampNew.Match($line)
155:     if ($m.Success -and ($m.Value -notmatch '[{}]')) {
156:         $d = $m.Groups[2].Value
157:         if ($d -and $d -ne 'none' -and $d -ne '-') { return $d }
158:         return ''
159:     }
160:     $m = $stampOld.Match($line)
161:     if ($m.Success -and ($m.Value -notmatch '[{}]')) {
162:         $b = $m.Groups[3].Value
163:         if ($b) { return ('legacy:' + $b) }
164:         return ''
165:     }
166:     return $current
167: }
