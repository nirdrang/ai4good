 succeeded in 635ms:
1: # attribution-report.ps1 - the buildout's token-denominated burn report (attribution dogfood, AI4DEV-14).
2: # Read-only over this machine's Claude Code transcripts for THIS project. Correlates each
3: # response's PROVIDER-ECHOED token usage with the item that response was working on, and rolls
4: # that up the attribution chain (REQ-034's model: token-denominated, honest buckets, totals that
5: # reconcile).
6: #   powershell -File loop/work/attribution-report.ps1                    -> all sessions
7: #   powershell -File loop/work/attribution-report.ps1 -Days 1            -> touched in the last day
8: #   powershell -File loop/work/attribution-report.ps1 -Item AI4DEV-79    -> one item only
9: #   powershell -File loop/work/attribution-report.ps1 -Json              -> aggregates as JSON
10: #
11: # The five root parameters exist so the selftest can point the report at a synthetic store. They
12: # default to this machine's real roots, so a default invocation is unchanged.
13: param(
14:     [int]$Days = 0,
15:     [string]$Item = '',
16:     [switch]$Json,
17:     [string]$ProjectsDir   = (Join-Path $env:USERPROFILE '.claude\projects\C--Users-nirdr-Downloads-ai4good'),
18:     [string]$AttrDir       = (Join-Path $env:LOCALAPPDATA 'ai4good-build\nirdrang-ai4good\attr'),
19:     [string]$ItemsDir      = (Join-Path (Split-Path -Parent (Split-Path -Parent $PSScriptRoot)) 'loop\items'),
20:     [string]$CodexSessions = (Join-Path $env:USERPROFILE '.codex\sessions'),
21:     [string]$KimiRoot      = (Join-Path $env:USERPROFILE '.kimi-code\sessions')
22: )
23: $ErrorActionPreference = 'Stop'
24: 
25: # ---------------------------------------------------------------------------------------------
26: # WHY ATTRIBUTION COMES FROM THE BRANCH, NOT FROM THE STAMP (founder, 2026-08-07).
27: #
28: # The stamp is a UserPromptSubmit hook, so it NEVER fires in a subagent thread - and the subagents
29: # are where the work happens. On AI4DEV-48 the item ran as five orchestrator sittings, an executor,
30: # distillers and a mechanical, and this report saw NINE responses for it, because it only read
31: # main-session transcripts and only looked for a stamp.
32: #
33: # Every transcript record - main session and agent alike - carries `gitBranch`. The branch names
34: # exactly one item, and it is trustworthy for the same reason the stamp trusts it: the branch is
35: # COUPLED TO CLOSURE, since its pull request closes that item. A wrong branch surfaces as a wrong
36: # closure on the board rather than as a quiet error in a ledger nobody reads.
37: #
38: # An earlier design recorded an agent-to-item map at spawn time. The founder killed it: the agents
39: # form a TREE (the coordinator spawns a conductor, which spawns sittings, which spawn executors),
40: # so a map captures one edge of many - and a declared fact that drifts is the failure class this
41: # project exists to delete. The branch is on every record, at any nesting depth, declared by nobody.
42: #
43: # THE TREE IS NOW USED AS A FALLBACK, and it is still derived (founder, 2026-08-11). The platform
44: # writes the whole spawn forest to disk at spawn time - parent edge, spawn call and role - so the
45: # report reads the edges rather than declaring them. A record that names its own item branch is
46: # never overridden. Only a record that resolves NOTHING on its own asks the tree, and it inherits
47: # the item of its nearest ancestor that resolves one.
48: #
49: # WHAT THIS UNDERCOUNTS, stated rather than hidden:
50: #   - work whose whole ancestry sits on `main`, on a generated `worktree-agent-*` branch, or on a
51: #     branch naming no item: the tree has nothing to inherit, so it stays unattributed,
52: #   - the reviewers only partly: the codex and kimi joins below are real, but they cover the runs
53: #     whose logs this repository holds, so an item's true cost is higher than any figure here,
54: #   - a branch naming two items, which resolves to unresolved rather than guessing,
55: #   - an agent file naming two items, whose branchless records stay unattributed for the same
56: #     reason.
57: # So every number below is a FLOOR, not a total.
58: # ---------------------------------------------------------------------------------------------
59: 
60: $projDir = $ProjectsDir
61: if (-not (Test-Path $projDir)) { throw ('transcript directory not found: ' + $projDir) }
62: $files = @(Get-ChildItem $projDir -Filter '*.jsonl' -File)
63: 
64: # AGENT TRANSCRIPTS ARE `.jsonl` FILES BESIDE THEIR SESSION, and the glob above is not recursive,
65: # so this report never read one. They live under <projDir>\<sessionId>\subagents\.
66: #
67: # THE `subagents` TREE IS NOT FLAT, measured 2026-08-11: 290 of 877 agent transcripts sit directly
68: # in `subagents`, and the other 587 sit one level deeper in `subagents\workflows\wf_<id>\`, each
69: # with its meta file beside it. A flat glob would therefore leave two thirds of them invisible, so
70: # the search recurses. It still names `agent-*.jsonl` only, so a `tasks\*.output` file inside the
71: # same root is never counted.
72: #
73: # Usage is counted from `.jsonl` transcripts ONLY. The Temp `.output` store this report used to
74: # scan is gone from the scan for two measured reasons: 33 of its 34 transcript-shaped files are
75: # byte-identical twins of a `subagents` file, so scanning both double-counts every
76: # background-spawned agent; and the 34th is not an agent at all but a background task whose 50
77: # assistant-usage lines were counted as unattributed responses. Nothing is lost - zero orphan
78: # transcripts were found there.
79: foreach ($d in (Get-ChildItem $projDir -Directory -ErrorAction SilentlyContinue)) {
80:     $sub = Join-Path $d.FullName 'subagents'
81:     if (Test-Path $sub) { $files += @(Get-ChildItem $sub -Filter 'agent-*.jsonl' -File -Recurse -ErrorAction SilentlyContinue) }
82: }
83: if ($Days -gt 0) { $files = @($files | Where-Object { $_.LastWriteTime -gt (Get-Date).AddDays(-$Days) }) }
84: 
85: # -Item normalisation: accept AI4DEV-79, ai4dev-79, or a bare 79, and turn it into the canonical id.
86: $ItemFilter = ''
87: if ($Item) {
88:     $im = [regex]::Match($Item, '(?i)(?:AI4(DEV|PM)-)?0*([0-9]{1,7})')
89:     if (-not $im.Success) { throw ('unrecognised -Item value: ' + $Item) }
90:     $prefix = if ($im.Groups[1].Value) { $im.Groups[1].Value.ToUpperInvariant() } else { 'DEV' }
91:     $ItemFilter = 'AI4' + $prefix + '-' + [string][int]$im.Groups[2].Value
92: }
93: 
94: # ---------------------------------------------------------------------------------------------
95: # THE SPAWN FOREST IS ALREADY ON DISK. The platform writes agent-<agentId>.meta.json beside every
96: # agent transcript - 872 of 872 measured, none missing. Each one carries `agentType` (the spawn
97: # call's subagent_type), `parentAgentId` (absent at spawn depth 1, where the parent is the session
98: # whose directory holds the file), `toolUseId` (the spawn call inside the parent) and `spawnDepth`.
99: #
100: # So the role comes from the spawn call, and the parent edge comes from the spawn call. An earlier
101: # version paired a `subagent_type` line with an `agentId:` line by their shared tool_use id and
102: # read the role from the file name; the meta file states both directly, at any nesting depth.
103: # A transcript with no meta file reads role `unmarked agent`, builds no edge, and is counted in
104: # the floor note - never silently.
105: #
106: # THE META FILES ARE ALWAYS ALL READ, whatever -Days says: they are tiny, and an edge must exist
107: # even when the parent's transcript falls outside the window.
108: $metaOf = @{}
109: foreach ($d in (Get-ChildItem $projDir -Directory -ErrorAction SilentlyContinue)) {
110:     $sub = Join-Path $d.FullName 'subagents'
111:     if (-not (Test-Path $sub)) { continue }
112:     foreach ($mf in (Get-ChildItem $sub -Filter 'agent-*.meta.json' -File -Recurse -ErrorAction SilentlyContinue)) {
113:         $id = $mf.Name -replace '^agent-', '' -replace '\.meta\.json$', ''
114:         try {
115:             $mj = Get-Content $mf.FullName -Raw | ConvertFrom-Json
116:             $metaOf[$id] = @{
117:                 agentType     = [string]$mj.agentType
118:                 parentAgentId = [string]$mj.parentAgentId
119:                 toolUseId     = [string]$mj.toolUseId
120:             }
121:         } catch { }
122:     }
123: }
124: 
125: # The tag is still read as a FALLBACK for old sessions whose branches predate the id convention.
126: # Quotes arrive escaped (\") because a transcript is JSONL; the original pattern was written
127: # against the tag as it renders on screen and therefore matched nothing from the day it was
128: # written. Matches containing braces are refused - a transcript that READ this hook's source
129: # contains the tag's own format template, and it attributed real tokens to buckets named {0}.
130: $stampNew = [regex]'<ai4good-attribution pm=\\?"([^"\\]*)\\?" dev=\\?"([^"\\]*)\\?"/>'
131: $stampOld = [regex]'<ai4good-attribution wave=\\?"([^"\\]*)\\?" project=\\?"([^"\\]*)\\?" bucket=\\?"([^"\\]*)\\?"/>'
132: $branchRe = [regex]'"gitBranch":"([^"]*)"'
133: # Same tokeniser the stamp uses: strict boundaries, zero-padding normalised, ALL matches collected
134: # so a branch naming two items is unresolved rather than "take the first".
135: # CASE-INSENSITIVE, and that is not a detail: Linear's branch names are lower-case
136: # (`nirdrang/ai4dev-48-...`), so a case-sensitive pattern matches NOTHING and every response
137: # silently falls back to the stamp - which is the same shape of failure this file already carries
138: # two scars from. Verified against a real branch before being believed.
139: $idRe = New-Object System.Text.RegularExpressions.Regex(
140:     '(?<![A-Za-z0-9])AI4(DEV|PM)-0*([0-9]{1,7})(?![A-Za-z0-9])',
141:     ([System.Text.RegularExpressions.RegexOptions]::IgnoreCase -bor [System.Text.RegularExpressions.RegexOptions]::CultureInvariant))
142: 
143: function Get-BranchItems([string]$branch) {
144:     $ids = @()
145:     foreach ($m in $idRe.Matches($branch)) {
146:         $id = 'AI4' + $m.Groups[1].Value.ToUpperInvariant() + '-' + [string][int]$m.Groups[2].Value
147:         if ($ids -notcontains $id) { $ids += $id }
148:     }
149:     return $ids
150: }
