450: if (Test-Path $kimiRoot) {
451:     foreach ($wd in (Get-ChildItem $kimiRoot -Directory -ErrorAction SilentlyContinue)) {
452:         $am = [regex]::Match($wd.Name, 'wd_agent-([A-Za-z0-9]+)_')
