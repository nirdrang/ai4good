236: # TREE-ITEM(agent), in the ruled order:
237: #   (a) the single distinct item the agent's own records name;
238: #   (b) ONLY when (a) finds ZERO items, the parent agent's tree item, walking parentAgentId
239: #       upward. A file naming TWO items is ambiguous and inherits NOTHING - degrade, never guess;
240: #   (c) at a session root, the item the session had resolved at this agent's own spawn call.
241: #
242: # THERE IS NO DEPTH CAP. The VISITED SET is the only guard and must stay: a cap would truncate a
243: # valid deep chain, while a parentAgentId cycle would recurse for ever without the set.
244: $treeItem = @{}
245: function Get-TreeItem([string]$agentId, [hashtable]$visited) {
246:     if ($treeItem.ContainsKey($agentId)) { return $treeItem[$agentId] }
247:     if ($visited.ContainsKey($agentId)) { return '' }
248:     $visited[$agentId] = $true
249:     $result = ''
250:     $own = @()
251:     if ($fileItems.ContainsKey($agentId)) { $own = @($fileItems[$agentId]) }
252:     if ($own.Count -eq 1) { $result = $own[0] }
253:     elseif ($own.Count -eq 0 -and $metaOf.ContainsKey($agentId)) {
254:         $meta = $metaOf[$agentId]
255:         if ($meta.parentAgentId) { $result = [string](Get-TreeItem $meta.parentAgentId $visited) }
256:         elseif ($meta.toolUseId -and $spawnCtx.ContainsKey($meta.toolUseId)) { $result = $spawnCtx[$meta.toolUseId] }
257:     }
258:     $treeItem[$agentId] = $result
259:     return $result
260: }
