169: # ---------------------------------------------------------------------------------------------
170: # PROPAGATION DOWN THE SPAWN TREE (the ruled design, founder 2026-08-11).
171: #
172: # Most agent records name the item branch themselves, and those need nothing. The rest are the
173: # records an agent wrote before its worktree branch existed, or on `main`, or on a generated
174: # `worktree-agent-*` branch. Today they all fall to unattributed. They belong to whatever item
175: # their nearest ancestor was working on, and the spawn forest says who that ancestor is.
176: #
177: # This pre-pass collects the two facts the walk needs:
178: #   - for each agent transcript, the distinct items its OWN records name;
179: #   - for each session, the item it had resolved at each spawn call, keyed by the tool_use id
180: #     that the child's meta file names. State at the CALL, not at the end of the file: one
181: #     session holds different items at different times, and each child inherits what was held
182: #     when it was spawned.
183: #
184: # Both reads use the SAME unescaped-only branch match as the counting pass. An escaped
185: # \"gitBranch\" inside a quoted tool result is another transcript being read, never a branch fact.
186: $fileItems = @{}   # bare agent id -> the distinct items its own records name
187: $spawnCtx  = @{}   # tool_use id -> the item the spawning session had resolved at that call
188: $tuIdRe = [regex]'"(?:id|tool_use_id)"\s*:\s*"(toolu_[A-Za-z0-9]+)"'
189: foreach ($f in $files) {
190:     try {
191:         $fs = New-Object System.IO.FileStream($f.FullName, [System.IO.FileMode]::Open, [System.IO.FileAccess]::Read, ([System.IO.FileShare]::ReadWrite -bor [System.IO.FileShare]::Delete))
192:         $rd = New-Object System.IO.StreamReader($fs)
193:     } catch { continue }
194:     try {
195:         if ($f.Name.StartsWith('agent-')) {
196:             $aid = [System.IO.Path]::GetFileNameWithoutExtension($f.Name) -replace '^agent-', ''
197:             $own = @()
198:             while ($null -ne ($line = $rd.ReadLine())) {
199:                 if ($line.IndexOf('"gitBranch"') -lt 0) { continue }
200:                 $bm = $branchRe.Match($line)
201:                 if (-not $bm.Success) { continue }
202:                 foreach ($id in (Get-BranchItems $bm.Groups[1].Value)) { if ($own -notcontains $id) { $own += $id } }
203:             }
204:             $fileItems[$aid] = $own
205:         }
206:         else {
207:             $cb = ''
208:             $cs = ''
209:             while ($null -ne ($line = $rd.ReadLine())) {
210:                 if ($line.IndexOf('"gitBranch"') -ge 0) {
211:                     $bm = $branchRe.Match($line)
212:                     if ($bm.Success) { $cb = $bm.Groups[1].Value }
213:                 }
214:                 if ($line.IndexOf('ai4good-attribution') -ge 0) { $cs = Get-StampValue $line $cs }
215:                 if ($line.IndexOf('toolu_') -lt 0) { continue }
216:                 foreach ($m in $tuIdRe.Matches($line)) {
217:                     $tid = $m.Groups[1].Value
218:                     # FIRST sighting wins: the spawn call comes before its own tool result.
219:                     if ($spawnCtx.ContainsKey($tid)) { continue }
220:                     $bids = @(Get-BranchItems $cb)

