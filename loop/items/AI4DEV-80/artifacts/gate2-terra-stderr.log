 succeeded in 628ms:
220:                     $bids = @(Get-BranchItems $cb)
221:                     if ($bids.Count -eq 1) { $spawnCtx[$tid] = $bids[0] }
222:                     elseif ($bids.Count -eq 0 -and $cs) {
