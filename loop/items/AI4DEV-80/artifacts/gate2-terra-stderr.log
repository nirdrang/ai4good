33: function Write-Lines([string]$path, [string[]]$lines) {
34:     $dir = Split-Path -Parent $path
35:     if (-not (Test-Path $dir)) { New-Item -ItemType Directory -Path $dir -Force | Out-Null }
36:     [System.IO.File]::WriteAllLines($path, $lines)
