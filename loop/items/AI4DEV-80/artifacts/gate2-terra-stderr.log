262: # ---- the chains, from the cache /work writes (never a Linear call from a report)
263: $chains = @{}
264: $attrDir = $AttrDir
265: foreach ($f in (Get-ChildItem $attrDir -Filter 'chain-*.json' -File -ErrorAction SilentlyContinue)) {
266:     try {
267:         $j = Get-Content $f.FullName -Raw | ConvertFrom-Json
268:         $item = [string]$j.item
269:         $nodes = @($j.chain | ForEach-Object { [string]$_.id })
270:         # Duplicates exist (the same item resolved in two worktrees). Keep the LONGEST chain: a
271:         # shorter one is a walk that stopped early, and claiming a nearer root than the real one
272:         # is the confident-wrong answer this design forbids.
273:         if ($item -and $nodes.Count -gt 0) {
274:             if (-not $chains.ContainsKey($item) -or $nodes.Count -gt $chains[$item].Count) { $chains[$item] = $nodes }
275:         }
276:     } catch { }
277: }
