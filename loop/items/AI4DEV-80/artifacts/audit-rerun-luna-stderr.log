  348:     # Shared read: a transcript belonging to a RUNNING agent or background task is locked, and a
  349:     # report that dies on a live file can never be run while anything is working - which is
  350:     # exactly when it is most worth running.
  351:     try {
  352:         $fs = New-Object System.IO.FileStream($f.FullName, [System.IO.FileMode]::Open, [System.IO.FileAccess]::Read, ([System.IO.FileShare]::ReadWrite -bor [System.IO.FileShare]::Delete))
