  409: # ---- per item
  410: $rows = @()
  411: foreach ($k in $agg.Keys) {
  412:     $item, $src = $k -split '\|'
  413:     $a = $agg[$k]
  414:     $rows += [pscustomobject]@{ Item=$item; From=$src; Responses=$a.responses; OutputTok=$a.outTok; InputTok=$a.inTok; CacheRead=$a.cacheRead; CacheWrite=$a.cacheWrite }
  415: }
  416: $rows = $rows | Sort-Object -Property @{e='OutputTok';Descending=$true}
