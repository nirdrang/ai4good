  418: # ---- rolled up the chain: every ancestor carries its descendants' cost, and the item carries its own
  419: $roll = @{}
  420: function Add-Roll([string]$node, $r, [hashtable]$roll) {
  421:     if (-not $roll.ContainsKey($node)) { $roll[$node] = @{ responses = 0; outTok = [long]0; items = @() } }
  422:     $roll[$node].responses += $r.Responses
  423:     $roll[$node].outTok    += $r.OutputTok
  424:     if ($roll[$node].items -notcontains $r.Item) { $roll[$node].items += $r.Item }
  425: }
  426: foreach ($r in $rows) {
  427:     if ($r.Item -notmatch '^AI4(DEV|PM)-[0-9]+$') { continue }
  428:     if ($chains.ContainsKey($r.Item)) { foreach ($n in $chains[$r.Item]) { Add-Roll $n $r $roll } }
  429:     else { Add-Roll '(chain not cached)' $r $roll; Add-Roll $r.Item $r $roll }
  430: }
  431: $rollRows = @()
  432: foreach ($k in $roll.Keys) {
  433:     $rollRows += [pscustomobject]@{ Node=$k; Covers=$roll[$k].items.Count; Responses=$roll[$k].responses; OutputTok=$roll[$k].outTok }
  434: }
  435: $rollRows = $rollRows | Sort-Object -Property @{e='OutputTok';Descending=$true}
