--- REPORT CURRENT (NUMBERED) ---
    1: # attribution-report.ps1 - the buildout's token-denominated burn report (attribution dogfood, AI4DEV-14).
    2: # Read-only over this machine's Claude Code transcripts for THIS project. Correlates each
    3: # response's PROVIDER-ECHOED token usage with the item that response was working on, and rolls
    4: # that up the attribution chain (REQ-034's model: token-denominated, honest buckets, totals that
    5: # reconcile).
    6: #   powershell -File loop/work/attribution-report.ps1                    -> all sessions
    7: #   powershell -File loop/work/attribution-report.ps1 -Days 1            -> touched in the last day
    8: #   powershell -File loop/work/attribution-report.ps1 -Item AI4DEV-79    -> one item only
    9: #   powershell -File loop/work/attribution-report.ps1 -Json              -> aggregates as JSON
   10: #
   11: # The five root parameters exist so the selftest can point the report at a synthetic store. They
   12: # default to this machine's real roots, so a default invocation is unchanged.
   13: param(
   14:     [int]$Days = 0,
   15:     [string]$Item = '',
   16:     [switch]$Json,
   17:     [string]$ProjectsDir   = (Join-Path $env:USERPROFILE '.claude\projects\C--Users-nirdr-Downloads-ai4good'),
   18:     [string]$AttrDir       = (Join-Path $env:LOCALAPPDATA 'ai4good-build\nirdrang-ai4good\attr'),
   19:     [string]$ItemsDir      = (Join-Path (Split-Path -Parent (Split-Path -Parent $PSScriptRoot)) 'loop\items'),
   20:     [string]$CodexSessions = (Join-Path $env:USERPROFILE '.codex\sessions'),
   21:     [string]$KimiRoot      = (Join-Path $env:USERPROFILE '.kimi-code\sessions')
   22: )
   23: $ErrorActionPreference = 'Stop'
   24: 
   25: # ---------------------------------------------------------------------------------------------
   26: # WHY ATTRIBUTION COMES FROM THE BRANCH, NOT FROM THE STAMP (founder, 2026-08-07).
   27: #
   28: # The stamp is a UserPromptSubmit hook, so it NEVER fires in a subagent thread - and the subagents
   29: # are where the work happens. On AI4DEV-48 the item ran as five orchestrator sittings, an executor,
   30: # distillers and a mechanical, and this report saw NINE responses for it, because it only read
   31: # main-session transcripts and only looked for a stamp.
   32: #
   33: # Every transcript record - main session and agent alike - carries `gitBranch`. The branch names
   34: # exactly one item, and it is trustworthy for the same reason the stamp trusts it: the branch is
   35: # COUPLED TO CLOSURE, since its pull request closes that item. A wrong branch surfaces as a wrong
   36: # closure on the board rather than as a quiet error in a ledger nobody reads.
   37: #
   38: # An earlier design recorded an agent-to-item map at spawn time. The founder killed it: the agents
   39: # form a TREE (the coordinator spawns a conductor, which spawns sittings, which spawn executors),
   40: # so a map captures one edge of many - and a declared fact that drifts is the failure class this
   41: # project exists to delete. The branch is on every record, at any nesting depth, declared by nobody.
   42: #
   43: # THE TREE IS NOW USED AS A FALLBACK, and it is still derived (founder, 2026-08-11). The platform
   44: # writes the whole spawn forest to disk at spawn time - parent edge, spawn call and role - so the
   45: # report reads the edges rather than declaring them. A record that names its own item branch is
   46: # never overridden. Only a record that resolves NOTHING on its own asks the tree, and it inherits
   47: # the item of its nearest ancestor that resolves one.
   48: #
   49: # WHAT THIS UNDERCOUNTS, stated rather than hidden:
   50: #   - work whose whole ancestry sits on `main`, on a generated `worktree-agent-*` branch, or on a
   51: #     branch naming no item: the tree has nothing to inherit, so it stays unattributed,
   52: #   - the reviewers only partly: the codex and kimi joins below are real, but they cover the runs
   53: #     whose logs this repository holds, so an item's true cost is higher than any figure here,
   54: #   - a branch naming two items, which resolves to unresolved rather than guessing,
   55: #   - an agent file naming two items, whose branchless records stay unattributed for the same
   56: #     reason.
   57: # So every number below is a FLOOR, not a total.
   58: # ---------------------------------------------------------------------------------------------
   59: 
   60: $projDir = $ProjectsDir
   61: if (-not (Test-Path $projDir)) { throw ('transcript directory not found: ' + $projDir) }
   62: $files = @(Get-ChildItem $projDir -Filter '*.jsonl' -File)
   63: 
   64: # AGENT TRANSCRIPTS ARE `.jsonl` FILES BESIDE THEIR SESSION, and the glob above is not recursive,
   65: # so this report never read one. They live under <projDir>\<sessionId>\subagents\.
   66: #
   67: # THE `subagents` TREE IS NOT FLAT, measured 2026-08-11: 290 of 877 agent transcripts sit directly
   68: # in `subagents`, and the other 587 sit one level deeper in `subagents\workflows\wf_<id>\`, each
   69: # with its meta file beside it. A flat glob would therefore leave two thirds of them invisible, so
   70: # the search recurses. It still names `agent-*.jsonl` only, so a `tasks\*.output` file inside the
   71: # same root is never counted.
   72: #
   73: # Usage is counted from `.jsonl` transcripts ONLY. The Temp `.output` store this report used to
   74: # scan is gone from the scan for two measured reasons: 33 of its 34 transcript-shaped files are
   75: # byte-identical twins of a `subagents` file, so scanning both double-counts every
   76: # background-spawned agent; and the 34th is not an agent at all but a background task whose 50
   77: # assistant-usage lines were counted as unattributed responses. Nothing is lost - zero orphan
   78: # transcripts were found there.
   79: foreach ($d in (Get-ChildItem $projDir -Directory -ErrorAction SilentlyContinue)) {
   80:     $sub = Join-Path $d.FullName 'subagents'
   81:     if (Test-Path $sub) { $files += @(Get-ChildItem $sub -Filter 'agent-*.jsonl' -File -Recurse -ErrorAction SilentlyContinue) }
   82: }
   83: if ($Days -gt 0) { $files = @($files | Where-Object { $_.LastWriteTime -gt (Get-Date).AddDays(-$Days) }) }
   84: 
   85: # -Item normalisation: accept AI4DEV-79, ai4dev-79, or a bare 79, and turn it into the canonical id.
   86: $ItemFilter = ''
   87: if ($Item) {
   88:     $im = [regex]::Match($Item, '(?i)(?:AI4(DEV|PM)-)?0*([0-9]{1,7})')
   89:     if (-not $im.Success) { throw ('unrecognised -Item value: ' + $Item) }
   90:     $prefix = if ($im.Groups[1].Value) { $im.Groups[1].Value.ToUpperInvariant() } else { 'DEV' }
   91:     $ItemFilter = 'AI4' + $prefix + '-' + [string][int]$im.Groups[2].Value
   92: }
   93: 
   94: # ---------------------------------------------------------------------------------------------
   95: # THE SPAWN FOREST IS ALREADY ON DISK. The platform writes agent-<agentId>.meta.json beside every
   96: # agent transcript - 872 of 872 measured, none missing. Each one carries `agentType` (the spawn
   97: # call's subagent_type), `parentAgentId` (absent at spawn depth 1, where the parent is the session
   98: # whose directory holds the file), `toolUseId` (the spawn call inside the parent) and `spawnDepth`.
   99: #
  100: # So the role comes from the spawn call, and the parent edge comes from the spawn call. An earlier
  101: # version paired a `subagent_type` line with an `agentId:` line by their shared tool_use id and
  102: # read the role from the file name; the meta file states both directly, at any nesting depth.
  103: # A transcript with no meta file reads role `unmarked agent`, builds no edge, and is counted in
  104: # the floor note - never silently.
  105: #
  106: # THE META FILES ARE ALWAYS ALL READ, whatever -Days says: they are tiny, and an edge must exist
  107: # even when the parent's transcript falls outside the window.
  108: $metaOf = @{}
  109: foreach ($d in (Get-ChildItem $projDir -Directory -ErrorAction SilentlyContinue)) {
  110:     $sub = Join-Path $d.FullName 'subagents'
  111:     if (-not (Test-Path $sub)) { continue }
  112:     foreach ($mf in (Get-ChildItem $sub -Filter 'agent-*.meta.json' -File -Recurse -ErrorAction SilentlyContinue)) {
  113:         $id = $mf.Name -replace '^agent-', '' -replace '\.meta\.json$', ''
  114:         try {
  115:             $mj = Get-Content $mf.FullName -Raw | ConvertFrom-Json
  116:             $metaOf[$id] = @{
  117:                 agentType     = [string]$mj.agentType
  118:                 parentAgentId = [string]$mj.parentAgentId
  119:                 toolUseId     = [string]$mj.toolUseId
  120:                 # The agent's session, DERIVED from where the file sits, never declared: an agent
  121:                 # transcript lives under <projDir>\<sessionId>\subagents\. The spawn-context key
  122:                 # needs it (see the pre-pass below).
  123:                 session       = $d.Name
  124:             }
  125:         } catch { }
  126:     }
  127: }
  128: 
  129: # The tag is still read as a FALLBACK for old sessions whose branches predate the id convention.
  130: # Quotes arrive escaped (\") because a transcript is JSONL; the original pattern was written
  131: # against the tag as it renders on screen and therefore matched nothing from the day it was
  132: # written. Matches containing braces are refused - a transcript that READ this hook's source
  133: # contains the tag's own format template, and it attributed real tokens to buckets named {0}.
  134: $stampNew = [regex]'<ai4good-attribution pm=\\?"([^"\\]*)\\?" dev=\\?"([^"\\]*)\\?"/>'
  135: $stampOld = [regex]'<ai4good-attribution wave=\\?"([^"\\]*)\\?" project=\\?"([^"\\]*)\\?" bucket=\\?"([^"\\]*)\\?"/>'
  136: $branchRe = [regex]'"gitBranch":"([^"]*)"'
  137: # Same tokeniser the stamp uses: strict boundaries, zero-padding normalised, ALL matches collected
  138: # so a branch naming two items is unresolved rather than "take the first".
  139: # CASE-INSENSITIVE, and that is not a detail: Linear's branch names are lower-case
  140: # (`nirdrang/ai4dev-48-...`), so a case-sensitive pattern matches NOTHING and every response
  141: # silently falls back to the stamp - which is the same shape of failure this file already carries
  142: # two scars from. Verified against a real branch before being believed.
  143: $idRe = New-Object System.Text.RegularExpressions.Regex(
  144:     '(?<![A-Za-z0-9])AI4(DEV|PM)-0*([0-9]{1,7})(?![A-Za-z0-9])',
  145:     ([System.Text.RegularExpressions.RegexOptions]::IgnoreCase -bor [System.Text.RegularExpressions.RegexOptions]::CultureInvariant))
  146: 
  147: function Get-BranchItems([string]$branch) {
  148:     $ids = @()
  149:     foreach ($m in $idRe.Matches($branch)) {
  150:         $id = 'AI4' + $m.Groups[1].Value.ToUpperInvariant() + '-' + [string][int]$m.Groups[2].Value
  151:         if ($ids -notcontains $id) { $ids += $id }
  152:     }
  153:     return $ids
  154: }
  155: 
  156: # One stamp rule, used by both passes below, so they can never disagree.
  157: function Get-StampValue([string]$line, [string]$current) {
  158:     $m = $stampNew.Match($line)
  159:     if ($m.Success -and ($m.Value -notmatch '[{}]')) {
  160:         $d = $m.Groups[2].Value
  161:         if ($d -and $d -ne 'none' -and $d -ne '-') { return $d }
  162:         return ''
  163:     }
  164:     $m = $stampOld.Match($line)
  165:     if ($m.Success -and ($m.Value -notmatch '[{}]')) {
  166:         $b = $m.Groups[3].Value
  167:         if ($b) { return ('legacy:' + $b) }
  168:         return ''
  169:     }
  170:     return $current
  171: }
  172: 
  173: # ---------------------------------------------------------------------------------------------
  174: # PROPAGATION DOWN THE SPAWN TREE (the ruled design, founder 2026-08-11).
  175: #
  176: # Most agent records name the item branch themselves, and those need nothing. The rest are the
  177: # records an agent wrote before its worktree branch existed, or on `main`, or on a generated
  178: # `worktree-agent-*` branch. Today they all fall to unattributed. They belong to whatever item
  179: # their nearest ancestor was working on, and the spawn forest says who that ancestor is.
  180: #
  181: # This pre-pass collects the two facts the walk needs:
  182: #   - for each agent transcript, the distinct items its OWN records name;
  183: #   - for each session, the item it had resolved at each spawn call, keyed by the SESSION plus
  184: #     the tool_use id that the child's meta file names. State at the CALL, not at the end of the
  185: #     file: one session holds different items at different times, and each child inherits what
  186: #     was held when it was spawned.
  187: #
  188: # THE KEY CARRIES THE SESSION, and that is measured rather than assumed. A tool_use id alone was
  189: # not unique on this store: 580 ids appear in two session files, all of them in ONE pair, because
  190: # a resumed session writes a copy of the earlier session's records. The ids are not reused - the
  191: # records are copied. Five of those 580 resolve a DIFFERENT item in the two files, so a global key
  192: # lets whichever file is scanned first answer for the other. The session is derived from the file
  193: # for a session transcript and from the directory path for an agent, so nothing is declared.
  194: # (Measured 2026-08-11: loop/items/AI4DEV-80/artifacts/g2-3-probe.txt.)
  195: #
  196: # Both reads use the SAME unescaped-only branch match as the counting pass. An escaped
  197: # \"gitBranch\" inside a quoted tool result is another transcript being read, never a branch fact.
  198: $fileItems = @{}   # bare agent id -> the distinct items its own records name
  199: $spawnCtx  = @{}   # "<sessionId>|<tool_use id>" -> the item that session had resolved at that call
  200: $tuIdRe = [regex]'"(?:id|tool_use_id)"\s*:\s*"(toolu_[A-Za-z0-9]+)"'
  201: foreach ($f in $files) {
  202:     try {
  203:         $fs = New-Object System.IO.FileStream($f.FullName, [System.IO.FileMode]::Open, [System.IO.FileAccess]::Read, ([System.IO.FileShare]::ReadWrite -bor [System.IO.FileShare]::Delete))
  204:         $rd = New-Object System.IO.StreamReader($fs)
  205:     } catch { continue }
  206:     try {
  207:         if ($f.Name.StartsWith('agent-')) {
  208:             $aid = [System.IO.Path]::GetFileNameWithoutExtension($f.Name) -replace '^agent-', ''
  209:             $own = @()
  210:             while ($null -ne ($line = $rd.ReadLine())) {
  211:                 if ($line.IndexOf('"gitBranch"') -lt 0) { continue }
  212:                 $bm = $branchRe.Match($line)
  213:                 if (-not $bm.Success) { continue }
  214:                 foreach ($id in (Get-BranchItems $bm.Groups[1].Value)) { if ($own -notcontains $id) { $own += $id } }
  215:             }
  216:             $fileItems[$aid] = $own
  217:         }
  218:         else {
  219:             $cb = ''
  220:             $cs = ''
  221:             # A session file IS its session: the file's base name is the session id, and the
  222:             # agent directory beside it carries the same name (7 of 7 measured).
  223:             $sessId = [System.IO.Path]::GetFileNameWithoutExtension($f.Name)
  224:             while ($null -ne ($line = $rd.ReadLine())) {
  225:                 if ($line.IndexOf('"gitBranch"') -ge 0) {
  226:                     $bm = $branchRe.Match($line)
  227:                     if ($bm.Success) { $cb = $bm.Groups[1].Value }
  228:                 }
  229:                 if ($line.IndexOf('ai4good-attribution') -ge 0) { $cs = Get-StampValue $line $cs }
  230:                 if ($line.IndexOf('toolu_') -lt 0) { continue }
  231:                 foreach ($m in $tuIdRe.Matches($line)) {
  232:                     $tid = $sessId + '|' + $m.Groups[1].Value
  233:                     # FIRST sighting wins WITHIN THE SESSION: the spawn call comes before its own
  234:                     # tool result. Another session's copy of the same id is a different key.
  235:                     #
  236:                     # THE FIRST SIGHTING PINS THE KEY EVEN WHEN IT RESOLVES NOTHING, and the
  237:                     # empty string is a real answer. Storing a key only for a sighting that
  238:                     # RESOLVES an item would leave a spawn call made before the session held any
  239:                     # item unrecorded - and the next occurrence of that id, the tool result, is
  240:                     # written after the session has resolved one. The child would then inherit
  241:                     # the state at its tool result rather than the state at its spawn call. An
  242:                     # empty stored value reads as unattributed in Get-TreeItem, which is the
  243:                     # honest answer: nothing was held when this child was spawned.
  244:                     if ($spawnCtx.ContainsKey($tid)) { continue }
  245:                     $val = ''
  246:                     $bids = @(Get-BranchItems $cb)
  247:                     if ($bids.Count -eq 1) { $val = $bids[0] }
  248:                     elseif ($bids.Count -eq 0 -and $cs) {
  249:                         $sids = @(Get-BranchItems $cs)
  250:                         if ($sids.Count -eq 1) { $val = $sids[0] }
  251:                     }
  252:                     $spawnCtx[$tid] = $val
  253:                 }
  254:             }
  255:         }
  256:     }
  257:     finally { $rd.Dispose() }
  258: }
  259: 
  260: $ambiguousAgents = 0
  261: foreach ($k in $fileItems.Keys) { if (@($fileItems[$k]).Count -gt 1) { $ambiguousAgents++ } }
  262: 
  263: # TREE-ITEM(agent), in the ruled order:
  264: #   (a) the single distinct item the agent's own records name;
  265: #   (b) ONLY when (a) finds ZERO items, the parent agent's tree item, walking parentAgentId
  266: #       upward. A file naming TWO items is ambiguous and inherits NOTHING - degrade, never guess;
  267: #   (c) at a session root, the item the session had resolved at this agent's own spawn call.
  268: #
  269: # THERE IS NO DEPTH CAP. The VISITED SET is the only guard and must stay: a cap would truncate a
  270: # valid deep chain, while a parentAgentId cycle would recurse for ever without the set.
  271: $treeItem = @{}
  272: function Get-TreeItem([string]$agentId, [hashtable]$visited) {
  273:     if ($treeItem.ContainsKey($agentId)) { return $treeItem[$agentId] }
  274:     if ($visited.ContainsKey($agentId)) { return '' }
  275:     $visited[$agentId] = $true
  276:     $result = ''
  277:     $own = @()
  278:     if ($fileItems.ContainsKey($agentId)) { $own = @($fileItems[$agentId]) }
  279:     if ($own.Count -eq 1) { $result = $own[0] }
  280:     elseif ($own.Count -eq 0 -and $metaOf.ContainsKey($agentId)) {
  281:         $meta = $metaOf[$agentId]
  282:         if ($meta.parentAgentId) { $result = [string](Get-TreeItem $meta.parentAgentId $visited) }
  283:         elseif ($meta.toolUseId -and $meta.session) {
  284:             $ctxKey = [string]$meta.session + '|' + [string]$meta.toolUseId
  285:             if ($spawnCtx.ContainsKey($ctxKey)) { $result = $spawnCtx[$ctxKey] }
  286:         }
  287:     }
  288:     $treeItem[$agentId] = $result
  289:     return $result
  290: }
  291: 
  292: # ---- the chains, from the cache /work writes (never a Linear call from a report)
  293: $chains = @{}
  294: $attrDir = $AttrDir
  295: foreach ($f in (Get-ChildItem $attrDir -Filter 'chain-*.json' -File -ErrorAction SilentlyContinue)) {
  296:     try {
  297:         $j = Get-Content $f.FullName -Raw | ConvertFrom-Json
  298:         $item = [string]$j.item
  299:         $nodes = @($j.chain | ForEach-Object { [string]$_.id })
  300:         # Duplicates exist (the same item resolved in two worktrees). Keep the LONGEST chain: a
  301:         # shorter one is a walk that stopped early, and claiming a nearer root than the real one
  302:         # is the confident-wrong answer this design forbids.
  303:         if ($item -and $nodes.Count -gt 0) {
  304:             if (-not $chains.ContainsKey($item) -or $nodes.Count -gt $chains[$item].Count) { $chains[$item] = $nodes }
  305:         }
  306:     } catch { }
  307: }
  308: 
  309: $agg = @{}   # key "item|source" -> counters
  310: $roleAgg = @{}  # key "item|role" -> counters
  311: $agentItem = @{}  # agent id (the task file's base name) -> the item it worked on
  312: function Add-Usage([string]$key, $usage, [hashtable]$agg) {
  313:     if (-not $agg.ContainsKey($key)) {
  314:         $agg[$key] = @{ responses = 0; inTok = [long]0; outTok = [long]0; cacheRead = [long]0; cacheWrite = [long]0 }
  315:     }
  316:     $a = $agg[$key]
  317:     $a.responses++
  318:     if ($usage.input_tokens)                { $a.inTok      += [long]$usage.input_tokens }
  319:     if ($usage.output_tokens)               { $a.outTok     += [long]$usage.output_tokens }
  320:     if ($usage.cache_read_input_tokens)     { $a.cacheRead  += [long]$usage.cache_read_input_tokens }
  321:     if ($usage.cache_creation_input_tokens) { $a.cacheWrite += [long]$usage.cache_creation_input_tokens }
  322: }
  323: 
  324: $sessions = 0
  325: $skipped = 0
  326: $unmarkedAgents = 0
  327: foreach ($f in $files) {
  328:     $curBranch = ''          # derived, primary
  329:     $curStamp = ''           # declared, fallback only
  330:     # Which kind of transcript this is comes from the platform's own naming, declared by nobody:
  331:     # an agent transcript is `agent-<agentId>.jsonl` at any depth, and a session file is named by
  332:     # its session id. A session was spawned by nobody and is the coordinator.
  333:     $base = [System.IO.Path]::GetFileNameWithoutExtension($f.Name)
  334:     $isAgent = $f.Name.StartsWith('agent-')
  335:     $joinKey = $base
  336:     $curRole = 'coordinator'
  337:     $curTree = ''
  338:     $curAmbiguous = $false
  339:     if ($isAgent) {
  340:         $joinKey = $base -replace '^agent-', ''
  341:         if ($metaOf.ContainsKey($joinKey) -and $metaOf[$joinKey].agentType) { $curRole = $metaOf[$joinKey].agentType }
  342:         else { $curRole = 'unmarked agent'; $unmarkedAgents++ }
  343:         $curTree = [string](Get-TreeItem $joinKey (New-Object 'System.Collections.Hashtable'))
  344:         # An agent whose own records name TWO OR MORE items is ambiguous. Per-record attribution
  345:         # to two items is a fact; per-AGENT vendor spend credited wholly to one of them is a guess.
  346:         if ($fileItems.ContainsKey($joinKey) -and @($fileItems[$joinKey]).Count -gt 1) { $curAmbiguous = $true }
  347:     }
  348:     # Shared read: a transcript belonging to a RUNNING agent or background task is locked, and a
  349:     # report that dies on a live file can never be run while anything is working - which is
  350:     # exactly when it is most worth running.
  351:     try {
  352:         $fs = New-Object System.IO.FileStream($f.FullName, [System.IO.FileMode]::Open, [System.IO.FileAccess]::Read, ([System.IO.FileShare]::ReadWrite -bor [System.IO.FileShare]::Delete))
  353:         $reader = New-Object System.IO.StreamReader($fs)
  354:     }
  355:     catch { $skipped++; continue }
  356:     $sessions++
  357:     try {
  358:         while ($null -ne ($line = $reader.ReadLine())) {
  359:             if ($line.IndexOf('"gitBranch"') -ge 0) {
  360:                 $bm = $branchRe.Match($line)
  361:                 if ($bm.Success) { $curBranch = $bm.Groups[1].Value }
  362:             }
  363:             if ($line.IndexOf('ai4good-attribution') -ge 0) { $curStamp = Get-StampValue $line $curStamp }
  364:             if ($line.IndexOf('"usage"') -ge 0 -and $line.IndexOf('"output_tokens"') -ge 0) {
  365:                 try {
  366:                     $o = $line | ConvertFrom-Json
  367:                     $u = $null
  368:                     if ($o.message -and $o.message.usage) { $u = $o.message.usage }
  369:                     elseif ($o.usage) { $u = $o.usage }
  370:                     if ($u -and $o.type -eq 'assistant') {
  371:                         # Own record branch first, exactly as before. The tree is a FALLBACK for a
  372:                         # record that resolves nothing on its own - it never overrides a branch.
  373:                         #
  374:                         # THE STAMP FALLBACK IS FOR SESSION FILES ONLY. The stamp regex matches the
  375:                         # escaped form on purpose, so an agent transcript that QUOTES a stamp - in
  376:                         # a spawn prompt or a tool result - would otherwise set $curStamp and let an
  377:                         # unresolvable agent guess an item from text it merely read. An agent
  378:                         # resolves branch, then tree, then nothing.
  379:                         $ids = @(Get-BranchItems $curBranch)
  380:                         if ($ids.Count -eq 1)                  { Add-Usage ($ids[0] + '|branch')  $u $agg }
  381:                         elseif ($ids.Count -gt 1)              { Add-Usage ('unresolved|branch')  $u $agg }
  382:                         elseif ($curTree)                      { Add-Usage ($curTree + '|tree')   $u $agg }
  383:                         elseif ($curStamp -and (-not $isAgent)) { Add-Usage ($curStamp + '|stamp') $u $agg }
  384:                         else                                   { Add-Usage ('unattributed|none')  $u $agg }
  385:                         # A tree-resolved response feeds the role table and the vendor join key
  386:                         # exactly as a branch-resolved one does.
  387:                         #
  388:                         # THE VENDOR JOIN KEY DEGRADES LIKE THE TREE WALK. An ambiguous agent gets
  389:                         # no $agentItem entry, so its kimi spend stays unjoined rather than being
  390:                         # credited whole to whichever of its items its last branch record named.
  391:                         # The tree-fed assignment below needs no such guard: an ambiguous agent
  392:                         # never has a tree item.
  393:                         if ($ids.Count -eq 1) {
  394:                             Add-Usage ($ids[0] + '|' + $curRole) $u $roleAgg
  395:                             if (-not $curAmbiguous) { $agentItem[$joinKey] = $ids[0] }
  396:                         }
  397:                         elseif ($ids.Count -eq 0 -and $curTree) {
  398:                             Add-Usage ($curTree + '|' + $curRole) $u $roleAgg
  399:                             $agentItem[$joinKey] = $curTree
  400:                         }
  401:                     }
  402:                 } catch { }
  403:             }
  404:         }
  405:     }
  406:     finally { $reader.Dispose() }
  407: }
  408: 
  409: # ---- per item
  410: $rows = @()
  411: foreach ($k in $agg.Keys) {
  412:     $item, $src = $k -split '\|'
  413:     $a = $agg[$k]
  414:     $rows += [pscustomobject]@{ Item=$item; From=$src; Responses=$a.responses; OutputTok=$a.outTok; InputTok=$a.inTok; CacheRead=$a.cacheRead; CacheWrite=$a.cacheWrite }
  415: }
  416: $rows = $rows | Sort-Object -Property @{e='OutputTok';Descending=$true}
  417: 
  418: # ---- rolled up the chain: every ancestor carries its descendants' cost, and the item carries its own
  419: $roll = @{}
  420: function Add-Roll([string]$node, $r, [hashtable]$roll) {
  421:     if (-not $roll.ContainsKey($node)) { $roll[$node] = @{ responses = 0; outTok = [long]0; items = @() } }
  422:     $roll[$node].responses += $r.Responses
  423:     $roll[$node].outTok    += $r.OutputTok
  424:     if ($roll[$node].items -notcontains $r.Item) { $roll[$node].items += $r.Item }
  425: }
  426: foreach ($r in $rows) {
  427:     if ($r.Item -notmatch '^AI4(DEV|PM)-[0-9]+$') { continue }
  428:     if ($chains.ContainsKey($r.Item)) { foreach ($n in $chains[$r.Item]) { Add-Roll $n $r $roll } }
  429:     else { Add-Roll '(chain not cached)' $r $roll; Add-Roll $r.Item $r $roll }
  430: }
  431: $rollRows = @()
  432: foreach ($k in $roll.Keys) {
  433:     $rollRows += [pscustomobject]@{ Node=$k; Covers=$roll[$k].items.Count; Responses=$roll[$k].responses; OutputTok=$roll[$k].outTok }
  434: }
  435: $rollRows = $rollRows | Sort-Object -Property @{e='OutputTok';Descending=$true}
  436: 
  437: # ---- vendor spend (codex), joined by the session id the reviewer printed into its own log
  438: #
  439: # Every codex run writes a header containing `session id: <uuid>`, and we COMMIT those logs into
  440: # loop/items/<ITEM>/ - so the ids live in the repository and survive the artifact sweep. Codex
  441: # stores each run as sessions/<y>/<m>/<d>/rollout-<timestamp>-<uuid>.jsonl carrying real token
  442: # counts. Joining the two attributes reviewer spend to the item whose folder holds the log:
  443: # derived from what the tool emitted and what the item recorded, declared by nobody.
  444: #
  445: # KIMI IS INCLUDED, and an earlier version of this file claimed it could not be. That claim was
  446: # FALSE and was written after a search that used `-SimpleMatch` with a pattern containing `|`,
  447: # so it looked for the literal pipes instead of the alternatives and found nothing. The founder
  448: # pointed at the real location. Kimi keeps
  449: # ~/.kimi-code/sessions/wd_agent-<agentId>_*/session_*/agents/*/wire.jsonl, whose usage records
  450: # read {inputOther, output, inputCacheRead, inputCacheCreation} and are PER TURN - so they are
  451: # summed, unlike codex's cumulative total. The directory name embeds the id of the agent that
  452: # launched it, and that agent's own transcript gives the item, so the join needs nothing declared.
  453: $vendor = @{}
  454: $itemsDir = $ItemsDir
  455: $sessRe = [regex]'session id:\s*([0-9a-fA-F-]{36})'
  456: $rollouts = @{}
  457: $codexSessions = $CodexSessions
  458: if (Test-Path $codexSessions) {
  459:     foreach ($rf in (Get-ChildItem $codexSessions -Recurse -File -Filter 'rollout-*.jsonl' -ErrorAction SilentlyContinue)) {
  460:         $mm = [regex]::Match($rf.Name, '([0-9a-fA-F-]{36})\.jsonl$')
  461:         if ($mm.Success) { $rollouts[$mm.Groups[1].Value.ToLower()] = $rf.FullName }
  462:     }
  463: }
  464: if (Test-Path $itemsDir) {
  465:     foreach ($dir in (Get-ChildItem $itemsDir -Directory -ErrorAction SilentlyContinue)) {
  466:         $item = $dir.Name
  467:         # -Recurse: since 2026-08-09 reviewer logs land in loop/items/<ITEM>/artifacts/, one level down
  468:         foreach ($log in (Get-ChildItem $dir.FullName -File -Filter '*stderr*' -Recurse -ErrorAction SilentlyContinue)) {
  469:             foreach ($sm in $sessRe.Matches([System.IO.File]::ReadAllText($log.FullName))) {
  470:                 $sid = $sm.Groups[1].Value.ToLower()
  471:                 if (-not $rollouts.ContainsKey($sid)) { continue }
  472:                 if (-not $vendor.ContainsKey($item)) { $vendor[$item] = @{ runs = 0; inTok = [long]0; outTok = [long]0; cached = [long]0 } }
  473:                 $v = $vendor[$item]; $v.runs++
  474:                 foreach ($l in [System.IO.File]::ReadLines($rollouts[$sid])) {
  475:                     if ($l.IndexOf('"output_tokens"') -lt 0) { continue }
  476:                     try {
  477:                         $o = $l | ConvertFrom-Json
  478:                         $tu = $null
  479:                         if ($o.payload -and $o.payload.info -and $o.payload.info.total_token_usage) { $tu = $o.payload.info.total_token_usage }
  480:                         elseif ($o.info -and $o.info.total_token_usage) { $tu = $o.info.total_token_usage }
  481:                         if ($tu) {
  482:                             # total_token_usage is CUMULATIVE for the session, so the last one wins
  483:                             # rather than being summed - adding them would multiply the real cost.
  484:                             $v.inTok = [long]$tu.input_tokens; $v.outTok = [long]$tu.output_tokens
  485:                             if ($tu.cached_input_tokens) { $v.cached = [long]$tu.cached_input_tokens }
  486:                         }
  487:                     } catch { }
  488:                 }
  489:             }
  490:         }
  491:     }
  492: }
  493: 
  494: $kimi = @{}
  495: $kimiRoot = $KimiRoot
  496: if (Test-Path $kimiRoot) {
  497:     foreach ($wd in (Get-ChildItem $kimiRoot -Directory -ErrorAction SilentlyContinue)) {
  498:         $am = [regex]::Match($wd.Name, 'wd_agent-([A-Za-z0-9]+)_')
  499:         if (-not $am.Success) { continue }
  500:         $agentId = $am.Groups[1].Value
  501:         if (-not $agentItem.ContainsKey($agentId)) { continue }
  502:         $item = $agentItem[$agentId]
  503:         foreach ($wire in (Get-ChildItem $wd.FullName -Recurse -File -Filter 'wire.jsonl' -ErrorAction SilentlyContinue)) {
  504:             if (-not $kimi.ContainsKey($item)) { $kimi[$item] = @{ sessions = 0; inTok = [long]0; outTok = [long]0; cached = [long]0 } }
  505:             $kimi[$item].sessions++
  506:             foreach ($l in [System.IO.File]::ReadLines($wire.FullName)) {
  507:                 if ($l.IndexOf('"usage"') -lt 0) { continue }
  508:                 try {
  509:                     $o = $l | ConvertFrom-Json
  510:                     $u2 = $o.usage
  511:                     if ($u2) {
  512:                         if ($u2.inputOther)         { $kimi[$item].inTok  += [long]$u2.inputOther }
  513:                         if ($u2.output)             { $kimi[$item].outTok += [long]$u2.output }
  514:                         if ($u2.inputCacheRead)     { $kimi[$item].cached += [long]$u2.inputCacheRead }
  515:                     }
  516:                 } catch { }
  517:             }
  518:         }
  519:     }
  520: }
  521: 
  522: $totOut  = ($rows | Measure-Object OutputTok -Sum).Sum
  523: $totResp = ($rows | Measure-Object Responses -Sum).Sum
  524: $unatt   = ($rows | Where-Object { $_.Item -eq 'unattributed' } | Measure-Object OutputTok -Sum).Sum
  525: if (-not $totOut) { $totOut = 0 }
  526: if (-not $unatt) { $unatt = 0 }
  527: $pct = if ($totOut -gt 0) { [math]::Round(100.0 * $unatt / $totOut, 1) } else { 0 }
  528: 
  529: # -Item scopes every section to one item (and, for the rollup, to nodes that cover it).
  530: $scopeNote = if ($ItemFilter) { ' - SCOPED to ' + $ItemFilter } else { '' }
  531: if ($ItemFilter) {
  532:     $rows     = @($rows     | Where-Object { $_.Item -eq $ItemFilter })
  533:     $rollRows = @($rollRows | Where-Object { $_.Node -eq $ItemFilter -or $chains[$ItemFilter] -contains $_.Node })
  534: }
  535: 
  536: # Every row set is built here, BEFORE any output, so the JSON oracle and the printed tables
  537: # describe exactly the same aggregates - one derivation, two renderings.
  538: $roleRows = @()
  539: foreach ($k in $roleAgg.Keys) {
  540:     $it, $rl = $k -split '\|'
  541:     if ($ItemFilter -and $it -ne $ItemFilter) { continue }
  542:     $a = $roleAgg[$k]
  543:     $roleRows += [pscustomobject]@{ Item=$it; Role=$rl; Responses=$a.responses; InputTok=$a.inTok; OutputTok=$a.outTok; CacheRead=$a.cacheRead; CacheWrite=$a.cacheWrite }
  544: }
  545: $roleRows = @($roleRows | Sort-Object Item, @{e='OutputTok';Descending=$true})
  546: 
  547: $vRows = @()
  548: foreach ($k in $vendor.Keys) {
  549:     if ($ItemFilter -and $k -ne $ItemFilter) { continue }
  550:     $vRows += [pscustomobject]@{ Item=$k; Runs=$vendor[$k].runs; InputTok=$vendor[$k].inTok; OutputTok=$vendor[$k].outTok; CachedIn=$vendor[$k].cached }
  551: }
  552: $vRows = @($vRows | Sort-Object OutputTok -Descending)
  553: 
  554: $kRows = @()
  555: foreach ($k in $kimi.Keys) {
  556:     if ($ItemFilter -and $k -ne $ItemFilter) { continue }
  557:     $kRows += [pscustomobject]@{ Item=$k; Sessions=$kimi[$k].sessions; InputTok=$kimi[$k].inTok; OutputTok=$kimi[$k].outTok; CacheRead=$kimi[$k].cached }
  558: }
  559: $kRows = @($kRows | Sort-Object OutputTok -Descending)
  560: 
  561: # -Json emits the aggregates instead of the tables, so a test asserts on numbers rather than on
  562: # Format-Table whitespace. Windows PowerShell 5.1 needs an explicit -Depth.
  563: if ($Json) {
  564:     $out = [pscustomobject]@{
  565:         rows      = @($rows)
  566:         roleRows  = $roleRows
  567:         rollRows  = @($rollRows)
  568:         codexRows = $vRows
  569:         kimiRows  = $kRows
  570:         totals    = [pscustomobject]@{
  571:             responses             = $totResp
  572:             outputTok             = $totOut
  573:             unattributedOutputTok = $unatt
  574:             unattributedPct       = $pct
  575:             transcriptFiles       = $sessions
  576:             skippedFiles          = $skipped
  577:             item                  = $ItemFilter
  578:             days                  = $Days
  579:         }
  580:     }
  581:     $out | ConvertTo-Json -Depth 6
  582:     exit 0
  583: }
  584: 
  585: Write-Output ('ai4good buildout burn report - ' + (Get-Date -Format 'yyyy-MM-dd') + ' - ' + $sessions + ' transcript file(s), sessions and agents' + $(if ($Days -gt 0) { ' (last ' + $Days + ' days)' } else { '' }) + $scopeNote)
  586: Write-Output 'units: provider-echoed tokens per response (REQ-034 model); money lives elsewhere'
  587: Write-Output 'attribution DERIVED from each record''s own git branch, and from the spawn tree where the record names none; role DERIVED from the spawn call'
  588: Write-Output ''
  589: Write-Output ('== PER ITEM ==' + $scopeNote)
  590: if ($rows.Count -eq 0) { Write-Output ('  no responses attributed to ' + $ItemFilter + ' in this window') }
  591: else { $rows | Format-Table Item, From, Responses, OutputTok, InputTok, CacheRead, CacheWrite -AutoSize | Out-String -Width 200 | Write-Output }
  592: Write-Output ('== PER ROLE WITHIN EACH ITEM (role from the spawn call, not any ROLE: text)' + $scopeNote + ' ==')
  593: if ($roleRows.Count -eq 0) { Write-Output '  no role-attributed responses in scope' }
  594: else { $roleRows | Format-Table -AutoSize | Out-String -Width 200 | Write-Output }
  595: Write-Output 'InputTok is nearly always tiny next to CacheRead: almost everything an agent reads arrives from cache, so input alone understates what was consumed by orders of magnitude.'
  596: Write-Output ''
  597: Write-Output '== REVIEWER SPEND (codex, joined by the session id in each item''s committed logs) =='
  598: if ($vendor.Count -eq 0) { Write-Output '  none joined - no committed reviewer log matched a stored codex session' }
  599: elseif ($vRows.Count -eq 0) { Write-Output '  none in scope' }
  600: else { $vRows | Format-Table -AutoSize | Out-String -Width 200 | Write-Output }
  601: Write-Output ''
  602: Write-Output '== REVIEWER SPEND (kimi, joined by the launching agent id in its session directory) =='
  603: if ($kimi.Count -eq 0) { Write-Output '  none joined - no kimi session directory named an agent this run resolved to an item' }
  604: elseif ($kRows.Count -eq 0) { Write-Output '  none in scope' }
  605: else { $kRows | Format-Table -AutoSize | Out-String -Width 200 | Write-Output }
  606: Write-Output ''
  607: Write-Output '== ROLLED UP THE CHAIN (each node includes everything beneath it) =='
  608: $rollRows | Format-Table Node, Covers, Responses, OutputTok -AutoSize | Out-String -Width 200 | Write-Output
  609: Write-Output ('TOTAL: ' + $totResp + ' responses, ' + $totOut + ' output tokens. The PER ITEM table reconciles to this total by construction; the rollup deliberately double-counts, because a parent includes its children.')
  610: Write-Output ('COORDINATOR SIGNAL - unattributed share of output tokens: ' + $pct + '%')
  611: if ($skipped -gt 0) { Write-Output ($skipped.ToString() + ' transcript file(s) could not be opened and are NOT counted - said out loud rather than silently dropped') }
  612: Write-Output ''
  613: Write-Output 'Still a FLOOR, for named reasons. A nested sitting no longer falls to unattributed: that gap is closed, because the agent transcripts are now scanned and an agent that resolves no item of its own inherits its nearest ancestor''s item. What remains:'
  614: Write-Output '  - Coordinator work on main that holds no item resolves to nothing, and neither do the agents beneath it: the tree has no item to hand down.'
  615: Write-Output ('  - ' + $ambiguousAgents + ' agent transcript(s) name TWO OR MORE items in their own records. Their branchless responses stay unattributed rather than being guessed, and their vendor spend stays unjoined for the same reason.')
  616: Write-Output ('  - ' + $unmarkedAgents + ' agent transcript(s) have no meta file beside them, so their role reads "unmarked agent" and they build no edge.')
  617: Write-Output '  - Reviewer spend is only partly joined. The codex and kimi tables above cover the runs whose logs this repository holds. The flash and opencode reviewer spend is not joined at all; that work is filed separately and is not built here.'
  618: Write-Output '  - A -Days window that excludes an ancestor transcript loses the item that ancestor would have handed down. The default, all history, has no such gap.'
--- SELFTEST CURRENT (NUMBERED) ---
    1: # attribution-report.selftest.ps1 - the executable criteria of AI4DEV-80 (attribution by spawn tree).
    2: #
    3: # It builds a SYNTHETIC transcript store in a temp directory, points attribution-report.ps1 at it
    4: # with the root override parameters, and asserts on the -Json aggregates. The oracle is numbers,
    5: # never Format-Table whitespace.
    6: #
    7: # Every expected number is COMPUTED from the bytes the fixture wrote, with the same counting
    8: # predicate the report uses. Nothing is hard-coded, so a fixture edit cannot silently make an
    9: # assert vacuous.
   10: #
   11: #   powershell -File loop/work/attribution-report.selftest.ps1
   12: #   exit 0 = every assert green; exit 1 = at least one assert red.
   13: $ErrorActionPreference = 'Stop'
   14: 
   15: $report = Join-Path $PSScriptRoot 'attribution-report.ps1'
   16: if (-not (Test-Path $report)) { throw ('report script not found: ' + $report) }
   17: 
   18: # ---------------------------------------------------------------------------------------------
   19: # assert bookkeeping
   20: # ---------------------------------------------------------------------------------------------
   21: $script:failures = 0
   22: function Assert-That([string]$id, [string]$what, [bool]$ok, [string]$detail) {
   23:     if ($ok) { Write-Output ('PASS ' + $id + ' - ' + $what) }
   24:     else {
   25:         Write-Output ('FAIL ' + $id + ' - ' + $what + ' :: ' + $detail)
   26:         $script:failures = $script:failures + 1
   27:     }
   28: }
   29: 
   30: # ---------------------------------------------------------------------------------------------
   31: # fixture writers
   32: # ---------------------------------------------------------------------------------------------
   33: function Write-Lines([string]$path, [string[]]$lines) {
   34:     $dir = Split-Path -Parent $path
   35:     if (-not (Test-Path $dir)) { New-Item -ItemType Directory -Path $dir -Force | Out-Null }
   36:     [System.IO.File]::WriteAllLines($path, $lines)
   37: }
   38: 
   39: # One assistant response with provider-echoed usage, carrying its own record branch.
   40: function New-UsageLine([string]$branch, [int]$outTok) {
   41:     return '{"type":"assistant","gitBranch":"' + $branch + '","message":{"usage":{"input_tokens":5,"output_tokens":' + $outTok + ',"cache_read_input_tokens":1000,"cache_creation_input_tokens":10}}}'
   42: }
   43: 
   44: # The stamp as it really lands in a JSONL record: the quotes arrive escaped.
   45: function New-StampLine([string]$item) {
   46:     return '{"type":"user","gitBranch":"main","message":{"content":"WORKING ON <ai4good-attribution pm=\"none\" dev=\"' + $item + '\"/> fixture stamp"}}'
   47: }
   48: 
   49: # A spawn call in the parent session. It carries the tool_use id the child meta names.
   50: function New-SpawnLine([string]$toolUseId, [string]$agentType) {
   51:     return '{"type":"assistant","gitBranch":"main","message":{"content":[{"type":"tool_use","id":"' + $toolUseId + '","name":"Task","input":{"subagent_type":"' + $agentType + '"}}]}}'
   52: }
   53: 
   54: # A spawn call in a session that has resolved NOTHING yet: the record carries no gitBranch key at
   55: # all, so no branch fact precedes it in the file.
   56: function New-SpawnLineNoBranch([string]$toolUseId, [string]$agentType) {
   57:     return '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"' + $toolUseId + '","name":"Task","input":{"subagent_type":"' + $agentType + '"}}]}}'
   58: }
   59: 
   60: # The tool RESULT of a spawn call: it names the same tool_use id a second time, and it carries the
   61: # branch the session holds when the child has already finished.
   62: function New-ToolResultLine([string]$toolUseId, [string]$branch) {
   63:     return '{"type":"user","gitBranch":"' + $branch + '","message":{"content":[{"type":"tool_result","tool_use_id":"' + $toolUseId + '","content":"fixture agent finished"}]}}'
   64: }
   65: 
   66: # A tool result that QUOTES another transcript. Its gitBranch is escaped, so it is not a branch
   67: # fact - the decoy of G1-10.
   68: function New-DecoyLine([string]$decoyBranch) {
   69:     return '{"type":"user","gitBranch":"","message":{"content":"tool result: {\"type\":\"assistant\",\"gitBranch\":\"' + $decoyBranch + '\"}"}}'
   70: }
   71: 
   72: function New-MetaJson([hashtable]$fields) {
   73:     $parts = @()
   74:     foreach ($k in $fields.Keys) {
   75:         $v = $fields[$k]
   76:         if ($v -is [int]) { $parts += ('"' + $k + '":' + $v) }
   77:         else { $parts += ('"' + $k + '":"' + $v + '"') }
   78:     }
   79:     return '{' + ($parts -join ',') + '}'
   80: }
   81: 
   82: # The same counting predicate the report uses, applied to the fixture's own lines.
   83: function Measure-Lines([string[]]$lines) {
   84:     $n = 0
   85:     $o = [long]0
   86:     foreach ($l in $lines) {
   87:         if ($l.IndexOf('"usage"') -lt 0) { continue }
   88:         if ($l.IndexOf('"output_tokens"') -lt 0) { continue }
   89:         $j = $null
   90:         try { $j = $l | ConvertFrom-Json } catch { continue }
   91:         if ($j.type -ne 'assistant') { continue }
   92:         $u = $null
   93:         if ($j.message -and $j.message.usage) { $u = $j.message.usage }
   94:         elseif ($j.usage) { $u = $j.usage }
   95:         if (-not $u) { continue }
   96:         $n = $n + 1
   97:         $o = $o + [long]$u.output_tokens
   98:     }
   99:     return [pscustomobject]@{ Responses = $n; OutputTok = $o }
  100: }
  101: function Measure-File([string]$path) { return (Measure-Lines ([System.IO.File]::ReadAllLines($path))) }
  102: 
  103: # ---------------------------------------------------------------------------------------------
  104: # aggregate lookups over the -Json oracle
  105: # ---------------------------------------------------------------------------------------------
  106: function Get-Row($j, [string]$item, [string]$from) {
  107:     $r = @($j.rows | Where-Object { $_.Item -eq $item -and $_.From -eq $from })
  108:     if ($r.Count -eq 0) { return [pscustomobject]@{ Item=$item; From=$from; Responses=0; OutputTok=[long]0; Missing=$true } }
  109:     return $r[0]
  110: }
  111: function Get-RoleRow($j, [string]$item, [string]$role) {
  112:     $r = @($j.roleRows | Where-Object { $_.Item -eq $item -and $_.Role -eq $role })
  113:     if ($r.Count -eq 0) { return [pscustomobject]@{ Item=$item; Role=$role; Responses=0; OutputTok=[long]0; Missing=$true } }
  114:     return $r[0]
  115: }
  116: function Get-RollRow($j, [string]$node) {
  117:     $r = @($j.rollRows | Where-Object { $_.Node -eq $node })
  118:     if ($r.Count -eq 0) { return [pscustomobject]@{ Node=$node; Responses=0; OutputTok=[long]0; Missing=$true } }
  119:     return $r[0]
  120: }
  121: function Sum-Of($rows, [string]$prop) {
  122:     $s = [long]0
  123:     foreach ($r in @($rows)) { $s = $s + [long]$r.$prop }
  124:     return $s
  125: }
  126: 
  127: # ---------------------------------------------------------------------------------------------
  128: # the fixture store
  129: # ---------------------------------------------------------------------------------------------
  130: $root       = Join-Path ([System.IO.Path]::GetTempPath()) ('attr-selftest-' + [guid]::NewGuid().ToString('N'))
  131: $projects   = Join-Path $root 'projects'
  132: $sessionId  = '11111111-2222-3333-4444-555555555555'
  133: $sessionFile= Join-Path $projects ($sessionId + '.jsonl')
  134: $sessionDir = Join-Path $projects $sessionId
  135: $subagents  = Join-Path $sessionDir 'subagents'
  136: $tasksDir   = Join-Path $sessionDir 'tasks'
  137: $attrDir    = Join-Path $root 'attr'
  138: $itemsDir   = Join-Path $root 'items'
  139: $codexDir   = Join-Path $root 'codex'
  140: $kimiDir    = Join-Path $root 'kimi'
  141: 
  142: $ITEM_A = 'AI4DEV-901'   # the item the coordinator holds first; chained under AI4DEV-900
  143: $ITEM_B = 'AI4DEV-902'   # the item it holds later; deliberately chainless
  144: $ROOT_A = 'AI4DEV-900'
  145: $DECOY  = 'AI4DEV-999'
  146: 
  147: try {
  148:     New-Item -ItemType Directory -Path $projects  -Force | Out-Null
  149:     New-Item -ItemType Directory -Path $subagents -Force | Out-Null
  150:     New-Item -ItemType Directory -Path $tasksDir  -Force | Out-Null
  151:     New-Item -ItemType Directory -Path $attrDir   -Force | Out-Null
  152:     New-Item -ItemType Directory -Path $itemsDir  -Force | Out-Null
  153:     New-Item -ItemType Directory -Path $codexDir  -Force | Out-Null
  154:     New-Item -ItemType Directory -Path $kimiDir   -Force | Out-Null
  155: 
  156:     # --- the coordinator session: it holds ITEM_A, spawns C1 and U1, THEN moves to ITEM_B and
  157:     # spawns U2. A latest-wins or file-wide implementation cannot satisfy both U1 and U2.
  158:     $sessionA = @(
  159:         (New-StampLine $ITEM_A),
  160:         (New-UsageLine 'main' 11),
  161:         (New-UsageLine 'main' 11)
  162:     )
  163:     $sessionSpawns = @(
  164:         (New-SpawnLine 'toolu_01FixtureCONDUCTOR' 'conductor'),
  165:         (New-SpawnLine 'toolu_01FixtureUTILONE'   'general-purpose')
  166:     )
  167:     $sessionB = @(
  168:         (New-StampLine $ITEM_B),
  169:         (New-UsageLine 'main' 13)
  170:     )
  171:     $sessionSpawnB = @( (New-SpawnLine 'toolu_01FixtureUTILTWO' 'general-purpose') )
  172:     Write-Lines $sessionFile ($sessionA + $sessionSpawns + $sessionB + $sessionSpawnB)
  173: 
  174:     # --- C1, the conductor: its OWN records name the item branch (the common case).
  175:     $c1Lines = @(
  176:         (New-UsageLine 'nirdrang/ai4dev-901-fixture' 21),
  177:         (New-UsageLine 'nirdrang/ai4dev-901-fixture' 21),
  178:         (New-UsageLine 'nirdrang/ai4dev-901-fixture' 21)
  179:     )
  180:     Write-Lines (Join-Path $subagents 'agent-C1.jsonl') $c1Lines
  181:     Write-Lines (Join-Path $subagents 'agent-C1.meta.json') @((New-MetaJson @{ agentType='conductor'; description='fixture conductor'; toolUseId='toolu_01FixtureCONDUCTOR'; spawnDepth=1; model='sonnet' }))
  182: 
  183:     # --- O1 and O2, orchestrator sittings under C1: branchless records, so they resolve only
  184:     # through the spawn tree. O1 also carries the escaped decoy.
  185:     $o1Lines = @(
  186:         (New-DecoyLine 'nirdrang/ai4dev-999-decoy'),
  187:         (New-UsageLine '' 31),
  188:         (New-UsageLine '' 31)
  189:     )
  190:     Write-Lines (Join-Path $subagents 'agent-O1.jsonl') $o1Lines
  191:     Write-Lines (Join-Path $subagents 'agent-O1.meta.json') @((New-MetaJson @{ agentType='orchestrator'; description='fixture sitting one'; toolUseId='toolu_01FixtureORCHONE'; parentAgentId='C1'; spawnDepth=2; model='opus' }))
  192: 
  193:     $o2Lines = @(
  194:         (New-UsageLine '' 41),
  195:         (New-UsageLine '' 41)
  196:     )
  197:     Write-Lines (Join-Path $subagents 'agent-O2.jsonl') $o2Lines
  198:     Write-Lines (Join-Path $subagents 'agent-O2.meta.json') @((New-MetaJson @{ agentType='orchestrator'; description='fixture sitting two'; toolUseId='toolu_01FixtureORCHTWO'; parentAgentId='C1'; spawnDepth=2; model='opus' }))
  199: 
  200:     # --- E1, the executor under O1: a TWO-level walk, E1 -> O1 -> C1. Its file is backdated for
  201:     # the -Days assert.
  202:     $e1Lines = @(
  203:         (New-UsageLine '' 51),
  204:         (New-UsageLine '' 51)
  205:     )
  206:     $e1Path = Join-Path $subagents 'agent-E1.jsonl'
  207:     Write-Lines $e1Path $e1Lines
  208:     Write-Lines (Join-Path $subagents 'agent-E1.meta.json') @((New-MetaJson @{ agentType='executor'; description='fixture executor'; toolUseId='toolu_01FixtureEXEC'; parentAgentId='O1'; spawnDepth=3; model='opus' }))
  209:     (Get-Item $e1Path).LastWriteTime = (Get-Date).AddDays(-40)
  210: 
  211:     # --- U1 and U2, utility agents spawned by the SESSION itself. They have no parent agent, so
  212:     # they resolve through the session's spawn context at their own tool_use id.
  213:     $u1Lines = @( (New-UsageLine '' 61) )
  214:     Write-Lines (Join-Path $subagents 'agent-U1.jsonl') $u1Lines
  215:     Write-Lines (Join-Path $subagents 'agent-U1.meta.json') @((New-MetaJson @{ agentType='general-purpose'; description='fixture utility one'; toolUseId='toolu_01FixtureUTILONE'; spawnDepth=1; model='sonnet' }))
  216: 
  217:     $u2Lines = @( (New-UsageLine '' 71) )
  218:     Write-Lines (Join-Path $subagents 'agent-U2.jsonl') $u2Lines
  219:     Write-Lines (Join-Path $subagents 'agent-U2.meta.json') @((New-MetaJson @{ agentType='general-purpose'; description='fixture utility two'; toolUseId='toolu_01FixtureUTILTWO'; spawnDepth=1; model='sonnet' }))
  220: 
  221:     # --- W1, one level DEEPER in the subagents tree: subagents\workflows\wf_1\. Most real agent
  222:     # transcripts live at this depth, so a flat direct-child scan must not satisfy the suite.
  223:     # Branch-less, so it resolves only through the tree, W1 -> C1.
  224:     $w1Lines = @(
  225:         (New-UsageLine '' 101),
  226:         (New-UsageLine '' 101)
  227:     )
  228:     $wfDir = Join-Path $subagents 'workflows\wf_1'
  229:     Write-Lines (Join-Path $wfDir 'agent-W1.jsonl') $w1Lines
  230:     Write-Lines (Join-Path $wfDir 'agent-W1.meta.json') @((New-MetaJson @{ agentType='reviewer-runner'; description='fixture nested runner'; toolUseId='toolu_01FixtureRUNNER'; parentAgentId='C1'; spawnDepth=2; model='sonnet' }))
  231: 
  232:     # --- M1, the ambiguity case: its own records name TWO items, so its branchless lines must
  233:     # stay unattributed rather than inherit C1's item.
  234:     #
  235:     # The stamp line between them is the second door: the stamp regex matches the escaped form,
  236:     # so an agent transcript that merely QUOTES a stamp would let the branchless lines below it
  237:     # be guessed as AI4DEV-902. The stamp fallback belongs to session files only.
  238:     $m1BranchA   = @( (New-UsageLine 'nirdrang/ai4dev-901-mixed' 81) )
  239:     $m1BranchB   = @( (New-UsageLine 'nirdrang/ai4dev-902-mixed' 83) )
  240:     $m1Stamp     = @( (New-StampLine $ITEM_B) )
  241:     $m1Branchless= @( (New-UsageLine '' 85), (New-UsageLine '' 85) )
  242:     Write-Lines (Join-Path $subagents 'agent-M1.jsonl') ($m1BranchA + $m1BranchB + $m1Stamp + $m1Branchless)
  243:     Write-Lines (Join-Path $subagents 'agent-M1.meta.json') @((New-MetaJson @{ agentType='mechanical'; description='fixture mechanical'; toolUseId='toolu_01FixtureMECH'; parentAgentId='C1'; spawnDepth=2; model='haiku' }))
  244: 
  245:     # --- X1, the metaless agent: no role, no edge, unattributed BY DESIGN.
  246:     $x1Lines = @(
  247:         (New-UsageLine '' 91),
  248:         (New-UsageLine '' 91)
  249:     )
  250:     Write-Lines (Join-Path $subagents 'agent-X1.jsonl') $x1Lines
  251: 
  252:     # --- a background task INSIDE the scanned projects root. Transcript-shaped, and it must
  253:     # never reach a row.
  254:     $bgLines = @(
  255:         (New-UsageLine '' 999),
  256:         (New-UsageLine '' 999),
  257:         (New-UsageLine '' 999)
  258:     )
  259:     Write-Lines (Join-Path $tasksDir 'bg.output') $bgLines
  260: 
  261:     # --- the chain cache /work writes: ITEM_A hangs under ROOT_A; ITEM_B stays chainless.
  262:     Write-Lines (Join-Path $attrDir ('chain-' + $ITEM_A + '.json')) @('{"item":"' + $ITEM_A + '","chain":[{"id":"' + $ROOT_A + '"},{"id":"' + $ITEM_A + '"}]}')
  263: 
  264:     # --- the kimi store, keyed by the BARE agent id O1 (the report must strip the agent- prefix
  265:     # from the transcript file name before joining). Shape copied from the real store: the
  266:     # usage.record lines carry usage at the top level.
  267:     $kimiWire = @(
  268:         '{"type":"usage.record","model":"kimi-code/k3","usage":{"inputOther":100,"output":50,"inputCacheRead":900,"inputCacheCreation":0},"usageScope":"turn","time":1786180253600}',
  269:         '{"type":"usage.record","model":"kimi-code/k3","usage":{"inputOther":200,"output":70,"inputCacheRead":800,"inputCacheCreation":0},"usageScope":"turn","time":1786180259600}'
  270:     )
  271:     $kimiExpectedOut = [long]120
  272:     Write-Lines (Join-Path $kimiDir 'wd_agent-O1_ab12cd34\session_99999999-8888-7777-6666-555555555555\agents\main\wire.jsonl') $kimiWire
  273: 
  274:     # The AMBIGUOUS agent's kimi spend. M1's own records name two items, so no per-agent item
  275:     # fact exists and this spend must stay UNJOINED - it may not be credited whole to whichever
  276:     # of M1's items its last branch record happened to name. The amounts are distinctive, so a
  277:     # leak shows up as an amount rather than as a count.
  278:     $kimiWireM1 = @(
  279:         '{"type":"usage.record","model":"kimi-code/k3","usage":{"inputOther":300,"output":4444,"inputCacheRead":700,"inputCacheCreation":0},"usageScope":"turn","time":1786180263600}',
  280:         '{"type":"usage.record","model":"kimi-code/k3","usage":{"inputOther":400,"output":5555,"inputCacheRead":600,"inputCacheCreation":0},"usageScope":"turn","time":1786180269600}'
  281:     )
  282:     $kimiM1PlantedOut = [long]9999
  283:     Write-Lines (Join-Path $kimiDir 'wd_agent-M1_ef56ab78\session_88888888-7777-6666-5555-444444444444\agents\main\wire.jsonl') $kimiWireM1
  284: 
  285:     # -----------------------------------------------------------------------------------------
  286:     # THE LATE-RESOLVING SESSION (A15), in a store of ITS OWN.
  287:     #
  288:     # The spawn call for L1 is the FIRST record of this session file, and it carries no gitBranch
  289:     # key and no stamp: the session had resolved NOTHING when it spawned L1. The session then
  290:     # works on ITEM_A and names that branch on its own records, and the SAME tool_use id appears
  291:     # a second time in the tool result. First sighting wins, so the tree must hand L1 nothing -
  292:     # L1 was spawned before the session held any item.
  293:     #
  294:     # WHY A SECOND STORE. Every assert above measures ONE store, and A11 pins the unattributed
  295:     # row to an exact value. An agent that moves out of that row when the pin is missing would
  296:     # make A2, A9 and A11 red for a defect A15 already names, so one defect would print four
  297:     # failures. The mechanism under test is per session, so a second session in a second root
  298:     # tests it exactly, and the fourteen asserts above keep their oracles untouched.
  299:     $projects2   = Join-Path $root 'projects-late'
  300:     $sessionId2  = '66666666-7777-8888-9999-aaaaaaaaaaaa'
  301:     $subagents2  = Join-Path $projects2 ($sessionId2 + '\subagents')
  302:     $LATE_ROLE   = 'distiller'
  303:     $lateSession = @(
  304:         (New-SpawnLineNoBranch 'toolu_01FixtureLATE' $LATE_ROLE),
  305:         (New-UsageLine 'nirdrang/ai4dev-901-late' 17),
  306:         (New-ToolResultLine 'toolu_01FixtureLATE' 'nirdrang/ai4dev-901-late')
  307:     )
  308:     Write-Lines (Join-Path $projects2 ($sessionId2 + '.jsonl')) $lateSession
  309:     $l1Lines = @(
  310:         (New-UsageLine '' 131),
  311:         (New-UsageLine '' 131)
  312:     )
  313:     Write-Lines (Join-Path $subagents2 'agent-L1.jsonl') $l1Lines
  314:     Write-Lines (Join-Path $subagents2 'agent-L1.meta.json') @((New-MetaJson @{ agentType=$LATE_ROLE; description='fixture late-resolving spawn'; toolUseId='toolu_01FixtureLATE'; spawnDepth=1; model='haiku' }))
  315: 
  316:     # -----------------------------------------------------------------------------------------
  317:     # what the fixture wrote - every expectation below is derived from these measurements
  318:     # -----------------------------------------------------------------------------------------
  319:     $mSession   = Measure-File $sessionFile
  320:     $mC1        = Measure-File (Join-Path $subagents 'agent-C1.jsonl')
  321:     $mO1        = Measure-File (Join-Path $subagents 'agent-O1.jsonl')
  322:     $mO2        = Measure-File (Join-Path $subagents 'agent-O2.jsonl')
  323:     $mE1        = Measure-File $e1Path
  324:     $mU1        = Measure-File (Join-Path $subagents 'agent-U1.jsonl')
  325:     $mU2        = Measure-File (Join-Path $subagents 'agent-U2.jsonl')
  326:     $mW1        = Measure-File (Join-Path $wfDir 'agent-W1.jsonl')
  327:     $mX1        = Measure-File (Join-Path $subagents 'agent-X1.jsonl')
  328:     $mBg        = Measure-File (Join-Path $tasksDir 'bg.output')
  329:     $mSessA     = Measure-Lines $sessionA
  330:     $mSessB     = Measure-Lines $sessionB
  331:     $mM1A       = Measure-Lines $m1BranchA
  332:     $mM1B       = Measure-Lines $m1BranchB
  333:     $mM1None    = Measure-Lines $m1Branchless
  334:     $mLateSess  = Measure-Lines $lateSession
  335:     $mL1        = Measure-File (Join-Path $subagents2 'agent-L1.jsonl')
  336: 
  337:     $allJsonl = @(Get-ChildItem $projects -Recurse -File -Filter '*.jsonl')
  338:     $expTotalResp = 0
  339:     $expTotalOut  = [long]0
  340:     foreach ($f in $allJsonl) {
  341:         $m = Measure-File $f.FullName
  342:         $expTotalResp = $expTotalResp + $m.Responses
  343:         $expTotalOut  = $expTotalOut + $m.OutputTok
  344:     }
  345: 
  346:     # -----------------------------------------------------------------------------------------
  347:     # run the report against the fixture
  348:     # -----------------------------------------------------------------------------------------
  349:     function Invoke-Report([string[]]$extra, [string]$projectsRoot = $projects) {
  350:         $psArgs = @('-NoProfile', '-File', $report,
  351:                     '-ProjectsDir', $projectsRoot, '-AttrDir', $attrDir, '-ItemsDir', $itemsDir,
  352:                     '-CodexSessions', $codexDir, '-KimiRoot', $kimiDir) + $extra
  353:         return (& powershell @psArgs | Out-String)
  354:     }
  355: 
  356:     $jsonText  = Invoke-Report @('-Json')
  357:     $j         = $jsonText | ConvertFrom-Json
  358:     $textOut   = Invoke-Report @()
  359:     $jsonItemB = (Invoke-Report @('-Json', '-Item', $ITEM_B)) | ConvertFrom-Json
  360:     $jsonDays7 = (Invoke-Report @('-Json', '-Days', '7')) | ConvertFrom-Json
  361:     $jsonLate  = (Invoke-Report @('-Json') $projects2) | ConvertFrom-Json
  362: 
  363:     # -----------------------------------------------------------------------------------------
  364:     # A1 - the tree mechanism puts every sitting's tokens under the item.
  365:     # BOTH counters are asserted, responses AND output tokens: tokens could be moved between the
  366:     # branch, tree and stamp rows while every response count and the global total stayed right.
  367:     # -----------------------------------------------------------------------------------------
  368:     $rABranch = Get-Row $j $ITEM_A 'branch'
  369:     $rATree   = Get-Row $j $ITEM_A 'tree'
  370:     $rAStamp  = Get-Row $j $ITEM_A 'stamp'
  371:     $rBStamp  = Get-Row $j $ITEM_B 'stamp'
  372:     $expABranch    = $mC1.Responses + $mM1A.Responses
  373:     $expABranchOut = $mC1.OutputTok + $mM1A.OutputTok
  374:     $expATree      = $mO1.Responses + $mO2.Responses + $mE1.Responses + $mU1.Responses + $mW1.Responses
  375:     $expATreeOut   = $mO1.OutputTok + $mO2.OutputTok + $mE1.OutputTok + $mU1.OutputTok + $mW1.OutputTok
  376:     $a1RespOk = ($rABranch.Responses -eq $expABranch) -and ($rATree.Responses -eq $expATree) -and ($rAStamp.Responses -eq $mSessA.Responses) -and ($rBStamp.Responses -eq $mSessB.Responses)
  377:     $a1TokOk  = ([long]$rABranch.OutputTok -eq $expABranchOut) -and ([long]$rATree.OutputTok -eq $expATreeOut) -and ([long]$rAStamp.OutputTok -eq $mSessA.OutputTok) -and ([long]$rBStamp.OutputTok -eq $mSessB.OutputTok)
  378:     Assert-That 'A1' 'tree agents land under the item, in responses AND output tokens (C1 by branch, O1/O2/E1/W1 by tree, U1 by spawn context, stamp lines split)' `
  379:         ($a1RespOk -and $a1TokOk) `
  380:         ('branch=' + $rABranch.Responses + '/' + $expABranch + ' tree=' + $rATree.Responses + '/' + $expATree + ' stampA=' + $rAStamp.Responses + '/' + $mSessA.Responses + ' stampB=' + $rBStamp.Responses + '/' + $mSessB.Responses +
  381:          ' || branchOut=' + $rABranch.OutputTok + '/' + $expABranchOut + ' treeOut=' + $rATree.OutputTok + '/' + $expATreeOut + ' stampAOut=' + $rAStamp.OutputTok + '/' + $mSessA.OutputTok + ' stampBOut=' + $rBStamp.OutputTok + '/' + $mSessB.OutputTok)
  382: 
  383:     # -----------------------------------------------------------------------------------------
  384:     # A2 - the executor's tokens are under the item, and the unattributed row holds none of them
  385:     # -----------------------------------------------------------------------------------------
  386:     $roleExec = Get-RoleRow $j $ITEM_A 'executor'
  387:     $rUnatt   = Get-Row $j 'unattributed' 'none'
  388:     $expUnattResp = $mM1None.Responses + $mX1.Responses
  389:     Assert-That 'A2' 'the executor is attributed to the item and appears in no unattributed row' `
  390:         (($roleExec.Responses -eq $mE1.Responses) -and ([long]$roleExec.OutputTok -eq $mE1.OutputTok) -and ($rUnatt.Responses -eq $expUnattResp)) `
  391:         ('exec=' + $roleExec.Responses + '/' + $mE1.Responses + ' execOut=' + $roleExec.OutputTok + '/' + $mE1.OutputTok + ' unatt=' + $rUnatt.Responses + '/' + $expUnattResp)
  392: 
  393:     # -----------------------------------------------------------------------------------------
  394:     # A3 - the background file is excluded although it sits inside the scanned root, and the
  395:     # response total is exactly the assistant-usage sum over the fixture's .jsonl files
  396:     # -----------------------------------------------------------------------------------------
  397:     Assert-That 'A3' 'the total counts every fixture transcript and excludes the background .output file' `
  398:         ((([int]$j.totals.responses) -eq $expTotalResp) -and (([long]$j.totals.outputTok) -eq $expTotalOut) -and ($mBg.Responses -gt 0)) `
  399:         ('responses=' + $j.totals.responses + '/' + $expTotalResp + ' outTok=' + $j.totals.outputTok + '/' + $expTotalOut + ' bgLinesPlanted=' + $mBg.Responses)
  400: 
  401:     # -----------------------------------------------------------------------------------------
  402:     # A4 - the per-item rows reconcile to the totals
  403:     # -----------------------------------------------------------------------------------------
  404:     $sumResp = Sum-Of $j.rows 'Responses'
  405:     $sumOut  = Sum-Of $j.rows 'OutputTok'
  406:     Assert-That 'A4' 'the per-item rows reconcile to the TOTAL line' `
  407:         (($sumResp -eq [long]$j.totals.responses) -and ($sumOut -eq [long]$j.totals.outputTok)) `
  408:         ('rowSum=' + $sumResp + '/' + $j.totals.responses + ' outSum=' + $sumOut + '/' + $j.totals.outputTok)
  409: 
  410:     # -----------------------------------------------------------------------------------------
  411:     # A5 - the role column comes from the meta agentType, for tree-resolved agents too
  412:     # -----------------------------------------------------------------------------------------
  413:     $roleOrch = Get-RoleRow $j $ITEM_A 'orchestrator'
  414:     $roleCond = Get-RoleRow $j $ITEM_A 'conductor'
  415:     $expOrchResp = $mO1.Responses + $mO2.Responses
  416:     $expOrchOut  = $mO1.OutputTok + $mO2.OutputTok
  417:     Assert-That 'A5' 'roles come from the spawn meta: O1+O2 orchestrator, E1 executor, C1 conductor' `
  418:         (($roleOrch.Responses -eq $expOrchResp) -and ([long]$roleOrch.OutputTok -eq $expOrchOut) -and ($roleExec.Responses -eq $mE1.Responses) -and ($roleCond.Responses -eq $mC1.Responses)) `
  419:         ('orch=' + $roleOrch.Responses + '/' + $expOrchResp + ' orchOut=' + $roleOrch.OutputTok + '/' + $expOrchOut + ' exec=' + $roleExec.Responses + '/' + $mE1.Responses + ' cond=' + $roleCond.Responses + '/' + $mC1.Responses)
  420: 
  421:     # -----------------------------------------------------------------------------------------
  422:     # A6 - tree-resolved responses say so in the From column
  423:     # -----------------------------------------------------------------------------------------
  424:     $rBTree = Get-Row $j $ITEM_B 'tree'
  425:     Assert-That 'A6' 'tree-resolved rows carry From = tree' `
  426:         ((-not $rATree.Missing) -and ($rATree.Responses -gt 0) -and (-not $rBTree.Missing) -and ($rBTree.Responses -gt 0)) `
  427:         ('treeA=' + $rATree.Responses + ' treeB=' + $rBTree.Responses)
  428: 
  429:     # -----------------------------------------------------------------------------------------
  430:     # A7 - each session-rooted agent inherits the item the session held AT ITS OWN spawn call.
  431:     # Latest-wins gives U1 the wrong item; a file-wide single item resolves neither.
  432:     # -----------------------------------------------------------------------------------------
  433:     $roleUtilA = Get-RoleRow $j $ITEM_A 'general-purpose'
  434:     $roleUtilB = Get-RoleRow $j $ITEM_B 'general-purpose'
  435:     Assert-That 'A7' 'U1 inherits the first item and U2 the second, each at its own spawn tool_use id' `
  436:         (($roleUtilA.Responses -eq $mU1.Responses) -and ($roleUtilB.Responses -eq $mU2.Responses) -and ([long]$roleUtilA.OutputTok -eq $mU1.OutputTok) -and ([long]$roleUtilB.OutputTok -eq $mU2.OutputTok)) `
  437:         ('U1->' + $ITEM_A + '=' + $roleUtilA.Responses + '/' + $mU1.Responses + ' U2->' + $ITEM_B + '=' + $roleUtilB.Responses + '/' + $mU2.Responses)
  438: 
  439:     # -----------------------------------------------------------------------------------------
  440:     # A8 - the chain rollup still credits the root with everything beneath it
  441:     # -----------------------------------------------------------------------------------------
  442:     $rollRoot = Get-RollRow $j $ROOT_A
  443:     $expRootResp = $rABranch.Responses + $rATree.Responses + $rAStamp.Responses
  444:     $expRootOut  = [long]$rABranch.OutputTok + [long]$rATree.OutputTok + [long]$rAStamp.OutputTok
  445:     Assert-That 'A8' 'the rollup credits the chain root with its child item totals' `
  446:         (($rollRoot.Responses -eq $expRootResp) -and ([long]$rollRoot.OutputTok -eq $expRootOut)) `
  447:         ('root=' + $rollRoot.Responses + '/' + $expRootResp + ' rootOut=' + $rollRoot.OutputTok + '/' + $expRootOut)
  448: 
  449:     # -----------------------------------------------------------------------------------------
  450:     # A9 - an agent file naming TWO items keeps its branchless lines unattributed. It never
  451:     # inherits its parent's item.
  452:     # -----------------------------------------------------------------------------------------
  453:     $rBBranch = Get-Row $j $ITEM_B 'branch'
  454:     Assert-That 'A9' 'a two-item agent file stays ambiguous: its branchless lines are unattributed, its branch lines keep their own items' `
  455:         (($rUnatt.Responses -eq $expUnattResp) -and ($rABranch.Responses -eq $expABranch) -and ($rBBranch.Responses -eq $mM1B.Responses)) `
  456:         ('unatt=' + $rUnatt.Responses + '/' + $expUnattResp + ' branchA=' + $rABranch.Responses + '/' + $expABranch + ' branchB=' + $rBBranch.Responses + '/' + $mM1B.Responses)
  457: 
  458:     # -----------------------------------------------------------------------------------------
  459:     # A10 - the kimi join works on the BARE agent id and on a TREE-resolved agent, and the
  460:     # AMBIGUOUS agent's spend stays out of it. The fixture planted two kimi directories; exactly
  461:     # one row may exist, and its tokens must be the O1 wire sum alone.
  462:     # -----------------------------------------------------------------------------------------
  463:     $kRows = @($j.kimiRows)
  464:     $kRow  = @($kRows | Where-Object { $_.Item -eq $ITEM_A })
  465:     $kOk = (($kRows.Count -eq 1) -and ($kRow.Count -eq 1))
  466:     if ($kOk) { $kOk = (([long]$kRow[0].OutputTok -eq $kimiExpectedOut) -and ([int]$kRow[0].Sessions -eq 1)) }
  467:     Assert-That 'A10' 'the kimi table holds exactly the O1 join, on the bare agent id, and the ambiguous agent M1 contributes nothing' `
  468:         (($kOk) -and ($roleOrch.Responses -eq $expOrchResp)) `
  469:         ('kimiRows=' + $kRows.Count + '/1 matched=' + $kRow.Count + ' out=' + $(if ($kRow.Count -eq 1) { $kRow[0].OutputTok } else { 'n/a' }) + '/' + $kimiExpectedOut + ' M1 planted but unjoinable=' + $kimiM1PlantedOut + ' allRows=' + (($kRows | ForEach-Object { $_.Item + ':' + $_.OutputTok }) -join ','))
  470: 
  471:     # -----------------------------------------------------------------------------------------
  472:     # A11 - the unattributed row is exactly what the fixture planted, and the printed share is
  473:     # the value recomputed from the totals
  474:     # -----------------------------------------------------------------------------------------
  475:     $expUnattOut = $mM1None.OutputTok + $mX1.OutputTok
  476:     $recomputed = 0
  477:     if ([long]$j.totals.outputTok -gt 0) { $recomputed = [math]::Round(100.0 * [long]$j.totals.unattributedOutputTok / [long]$j.totals.outputTok, 1) }
  478:     $printed = -1
  479:     $pm = [regex]::Match($textOut, 'unattributed share of output tokens:\s*([0-9]+(?:\.[0-9]+)?)%')
  480:     if ($pm.Success) { $printed = [double]$pm.Groups[1].Value }
  481:     Assert-That 'A11' 'the unattributed row equals the planted lines, and the printed share equals the recomputed share' `
  482:         (($rUnatt.Responses -eq $expUnattResp) -and ([long]$rUnatt.OutputTok -eq $expUnattOut) -and ([long]$j.totals.unattributedOutputTok -eq $expUnattOut) -and ([double]$j.totals.unattributedPct -eq $recomputed) -and ($printed -eq $recomputed)) `
  483:         ('unattOut=' + $rUnatt.OutputTok + '/' + $expUnattOut + ' pct=' + $j.totals.unattributedPct + ' recomputed=' + $recomputed + ' printed=' + $printed)
  484: 
  485:     # -----------------------------------------------------------------------------------------
  486:     # A12 - -Item scopes every row to that item, and its responses are the fixture's known sum
  487:     # -----------------------------------------------------------------------------------------
  488:     $bRows = @($jsonItemB.rows)
  489:     $bOnly = $true
  490:     foreach ($r in $bRows) { if ($r.Item -ne $ITEM_B) { $bOnly = $false } }
  491:     $expBResp = $mU2.Responses + $mSessB.Responses + $mM1B.Responses
  492:     $bResp = Sum-Of $bRows 'Responses'
  493:     Assert-That 'A12' '-Item returns rows for that item only, summing to the fixture value' `
  494:         (($bOnly) -and ($bRows.Count -gt 0) -and ($bResp -eq $expBResp)) `
  495:         ('rows=' + $bRows.Count + ' onlyItemB=' + $bOnly + ' resp=' + $bResp + '/' + $expBResp)
  496: 
  497:     # -----------------------------------------------------------------------------------------
  498:     # A13 - -Days drops exactly the backdated transcript, and the default run keeps it
  499:     # -----------------------------------------------------------------------------------------
  500:     $expDaysResp = $expTotalResp - $mE1.Responses
  501:     Assert-That 'A13' '-Days 7 excludes exactly the backdated executor transcript that the default run includes' `
  502:         ((([int]$jsonDays7.totals.responses) -eq $expDaysResp) -and (([int]$j.totals.responses) -eq $expTotalResp) -and ($mE1.Responses -gt 0)) `
  503:         ('days7=' + $jsonDays7.totals.responses + '/' + $expDaysResp + ' default=' + $j.totals.responses + '/' + $expTotalResp)
  504: 
  505:     # -----------------------------------------------------------------------------------------
  506:     # A14 - the escaped gitBranch inside a tool result is never read as a branch fact
  507:     # -----------------------------------------------------------------------------------------
  508:     $decoySeen = $false
  509:     foreach ($r in @($j.rows))      { if ([string]$r.Item -eq $DECOY) { $decoySeen = $true } }
  510:     foreach ($r in @($j.roleRows))  { if ([string]$r.Item -eq $DECOY) { $decoySeen = $true } }
  511:     foreach ($r in @($j.rollRows))  { if ([string]$r.Node -eq $DECOY) { $decoySeen = $true } }
  512:     foreach ($r in @($j.codexRows)) { if ([string]$r.Item -eq $DECOY) { $decoySeen = $true } }
  513:     foreach ($r in @($j.kimiRows))  { if ([string]$r.Item -eq $DECOY) { $decoySeen = $true } }
  514:     if ($textOut.IndexOf($DECOY) -ge 0) { $decoySeen = $true }
  515:     Assert-That 'A14' 'no table names the decoy item planted as an escaped gitBranch in a tool result' `
  516:         (-not $decoySeen) `
  517:         ('decoy ' + $DECOY + ' found in the output')
  518: 
  519:     # -----------------------------------------------------------------------------------------
  520:     # A15 - the FIRST sighting of a spawn call pins the session's state even when that state
  521:     # resolves NOTHING. The late store plants the whole sequence: the spawn call first, with no
  522:     # branch and no stamp before it; then the session resolving ITEM_A on its own records; then
  523:     # the SAME tool_use id again in the tool result. Storing a key only for a RESOLVED sighting
  524:     # would leave the first sighting unrecorded, and the tool result would answer for it - so L1
  525:     # would inherit an item the session took AFTER it was spawned.
  526:     #
  527:     # Four measurements, all from the fixture's own bytes: L1 is exactly the unattributed row;
  528:     # the session's own branch line is exactly the branch row (which proves the session really
  529:     # does resolve ITEM_A later, so the assert cannot pass because nothing resolved at all);
  530:     # no tree row exists for ITEM_A; and no role row names the spawned role.
