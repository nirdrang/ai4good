  437: # ---- vendor spend (codex), joined by the session id the reviewer printed into its own log
  438: #
  439: # Every codex run writes a header containing `session id: <uuid>`, and we COMMIT those logs into
  440: # loop/items/<ITEM>/ - so the ids live in the repository and survive the artifact sweep. Codex
--- REPORT lines 441-700 ---
  441: # stores each run as sessions/<y>/<m>/<d>/rollout-<timestamp>-<uuid>.jsonl carrying real token
  442: # counts. Joining the two attributes reviewer spend to the item whose folder holds the log:
  443: # derived from what the tool emitted and what the item recorded, declared by nobody.
  444: #
  445: # KIMI IS INCLUDED, and an earlier version of this file claimed it could not be. That claim was
  446: # FALSE and was written after a search that used `-SimpleMatch` with a pattern containing `|`,
  447: # so it looked for the literal pipes instead of the alternatives and found nothing. The founder
  448: # pointed at the real location. Kimi keeps
  449: # ~/.kimi-code/sessions/wd_agent-<agentId>_*/session_*/agents/*/wire.jsonl, whose usage records
  450: # read {inputOther, output, inputCacheRead, inputCacheCreation} and are PER TURN - so they are
  451: # summed, unlike codex's cumulative total. The directory name embeds the id of the agent that
  452: # launched it, and that agent's own transcript gives the item, so the join needs nothing declared.
  453: $vendor = @{}
  454: $itemsDir = $ItemsDir
  455: $sessRe = [regex]'session id:\s*([0-9a-fA-F-]{36})'
  456: $rollouts = @{}
  457: $codexSessions = $CodexSessions
  458: if (Test-Path $codexSessions) {
  459:     foreach ($rf in (Get-ChildItem $codexSessions -Recurse -File -Filter 'rollout-*.jsonl' -ErrorAction SilentlyContinue)) {
  460:         $mm = [regex]::Match($rf.Name, '([0-9a-fA-F-]{36})\.jsonl$')
  461:         if ($mm.Success) { $rollouts[$mm.Groups[1].Value.ToLower()] = $rf.FullName }
  462:     }
  463: }
  464: if (Test-Path $itemsDir) {
  465:     foreach ($dir in (Get-ChildItem $itemsDir -Directory -ErrorAction SilentlyContinue)) {
  466:         $item = $dir.Name
  467:         # -Recurse: since 2026-08-09 reviewer logs land in loop/items/<ITEM>/artifacts/, one level down
  468:         foreach ($log in (Get-ChildItem $dir.FullName -File -Filter '*stderr*' -Recurse -ErrorAction SilentlyContinue)) {
  469:             foreach ($sm in $sessRe.Matches([System.IO.File]::ReadAllText($log.FullName))) {
  470:                 $sid = $sm.Groups[1].Value.ToLower()
  471:                 if (-not $rollouts.ContainsKey($sid)) { continue }
  472:                 if (-not $vendor.ContainsKey($item)) { $vendor[$item] = @{ runs = 0; inTok = [long]0; outTok = [long]0; cached = [long]0 } }
  473:                 $v = $vendor[$item]; $v.runs++
  474:                 foreach ($l in [System.IO.File]::ReadLines($rollouts[$sid])) {
  475:                     if ($l.IndexOf('"output_tokens"') -lt 0) { continue }
  476:                     try {
  477:                         $o = $l | ConvertFrom-Json
  478:                         $tu = $null
  479:                         if ($o.payload -and $o.payload.info -and $o.payload.info.total_token_usage) { $tu = $o.payload.info.total_token_usage }
  480:                         elseif ($o.info -and $o.info.total_token_usage) { $tu = $o.info.total_token_usage }
  481:                         if ($tu) {
  482:                             # total_token_usage is CUMULATIVE for the session, so the last one wins
  483:                             # rather than being summed - adding them would multiply the real cost.
  484:                             $v.inTok = [long]$tu.input_tokens; $v.outTok = [long]$tu.output_tokens
  485:                             if ($tu.cached_input_tokens) { $v.cached = [long]$tu.cached_input_tokens }
  486:                         }
  487:                     } catch { }
  488:                 }
  489:             }
  490:         }
  491:     }
  492: }
  493: 
  494: $kimi = @{}
  495: $kimiRoot = $KimiRoot
  496: if (Test-Path $kimiRoot) {
  497:     foreach ($wd in (Get-ChildItem $kimiRoot -Directory -ErrorAction SilentlyContinue)) {
  498:         $am = [regex]::Match($wd.Name, 'wd_agent-([A-Za-z0-9]+)_')
  499:         if (-not $am.Success) { continue }
  500:         $agentId = $am.Groups[1].Value
