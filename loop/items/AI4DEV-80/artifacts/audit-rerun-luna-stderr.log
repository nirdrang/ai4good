  357:     try {
  358:         while ($null -ne ($line = $reader.ReadLine())) {
  359:             if ($line.IndexOf('"gitBranch"') -ge 0) {
  360:                 $bm = $branchRe.Match($line)
  361:                 if ($bm.Success) { $curBranch = $bm.Groups[1].Value }
  362:             }
  363:             if ($line.IndexOf('ai4good-attribution') -ge 0) { $curStamp = Get-StampValue $line $curStamp }
  364:             if ($line.IndexOf('"usage"') -ge 0 -and $line.IndexOf('"output_tokens"') -ge 0) {
  365:                 try {
  366:                     $o = $line | ConvertFrom-Json
  367:                     $u = $null
  368:                     if ($o.message -and $o.message.usage) { $u = $o.message.usage }
  369:                     elseif ($o.usage) { $u = $o.usage }
  370:                     if ($u -and $o.type -eq 'assistant') {
  371:                         # Own record branch first, exactly as before. The tree is a FALLBACK for a
  372:                         # record that resolves nothing on its own - it never overrides a branch.
  373:                         #
  374:                         # THE STAMP FALLBACK IS FOR SESSION FILES ONLY. The stamp regex matches the
  375:                         # escaped form on purpose, so an agent transcript that QUOTES a stamp - in
  376:                         # a spawn prompt or a tool result - would otherwise set $curStamp and let an
  377:                         # unresolvable agent guess an item from text it merely read. An agent
  378:                         # resolves branch, then tree, then nothing.
  379:                         $ids = @(Get-BranchItems $curBranch)
  380:                         if ($ids.Count -eq 1)                  { Add-Usage ($ids[0] + '|branch')  $u $agg }
  381:                         elseif ($ids.Count -gt 1)              { Add-Usage ('unresolved|branch')  $u $agg }
  382:                         elseif ($curTree)                      { Add-Usage ($curTree + '|tree')   $u $agg }
  383:                         elseif ($curStamp -and (-not $isAgent)) { Add-Usage ($curStamp + '|stamp') $u $agg }
  384:                         else                                   { Add-Usage ('unattributed|none')  $u $agg }
  385:                         # A tree-resolved response feeds the role table and the vendor join key
  386:                         # exactly as a branch-resolved one does.
  387:                         #
  388:                         # THE VENDOR JOIN KEY DEGRADES LIKE THE TREE WALK. An ambiguous agent gets
  389:                         # no $agentItem entry, so its kimi spend stays unjoined rather than being
  390:                         # credited whole to whichever of its items its last branch record named.
  391:                         # The tree-fed assignment below needs no such guard: an ambiguous agent
  392:                         # never has a tree item.
  393:                         if ($ids.Count -eq 1) {
  394:                             Add-Usage ($ids[0] + '|' + $curRole) $u $roleAgg
  395:                             if (-not $curAmbiguous) { $agentItem[$joinKey] = $ids[0] }
  396:                         }
  397:                         elseif ($ids.Count -eq 0 -and $curTree) {
  398:                             Add-Usage ($curTree + '|' + $curRole) $u $roleAgg
  399:                             $agentItem[$joinKey] = $curTree
  400:                         }
  401:                     }
  402:                 } catch { }
  403:             }
  404:         }
  405:     }
  406:     finally { $reader.Dispose() }
