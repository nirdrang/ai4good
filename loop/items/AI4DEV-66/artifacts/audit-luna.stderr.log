  353: # `twitter`, `x`, `slack`, `spotify`, `workos`, `zoom`.
  354: [auth.external.apple]
  355: enabled = false
  356: client_id = ""
  357: # DO NOT commit your OAuth provider secret to git. Use environment variable substitution instead:
  358: secret = "env(SUPABASE_AUTH_EXTERNAL_APPLE_SECRET)"
  359: # Overrides the default auth callback URL derived from auth.external_url.
