    7:  * file's: `tenantReadAllowed(viewer, 'project')` admits the project's assigned developer and the
    8:  * platform administrator, and `tenantReadAllowed(viewer, 'organization')` admits the organisation's
    9:  * seat. Two scopes, two viewer kinds, one function.
   10:  *
   11:  * ============================================================================================
   12:  * THE TARGET IS READ LAST HERE TOO, AND HERE IT IS ALSO A DECISION INPUT
   13:  * ============================================================================================
   14:  *
   15:  * Two reads: the caller's account row, then the project. Whether the caller is the project's assigned
   16:  * developer is a fact carried BY the project row, so the target read is both the last read and one of
   17:  * the decision's inputs â€” which is consistent rather than an exception. The constraint is that
   18:  * NOTHING is read after the target, so a fault answers the same 502 for a real foreign project and
   19:  * for an identifier that names nothing. The decision is then computed from values already in hand.
   20:  *
   21:  * SO THERE IS NO MEMBERSHIP READ ON THIS PATH AT ALL, and that is worth saying because its absence
   22:  * looks like an omission. A membership read would have to be keyed on the project's owning
   23:  * organisation, which is only known AFTER the project row is read â€” and a read after the target read
   24:  * is exactly what the ordering forbids. The rule this surface serves does not need one.
   25:  */
   26: 
   27: import type { AccountType } from '../_shared/accounts.ts';
   28: import {
   29:   edgeHandler,
   30:   json,
   31:   readJsonBody,
   32:   readRows,
   33:   refusal,
   34:   requireEnv,
   35:   resolveCaller,
   36: } from '../_shared/edge.ts';
   37: import { TENANT_NOT_FOUND, tenantReadAllowed } from '../_shared/visibility.ts';
   38: 
   39: const SUPABASE_URL = requireEnv('SUPABASE_URL');
   40: const ANON_KEY = requireEnv('SUPABASE_ANON_KEY', 'SUPABASE_PUBLISHABLE_KEY');
   41: const SERVICE_ROLE_KEY = requireEnv('SUPABASE_SERVICE_ROLE_KEY', 'SUPABASE_SECRET_KEY');
   42: 
   43: /** An outage, naming no identifier â€” see `organization-dashboard` for why the sentence is fixed. */
   44: function readFailed(): Response {
   45:   return json(
   46:     { ok: false, reason: 'the project workspace could not read what it needs, so no decision was made' },
   47:     502,
   48:   );
   49: }
   50: 
   51: Deno.serve(edgeHandler('project-workspace', async (request: Request): Promise<Response> => {
   52:   if (request.method !== 'POST') return refusal('project-workspace accepts POST only', 405);
   53: 
   54:   const caller = await resolveCaller(request, SUPABASE_URL, ANON_KEY);
   55:   if (!caller) return refusal('authenticate before reading a project workspace', 401);
   56: 
   57:   const body = await readJsonBody(request);
   58:   if (!body.ok) return refusal(body.reason, 400);
   59: 
   60:   const rawId = body.value.projectId;
   61:   if (typeof rawId !== 'string' || rawId.trim() === '') {
   62:     return refusal('a project workspace read must name the project to read', 400);
   63:   }
   64:   const projectId = rawId.trim();
   65: 
   66:   // READ 1 â€” the caller's own account row, keyed on the caller.
   67:   const accountRead = await readRows(SUPABASE_URL, SERVICE_ROLE_KEY, `accounts?id=eq.${encodeURIComponent(caller.id)}&select=account_type`);
   68:   if (!accountRead.ok) return readFailed();
   69:   const accountType = accountRead.rows[0]?.account_type;
   70: 
   71:   // READ 2 â€” THE TARGET, AND IT IS LAST. Nothing is read after this line.
   72:   const projectRead = await readRows(
   73:     SUPABASE_URL,
   74:     SERVICE_ROLE_KEY,
   75:     `projects?id=eq.${encodeURIComponent(projectId)}&select=id,org_id,name,assigned_volunteer_id`,
   76:   );
   77:   if (!projectRead.ok) return readFailed();
   78:   const project = projectRead.rows[0];
   79: 
   80:   // THE DECISION, COMPUTED FROM VALUES ALREADY IN HAND. The seat comparison is `=== caller.id` â€” the
   81:   // id Supabase Auth answered with, never one the request carried.
   82:   const allowed = tenantReadAllowed(
   83:     {
   84:       accountType: typeof accountType === 'string' ? (accountType as AccountType) : null,
   85:       roleInTargetOrganization: null,
   86:       assignedVolunteerOfTargetProject: project !== undefined && project.assigned_volunteer_id === caller.id,
   87:     },
   88:     'project',
   89:   );
   90: 
   91:   // ONE ANSWER FOR BOTH CASES â€” the unassigned volunteer and the project that is not there.
   92:   if (!allowed.ok || project === undefined) return json(TENANT_NOT_FOUND.body, TENANT_NOT_FOUND.status);
   93: 
   94:   return json(
   95:     {
   96:       ok: true,
   97:       projectId: String(project.id),
   98:       projectName: String(project.name),
   99:       organizationId: String(project.org_id),
  100:       assignedVolunteerId: project.assigned_volunteer_id === null || project.assigned_volunteer_id === undefined ? null : String(project.assigned_volunteer_id),
  101:     },
  102:     200,
  103:   );
  104: }));
