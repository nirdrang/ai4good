  302: 
  303: atTest(
  304:   'AT-001.22',
  305:   'an unassigned volunteer is denied a project non-public data while the public page stays visible',
  306:   // THE `ui` TAG, for the same reason AT-001.21 carries it (gate-1 ruling 1): "the public project
  307:   // page remains visible" names a PAGE, and there is no page in this tree â€” only its API surface.
  308:   { surface: 'ui', timeoutMs: { integration: INTEGRATION_TIMEOUT_MS } },
  309:   {
  310:     default: async ({ open }) => {
  311:       const { w, sut } = await open();
  312:       const ORGANIZATION_NAME = 'Riverside Shelter 22';
  313:       const PROJECT_NAME = 'Riverside Shelter Website 22';
  314: 
  315:       // THE OWNING NGO, through the product path.
  316:       const ngo = await sut.registerWithEmailPassword(w.email('project-owner-22'), PASSWORD);
  317:       const owner = await sut.completeSignup(
  318:         ngo,
  319:         { accountType: 'ngo', organizationName: ORGANIZATION_NAME, acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
  320:         CLIENT_IP,
  321:       );
  322:       expect(owner, 'the NGO could not complete signup, so there is no organisation to hold a project').toMatchObject({ ok: true });
  323:       expect(
  324:         owner.ok ? owner.organizationId : null,
  325:         'the owning NGO completed signup with no organisation, so no project can be created for a volunteer to be denied and this id would go green having proved nothing',
  326:       ).not.toBeNull();
  327:       if (!owner.ok || owner.organizationId === null) return;
  328: 
  329:       // TWO VOLUNTEERS, both real accounts through the product path. The difference between them is
  330:       // the ONE fact the criterion turns on: which of them holds the project's developer seat.
  331:       const assignedSession = await sut.registerWithEmailPassword(w.email('assigned-volunteer-22'), PASSWORD);
  332:       await sut.linkGithubIdentity(assignedSession, 'assigned-volunteer-22-handle');
  333:       const assigned = await sut.completeSignup(
  334:         assignedSession,
  335:         { accountType: 'volunteer', acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
  336:         CLIENT_IP,
  337:       );
  338:       expect(assigned, 'the assigned volunteer could not complete signup, so there is no control').toMatchObject({ ok: true });
  339:       if (!assigned.ok) return;
  340: 
  341:       const unassigned = await sut.registerWithEmailPassword(w.email('unassigned-volunteer-22'), PASSWORD);
  342:       await sut.linkGithubIdentity(unassigned, 'unassigned-volunteer-22-handle');
  343:       const outsider = await sut.completeSignup(
  344:         unassigned,
  345:         { accountType: 'volunteer', acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
  346:         CLIENT_IP,
  347:       );
  348:       expect(outsider, 'the unassigned volunteer could not complete signup, so there is nobody to be denied').toMatchObject({
  349:         ok: true,
  350:       });
  351:       if (!outsider.ok) return;
  352: 
  353:       // THE PROJECT AND ITS SEAT â€” operator-provisioned, because no product path creates a project
  354:       // or attaches a volunteer at either tier.
  355:       const project = await sut.createProjectAsOperator(owner.organizationId, PROJECT_NAME);
  356:       const seated = await sut.assignVolunteerAsOperator(project.id, assigned.accountId);
  357:       expect(seated, 'the volunteer could not be attached, so this criterion has no Given').toMatchObject({ ok: true });
  358:       expect(await sut.projectAssignment(project.id), 'the seat does not hold the assigned volunteer').toMatchObject({
  359:         assignedVolunteerId: assigned.accountId,
  360:       });
  361: 
  362:       // (1) THE CONTROL COMES FIRST â€” the ASSIGNED volunteer reads the workspace. A surface that
  363:       // refused everybody would satisfy every denial below while proving nothing, so the allowed
  364:       // read is asserted before any refusal is measured.
  365:       const allowed = await sut.projectWorkspace(assignedSession, project.id);
  366:       expect(allowed.ok, 'the ASSIGNED volunteer was refused its own project workspace').toBe(true);
  367:       if (!allowed.ok) return;
  368:       expect(allowed.status, 'the allowed workspace read did not answer 200').toBe(200);
  369:       expect(allowed.value, 'the workspace does not hold the project working data it is supposed to').toEqual({
  370:         projectId: project.id,
  371:         projectName: PROJECT_NAME,
  372:         organizationId: owner.organizationId,
  373:         assignedVolunteerId: assigned.accountId,
  374:       });
  375: 
  376:       // (2) THE UNASSIGNED VOLUNTEER IS REFUSED THE SAME WORKSPACE.
  377:       const refused = await sut.projectWorkspace(unassigned, project.id);
  378:       expect(refused.ok, 'a volunteer who holds no seat on the project read its workspace').toBe(false);
  379:       if (refused.ok) return;
  380: 
  381:       // (3) AND THE IDENTIFIER THAT NAMES NOTHING ANSWERS IDENTICALLY. At the loop tier there are no
  382:       // bytes, so the comparison is deep equality of the whole returned value; the integration body
  383:       // compares the RAW response text instead (gate-1 ruling 5).
  384:       const absent = await sut.projectWorkspace(unassigned, ABSENT_ID);
  385:       expect(absent.ok, 'a project that does not exist answered with a projection').toBe(false);
  386:       if (absent.ok) return;
  387:       expect(absent.status, 'the two refusals carry different statuses, which says which project is real').toBe(refused.status);
  388:       expect(absent, 'the refusal for a real foreign project differs from the refusal for one that does not exist').toEqual(refused);
  389: 
  390:       // (4) THE SAME DENIAL THROUGH THE DATA API â€” the criterion's other path, with the volunteer's
  391:       // own access token on it rather than the edge surface's service-role read.
  392:       const keyed = await sut.dataApiRead(unassigned, { table: 'projects', keyedBy: 'id', value: project.id });
  393:       expect(keyed.rows, 'the volunteer\'s keyed probe was refused before any row was considered').not.toBeNull();
  394:       expect(keyed.rows ?? [], 'an unassigned volunteer read the project row by identifier').toEqual([]);
  395:       const keyedAbsent = await sut.dataApiRead(unassigned, { table: 'projects', keyedBy: 'id', value: ABSENT_ID });
  396:       expect(keyedAbsent, 'a real foreign project and one that names nothing answered differently at the Data API').toEqual(keyed);
  397: 
  398:       // (5) AND THE PUBLIC PAGE STAYS VISIBLE â€” to that same refused volunteer AND to a caller with
  399:       // no session at all. The second half is what makes it PUBLIC rather than merely wider.
  400:       const toVolunteer = await sut.publicProjectPage(project.id, unassigned);
  401:       expect(toVolunteer.ok, 'the public project page was hidden from the volunteer the workspace refused').toBe(true);
  402:       if (!toVolunteer.ok) return;
  403:       const toAnyone = await sut.publicProjectPage(project.id, null);
  404:       expect(toAnyone.ok, 'the public project page was hidden from a caller holding no session').toBe(true);
  405:       if (!toAnyone.ok) return;
  406:       expect(toAnyone, 'the public page answered a signed-in caller and an anonymous one differently').toEqual(toVolunteer);
  407: 
  408:       // (6) AND THE PUBLIC PROJECTION CARRIES NEITHER FIELD THE WORKSPACE HOLDS, each named rather
  409:       // than counted: a field count passes while the WRONG field is present. `organizationId` is an
  410:       // internal identifier a stranger has no use for; `assignedVolunteerId` names a person.
  411:       const publicFields = Object.keys(toAnyone.value);
  412:       expect(publicFields, 'the public project page leaks the owning organisation identifier').not.toContain('organizationId');
  413:       expect(publicFields, 'the public project page names the assigned developer').not.toContain('assignedVolunteerId');
  414:       expect(toAnyone.value, 'the public projection is not the three fields the shipped module builds').toEqual({
  415:         projectId: project.id,
  416:         projectName: PROJECT_NAME,
  417:         organizationName: ORGANIZATION_NAME,
  418:       });
  419: 
  420:       // (7) AND THE NO-ORACLE PROPERTY SURVIVES A DATABASE FAULT â€” gate-1 ruling 4's PROOF rather
  421:       // than its assertion, and the loop tier's own arm. `_live.ts` does not back `failNextReadOf`,
  422:       // so there is no fault injection at the integration tier and an integration body reaching for
  423:       // it would refuse by name.
  424:       //
  425:       // WHY IT MATTERS. With a lookup issued AFTER the target read, a fault reachable only on the
  426:       // existing-row path would answer 502 for a real foreign project while an identifier that names
  427:       // nothing had already answered 404 â€” an existence oracle sitting outside `TENANT_NOT_FOUND`.
  428:       // The surface issues every decision read BEFORE the target read and nothing after it, so both
  429:       // answer the same 502. The fault is ONE-SHOT, so each call arms its own.
  430:       for (const store of ['accounts', 'projects'] as const) {
  431:         await sut.failNextReadOf(store);
  432:         const faultedForeign = await sut.projectWorkspace(unassigned, project.id);
  433:         await sut.failNextReadOf(store);
  434:         const faultedAbsent = await sut.projectWorkspace(unassigned, ABSENT_ID);
  435:         expect(faultedForeign.ok, `a faulted ${store} read answered with a projection`).toBe(false);
  436:         expect(faultedForeign.status, `a faulted ${store} read did not answer as an outage`).toBe(502);
  437:         expect(
  438:           faultedAbsent,
  439:           `under a fault on ${store} a real foreign project and one that names nothing answered differently`,
  440:         ).toEqual(faultedForeign);
  441:       }
  442:     },
  443:     integration: at00122,
  444:   },
  445: );
