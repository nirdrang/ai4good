  // caller that sees "unknown account type platform_admin" learns the wrong thing: the type is not
  // unknown, it is not available here.
  if (candidate === 'platform_admin') {
    return refuse(
      'platform_admin is not available through public signup â€” a platform administrator is provisioned, never self-signed-up',
    );
  }
  return refuse(
    `unknown account type ${JSON.stringify(candidate)} â€” public signup offers ${PUBLIC_SIGNUP_ACCOUNT_TYPES.join(', ')}`,
