  202:     for (const viewer of [null, undefined, 42, 'ngo', true, [], {}, { accountTypes: 'ngo' }]) {
  203:       for (const scope of ['organization', 'project'] as const) {
  204:         expect(
  205:           call(viewer, scope).ok,
  206:           `a viewer of ${JSON.stringify(viewer)} must read nothing on the ${scope} scope, and must not throw`,
  207:         ).toBe(false);
  208:       }
  209:     }
  210:   });
