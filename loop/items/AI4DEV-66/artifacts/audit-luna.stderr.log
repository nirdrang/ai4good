--- tests/at/harness/shipped-route-visibility.selftest.ts
    1: /**
    2:  * THE ORACLE FOR THE SHIPPED ROUTE REGISTRY'S RULE.
    3:  *
    4:  * `supabase/functions/_shared/route-visibility.ts` declares every route under `src/routes/` public or
    5:  * authenticated, and `undeclaredRoutes` is the rule that says which route files carry no
    6:  * declaration. AT-001.24's loop body asserts that the answer over the REAL tree is empty â€” which is a
    7:  * true statement about today's tree and proves nothing at all about the rule, because today's tree
    8:  * holds one route and it is declared.
    9:  *
   10:  * THIS FILE IS WHAT EXERCISES THE FAILURE CASE. The plan's step 15 requires that the arm "fails when
   11:  * handed a synthetic file list holding an undeclared route", and that it is exercised rather than
   12:  * asserted. A list holding a route nobody declared is a state no checkout of this repository is in,
   13:  * so the only way to reach it is to drive the pure rule directly â€” which is possible only because the
   14:  * rule ships beside the declaration instead of living inside the acceptance body that consumes it.
   15:  *
   16:  * WHY A SHIPPED MODULE'S SHAPE TEST RIDES THE SELFTEST LANE, the same reason
   17:  * `shipped-visibility.selftest.ts`, `shipped-caller.selftest.ts` and `shipped-verification.selftest.ts`
   18:  * give: an acceptance body drives an application boundary, and a direct call to a helper from one
   19:  * would be a test of the helper wearing a criterion's name.
   20:  *
   21:  * IT NEEDS NO SCRIPT OR CONTINUOUS-INTEGRATION CHANGE: `tests/at/vitest.config.ts` includes
   22:  * `harness/**\/*.selftest.ts` and the `at:selftest` script filters to `harness/`, so this file is
   23:  * discovered by glob and never joins an acceptance run. It cannot affect any acceptance id's colour.
   24:  *
   25:  * WHAT A GREEN HERE CLAIMS: that the rule reports exactly the route files carrying no declaration.
   26:  * WHAT IT DOES NOT CLAIM: that any router obeys the declaration. A TanStack router DOES exist â€”
   27:  * `src/router.tsx` builds one over the generated route tree â€” and nothing in it consults
   28:  * `ROUTE_VISIBILITY`. The merge ruling carries that as a residual.
   29:  */
   30: 
   31: import { describe, expect, it } from 'vitest';
   32: 
   33: import { ROUTE_VISIBILITY, undeclaredRoutes } from '../../../supabase/functions/_shared/route-visibility.ts';
   34: 
   35: describe('the shipped route registry reports what it does not declare', () => {
   36:   it('reports a route file that carries no declaration', () => {
   37:     // THE CASE NO CHECKOUT IS IN, and the whole reason this file exists: somebody adds a screen and
   38:     // nobody classifies it. The realistic version is a design asking for a dashboard, which is an
   39:     // AUTHENTICATED surface arriving with no redirect target declared for it.
   40:     expect(
   41:       undeclaredRoutes(['index.tsx', 'dashboard.tsx']),
   42:       'a route file nobody classified must be reported, or the registry cannot fail the build',
   43:     ).toEqual(['dashboard.tsx']);
   44:     // AND A NESTED ONE, because the key is the path relative to `src/routes/` rather than a bare
   45:     // file name â€” a router derives its URL from the whole path, so two files called `index.tsx` in
   46:     // different directories are two different routes.
   47:     expect(
   48:       undeclaredRoutes(['index.tsx', 'projects/index.tsx']),
   49:       'a nested route file nobody classified must be reported under its own path',
   50:     ).toEqual(['projects/index.tsx']);
   51:     // AND SEVERAL AT ONCE, in the order they arrived, so the failure names every one rather than the
   52:     // first.
   53:     expect(
   54:       undeclaredRoutes(['sign-in.tsx', 'index.tsx', 'admin/ledger.tsx']),
   55:       'every undeclared route must be reported, not only the first',
   56:     ).toEqual(['sign-in.tsx', 'admin/ledger.tsx']);
   57:   });
   58: 
   59:   it('reports nothing for the real declared set', () => {
   60:     // The declaration read back as a list of names is, by construction, a clean answer. This is the
   61:     // shape the acceptance body asserts over the real tree, driven here without touching a disk.
   62:     expect(
   63:       undeclaredRoutes(Object.keys(ROUTE_VISIBILITY)),
   64:       'the registry does not accept its own declared routes, so the acceptance arm can never be clean',
   65:     ).toEqual([]);
   66:   });
   67: 
   68:   it('ignores a file whose base name begins with `__`, whatever directory it sits in', () => {
   69:     // THE CONVENTIONS `src/routes/README.md` DOCUMENTS: `__root.tsx` is the APP SHELL, which wraps
   70:     // every page, and `_layout.tsx` â€” ONE underscore â€” is a layout route. The rule excludes any base
   71:     // name beginning with `__`, and `src/routes/__root.tsx` is the one such file today. It must not
   72:     // need a classification, or the arm would fail on a clean checkout.
   73:     expect(
   74:       undeclaredRoutes(['__root.tsx', 'index.tsx']),
   75:       'the app shell is not a route and must not be reported',
   76:     ).toEqual([]);
   77:     // AND THE EXCLUSION READS THE BASE NAME RATHER THAN THE WHOLE PATH, which is the property this
   78:     // second input pins. The name is synthetic â€” no such file exists in this tree â€” so it is chosen
   79:     // to carry no convention a reader could infer from it.
   80:     expect(
   81:       undeclaredRoutes(['admin/__shell.tsx']),
   82:       'the rule reads the BASE name, so a `__`-prefixed file nested in a directory is excluded exactly as a top-level one is',
   83:     ).toEqual([]);
   84:   });
   85: 
   86:   it('ignores anything that is not a .tsx file', () => {
   87:     // `src/routes/README.md` is in that directory today, and a directory name arrives in the same
   88:     // list because the scan walks the tree. Neither is a route.
   89:     expect(
   90:       undeclaredRoutes(['README.md', 'admin', 'index.tsx', 'notes.txt', 'helper.ts']),
