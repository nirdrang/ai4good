   80:  * FOUR MINUTES, AND IT IS STILL A BOUND. It is the longer of the two waits plus about ninety seconds
   81:  * for the live round trips around it â€” a sign-up, a mail-catcher read, a confirmation, a sign-in, a
   82:  * completion and several writes. It is a raise, not a removal: a body that hangs still fails here
   83:  * rather than running until somebody notices. The raise is PER TIER, so the loop tier's 30 seconds
   84:  * are untouched.
   85:  */
   86: export const INTEGRATION_TIMEOUT_MS = 240_000;
   87: 
   88: const wait = (ms: number): Promise<void> => new Promise((resolve) => setTimeout(resolve, ms));
   89: 
   90: /* ------------------------------------------------------------------ the real client, for AT-001.13 */
   91: 
   92: /**
   93:  * EXACTLY THE CLIENT SURFACE AT-001.13 DEPENDS ON, declared here rather than imported.
   94:  *
   95:  * `@supabase/supabase-js` is a real runtime dependency of that body â€” the criterion is about a
   96:  * client refreshing itself, and this repository ships none â€” but its type declarations describe a
   97:  * BROWSER: they reach for `Window`, `CloseEvent`, `PublicKeyCredential` and a dozen other DOM names.
   98:  * `tests/at/tsconfig.json` deliberately holds `lib: ["ES2022"]` with no DOM, and equally
   99:  * deliberately keeps `skipLibCheck` FALSE â€” its own comment says why, and neither is a knob this
  100:  * suite may turn to make one test body compile.
  101:  *
  102:  * So the module is loaded through a NON-LITERAL specifier, which TypeScript cannot resolve and
  103:  * therefore does not type-check, and the surface this body uses is written out below. That is not a
  104:  * way round the type system: it is a narrower claim than importing the whole library would make,
  105:  * and it is checked at run time by the code failing loudly if the shape is wrong. The same pattern
  106:  * is what `index.ts` uses to load a suite's adapter.
  107:  */
  108: type RealClient = {
  109:   auth: {
  110:     signInWithPassword(credentials: { email: string; password: string }): Promise<{
  111:       data: { session: { access_token: string } | null };
  112:       error: unknown;
  113:     }>;
  114:     getSession(): Promise<{ data: { session: { access_token: string } | null } }>;
  115:     getUser(): Promise<{ data: { user: { id: string } | null } }>;
  116:     stopAutoRefresh(): Promise<void>;
  117:   };
  118: };
  119: 
  120: async function realClient(url: string, anonKey: string): Promise<RealClient> {
  121:   const specifier = '@supabase/supabase-js';
  122:   const module = (await import(/* @vite-ignore */ specifier)) as {
  123:     createClient?: (url: string, key: string, opts: unknown) => RealClient;
  124:   };
  125:   if (typeof module.createClient !== 'function') {
  126:     throw new Error(`${specifier} exports no createClient() â€” AT-001.13's whole claim is about a real client`);
  127:   }
  128:   return module.createClient(url, anonKey, {
  129:     auth: { autoRefreshToken: true, persistSession: false, detectSessionInUrl: false },
  130:   });
  131: }
  132: 
  133: /**
  134:  * Register, confirm through the emailed link, and sign in â€” the live public order, as one step.
  135:  *
  136:  * IT ASSERTS AS IT GOES, because a helper that swallowed a failure would report the wrong cause for
  137:  * the right red: "no session" three assertions later, rather than "no confirmation email arrived".
  138:  */
  139: async function registerConfirmAndSignIn(
  140:   sut: Awaited<ReturnType<Ctx['open']>>['sut'],
  141:   email: string,
  142:   password = PASSWORD,
  143: ): Promise<Session> {
  144:   const registered = await sut.registerWithEmailPassword(email, password);
  145:   expect(registered.sessionId, 'the live registration issued a session, which under confirmations it must not').toBe('');
  146: 
  147:   const link = await sut.emailedVerificationLink(email);
  148:   expect(link, `no confirmation email reached the slot's mail catcher for ${email}`).not.toBeNull();
  149:   const used = await sut.useVerificationLink(link!);
  150:   expect(used.ok, 'following the emailed confirmation link was refused').toBe(true);
  151: 
  152:   const signedIn = await sut.signInWithEmailPassword(email, password);
  153:   expect(signedIn, `sign-in after confirmation failed for ${email}`).toMatchObject({ ok: true });
  154:   if (!signedIn.ok) throw new Error('unreachable: the assertion above fails first');
  155:   expect(signedIn.session.accountId, 'sign-in resolved to a different account than the registration created').toBe(
  156:     registered.accountId,
  157:   );
  158:   return signedIn.session;
  159: }
  160: 
  161: /* ------------------------------------------------------------------------ the ids that go green */
  162: 
  163: /**
  164:  * AT-001.01 â€” the FULL-OUTCOME oracle, not the atomicity arm alone.
  165:  *
  166:  * The criterion names five outcomes and a later sign-in, and gate 1 ruled that a green here has to
  167:  * prove all of them: an account of type NGO, an org, an admin membership in it, an acknowledgment
  168:  * carrying timestamp, IP and text version, the pre-project gate discriminating, and a return
  169:  * sign-in. Atomicity is the NEGATIVE arm and is asserted last.
  170:  *
  171:  * WHAT IS LIVE HERE THAT WAS NOT AT LOOP TIER: the act is the DEPLOYED `complete-signup`, so the
  172:  * platform's own token check, `resolveCaller`, the edge function and the database's
  173:  * `complete_signup` all sit on the path; and `hasPlatformAcknowledgment` calls the SHIPPED SQL
  174:  * predicate rather than an adapter query, which is the one thing the loop tier's own fixture says
  175:  * its green cannot establish.
  176:  */
  177: export async function at00101(ctx: Ctx): Promise<void> {
  178:   const { w, sut } = await ctx.open();
  179:   const email = w.email('ngo-signup');
  180:   const session = await registerConfirmAndSignIn(sut, email);
  181: 
  182:   expect(
  183:     await sut.hasPlatformAcknowledgment(session.accountId),
  184:     'a user who has authenticated but not completed signup must NOT hold the platform acknowledgment',
  185:   ).toBe(false);
  186: 
  187:   const completion = await sut.completeSignup(
  188:     session,
  189:     { accountType: 'ngo', organizationName: 'Riverside Shelter', acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
  190:     CLIENT_IP,
  191:   );
  192:   expect(completion, 'the deployed complete-signup refused the NGO completion').toMatchObject({ ok: true });
  193:   if (!completion.ok) return;
  194:   expect(completion.organizationId, 'an NGO completion produced no organisation').not.toBeNull();
  195: 
  196:   expect(await sut.account(completion.accountId)).toEqual({ id: session.accountId, accountType: 'ngo' });
  197:   expect(await sut.organization(completion.organizationId!)).toMatchObject({ name: 'Riverside Shelter' });
  198:   expect(await sut.membership(completion.organizationId!, completion.accountId)).toEqual({
  199:     organizationId: completion.organizationId,
  200:     accountId: completion.accountId,
  201:     role: 'admin',
  202:   });
  203: 
  204:   const acknowledgments = await sut.acknowledgments(completion.accountId);
  205:   expect(acknowledgments, 'exactly one platform acknowledgment is recorded by one completion').toHaveLength(1);
  206:   expect(acknowledgments[0].textVersion, 'the acknowledgment must say WHICH text was accepted').toBe(TEXT_VERSION);
  207:   // The address the gateway chain REPORTED, never a verified source address â€” the header travels
  208:   // through kong and the edge runtime and must arrive in the row intact.
  209:   expect(acknowledgments[0].ip, 'the reported address did not reach the acknowledgment row').toContain(CLIENT_IP);
  210:   expect(
  211:     Number.isFinite(Date.parse(acknowledgments[0].acknowledgedAt)),
  212:     `the acknowledgment timestamp ${JSON.stringify(acknowledgments[0].acknowledgedAt)} is not a readable instant`,
  213:   ).toBe(true);
  214: 
  215:   expect(
  216:     await sut.hasPlatformAcknowledgment(completion.accountId),
  217:     'the SHIPPED has_platform_acknowledgment does not hold once signup has completed',
  218:   ).toBe(true);
  219: 
  220:   const returning = await sut.signInWithEmailPassword(email, PASSWORD);
  221:   expect(returning, 'the same credentials did not sign in again').toMatchObject({ ok: true });
  222:   if (!returning.ok) return;
  223:   expect(returning.session.accountId).toBe(session.accountId);
  224: 
  225:   /*
  226:    * THE NEGATIVE ARM, AND EXACTLY WHAT IT PROVES â€” narrowed by gate-2 ruling S2-3, which asked
  227:    * whether it proves more than this and had the question measured rather than argued.
  228:    *
  229:    * WHAT IT PROVES: the DEPLOYED completion path refuses a completion that carries no
  230:    * acknowledgment, states the acknowledgment as the reason, and leaves NO account row and NO
  231:    * acknowledgment behind. That is the criterion's clause â€” the acknowledgment is required â€” proved
  232:    * against the deployed function rather than against a fixture.
  233:    *
  234:    * WHAT IT DOES NOT PROVE, said plainly because an earlier version of this comment implied it: it
  235:    * is NOT a demonstration of mid-transaction rollback. The refusal here comes from
  236:    * `validateCompleteSignup` BEFORE the database is called, so "zero rows left" is true because
  237:    * nothing was ever written, not because something was written and undone.
  238:    *
  239:    * AND THAT IS NOT A GAP LEFT UNEXAMINED. `verify-first.md` Part C records the inspection: the only
  240:    * write inside `public.complete_signup` that can fail after an earlier one has succeeded is the
  241:    * acknowledgment insert, whose lever is an empty `text_version` â€” and JavaScript's `trim()` strips
  242:    * a superset of what Postgres's `btrim()` strips, so every value the constraint would refuse the
  243:    * validator refuses first. Measured on both instruments; the intersection is empty by
  244:    * construction. In-transaction rollback is therefore NOT externally drivable on the deployed
  245:    * surface, and no fault-injection seam was added to shipped code to manufacture one. The green
  246:    * rests on the full-outcome positive oracle above plus this refusal.
  247:    */
  248:   const other = await registerConfirmAndSignIn(sut, w.email('no-acknowledgment'));
  249:   const refused = await sut.completeSignup(other, { accountType: 'ngo', organizationName: 'Riverside Shelter Annexe' }, CLIENT_IP);
  250:   expect(refused.ok, 'signup completed with no acknowledgment of the ToS and Platform Promise').toBe(false);
  251:   if (refused.ok) return;
  252:   expect(refused.reason, 'the refusal does not say the acknowledgment is what is missing').toMatch(/acknowledgment/i);
  253:   expect(await sut.account(other.accountId), 'the refused completion left an account row behind').toBeNull();
  254:   expect(
  255:     await sut.hasPlatformAcknowledgment(other.accountId),
  256:     'the refused completion recorded an acknowledgment anyway',
  257:   ).toBe(false);
  258: }
