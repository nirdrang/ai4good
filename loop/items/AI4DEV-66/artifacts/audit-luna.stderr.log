  260: /**
  261:  * AT-001.06 â€” a volunteer is refused the NGO-only action while an NGO performs it.
  262:  *
  263:  * THE CONTROL IS NOT OPTIONAL: an operation that refuses everybody would satisfy the negative half
  264:  * on its own, so the NGO succeeds FIRST and the volunteer's refusal is then attributable to the
  265:  * account type.
  266:  *
  267:  * THE LINKED IDENTITY IS A GIVEN HERE, and it is written by the operator. Since the GitHub leaf a
  268:  * volunteer cannot complete signup without one; the refusal under test is the NGO-only one, so the
  269:  * volunteer has to reach the state of being a signed-up volunteer first. AT-001.04 owns the link
  270:  * rule and is declared red at this tier for exactly the reason that rule cannot be proved live.
  271:  */
  272: export async function at00106(ctx: Ctx): Promise<void> {
  273:   const { w, sut } = await ctx.open();
  274: 
  275:   const ngo = await registerConfirmAndSignIn(sut, w.email('ngo-actor'));
  276:   const ngoCompletion = await sut.completeSignup(
  277:     ngo,
  278:     { accountType: 'ngo', organizationName: 'Riverside Shelter', acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
  279:     CLIENT_IP,
  280:   );
  281:   expect(ngoCompletion, 'the NGO control could not complete signup').toMatchObject({ ok: true });
  282:   if (!ngoCompletion.ok) return;
  283: 
  284:   const ngoAction = await sut.createOrganization(ngo, 'Riverside Shelter Second Programme');
  285:   expect(ngoAction, 'the NGO control was refused the NGO-only action, so the refusal below proves nothing').toMatchObject({
  286:     ok: true,
  287:   });
  288:   if (!ngoAction.ok) return;
  289:   expect(await sut.organization(ngoAction.organizationId)).toMatchObject({ name: 'Riverside Shelter Second Programme' });
  290:   expect(await sut.membership(ngoAction.organizationId, ngoCompletion.accountId)).toMatchObject({ role: 'admin' });
  291: 
  292:   const volunteer = await registerConfirmAndSignIn(sut, w.email('volunteer-actor'));
  293:   await sut.linkGithubIdentity(volunteer, 'volunteer-actor-handle');
  294:   const volunteerCompletion = await sut.completeSignup(
  295:     volunteer,
  296:     { accountType: 'volunteer', acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
  297:     CLIENT_IP,
  298:   );
  299:   expect(volunteerCompletion, 'the volunteer could not complete signup, so the refusal below is not the one under test').toMatchObject(
  300:     { ok: true },
  300:     { ok: true },
  301:   );
  302:   if (!volunteerCompletion.ok) return;
  303: 
  304:   const REFUSED_NAME = 'Riverside Shelter Copy';
  305:   const volunteerAction = await sut.createOrganization(volunteer, REFUSED_NAME);
  306:   expect(volunteerAction.ok, 'a volunteer account performed an NGO-only action').toBe(false);
  307:   if (volunteerAction.ok) return;
  308: 
  309:   // A REJECTION INCLUDES ITS WRITES NOT HAPPENING, and on the live stack that is row-level truth
  310:   // rather than a mirror: no organisation by the attempted name, and no membership anywhere.
  311:   expect(await sut.organizationsNamed(REFUSED_NAME), `the refused action created an organisation named ${REFUSED_NAME}`).toEqual([]);
  312:   expect(await sut.membershipsOf(volunteerCompletion.accountId), 'the refused action left the volunteer holding a membership').toEqual(
  313:     [],
  314:   );
  315:   expect(volunteerAction.reason).toMatch(/NGO accounts only/i);
  316:   expect(volunteerAction.reason).toMatch(/volunteer/i);
  317: }
