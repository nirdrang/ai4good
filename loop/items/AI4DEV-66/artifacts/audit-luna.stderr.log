  678:     /**
  679:      * THE VERIFIED FACT, DERIVED BY THE SHIPPED EXTRACTOR â€” never read as a boolean off a column.
  680:      *
  681:      * The row is read with operator authority and rendered as the canonical `/auth/v1/user` shape,
  682:      * and the SHIPPED `emailVerifiedFromUser` judges it. That is the same pattern the loop fixture
  683:      * uses and it exists for the same reason: the extractor the future Discovery route will call
  684:      * sits on the tested path rather than being a function no test ever runs. AI4DEV-59's proof is
  685:      * what binds the RENDERED shape to the real one â€” it fed a real response to the same function.
  686:      */
  687:     emailVerified: async (accountId) => {
  688:       const found = await rows<{ email_confirmed_at: string | Date | null; email: string }>(
  689:         sql`select email, email_confirmed_at from auth.users where id = ${accountId}::uuid`,
  690:       );
  691:       if (found.length !== 1) return false;
  692:       // THE ROW IS RENDERED AS GoTrue RENDERS IT, and the rendering is the load-bearing part rather
  693:       // than a formality. The driver hands back a `timestamptz` as a Date OBJECT, and the shipped
  694:       // extractor's only verified answer is a non-blank STRING â€” deliberately, because it judges a
  695:       // JSON body that crossed a network. Handing it the Date made `emailVerified` answer false for
  696:       // a confirmed account, so AT-001.09 reported "using the emailed link did not flip the account
