  212:   it('carries a reason on every refusal, so no refusal is a bare false', () => {
  213:     // The refusal reason NEVER travels to the caller â€” `TENANT_NOT_FOUND` is what travels â€” but it is
  214:     // what a reader of the decision gets, and a refusal with an empty reason would be the same defect
  215:     // as a bare status.
  216:     for (const [viewer, scope] of [
  217:       [{ accountType: 'nonsense', roleInTargetOrganization: null, assignedVolunteerOfTargetProject: false }, 'organization'],
  218:       [{ accountType: 'ngo', roleInTargetOrganization: null, assignedVolunteerOfTargetProject: false }, 'organization'],
  219:       [{ accountType: 'volunteer', roleInTargetOrganization: null, assignedVolunteerOfTargetProject: false }, 'project'],
  220:       [{ accountType: 'volunteer', roleInTargetOrganization: null, assignedVolunteerOfTargetProject: true }, 'nonsense'],
  221:     ] as const) {
  222:       const decision = call(viewer, scope);
  223:       expect(decision.ok, `${JSON.stringify(viewer)} on ${String(scope)} must be refused`).toBe(false);
  224:       expect(
  225:         decision.ok ? '' : decision.reason.trim(),
  226:         `the refusal for ${JSON.stringify(viewer)} on ${String(scope)} carries no sentence a reader can act on`,
  227:       ).not.toBe('');
  228:     }
  229:   });
  230: });
--- tests/at/harness/shipped-catalog-conformance.selftest.ts
    1: /**
    2:  * THE ORACLE FOR THE CATALOG CONFORMANCE RULE.
    3:  *
    4:  * `tests/at/suites/req-001/_catalog-conformance.ts` is what makes this leaf's isolation claim
    5:  * self-correcting: it fails when a table exists in `public` and nobody has classified it, when a
    6:  * table declared unreachable is reachable, and when a table declared isolated carries a policy that
    7:  * admits every row. AT-001.21's integration body asserts that its answer over the LIVE catalog is
    8:  * empty â€” which, on a correct database, proves the rule found no problem and says nothing at all
    9:  * about whether the rule can find one.
   10:  *
   11:  * THIS FILE IS WHAT EXERCISES EVERY FAILURE CASE. Each one is a state no database of this repository
   12:  * is in, and none of them is reachable by running the acceptance suite: reaching them needs a catalog
   13:  * that was constructed rather than read, which is exactly what a pure rule taking its witness as an
   14:  * argument allows.
   15:  *
   16:  * ONE CASE NEEDS THE DECLARATION HANDED IN TOO, and that is why the module exports the rule twice.
   17:  * Clause 1 fails a table declared in BOTH lists; the declaration this tree makes has no overlap and
   18:  * must never gain one, so no catalog argument alone can reach that branch.
   19:  * `catalogProblemsAgainst(catalog, declaration)` is the same rule with the declaration as a
   20:  * parameter, and `catalogConformanceProblems(catalog)` is the entry point the acceptance body calls
   21:  * with this tree's own declaration fixed.
   22:  *
   23:  * WHAT A GREEN HERE CLAIMS: that the rule reports each of the three kinds of disagreement, and
   24:  * reports none against a catalog shaped the way the migrations leave one. WHAT IT DOES NOT CLAIM:
   25:  * that a real database is shaped that way. The catalog in the last case below is a PREDICTION of the
   26:  * two migrations, written by hand; the integration tier is the only thing that grades it, and it has
   27:  * not run at any head of this branch.
   28:  */
   29: 
   30: import { describe, expect, it } from 'vitest';
   31: 
   32: import {
   33:   DECLARED_CATALOG,
   34:   catalogConformanceProblems,
   35:   catalogProblemsAgainst,
   36: } from '../suites/req-001/_catalog-conformance.ts';
   37: import type { CatalogTable } from '../suites/req-001/_contract.ts';
   38: 
   39: /** One catalog row, with the shape a clean unclassified table has, so each case states only its own point. */
   40: const table = (name: string, over: Partial<CatalogTable> = {}): CatalogTable => ({
   41:   table: name,
   42:   selectGrantedTo: [],
   43:   rowLevelSecurity: true,
   44:   selectPolicies: [],
   45:   ...over,
   46: });
   47: 
   48: /** The `(select auth.uid())` a policy carries, deparsed the way `pg_policies.qual` renders it. */
   49: const OWN_UID = '( SELECT auth.uid() AS uid)';
   50: 
   51: /**
   52:  * THE CATALOG THE TWO MIGRATIONS LEAVE, as this suite predicts it.
   53:  *
   54:  * `20260812120000_tenant_isolation_policy_set.sql` grants `select` on the four tenant tables to
   55:  * `authenticated` and creates one organisation-member policy on each;
   56:  * `20260813120000_tenant_visibility_volunteer_and_admin.sql` adds the assigned-volunteer policy on
   57:  * `projects` and one platform-admin policy on each of the four. `accounts` keeps its first-migration
   58:  * grant with no policy at all, and `volunteer_profiles` keeps its `revoke all`.
   59:  */
   60: const REAL_SHAPED_CATALOG: CatalogTable[] = [
   61:   // Granted to `authenticated` AND unreachable, because row-level security is on and it has no
   62:   // policy. This is the table that would have failed a grants-only check.
   63:   table('accounts', { selectGrantedTo: ['authenticated'] }),
   64:   // Unreachable the other way: `revoke all` leaves no grant to revoke a policy against.
   65:   table('volunteer_profiles'),
   66:   table('organizations', {
   67:     selectGrantedTo: ['authenticated'],
   68:     selectPolicies: [
   69:       { name: 'organizations_select_org_member', roles: ['authenticated'], qual: 'viewer_is_org_member(id)' },
   70:       { name: 'organizations_select_platform_admin', roles: ['authenticated'], qual: 'viewer_is_platform_admin()' },
   71:     ],
   72:   }),
   73:   table('org_memberships', {
   74:     selectGrantedTo: ['authenticated'],
   75:     selectPolicies: [
   76:       { name: 'org_memberships_select_org_member', roles: ['authenticated'], qual: 'viewer_is_org_member(org_id)' },
   77:       { name: 'org_memberships_select_platform_admin', roles: ['authenticated'], qual: 'viewer_is_platform_admin()' },
   78:     ],
   79:   }),
   80:   table('acknowledgments', {
   81:     selectGrantedTo: ['authenticated'],
   82:     selectPolicies: [
   83:       { name: 'acknowledgments_select_own_account', roles: ['authenticated'], qual: `(account_id = ${OWN_UID})` },
   84:       { name: 'acknowledgments_select_platform_admin', roles: ['authenticated'], qual: 'viewer_is_platform_admin()' },
   85:     ],
   86:   }),
   87:   table('projects', {
   88:     selectGrantedTo: ['authenticated'],
   89:     selectPolicies: [
   90:       { name: 'projects_select_org_member', roles: ['authenticated'], qual: 'viewer_is_org_member(org_id)' },
   91:       {
   92:         name: 'projects_select_assigned_volunteer',
