  365:   let text: string;
  366:   try {
  367:     text = await request.text();
  368:   } catch {
  369:     return { ok: false, reason: 'the request body could not be read' };
  370:   }
  371:   if (text.trim() === '') return { ok: true, value: {} };
  372:   try {
  373:     const parsed = JSON.parse(text) as unknown;
  374:     if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) {
  375:       return { ok: false, reason: 'the request body must be a JSON object' };
  376:     }
  377:     return { ok: true, value: parsed as Record<string, unknown> };
  378:   } catch {
  379:     return { ok: false, reason: 'the request body is not valid JSON' };
  380:   }
  381: }
