 108:         sessionA,
 109:         { accountType: 'ngo', organizationName: NAME_A, acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
 110:         CLIENT_IP,
 111:       );
 112:       expect(a, 'NGO A could not complete signup, so there is no tenant for B to be denied').toMatchObject({ ok: true });
 113:       // THE `expect` ABOVE THROWS ON `ok: false`, SO THE NARROWING RETURN BELOW IS REACHED ONLY BY A
 114:       // COMPLETION THAT SUCCEEDED WITH NO ORGANISATION â€” and on that path the body used to return as
 115:       // a PASS with zero arms run (gate-2 ruling 4). The assertion is what closes that seam; the
 116:       // return stays exactly as it is and becomes what it was always meant to be, a TypeScript
 117:       // narrowing device no run reaches.
 118:       expect(
 119:         a.ok ? a.organizationId : null,
 120:         'NGO A completed signup with no organisation, so there is no tenant for B to be denied and this id would go green with every arm below skipped',
 121:       ).not.toBeNull();
 122:       if (!a.ok || a.organizationId === null) return;
 123: 
 124:       const sessionB = await sut.registerWithEmailPassword(w.email('ngo-b-21'), PASSWORD);
 125:       const b = await sut.completeSignup(
 126:         sessionB,
 127:         { accountType: 'ngo', organizationName: NAME_B, acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
 128:         CLIENT_IP,
 129:       );
 130:       expect(b, 'NGO B could not complete signup, so there is no second tenant to do the probing').toMatchObject({ ok: true });
 131:       expect(
 132:         b.ok ? b.organizationId : null,
 133:         'NGO B completed signup with no organisation, so its own unfiltered listing has nothing to hold and every probe below would be skipped',
 134:       ).not.toBeNull();
 135:       if (!b.ok || b.organizationId === null) return;
 136: 
 137:       // A PROJECT IN A, so `public.projects` holds a row that belongs to A. The operator provisions
 138:       // it because no product path creates a project at either tier.
 139:       const project = await sut.createProjectAsOperator(a.organizationId, 'Riverside Shelter Website 21');
 140: 
 141:       // A'S ROWS REALLY EXIST, read back with operator authority. Without this the empty Data API
 142:       // answers below would be indistinguishable from four empty tables, and every denial would be
 143:       // measuring the tree's emptiness instead of the policy set.
 144:       expect(await sut.membership(a.organizationId, a.accountId), 'A holds no seat in its own organisation').toMatchObject({
 145:         role: 'admin',
 146:       });
 147:       expect(await sut.projectAssignment(project.id), 'A\'s project is not there').toMatchObject({
 148:         organizationId: a.organizationId,
 149:       });
 150:       expect((await sut.acknowledgments(a.accountId)).length, 'A\'s completion recorded no acknowledgment').toBeGreaterThan(0);
 151: 
 152:       // (1) THE CONTROL â€” A READS ITS OWN DASHBOARD. A surface that refused everybody would satisfy
 153:       // every denial below while proving nothing at all.
 154:       const own = await sut.organizationDashboard(sessionA, a.organizationId);
 155:       expect(own.ok, 'A was refused its OWN dashboard, so the refusals below are not about the tenant boundary').toBe(true);
 156:       if (!own.ok) return;
 157:       expect(own.status, 'A\'s own dashboard did not answer 200').toBe(200);
 158:       expect(own.value.organizationId, 'A\'s dashboard names a different organisation').toBe(a.organizationId);
 159:       expect(own.value.seat, 'A\'s dashboard does not show A\'s own seat').toMatchObject({ accountId: a.accountId, role: 'admin' });
 160:       expect(
 161:         own.value.projects.map((row) => row.projectId),
 162:         'A\'s dashboard does not show A\'s project, so the projection carries no tenant data to leak',
 163:       ).toEqual([project.id]);
 164: 
 165:       // (2) B IS REFUSED A'S DASHBOARD.
 166:       const foreign = await sut.organizationDashboard(sessionB, a.organizationId);
 167:       expect(foreign.ok, 'NGO B read NGO A\'s dashboard').toBe(false);
 168:       if (foreign.ok) return;
 169: 
 170:       // (3) AND THE SAME CALLER PROBING AN IDENTIFIER THAT NAMES NOTHING RECEIVES THE IDENTICAL
 171:       // ANSWER. This is the no-existence-oracle clause, and it is an EQUALITY rather than two
 172:       // refusals: two answers that both said no while differing in status, or in one field, would
 173:       // still tell B which organisation identifiers are real.
 174:       const absent = await sut.organizationDashboard(sessionB, ABSENT_ID);
 175:       expect(absent.ok, 'an organisation that does not exist answered with a projection').toBe(false);
 176:       if (absent.ok) return;
 177:       expect(absent.status, 'the two refusals carry different statuses, which tells B which identifier is real').toBe(foreign.status);
 178:       // AT THE LOOP TIER THERE ARE NO BYTES, so the comparison is deep equality of the whole returned
 179:       // value. The integration body compares the RAW response text instead â€” gate-1 ruling 5 â€” and
 180:       // neither comparison ever crosses the two tiers.
 181:       expect(absent, 'the refusal for a real foreign organisation differs from the refusal for one that does not exist').toEqual(
 182:         foreign,
 183:       );
 184: 
 185:       // (4) THE SAME PAIR THROUGH THE DATA API, on every table that holds tenant data. This is the
 186:       // criterion's "direct API/ID probing": the caller's own access token, PostgREST and the policy
 187:       // set, not the edge surface wearing another name. A denied keyed read answers `[]`, which is
 188:       // byte for byte what a row that does not exist answers â€” so the no-oracle property is free
 189:       // here, and the pair is asserted anyway because "free" is a claim about today's mechanism.
 190:       const probes = [
 191:         { table: 'organizations' as const, keyedBy: 'id' as const, real: a.organizationId },
 192:         { table: 'org_memberships' as const, keyedBy: 'org_id' as const, real: a.organizationId },
 193:         { table: 'projects' as const, keyedBy: 'org_id' as const, real: a.organizationId },
 194:         { table: 'acknowledgments' as const, keyedBy: 'account_id' as const, real: a.accountId },
 195:       ];
 196:       for (const probe of probes) {
 197:         const keyed = await sut.dataApiRead(sessionB, { table: probe.table, keyedBy: probe.keyedBy, value: probe.real });
 198:         expect(keyed.rows, `B's keyed probe of ${probe.table} was refused before any row was considered`).not.toBeNull();
 199:         expect(keyed.rows ?? [], `B read A's rows out of ${probe.table} by identifier`).toEqual([]);
 200: 
 201:         const nothing = await sut.dataApiRead(sessionB, { table: probe.table, keyedBy: probe.keyedBy, value: ABSENT_ID });
 202:         expect(nothing, `on ${probe.table} a real foreign identifier and one that names nothing answered differently`).toEqual(keyed);
 203:       }
 204: 
 205:       // (5) THE POSITIVE CONTROL AT THE DATA API, and it is what settles that a policy ran at all
 206:       // (gate-1 ruling 9). Without it an empty array from a denied read could be a gateway refusal
 207:       // or a missing table privilege wearing the policy's clothes.
 208:       //
 209:       // IT COVERS ALL FOUR TABLES, not the one it used to (gate-2 ruling 3). Arm (4) above asserts a
 210:       // DENIAL on each of the four, and a `using (false)` policy â€” or one keyed on the wrong column â€”
 211:       // answers `[]` to A and to B alike, so three of those four denials had nothing standing behind
 212:       // them: every assertion in this body passed while the rightful tenant could read nothing
 213:       // either. Each table below is read by its OWN owner, keyed the way arm (4) keys it.
 214:       const ownRow = await sut.dataApiRead(sessionA, { table: 'organizations', keyedBy: 'id', value: a.organizationId });
 215:       expect(ownRow.rows, 'A\'s own keyed read was refused before any row was considered').not.toBeNull();
 216:       expect(ownRow.rows ?? [], 'A\'s own keyed read did not return exactly one row').toHaveLength(1);
 217:       expect((ownRow.rows ?? [])[0], 'A\'s own keyed read returned a different organisation').toMatchObject({ id: a.organizationId });
 218: 
 219:       // AND "AT LEAST ONE ROW, AND EVERY ROW IS A'S" ON THE OTHER THREE, rather than an exact count.
 220:       // The reason is measured rather than stylistic: the integration database is shared by the whole
 221:       // run â€” the twin of this body says so at its unfiltered listing â€” and one completion records
 222:       // more than one kind of acknowledgment. An exact count would be a brittle assertion about the
 223:       // suite instead of a statement about the policy.
 224:       const ownSeats = await sut.dataApiRead(sessionA, { table: 'org_memberships', keyedBy: 'org_id', value: a.organizationId });
 225:       expect(ownSeats.rows, 'A\'s own keyed read of org_memberships was refused before any row was considered').not.toBeNull();
 226:       expect((ownSeats.rows ?? []).length, 'A cannot read the seats of its OWN organisation, so that denial proves nothing').toBeGreaterThan(0);
 227:       expect(
 228:         (ownSeats.rows ?? []).map((row) => String(row.org_id)),
 229:         'A\'s keyed read of org_memberships returned a seat in another organisation',
 230:       ).toEqual((ownSeats.rows ?? []).map(() => a.organizationId));
 231: 
 232:       const ownProjects = await sut.dataApiRead(sessionA, { table: 'projects', keyedBy: 'org_id', value: a.organizationId });
 233:       expect(ownProjects.rows, 'A\'s own keyed read of projects was refused before any row was considered').not.toBeNull();
 234:       expect((ownProjects.rows ?? []).length, 'A cannot read the projects of its OWN organisation, so that denial proves nothing').toBeGreaterThan(0);
 235:       expect(
 236:         (ownProjects.rows ?? []).map((row) => String(row.org_id)),
 237:         'A\'s keyed read of projects returned a project of another organisation',
 238:       ).toEqual((ownProjects.rows ?? []).map(() => a.organizationId));
 239:       expect(
 240:         (ownProjects.rows ?? []).map((row) => String(row.id)),
 241:         'A\'s keyed read of projects does not hold the project the operator created in A',
 242:       ).toContain(project.id);
 243: 
 244:       const ownAcknowledgments = await sut.dataApiRead(sessionA, { table: 'acknowledgments', keyedBy: 'account_id', value: a.accountId });
 245:       expect(ownAcknowledgments.rows, 'A\'s own keyed read of acknowledgments was refused before any row was considered').not.toBeNull();
 246:       expect((ownAcknowledgments.rows ?? []).length, 'A cannot read its OWN acknowledgments, so that denial proves nothing').toBeGreaterThan(0);
 247:       expect(
 248:         (ownAcknowledgments.rows ?? []).map((row) => String(row.account_id)),
 249:         'A\'s keyed read of acknowledgments returned another account\'s row',
 250:       ).toEqual((ownAcknowledgments.rows ?? []).map(() => a.accountId));
 251: 
 252:       // (6) AND THE UNFILTERED LISTING, which is a DIFFERENT attack from a keyed probe: a keyed
 253:       // probe asks whether one identifier is yours, a listing asks what is there at all, and a
 254:       // policy that leaked would leak there first.
 255:       const organizations = await sut.dataApiRead(sessionB, { table: 'organizations', keyedBy: null, value: null });
 256:       expect(organizations.rows, 'B\'s unfiltered listing of organisations was refused before any row was considered').not.toBeNull();
 257:       expect(
 258:         (organizations.rows ?? []).map((row) => String(row.id)),
 259:         'B\'s unfiltered listing is not exactly its own organisation',
 260:       ).toEqual([b.organizationId]);
 261:       const projects = await sut.dataApiRead(sessionB, { table: 'projects', keyedBy: null, value: null });
 262:       expect(projects.rows, 'B\'s unfiltered listing of projects was refused before any row was considered').not.toBeNull();
 263:       expect(
 264:         (projects.rows ?? []).map((row) => String(row.id)),
 265:         'B\'s unfiltered listing shows a project B does not own',
 266:       ).toEqual([]);
 267: 
 268:       // (7) AND THE NO-ORACLE PROPERTY SURVIVES A DATABASE FAULT â€” gate-1 ruling 4's PROOF rather
 269:       // than its assertion, and the loop tier's own arm. `_live.ts` does not back `failNextReadOf`,
 270:       // so there is no fault injection at the integration tier and an integration body reaching for
 271:       // it would refuse by name rather than fault a real database.
 272:       //
 273:       // THIS IS THE SURFACE THAT MOST NEEDS THE ARM, and that is why it is here as well as on the
 274:       // project workspace. `organization-dashboard` makes FOUR reads and THREE of them precede the
 275:       // target, so it is where a lookup issued AFTER the target read would first appear. Such a
 276:       // fault is reachable only on the path where the target EXISTS: a real foreign organisation
 277:       // would answer 502 while an identifier that names nothing had already answered 404, and those
 278:       // two answers are an existence oracle sitting outside `TENANT_NOT_FOUND`. With every decision
 279:       // read issued BEFORE the target read and nothing after it, both answer the same 502 â€” by
 280:       // construction rather than by care.
 281:       //
 282:       // ALL FOUR STORES, THE TARGET'S OWN INCLUDED. A fault on `organizations` faults the target
 283:       // read itself, and that answer must be identical for both identifiers too; asserting it is
 284:       // what makes this a complete statement rather than one about the first three reads only. The
 285:       // fault is ONE-SHOT â€” it is consumed by the read it fails â€” so each call arms its own.
 286:       for (const store of ['accounts', 'memberships', 'projects', 'organizations'] as const) {
 287:         await sut.failNextReadOf(store);
 288:         const faultedForeign = await sut.organizationDashboard(sessionB, a.organizationId);
 289:         await sut.failNextReadOf(store);
 290:         const faultedAbsent = await sut.organizationDashboard(sessionB, ABSENT_ID);
 291:         expect(faultedForeign.ok, `a faulted ${store} read answered with a projection`).toBe(false);
 292:         expect(faultedForeign.status, `a faulted ${store} read did not answer as an outage`).toBe(502);
 293:         expect(
 294:           faultedAbsent,
 295:           `under a fault on ${store} a real foreign organisation and one that names nothing answered differently`,
 296:         ).toEqual(faultedForeign);
 297:       }
 298:     },
 299:     integration: at00121,
 300:   },
 301: );
