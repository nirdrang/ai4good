 512:       });
 513: 
 514:       // (2) AND THE OTHER PROJECT OF THE SAME ORGANISATION IS REFUSED â€” this is "scoped to that
 515:       // project only". The answer is the shared not-found constant, and it is compared against the
 516:       // answer for an identifier that names nothing: at this tier that is deep equality of the whole
 517:       // returned value, and the integration body compares the raw response text instead.
 518:       const other = await sut.projectWorkspace(volunteerSession, otherProject.id);
 519:       expect(other.ok, 'the volunteer read a project it holds no seat on, so the grant is not scoped to its own project').toBe(false);
 520:       if (other.ok) return;
 521:       expect(other.status, 'the refusal for another project did not answer as the shared not-found constant').toBe(404);
 522:       const absent = await sut.projectWorkspace(volunteerSession, ABSENT_ID);
 523:       expect(absent.ok, 'a project that does not exist answered with a projection').toBe(false);
 524:       if (absent.ok) return;
 525:       expect(absent, 'the refusal for a real unassigned project differs from the refusal for one that does not exist').toEqual(other);
 526: 
 527:       // (3) AND THE OWNING ORGANISATION'S DASHBOARD IS REFUSED. This is the arm that proves the scope
 528:       // is the PROJECT and not the tenant: the volunteer works inside that organisation and holds no
