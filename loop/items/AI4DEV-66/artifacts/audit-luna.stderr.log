 734: atTest(
 735:   'AT-001.24',
 736:   'a logged-out visitor renders public surfaces only; authenticated surfaces redirect to sign-in',
 737:   // THE `ui` TAG, and here it carries more weight than on AT-001.21: this criterion's OUTCOME is the
 738:   // rendering itself, which is why the integration body refuses with a capability instead of going
 739:   // green (gate-1 ruling 1). The tag is what enrols the id in a wiring leaf's `--wired` re-run for
 740:   // the day the screens land.
 741:   { surface: 'ui' },
 742:   {
 743:     default: async ({ open }) => {
 744:       const { w, sut } = await open();
 745:       const ORGANIZATION_NAME = 'Riverside Shelter 24';
 746:       const PROJECT_NAME = 'Riverside Shelter Website 24';
 747: 
 748:       // SOMETHING NON-PUBLIC TO BE REFUSED AND SOMETHING PUBLIC TO BE ANSWERED WITH. A body that
 749:       // pointed every surface at nothing would be refused for the wrong reason, and the public arm
 750:       // would have no projection to compare.
 751:       const ngo = await sut.registerWithEmailPassword(w.email('project-owner-24'), PASSWORD);
 752:       const owner = await sut.completeSignup(
 753:         ngo,
 754:         { accountType: 'ngo', organizationName: ORGANIZATION_NAME, acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
 755:         CLIENT_IP,
 756:       );
 757:       expect(owner, 'the NGO could not complete signup, so there is no organisation to be refused').toMatchObject({ ok: true });
 758:       expect(
 759:         owner.ok ? owner.organizationId : null,
 760:         'the NGO completed signup with no organisation, so the dashboard arm has no target and every arm below would be skipped',
 761:       ).not.toBeNull();
 762:       if (!owner.ok || owner.organizationId === null) return;
 763:       const project = await sut.createProjectAsOperator(owner.organizationId, PROJECT_NAME);
 764: 
 765:       // THE TWO SHAPES OF "LOGGED OUT", and this body asserts BOTH and asserts they agree. The
 766:       // criterion's visitor is the FIRST shape â€” a caller that never signed in, which is `null`. The
 767:       // second is a caller that signed out, whose token was issued and then ended. A revoked token
 768:       // must not be treated as a live one, so both are driven wherever both are expressible.
 769:       const signedOut = await sut.registerWithEmailPassword(w.email('logged-out-visitor-24'), PASSWORD);
 770:       await sut.signOut(signedOut);
 771: 
 772:       // (1) THE TWO AUTHENTICATED SURFACES REFUSE, at the session layer, before any tenant rule runs.
 773:       //
 774:       // THE RESIDUAL IS NAMED HERE RATHER THAN LEFT TO BE FOUND. Only the signed-out shape is
 775:       // expressible against these two members: both deployed blocks declare `verify_jwt = true`, so
 776:       // the gateway answers a missing token and a revoked one alike, and a member that could be
 777:       // called with no session at all would be describing a request the gateway never forwards. So
 778:       // what this arm proves is that a caller whose session has ended reads neither surface â€” and at
 779:       // this tier nothing distinguishes that refusal from the one a caller with no token receives.
 780:       const dashboard = await sut.organizationDashboard(signedOut, owner.organizationId);
 781:       expect(dashboard.ok, 'a caller whose session had ended read an organisation dashboard').toBe(false);
 782:       if (dashboard.ok) return;
 783:       expect(dashboard.status, 'the dashboard did not refuse a logged-out caller at the session layer').toBe(401);
 784: 
 785:       const workspace = await sut.projectWorkspace(signedOut, project.id);
 786:       expect(workspace.ok, 'a caller whose session had ended read a project workspace').toBe(false);
 787:       if (workspace.ok) return;
 788:       expect(workspace.status, 'the workspace did not refuse a logged-out caller at the session layer').toBe(401);
 789: 
 790:       // (2) AND THE DATA API REFUSES AT THE PRIVILEGE LAYER, on every table that holds tenant data.
 791:       // This is where BOTH shapes are expressible, so both are driven and compared: the migrations
 792:       // grant `anon` nothing at all, so a caller with no token is refused before any policy is
 793:       // consulted, and `rows: null` rather than an empty array is what says so.
 794:       //
 795:       // THE TWO HALVES OF THIS ARM STAND ON DIFFERENT GROUND, and the split is stated rather than
 796:       // left to be discovered. THE NEVER-SIGNED-IN HALF IS SOUND AT BOTH TIERS: that caller sends no
 797:       // `Authorization` header, so PostgREST can resolve it to nothing but `anon`, and `anon` holds
 798:       // no grant. THE EQUALITY WITH THE SIGNED-OUT HALF IS THE FIXTURE'S MODEL. `_live.ts`'s
 799:       // `signOut` deliberately retains the cached tokens, so the live twin of the second call would
 800:       // carry a user's bearer token, and PostgREST judges a token by signature and expiry rather than
 801:       // by a session store.
 802:       //
 803:       // SO IF THIS ID EVER RAN LIVE, THE EQUALITY IS WHAT WOULD BE EXPECTED TO FAIL FIRST: the
 804:       // signed-out caller would be answered as that user until the token expired, with rows rather
 805:       // than `rows: null`, while the never-signed-in caller answered 401 exactly as it does here. It
 806:       // does not run live â€” AT-001.24 refuses at the integration tier under
 807:       // `ui.logged-out-surface-rendering` â€” so nothing in this branch grades it, and the record says
 808:       // so rather than guessing which model is right.
 809:       for (const table of ['organizations', 'org_memberships', 'projects', 'acknowledgments'] as const) {
 810:         const neverSignedIn = await sut.dataApiRead(null, { table, keyedBy: null, value: null });
 811:         expect(neverSignedIn.rows, `a caller who never signed in read rows out of ${table}`).toBeNull();
 812:         expect(neverSignedIn.status, `${table} did not refuse a caller with no session at the privilege layer`).toBe(401);
 813: 
 814:         const afterSignOut = await sut.dataApiRead(signedOut, { table, keyedBy: null, value: null });
 815:         expect(
 816:           afterSignOut,
 817:           `on ${table} a caller who never signed in and one whose session had ended were answered differently`,
 818:         ).toEqual(neverSignedIn);
 819:       }
 820: 
 821:       // (3) AND THE PUBLIC SURFACE ANSWERS BOTH SHAPES, identically. This is the half of the criterion
 822:       // that is a grant rather than a denial â€” "only public surfaces render" needs the public one to
 823:       // render at all, or a product that answered nobody would satisfy every arm above.
 824:       const toVisitor = await sut.publicProjectPage(project.id, null);
 825:       expect(toVisitor.ok, 'the public project surface was hidden from a caller who never signed in').toBe(true);
 826:       if (!toVisitor.ok) return;
 827:       expect(toVisitor.value, 'the public projection is not the three fields the shipped module builds').toEqual({
 828:         projectId: project.id,
 829:         projectName: PROJECT_NAME,
 830:         organizationName: ORGANIZATION_NAME,
 831:       });
 832:       const afterSignOut = await sut.publicProjectPage(project.id, signedOut);
 833:       expect(afterSignOut.ok, 'the public project surface was hidden from a caller whose session had ended').toBe(true);
 834:       expect(
 835:         afterSignOut,
 836:         'the public surface answered a caller who never signed in and one whose session had ended differently',
 837:       ).toEqual(toVisitor);
 838: 
 839:       // (4) AND EVERY ROUTE IN THE TREE IS DECLARED PUBLIC OR AUTHENTICATED. This is the shipped
 840:       // DECISION half of the criterion, and it is all of it this pull request may build: there is no
 841:       // screen to render and `src/` is another territory that continuous integration forbids this
 842:       // change to touch. The arm READS that directory and writes nothing in it, and it throws rather
 843:       // than reporting an absence it could not measure. It is not a redirect that runs, and the
 844:       // integration body refuses this id for exactly that reason.
 845:       expect(
 846:         undeclaredRoutesInTree(),
 847:         'a route under src/routes/ is declared neither public nor authenticated in supabase/functions/_shared/route-visibility.ts',
 848:       ).toEqual([]);
 849:     },
 850:     integration: at00124,
 851:   },
 852: );

