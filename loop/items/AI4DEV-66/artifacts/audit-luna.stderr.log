  552: atTest(
  553:   'AT-001.40',
  554:   'a platform admin reaches any NGO or project data â€” the admin role spans all accounts',
  555:   // NO `ui` TAG, for the reason AT-001.23 carries none: the criterion names no browser route, and its
  556:   // outcome is that reads succeed where another caller's are refused.
  557:   { timeoutMs: { integration: INTEGRATION_TIMEOUT_MS } },
  558:   {
  559:     default: async ({ open }) => {
  560:       const { w, sut } = await open();
  561:       const NAME_A = 'Riverside Shelter 40A';
  562:       const NAME_B = 'Northgate Foodbank 40B';
  563: 
  564:       const sessionA = await sut.registerWithEmailPassword(w.email('ngo-a-40'), PASSWORD);
  565:       const a = await sut.completeSignup(
  566:         sessionA,
  567:         { accountType: 'ngo', organizationName: NAME_A, acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
  568:         CLIENT_IP,
  569:       );
  570:       expect(a, 'NGO A could not complete signup, so there is no first tenant to reach across').toMatchObject({ ok: true });
  571:       expect(
  572:         a.ok ? a.organizationId : null,
  573:         'NGO A completed signup with no organisation, so the administrator has only one tenant to read and its reach would be indistinguishable from an ordinary one',
  574:       ).not.toBeNull();
  575:       if (!a.ok || a.organizationId === null) return;
  576: 
  577:       const sessionB = await sut.registerWithEmailPassword(w.email('ngo-b-40'), PASSWORD);
  578:       const b = await sut.completeSignup(
  579:         sessionB,
  580:         { accountType: 'ngo', organizationName: NAME_B, acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
  581:         CLIENT_IP,
  582:       );
  583:       expect(b, 'NGO B could not complete signup, so there is no second tenant and no boundary to cross').toMatchObject({ ok: true });
  584:       expect(
  585:         b.ok ? b.organizationId : null,
  586:         'NGO B completed signup with no organisation, so there is no second tenant and every arm below would be skipped',
  587:       ).not.toBeNull();
  588:       if (!b.ok || b.organizationId === null) return;
  589: 
  590:       const projectA = await sut.createProjectAsOperator(a.organizationId, 'Riverside Shelter Website 40');
  591:       const projectB = await sut.createProjectAsOperator(b.organizationId, 'Northgate Foodbank Website 40');
  592: 
  593:       // THE ADMINISTRATOR, PROVISIONED AND THEN SIGNED IN. `complete_signup` refuses this account type
  594:       // by name, so provisioning is the only way one exists at all, and the sign-in is what turns it
  595:       // into a caller with a session.
  596:       const adminEmail = w.email('platform-admin-40');
  597:       await sut.provisionPlatformAdmin(adminEmail, PASSWORD);
  598:       const adminSignIn = await sut.signInWithEmailPassword(adminEmail, PASSWORD);
  599:       expect(adminSignIn, 'the provisioned platform administrator could not sign in, so there is no administrator to act').toMatchObject(
  600:         { ok: true },
  601:       );
  602:       if (!adminSignIn.ok) return;
  603:       const admin = adminSignIn.session;
  604: 
  605:       // (1) BOTH ORGANISATIONS' DASHBOARDS, read by ONE administrator. Two tenants, never one: one
  606:       // administrator reading one organisation proves nothing an ordinary member could not prove.
  607:       const dashboardA = await sut.organizationDashboard(admin, a.organizationId);
  608:       expect(dashboardA.ok, "the platform administrator was refused NGO A's dashboard").toBe(true);
  609:       if (!dashboardA.ok) return;
  610:       expect(dashboardA.value.organizationName, "the administrator's read of NGO A named a different organisation").toBe(NAME_A);
  611: 
  612:       const dashboardB = await sut.organizationDashboard(admin, b.organizationId);
  613:       expect(dashboardB.ok, "the platform administrator was refused NGO B's dashboard").toBe(true);
  614:       if (!dashboardB.ok) return;
  615:       expect(dashboardB.value.organizationName, "the administrator's read of NGO B named a different organisation").toBe(NAME_B);
  616: 
  617:       // (2) AND BOTH PROJECTS' WORKSPACES, which is the other scope the criterion names. The
  618:       // administrator holds neither developer seat and neither membership row.
  619:       const workspaceA = await sut.projectWorkspace(admin, projectA.id);
  620:       expect(workspaceA.ok, "the platform administrator was refused NGO A's project workspace").toBe(true);
  621:       if (!workspaceA.ok) return;
  622:       expect(workspaceA.value.projectId, "the administrator's workspace read named a different project").toBe(projectA.id);
  623: 
  624:       const workspaceB = await sut.projectWorkspace(admin, projectB.id);
  625:       expect(workspaceB.ok, "the platform administrator was refused NGO B's project workspace").toBe(true);
  626:       if (!workspaceB.ok) return;
  627:       expect(workspaceB.value.projectId, "the administrator's workspace read named a different project").toBe(projectB.id);
  628: 
  629:       // (3) AND THE UNFILTERED DATA API LISTING HOLDS BOTH TENANTS' ROWS â€” the criterion's other path.
  630:       // It is asserted as "both are present" rather than as an exact set, because the integration twin
  631:       // reads a database the whole run shares and the two bodies state one claim.
  632:       //
  633:       // ALL FOUR TABLES, NOT THE ONE THIS ARM USED TO READ (gate-2 slice-2 ruling 5). The migration
  634:       // ships FOUR platform-admin policies, and the dashboard and workspace successes above prove
  635:       // nothing about the other three: those surfaces read with the SERVICE ROLE, so row-level security
  636:       // is never consulted on that path at all. With only the `organizations` listing here, three
  637:       // shipped policies had no test at the one layer where they act â€” which is what gate-1 ruling 7
  638:       // forbids: a slice does not ship a policy branch it does not test.
  639:       const listing = await sut.dataApiRead(admin, { table: 'organizations', keyedBy: null, value: null });
  640:       expect(listing.rows, "the administrator's unfiltered listing was refused before any row was considered").not.toBeNull();
  641:       const listed = (listing.rows ?? []).map((row) => String(row.id));
  642:       expect(listed, "the administrator's unfiltered listing does not hold NGO A").toContain(a.organizationId);
  643:       expect(listed, "the administrator's unfiltered listing does not hold NGO B").toContain(b.organizationId);
  644: 
  645:       const seatListing = await sut.dataApiRead(admin, { table: 'org_memberships', keyedBy: null, value: null });
  646:       expect(
  647:         seatListing.rows,
  648:         "the administrator's unfiltered listing of org_memberships was refused before any row was considered",
  649:       ).not.toBeNull();
  650:       const listedSeats = (seatListing.rows ?? []).map((row) => String(row.org_id));
  651:       expect(listedSeats, "the administrator cannot read NGO A's seats, so org_memberships_select_platform_admin admits nobody").toContain(
  652:         a.organizationId,
  653:       );
  654:       expect(listedSeats, "the administrator cannot read NGO B's seats, so its reach over that table stops at one tenant").toContain(
  655:         b.organizationId,
  656:       );
  657: 
  658:       const projectListing = await sut.dataApiRead(admin, { table: 'projects', keyedBy: null, value: null });
  659:       expect(
  660:         projectListing.rows,
  661:         "the administrator's unfiltered listing of projects was refused before any row was considered",
  662:       ).not.toBeNull();
  663:       const listedProjects = (projectListing.rows ?? []).map((row) => String(row.id));
  664:       expect(listedProjects, "the administrator cannot read NGO A's project, so projects_select_platform_admin admits nobody").toContain(
  665:         projectA.id,
  666:       );
  667:       expect(listedProjects, "the administrator cannot read NGO B's project, so its reach over that table stops at one tenant").toContain(
  668:         projectB.id,
  669:       );
  670: 
  671:       const acknowledgmentListing = await sut.dataApiRead(admin, { table: 'acknowledgments', keyedBy: null, value: null });
  672:       expect(
  673:         acknowledgmentListing.rows,
  674:         "the administrator's unfiltered listing of acknowledgments was refused before any row was considered",
  675:       ).not.toBeNull();
  676:       const listedAcknowledgments = (acknowledgmentListing.rows ?? []).map((row) => String(row.account_id));
  677:       expect(
  678:         listedAcknowledgments,
  679:         "the administrator cannot read NGO A's acknowledgment, so acknowledgments_select_platform_admin admits nobody",
  680:       ).toContain(a.accountId);
  681:       expect(
  682:         listedAcknowledgments,
  683:         "the administrator cannot read NGO B's acknowledgment, so its reach over that table stops at one account",
  684:       ).toContain(b.accountId);
  685: 
  686:       // (4) AND A NON-ADMIN REPEATING THOSE READS IS REFUSED. Without this arm the body would
  687:       // show only that somebody read something. The reach is attributable through the CONTRAST and not
  688:       // through anything the answer carries: the shipped decision knows WHY it granted, and
  689:       // `TenantReadOutcome` deliberately does not carry that reason, because AT-001.21's claim is that
  690:       // two whole answers are identical and a richer outcome would invite a weaker assertion.
  691:       //
  692:       // THE CONTROL COVERS THE SAME FOUR TABLES, because a control on one of them would leave the
  693:       // other three admitting an ordinary caller with nothing to notice.
  694:       const nonAdminDashboard = await sut.organizationDashboard(sessionB, a.organizationId);
