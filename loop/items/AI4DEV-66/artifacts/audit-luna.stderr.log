  365: /* ------------------------------------------------------- the direct-identifier probing clause */
  366: 
  367: /** The four tables that hold data belonging to one tenant. `accounts` is not one: it holds no rows a tenant owns. */
  368: export type TenantTable = 'organizations' | 'org_memberships' | 'acknowledgments' | 'projects';
  369: 
  370: /** The column a tenant table is keyed by for a probe â€” `id` for organisations, and the two foreign keys. */
  371: export type TenantKeyColumn = 'id' | 'org_id' | 'account_id';
  372: 
  373: /**
  374:  * ONE DIRECT DATA API READ â€” AT-001.21's "direct API/ID probing", said as a value.
  375:  *
  376:  * `keyedBy: null` is the UNFILTERED LISTING, which is a different attack from a keyed probe and needs
  377:  * its own arm: a keyed probe asks "is this identifier yours"; a listing asks "what is there at all",
  378:  * and a policy that leaked would leak there first.
  379:  */
  380: export type DataApiProbe = {
  381:   table: TenantTable;
  382:   keyedBy: TenantKeyColumn | null;
  383:   /** the identifier the probe filters by; `null` exactly when `keyedBy` is `null` */
  384:   value: string | null;
  385: };
  386: 
  387: /**
  388:  * WHAT ONE DIRECT DATA API READ ANSWERED.
  389:  *
  390:  * `rows: []` IS THE DENIAL, and that is the whole reason this clause is cheap to satisfy at the
  391:  * database: a row-level-security policy that admits nothing answers with an empty array, which is
  392:  * byte for byte what a keyed read of a row that does not exist answers. The no-oracle property is
  393:  * free there, unlike at the edge surface where `TENANT_NOT_FOUND` has to supply it.
  394:  *
  395:  * `rows: null` is a read that was REFUSED before any row was considered â€” the privilege layer, not a
  396:  * policy. It is a distinct answer rather than an empty one for the reason every three-outcome lookup
  397:  * in this tree gives: "denied by row-level security" and "the role holds no privilege" are different
  398:  * facts, and collapsing them would let one be reported as the other.
  399:  */
  400: export type DataApiReadOutcome = {
  401:   status: number;
  402:   rows: Record<string, unknown>[] | null;
  403: };
  404: 
  405: /* ---------------------------------------------------- the live catalog, for the conformance arm */
  406: 
  407: /**
  408:  * ONE TABLE IN THE `public` SCHEMA, as the live catalog reports it.
  409:  *
  410:  * IT EXISTS SO THE ABSENCE OF A TABLE IS SELF-CORRECTING. The criteria enumerate drafts, ledger,
  411:  * files, thread and tasks, and none of those tables exists in this tree. A conformance arm that reads
  412:  * this and compares it against a SHIPPED list fails the build when a later requirement lands a table
  413:  * nobody has classified â€” without which this leaf's green would be a statement about today's tables
  414:  * and nothing else.
  415:  *
  416:  * IT IS AN INTEGRATION-TIER READ AND ONLY THAT. There is no catalog at loop tier, and the loop
  417:  * adapter refuses this member by name rather than answering with an invented one.
  418:  */
  419: export type CatalogTable = {
  420:   /** the table's name in `public` */
  421:   table: string;
  422:   /**
  423:    * the CLIENT roles that EFFECTIVELY hold `select` on it, by any grant including one to `PUBLIC` â€”
  424:    * `anon` and `authenticated` only, because the operator is not a client. The witness is
  425:    * `has_table_privilege(<role>, <table>, 'SELECT')` rather than a grant catalogue, because a grant
  426:    * catalogue answers who was NAMED in a grant statement and omits `PUBLIC` by documented design.
  427:    */
  428:   selectGrantedTo: string[];
  429:   /** whether row-level security is enabled on it */
  430:   rowLevelSecurity: boolean;
  431:   /** every `select` policy on it, with the roles it reaches and its `qual` expression */
  432:   selectPolicies: { name: string; roles: string[]; qual: string | null }[];
  433: };
  434: 
  435: /** WHICH STORE A LOOP-TIER READ FAULT IS ARMED AGAINST â€” the four a tenant read touches. */
  436: export type TenantReadStore = 'accounts' | 'memberships' | 'projects' | 'organizations';
  437: 
  438: /* ------------------------------------------------------------------------------------ the SUT */
  439: 
  440: /**
  441:  * REQ-001's accounts system under test.
  442:  *
  443:  * The split is the point, and there are now FOUR kinds of member here rather than three:
  444:  *
  445:  *   1. THE TWO PRODUCT OPERATIONS â€” `completeSignup` and `createOrganization`. At loop tier the
  446:  *      adapter runs them over its own storage but delegates every judgement to
  447:  *      `supabase/functions/_shared/accounts.ts`, the module the edge functions import; at
  448:  *      integration tier they would be the deployed edge functions.
  449:  *   2. SUPABASE AUTH'S HALF â€” registration, sign-in, identity linking, the session layer
  450:  *      (`signOut`, `refreshSession`, `sessionsOf`), password reset (`requestPasswordReset`,
  451:  *      `emailedPasswordResetLink`, `completePasswordReset`) and the verification state
  452:  *      (`emailVerified`, `emailedVerificationLink`, `useVerificationLink`). None of it is this
  453:  *      requirement's code. It is what produces the states the product operations judge.
  454:  *
  455:  *      THE SESSION AND RESET MEMBERS ARE VENDOR MIRRORS, and every one of them is named in
  456:  *      `_fixture.ts`'s mirror section with what binds it live or an explicit unbound label. What is
  457:  *      NOT a mirror is the judgement that reads them: every session-taking operation resolves its
  458:  *      caller through the SHIPPED `callerFromAuthAnswer`, so a dead session is refused by the same
  459:  *      code the deployed functions run.
  460:  *   3. READ-BACK â€” the row shapes an assertion reads after the fact.
  461:  *   4. ONE STAND-IN SURFACE, AND IT IS THE ONLY ONE â€” `sendDiscoveryMessage`, with
  462:  *      `discoveryMessagesBy` reading it back.
  463:  *
  464:  * THE FOURTH KIND NEEDS ITS OWN SENTENCE, because it is the one that could be misread. NO
  465:  * DISCOVERY ROUTE EXISTS IN THIS TREE. The Discovery message route is REQ-002/004's, and what
  466:  * this requirement's leaf ships is the DECISION that route must consult â€”
  467:  * `discoveryMessageAllowed` in `supabase/functions/_shared/verification.ts`. So
  468:  * `sendDiscoveryMessage` is not a deployed operation being tested; it is a stand-in surface whose
  469:  * only job is to put the shipped decision on a tested path, exactly as
  470:  * `hasPlatformAcknowledgment` below is the hook a project-creation leaf must call. A green over
  471:  * it says the DECISION is right. It says nothing about enforcement anywhere, because there is
  472:  * nowhere yet to enforce it.
  473:  */
  474: export type AccountsSut = {
  475:   /** AT-001.07's second clause: which types the PUBLIC signup surface offers. */
  476:   publicSignupAccountTypes(): Promise<readonly string[]>;
  477: 
  478:   /* --- Supabase Auth's half. Not this leaf's code; it is what produces a session to complete. --- */
  479: 
  480:   /**
  481:    * Register an auth user with an email and a password, and return the resulting session.
  482:    *
  483:    * ============================================================================================
  484:    * IT STILL RETURNS A SESSION, AND THE LIVE STACK ISSUES NONE. THIS IS THE DECLARED DIVERGENCE.
  485:    * ============================================================================================
  486:    *
  487:    * With `enable_confirmations = true` the live GoTrue issues NO session at signup: it creates the
  488:    * user, sends the confirmation email, and answers with no tokens. This fixture mints one anyway,
  489:    * because every body written before this leaf takes its session from here and rewriting them all
  490:    * would be a change to nine green ids for no criterion's sake.
  491:    *
  492:    * SO REGISTRATION ISSUANCE IS NEVER LABELLED LIVE-BOUND, anywhere. `_fixture.ts`'s mirror section
  493:    * binds SIGN-IN issuance â€” the live checks (a) and (b) measure a password grant and the
  494:    * `auth.sessions` row it creates â€” and says of registration issuance only that it diverges. A
  495:    * label claiming otherwise would be an untrue stated fact, and this paragraph is where the truth
  496:    * is kept.
  497:    *
  498:    * WHAT THE NEW BODIES DO ABOUT IT: they narrow it. AT-001.12, .13, .14 and .38 all follow the
  499:    * LIVE PUBLIC ORDER â€” register, use the emailed verification link, sign in, and only then play
  500:    * the session and password games â€” so the registration-minted handle plays no part in any
  501:    * assertion they make. The older bodies still use it, and AT-001.10's body relies on it
  502:    * deliberately: it builds a completed-but-unverified account, which the live public path cannot
  503:    * reach, because decision-8 makes verification the WRITE PATH's own floor rather than a property
  504:    * borrowed from the session layer. The live-stack behaviour is measured in
  505:    * `loop/items/AI4DEV-59/proof-local.ts` checks (a) and (c), and in this item's own proof.
  506:    */
  507:   registerWithEmailPassword(email: string, password: string): Promise<Session>;
  508:   /**
  509:    * A session Auth recorded as having come from an external provider.
  510:    *
  511:    * It performs NO handshake and fabricates no authorization code or token exchange: it is the state
  512:    * Auth is in AFTER a consent round trip, which is the only part of the story any agent can reach.
  513:    */
  514:   registerWithProvider(provider: SessionProvider, email: string): Promise<Session>;
  515:   /**
  516:    * A GitHub OAuth signup, as Auth records it: a session established by GitHub whose account already
  517:    * carries the linked GitHub identity â€” AT-001.02's "signs up via GitHub OAuth".
  518:    *
  519:    * Like `registerWithProvider` it performs NO handshake. It is `registerWithProvider('github', â€¦)`
  520:    * plus the fact that a GitHub signup necessarily links the GitHub identity it signed up with, and
  521:    * it is a separate member rather than an argument because that second half is what AT-001.02's
  522:    * "the GitHub identity is linked to it" clause is about.
  523:    */
  524:   registerWithGithub(email: string, githubHandle: string): Promise<Session>;
  525:   /**
  526:    * The state Auth is in after a `linkIdentity` round trip â€” AT-001.04's "linking completes signup".
  527:    *
  528:    * A LINKED IDENTITY IS NOT THE ESTABLISHING PROVIDER, and keeping the two apart is the point of
  529:    * this member existing at all: an email- or Google-established volunteer links GitHub and their
  530:    * session's `provider` does not change. The gate in
  531:    * `supabase/functions/_shared/accounts.ts` reads the link; nothing shipped reads the provider.
  532:    *
  533:    * Same posture as every other Auth member here â€” no handshake, no fabricated authorization code.
  534:    */
  535:   linkGithubIdentity(session: Session, githubHandle: string): Promise<void>;
  536:   /** Return sign-in with the same credentials â€” AT-001.01's final clause. */
  537:   signInWithEmailPassword(email: string, password: string): Promise<SignInOutcome>;
  538:   /**
  539:    * The return visit through an external provider â€” AT-001.02's "a later sign-in via GitHub returns
  540:    * to the same account".
  541:    *
  542:    * What it asserts is IDENTITY CONTINUITY, which is the half of that clause reachable without a
  543:    * person: an existing user whose account carries that provider's identity signs in to the SAME
  544:    * account rather than to a second one. The consent round trip itself is not performed and is named
  545:    * unproved in the plan's per-id table.
  546:    */
  547:   signInWithProvider(provider: SessionProvider, email: string): Promise<SignInOutcome>;
  548: 
  549:   /* ----------------------------- Supabase Auth's session layer -------------------------------- */
  550: 
  551:   /**
  552:    * End this session â€” the mirror of `POST /auth/v1/logout`, which deletes the `auth.sessions` row.
  553:    *
  554:    * IT ENDS ONE SESSION, NOT THE ACCOUNT'S ACCESS. That is the distinction AT-001.12's revocation
  555:    * half turns on: after it, work under this handle is refused and the account is otherwise
  556:    * untouched â€” a fresh sign-in works immediately, which is what makes re-authentication the
  557:    * REMEDY rather than a coincidence.
  558:    *
  559:    * SO IT MIRRORS THE `?scope=local` SHAPE, AND THE VENDOR'S DEFAULT IS THE OTHER ONE. Measured on
  560:    * the live stack and recorded in `loop/items/AI4DEV-60/proof-local.txt`: a plain
  561:    * `POST /auth/v1/logout` carries the `global` scope and ends EVERY session the user holds. The
  562:    * live counterpart of THIS member is therefore the scoped call, which is what check (c) makes â€”
  563:    * with a sibling session as the control, so "this session ended" and "the account's access ended"
  564:    * cannot be confused. No body in this suite asserts the difference: every one of them signs in
  565:    * afresh after a sign-out, which both scopes permit.
  566:    *
  567:    * It returns nothing, and a handle Auth never issued THROWS rather than answering politely: a
  568:    * body signing out a session that does not exist has a bug in the TEST, and a polite outcome
  569:    * would let that bug read as a product refusal further down. Same posture as
  570:    * `linkGithubIdentity`.
  571:    */
  572:   signOut(session: Session): Promise<void>;
  573:   /**
  574:    * Refresh a session â€” AT-001.13's act, and the whole point of it is what it does NOT take.
  575:    *
  576:    * NO CREDENTIALS PASS THROUGH THIS CALL, and that is structural rather than asserted: there is no
  577:    * parameter for a password. On the live stack the refresh token does this, which is why a client
  578:    * can keep a session alive while the user works and never ask them to sign in again.
  579:    *
  580:    * IT WORKS AFTER THE ACCESS TOKEN HAS EXPIRED, which is the mirror that matters â€” a refresh token
  581:    * outliving the access token is the entire mechanism. It stops working once the session is
  582:    * revoked, because revocation removes the session itself.
  583:    *
  584:    * IT EXTENDS THE SAME SESSION, and the returned handle carries the same `sessionId`. Whether the
  585:    * live vendor extends the row or rotates it is MEASURED rather than assumed â€”
  586:    * `loop/items/AI4DEV-60/proof-local.ts` check (d) reads `auth.sessions` before and after a real
  587:    * refresh. If the vendor rotates, this mirror is corrected to the measurement.
  588:    *
  589:    * ROTATION OF THE REFRESH TOKEN AND THE REUSE INTERVAL ARE NOT MODELLED. No criterion reads
  590:    * either, and modelling vendor semantics nothing asserts is how retired ground creeps back in.
  591:    */
  592:   refreshSession(session: Session): Promise<RefreshSessionOutcome>;
  593:   /**
  594:    * The account's live sessions â€” the mirror of reading `auth.sessions` with operator authority.
  595:    *
  596:    * "LIVE" MEANS NEITHER REVOKED NOR EXPIRED, so a session that has ended is absent rather than
  597:    * present-and-flagged. That is what the read is for: AT-001.38's second clause is "no
  598:    * authenticated session is created", and a refusal's own return value cannot show that nothing
  599:    * was minted â€” only a count taken before and after can. Same reason `organizationsNamed` and
  600:    * `discoveryMessagesBy` exist.
  601:    *
  602:    * IT IS AN OPERATOR'S READ, not a caller's, so it takes an account id rather than a session. No
  603:    * product surface in this tree exposes it and none is implied by it.
  604:    */
  605:   sessionsOf(accountId: string): Promise<{ sessionId: string }[]>;
  606: 
  607:   /* --------------------------- Supabase Auth's password reset --------------------------------- */
  608: 
  609:   /**
  610:    * Ask for a password reset â€” the mirror of `POST /auth/v1/recover`.
  611:    *
  612:    * IT ALWAYS SUCCEEDS, INCLUDING FOR AN ADDRESS NOBODY REGISTERED, and that is a security shape
  613:    * rather than laziness: an answer that differed would tell an anonymous caller which addresses
  614:    * hold accounts. REQ-001 spends AT-001.21 forbidding exactly that shape elsewhere, and the
  615:    * sign-in refusal in this same fixture gives one reason for both of its branches for the same
  616:    * reason. The live behaviour is measured â€” `loop/items/AI4DEV-60/proof-local.ts` check (e)
  617:    * calls `/auth/v1/recover` for a never-registered address and captures the answer.
  618:    *
  619:    * A LINK IS EMAILED ONLY WHERE THERE IS A PASSWORD TO RESET: a registered email/password user.
  620:    * A provider-established account has no password, so nothing is sent, and the answer is the same.
  621:    */
  622:   requestPasswordReset(email: string): Promise<{ ok: true }>;
  623:   /**
  624:    * The reset link emailed to this address, or `null` when none was emailed â€” the stand-in for the
  625:    * message the local mail catcher holds on the live stack.
  626:    *
  627:    * `null` is a real answer rather than only the empty case: no reset was requested, or the address
  628:    * has no password to reset.
  629:    */
  630:   emailedPasswordResetLink(email: string): Promise<string | null>;
  631:   /**
  632:    * Complete the emailed reset flow with a new password â€” AT-001.14's act.
  633:    *
  634:    * NO EXPIRY, NO SINGLE USE AND NO RESEND IS MODELLED OR ASSERTED. AT-001.15 is retired â€” the
  635:    * acceptance file's own words are that "reset-link expiry/single-use semantics are not stated in
  636:    * REQ-001" â€” so building any of them here would be asserting a criterion that was deliberately
  637:    * withdrawn. The link is NOT cleared when it is used, exactly as a verification link is not.
  638:    *
  639:    * THE NEVER-ISSUED NEGATIVE IS NOT AT-001.15 GROUND, and the difference is worth being exact
  640:    * about â€” it is the same difference `useVerificationLink` draws. It is not a claim about a link's
  641:    * lifetime; it guards this test's own oracle. A link-shaped string that reset an account it never
  642:    * belonged to would make "completing the emailed flow is what changes the password" mean nothing,
  643:    * because any string would change anything.
  644:    *
  645:    * WHETHER A LIVE RESET REVOKES THE ACCOUNT'S OTHER SESSIONS IS NEITHER MODELLED NOR ASSERTED. No
  646:    * criterion reads it, and `secure_password_change` sits false in `supabase/config.toml`.
  647:    */
  648:   completePasswordReset(link: string, newPassword: string): Promise<{ ok: boolean }>;
  649: 
  650:   /* ------------------------- Supabase Auth's verification state ------------------------------- */
  651: 
  652:   /**
  653:    * Whether Supabase Auth reports this account's email address confirmed â€” AT-001.09's observable.
  654:    *
  655:    * IT IS DERIVED, NOT STORED-AND-READ. The adapter renders the account's stored Auth state as the
  656:    * canonical GoTrue `/auth/v1/user` shape and judges the answer out of it with the SHIPPED
  657:    * `emailVerifiedFromUser`. That is the same pattern `completeSignup` uses for the GitHub handle
  658:    * (the GitHub leaf's gate-2 ruling R3), and it exists so the shipped extractor sits on the tested
  659:    * path rather than being a function no test ever runs â€” which is exactly how the future Discovery
  660:    * route will resolve the same fact from the same response.
  661:    *
  662:    * WHAT NO LOOP-TIER GREEN OVER IT PROVES: that the rendered shape is the shape GoTrue really
  663:    * sends. Only `loop/items/AI4DEV-59/proof-local.ts` check (d) touches that, by feeding a real
  664:    * response to the same shipped function.
  665:    */
  666:   emailVerified(accountId: string): Promise<boolean>;
  667:   /**
  668:    * The verification link emailed to this address, or `null` when none was emailed.
  669:    *
  670:    * `null` is a real answer rather than only the empty case: a provider registration is confirmed
  671:    * by the provider and no confirmation email is sent for it.
  672:    */
  673:   emailedVerificationLink(email: string): Promise<string | null>;
  674:   /**
  675:    * Use a verification link. Using the link Auth emailed for an address confirms that address; a
  676:    * link that was never issued returns `ok: false` and flips nothing.
  677:    *
  678:    * NO EXPIRY, NO SINGLE USE AND NO RESEND IS MODELLED OR ASSERTED. AT-001.11 is retired â€” the
  679:    * acceptance file's own words are that "verification-link expiry/single-use/resend semantics are
  680:    * not stated in REQ-001" â€” so building any of them here would be asserting a criterion that was
  681:    * deliberately withdrawn.
  682:    *
  683:    * THE NEVER-ISSUED NEGATIVE IS NOT AT-001.11 GROUND, and the difference is worth being exact
  684:    * about. It is not a claim about a link's lifetime; it guards this test's own oracle. A
  685:    * link-shaped string that verified an account it never belonged to would make "using the emailed
  686:    * link is what flips it" mean nothing at all, because any string would flip anything.
  687:    */
  688:   useVerificationLink(link: string): Promise<{ ok: boolean }>;
  689: 
  690:   /* ----------------------------------- the two product operations ----------------------------- */
  691: 
  692:   /**
  693:    * `supabase/functions/complete-signup` â€” turns an authenticated auth user into a typed account.
  694:    *
  695:    * IT RESOLVES ITS CALLER FIRST, through the shipped `callerFromAuthAnswer`, exactly as the
  696:    * deployed function does. An expired or revoked session therefore refuses BEFORE any product rule
  697:    * is consulted and writes nothing â€” which is the shape AT-001.12 reads.
  698:    */
  699:   completeSignup(session: Session, request: CompleteSignupRequest, ip: string): Promise<CompleteSignupOutcome>;
  700:   /**
  701:    * `supabase/functions/create-organization` â€” the NGO-only action AT-001.06 drives, and the write
  702:    * AT-001.12 uses as its stale-session oracle.
  703:    *
  704:    * IT IS AT-001.12'S WRITE FOR A REASON: no verification gate sits on it, so a refusal here is
  705:    * unambiguously the session layer's rather than the Discovery floor's. It resolves its caller the
  706:    * same way `completeSignup` does.
  707:    */
  708:   createOrganization(session: Session, organizationName: string): Promise<CreateOrganizationOutcome>;
  709: 
  710:   /**
  711:    * `supabase/functions/update-organization` â€” THE ADMIN-ONLY NGO-SIDE ACTION, and the operation
  712:    * AT-001.16 and AT-001.36 are both graded through.
  713:    *
  714:    * IT TAKES THE ORGANISATION AS AN ARGUMENT, which is what makes it usable as an isolation oracle:
  715:    * one caller, three targets, three different answers. The same session renames the organisation it
  716:    * administers, is refused in the organisation where it holds `member`, and is refused in an
  717:    * organisation it holds no membership in â€” and the two refusals carry DIFFERENT kinds.
  718:    *
  719:    * WHAT A GREEN OVER IT CLAIMS, said narrowly because the criterion's words are wider. It claims
  720:    * OPERATION-SURFACE isolation: authority does not cross organisations on this action. It does NOT
  721:    * claim read isolation â€” "acting in NGO A never grants access to NGO B's data" is the
  722:    * tenant-isolation deliverable's (`loop/decomp/req-001.md` D5.L1 and D5.L2), which this leaf
  723:    * unblocked and which has now landed.
  724:    *
  725:    * (This paragraph used to end by saying the tree had no read surface to leak through, because
  726:    * row-level security was on with zero policies and `org_memberships` reached no Data API role.
  727:    * Every clause of that sentence stopped being true when the two tenant-visibility migrations
  728:    * landed on 2026-08-12 and 2026-08-13: `authenticated` holds `select` on the four tenant tables
  729:    * and each carries `select` policies. The read claim is made by AT-001.21, .22, .23, .40 and .24
  730:    * against those policies and the three read surfaces, so this member's narrow claim stands on its
  731:    * own rather than on an absence that has gone.)
  732:    */
  733:   updateOrganization(session: Session, organizationId: string, name: string): Promise<UpdateOrganizationOutcome>;
  734: 
  735:   /* ------------------------------------ the operator's surface -------------------------------- */
  736: 
  737:   /**
  738:    * Create an organisation WITH NO MEMBERSHIP ROW â€” an authority no product path holds, and the
  739:    * reason it exists is exact.
  740:    *
  741:    * EVERY PRODUCT PATH SEATS ITS CREATOR AS ADMIN: `complete_signup` does it for an NGO signup and
  742:    * `create_organization` does it for a second organisation. The single-seat invariant then refuses
  743:    * a second membership row in that organisation. So the Given AT-001.16 and AT-001.36 both need â€”
  744:    * one account holding DIFFERENT roles in two organisations â€” is unconstructible through product
  745:    * paths alone, not because the product is wrong but because the product is right. This method
  746:    * creates the unseated organisation the operator then seats the actor into as `member`, and mints
  747:    * the third organisation AT-001.16's not-a-member arm targets.
  748:    *
  749:    * IT IS AN OPERATOR ACT, exactly as `provisionPlatformAdmin` is: a direct database operation, not
  750:    * a service-role write, and no running service holds it. It THROWS on failure rather than
  751:    * returning an outcome, because a Given that could not be provisioned is a bug in the TEST and a
  752:    * polite refusal would read as a product answer three assertions later.
  753:    */
  754:   createOrganizationAsOperator(name: string): Promise<OrganizationRow>;
  755: 
  756:   /**
  757:    * Grant a membership directly, as the operator â€” the provisioning act AND the refusal probe.
  758:    *
  759:    * IT IS BOTH, deliberately, and that is why it returns an outcome where
  760:    * `createOrganizationAsOperator` throws. Two criteria read its REFUSALS as the thing under test:
  761:    * AT-001.37 needs a direct grant to a volunteer account to be rejected on a path with no
  762:    * TypeScript on it, and AT-001.17 needs a second seat in an already-seated organisation to be
  763:    * rejected. Its successes are Givens; its refusals are evidence.
  764:    *
  765:    * NOTHING IN THE PRODUCT WRITES `'member'`, and that is by design rather than by omission â€” the
  766:    * single-seat invariant forbids invites, so no product path can mint a second member. The
  767:    * `member` half of the `org_role` enum exists for AT-001.36, and this is how that criterion's
  768:    * Given is reached. The body that uses it says so in its own evidence.
  769:    */
  770:   grantMembershipAsOperator(organizationId: string, accountId: string, role: OrgRole): Promise<GrantMembershipOutcome>;
  771: 
  772:   /**
  773:    * Re-point an organisation's EXISTING membership row at a different account, as the operator â€”
  774:    * the refusal probe for the trigger's UPDATE half.
  775:    *
  776:    * THE ROLE IS NOT AN ARGUMENT, because the role is not what moves: the row keeps whatever role it
  777:    * holds and only its account changes. That is exactly the attack the migration names in its own
  778:    * prose â€” a row inserted for an NGO account and then re-keyed to a volunteer â€” and the read-back a
  779:    * body makes afterwards is that the row still holds the ORIGINAL account with its ORIGINAL role.
  780:    *
  781:    * IT IS A REFUSAL PROBE AND NOTHING ELSE, so it returns an outcome rather than throwing: no Given
  782:    * in this suite is reached by re-pointing a seat, and every body that calls it is asserting that
  783:    * the database said no.
  784:    */
  785:   repointMembershipAsOperator(organizationId: string, accountId: string): Promise<RepointMembershipOutcome>;
  786: 
  787:   /**
  788:    * Create a project, as the operator â€” a GIVEN, never an act under test.
  789:    *
  790:    * NO PRODUCT PATH CREATES A PROJECT, at either tier, and this method does not pretend otherwise.
  791:    * AT-001.32's Given is "a project with an assigned volunteer", and the criterion is about the
  792:    * SECOND volunteer; reaching that state needs a project, and building product project creation to
  793:    * get one would be landing another requirement's surface early. It throws on failure, for the
  794:    * reason `createOrganizationAsOperator` throws.
  795:    */
  796:   createProjectAsOperator(organizationId: string, name: string): Promise<ProjectRow>;
  797: 
  798:   /**
  799:    * Attach a volunteer to a project, as the operator â€” the Given AND the refusal probe, exactly as
  800:    * `grantMembershipAsOperator` is both.
  801:    *
