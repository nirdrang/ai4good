  319: /**
  320:  * AT-001.07 â€” a provisioned platform administrator authenticates and carries the type; the public
  321:  * signup surface offers only the two.
  322:  *
  323:  * THE SECOND CLAUSE IS PROVED DIFFERENTLY HERE, and that difference is the reason this body exists.
  324:  * At loop tier it reads `publicSignupAccountTypes()`, which is a constant a shipped module exports â€”
  325:  * a list is a claim. At this tier the live oracle is a REFUSAL, which is a fact: the DEPLOYED
  326:  * completion path is asked for a `platform_admin` and must refuse it and leave no row behind. That
  327:  * is a strictly stronger oracle, and it is why the constant is not among the methods the live
  328:  * adapter backs.
  329:  */
  330: export async function at00107(ctx: Ctx): Promise<void> {
  331:   const { w, sut } = await ctx.open();
  332: 
  333:   const adminEmail = w.email('platform-admin');
  334:   const provisioned = await sut.provisionPlatformAdmin(adminEmail, PASSWORD);
  335: 
  336:   const signedIn = await sut.signInWithEmailPassword(adminEmail, PASSWORD);
  337:   expect(signedIn, 'the provisioned platform admin could not sign in').toMatchObject({ ok: true });
  338:   if (!signedIn.ok) return;
  339:   expect(signedIn.session.accountId).toBe(provisioned.accountId);
  340:   expect(
  341:     await sut.account(signedIn.session.accountId),
  342:     'the signed-in administrator does not carry the platform_admin global type',
  343:   ).toMatchObject({ accountType: 'platform_admin' });
  344: 
  345:   const visitor = await registerConfirmAndSignIn(sut, w.email('would-be-admin'));
  346:   const escalation = await sut.completeSignup(
  347:     visitor,
  348:     { accountType: 'platform_admin', acknowledgmentTextVersion: TEXT_VERSION },
  349:     CLIENT_IP,
  350:   );
  351:   expect(escalation.ok, 'the DEPLOYED public signup path minted a platform administrator').toBe(false);
  352:   if (escalation.ok) return;
  353:   expect(escalation.reason).toMatch(/platform_admin/);
  354:   expect(await sut.account(visitor.accountId), 'the refused escalation left an account row behind').toBeNull();
  355: }
  356: 
  357: /**
  358:  * AT-001.09 â€” email verification, PARAMETERIZED OVER BOTH email-capable account types.
  359:  *
  360:  * Gate 1's finding 8 is what makes this body cover two types rather than one: the criterion says
  361:  * "EITHER account type â€¦ (NGO and volunteer)" and carries the acceptance file's own
  362:  * "parameterized over account types" note, and the migrated NGO-only set proved half of it.
  363:  *
  364:  * AND EACH ITERATION REALLY IS ITS TYPE (gate-2 ruling S2-4). The first version of this body labelled
  365:  * the two iterations `ngo` and `volunteer` and differed only in the email address it used â€” neither
  366:  * one ever created an account of either type, so the parameterization was nominal and a
  367:  * type-specific verification regression would have gone unnoticed by both halves. Each iteration now
  368:  * COMPLETES SIGNUP as its type after verification â€” the NGO with an organisation, the volunteer with
  369:  * a linked GitHub identity, both with the acknowledgment â€” and asserts the account row carries that
  370:  * global type.
  371:  *
  372:  * WHAT IS LIVE HERE: the message is the one GoTrue really sent, held by the slot's own mail catcher;
  373:  * the link is followed by HTTP; and the verified fact is judged by the SHIPPED extractor over the
  374:  * real row rather than read as a boolean.
  375:  */
  376: export async function at00109(ctx: Ctx): Promise<void> {
  377:   const { w, sut } = await ctx.open();
  378: 
  379:   for (const kind of ['ngo', 'volunteer'] as const) {
  380:     const email = w.email(`${kind}-verify`);
  381:     const registered = await sut.registerWithEmailPassword(email, PASSWORD);
  382:     expect(registered.sessionId, 'the live registration issued a session, which under confirmations it must not').toBe('');
  383: 
  384:     // UNVERIFIED FIRST, and it must DISCRIMINATE: an extractor that answered true unconditionally
  385:     // would satisfy every assertion after the link is used.
  386:     expect(
  387:       await sut.emailVerified(registered.accountId),
  388:       `a fresh ${kind} registration is already reported verified â€” nothing below would then mean anything`,
  389:     ).toBe(false);
  390: 
  391:     // Auth itself refuses sign-in before confirmation, which is the state the criterion describes.
  392:     const early = await sut.signInWithEmailPassword(email, PASSWORD);
  393:     expect(early.ok, `an unconfirmed ${kind} account signed in`).toBe(false);
  394: 
  395:     const link = await sut.emailedVerificationLink(email);
  396:     expect(link, `no confirmation email reached the slot's mail catcher for the ${kind} address`).not.toBeNull();
  397: 
  398:     const used = await sut.useVerificationLink(link!);
  399:     expect(used.ok, `following the emailed ${kind} confirmation link was refused`).toBe(true);
  400:     expect(
  401:       await sut.emailVerified(registered.accountId),
  402:       `using the emailed link did not flip the ${kind} account to verified`,
  403:     ).toBe(true);
  404: 
  405:     const after = await sut.signInWithEmailPassword(email, PASSWORD);
  406:     expect(after, `a confirmed ${kind} account could not sign in`).toMatchObject({ ok: true });
  407:     if (!after.ok) return;
  408: 
  409:     // THE COMPLETION AS THIS TYPE, which is what makes the two iterations two different runs of the
  410:     // criterion rather than the same run under two labels. The volunteer's linked GitHub identity is
  411:     // a GIVEN written by the operator â€” AT-001.04 owns the link rule and is red at this tier â€” and
  412:     // without it the deployed path refuses a volunteer completion, correctly.
  413:     const request =
  414:       kind === 'ngo'
  415:         ? {
  416:             accountType: 'ngo' as const,
  417:             organizationName: `Riverside Shelter ${kind}-verify`,
  418:             acknowledgmentTextVersion: TEXT_VERSION,
  419:             ...SIGNER,
  420:           }
  421:         : { accountType: 'volunteer' as const, acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER };
  422:     if (kind === 'volunteer') await sut.linkGithubIdentity(after.session, `verify-${registered.accountId.slice(0, 8)}`);
  423: 
  424:     const completion = await sut.completeSignup(after.session, request, CLIENT_IP);
  425:     expect(completion, `the verified ${kind} could not complete signup as a ${kind}`).toMatchObject({ ok: true });
  426:     if (!completion.ok) return;
  427:     expect(
  428:       await sut.account(completion.accountId),
  429:       `the completed ${kind} account does not carry the ${kind} global type`,
  430:     ).toEqual({ id: registered.accountId, accountType: kind });
  431:   }
  432: }
  433: 
  434: /**
  435:  * AT-001.12 â€” access ends when a session expires OR is revoked, and re-authentication is the remedy.
  436:  *
  437:  * TWO ARMS, BOTH AGAINST REAL TIME AND A REAL AUTH.
  438:  *
  439:  *   REVOCATION â€” a scoped logout ends THIS session while a SIBLING session of the same account keeps
  440:  *   working. The sibling is the control that separates "this session ended" from "the account's
  441:  *   access ended", and without it the criterion's remedy clause is untested.
  442:  *
  443:  *   EXPIRY â€” the body WAITS OUT a real access token. There is nothing to command: the slot's config
  444:  *   pins a standing low `jwt_expiry` precisely so this wait is two minutes rather than an hour, and
  445:  *   no test edits configuration or restarts anything. The loop body advances a controlled clock,
  446:  *   which is a different procedure proving the same clause.
  447:  */
  448: export async function at00112(ctx: Ctx): Promise<void> {
  449:   const { w, sut } = await ctx.open();
  450:   const email = w.email('sessions');
  451:   const session = await registerConfirmAndSignIn(sut, email);
  452: 
  453:   const completion = await sut.completeSignup(
  454:     session,
  455:     { accountType: 'ngo', organizationName: 'Riverside Shelter', acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
  456:     CLIENT_IP,
  457:   );
  458:   expect(completion, 'the session under test could not complete signup, so nothing below is about a working session').toMatchObject({
  459:     ok: true,
  460:   });
  461: 
  462:   // A SIBLING SESSION, opened before the logout, standing as the control.
  463:   const sibling = await sut.signInWithEmailPassword(email, PASSWORD);
  464:   expect(sibling, 'a second sign-in for the same account failed').toMatchObject({ ok: true });
  465:   if (!sibling.ok) return;
  466:   const before = await sut.sessionsOf(session.accountId);
  467:   expect(before.length, 'the account does not hold the two sessions this arm needs').toBeGreaterThanOrEqual(2);
  468: 
  469:   await sut.signOut(session);
  470:   const after = await sut.sessionsOf(session.accountId);
  471:   expect(after.map((row) => row.sessionId), 'the signed-out session row is still there').not.toContain(session.sessionId);
  472:   expect(after.map((row) => row.sessionId), 'the scoped logout took the sibling session with it').toContain(sibling.session.sessionId);
  473: 
  474:   // THE REVOKED SESSION CANNOT WRITE. `create-organization` is the write, because no verification
  475:   // gate sits on it â€” so a refusal here is unambiguously the session layer's.
  476:   const revokedWrite = await sut.createOrganization(session, 'Riverside Shelter After Logout');
  477:   expect(revokedWrite.ok, 'a revoked session performed a write').toBe(false);
  478:   expect(await sut.organizationsNamed('Riverside Shelter After Logout'), 'the revoked write happened anyway').toEqual([]);
  479: 
  480:   // RE-AUTHENTICATION IS THE REMEDY, not a wall: a fresh sign-in works at once.
  481:   const again = await sut.signInWithEmailPassword(email, PASSWORD);
  482:   expect(again, 're-authentication after revocation was refused, so revocation ended the account rather than the session').toMatchObject(
  483:     { ok: true },
  484:   );
  485:   if (!again.ok) return;
  486: 
  487:   // THE EXPIRY ARM. Wait past the slot's standing token lifetime and assert the same write is
  488:   // refused â€” with the margin on the far side, so a token that is merely close to expiry is not
  489:   // mistaken for one that has passed it.
  490:   await wait(SLOT_JWT_EXPIRY_MS + 15_000);
  491:   const expiredWrite = await sut.createOrganization(again.session, 'Riverside Shelter After Expiry');
  492:   expect(expiredWrite.ok, 'an expired access token performed a write').toBe(false);
  493:   expect(await sut.organizationsNamed('Riverside Shelter After Expiry'), 'the expired write happened anyway').toEqual([]);
  494: 
  495:   // And the refresh token re-establishes access with NO credentials â€” which is what makes expiry a
  496:   // pause rather than a logout, and is the mechanism AT-001.13 builds its own claim on.
  497:   const refreshed = await sut.refreshSession(again.session);
