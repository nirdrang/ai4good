  111:     // classifies it, and this is the failure that makes somebody decide.
  112:     const problems = catalogConformanceProblems([...REAL_SHAPED_CATALOG, table('drafts', { selectGrantedTo: ['authenticated'] })]);
  113:     expect(problems, 'a table nobody classified must be reported').toHaveLength(1);
