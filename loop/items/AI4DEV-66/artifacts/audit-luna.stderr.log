  702:         email: found[0].email,
  703:         email_confirmed_at: confirmedAt === null ? null : new Date(confirmedAt).toISOString(),
  704:       });
  705:     },
  706: 
  707:     emailedVerificationLink: async (email) => (await linksFor(email, 'signup'))[0] ?? null,
  708: 
  709:     useVerificationLink: async (link) => {
  710:       const response = await fetch(link, { redirect: 'manual' });
  711:       // GoTrue answers a 303 to the site URL for a token it issued AND for one it never issued â€” the
  712:       // tampered probe in AI4DEV-59's proof measured that. So the STATUS is not the oracle; the
  713:       // column is, and the body that cares reads `emailVerified` afterwards.
  714:       return { ok: response.status < 400 };
  715:     },
