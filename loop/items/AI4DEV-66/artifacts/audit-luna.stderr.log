 1869:  * IT IS NOT A SKIP AND IT IS NOT A STUB. `CapabilityPending` carrying an exact name is the same
 1870:  * shape `pendingMethodProxy` throws and the same shape a `capability-pending` declaration rebuilds,
 1871:  * so the id is red in a form the machinery matches from position 0 â€” and the declaration has to say
 1872:  * WHICH capability is missing. A body that instead asserted the half of the criterion it CAN reach
 1873:  * would be reporting a green for a criterion it does not prove, which is the whole failure mode this
 1874:  * tier exists to remove.
 1875:  */
 1876: function refusesWith(capability: string): (ctx: Ctx) => Promise<void> {
 1877:   return async (ctx: Ctx): Promise<void> => {
 1878:     await ctx.open();
 1879:     throw new CapabilityPending([capability]);
 1880:   };
 1881: }
