  218: /**
  219:  * WHAT A POSTGRES REFUSAL CARRIES â€” the SQLSTATE and the sentence, and WHERE THE SQLSTATE REALLY
  220:  * LIVES WAS MEASURED RATHER THAN ASSUMED.
  221:  *
  222:  * The operator methods below drive SQL directly, so a refused write arrives as a thrown error rather
  223:  * than as a status and a body. The obvious field is wrong on this client: `loop/items/AI4DEV-62`'s
  224:  * verify-first probe, answer (d), dumped a real refusal's own properties on the slot stack and found
  225:  *
  226:  *   name `PostgresError`, code `ERR_POSTGRES_SERVER_ERROR`, **errno `42501`**, severity `ERROR`,
  227:  *   where `PL/pgSQL function public.org_membership_grantee_must_be_ngo() line 24 at RAISE`
  228:  *
  229:  * â€” so `code` is the client's own error CLASS and `errno` is the SQLSTATE the migration raised. A
  230:  * classification written against `code === '42501'` would have matched nothing, every refusal would
  231:  * have fallen through to `refused`, and two acceptance criteria would have gone red for a reason
  232:  * that had nothing to do with the product.
  233:  *
  234:  * SO EVERY CANDIDATE FIELD IS READ AND THE ONE THAT LOOKS LIKE A SQLSTATE WINS â€” five characters,
  235:  * digits and capitals, which is the format's own shape. A client that reports it somewhere else
  236:  * again simply yields no code, and the call sites below fall back on the sentence.
  237:  */
  238: function databaseRefusal(error: unknown): { code: string; message: string } {
  239:   const carrier = error as Record<string, unknown> | null;
  240:   let code = '';
  241:   for (const field of ['errno', 'errcode', 'code'] as const) {
  242:     const value = carrier?.[field];
  243:     if (typeof value === 'string' && /^[0-9A-Z]{5}$/.test(value)) {
  244:       code = value;
  245:       break;
  246:     }
  247:   }
  248:   const message = typeof carrier?.message === 'string' ? carrier.message : String(error);
  249:   return { code, message };
  250: }
