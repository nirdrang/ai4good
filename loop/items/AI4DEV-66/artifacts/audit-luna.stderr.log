  987: 
  988:     /**
  989:      * EVERY TABLE IN `public`, WITH ITS CLIENT GRANTS AND ITS SELECT POLICIES â€” the conformance
  990:      * arm's witness, read out of the live catalog over the operator connection.
  991:      *
  992:      * IT IS AN OUT-OF-BAND READ. The witness is the database's own catalog rather than something the
  993:      * system under test reports about itself, which is the same posture `_source-scan.ts` takes
  994:      * towards `src/routes/`. The two reads are separate rather than one join, because a join would
  995:      * drop a table that holds no policy â€” and a table nobody has classified is exactly what the arm
  996:      * exists to catch.
  997:      *
  998:      * THE GRANT HALF ASKS THE EFFECTIVE QUESTION, AND IT DOES SO BECAUSE THE GRANT CATALOGUE CANNOT
  999:      * ANSWER IT. This read used to select from `information_schema.role_table_grants` filtered to
 1000:      * `grantee in ('anon','authenticated')`. That view answers "who was NAMED in a grant statement",
 1001:      * and PostgreSQL documents that it omits grants made to `PUBLIC` altogether. So a table opened
 1002:      * with `grant select â€¦ to public` â€” which every client role holds â€” would have been reported here
 1003:      * as granted to nobody, and the conformance arm would have accepted it as unreachable while every
 1004:      * signed-in caller could read it. `has_table_privilege(<role>, c.oid, 'SELECT')` answers whether
 1005:      * the role holds `select` BY ANY ROUTE: a direct grant, a grant to `PUBLIC`, or role inheritance.
 1006:      * That is the question the rule was always asking, and this is the measured reason for the change
 1007:      * rather than a preference between two catalogues.
 1008:      *
 1009:      * `cmd` IS FILTERED TO THE POLICIES THAT REACH A READ. `pg_policies.cmd` is `SELECT`, `INSERT`,
 1010:      * `UPDATE`, `DELETE` or `ALL`, and an `ALL` policy governs reads as well â€” so both are kept and
 1011:      * the write-only kinds are left out.
 1012:      */
 1013:     publicSchemaCatalog: async (): Promise<CatalogTable[]> => {
 1014:       const tables = await rows<{
 1015:         table_name: string;
 1016:         row_level_security: boolean;
 1017:         anon_selects: boolean;
 1018:         authenticated_selects: boolean;
 1019:       }>(
 1020:         sql`select c.relname as table_name,
 1021:                    c.relrowsecurity as row_level_security,
 1022:                    has_table_privilege('anon', c.oid, 'SELECT') as anon_selects,
 1023:                    has_table_privilege('authenticated', c.oid, 'SELECT') as authenticated_selects
 1024:               from pg_class c
 1025:               join pg_namespace n on n.oid = c.relnamespace
 1026:              where n.nspname = 'public' and c.relkind = 'r'
 1027:              order by c.relname`,
 1028:       );
 1029:       const policies = await rows<{ table_name: string; policy_name: string; roles: unknown; qual: string | null; cmd: string }>(
 1030:         sql`select tablename as table_name, policyname as policy_name, roles, qual, cmd
 1031:               from pg_policies
 1032:              where schemaname = 'public'
 1033:              order by tablename, policyname`,
 1034:       );
 1035: 
 1036:       return tables.map((table) => ({
 1037:         table: String(table.table_name),
 1038:         selectGrantedTo: [
 1039:           ...(table.anon_selects === true ? ['anon'] : []),
 1040:           ...(table.authenticated_selects === true ? ['authenticated'] : []),
 1041:         ].sort(),
 1042:         rowLevelSecurity: table.row_level_security === true,
 1043:         selectPolicies: policies
 1044:           .filter((policy) => String(policy.table_name) === String(table.table_name))
 1045:           .filter((policy) => String(policy.cmd) === 'SELECT' || String(policy.cmd) === 'ALL')
 1046:           .map((policy) => ({
 1047:             name: String(policy.policy_name),
 1048:             roles: pgRoleList(policy.roles),
 1049:             qual: policy.qual === null ? null : String(policy.qual),
 1050:           })),
 1051:       }));
 1052:     },
 1053: 
 1054:     /* -------------------------------------------------------- read-back, as the operator, over SQL */
 1055: 
 1056:     account: async (accountId): Promise<AccountRow | null> => {
 1057:       const found = await rows<{ id: string; account_type: AccountRow['accountType'] }>(
 1058:         sql`select id, account_type from public.accounts where id = ${accountId}::uuid`,
 1059:       );
 1060:       return found.length === 1 ? { id: String(found[0].id), accountType: found[0].account_type } : null;
 1061:     },
 1062: 
 1063:     organization: async (organizationId): Promise<OrganizationRow | null> => {
