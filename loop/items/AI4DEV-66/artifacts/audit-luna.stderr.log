  661:     completePasswordReset: async (link, newPassword) => {
  662:       // THE FLOW SHAPE IS MEASURED RATHER THAN REMEMBERED. AI4DEV-60's proof found the implicit
  663:       // fragment on this CLI version and recorded that a PKCE code appears on others; following the
  664:       // link and reading what comes back is what keeps this working across either.
  665:       const response = await fetch(link, { redirect: 'manual' });
  666:       const location = response.headers.get('location') ?? '';
  667:       const fragment = location.includes('#') ? location.slice(location.indexOf('#') + 1) : '';
  668:       const accessToken = new URLSearchParams(fragment).get('access_token') ?? '';
  669:       if (!accessToken) return { ok: false };
  670:       const update = await fetch(`${api}/auth/v1/user`, {
  671:         method: 'PUT',
  672:         headers: { apikey: slot.anonKey, Authorization: `Bearer ${accessToken}`, 'Content-Type': 'application/json' },
  673:         body: JSON.stringify({ password: newPassword }),
