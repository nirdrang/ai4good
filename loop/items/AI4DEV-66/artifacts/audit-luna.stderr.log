  641:       if (!accessToken) return { ok: false, reason: 'the refresh answered 200 with no access token' };
  642:       const sessionId = sessionIdOf(accessToken);
  643:       sessions.set(sessionId, { accessToken, refreshToken: String(json.refresh_token ?? tokens.refreshToken) });
