   94:         qual: `((assigned_volunteer_id = ${OWN_UID}) AND viewer_is_volunteer())`,
   95:       },
   96:       { name: 'projects_select_platform_admin', roles: ['authenticated'], qual: 'viewer_is_platform_admin()' },
   97:     ],
   98:   }),
