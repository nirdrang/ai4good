   27: import { readdirSync } from 'node:fs';
   28: import { fileURLToPath } from 'node:url';
   29: 
   30: import { undeclaredRoutes } from '../../../../supabase/functions/_shared/route-visibility.ts';
   31: 
   32: /** The repository root, resolved from THIS file, so the answer never depends on the caller's cwd. */
   33: const REPO_ROOT = fileURLToPath(new URL('../../../../', import.meta.url));
   34: 
   35: /** Every file and directory name under `src/routes/`, recursively, relative to that directory. */
   36: function routeDirectoryEntries(): string[] {
   37:   const root = new URL('../../../../src/routes/', import.meta.url);
   38:   const found: string[] = [];
   39:   const walk = (relative: string): void => {
   40:     for (const entry of readdirSync(new URL(relative, root), { withFileTypes: true })) {
   41:       const path = `${relative}${entry.name}`;
   42:       found.push(path);
   43:       if (entry.isDirectory()) walk(`${path}/`);
   44:     }
   45:   };
   46:   walk('');
   47:   return found;
   48: }
   49: 
   50: /**
   51:  * Every route in this tree that the shipped registry does not classify.
   52:  *
   53:  * AN EMPTY ARRAY IS THE ASSERTION AT-001.24's loop body makes. It THROWS rather than returning
   54:  * nothing when `src/routes/` cannot be read, and again when the directory is empty: an oracle that
   55:  * answered "nothing undeclared" because it found no directory would report every declaration complete
   56:  * while measuring nothing at all. That is `_source-scan.ts`'s exact posture and this repository's
   57:  * standing rule that a negative is re-measured before it is believed â€” here the instrument says so
   58:  * itself rather than being re-measured after the fact.
   59:  */
   60: export function undeclaredRoutesInTree(): string[] {
   61:   let entries: string[];
   62:   try {
   63:     entries = routeDirectoryEntries();
   64:   } catch (error) {
   65:     throw new Error(
   66:       `AT-001.24's route arm could not read src/routes/ under ${REPO_ROOT} â€” the absence it reports would be the ` +
   67:         `instrument's, not the product's: ${(error as Error).message}`,
   68:     );
   69:   }
   70:   if (entries.length === 0) {
   71:     throw new Error("AT-001.24's route arm found src/routes/ empty, which no checkout of this tree is â€” refusing to report an absence");
   72:   }
   73:   return undeclaredRoutes(entries);
   74: }

