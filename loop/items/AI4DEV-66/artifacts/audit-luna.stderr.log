    1: /**
    2:  * `public-project-page` â€” AT-001.22's "the public project page remains visible" and AT-001.24's
    3:  * "only public surfaces render (listings, project pages)".
    4:  *
    5:  * ============================================================================================
    6:  * THE FIRST `verify_jwt = false` FUNCTION IN THIS REPOSITORY, AND THE ONLY ONE
    7:  * ============================================================================================
    8:  *
    9:  * Every other function here operates for an already-authenticated caller and says so in
   10:  * `supabase/config.toml`. This one answers a logged-out visitor, because that is the criterion: a
   11:  * denial that also hid the public page would satisfy AT-001.22's first half and break its second.
   12:  *
   13:  * IT REVEALS THAT A PROJECT EXISTS, DELIBERATELY. AT-001.21's clause is "no existence oracle BEYOND
   14:  * PUBLIC SURFACES", and this IS the public surface â€” the carve-out the criterion writes for itself.
   15:  * Keeping it a SEPARATE FUNCTION is what stops that carve-out contaminating the no-oracle test: the
   16:  * two authenticated surfaces have one refusal constant and no public branch to fall through to.
   17:  *
   18:  * WHAT IT MAY ANSWER IS THE SHARED MODULE'S â€” `publicProjectView` in `../_shared/visibility.ts`
   19:  * builds the projection field by field and copies nothing wholesale, so a column added to
   20:  * `public.projects` cannot arrive here by accident. This file chooses no fields at all.
   21:  *
   22:  * THE READ ORDER IS NOT LOAD-BEARING HERE, and saying so is the point rather than an omission. This
   23:  * surface makes no access decision â€” it answers everyone the same way â€” so there is no second answer
   24:  * for an ordering to keep indistinguishable from the first. It reads the project, then the
   25:  * organisation whose name the projection carries.
   26:  */
   27: 
   28: import {
   29:   edgeHandler,
   30:   json,
   31:   readJsonBody,
   32:   readRows,
   33:   refusal,
   34:   requireEnv,
   35: } from '../_shared/edge.ts';
   36: import { TENANT_NOT_FOUND, publicProjectView } from '../_shared/visibility.ts';
   37: 
   38: const SUPABASE_URL = requireEnv('SUPABASE_URL');
   39: const SERVICE_ROLE_KEY = requireEnv('SUPABASE_SERVICE_ROLE_KEY', 'SUPABASE_SECRET_KEY');
   40: 
   41: /** An outage, naming no identifier â€” the same shape the two authenticated surfaces use. */
   42: function readFailed(): Response {
   43:   return json(
   44:     { ok: false, reason: 'the public project page could not read what it needs, so no answer was made' },
   45:     502,
   46:   );
   47: }
   48: 
   49: Deno.serve(edgeHandler('public-project-page', async (request: Request): Promise<Response> => {
   50:   if (request.method !== 'POST') return refusal('public-project-page accepts POST only', 405);
   51: 
   52:   // NO `resolveCaller` CALL, and its absence is the substance of this function. There is nobody to
   53:   // resolve: an anonymous visitor and a signed-in one receive the same answer, so asking Auth who is
   54:   // calling would be a round trip whose result nothing may read.
   55:   const body = await readJsonBody(request);
   56:   if (!body.ok) return refusal(body.reason, 400);
   57: 
   58:   const rawId = body.value.projectId;
   59:   if (typeof rawId !== 'string' || rawId.trim() === '') {
   60:     return refusal('a public project page read must name the project to read', 400);
   61:   }
   62:   const projectId = rawId.trim();
   63: 
   64:   const projectRead = await readRows(
   65:     SUPABASE_URL,
   66:     SERVICE_ROLE_KEY,
   67:     `projects?id=eq.${encodeURIComponent(projectId)}&select=id,org_id,name`,
   68:   );
   69:   if (!projectRead.ok) return readFailed();
   70:   const project = projectRead.rows[0];
   71:   if (project === undefined) return json(TENANT_NOT_FOUND.body, TENANT_NOT_FOUND.status);
   72: 
   73:   const organizationRead = await readRows(
   74:     SUPABASE_URL,
   75:     SERVICE_ROLE_KEY,
   76:     `organizations?id=eq.${encodeURIComponent(String(project.org_id))}&select=name`,
   77:   );
   78:   if (!organizationRead.ok) return readFailed();
   79:   const organization = organizationRead.rows[0];
   80:   // A project whose organisation row is gone has no public page to render â€” the same not-found
   81:   // answer, because a page naming no organisation would be a projection with a hole in it.
   82:   if (organization === undefined) return json(TENANT_NOT_FOUND.body, TENANT_NOT_FOUND.status);
   83: 
   84:   const view = publicProjectView(
   85:     { id: String(project.id), name: String(project.name) },
   86:     { name: String(organization.name) },
   87:   );
   88:   return json({ ok: true, ...view }, 200);
   89: }));

