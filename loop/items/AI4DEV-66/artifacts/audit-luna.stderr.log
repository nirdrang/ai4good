 504:       expect(workspace.ok, 'the ASSIGNED volunteer was refused its own project workspace').toBe(true);
 505:       if (!workspace.ok) return;
 506:       expect(workspace.status, 'the allowed workspace read did not answer 200').toBe(200);
 507:       expect(workspace.value, 'the workspace does not hold the project working data it is supposed to').toEqual({
 508:         projectId: assignedProject.id,
