1792: /* -------------------------------------------------------- the ids that refuse, and what they name */
1793: 
1794: /**
1795:  * A refusal body: it opens a world â€” so the run is real and the id is genuinely exercised â€” and then
1796:  * refuses with the capability this environment does not hold.
1797:  *
1798:  * IT IS NOT A SKIP AND IT IS NOT A STUB. `CapabilityPending` carrying an exact name is the same
1799:  * shape `pendingMethodProxy` throws and the same shape a `capability-pending` declaration rebuilds,
1800:  * so the id is red in a form the machinery matches from position 0 â€” and the declaration has to say
1801:  * WHICH capability is missing. A body that instead asserted the half of the criterion it CAN reach
1802:  * would be reporting a green for a criterion it does not prove, which is the whole failure mode this
1803:  * tier exists to remove.
1804:  */
1805: function refusesWith(capability: string): (ctx: Ctx) => Promise<void> {
1806:   return async (ctx: Ctx): Promise<void> => {
1807:     await ctx.open();
1808:     throw new CapabilityPending([capability]);
1809:   };
1810: }
1811: 
1812: /**
1813:  * AT-001.05 â€” the imported GitHub statistics.
1814:  *
1815:  * WHY THIS REFUSES RATHER THAN GOING GREEN, when the live path would in fact populate the row. The
1816:  * criterion's words are "the imported PUBLIC STATS (top languages, repository count, contribution
1817:  * summary) are observably populated". What the deployed completion imports is
1818:  * `stubGithubStatsFor` â€” a shipped stub whose own output says "no GitHub API was called to produce
1819:  * this". The row really is populated, and the statistics in it are fabricated, so a green at the
1820:  * tier whose meaning is "proved for real" would be claiming the one thing that is not true.
1821:  *
1822:  * The stub is RATIFIED by the decomposition manifest's cross-contract ("stub import fixture until
1823:  * W3"), and the loop tier's green over it is honest for that reason. This tier is the one that
1824:  * cannot say it.
1825:  */
1826: export const at00105 = refusesWith('vendors.github-public-statistics');
1827: 
1828: /**
1829:  * AT-001.10 â€” the Discovery send is blocked with verification named as the remedy.
1830:  *
1831:  * NO DISCOVERY SEND ROUTE EXISTS IN THIS REPOSITORY, at any tier. The route is REQ-002/004's; what
1832:  * this requirement ships is the DECISION that route must consult, and the loop tier puts that
1833:  * decision on a tested path through a stand-in surface. At this tier there is no route to call and
1834:  * nothing to enforce anything, so there is nothing a live green could be about.
1835:  */
1836: export const at00110 = refusesWith('sut.accounts.sendDiscoveryMessage');
1837: 
1838: /**
1839:  * AT-001.24 â€” a logged-out visitor renders public surfaces only, and every authenticated surface
1840:  * redirects to sign-in.
1841:  *
1842:  * WHY THIS REFUSES RATHER THAN GOING GREEN, when the loop tier asserts three real things about the
1843:  * same criterion. THE CRITERION'S OUTCOME IS A RENDERING. "Only public surfaces render" and "every
1844:  * authenticated surface redirects to sign-in" are statements about what a browser shows a visitor,
1845:  * and there is no browser here, no screen to render and no router to redirect: `src/routes/` holds
1846:  * one page and a root layout, and continuous integration fails any pull request whose file list
