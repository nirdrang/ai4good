 337:       );
 338:       expect(assigned, 'the assigned volunteer could not complete signup, so there is no control').toMatchObject({ ok: true });
 339:       if (!assigned.ok) return;
 340: 
 341:       const unassigned = await sut.registerWithEmailPassword(w.email('unassigned-volunteer-22'), PASSWORD);
 342:       await sut.linkGithubIdentity(unassigned, 'unassigned-volunteer-22-handle');
 343:       const outsider = await sut.completeSignup(
 344:         unassigned,
 345:         { accountType: 'volunteer', acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
