 365:       const allowed = await sut.projectWorkspace(assignedSession, project.id);
 366:       expect(allowed.ok, 'the ASSIGNED volunteer was refused its own project workspace').toBe(true);
 367:       if (!allowed.ok) return;
 368:       expect(allowed.status, 'the allowed workspace read did not answer 200').toBe(200);
