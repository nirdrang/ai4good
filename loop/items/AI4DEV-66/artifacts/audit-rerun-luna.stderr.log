1497:  * constraint rather than writing the canary. The canary has to be this run's own table.
1498:  */
1499: async function writeCanary(slot: number, status: StackStatus, note: string): Promise<void> {
1500:   await withSlotSql(slot, status, async (sql) => {
1501:     await sql`drop table if exists public.spike_canary`;
1502:     await sql`create table public.spike_canary (note text)`;
1503:     await sql`insert into public.spike_canary (note) values (${note})`;
1504:   });
