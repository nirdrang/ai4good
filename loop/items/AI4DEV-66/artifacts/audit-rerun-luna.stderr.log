  91: /** THE DECLARATION THIS TREE MAKES â€” the two lists above, and the one `catalogConformanceProblems` uses. */
  92: export const DECLARED_CATALOG: CatalogDeclaration = { unreachableByClientRoles, tenantIsolated };
  93: 
  94: /**
  95:  * THE POLICY HELPERS A `qual` MAY NAME â€” the three `security definer` functions the migrations ship.
  96:  *
  97:  * A policy naming one of these is making a claim this repository can point at. A policy naming
  98:  * neither, and no tenant key column either, is asking to be read as isolation on the strength of
  99:  * existing, which is the thing gate-1 ruling 8 refuses.
 100:  */
 101: const KNOWN_POLICY_HELPERS: readonly string[] = [
 102:   'viewer_is_org_member',
 103:   'viewer_is_platform_admin',
 104:   'viewer_is_volunteer',
 105: ];
 106: 
 107: /**
 108:  * THE TWO CLIENT ROLES THE WITNESS ANSWERS ABOUT â€” the roles a client key can act as.
 109:  *
 110:  * The grant arm of clause 2 compares against this list directly, and that is correct because
 111:  * `selectGrantedTo` is an EFFECTIVE privilege answer rather than a list of grantees: `_live.ts` asks
 112:  * `has_table_privilege` per role, which already accounts for a grant made to `PUBLIC` and for role
 113:  * inheritance. `'public'` is deliberately NOT a member of this list â€” the witness can never emit it,
 114:  * and a branch nothing can drive is the thing this repository distrusts. The POLICY arms below are a
 115:  * different question: `pg_policies.roles` reports the role names a policy was written `to`, where
 116:  * `public` really can appear and really does reach both client roles.
 117:  */
 118: const CLIENT_ROLES: readonly string[] = ['anon', 'authenticated'];
 119: 
 120: /** Whether a policy's role list reaches any client role â€” `public` grants to every role, `anon` included. */
 121: function reachesClientRole(roles: readonly string[]): boolean {
 122:   return roles.some((role) => role === 'public' || CLIENT_ROLES.includes(role));
 123: }
 124: 
 125: /** Whether a policy's role list reaches an authenticated caller specifically. */
 126: function reachesAuthenticated(roles: readonly string[]): boolean {
 127:   return roles.some((role) => role === 'public' || role === 'authenticated');
 128: }
 129: 
 130: /**
 131:  * Whether a `qual` NAMES an identifier â€” as a whole word, never as a substring.
 132:  *
 133:  * THE WORD BOUNDARY IS LOAD-BEARING, and a substring test would have made one declaration vacuous:
 134:  * `organizations`'s tenant key is `id`, and `id` appears inside `assigned_volunteer_id`,
 135:  * `account_id` and `org_id`. A substring test would therefore accept any qual at all on that table
 136:  * while looking like a check.
 137:  */
 138: function namesIdentifier(qual: string, identifier: string): boolean {
 139:   return new RegExp(`(^|[^A-Za-z0-9_])${identifier}([^A-Za-z0-9_]|$)`).test(qual);
 140: }
 141: 
 142: /** Whether a `qual` is the trivially open one. `using (true)` deparses as `true`, sometimes parenthesised. */
 143: function isTriviallyOpen(qual: string): boolean {
 144:   return qual.trim().replace(/^\(+|\)+$/g, '').trim().toLowerCase() === 'true';
 145: }
 146: 
 147: /**
 148:  * EVERY WAY THE LIVE CATALOG DISAGREES WITH THE DECLARATION â€” an empty array is the assertion.
 149:  *
 150:  * The three checks are gate-1 ruling 8's, in its order:
 151:  *
 152:  *   1. Every table in `public` appears in EXACTLY ONE of the two declared lists. In neither, or in
 153:  *      both, fails. This is the tripwire: a table a later requirement lands arrives in neither list
 154:  *      and fails the build until somebody decides which it is.
 155:  *   2. A table declared unreachable really is unreachable, for one of TWO stated reasons â€” no `select`
 156:  *      grant to a client role, or row-level security on with no `select` policy reaching one. Both
 157:  *      arms are needed and the declaration's own comment says which table proves which.
 158:  *   3. A table declared isolated has row-level security ON and an effective `select` grant for
 159:  *      `authenticated`; it carries at least one `select` policy an authenticated caller can be judged
 160:  *      by; no `select` policy on it is trivially open; and every `select` policy on it names a known
 161:  *      helper or one of that table's declared tenant key columns.
 162:  *
 163:  *      THE FIRST TWO OF THOSE ARE THE SAME DEFECT FROM OPPOSITE SIDES, and neither is reachable
 164:  *      through the policy checks. A POLICY ON A TABLE WITH ROW-LEVEL SECURITY OFF IS INERT: the four
 165:  *      policies this leaf ships, with `relrowsecurity` false, would satisfy every other check while
 166:  *      every row is readable by any caller holding the grant. That is `using (true)` reached by a
 167:  *      different door. AND A TABLE WITH NO EFFECTIVE `select` GRANT FOR `authenticated` denies the
 168:  *      rightful tenant everything, so every denial arm over it passes while proving nothing â€” the
 169:  *      failure gate-2 ruling 3 fixed from the acceptance side, seen from the catalog side.
 170:  *
 171:  * EACH PROBLEM IS A SENTENCE NAMING THE TABLE AND WHAT WAS MEASURED, because the reader of a failure
 172:  * is somebody who has just added a table and does not yet know this arm exists.
 173:  *
 174:  * THE DECLARATION IS A PARAMETER, AND ONE OF THE THREE CHECKS CANNOT BE DRIVEN WITHOUT THAT. Clause 1
 175:  * fails a table declared in BOTH lists, and the declaration this tree makes has no overlap and must
 176:  * not gain one â€” so no `catalog` argument alone can reach that branch, and a defensive branch nothing
 177:  * drives is exactly what this repository has learned to distrust. `catalogConformanceProblems` below
 178:  * is the entry point the acceptance body calls, with the shape and the single argument the plan
 179:  * names; this is the same rule with the declaration handed in, so the selftest can drive a
 180:  * declaration that contradicts itself without this tree ever holding one.
 181:  */
 182: export function catalogProblemsAgainst(catalog: readonly CatalogTable[], declaration: CatalogDeclaration): string[] {
 183:   const problems: string[] = [];
 184:   const isolatedByTable = new Map(declaration.tenantIsolated.map((entry) => [entry.table, entry]));
 185: 
 186:   for (const table of catalog) {
 187:     const declaredUnreachable = declaration.unreachableByClientRoles.includes(table.table);
 188:     const declaredIsolated = isolatedByTable.has(table.table);
 189: 
 190:     /* --- 1. exactly one list --------------------------------------------------------------- */
 191: 
 192:     if (declaredUnreachable && declaredIsolated) {
 193:       problems.push(
 194:         `public.${table.table} is declared BOTH unreachable by client roles and tenant-isolated, and it cannot be both`,
 195:       );
 196:       continue;
 197:     }
 198:     if (!declaredUnreachable && !declaredIsolated) {
 199:       problems.push(
 200:         `public.${table.table} exists and is declared in neither list â€” classify it in ` +
 201:           `tests/at/suites/req-001/_catalog-conformance.ts as unreachable by client roles or as tenant-isolated`,
 202:       );
 203:       continue;
 204:     }
 205: 
 206:     const selectPolicies = table.selectPolicies;
 207: 
 208:     /* --- 2. unreachable, for a stated reason ------------------------------------------------ */
 209: 
 210:     if (declaredUnreachable) {
 211:       const noClientGrant = !table.selectGrantedTo.some((role) => CLIENT_ROLES.includes(role));
 212:       const noClientPolicy = table.rowLevelSecurity && !selectPolicies.some((policy) => reachesClientRole(policy.roles));
 213:       if (!noClientGrant && !noClientPolicy) {
 214:         problems.push(
 215:           `public.${table.table} is declared unreachable by client roles and is reachable: it grants select to ` +
 216:             `[${table.selectGrantedTo.join(', ')}] and it carries ${selectPolicies.length} select policy or policies ` +
 217:             `reaching a client role, with row-level security ${table.rowLevelSecurity ? 'on' : 'OFF'}`,
 218:         );
 219:       }
 220:       continue;
 221:     }
 222: 
 223:     /* --- 3. isolated, and not trivially open ------------------------------------------------ */
 224: 
 225:     const declared = isolatedByTable.get(table.table)!;
 226:     if (!table.rowLevelSecurity) {
 227:       problems.push(
 228:         `public.${table.table} is declared tenant-isolated and row-level security is OFF on it, so its ` +
 229:           `${selectPolicies.length} select policy or policies are inert and every row is readable by any caller ` +
 230:           `holding the select grant`,
 231:       );
 232:     }
 233:     if (!table.selectGrantedTo.includes('authenticated')) {
 234:       problems.push(
 235:         `public.${table.table} is declared tenant-isolated and no effective select grant reaches authenticated ` +
 236:           `(it grants select to [${table.selectGrantedTo.join(', ')}]), so the rightful tenant reads nothing and ` +
 237:           `every denial over it proves nothing`,
 238:       );
 239:     }
 240:     if (!selectPolicies.some((policy) => reachesAuthenticated(policy.roles))) {
 241:       problems.push(
 242:         `public.${table.table} is declared tenant-isolated and carries no select policy an authenticated caller ` +
 243:           `is judged by, so the rightful tenant reads nothing and every denial over it proves nothing`,
 244:       );
 245:     }
 246:     for (const policy of selectPolicies) {
 247:       if (policy.qual === null) {
 248:         problems.push(
 249:           `public.${table.table}'s select policy ${policy.name} carries no using expression, so nothing states which ` +
 250:             `rows it admits`,
 251:         );
 252:         continue;
 253:       }
 254:       if (isTriviallyOpen(policy.qual)) {
 255:         problems.push(
 256:           `public.${table.table}'s select policy ${policy.name} is using (true), which admits every row while ` +
 257:             `satisfying "the table carries a select policy"`,
 258:         );
 259:         continue;
 260:       }
 261:       const named =
 262:         KNOWN_POLICY_HELPERS.some((helper) => namesIdentifier(policy.qual!, helper)) ||
 263:         declared.tenantKeyColumns.some((column) => namesIdentifier(policy.qual!, column));
 264:       if (!named) {
 265:         problems.push(
 266:           `public.${table.table}'s select policy ${policy.name} names neither a known policy helper ` +
 267:             `(${KNOWN_POLICY_HELPERS.join(', ')}) nor a declared tenant key column ` +
 268:             `(${declared.tenantKeyColumns.join(', ')}): ${policy.qual}`,
 269:         );
 270:       }
 271:     }
 272:   }
 273: 
 274:   return problems;
 275: }
 276: 
 277: /**
 278:  * EVERY WAY THE LIVE CATALOG DISAGREES WITH THE DECLARATION THIS TREE MAKES â€” the arm's entry point,
 279:  * and the one AT-001.21's integration body calls.
 280:  *
 281:  * An empty array is the assertion. The rule is `catalogProblemsAgainst` above; this fixes its second
 282:  * argument at `DECLARED_CATALOG` so no caller can grade the live catalog against a declaration
 283:  * somebody invented for the occasion.
 284:  */
 285: export function catalogConformanceProblems(catalog: readonly CatalogTable[]): string[] {
 286:   return catalogProblemsAgainst(catalog, DECLARED_CATALOG);
 287: }

