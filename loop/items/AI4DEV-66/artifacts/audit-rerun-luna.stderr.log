 212: function isIpv6(value: string): boolean {
 213:   if (value.split('::').length > 2) return false;
 214:   const abbreviated = value.includes('::');
 215:   const groups = value.split(':').filter((group) => group !== '');
 216:   if (groups.length === 0) return abbreviated; // `::` itself
 217:   const last = groups[groups.length - 1];
 218:   // `::ffff:127.0.0.1` is a legal IPv6 address whose final element is a dotted IPv4 and occupies
 219:   // two of the eight groups.
 220:   const trailingIpv4 = last.includes('.');

