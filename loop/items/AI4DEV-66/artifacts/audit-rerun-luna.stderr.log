1521: function dockerLines(args: string[]): string[] {
1522:   const res = spawnSync('docker', args, { env: childEnv(), encoding: 'utf8' });
1523:   if (res.error) throw new Error(`docker could not be run (${diagnostic((res.error as Error).message)})`);
1524:   if (res.status !== 0) throw new Error(`\`docker ${args.slice(0, 2).join(' ')}\` exited ${res.status}: ${diagnostic(res.stderr) || '(no error output)'}`);
1525:   return (res.stdout ?? '')
1526:     .split('\n')
1527:     .map((line) => line.trim())
1528:     .filter(Boolean);
1529: }
