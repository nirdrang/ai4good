 232: atTest(
 233:   'AT-001.22',
 234:   'an unassigned volunteer is denied a project non-public data while the public page stays visible',
 235:   // THE `ui` TAG, for the same reason AT-001.21 carries it (gate-1 ruling 1): "the public project
 236:   // page remains visible" names a PAGE, and there is no page in this tree — only its API surface.
 237:   { surface: 'ui', timeoutMs: { integration: INTEGRATION_TIMEOUT_MS } },
 238:   {
 239:     default: async ({ open }) => {
 240:       const { w, sut } = await open();
 241:       const ORGANIZATION_NAME = 'Riverside Shelter 22';
 242:       const PROJECT_NAME = 'Riverside Shelter Website 22';
 243: 
 244:       // THE OWNING NGO, through the product path.
 245:       const ngo = await sut.registerWithEmailPassword(w.email('project-owner-22'), PASSWORD);
 246:       const owner = await sut.completeSignup(
 247:         ngo,
 248:         { accountType: 'ngo', organizationName: ORGANIZATION_NAME, acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
 249:         CLIENT_IP,
 250:       );
 251:       expect(owner, 'the NGO could not complete signup, so there is no organisation to hold a project').toMatchObject({ ok: true });
 252:       if (!owner.ok || owner.organizationId === null) return;
 253: 
 254:       // TWO VOLUNTEERS, both real accounts through the product path. The difference between them is
 255:       // the ONE fact the criterion turns on: which of them holds the project's developer seat.
 256:       const assignedSession = await sut.registerWithEmailPassword(w.email('assigned-volunteer-22'), PASSWORD);
 257:       await sut.linkGithubIdentity(assignedSession, 'assigned-volunteer-22-handle');
 258:       const assigned = await sut.completeSignup(
 259:         assignedSession,
 260:         { accountType: 'volunteer', acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
 261:         CLIENT_IP,
 262:       );
 263:       expect(assigned, 'the assigned volunteer could not complete signup, so there is no control').toMatchObject({ ok: true });
 264:       if (!assigned.ok) return;
 265: 
 266:       const unassigned = await sut.registerWithEmailPassword(w.email('unassigned-volunteer-22'), PASSWORD);
 267:       await sut.linkGithubIdentity(unassigned, 'unassigned-volunteer-22-handle');
 268:       const outsider = await sut.completeSignup(
 269:         unassigned,
 270:         { accountType: 'volunteer', acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
 271:         CLIENT_IP,
 272:       );
 273:       expect(outsider, 'the unassigned volunteer could not complete signup, so there is nobody to be denied').toMatchObject({
 274:         ok: true,
 275:       });
 276:       if (!outsider.ok) return;
 277: 
 278:       // THE PROJECT AND ITS SEAT — operator-provisioned, because no product path creates a project
 279:       // or attaches a volunteer at either tier.
 280:       const project = await sut.createProjectAsOperator(owner.organizationId, PROJECT_NAME);
 281:       const seated = await sut.assignVolunteerAsOperator(project.id, assigned.accountId);
 282:       expect(seated, 'the volunteer could not be attached, so this criterion has no Given').toMatchObject({ ok: true });
 283:       expect(await sut.projectAssignment(project.id), 'the seat does not hold the assigned volunteer').toMatchObject({
 284:         assignedVolunteerId: assigned.accountId,
 285:       });
 286: 
 287:       // (1) THE CONTROL COMES FIRST — the ASSIGNED volunteer reads the workspace. A surface that
 288:       // refused everybody would satisfy every denial below while proving nothing, so the allowed
 289:       // read is asserted before any refusal is measured.
 290:       const allowed = await sut.projectWorkspace(assignedSession, project.id);
 291:       expect(allowed.ok, 'the ASSIGNED volunteer was refused its own project workspace').toBe(true);
 292:       if (!allowed.ok) return;
 293:       expect(allowed.status, 'the allowed workspace read did not answer 200').toBe(200);
 294:       expect(allowed.value, 'the workspace does not hold the project working data it is supposed to').toEqual({
 295:         projectId: project.id,
 296:         projectName: PROJECT_NAME,
 297:         organizationId: owner.organizationId,
 298:         assignedVolunteerId: assigned.accountId,
 299:       });
 300: 
 301:       // (2) THE UNASSIGNED VOLUNTEER IS REFUSED THE SAME WORKSPACE.
 302:       const refused = await sut.projectWorkspace(unassigned, project.id);
 303:       expect(refused.ok, 'a volunteer who holds no seat on the project read its workspace').toBe(false);
