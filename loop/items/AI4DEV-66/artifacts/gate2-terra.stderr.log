 364:     body: unknown,
 365:     session: Session | null,
 366:   ): Promise<{ status: number; text: string; contentType: string }> => {
 367:     const bearer = session === null ? slot.anonKey : tokensOf(sessions, session, `call the deployed ${name}`).accessToken;
 368:     const response = await fetch(`${api}/functions/v1/${name}`, {
 369:       method: 'POST',
 370:       headers: {
 371:         apikey: slot.anonKey,
 372:         Authorization: `Bearer ${bearer}`,
 373:         'Content-Type': 'application/json',
 374:       },
 375:       body: JSON.stringify(body),
 376:     });
