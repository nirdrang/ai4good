 342: /** Read a JSON request body, or refuse — a malformed body must not read as an empty one. */
 343: export async function readJsonBody(request: Request): Promise<{ ok: true; value: Record<string, unknown> } | { ok: false; reason: string }> {
 344:   let text: string;
 345:   try {
 346:     text = await request.text();
 347:   } catch {
 348:     return { ok: false, reason: 'the request body could not be read' };
 349:   }
 350:   if (text.trim() === '') return { ok: true, value: {} };
 351:   try {
 352:     const parsed = JSON.parse(text) as unknown;
 353:     if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) {
 354:       return { ok: false, reason: 'the request body must be a JSON object' };
 355:     }
 356:     return { ok: true, value: parsed as Record<string, unknown> };
 357:   } catch {
 358:     return { ok: false, reason: 'the request body is not valid JSON' };
 359:   }
 360: }

