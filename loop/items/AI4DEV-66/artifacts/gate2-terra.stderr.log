 307: /** The result of one Data API read: the rows, or the fact that the read did not happen. */
 308: export type RowsOutcome = { ok: true; rows: Record<string, unknown>[] } | { ok: false; detail: string };
 309: 
 310: /**
 311:  * Read rows from one `public.` table, with the service role — the read half of `callDatabaseFunction`.
 312:  *
 313:  * TWO OUTCOMES, AND `ok: false` MEANS THE READ DID NOT HAPPEN — never "there are no rows". An empty
 314:  * array is a successful read of nothing, which is a completely different fact from a Data API that
 315:  * answered an error, and the three read surfaces branch on the difference: no rows is a refusal a
 316:  * caller earned, a failed read is an outage that answers 502 and says so. Collapsing them would let
 317:  * an outage be read by an acceptance test as the isolation property holding.
 318:  *
 319:  * `path` IS THE TABLE AND ITS QUERY STRING, already encoded by the caller — `accounts?id=eq.…`. It is
 320:  * not built here because each surface's filter is part of that surface's own read ORDER, which is
 321:  * load-bearing for the no-existence-oracle property and belongs where a reader can see it.
 322:  */
 323: export async function readRows(supabaseUrl: string, serviceRoleKey: string, path: string): Promise<RowsOutcome> {
 324:   const response = await fetch(`${supabaseUrl}/rest/v1/${path}`, {
 325:     headers: {
 326:       apikey: serviceRoleKey,
 327:       Authorization: `Bearer ${serviceRoleKey}`,
 328:       Accept: 'application/json',
 329:     },
 330:   });
 331:   if (!response.ok) return { ok: false, detail: `a read of ${path.split('?')[0]} answered ${response.status}` };
 332:   const text = await response.text();
 333:   try {
 334:     const parsed = JSON.parse(text) as unknown;
 335:     if (!Array.isArray(parsed)) return { ok: false, detail: `a read of ${path.split('?')[0]} answered a body that is not an array` };
 336:     return { ok: true, rows: parsed as Record<string, unknown>[] };
 337:   } catch {
 338:     return { ok: false, detail: `a read of ${path.split('?')[0]} answered a body that is not JSON` };
 339:   }
 340: }
