+export async function readRows(supabaseUrl: string, serviceRoleKey: string, path: string): Promise<RowsOutcome> {
+  const response = await fetch(`${supabaseUrl}/rest/v1/${path}`, {
+    headers: {
+      apikey: serviceRoleKey,
