 384:   /**
 385:    * ONE TENANT READ, TURNED INTO AN OUTCOME — and each half of the union is built the way the
 386:    * criterion needs it read.
 387:    *
 388:    * A REFUSAL CARRIES THE RAW RESPONSE TEXT, UNPARSED. `_contract.ts` says of `TenantReadOutcome`
 389:    * that `body` holds the raw text at this tier and the returned value at the loop tier, and that no
 390:    * comparison ever crosses the two. This is where that promise is kept.
 391:    *
 392:    * A SUCCESS HANDS BACK THE WIRE OBJECT WITH ONLY `ok` REMOVED, and that matters more than it
 393:    * looks. AT-001.22 asserts that the public projection carries NO `organizationId` and NO
 394:    * `assignedVolunteerId`; if this adapter rebuilt the projection field by field, that assertion
 395:    * would be about the rebuild and would pass however much the deployed function had leaked. The
 396:    * `ok` flag is the envelope rather than part of the projection, so it is the one field dropped.
 397:    *
 398:    * ANYTHING THAT IS NOT A 200 IS A REFUSAL. The three read surfaces answer 200 with a projection,
 399:    * 404 with the shared constant, 401 when the session layer refuses, or 502 on an outage — so the
 400:    * split is by status and needs no reading of the body to decide it.
 401:    */
 402:   const tenantRead = async <T>(name: string, body: unknown, session: Session | null): Promise<TenantReadOutcome<T>> => {
 403:     const { status, text, contentType } = await callFunctionRaw(name, body, session);
 404:     if (status !== 200) return { ok: false, status, body: text };
 405:     // A 200 THAT IS NOT JSON IS A HARNESS FAULT, NOT A PRODUCT ANSWER, so it is loud rather than
 406:     // parsed into whatever comes out. A gateway error page rendered as HTML would otherwise reach
 407:     // `JSON.parse` and fail with a message about a character position.
 408:     if (!contentType.toLowerCase().includes('json')) {
 409:       throw new Error(
 410:         `the deployed ${name} answered 200 with content type ${JSON.stringify(contentType)} rather than JSON: ${text.slice(0, 200)}`,
 411:       );
 412:     }
 413:     const wire = JSON.parse(text) as Record<string, unknown>;
 414:     delete wire.ok;
 415:     return { ok: true, status, value: wire as T };
 416:   };
