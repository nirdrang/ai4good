 238: function databaseRefusal(error: unknown): { code: string; message: string } {
 239:   const carrier = error as Record<string, unknown> | null;
 240:   let code = '';
 241:   for (const field of ['errno', 'errcode', 'code'] as const) {
 242:     const value = carrier?.[field];
 243:     if (typeof value === 'string' && /^[0-9A-Z]{5}$/.test(value)) {
 244:       code = value;
 245:       break;
 246:     }
 247:   }
 248:   const message = typeof carrier?.message === 'string' ? carrier.message : String(error);
 249:   return { code, message };
 250: }
