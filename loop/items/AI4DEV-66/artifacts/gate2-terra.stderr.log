 252: /**
 253:  * `pg_policies.roles` AS A LIST OF NAMES — read defensively, and LOUD when it cannot be read.
 254:  *
 255:  * The column is a `name[]`, and how a client renders a Postgres array is the client's business
 256:  * rather than something this file gets to assume: it may arrive as a JavaScript array or as the
 257:  * literal text `{authenticated,service_role}`. Both are handled.
 258:  *
 259:  * ANYTHING ELSE THROWS RATHER THAN ANSWERING `[]`. The conformance arm reads this list to decide
 260:  * whether a policy reaches a client role, so an empty list is a MEANINGFUL answer — "this policy
 261:  * reaches nobody" — and a rendering this function did not recognise must never be able to arrive
 262:  * wearing it. That is this repository's standing rule about negatives, applied at the one place a
 263:  * broken instrument would look exactly like a true absence.
 264:  */
 265: function pgRoleList(raw: unknown): string[] {
 266:   if (Array.isArray(raw)) return raw.map((entry) => String(entry));
 267:   if (typeof raw === 'string') {
 268:     return raw
 269:       .replace(/^\{|\}$/g, '')
 270:       .split(',')
 271:       .map((entry) => entry.trim().replace(/^"|"$/g, ''))
 272:       .filter((entry) => entry !== '');
 273:   }
 274:   throw new Error(`the catalog read could not interpret a pg_policies.roles value of type ${typeof raw}: ${String(raw)}`);
 275: }
