  456:       const response = await fetch(`${api}/auth/v1/logout?scope=local`, {
  457:         method: 'POST',
  458:         headers: { apikey: slot.anonKey, Authorization: `Bearer ${tokens.accessToken}` },
  459:       });
  460:       if (response.status >= 400) throw new Error(`the live logout answered ${response.status}`);
