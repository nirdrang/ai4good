  697: /**
  698:  * AT-001.16 â€” membership and role are held per NGO, and acting in one grants nothing in another.
  699:  *
  700:  * WHAT IS LIVE HERE THAT WAS NOT AT LOOP TIER: the two membership rows are rows in
  701:  * `public.org_memberships` read back with operator authority, the rename is the DEPLOYED
  702:  * `update-organization` â€” so the platform's token check, `resolveCaller`, the service-role
  703:  * membership read and the definer function all sit on the path â€” and the refusals are the ones the
  704:  * deployed function really sent.
  705:  *
  706:  * WHAT THIS GREEN CLAIMS, AND WHAT IT DOES NOT (gate-1 ruling 1). It claims OPERATION-SURFACE
  707:  * isolation: the same account's authority does not cross organisations on this action, proved by
  708:  * three different answers to one caller. It does NOT claim read isolation over drafts, ledgers and
  709:  * files â€” that breadth is the tenant-isolation deliverable's, which is blocked by this leaf, and
  710:  * this tree has no read surface to leak through (row-level security on, zero policies,
  711:  * `org_memberships` reachable by no client role).
  712:  */
  713: export async function at00116(ctx: Ctx): Promise<void> {
  714:   const { w, sut } = await ctx.open();
  715:   const NAMES = {
  716:     a: 'Riverside Shelter 16A',
  717:     b: 'Northgate Foodbank 16B',
  718:     c: 'Eastside Legal Aid 16C',
  719:   };
  720:   const RENAMED_A = 'Riverside Shelter and Kitchen 16A';
  721:   const ATTEMPTED_B = 'Northgate Foodbank Renamed By An Outsider 16B';
  722:   const ATTEMPTED_C = 'Eastside Legal Aid Renamed By An Outsider 16C';
  723: 
  724:   const given = await twoMembershipGiven(sut, w, 'two-orgs-16', NAMES);
  725: 
  726:   // (1) ROLE IS HELD PER ORGANISATION â€” two independent rows, different roles, and NO row in C.
  727:   expect(await sut.membership(given.organizationA, given.accountId), 'the actor is not A\'s admin').toMatchObject({ role: 'admin' });
  728:   expect(await sut.membership(given.organizationB, given.accountId), 'the actor is not B\'s member').toMatchObject({ role: 'member' });
  729:   expect(await sut.membership(given.organizationC, given.accountId), 'the actor holds a membership in C, which the Given denies').toBeNull();
  730:   const held = await sut.membershipsOf(given.accountId);
  731:   expect(held, 'the actor does not hold exactly two memberships').toHaveLength(2);
  732:   expect(
  733:     held.map((row) => row.role).sort(),
  734:     'the two memberships do not carry two different roles, so the role is not being held per organisation',
  735:   ).toEqual(['admin', 'member']);
  736: 
  737:   // (2) THE ADMIN ACTS IN A. The positive is not optional: an action that refused everybody would
  738:   // satisfy both refusals below on its own.
  739:   const renamed = await sut.updateOrganization(given.session, given.organizationA, RENAMED_A);
  740:   expect(renamed, 'A\'s own admin was refused the admin-only action, so the refusals below prove nothing').toMatchObject({ ok: true });
  741:   expect(await sut.organization(given.organizationA), 'the rename did not reach the row').toMatchObject({ name: RENAMED_A });
  742: 
  743:   // (3) ADMIN STANDING IN A DOES NOT CARRY INTO B, where the same account holds `member`.
  744:   const refusedInB = await sut.updateOrganization(given.session, given.organizationB, ATTEMPTED_B);
  745:   expect(refusedInB.ok, 'A\'s admin renamed an organisation where it holds only the member role').toBe(false);
  746:   if (refusedInB.ok) return;
  747:   expect(refusedInB.kind, 'the refusal in B is not the not-an-admin one').toBe('not-an-admin');
  748:   expect(await sut.organization(given.organizationB), 'the refused rename reached B\'s row anyway').toMatchObject({ name: NAMES.b });
  749:   expect(await sut.organizationsNamed(ATTEMPTED_B), 'the refused rename created an organisation by the attempted name').toEqual([]);
  750: 
  751:   // (4) NO AMBIENT AUTHORITY â€” C, where the actor holds no membership at all, refuses with the
  752:   // OTHER kind. Two different refusals from one caller is what makes this an isolation oracle
  753:   // rather than a blanket denial.
  754:   const refusedInC = await sut.updateOrganization(given.session, given.organizationC, ATTEMPTED_C);
  755:   expect(refusedInC.ok, 'the actor renamed an organisation it holds no membership in').toBe(false);
  756:   if (refusedInC.ok) return;
  757:   expect(refusedInC.kind, 'the refusal in C is not the not-a-member one').toBe('not-a-member');
  758:   expect(await sut.organization(given.organizationC), 'the refused rename reached C\'s row anyway').toMatchObject({ name: NAMES.c });
  759:   expect(await sut.organizationsNamed(ATTEMPTED_C), 'the refused rename created an organisation by the attempted name').toEqual([]);
  760: 
  761:   // (5) AND NEITHER REFUSAL WROTE A MEMBERSHIP. A refusal that quietly enrolled the caller would
  762:   // pass every assertion above and hand it the authority next time.
  763:   expect(await sut.membershipsOf(given.accountId), 'a refused action changed what the actor is a member of').toHaveLength(2);
  764: }
