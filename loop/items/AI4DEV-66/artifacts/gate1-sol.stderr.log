   85: /**
   86:  * The two conventions EVERY entry point here needs, applied once instead of twice.
   87:  *
   88:  *   * THE PREFLIGHT. Both functions refuse any method that is not POST, so without this an
   89:  *     `OPTIONS` would be answered 405 and no browser would ever reach the real call.
   90:  *   * NOTHING ESCAPES AS A BARE STATUS. A rejected `fetch` (Auth or the Data API unreachable) or a
   91:  *     non-JSON success body throws, and an exception out of a `Deno.serve` handler becomes a 500
   92:  *     with no body â€” precisely the case where a caller most needs to tell a refusal from an outage.
   93:  *     Anything thrown becomes a shaped 502 carrying a sentence, which is this file's standing
   94:  *     contract: the reason travels, never a bare status.
   95:  */
   96: export function edgeHandler(
   97:   name: string,
   98:   handler: (request: Request) => Promise<Response>,
   99: ): (request: Request) => Promise<Response> {
  100:   return async (request: Request): Promise<Response> => {
  101:     if (request.method === 'OPTIONS') return new Response(null, { status: 204, headers: CORS_HEADERS });
  102:     try {
  103:       return await handler(request);
  104:     } catch (error) {
  105:       const detail = error instanceof Error ? error.message : String(error);
  106:       return refusal(`${name} could not complete the request: ${detail}`, 502);
  107:     }
  108:   };
  109: }
