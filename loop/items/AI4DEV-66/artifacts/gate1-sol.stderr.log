 1005: /* ------------------------------------------------------------------------------ suite binding */
 1006: 
 1007: /** `atTest`, with the binding already applied â€” so bodies say `atTest(id, title, body)`. */
 1008: type BoundAtTest<R extends SuiteId, K extends SutKeyOf<R>> = {
 1009:   (atId: string, title: string, opts: AtTestOptions, body: AtTestBody<R, K, 'loop'> | AtTestBodies<R, K>): void;
 1010:   (atId: string, title: string, body: AtTestBody<R, K, 'loop'> | AtTestBodies<R, K>): void;
 1011: };
 1012: 
 1013: /** `defineEvidenceCapture`, with the binding already applied. */
 1014: type BoundDefineEvidenceCapture<R extends SuiteId, K extends SutKeyOf<R>> = <T>(
 1015:   name: string,
 1016:   producer: (ctx: AtContext<R, K>) => Promise<T>,
 1017: ) => EvidenceCapture<T, R, K>;
 1018: 
 1019: /**
 1020:  * A suite's ONE line of harness contact: name the requirement and the system-under-test key, and
 1021:  * get back both entry points with the seam types already derived from that suite's adapter.
 1022:  *
 1023:  * BOTH are returned because both were doors. Closing `atTest` alone would have moved the defect one
 1024:  * import along â€” `defineEvidenceCapture` handed its producer the same `AtContext`, so a suite could
 1025:  * fabricate a system under test there instead and read it green, and the item would have shipped
 1026:  * claiming a closure it did not have.
 1027:  *
 1028:  * It is the same `atTest` and the same `defineEvidenceCapture` as above: one implementation, not
 1029:  * one per suite. And it is a `const`, not an exported `function` declaration, so no suite can merge
 1030:  * an extra generic overload onto it through `declare module` and restore the fabricated arguments.
 1031:  */
 1032: type BindSuiteFn = <R extends SuiteId, K extends SutKeyOf<R>>(
 1033:   binding: SuiteBinding<R, K>,
 1034: ) => {
 1035:   atTest: BoundAtTest<R, K>;
 1036:   defineEvidenceCapture: BoundDefineEvidenceCapture<R, K>;
 1037: };
 1038: 
 1039: export const bindSuite: BindSuiteFn = <R extends SuiteId, K extends SutKeyOf<R>>(binding: SuiteBinding<R, K>) => {
 1040:   const boundAtTest = (
 1041:     atId: string,
 1042:     title: string,
 1043:     optsOrBody: AtTestOptions | AtTestBody<R, K, 'loop'> | AtTestBodies<R, K>,
 1044:     maybeBody?: AtTestBody<R, K, 'loop'> | AtTestBodies<R, K>,
 1045:   ): void => {
 1046:     // THREE SHAPES ARRIVE HERE and the discriminator is which of them the third argument is: a
 1047:     // function is a single body, an options object comes with the body fourth, and a per-tier body
 1048:     // MAP is an object too â€” told apart by carrying at least one body-shaped member. A map that
 1049:     // names none of them is not silently read as options: `tierBodyProblem` refuses it by name.
 1050:     const looksLikeBodies =
 1051:       typeof optsOrBody === 'object' &&
 1052:       optsOrBody !== null &&
 1053:       (['default', ...TIERS] as const).some((key) => typeof (optsOrBody as Record<string, unknown>)[key] === 'function');
 1054:     const givenBody = typeof optsOrBody === 'function' || looksLikeBodies;
 1055:     const opts: AtTestOptions = givenBody ? {} : (optsOrBody as AtTestOptions);
 1056:     const body = (givenBody ? optsOrBody : maybeBody) as AtTestBody<R, K, 'loop'> | AtTestBodies<R, K>;
 1057:     atTest<R, K>(atId, title, { ...opts, ...binding }, body);
 1058:   };
 1059: 
 1060:   // Annotated here rather than left to the contextual type from `BindSuiteFn`: inside the object
 1061:   // literal the context would supply that alias's own `R`/`K`, which TypeScript treats as unrelated
 1062:   // to this implementation's â€” the "two different types with this name exist" rejection. Naming the
 1063:   // type against the local parameters is what makes `binding` line up with the call below.
 1064:   const boundCapture: BoundDefineEvidenceCapture<R, K> = (name, producer) =>
 1065:     defineEvidenceCapture(binding, name, producer);
 1066: 
 1067:   return {
 1068:     atTest: boundAtTest,
 1069:     defineEvidenceCapture: boundCapture,
 1070:   };
 1071: };

