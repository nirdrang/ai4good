  354: /**
  355:  * AT-001.09 â€” email verification, PARAMETERIZED OVER BOTH email-capable account types.
  356:  *
  357:  * Gate 1's finding 8 is what makes this body cover two types rather than one: the criterion says
  358:  * "EITHER account type â€¦ (NGO and volunteer)" and carries the acceptance file's own
  359:  * "parameterized over account types" note, and the migrated NGO-only set proved half of it.
  360:  *
  361:  * AND EACH ITERATION REALLY IS ITS TYPE (gate-2 ruling S2-4). The first version of this body labelled
  362:  * the two iterations `ngo` and `volunteer` and differed only in the email address it used â€” neither
  363:  * one ever created an account of either type, so the parameterization was nominal and a
  364:  * type-specific verification regression would have gone unnoticed by both halves. Each iteration now
  365:  * COMPLETES SIGNUP as its type after verification â€” the NGO with an organisation, the volunteer with
  366:  * a linked GitHub identity, both with the acknowledgment â€” and asserts the account row carries that
  367:  * global type.
  368:  *
  369:  * WHAT IS LIVE HERE: the message is the one GoTrue really sent, held by the slot's own mail catcher;
  370:  * the link is followed by HTTP; and the verified fact is judged by the SHIPPED extractor over the
  371:  * real row rather than read as a boolean.
  372:  */
  373: export async function at00109(ctx: Ctx): Promise<void> {
  374:   const { w, sut } = await ctx.open();
  375: 
  376:   for (const kind of ['ngo', 'volunteer'] as const) {
  377:     const email = w.email(`${kind}-verify`);
  378:     const registered = await sut.registerWithEmailPassword(email, PASSWORD);
  379:     expect(registered.sessionId, 'the live registration issued a session, which under confirmations it must not').toBe('');
  380: 
  381:     // UNVERIFIED FIRST, and it must DISCRIMINATE: an extractor that answered true unconditionally
  382:     // would satisfy every assertion after the link is used.
  383:     expect(
  384:       await sut.emailVerified(registered.accountId),
  385:       `a fresh ${kind} registration is already reported verified â€” nothing below would then mean anything`,
  386:     ).toBe(false);
  387: 
  388:     // Auth itself refuses sign-in before confirmation, which is the state the criterion describes.
  389:     const early = await sut.signInWithEmailPassword(email, PASSWORD);
  390:     expect(early.ok, `an unconfirmed ${kind} account signed in`).toBe(false);
  391: 
  392:     const link = await sut.emailedVerificationLink(email);
  393:     expect(link, `no confirmation email reached the slot's mail catcher for the ${kind} address`).not.toBeNull();
  394: 
  395:     const used = await sut.useVerificationLink(link!);
  396:     expect(used.ok, `following the emailed ${kind} confirmation link was refused`).toBe(true);
  397:     expect(
  398:       await sut.emailVerified(registered.accountId),
  399:       `using the emailed link did not flip the ${kind} account to verified`,
  400:     ).toBe(true);
  401: 
  402:     const after = await sut.signInWithEmailPassword(email, PASSWORD);
  403:     expect(after, `a confirmed ${kind} account could not sign in`).toMatchObject({ ok: true });
  404:     if (!after.ok) return;
  405: 
  406:     // THE COMPLETION AS THIS TYPE, which is what makes the two iterations two different runs of the
  407:     // criterion rather than the same run under two labels. The volunteer's linked GitHub identity is
  408:     // a GIVEN written by the operator â€” AT-001.04 owns the link rule and is red at this tier â€” and
  409:     // without it the deployed path refuses a volunteer completion, correctly.
  410:     const request =
  411:       kind === 'ngo'
  412:         ? {
  413:             accountType: 'ngo' as const,
  414:             organizationName: `Riverside Shelter ${kind}-verify`,
  415:             acknowledgmentTextVersion: TEXT_VERSION,
  416:             ...SIGNER,
  417:           }
  418:         : { accountType: 'volunteer' as const, acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER };
  419:     if (kind === 'volunteer') await sut.linkGithubIdentity(after.session, `verify-${registered.accountId.slice(0, 8)}`);
  420: 
  421:     const completion = await sut.completeSignup(after.session, request, CLIENT_IP);
  422:     expect(completion, `the verified ${kind} could not complete signup as a ${kind}`).toMatchObject({ ok: true });
  423:     if (!completion.ok) return;
  424:     expect(
  425:       await sut.account(completion.accountId),
  426:       `the completed ${kind} account does not carry the ${kind} global type`,
  427:     ).toEqual({ id: registered.accountId, accountType: kind });
  428:   }
  429: }
