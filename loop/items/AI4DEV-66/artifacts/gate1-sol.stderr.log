  580: export class CapabilityPending extends Error {
  581:   constructor(readonly capabilities: readonly string[]) {
  582:     super(`CAPABILITY PENDING â€” ${capabilities.join(', ')}`);
  583:     this.name = 'CapabilityPending';
  584:   }
