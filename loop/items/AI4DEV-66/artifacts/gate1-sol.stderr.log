  431: /**
  432:  * AT-001.12 â€” access ends when a session expires OR is revoked, and re-authentication is the remedy.
  433:  *
  434:  * TWO ARMS, BOTH AGAINST REAL TIME AND A REAL AUTH.
  435:  *
  436:  *   REVOCATION â€” a scoped logout ends THIS session while a SIBLING session of the same account keeps
  437:  *   working. The sibling is the control that separates "this session ended" from "the account's
  438:  *   access ended", and without it the criterion's remedy clause is untested.
  439:  *
  440:  *   EXPIRY â€” the body WAITS OUT a real access token. There is nothing to command: the slot's config
  441:  *   pins a standing low `jwt_expiry` precisely so this wait is two minutes rather than an hour, and
  442:  *   no test edits configuration or restarts anything. The loop body advances a controlled clock,
  443:  *   which is a different procedure proving the same clause.
  444:  */
  445: export async function at00112(ctx: Ctx): Promise<void> {
  446:   const { w, sut } = await ctx.open();
  447:   const email = w.email('sessions');
  448:   const session = await registerConfirmAndSignIn(sut, email);
  449: 
  450:   const completion = await sut.completeSignup(
  451:     session,
  452:     { accountType: 'ngo', organizationName: 'Riverside Shelter', acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
  453:     CLIENT_IP,
  454:   );
  455:   expect(completion, 'the session under test could not complete signup, so nothing below is about a working session').toMatchObject({
  456:     ok: true,
  457:   });
  458: 
  459:   // A SIBLING SESSION, opened before the logout, standing as the control.
  460:   const sibling = await sut.signInWithEmailPassword(email, PASSWORD);
  461:   expect(sibling, 'a second sign-in for the same account failed').toMatchObject({ ok: true });
  462:   if (!sibling.ok) return;
  463:   const before = await sut.sessionsOf(session.accountId);
  464:   expect(before.length, 'the account does not hold the two sessions this arm needs').toBeGreaterThanOrEqual(2);
  465: 
  466:   await sut.signOut(session);
  467:   const after = await sut.sessionsOf(session.accountId);
  468:   expect(after.map((row) => row.sessionId), 'the signed-out session row is still there').not.toContain(session.sessionId);
  469:   expect(after.map((row) => row.sessionId), 'the scoped logout took the sibling session with it').toContain(sibling.session.sessionId);
  470: 
  471:   // THE REVOKED SESSION CANNOT WRITE. `create-organization` is the write, because no verification
  472:   // gate sits on it â€” so a refusal here is unambiguously the session layer's.
  473:   const revokedWrite = await sut.createOrganization(session, 'Riverside Shelter After Logout');
  474:   expect(revokedWrite.ok, 'a revoked session performed a write').toBe(false);
  475:   expect(await sut.organizationsNamed('Riverside Shelter After Logout'), 'the revoked write happened anyway').toEqual([]);
  476: 
  477:   // RE-AUTHENTICATION IS THE REMEDY, not a wall: a fresh sign-in works at once.
  478:   const again = await sut.signInWithEmailPassword(email, PASSWORD);
  479:   expect(again, 're-authentication after revocation was refused, so revocation ended the account rather than the session').toMatchObject(
  480:     { ok: true },
  481:   );
  482:   if (!again.ok) return;
  483: 
  484:   // THE EXPIRY ARM. Wait past the slot's standing token lifetime and assert the same write is
  485:   // refused â€” with the margin on the far side, so a token that is merely close to expiry is not
  486:   // mistaken for one that has passed it.
  487:   await wait(SLOT_JWT_EXPIRY_MS + 15_000);
  488:   const expiredWrite = await sut.createOrganization(again.session, 'Riverside Shelter After Expiry');
  489:   expect(expiredWrite.ok, 'an expired access token performed a write').toBe(false);
  490:   expect(await sut.organizationsNamed('Riverside Shelter After Expiry'), 'the expired write happened anyway').toEqual([]);
  491: 
  492:   // And the refresh token re-establishes access with NO credentials â€” which is what makes expiry a
  493:   // pause rather than a logout, and is the mechanism AT-001.13 builds its own claim on.
  494:   const refreshed = await sut.refreshSession(again.session);
  495:   expect(refreshed, 'the same session could not be refreshed after its access token expired').toMatchObject({ ok: true });
  496:   if (!refreshed.ok) return;
  497:   const afterRefresh = await sut.createOrganization(refreshed.session, 'Riverside Shelter After Refresh');
  498:   expect(afterRefresh, 'a refreshed session still could not write').toMatchObject({ ok: true });
  499: }
