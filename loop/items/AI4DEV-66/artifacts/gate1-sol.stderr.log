  501: /**
  502:  * AT-001.13 â€” the session refreshes AUTOMATICALLY, with no forced re-login mid-work.
  503:  *
  504:  * GATE 1'S FINDING 7 IS WHY THIS BODY LOOKS DIFFERENT FROM EVERY OTHER ONE HERE. The criterion's
  505:  * word is "automatically", and every existing piece of evidence proves the MECHANISM: the loop body
  506:  * calls `refreshSession` explicitly, and the live proof transcript says in its own words that it
  507:  * establishes nothing about scheduling. A mechanism-only green at the tier whose meaning is "proved
  508:  * for real" would be a new overclaim.
  509:  *
  510:  * SO THE THING UNDER TEST IS A REAL CLIENT â€” supabase-js with `autoRefreshToken: true` â€” and the
  511:  * observable is a rotation NOBODY ASKED FOR: the access token the client holds changes while the
  512:  * body only waits, and access continues afterwards. No `refreshSession` call appears below.
  513:  *
  514:  * WHY THE COORDINATES COME FROM THE ENVIRONMENT rather than through the system under test: the thing
  515:  * under test is a CLIENT LIBRARY, not a product surface, and this repository ships no client. The
  516:  * runner validated those coordinates, attested them, and put them in this child's environment; a
  517:  * system-under-test method wrapping the client would be this suite building the very thing it is
  518:  * supposed to be observing.
  519:  */
  520: export async function at00113(ctx: Ctx): Promise<void> {
  521:   const { w, sut } = await ctx.open();
  522:   const email = w.email('auto-refresh');
  523:   const session = await registerConfirmAndSignIn(sut, email);
  524: 
  525:   // SIGNUP IS COMPLETED FIRST, so there is an account row for the rotated session to resolve TO.
  526:   // Without it the same-account assertion below could only ever compare two nulls, which is how the
  527:   // vacuous version of it came to be written (gate-2 ruling S2-5).
  528:   const completion = await sut.completeSignup(
  529:     session,
  530:     { accountType: 'ngo', organizationName: 'Riverside Shelter Auto Refresh', acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
  531:     CLIENT_IP,
  532:   );
  533:   expect(completion, 'the account under test could not complete signup, so it holds no account row').toMatchObject({ ok: true });
  534: 
  535:   const url = process.env.AT_SUPABASE_URL ?? '';
  536:   const anonKey = process.env.AT_SUPABASE_ANON_KEY ?? '';
  537:   expect(url && anonKey, 'this child holds no slot coordinates, so no real client can be built').toBeTruthy();
  538: 
  539:   const client = await realClient(url, anonKey);
  540:   try {
  541:     const signedIn = await client.auth.signInWithPassword({ email, password: PASSWORD });
  542:     expect(signedIn.error, 'the real client could not sign in against the slot').toBeNull();
  543:     const first = signedIn.data.session?.access_token ?? '';
  544:     expect(first, 'the real client signed in with no access token').not.toBe('');
  545: 
  546:     // WHOSE SESSION THIS IS, captured AT SIGN-IN and from the client's own answer â€” so the assertion
  547:     // after the rotation compares the rotated identity with a value that was read before any
  548:     // rotation happened, rather than with itself.
  549:     const signedInAs = (await client.auth.getUser()).data.user?.id ?? '';
  550:     expect(signedInAs, 'the real client signed in and named no user').not.toBe('');
  551:     expect(signedInAs, 'the real client signed in as a different account than the harness registered').toBe(
  552:       session.accountId,
  553:     );
  554: 
  555:     // WAIT, AND ONLY WAIT. The client's own scheduler is the thing under test, so the body issues no
  556:     // refresh of any kind. The budget is the token's whole lifetime plus a margin: the client
  557:     // rotates about one tick in, well before expiry, and a body that waited less than the lifetime
  558:     // could pass by luck.
  559:     const deadline = Date.now() + SLOT_JWT_EXPIRY_MS + 30_000;
  560:     let rotated = '';
  561:     while (Date.now() < deadline && !rotated) {
  562:       await wait(5_000);
  563:       const current = (await client.auth.getSession()).data.session?.access_token ?? '';
  564:       if (current && current !== first) rotated = current;
  565:     }
  566:     expect(rotated, 'the client never rotated its access token on its own â€” automatic refresh is unproved').not.toBe('');
  567: 
  568:     // "WITHOUT FORCED RE-LOGIN MID-WORK": the work continues, with no credentials supplied anywhere.
  569:     const me = await fetch(`${url.replace(/\/$/, '')}/auth/v1/user`, {
  570:       headers: { apikey: anonKey, Authorization: `Bearer ${rotated}` },
  571:     });
  572:     expect(me.status, 'the automatically rotated token does not carry access').toBe(200);
  573: 
  574:     // AND IT IS THE SAME USER'S WORK THAT CONTINUED, which is the clause the previous version of
  575:     // this assertion did not reach: `account === null || account.id.length > 0` is satisfied by
  576:     // every possible value, so it passed whoever the rotated token belonged to. Two independent
  577:     // reads now say the same name â€” the client's own `getUser()` over the rotated token, and the
  578:     // account row read out of the database with operator authority.
  579:     const rotatedUser = (await client.auth.getUser()).data.user?.id ?? '';
  580:     expect(rotatedUser, 'the automatically rotated token names a different user than the one that signed in').toBe(
  581:       signedInAs,
  582:     );
  583:     const account = await sut.account(rotatedUser);
  584:     expect(account, 'the rotated session resolved to no readable account row').not.toBeNull();
  585:     expect(account?.id, 'the account row the rotated session resolves to is somebody else\'s').toBe(signedInAs);
  586:   } finally {
  587:     await client.auth.stopAutoRefresh().catch(() => undefined);
  588:   }
  589: }
