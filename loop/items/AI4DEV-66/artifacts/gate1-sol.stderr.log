   79:     }
   80:   }
   81:   return found;
   82: }
   83: 
   84: export interface BijectionReport {
   85:   expected: string[];
   86:   registered: SuiteRegistration[];
   87:   missing: string[];
   88:   extra: string[];
   89:   duplicate: string[];
   90:   problems: string[];
   91: }
   92: 
   93: export function bijectionProblems(expected: string[], registered: SuiteRegistration[]): string[] {
   94:   const registeredSet = [...new Set(registered.map((entry) => entry.atId))];
   95:   const missing = expected.filter((id) => !registeredSet.includes(id));
   96:   const extra = registeredSet.filter((id) => !expected.includes(id));
   97:   const duplicate = registeredSet.filter((id) => registered.filter((entry) => entry.atId === id).length > 1);
   98:   const problems: string[] = [];
   99:   if (expected.length === 0) problems.push('the acceptance parser found zero P0 ids');
  100:   if (missing.length) problems.push(`${missing.length} missing: ${missing.join(', ')}`);
  101:   if (extra.length) problems.push(`${extra.length} extra: ${extra.join(', ')}`);
  102:   if (duplicate.length) problems.push(`${duplicate.length} duplicated: ${duplicate.join(', ')}`);
  103:   return problems;
  104: }
  105: 
  106: export function inspectBijection(requirement: string): BijectionReport {
  107:   const expected = acceptanceP0Ids(requirement);
  108:   const registered = registeredIds(requirement);
  109:   const registeredSet = [...new Set(registered.map((entry) => entry.atId))];
  110:   const missing = expected.filter((id) => !registeredSet.includes(id));
  111:   const extra = registeredSet.filter((id) => !expected.includes(id));
  112:   const duplicate = registeredSet.filter((id) => registered.filter((entry) => entry.atId === id).length > 1);
  113:   return {
  114:     expected,
  115:     registered,
  116:     missing,
  117:     extra,
  118:     duplicate,
  119:     problems: bijectionProblems(expected, registered),
  120:   };
  121: }
  122: 
  123: function main(argv: string[]): number {
  124:   let requirement: string;
  125:   try {
  126:     requirement = normalizeRequirement(argv[0]);
  127:   } catch (err) {
  128:     console.error(`at:check â€” ${(err as Error).message}`);
  129:     console.error('usage: bun run at:check req-0NN');
  130:     return 2;
  131:   }
  132: 
  133:   let report: BijectionReport;
  134:   try {
  135:     report = inspectBijection(requirement);
  136:   } catch (err) {
  137:     console.error(`at:check req-${requirement} â€” ${(err as Error).message}`);
  138:     return 2;
  139:   }
  140: 
  141:   console.log(
  142:     `at:check req-${requirement} â€” ${report.expected.length} P0 in the acceptance file, ` +
  143:       `${report.registered.length} registered in the suite`,
  144:   );
  145:   if (report.expected.length === 0) console.log('  EMPTY      the acceptance parser found zero P0 ids');
  146:   for (const id of report.missing) console.log(`  MISSING    ${id} â€” no executable test registers this id`);
  147:   for (const id of report.extra) {
  148:     const where = report.registered
  149:       .filter((r) => r.atId === id)
  150:       .map((r) => r.file)
  151:       .join(', ');
  152:     console.log(`  EXTRA      ${id} â€” registered in ${where} but not a P0 of this requirement`);
  153:   }
  154:   for (const id of report.duplicate) {
  155:     const where = report.registered
  156:       .filter((r) => r.atId === id)
  157:       .map((r) => r.file)
  158:       .join(', ');
  159:     console.log(`  DUPLICATE  ${id} â€” registered ${report.registered.filter((r) => r.atId === id).length} times (${where})`);
  160:   }
  161: 
  162:   if (report.problems.length === 0) {
  163:     console.log(`RESULT: ${report.expected.length} P0 ids in bijection`);
  164:     return 0;
  165:   }
  166:   console.log(
  167:     `RESULT: ${report.missing.length} missing, ${report.extra.length} extra, ` +
  168:       `${report.duplicate.length} duplicated${report.expected.length === 0 ? ', zero expected' : ''}`,
  169:   );
  170:   return 1;
  171: }
  172: 
  173: if (import.meta.main) process.exit(main(process.argv.slice(2)));
