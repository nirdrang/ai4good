  719:    */
  720:   organizationsNamed(name: string): Promise<OrganizationRow[]>;
  721:   membershipsOf(accountId: string): Promise<MembershipRow[]>;
  722:   /**
  723:    * `public.has_platform_acknowledgment(account_id)` â€” the observable form of AT-001.01's "before
  724:    * any project creation is possible".
  725:    *
  726:    * It MUST DISCRIMINATE: false for an authenticated user who has not completed signup, true after.
  727:    * The body asserts both halves for exactly that reason.
  728:    *
  729:    * WHICH IMPLEMENTATION THAT ASSERTION REACHES depends on the tier, and the difference matters. At
  730:    * loop tier it reaches the fixture adapter's storage query, so what goes green is the RULE and the
  731:    * adapter's storage â€” the shipped SQL function could return true unconditionally and the loop tier
  732:    * would not notice. `public.has_platform_acknowledgment` itself is proved by step 7(h) of the
  733:    * plan, against the live database, and by nothing else in this item.
  734:    *
  735:    * What this leaf cannot do at either tier is ENFORCE the clause â€” nothing in the tree creates a
  736:    * project, and building project creation belongs to another requirement. This is the hook the leaf
  737:    * that lands project creation must call.
  738:    */
  739:   hasPlatformAcknowledgment(accountId: string): Promise<boolean>;
  740: 
  741:   /* ------------------------------------ the provisioned admin --------------------------------- */
  742: 
  743:   /**
  744:    * Provision a `platform_admin` â€” the ONLY legal way one exists, because the public path refuses
  745:    * the type. It sits apart from `completeSignup` rather than being one of its options for that
  746:    * reason.
  747:    *
  748:    * ON THE LIVE STACK THIS IS **NOT** A SERVICE-ROLE WRITE, and the correction matters more than
  749:    * most: this comment used to say it was, and a later reader following it would have granted the
  750:    * service role an INSERT on `public.accounts` â€” a write path straight past `complete_signup`'s
  751:    * `platform_admin` refusal, which is the one guard that sits on the only write path. The service
  752:    * role holds no INSERT anywhere in this schema, by measurement and by decision. Provisioning is a
  753:    * direct database operation by an operator: a NARROWER authority than the service role, not a
  754:    * wider one, and not one any running service holds.
  755:    */
  756:   provisionPlatformAdmin(email: string, password: string): Promise<Session>;
