  426: export function createFixtureAdapter({ clock, worlds }: AdapterOptions) {
  427:   const state: State = {
  428:     authUsers: new Map(),
  429:     byEmail: new Map(),
  430:     byVerificationLink: new Map(),
  431:     byPasswordResetLink: new Map(),
  432:     sessions: new Map(),
  433:     accounts: new Map(),
  434:     organizations: new Map(),
  435:     memberships: new Map(),
  436:     projects: new Map(),
  437:     acknowledgments: [],
  438:     volunteerProfiles: new Map(),
  439:     discoveryMessages: new Map(),
  440:     nextId: 1,
  441:   };
  442:   const openedWorlds = new Set<AccountsFixtureWorld>();
  443:   let worldSerial = 0;
  444: 
  445:   const nextId = (prefix: string): string => `${prefix}-${state.nextId++}`;
  446: 
  447:   /**
  448:    * The instant a confirmation is recorded at.
  449:    *
  450:    * Fixed rather than read from a clock, for the same reason the acknowledgment's instant is: no
  451:    * criterion here depends on WHICH instant, only on whether one is present, and a real timestamp
  452:    * would make the capture non-deterministic for no gain. The shipped `emailVerifiedFromUser`
  453:    * judges presence and never parses the value, so this is the whole of what the field has to be.
  454:    */
  455:   const CONFIRMED_AT = '2026-01-01T00:00:00.000Z';
  456: 
  457:   /**
  458:    * How long a session's access lasts â€” VENDOR MIRROR 5, and the number is the configuration's.
  459:    *
  460:    * `jwt_expiry = 3600` sits at `supabase/config.toml` line 165, in seconds; this is that value in
  461:    * milliseconds, because the harness clock counts milliseconds. It is written as the arithmetic
  462:    * rather than as `3_600_000` so that a reader can see the config value inside it, and so that
  463:    * changing the configuration is a one-line change here with the citation beside it.
  464:    *
  465:    * NOTHING ELSE ABOUT THE TOKEN'S LIFETIME IS MODELLED. `[auth.sessions]`'s timebox and inactivity
  466:    * timeout are commented out in that file (lines 304-308) and no criterion reads them.
  467:    */
  468:   const ACCESS_TOKEN_TTL_MS = 3600 * 1000;
