  210: function databaseRefusal(error: unknown): { code: string; message: string } {
  211:   const carrier = error as Record<string, unknown> | null;
  212:   let code = '';
  213:   for (const field of ['errno', 'errcode', 'code'] as const) {
  214:     const value = carrier?.[field];
  215:     if (typeof value === 'string' && /^[0-9A-Z]{5}$/.test(value)) {
  216:       code = value;
  217:       break;
  218:     }
  219:   }
  220:   const message = typeof carrier?.message === 'string' ? carrier.message : String(error);
  221:   return { code, message };
  222: }
