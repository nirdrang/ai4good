 1471: /** bun's SQL client. Described here rather than imported: the runner keeps its own private copy. */
 1472: interface BunSqlClient {
 1473:   (strings: TemplateStringsArray, ...values: unknown[]): Promise<unknown>;
 1474:   close(): Promise<void>;
