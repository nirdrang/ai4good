    1: -- REQ-001 D3.L2 â€” the single-seat NGO and the single-developer project.
    2: --
    3: -- BOTH INVARIANTS ARE STRUCTURAL HERE, and that is the whole design of this migration. AT-001.17
    4: -- says no capability exists to invite or add a second member to an org; AT-001.32 says attaching a
    5: -- second volunteer to a project is rejected. Neither is expressed as a rule some writer applies â€”
    6: -- there is no writer to apply it, because no invite path and no attach path exists. They are
    7: -- expressed as SHAPE: a unique index that leaves no room for a second membership row, and one
    8: -- nullable column that can hold at most one developer.
    9: --
   10: -- WHAT IS DELIBERATELY ABSENT, stated so a reader does not read the absence as an oversight:
   11: --   * NO PRODUCT PROJECT CREATION. Nothing in this tree creates a project, and this table does not
   12: --     change that. AT-001.01's clause is that the platform acknowledgment is required "before any
   13: --     project creation is possible", and `public.has_platform_acknowledgment` is still the hook the
   14: --     leaf that lands project creation must call â€” landing a TABLE is not landing creation, and a
   15: --     gate written here would sit in front of nothing.
   16: --   * NO VOLUNTEER-TYPE VALIDATION OF THE ASSIGNEE. Whether the account attached to a project is of
   17: --     type `volunteer`, and whether it was matched to that project, is the matching requirement's
   18: --     concern. AT-001.32 is about the SECOND volunteer, not about the first one's type, and a check
   19: --     here would be an untested requirement.
   20: --   * NO OFFBOARDING. Releasing the seat to null stays allowed precisely because volunteer
   21: --     offboarding is AT-001.18's, in a different leaf. This migration refuses a REPLACEMENT, which
   22: --     is what "attach a second volunteer" means, and refuses nothing else.
   23: --   * NO POLICIES. Row-level security is enabled and the table reaches no Data API role at all,
   24: --     which is stricter than the grant-and-deny-by-policy posture `public.accounts` needs.
   25: 
   26: /* ======================================================= the single seat, as an index ========== */
   27: 
   28: -- STRICTLY STRONGER THAN THE COMPOSITE PRIMARY KEY, which is the point. `primary key (org_id,
   29: -- account_id)` permits many accounts in one organisation with a different role each â€” the shape a
   30: -- multi-seat product would need. A unique index on `org_id` ALONE permits exactly one membership row
   31: -- per organisation, whoever holds it, so "no second member can be added" is a fact about the table
   32: -- rather than a check somebody remembered to write.
   33: --
   34: -- NOTHING ON MAIN CAN TRIP IT. Every existing writer creates an organisation and seats exactly one
   35: -- admin in it inside one transaction: `complete_signup` for an NGO signup, `create_organization` for
   36: -- a second organisation. Neither ever writes a second row.
   37: --
   38: -- THE OPERATOR IS INSIDE IT TOO. An index is not a product rule and there is no path around it â€”
   39: -- which is what AT-001.17's "no such capability exists" needs, since the paths that would have to be
   40: -- checked are the ones nobody has written yet.
   41: create unique index org_memberships_one_seat_per_org_idx
   42:   on public.org_memberships (org_id);
   43: 
   44: comment on index public.org_memberships_one_seat_per_org_idx is
   45:   'The v1 single-seat NGO, in structural form: one membership row per organisation (REQ-001, AT-001.17).';
   46: 
   47: /* ========================================================================== projects =========== */
   48: 
   49: -- THE SINGLE-DEVELOPER INVARIANT IS THE COLUMN. `assigned_volunteer_id` is ONE nullable reference,
   50: -- so a project holds at most one developer and there is no collaborator seat to add a second to.
   51: -- A join table would have made "no second volunteer" a rule; a column makes it unrepresentable.
   52: --
   53: -- `on delete set null` on the assignee: deleting the account releases the seat rather than blocking
   54: -- the delete or destroying the project. `public.accounts` cascades from `auth.users`, so the
   55: -- alternative â€” the default NO ACTION â€” would make deleting an auth user fail on a project row,
   56: -- which no criterion asks for and nothing would repair.
   57: create table public.projects (
   58:   id uuid primary key default gen_random_uuid(),
   59:   org_id uuid not null references public.organizations (id) on delete cascade,
   60:   name text not null check (length(btrim(name)) > 0),
   61:   assigned_volunteer_id uuid references public.accounts (id) on delete set null,
   62:   created_at timestamptz not null default now()
   63: );
   64: 
   65: comment on table public.projects is
   66:   'A project and its single developer seat (REQ-001, AT-001.32). Product project creation is NOT landed here; has_platform_acknowledgment is still the hook the leaf that lands it must call.';
   67: 
   68: create index projects_org_id_idx on public.projects (org_id);
   69: 
   70: -- THE GUARD IS ABOUT REPLACEMENT, AND ONLY ABOUT REPLACEMENT. Attaching the first volunteer is the
   71: -- assignment; releasing the seat to null is offboarding's, and belongs to another leaf; attaching a
   72: -- DIFFERENT volunteer while one is already attached is "attaching a second volunteer to the
   73: -- project", which AT-001.32 says is rejected. Re-writing the same id is a no-op and stays allowed,
   74: -- because refusing it would make an idempotent write look like a second developer.
   75: --
   76: -- IT IS AN INVOKER FUNCTION, unlike the membership trigger: it reads only OLD and NEW and needs no
   77: -- privilege on any table. `set search_path = ''` is set all the same â€” nothing here resolves an
   78: -- unqualified name, and a function that cannot be redirected is cheaper to reason about than one
   79: -- that must be argued about.
   80: create function public.project_seat_holds_one_developer()
   81: returns trigger
   82: language plpgsql
   83: set search_path = ''
   84: as $$
   85: begin
   86:   if old.assigned_volunteer_id is not null
   87:      and new.assigned_volunteer_id is not null
   88:      and new.assigned_volunteer_id <> old.assigned_volunteer_id then
   89:     raise exception
   90:       'projects refuses a second volunteer on project %: its single developer seat is held by account %',
   91:       old.id, old.assigned_volunteer_id
   92:       using errcode = '42501';
   93:   end if;
   94:   return new;
   95: end;
   96: $$;
   97: 
   98: comment on function public.project_seat_holds_one_developer() is
   99:   'Refuses re-pointing an occupied project seat at a different account â€” the single-dev invariant (REQ-001, AT-001.32).';
  100: 
  101: create trigger projects_single_developer_seat
  102: before update on public.projects
  103: for each row
  104: execute function public.project_seat_holds_one_developer();
  105: 
  106: revoke execute on function public.project_seat_holds_one_developer() from public;
  107: 
  108: /* ================================================================== privilege posture ========== */
  109: 
  110: alter table public.projects enable row level security;
  111: 
  112: -- NO GRANT STATEMENT IS NOT THE SAME THING AS NO PRIVILEGE, and the preceding migration learned that
  113: -- by measuring rather than by reasoning: its own committed replay capture recorded REFERENCES,
  114: -- TRIGGER and TRUNCATE for `anon`, `authenticated` AND `service_role` on a new public table, because
  115: -- Supabase ships ALTER DEFAULT PRIVILEGES for the `public` schema. Row-level security does not cover
  116: -- TRUNCATE, so the privilege would have been real even though no PostgREST route reaches it.
  117: --
  118: -- SO THE REVOKE IS WHAT MAKES THE POSTURE TRUE, and it is verified rather than asserted: after a
  119: -- reset on the item's slot, the catalog check for these three roles on this table must return ZERO
  120: -- rows. That measurement is recorded in `loop/items/AI4DEV-62/artifacts/verify-first-answers.md`,
  121: -- answer (f). The `postgres` owner rows remain and are not a defect â€” an owner's implicit privileges
  122: -- are not grants.
  123: revoke all on table public.projects from anon, authenticated, service_role;
  124: 
  125: -- PostgREST caches the schema; a new table and a new function need the reload to be answerable at
  126: -- all rather than 404 from a stale cache.
  127: notify pgrst, 'reload schema';

