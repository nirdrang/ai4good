  100:     value: Object.freeze({ evidence: attestation.evidence, constructedFor: attestation.constructedFor }),
  101:     enumerable: false,
  102:     writable: false,
  103:     configurable: false,
  104:   });
  105:   return value;
  106: }
  107: 
  108: /** The attestation this value carries FOR THIS NAME, or null. A brand for another name is null. */
  109: export function attestationOf(value: unknown, constructedFor: string): LiveAttestation | null {
  110:   if (value === null || (typeof value !== 'object' && typeof value !== 'function')) return null;
  111:   const carried = (value as Record<symbol, unknown>)[ATTESTATION];
  112:   if (carried === null || typeof carried !== 'object') return null;
  113:   const { evidence, constructedFor: brandedFor } = carried as Partial<LiveAttestation>;
  114:   if (typeof evidence !== 'string' || evidence.trim() === '') return null;
  115:   if (brandedFor !== constructedFor) return null;
  116:   return { evidence, constructedFor };
  117: }
