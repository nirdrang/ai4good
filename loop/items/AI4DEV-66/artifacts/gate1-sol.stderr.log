 1531: interface DockerSnapshot {
 1532:   containers: string[];
 1533:   volumes: string[];
 1534: }
 1535: 
 1536: /**
 1537:  * A READ-ONLY identity record of the personal stack's docker objects. Only `ps`, `inspect`,
 1538:  * `volume ls` and `volume inspect` are used, and only identity fields are recorded: container id,
 1539:  * created timestamp, image and port bindings; volume name and CreatedAt. No run state.
 1540:  */
 1541: function personalDockerSnapshot(personal: string): DockerSnapshot {
 1542:   const containerNames = dockerLines(['ps', '-a', '--filter', `name=${personal}`, '--format', '{{.Names}}']).sort();
 1543:   const containers = containerNames.length
 1544:     ? dockerLines([
 1545:         'inspect',
 1546:         '--format',
 1547:         '{{.Name}} | id {{.Id}} | created {{.Created}} | image {{.Config.Image}} | ports {{json .HostConfig.PortBindings}}',
 1548:         ...containerNames,
 1549:       ]).sort()
 1550:     : [];
 1551:   const volumeNames = dockerLines(['volume', 'ls', '--filter', `name=${personal}`, '--format', '{{.Name}}']).sort();
 1552:   const volumes = volumeNames.length
 1553:     ? dockerLines(['volume', 'inspect', '--format', '{{.Name}} | created {{.CreatedAt}}', ...volumeNames]).sort()
 1554:     : [];
 1555:   return { containers, volumes };
 1556: }
 1557: 
 1558: function snapshotDifferences(before: DockerSnapshot, after: DockerSnapshot): string[] {
 1559:   const differences: string[] = [];
 1560:   const pairs = [
 1561:     ['container', before.containers, after.containers],
 1562:     ['volume', before.volumes, after.volumes],
 1563:   ] as const;
 1564:   for (const [what, first, second] of pairs) {
 1565:     for (const line of first) if (!second.includes(line)) differences.push(`${what} recorded BEFORE and not after: ${line}`);
 1566:     for (const line of second) if (!first.includes(line)) differences.push(`${what} recorded AFTER and not before: ${line}`);
 1567:   }
 1568:   return differences;
 1569: }
