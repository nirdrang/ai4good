   95: /** Stamp an attestation onto a live value. Non-enumerable, so it never travels into a JSON dump. */
   96: export function stampAttestation<T extends object>(value: T, attestation: LiveAttestation): T {
   97:   if (!attestation.evidence.trim()) throw new Error('a live attestation requires non-empty evidence');
   98:   if (!attestation.constructedFor.trim()) throw new Error('a live attestation must name the capability it was minted for');
