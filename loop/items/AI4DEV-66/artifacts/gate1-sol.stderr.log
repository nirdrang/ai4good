  591: /**
  592:  * AT-001.14 â€” the emailed reset flow changes the password: the new one works and the old one does
  593:  * not.
  594:  *
  595:  * The link is the one GoTrue really sent, held by the slot's own catcher, and its flow shape is read
  596:  * from what the link answers rather than remembered â€” the shape differs across CLI versions and
  597:  * AI4DEV-60's proof measured it before using it.
  598:  */
  599: export async function at00114(ctx: Ctx): Promise<void> {
  600:   const { w, sut } = await ctx.open();
  601:   const email = w.email('password-reset');
  602:   await registerConfirmAndSignIn(sut, email);
  603: 
  604:   await sut.requestPasswordReset(email);
  605:   const link = await sut.emailedPasswordResetLink(email);
  606:   expect(link, "no recovery email reached the slot's mail catcher").not.toBeNull();
  607: 
  608:   const NEW_PASSWORD = 'a completely different passphrase 42';
  609:   const completed = await sut.completePasswordReset(link!, NEW_PASSWORD);
  610:   expect(completed.ok, 'completing the emailed reset flow failed').toBe(true);
  611: 
  612:   const withNew = await sut.signInWithEmailPassword(email, NEW_PASSWORD);
  613:   expect(withNew, 'the new password does not work').toMatchObject({ ok: true });
  614: 
  615:   const withOld = await sut.signInWithEmailPassword(email, PASSWORD);
  616:   expect(withOld.ok, 'the OLD password still works after the reset').toBe(false);
  617: }
