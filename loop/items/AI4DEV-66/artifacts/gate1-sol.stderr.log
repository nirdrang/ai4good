  646: /* ------------------------------------------------- the per-organisation role ids (D3.L1) -------- */
  647: 
  648: /**
  649:  * THE TWO-MEMBERSHIP GIVEN, provisioned once for AT-001.16 and AT-001.36 â€” and HOW it is reached is
  650:  * part of what those greens claim, so it is written down here rather than buried in a helper name.
  651:  *
  652:  * ONE ACCOUNT, THREE ORGANISATIONS, TWO MEMBERSHIP ROWS:
  653:  *   * A â€” created by the PRODUCT path. `complete_signup` writes the organisation and seats the
  654:  *     caller as its `admin`, inside one transaction, exactly as an NGO signup does.
  655:  *   * B â€” created by the OPERATOR with NO membership row, and the actor is then granted B's single
  656:  *     seat as `member`.
  657:  *   * C â€” created by the OPERATOR and left unseated, so the actor holds no membership in it at all.
  658:  *
  659:  * WHY B AND C NEED AN OPERATOR AT ALL, said plainly because it is the honest part. No product path
  660:  * writes `'member'`: the single-seat invariant (AT-001.17) forbids invites, so there is no invite
  661:  * surface to mint a second member and no second seat for one to occupy. The `member` half of the
  662:  * `org_role` enum exists for AT-001.36 and this is how that criterion's Given is reached â€” the same
  663:  * posture the merged integration-verification item recorded for its own operator-provisioned Givens.
  664:  * The Given is provisioned; the BEHAVIOUR under test is entirely the product's.
  665:  */
  666: async function twoMembershipGiven(
  667:   sut: Awaited<ReturnType<Ctx['open']>>['sut'],
  668:   w: Awaited<ReturnType<Ctx['open']>>['w'],
  669:   label: string,
  670:   names: { a: string; b: string; c: string },
  671: ): Promise<{ session: Session; accountId: string; organizationA: string; organizationB: string; organizationC: string }> {
  672:   const session = await registerConfirmAndSignIn(sut, w.email(label));
  673:   const completion = await sut.completeSignup(
  674:     session,
  675:     { accountType: 'ngo', organizationName: names.a, acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
  676:     CLIENT_IP,
  677:   );
  678:   expect(completion, 'the NGO actor could not complete signup, so nothing below is about a seated admin').toMatchObject({ ok: true });
  679:   if (!completion.ok || completion.organizationId === null) throw new Error('unreachable: the assertion above fails first');
  680: 
  681:   const organizationB = await sut.createOrganizationAsOperator(names.b);
  682:   const seated = await sut.grantMembershipAsOperator(organizationB.id, completion.accountId, 'member');
  683:   expect(seated, `the operator could not seat the actor as ${names.b}'s single member, so the Given does not exist`).toMatchObject({
  684:     ok: true,
  685:   });
  686:   const organizationC = await sut.createOrganizationAsOperator(names.c);
  687: 
  688:   return {
  689:     session,
  690:     accountId: completion.accountId,
  691:     organizationA: completion.organizationId,
  692:     organizationB: organizationB.id,
  693:     organizationC: organizationC.id,
  694:   };
  695: }
