  177:   email: string;
  178:   provider: SessionProvider;
  179:   /**
  180:    * WHICH session this handle is â€” the mirror of one `auth.sessions` row, and the thing expiry and
  181:    * revocation happen to.
  182:    *
  183:    * It is separate from `accountId` because one account holds MANY sessions at once, which is the
  184:    * whole substance of AT-001.12 and AT-001.13: a revoked session must end access while the account
  185:    * lives on, and a refreshed session must outlive an unrefreshed sibling of the same instant. A
  186:    * handle keyed only by account could express neither.
  187:    *
  188:    * IT IS STILL NOT AN ACCESS TOKEN. Nothing here is signed, nothing is decoded, and no expiry claim
  189:    * is parsed; the fixture holds the session's validity in its own store and the SHIPPED
  190:    * `callerFromAuthAnswer` judges the answer that store renders. What a real access token does is
  191:    * measured on the live stack, in `loop/items/AI4DEV-60/proof-local.ts` checks (c) and (d).
  192:    */
  193:   sessionId: string;
  194: };
