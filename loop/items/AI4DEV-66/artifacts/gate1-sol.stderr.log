  556: /** The live route's `fixtures.worlds` half: one exact name, the same attestation requirement. */
  557: export function liveFixturesCapability<T>(value: T, attestation: LiveAttestation): Capability<T> {
  558:   const attested = attestationOf(attestation, SLOT_ATTESTATION_BRAND);
  559:   if (!attested) {
  560:     throw new Error(
  561:       `refusing to construct capability ${JSON.stringify(ADAPTER_DERIVED_EXACT)} on the live route with no slot ` +
  562:         'attestation: without the round trip that proved the coordinates answered with this run\'s minted value ' +
  563:         'there are no positive grounds, and finding no stand-in seam is not evidence of real backing.',
  564:     );
  565:   }
  566:   return sealed(
  567:     ADAPTER_DERIVED_EXACT,
  568:     { kind: 'real', evidence: `fixture worlds built against the slot's own stack â€” ${attested.evidence}` },
  569:     value,
  570:   );
  571: }
