  340:   ).toMatchObject({ accountType: 'platform_admin' });
  341: 
  342:   const visitor = await registerConfirmAndSignIn(sut, w.email('would-be-admin'));
  343:   const escalation = await sut.completeSignup(
  344:     visitor,
  345:     { accountType: 'platform_admin', acknowledgmentTextVersion: TEXT_VERSION },
  346:     CLIENT_IP,
  347:   );
  348:   expect(escalation.ok, 'the DEPLOYED public signup path minted a platform administrator').toBe(false);
  349:   if (escalation.ok) return;
  350:   expect(escalation.reason).toMatch(/platform_admin/);
