  390:   linkGithubIdentity(session: Session, githubHandle: string): Promise<void>;
  391:   /** Return sign-in with the same credentials â€” AT-001.01's final clause. */
  392:   signInWithEmailPassword(email: string, password: string): Promise<SignInOutcome>;
  393:   /**
  394:    * The return visit through an external provider â€” AT-001.02's "a later sign-in via GitHub returns
  395:    * to the same account".
  396:    *
  397:    * What it asserts is IDENTITY CONTINUITY, which is the half of that clause reachable without a
  398:    * person: an existing user whose account carries that provider's identity signs in to the SAME
  399:    * account rather than to a second one. The consent round trip itself is not performed and is named
  400:    * unproved in the plan's per-id table.
  401:    */
  402:   signInWithProvider(provider: SessionProvider, email: string): Promise<SignInOutcome>;
  403: 
  404:   /* ----------------------------- Supabase Auth's session layer -------------------------------- */
  405: 
  406:   /**
  407:    * End this session â€” the mirror of `POST /auth/v1/logout`, which deletes the `auth.sessions` row.
  408:    *
  409:    * IT ENDS ONE SESSION, NOT THE ACCOUNT'S ACCESS. That is the distinction AT-001.12's revocation
  410:    * half turns on: after it, work under this handle is refused and the account is otherwise
  411:    * untouched â€” a fresh sign-in works immediately, which is what makes re-authentication the
  412:    * REMEDY rather than a coincidence.
  413:    *
  414:    * SO IT MIRRORS THE `?scope=local` SHAPE, AND THE VENDOR'S DEFAULT IS THE OTHER ONE. Measured on
  415:    * the live stack and recorded in `loop/items/AI4DEV-60/proof-local.txt`: a plain
  416:    * `POST /auth/v1/logout` carries the `global` scope and ends EVERY session the user holds. The
  417:    * live counterpart of THIS member is therefore the scoped call, which is what check (c) makes â€”
  418:    * with a sibling session as the control, so "this session ended" and "the account's access ended"
  419:    * cannot be confused. No body in this suite asserts the difference: every one of them signs in
  420:    * afresh after a sign-out, which both scopes permit.
  421:    *
  422:    * It returns nothing, and a handle Auth never issued THROWS rather than answering politely: a
  423:    * body signing out a session that does not exist has a bug in the TEST, and a polite outcome
  424:    * would let that bug read as a product refusal further down. Same posture as
  425:    * `linkGithubIdentity`.
  426:    */
  427:   signOut(session: Session): Promise<void>;
  428:   /**
  429:    * Refresh a session â€” AT-001.13's act, and the whole point of it is what it does NOT take.
  430:    *
  431:    * NO CREDENTIALS PASS THROUGH THIS CALL, and that is structural rather than asserted: there is no
  432:    * parameter for a password. On the live stack the refresh token does this, which is why a client
  433:    * can keep a session alive while the user works and never ask them to sign in again.
  434:    *
  435:    * IT WORKS AFTER THE ACCESS TOKEN HAS EXPIRED, which is the mirror that matters â€” a refresh token
  436:    * outliving the access token is the entire mechanism. It stops working once the session is
  437:    * revoked, because revocation removes the session itself.
  438:    *
  439:    * IT EXTENDS THE SAME SESSION, and the returned handle carries the same `sessionId`. Whether the
  440:    * live vendor extends the row or rotates it is MEASURED rather than assumed â€”
  441:    * `loop/items/AI4DEV-60/proof-local.ts` check (d) reads `auth.sessions` before and after a real
  442:    * refresh. If the vendor rotates, this mirror is corrected to the measurement.
  443:    *
  444:    * ROTATION OF THE REFRESH TOKEN AND THE REUSE INTERVAL ARE NOT MODELLED. No criterion reads
  445:    * either, and modelling vendor semantics nothing asserts is how retired ground creeps back in.
  446:    */
  447:   refreshSession(session: Session): Promise<RefreshSessionOutcome>;
  448:   /**
  449:    * The account's live sessions â€” the mirror of reading `auth.sessions` with operator authority.
  450:    *
  451:    * "LIVE" MEANS NEITHER REVOKED NOR EXPIRED, so a session that has ended is absent rather than
  452:    * present-and-flagged. That is what the read is for: AT-001.38's second clause is "no
  453:    * authenticated session is created", and a refusal's own return value cannot show that nothing
  454:    * was minted â€” only a count taken before and after can. Same reason `organizationsNamed` and
  455:    * `discoveryMessagesBy` exist.
  456:    *
  457:    * IT IS AN OPERATOR'S READ, not a caller's, so it takes an account id rather than a session. No
  458:    * product surface in this tree exposes it and none is implied by it.
  459:    */
  460:   sessionsOf(accountId: string): Promise<{ sessionId: string }[]>;
  461: 
  462:   /* --------------------------- Supabase Auth's password reset --------------------------------- */
  463: 
  464:   /**
  465:    * Ask for a password reset â€” the mirror of `POST /auth/v1/recover`.
  466:    *
  467:    * IT ALWAYS SUCCEEDS, INCLUDING FOR AN ADDRESS NOBODY REGISTERED, and that is a security shape
  468:    * rather than laziness: an answer that differed would tell an anonymous caller which addresses
  469:    * hold accounts. REQ-001 spends AT-001.21 forbidding exactly that shape elsewhere, and the
  470:    * sign-in refusal in this same fixture gives one reason for both of its branches for the same
  471:    * reason. The live behaviour is measured â€” `loop/items/AI4DEV-60/proof-local.ts` check (e)
  472:    * calls `/auth/v1/recover` for a never-registered address and captures the answer.
  473:    *
  474:    * A LINK IS EMAILED ONLY WHERE THERE IS A PASSWORD TO RESET: a registered email/password user.
  475:    * A provider-established account has no password, so nothing is sent, and the answer is the same.
  476:    */
  477:   requestPasswordReset(email: string): Promise<{ ok: true }>;
  478:   /**
  479:    * The reset link emailed to this address, or `null` when none was emailed â€” the stand-in for the
  480:    * message the local mail catcher holds on the live stack.
  481:    *
  482:    * `null` is a real answer rather than only the empty case: no reset was requested, or the address
  483:    * has no password to reset.
  484:    */
  485:   emailedPasswordResetLink(email: string): Promise<string | null>;
  486:   /**
  487:    * Complete the emailed reset flow with a new password â€” AT-001.14's act.
  488:    *
  489:    * NO EXPIRY, NO SINGLE USE AND NO RESEND IS MODELLED OR ASSERTED. AT-001.15 is retired â€” the
  490:    * acceptance file's own words are that "reset-link expiry/single-use semantics are not stated in
  491:    * REQ-001" â€” so building any of them here would be asserting a criterion that was deliberately
  492:    * withdrawn. The link is NOT cleared when it is used, exactly as a verification link is not.
  493:    *
  494:    * THE NEVER-ISSUED NEGATIVE IS NOT AT-001.15 GROUND, and the difference is worth being exact
  495:    * about â€” it is the same difference `useVerificationLink` draws. It is not a claim about a link's
  496:    * lifetime; it guards this test's own oracle. A link-shaped string that reset an account it never
  497:    * belonged to would make "completing the emailed flow is what changes the password" mean nothing,
  498:    * because any string would change anything.
  499:    *
  500:    * WHETHER A LIVE RESET REVOKES THE ACCOUNT'S OTHER SESSIONS IS NEITHER MODELLED NOR ASSERTED. No
  501:    * criterion reads it, and `secure_password_change` sits false in `supabase/config.toml`.
  502:    */
  503:   completePasswordReset(link: string, newPassword: string): Promise<{ ok: boolean }>;
  504: 
  505:   /* ------------------------- Supabase Auth's verification state ------------------------------- */
  506: 
  507:   /**
  508:    * Whether Supabase Auth reports this account's email address confirmed â€” AT-001.09's observable.
  509:    *
  510:    * IT IS DERIVED, NOT STORED-AND-READ. The adapter renders the account's stored Auth state as the
  511:    * canonical GoTrue `/auth/v1/user` shape and judges the answer out of it with the SHIPPED
  512:    * `emailVerifiedFromUser`. That is the same pattern `completeSignup` uses for the GitHub handle
  513:    * (the GitHub leaf's gate-2 ruling R3), and it exists so the shipped extractor sits on the tested
  514:    * path rather than being a function no test ever runs â€” which is exactly how the future Discovery
  515:    * route will resolve the same fact from the same response.
  516:    *
  517:    * WHAT NO LOOP-TIER GREEN OVER IT PROVES: that the rendered shape is the shape GoTrue really
  518:    * sends. Only `loop/items/AI4DEV-59/proof-local.ts` check (d) touches that, by feeding a real
  519:    * response to the same shipped function.
  520:    */
  521:   emailVerified(accountId: string): Promise<boolean>;
  522:   /**
  523:    * The verification link emailed to this address, or `null` when none was emailed.
  524:    *
  525:    * `null` is a real answer rather than only the empty case: a provider registration is confirmed
  526:    * by the provider and no confirmation email is sent for it.
  527:    */
  528:   emailedVerificationLink(email: string): Promise<string | null>;
  529:   /**
  530:    * Use a verification link. Using the link Auth emailed for an address confirms that address; a
  531:    * link that was never issued returns `ok: false` and flips nothing.
  532:    *
  533:    * NO EXPIRY, NO SINGLE USE AND NO RESEND IS MODELLED OR ASSERTED. AT-001.11 is retired â€” the
  534:    * acceptance file's own words are that "verification-link expiry/single-use/resend semantics are
  535:    * not stated in REQ-001" â€” so building any of them here would be asserting a criterion that was
  536:    * deliberately withdrawn.
  537:    *
  538:    * THE NEVER-ISSUED NEGATIVE IS NOT AT-001.11 GROUND, and the difference is worth being exact
  539:    * about. It is not a claim about a link's lifetime; it guards this test's own oracle. A
  540:    * link-shaped string that verified an account it never belonged to would make "using the emailed
  541:    * link is what flips it" mean nothing at all, because any string would flip anything.
  542:    */
  543:   useVerificationLink(link: string): Promise<{ ok: boolean }>;
  544: 
  545:   /* ----------------------------------- the two product operations ----------------------------- */
  546: 
  547:   /**
  548:    * `supabase/functions/complete-signup` â€” turns an authenticated auth user into a typed account.
  549:    *
  550:    * IT RESOLVES ITS CALLER FIRST, through the shipped `callerFromAuthAnswer`, exactly as the
  551:    * deployed function does. An expired or revoked session therefore refuses BEFORE any product rule
  552:    * is consulted and writes nothing â€” which is the shape AT-001.12 reads.
  553:    */
  554:   completeSignup(session: Session, request: CompleteSignupRequest, ip: string): Promise<CompleteSignupOutcome>;
  555:   /**
  556:    * `supabase/functions/create-organization` â€” the NGO-only action AT-001.06 drives, and the write
  557:    * AT-001.12 uses as its stale-session oracle.
  558:    *
  559:    * IT IS AT-001.12'S WRITE FOR A REASON: no verification gate sits on it, so a refusal here is
  560:    * unambiguously the session layer's rather than the Discovery floor's. It resolves its caller the
  561:    * same way `completeSignup` does.
  562:    */
  563:   createOrganization(session: Session, organizationName: string): Promise<CreateOrganizationOutcome>;
  564: 
  565:   /**
  566:    * `supabase/functions/update-organization` â€” THE ADMIN-ONLY NGO-SIDE ACTION, and the operation
  567:    * AT-001.16 and AT-001.36 are both graded through.
  568:    *
  569:    * IT TAKES THE ORGANISATION AS AN ARGUMENT, which is what makes it usable as an isolation oracle:
  570:    * one caller, three targets, three different answers. The same session renames the organisation it
  571:    * administers, is refused in the organisation where it holds `member`, and is refused in an
  572:    * organisation it holds no membership in â€” and the two refusals carry DIFFERENT kinds.
  573:    *
  574:    * WHAT A GREEN OVER IT CLAIMS, said narrowly because the criterion's words are wider. It claims
  575:    * OPERATION-SURFACE isolation: authority does not cross organisations on this action. It does NOT
  576:    * claim read isolation â€” "acting in NGO A never grants access to NGO B's data" over drafts,
  577:    * ledgers and files is the tenant-isolation deliverable's (`loop/decomp/req-001.md` D5.L1), which
  578:    * is blocked by this leaf and lands the policy set. This tree has no read surface to leak through:
  579:    * row-level security is on with zero policies and `org_memberships` reaches no Data API role.
  580:    */
  581:   updateOrganization(session: Session, organizationId: string, name: string): Promise<UpdateOrganizationOutcome>;
  582: 
  583:   /* ------------------------------------ the operator's surface -------------------------------- */
  584: 
  585:   /**
  586:    * Create an organisation WITH NO MEMBERSHIP ROW â€” an authority no product path holds, and the
  587:    * reason it exists is exact.
  588:    *
  589:    * EVERY PRODUCT PATH SEATS ITS CREATOR AS ADMIN: `complete_signup` does it for an NGO signup and
  590:    * `create_organization` does it for a second organisation. The single-seat invariant then refuses
  591:    * a second membership row in that organisation. So the Given AT-001.16 and AT-001.36 both need â€”
  592:    * one account holding DIFFERENT roles in two organisations â€” is unconstructible through product
  593:    * paths alone, not because the product is wrong but because the product is right. This method
  594:    * creates the unseated organisation the operator then seats the actor into as `member`, and mints
  595:    * the third organisation AT-001.16's not-a-member arm targets.
  596:    *
  597:    * IT IS AN OPERATOR ACT, exactly as `provisionPlatformAdmin` is: a direct database operation, not
  598:    * a service-role write, and no running service holds it. It THROWS on failure rather than
  599:    * returning an outcome, because a Given that could not be provisioned is a bug in the TEST and a
  600:    * polite refusal would read as a product answer three assertions later.
  601:    */
  602:   createOrganizationAsOperator(name: string): Promise<OrganizationRow>;
  603: 
  604:   /**
  605:    * Grant a membership directly, as the operator â€” the provisioning act AND the refusal probe.
  606:    *
  607:    * IT IS BOTH, deliberately, and that is why it returns an outcome where
  608:    * `createOrganizationAsOperator` throws. Two criteria read its REFUSALS as the thing under test:
  609:    * AT-001.37 needs a direct grant to a volunteer account to be rejected on a path with no
  610:    * TypeScript on it, and AT-001.17 needs a second seat in an already-seated organisation to be
  611:    * rejected. Its successes are Givens; its refusals are evidence.
  612:    *
  613:    * NOTHING IN THE PRODUCT WRITES `'member'`, and that is by design rather than by omission â€” the
  614:    * single-seat invariant forbids invites, so no product path can mint a second member. The
  615:    * `member` half of the `org_role` enum exists for AT-001.36, and this is how that criterion's
  616:    * Given is reached. The body that uses it says so in its own evidence.
  617:    */
  618:   grantMembershipAsOperator(organizationId: string, accountId: string, role: OrgRole): Promise<GrantMembershipOutcome>;
  619: 
  620:   /**
  621:    * Re-point an organisation's EXISTING membership row at a different account, as the operator â€”
  622:    * the refusal probe for the trigger's UPDATE half.
  623:    *
  624:    * THE ROLE IS NOT AN ARGUMENT, because the role is not what moves: the row keeps whatever role it
  625:    * holds and only its account changes. That is exactly the attack the migration names in its own
  626:    * prose â€” a row inserted for an NGO account and then re-keyed to a volunteer â€” and the read-back a
  627:    * body makes afterwards is that the row still holds the ORIGINAL account with its ORIGINAL role.
  628:    *
  629:    * IT IS A REFUSAL PROBE AND NOTHING ELSE, so it returns an outcome rather than throwing: no Given
  630:    * in this suite is reached by re-pointing a seat, and every body that calls it is asserting that
  631:    * the database said no.
  632:    */
  633:   repointMembershipAsOperator(organizationId: string, accountId: string): Promise<RepointMembershipOutcome>;
  634: 
  635:   /**
  636:    * Create a project, as the operator â€” a GIVEN, never an act under test.
  637:    *
  638:    * NO PRODUCT PATH CREATES A PROJECT, at either tier, and this method does not pretend otherwise.
  639:    * AT-001.32's Given is "a project with an assigned volunteer", and the criterion is about the
  640:    * SECOND volunteer; reaching that state needs a project, and building product project creation to
  641:    * get one would be landing another requirement's surface early. It throws on failure, for the
  642:    * reason `createOrganizationAsOperator` throws.
  643:    */
  644:   createProjectAsOperator(organizationId: string, name: string): Promise<ProjectRow>;
  645: 
  646:   /**
  647:    * Attach a volunteer to a project, as the operator â€” the Given AND the refusal probe, exactly as
  648:    * `grantMembershipAsOperator` is both.
  649:    *
  650:    * THE FIRST ATTACH IS THE GIVEN; THE SECOND IS THE ACT UNDER TEST. AT-001.32 says attaching a
  651:    * second volunteer is rejected, and the path this method drives is the one with no product code on
  652:    * it at all â€” which is what makes the refusal a property of the database rather than of a writer
  653:    * somebody could change.
  654:    */
  655:   assignVolunteerAsOperator(projectId: string, accountId: string): Promise<AssignVolunteerOutcome>;
  656: 
  657:   /**
  658:    * The project as it stands, or `null` when there is no such project â€” the read-back a refused
  659:    * attach needs.
  660:    *
  661:    * IT RETURNS THE WHOLE ROW rather than the assigned id alone, and the difference is not cosmetic:
  662:    * a bare `string | null` cannot tell "the seat is free" from "there is no such project", and a
  663:    * body asserting the seat still holds the FIRST volunteer would then pass over a project that had
  664:    * been deleted.
  665:    */
  666:   projectAssignment(projectId: string): Promise<ProjectRow | null>;
  667: 
  668:   /* --------------------------- the Discovery gate's stand-in surface -------------------------- */
  669: 
  670:   /**
  671:    * Attempt to send a Discovery message â€” AT-001.10's action.
  672:    *
  673:    * THERE IS NO DEPLOYED ROUTE BEHIND THIS, at either tier. See the fourth kind in this type's own
  674:    * header: the Discovery route is REQ-002/004's and does not exist, so this member is a stand-in
  675:    * surface that exists to put the SHIPPED `discoveryMessageAllowed` on a tested path. At loop
  676:    * tier the adapter derives the caller's verified fact through the shipped
  677:    * `emailVerifiedFromUser`, consults the shipped gate, and refuses with the GATE's own reason.
  678:    *
  679:    * THE BODY IS AN OPAQUE STRING AND NOTHING ELSE. Recipients, threads, attachments and message
  680:    * state are REQ-002/004's semantics; inventing any of them here to make this member look real
  681:    * would be building another requirement's surface early. What AT-001.10 needs is an attempted
  682:    * write and a way to see whether it happened, and one string supplies both.
  683:    */
  684:   sendDiscoveryMessage(session: Session, body: string): Promise<SendDiscoveryMessageOutcome>;
  685:   /**
  686:    * The Discovery message bodies this account has sent â€” read-back, and it is not optional.
  687:    *
  688:    * A BLOCK WHOSE WRITE HAPPENED ANYWAY IS NOT A BLOCK. The refusal's own return value cannot show
  689:    * that nothing was written, for the same reason `organizationsNamed` exists: a refusal hands
  690:    * back no identifier, so the row that must NOT be there can only be looked for by who would have
  691:    * written it.
  692:    */
  693:   discoveryMessagesBy(accountId: string): Promise<string[]>;
  694: 
  695:   /* ------------------------------------------- read-back -------------------------------------- */
  696: 
  697:   account(accountId: string): Promise<AccountRow | null>;
  698:   organization(organizationId: string): Promise<OrganizationRow | null>;
  699:   membership(organizationId: string, accountId: string): Promise<MembershipRow | null>;
  700:   acknowledgments(accountId: string): Promise<AcknowledgmentRow[]>;
  701:   /**
  702:    * The volunteer's imported GitHub profile, or `null` â€” AT-001.05's observable.
  703:    *
  704:    * `null` is a real and asserted answer, not merely the empty case: AT-001.05's pre-completion
  705:    * negative reads it AFTER the identity is linked and BEFORE the signup completes, and requires
  706:    * null there. That is what proves the population is CAUSED by completion rather than sitting in a
  707:    * queue somewhere waiting to be drained.
  708:    */
  709:   volunteerProfile(accountId: string): Promise<VolunteerProfileRow | null>;
  710: 
  711:   /**
  712:    * The two read-backs a REFUSED action needs, which the keyed ones above cannot serve.
  713:    *
  714:    * Asserting that a rejection wrote nothing means looking for rows whose identifiers were never
  715:    * handed out â€” a refused `createOrganization` returns no organisation id. So one search by the
  716:    * name that was attempted, and one listing of everything an account is a member of. Without them
  717:    * the strongest statement available is "the call said no", and an implementation that writes both
