  390:   /** account id -> the imported volunteer profile, mirroring `public.volunteer_profiles`'s primary key */
  391:   volunteerProfiles: Map<string, VolunteerProfileRow>;
  392:   /**
  393:    * account id -> the Discovery message bodies that account has sent.
  394:    *
  395:    * There is NO table behind this and no route that writes one; see the header's closing paragraph.
  396:    * It exists so AT-001.10 can assert that a refused send wrote NOTHING, which the refusal's own
