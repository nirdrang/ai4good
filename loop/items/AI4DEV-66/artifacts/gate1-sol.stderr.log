  619: /**
  620:  * AT-001.38 â€” the wrong password is rejected and NO authenticated session is created.
  621:  *
  622:  * The second clause is the one a refusal's own return value cannot show, so it is measured as an
  623:  * UNCHANGED set of `auth.sessions` rows across the refused attempt â€” read with operator authority,
  624:  * which is the only place the fact lives.
  625:  */
  626: export async function at00138(ctx: Ctx): Promise<void> {
  627:   const { w, sut } = await ctx.open();
  628:   const email = w.email('wrong-password');
  629:   const session = await registerConfirmAndSignIn(sut, email);
  630: 
  631:   const before = (await sut.sessionsOf(session.accountId)).map((row) => row.sessionId).sort();
  632: 
  633:   const refused = await sut.signInWithEmailPassword(email, 'not the password at all');
  634:   expect(refused.ok, 'the wrong password signed in').toBe(false);
  635: 
  636:   const after = (await sut.sessionsOf(session.accountId)).map((row) => row.sessionId).sort();
  637:   expect(after, 'the refused sign-in created an authenticated session').toEqual(before);
  638: 
  639:   // THE CONTROL: the CORRECT password does add exactly one row, so the assertion above is measuring
  640:   // a real observable rather than a table nothing ever writes to.
  641:   const accepted = await sut.signInWithEmailPassword(email, PASSWORD);
  642:   expect(accepted, 'the correct password was refused, so the negative above proves nothing').toMatchObject({ ok: true });
  643:   expect((await sut.sessionsOf(session.accountId)).length, 'the accepted sign-in added no session row').toBe(after.length + 1);
  644: }
