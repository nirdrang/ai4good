  766: /**
  767:  * AT-001.36 â€” an admin in NGO A and a member in NGO B succeeds only where it is the admin.
  768:  *
  769:  * THE DISCRIMINATOR IS THE `member` ROW, and it is asserted before the action is attempted. The
  770:  * refusal under test is `not-an-admin` â€” the caller IS in this organisation and its role here is too
  771:  * low â€” which is a DIFFERENT refusal from AT-001.16's `not-a-member`. Without the row assertion the
  772:  * body could not tell "rejected because the role is member" from "rejected because nothing was
  773:  * found", and the criterion's whole point is that "NGO admin" names the admin role IN THAT NGO.
  774:  */
  775: export async function at00136(ctx: Ctx): Promise<void> {
  776:   const { w, sut } = await ctx.open();
  777:   const NAMES = {
  778:     a: 'Riverside Shelter 36A',
  779:     b: 'Northgate Foodbank 36B',
  780:     c: 'Eastside Legal Aid 36C',
  781:   };
  782:   const RENAMED_A = 'Riverside Shelter Second Programme 36A';
  783:   const ATTEMPTED_B = 'Northgate Foodbank Renamed By A Member 36B';
  784: 
  785:   const given = await twoMembershipGiven(sut, w, 'admin-and-member-36', NAMES);
  786: 
  787:   // THE GIVEN, ASSERTED: admin in A, member in B, one account.
  788:   expect(await sut.membership(given.organizationA, given.accountId), 'the actor is not A\'s admin').toMatchObject({
  789:     accountId: given.accountId,
  790:     role: 'admin',
  791:   });
  792:   expect(await sut.membership(given.organizationB, given.accountId), 'the actor is not B\'s member').toMatchObject({
  793:     accountId: given.accountId,
  794:     role: 'member',
  795:   });
  796: 
  797:   // IT SUCCEEDS IN A.
  798:   const inA = await sut.updateOrganization(given.session, given.organizationA, RENAMED_A);
  799:   expect(inA, 'the admin-only action failed where the caller IS the admin').toMatchObject({ ok: true });
  800:   expect(await sut.organization(given.organizationA)).toMatchObject({ name: RENAMED_A });
  801: 
  802:   // AND IS REJECTED IN B, on the role rather than on absence.
  803:   const inB = await sut.updateOrganization(given.session, given.organizationB, ATTEMPTED_B);
  804:   expect(inB.ok, 'the same account performed the admin-only action where it holds the member role').toBe(false);
  805:   if (inB.ok) return;
  806:   expect(inB.kind, 'the refusal is not the not-an-admin one').toBe('not-an-admin');
  807:   expect(
  808:     inB.kind,
  809:     'the refusal came back as not-a-member, which would mean the member row was not found rather than not sufficient',
  810:   ).not.toBe('not-a-member');
  811: 
  812:   // AND IT WROTE NOTHING.
  813:   expect(await sut.organization(given.organizationB), 'the refused action renamed B anyway').toMatchObject({ name: NAMES.b });
  814:   expect(await sut.organizationsNamed(ATTEMPTED_B), 'the refused action created an organisation by the attempted name').toEqual([]);
  815:   expect(await sut.membership(given.organizationB, given.accountId), 'the refused action changed the actor\'s role in B').toMatchObject({
  816:     role: 'member',
  817:   });
  818: }
