FILE tests/at/suites/req-001/_source-scan.ts
    1: /**
    2:  * AT-001.17's SOURCE ARM â€” the executable oracle for its "UI absent" clause (gate-1 ruling 3).
    3:  *
    4:  * The criterion's parenthetical is "(UI absent; API rejects)", and every other arm of that body
    5:  * tests the second half: the acceptance surface holds no invite method, the deployed function does
    6:  * not exist, the membership table reaches no client role, and the database refuses a second seat.
    7:  * None of them looks at `src/routes/`, so an invite screen could be added while both tiers stayed
    8:  * green. This module is what looks.
    9:  *
   10:  * IT LIVES IN ITS OWN FILE, not in a test file and not in `_integration.ts`, for one reason: the arm
   11:  * runs at BOTH tiers and the two bodies live in different files. A helper imported by both is a
   12:  * shared arm, which is what the plan permits; a copy in each would be two statements of one check.
   13:  * The file name starts with an underscore and does not end in `.test.ts`, so `at:check` does not
   14:  * read it for call sites.
   15:  *
   16:  * ============================================================================================
   17:  * WHAT THIS ORACLE IS, AND WHAT IT IS NOT â€” the residual, stated openly because the ruling states it
   18:  * ============================================================================================
   19:  *
   20:  * IT IS A NAMING ORACLE. It reads the names of the files under `src/routes/` and the route paths in
   21:  * the generated route tree, and it fails when one of them is named like an invite or an add-member
   22:  * surface. A deliberately renamed invite screen escapes it, exactly as it escapes any static check.
   23:  * Semantic absence â€” "this screen does not invite anybody, whatever it is called" â€” stays with human
   24:  * review, and the merge ruling carries that limit.
   25:  *
   26:  * WHY IT IS WORTH HAVING ANYWAY: the realistic regression is not a disguise, it is somebody adding
   27:  * `src/routes/invite.tsx` because a design asked for it. This oracle turns that into a red test in
   28:  * the same run rather than into a green suite over a product that grew a second seat.
   29:  *
   30:  * IT READS THE TREE, NOT THE SYSTEM UNDER TEST. That is the point of an out-of-band check: the
   31:  * witness is the source, not something the component under test reports about itself.
   32:  */
   33: 
   34: import { readdirSync, readFileSync } from 'node:fs';
   35: import { fileURLToPath } from 'node:url';
   36: 
   37: /** The repository root, resolved from THIS file, so the answer never depends on the caller's cwd. */
   38: const REPO_ROOT = fileURLToPath(new URL('../../../../', import.meta.url));
   39: 
   40: /**
   41:  * The naming this oracle refuses.
   42:  *
   43:  * The two spellings the criterion itself uses â€” "invite" and "add a second member" â€” plus the
   44:  * hyphen, underscore and camel-case forms a router file or a route path would carry. It is
   45:  * deliberately narrow: a pattern wide enough to catch anything would fail on unrelated names and
   46:  * would then be widened back by whoever hit it first.
   47:  */
   48: const INVITE_OR_ADD_MEMBER = /invite|add[-_ ]?member|addmember|add[-_ ]?user|adduser/i;
   49: 
   50: export type SourceHit = { where: string; name: string };
   51: 
   52: /** Every file and directory name under `src/routes/`, recursively, relative to that directory. */
   53: function routeFileNames(): string[] {
   54:   const root = new URL('../../../../src/routes/', import.meta.url);
   55:   const found: string[] = [];
   56:   const walk = (relative: string): void => {
   57:     for (const entry of readdirSync(new URL(relative, root), { withFileTypes: true })) {
   58:       const path = `${relative}${entry.name}`;
   59:       found.push(path);
   60:       if (entry.isDirectory()) walk(`${path}/`);
   61:     }
   62:   };
   63:   walk('');
   64:   return found;
   65: }
   66: 
   67: /** Every quoted string literal in the generated route tree â€” which is where its paths and ids are. */
   68: function routeTreeLiterals(): string[] {
   69:   const text = readFileSync(new URL('../../../../src/routeTree.gen.ts', import.meta.url), 'utf8');
   70:   return [...text.matchAll(/'([^'\n]*)'|"([^"\n]*)"/g)].map((match) => match[1] ?? match[2] ?? '');
   71: }
   72: 
   73: /**
   74:  * Every place in the route surface whose NAME reads like an invite or an add-member capability.
   75:  *
   76:  * An EMPTY array is the assertion both AT-001.17 bodies make. It throws rather than returning
   77:  * nothing when `src/routes/` cannot be read at all: an oracle that answered "no hits" because it
   78:  * found no directory would be the false green this whole arrangement exists to remove â€” a negative
   79:  * from a broken instrument is indistinguishable from a true absence unless the instrument says so.
   80:  */
   81: export function inviteOrAddMemberSurface(): SourceHit[] {
   82:   let files: string[];
   83:   try {
   84:     files = routeFileNames();
   85:   } catch (error) {
   86:     throw new Error(
   87:       `AT-001.17's source arm could not read src/routes/ under ${REPO_ROOT} â€” the absence it reports would be the ` +
   88:         `instrument's, not the product's: ${(error as Error).message}`,
   89:     );
   90:   }
   91:   if (files.length === 0) {
   92:     throw new Error("AT-001.17's source arm found src/routes/ empty, which no checkout of this tree is â€” refusing to report an absence");
   93:   }
   94: 
   95:   const hits: SourceHit[] = files
   96:     .filter((name) => INVITE_OR_ADD_MEMBER.test(name))
   97:     .map((name) => ({ where: 'src/routes/', name }));
   98: 
   99:   for (const literal of routeTreeLiterals()) {
  100:     if (INVITE_OR_ADD_MEMBER.test(literal)) hits.push({ where: 'src/routeTree.gen.ts', name: literal });
  101:   }
  102:   return hits;
  103: }
