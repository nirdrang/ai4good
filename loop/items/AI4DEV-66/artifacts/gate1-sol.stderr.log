  918: /**
  919:  * AT-001.17 â€” no capability exists to invite or add a second member to an org.
  920:  *
  921:  * A NEGATIVE CRITERION NEEDS MORE THAN ONE WITNESS, because "no capability exists" is a claim about
  922:  * every path rather than about one. Four arms, each closing a different way in:
  923:  *
  924:  *   1. NO DEPLOYED FUNCTION. The functions router is asked for an invite endpoint by name and
  925:  *      answers 404 `Function not found` â€” with a DEPLOYED function on the same stack as the control,
  926:  *      because a router that answered 404 to everything would make the first answer meaningless.
  927:  *      Both shapes were measured before this body was written (verify-first answer (e)).
  928:  *   2. NO CLIENT REACH. `public.org_memberships` is asked for through the Data API with the
  929:  *      publishable key and refuses â€” the privilege layer, not a policy, since the table is granted
  930:  *      to no client role at all.
  931:  *   3. NO ROOM IN THE DATABASE. The operator, whose authority exceeds anything the product holds,
  932:  *      tries to seat a second member in an organisation that already holds its one seat, and the
  933:  *      unique index refuses.
  934:  *   4. NO SURFACE IN THE APP. `src/routes/` and the generated route tree carry no invite or
  935:  *      add-member naming â€” the source arm, shared with the loop body, with its residual stated in
  936:  *      `_source-scan.ts`.
  937:  */
  938: export async function at00117(ctx: Ctx): Promise<void> {
  939:   const { w, sut } = await ctx.open();
  940: 
  941:   // ARM 4 first, because it needs no state and a failure in it is the cheapest to read.
  942:   expect(
  943:     inviteOrAddMemberSurface(),
  944:     'the app carries a route named like an invite or add-member surface, so "UI absent" is no longer true',
  945:   ).toEqual([]);
  946: 
  947:   const url = (process.env.AT_SUPABASE_URL ?? '').replace(/\/$/, '');
  948:   const anonKey = process.env.AT_SUPABASE_ANON_KEY ?? '';
  949:   expect(url && anonKey, 'this child holds no slot coordinates, so the absence probes below cannot run').toBeTruthy();
  950: 
  951:   // ARM 1 â€” the deployed-function absence probe, with its control.
  952:   const absent = await fetch(`${url}/functions/v1/invite-member`, {
  953:     method: 'POST',
  954:     headers: { apikey: anonKey, Authorization: `Bearer ${anonKey}`, 'Content-Type': 'application/json' },
  955:     body: JSON.stringify({}),
  956:   });
  957:   const absentBody = await absent.text();
  958:   expect(absent.status, 'an invite-member function answered on the deployed stack').toBe(404);
  959:   expect(absentBody, 'the router did not answer with its not-found shape').toContain('Function not found');
  960: 
  961:   const present = await fetch(`${url}/functions/v1/create-organization`, {
  962:     method: 'POST',
  963:     headers: { apikey: anonKey, Authorization: `Bearer ${anonKey}`, 'Content-Type': 'application/json' },
  964:     body: JSON.stringify({}),
  965:   });
  966:   // THE CONTROL ASSERTS THE MEASURED ANSWER, not merely a non-404 (gate-2 ruling R6). Verify-first
  967:   // answer (e) measured this exact call answering 401 with its own refusal body, so pinning it costs
  968:   // nothing and makes the control prove two things instead of one: the router resolves names AND the
  969:   // function it resolved really ran. A 500, a 502 or a misroute passed the old assertion.
  970:   expect(
  971:     present.status,
  972:     'the deployed control did not answer its measured 401, so the router may not be resolving names and the probe above proves nothing',
  973:   ).toBe(401);
  974: 
  975:   // ARM 2 â€” the membership table through the Data API, with the publishable key.
  976:   const clientRead = await fetch(`${url}/rest/v1/org_memberships?select=role`, {
  977:     headers: { apikey: anonKey, Authorization: `Bearer ${anonKey}`, Accept: 'application/json' },
  978:   });
  979:   const clientReadBody = await clientRead.text();
  980:   // THE STATUS AND THE BODY ARE BOTH PINNED TO WHAT WAS MEASURED (gate-2 ruling R7). The plan's claim
  981:   // is that the table is unreachable BECAUSE no privilege reaches a client role, and `status >= 400`
  982:   // does not prove the because: a missing table route (404) or a down PostgREST (5xx) passed it. The
  983:   // measurement is in `loop/items/AI4DEV-62/artifacts/gate2-verify-answers.md`, v2 â€” HTTP 401 with
  984:   // SQLSTATE 42501 and `permission denied for table org_memberships`. The status is 401 rather than
  985:   // the 403 the service role receives (verify-first answer (c)) because the anon key carries no
  986:   // authenticated user; the privilege layer is the same one either way, which is what the body says.
  987:   expect(clientRead.status, 'the membership table did not answer the measured privilege refusal to a client key').toBe(401);
  988:   expect(clientReadBody, 'the refusal does not name a permission denial, so it is not the privilege layer answering').toMatch(
  989:     /permission denied/i,
  990:   );
  991: 
  992:   // ARM 3 â€” the operator's own attempt at a second seat, on an organisation the PRODUCT path
  993:   // created and seated. The one-seat index is what refuses; nothing about the product is consulted.
  994:   const owner = await registerConfirmAndSignIn(sut, w.email('single-seat-owner-17'));
  995:   const ownerCompletion = await sut.completeSignup(
  996:     owner,
  997:     { accountType: 'ngo', organizationName: 'Riverside Shelter 17', acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
  998:     CLIENT_IP,
  999:   );
 1000:   expect(ownerCompletion, 'the NGO owner could not complete signup, so there is no seated organisation').toMatchObject({ ok: true });
 1001:   if (!ownerCompletion.ok || ownerCompletion.organizationId === null) return;
 1002: 
 1003:   const wouldBeSecond = await registerConfirmAndSignIn(sut, w.email('would-be-second-17'));
 1004:   const secondCompletion = await sut.completeSignup(
 1005:     wouldBeSecond,
 1006:     { accountType: 'ngo', organizationName: 'Northgate Foodbank 17', acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
 1007:     CLIENT_IP,
 1008:   );
 1009:   expect(secondCompletion, 'the second NGO account could not complete signup').toMatchObject({ ok: true });
 1010:   if (!secondCompletion.ok) return;
 1011: 
 1012:   for (const role of ['admin', 'member'] as const) {
 1013:     const seated = await sut.grantMembershipAsOperator(ownerCompletion.organizationId, secondCompletion.accountId, role);
 1014:     expect(seated.ok, `a second ${role} was seated in an organisation that already holds its one seat`).toBe(false);
 1015:     if (seated.ok) return;
 1016:     expect(seated.kind, `the second ${role} was refused for a reason other than the seat being taken`).toBe('org-already-seated');
 1017:   }
 1018: 
 1019:   // AND THE ORGANISATION STILL HOLDS EXACTLY ONE SEAT, its owner's.
 1020:   const seats = await sut.membershipsOf(secondCompletion.accountId);
 1021:   expect(
 1022:     seats.map((row) => row.organizationId),
 1023:     'the refused grant seated the second account in the first organisation anyway',
 1024:   ).not.toContain(ownerCompletion.organizationId);
 1025:   expect(
 1026:     await sut.membership(ownerCompletion.organizationId, ownerCompletion.accountId),
 1027:     'the owner lost its own seat',
 1028:   ).toMatchObject({ role: 'admin' });
 1029: }
