  316: /**
  317:  * AT-001.07 â€” a provisioned platform administrator authenticates and carries the type; the public
  318:  * signup surface offers only the two.
  319:  *
  320:  * THE SECOND CLAUSE IS PROVED DIFFERENTLY HERE, and that difference is the reason this body exists.
  321:  * At loop tier it reads `publicSignupAccountTypes()`, which is a constant a shipped module exports â€”
  322:  * a list is a claim. At this tier the live oracle is a REFUSAL, which is a fact: the DEPLOYED
  323:  * completion path is asked for a `platform_admin` and must refuse it and leave no row behind. That
  324:  * is a strictly stronger oracle, and it is why the constant is not among the methods the live
  325:  * adapter backs.
  326:  */
  327: export async function at00107(ctx: Ctx): Promise<void> {
  328:   const { w, sut } = await ctx.open();
  329: 
  330:   const adminEmail = w.email('platform-admin');
  331:   const provisioned = await sut.provisionPlatformAdmin(adminEmail, PASSWORD);
