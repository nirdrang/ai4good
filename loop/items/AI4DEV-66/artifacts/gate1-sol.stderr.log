  820: /**
  821:  * AT-001.37 â€” granting a per-NGO role to a volunteer account is rejected on EVERY path.
  822:  *
  823:  * "EVERY PATH" IS WHY THIS BODY HAS FOUR ARMS AND A CONTROL. Two product paths already refuse, and
  824:  * they refuse for product reasons a future change could move; the third arm is the one that closes
  825:  * the criterion, because it carries no edge function, no shared module and no TypeScript at all â€”
  826:  * an operator's direct insert, which is the shape every path nobody has written yet will have. The
  827:  * fourth arm is the same grant reached in TWO statements: the seat is taken by an NGO account and
  828:  * then re-pointed at the volunteer, which changes no row count and so meets only the NGO-only rule's
  829:  * UPDATE half (gate-2 ruling R5).
  830:  *
  831:  * THE CONTROL IS NOT OPTIONAL: an insert that refused everybody would satisfy the negative on its
  832:  * own, so an NGO account is granted the same seat afterwards and must succeed. It also SEATS the row
  833:  * the fourth arm re-points, which is why it runs before that arm rather than last.
  834:  */
  835: export async function at00137(ctx: Ctx): Promise<void> {
  836:   const { w, sut } = await ctx.open();
  837:   const ATTEMPTED_ORG = 'Volunteer Attempted Organisation 37';
  838:   const ATTEMPTED_ON_SIGNUP = 'Volunteer Owned Organisation 37';
  839:   const OPERATOR_ORG = 'Operator Created Organisation 37';
  840: 
  841:   const volunteer = await registerConfirmAndSignIn(sut, w.email('volunteer-37'));
  842:   await sut.linkGithubIdentity(volunteer, `volunteer-37-${volunteer.accountId.slice(0, 8)}`);
  843:   const completion = await sut.completeSignup(
  844:     volunteer,
  845:     { accountType: 'volunteer', acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
  846:     CLIENT_IP,
  847:   );
  848:   expect(completion, 'the volunteer could not complete signup, so nothing below is about a volunteer account').toMatchObject({ ok: true });
  849:   if (!completion.ok) return;
  850:   expect(await sut.account(completion.accountId), 'the account under test is not a volunteer').toMatchObject({ accountType: 'volunteer' });
  851: 
  852:   // ARM 1 â€” the product's NGO-only action. A volunteer cannot create the organisation that would
  853:   // have seated it as an admin.
  854:   const ngoOnly = await sut.createOrganization(volunteer, ATTEMPTED_ORG);
  855:   expect(ngoOnly.ok, 'a volunteer performed the NGO-only action and would have been seated as its admin').toBe(false);
  856:   expect(await sut.organizationsNamed(ATTEMPTED_ORG), 'the refused action created an organisation').toEqual([]);
  857: 
  858:   // ARM 2 â€” the product's signup path. A volunteer completion carrying an organisation name is
  859:   // refused outright, so the seat is never reached through signup either.
  860:   const second = await registerConfirmAndSignIn(sut, w.email('volunteer-with-org-37'));
  861:   await sut.linkGithubIdentity(second, `volunteer-org-37-${second.accountId.slice(0, 8)}`);
  862:   const withOrganization = await sut.completeSignup(
  863:     second,
  864:     { accountType: 'volunteer', organizationName: ATTEMPTED_ON_SIGNUP, acknowledgmentTextVersion: TEXT_VERSION },
  865:     CLIENT_IP,
  866:   );
  867:   expect(withOrganization.ok, 'a volunteer completion carrying an organisation name was accepted').toBe(false);
  868:   expect(await sut.account(second.accountId), 'the refused completion left an account row behind').toBeNull();
  869:   expect(await sut.organizationsNamed(ATTEMPTED_ON_SIGNUP), 'the refused completion created an organisation').toEqual([]);
  870: 
  871:   // ARM 3 â€” THE OPERATOR'S DIRECT GRANT, into an organisation whose single seat is free, so the
  872:   // refusal cannot be the one-seat index answering instead of the NGO-only rule. Both roles are
  873:   // attempted: the criterion is about a per-NGO role, not about the admin role.
  874:   const organization = await sut.createOrganizationAsOperator(OPERATOR_ORG);
  875:   for (const role of ['admin', 'member'] as const) {
  876:     const granted = await sut.grantMembershipAsOperator(organization.id, completion.accountId, role);
  877:     expect(granted.ok, `an operator granted the ${role} role to a volunteer account`).toBe(false);
  878:     if (granted.ok) return;
  879:     expect(granted.kind, `the ${role} grant was refused for a reason other than the account type`).toBe('not-an-ngo-account');
  880:   }
  881: 
  882:   // THE READ-BACK: zero membership rows anywhere for this account.
  883:   expect(await sut.membershipsOf(completion.accountId), 'the volunteer holds a per-organisation role after every path refused').toEqual([]);
  884:   expect(await sut.membership(organization.id, completion.accountId), 'the refused grant wrote a membership row').toBeNull();
  885: 
  886:   // THE CONTROL â€” the same seat, the same method, an NGO account: it succeeds. So the three
  887:   // refusals above are about the account TYPE and not about the path being closed to everybody.
  888:   const control = await registerConfirmAndSignIn(sut, w.email('ngo-control-37'));
  889:   const controlCompletion = await sut.completeSignup(
  890:     control,
  891:     { accountType: 'ngo', organizationName: 'Riverside Shelter Control 37', acknowledgmentTextVersion: TEXT_VERSION, ...SIGNER },
  892:     CLIENT_IP,
  893:   );
  894:   expect(controlCompletion, 'the NGO control could not complete signup').toMatchObject({ ok: true });
  895:   if (!controlCompletion.ok) return;
  896:   const seated = await sut.grantMembershipAsOperator(organization.id, controlCompletion.accountId, 'member');
  897:   expect(seated, 'the operator grant refuses an NGO account too, so the refusals above prove nothing').toMatchObject({ ok: true });
  898: 
  899:   // ARM 4 â€” THE SAME GRANT IN TWO STATEMENTS. The seat the control just took is re-pointed at the
  900:   // volunteer. The row count does not change, so the one-seat index never sees this write and the
  901:   // NGO-only trigger's UPDATE half is the only guard on it â€” the attack the migration names in its
  902:   // own prose, driven here for the first time (gate-2 ruling R5).
  903:   const repointed = await sut.repointMembershipAsOperator(organization.id, completion.accountId);
  904:   expect(repointed.ok, 'an operator re-pointed a seated membership at a volunteer account').toBe(false);
  905:   if (repointed.ok) return;
  906:   expect(repointed.kind, 'the re-point was refused for a reason other than the account type').toBe('not-an-ngo-account');
  907: 
  908:   // AND THE ROW IS UNMOVED: the control still holds it, with the role it was granted.
  909:   expect(await sut.membership(organization.id, controlCompletion.accountId), 'the refused re-point moved the seat anyway').toMatchObject({
  910:     accountId: controlCompletion.accountId,
  911:     role: 'member',
  912:   });
  913:   expect(await sut.membershipsOf(completion.accountId), 'the volunteer holds a per-organisation role after the re-point refused').toEqual([]);
  914: }
