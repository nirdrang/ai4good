  573: export function stubbedCapabilityNames(capabilities: readonly Capability<unknown>[]): string[] {
  574:   return capabilities
  575:     .filter((entry) => entry[CAPABILITY] === true && entry.provenance === 'stand-in')
  576:     .map((entry) => entry.name)
  577:     .sort();
