  281: /** An auth user as Supabase Auth holds one: credentials and the provider that established them. */
  282: interface AuthUser {
  283:   id: string;
  284:   email: string;
  285:   password: string | null;
  286:   provider: SessionProvider;
  287:   /**
  288:    * The handle of a LINKED GitHub identity, or null â€” Auth's `identities[]` narrowed to the one
  289:    * field anything here reads.
  290:    *
  291:    * It is stored on the auth user and NOT on the session, which is the whole reason the gate is a
  292:    * caller fact: linking happens after a session exists, changes nothing about how that session was
  293:    * established, and is a property of the user Auth answers for.
  294:    */
  295:   githubHandle: string | null;
  296:   /**
  297:    * GoTrue's `email_confirmed_at`, or null while the address is unconfirmed â€” vendor mirror 1 and
  298:    * 4 in this file's header.
  299:    *
  300:    * IT IS STORED AS THE VENDOR'S OWN FIELD VALUE, a nullable instant, and never as a boolean. The
  301:    * shipped `emailVerifiedFromUser` is what turns it into an answer, and it does so from the
  302:    * rendered `/auth/v1/user` shape rather than from this field directly. Storing a boolean here
  303:    * would put the judgement in storage, which is the one thing this file's opening paragraph
  304:    * promises it does not do.
  305:    */
  306:   emailConfirmedAt: string | null;
  307:   /**
  308:    * The verification link Auth emailed for this address, or null when no confirmation email was
  309:    * sent â€” the fixture's stand-in for the message the local mail catcher holds on the live stack.
  310:    *
  311:    * IT IS NOT CLEARED WHEN IT IS USED, deliberately. Clearing it would model SINGLE USE, and
  312:    * single-use semantics are retired AT-001.11's â€” "not stated in REQ-001". The fixture models
  313:    * what the criterion states and no more.
  314:    */
  315:   verificationLink: string | null;
  316:   /**
  317:    * The password-reset link Auth emailed for this address, or null when none was emailed â€” the
  318:    * fixture's stand-in for the recovery message the local mail catcher holds on the live stack.
  319:    *
  320:    * IT IS NOT CLEARED WHEN IT IS USED, deliberately and for the same reason `verificationLink` is
  321:    * not: clearing it would model SINGLE USE, and single-use semantics are retired AT-001.15's â€”
  322:    * "not stated in REQ-001". The fixture models what the criterion states and no more.
  323:    */
  324:   passwordResetLink: string | null;
  325: }
  326: 
  327: /**
  328:  * One row of `auth.sessions`, reduced to the three facts anything here reads.
  329:  *
  330:  * IT IS A ROW, NOT A TOKEN. There is no JWT, no signature and no expiry claim to parse; the
  331:  * validity of a session is looked up, exactly as GoTrue looks it up when `/auth/v1/user` is asked
  332:  * about a token. What a real token does is measured on the live stack, never here.
  333:  */
  334: interface StoredSession {
  335:   userId: string;
  336:   /**
  337:    * When this session's access stops working, in milliseconds on the harness clock â€” the mirror of
  338:    * `jwt_expiry`.
  339:    *
  340:    * A REFRESH MOVES THIS VALUE AND NOTHING ELSE, which is what makes `refreshSession` an extension
  341:    * of one session rather than the opening of another.
  342:    */
  343:   expiresAtMs: number;
  344:   /**
  345:    * Whether `signOut` ended this session â€” the mirror of `POST /auth/v1/logout` deleting the row.
  346:    *
  347:    * A FLAG RATHER THAN A DELETE, so that a revoked session is told apart from one that never
  348:    * existed while the code is being read. Neither is a caller, so nothing observable turns on the
  349:    * difference.
  350:    */
  351:   revoked: boolean;
  352: }
  353: 
  354: interface StoredAcknowledgment extends AcknowledgmentRow {}
  355: 
  356: interface State {
  357:   authUsers: Map<string, AuthUser>;
  358:   /** email -> auth user id, because sign-in arrives with an address rather than an id */
  359:   byEmail: Map<string, string>;
  360:   /**
  361:    * verification link -> auth user id, because a link arrives on its own with no address beside it
  362:    * â€” which is exactly the situation on the live stack, where the link is followed from an inbox.
  363:    *
  364:    * A link this map does not hold was never issued, and confirms nothing.
  365:    */
