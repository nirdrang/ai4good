  324:  * `stale-or-dead` is the runner's own long-standing rule: a dead process, or a live one whose
  325:  * claim is older than `LOCK_STALE_MINUTES`. `dead-pid-only` never displaces a running process at
  326:  * any age â€” the database-slot pool passes it, because a slot's occupancy is ruled to break on a
  327:  * dead holder pid and on nothing else. A run that legitimately lasts longer than the stale window
  328:  * must not have its database reset under it.
  329:  */
  330: export type TakeoverPolicy = 'stale-or-dead' | 'dead-pid-only';
  331: 
  332: export interface StackLockOptions {
  333:   takeover?: TakeoverPolicy;
  334: }
  335: 
  336: /** Live = a holder this policy may not displace. */
  337: function holderIsLive(holder: Holder, policy: TakeoverPolicy = 'stale-or-dead'): boolean {
  338:   if (typeof holder.pid !== 'number' || !processIsAlive(holder.pid)) return false;
  339:   if (policy === 'dead-pid-only') return true;
  340:   const startedAt = holder.startedAt ? Date.parse(holder.startedAt) : NaN;
  341:   const ageMinutes = Number.isFinite(startedAt) ? (Date.now() - startedAt) / 60_000 : Infinity;
  342:   return ageMinutes < LOCK_STALE_MINUTES;
  343: }
  344: 
  345: function heldByAnotherRun(holder: Holder, file: string): Error {
  346:   return new Error(
  347:     `another at:verify run holds this stack (pid ${holder.pid} on ${holder.host ?? 'this machine'}, ` +
  348:       `requirement ${holder.requirement ?? 'unknown'}, started ${holder.startedAt ?? 'unknown'}). ` +
  349:       `Two runs against one stack destroy each other: the second would reset the first's database ` +
  350:       `mid-run. Wait for it to finish. If that process is definitely gone, delete ${file}.`,
  351:   );
  352: }
  353: 
  354: /**
  355:  * A gate left behind by a process that died mid-takeover. The section lasts milliseconds, so
  356:  * anything this old is certainly abandoned; removing one wrongly costs at most two processes in
  357:  * the section, which is the behaviour we had before the gate existed.
  358:  */
  359: function clearStrandedGate(gate: string): void {
  360:   try {
  361:     const held = JSON.parse(readFileSync(gate, 'utf8')) as { pid?: number; at?: string };
  362:     const at = held.at ? Date.parse(held.at) : NaN;
  363:     const ageMinutes = Number.isFinite(at) ? (Date.now() - at) / 60_000 : Infinity;
  364:     const alive = typeof held.pid === 'number' && processIsAlive(held.pid);
  365:     if (!alive || ageMinutes > GATE_STALE_MINUTES) rmSync(gate, { force: true });
  366:   } catch {
  367:     // unreadable or already gone â€” the next pass finds out
  368:   }
  369: }
  370: 
  371: /**
  372:  * Serialize every destructive run against one stack. The key is project id + api port because
  373:  * that pair IS the stack's identity: a second checkout carrying the same `project_id` shares the
  374:  * same Docker containers and the same ports, so its `at:verify` would reset this run's database
  375:  * out from under it. Mirrors `Acquire-WorkLock` in loop/work/work-lib.ps1 â€” exclusive create,
  376:  * holder recorded, stale takeover.
  377:  *
  378:  * TAKEOVER IS THE WHOLE DIFFICULTY. Two processes can both read the same leftover lock and both
  379:  * conclude it is stale; if each then removed it and created its own, the second removal would take
  380:  * out the FIRST one's brand-new live lock and both would run â€” the precise failure this exists to
  381:  * prevent. Moving the stale file aside with an atomic rename does NOT fix that: the winner
  382:  * repopulates the path microseconds later, so the loser's rename succeeds against a LIVE lock,
  383:  * which is just as destructive as unlinking it. (Proved with a two-contender race, not reasoned
  384:  * about; the race is in runner.selftest.ts.)
  385:  *
  386:  * So the takeover DECISION is serialized by a second exclusive-create lock â€” the gate. Only one
  387:  * process is ever inside it, and it re-reads the holder INSIDE, so:
  388:  *   - no other process can be taking over concurrently (the gate is exclusive);
  389:  *   - no ordinary claim can have slipped in, because the stale file occupies the path continuously
  390:  *     until the gate holder removes it, and an exclusive create only succeeds on a free path;
  391:  *   - if a third process wins the claim in the instant after removal, the gate holder's own create
  392:  *     simply fails and it restarts, having deleted nothing further.
  393:  * A gate stranded by a killed process is cleared on age. The section lasts milliseconds, so a live
  394:  * holder never reaches that threshold, and clearing one wrongly degrades to two takers in the
  395:  * section â€” today's behaviour, not worse.
  396:  */
  397: export function acquireStackLock(config: LocalConfig, requirement: string, options: StackLockOptions = {}): StackLock {
  398:   const file = stackLockPath(config);
  399:   const policy: TakeoverPolicy = options.takeover ?? 'stale-or-dead';
  400: 
  401:   const claim = (displaced?: Holder): StackLock | null => {
  402:     let fd: number;
  403:     try {
  404:       fd = openSync(file, 'wx');
  405:     } catch (err) {
  406:       if ((err as NodeJS.ErrnoException).code === 'EEXIST') return null;
  407:       throw err;
  408:     }
  409:     try {
  410:       writeSync(
  411:         fd,
  412:         JSON.stringify({
  413:           pid: process.pid,
  414:           host: hostname(),
  415:           requirement,
  416:           startedAt: new Date().toISOString(),
  417:           // A takeover recorded ONLY on the console is lost the moment the terminal scrolls. The
  418:           // claim file outlives the run that wrote it, so whoever reads it later can see that this
  419:           // occupancy began by displacing an abandoned one, and whose.
  420:           ...(displaced
  421:             ? {
  422:                 tookOverFrom: {
  423:                   pid: displaced.pid,
  424:                   startedAt: displaced.startedAt,
  425:                   requirement: displaced.requirement,
  426:                 },
  427:               }
  428:             : {}),
  429:         }),
  430:       );
  431:     } finally {
  432:       closeSync(fd);
  433:     }
  434:     return {
  435:       file,
  436:       release: () => {
  437:         try {
  438:           const held = JSON.parse(readFileSync(file, 'utf8')) as { pid?: number };
  439:           if (held.pid === process.pid) rmSync(file, { force: true });
  440:         } catch {
  441:           // already removed, or unreadable â€” nothing of ours left to release
  442:         }
  443:       },
  444:     };
  445:   };
  446: 
  447:   const gate = `${file}.takeover`;
  448: 
  449:   /** The recorded holder, or null if the lock is gone. */
  450:   const readHolder = (): Holder | null => {
  451:     try {
  452:       return JSON.parse(readFileSync(file, 'utf8')) as Holder;
  453:     } catch (err) {
  454:       if ((err as NodeJS.ErrnoException).code === 'ENOENT') return null;
  455:       return {}; // unreadable or half-written: treat as an unidentifiable holder, judged below
  456:     }
  457:   };
  458: 
  459:   /** Bounded synchronous pause; a gate is held for milliseconds, so this is all the wait needed. */
  460:   const pause = (ms: number) => {
  461:     const until = Date.now() + ms;
  462:     while (Date.now() < until) {
  463:       /* spin */
  464:     }
  465:   };
  466: 
  467:   /**
  468:    * UNDER `dead-pid-only`, AN UNIDENTIFIABLE HOLDER IS NEVER TAKEOVER-ELIGIBLE.
  469:    *
  470:    * `readHolder` returns `{}` for a file it cannot read or parse, and `holderIsLive({})` is false
  471:    * under every policy â€” so without this guard a claim file that is empty or half written looks
  472:    * exactly like a dead holder and is deleted. The window is real and small: it is the microseconds
  473:    * between `openSync(file, 'wx')` and the `writeSync` that fills the file, so a second occupier
  474:    * arriving in that instant would remove a LIVE process's brand-new claim. That is the one thing
  475:    * this policy exists to make impossible.
  476:    *
  477:    * One bounded re-read skates over the write window. A holder that STILL has no parseable pid is
  478:    * not a dead holder â€” it is a file nobody in this process can account for â€” so it refuses loudly
  479:    * and names the manual repair. `stale-or-dead` keeps its long-standing behaviour: that path
  480:    * predates the slot pool and is another item's business.
  481:    *
  482:    * Returns the identified holder, or null when the file went away and the loop should retry.
  483:    */
  484:   const identified = (holder: Holder, where: string): Holder | null => {
  485:     if (typeof holder.pid === 'number') return holder;
  486:     if (policy !== 'dead-pid-only') return holder;
  487: 
  488:     pause(50);
  489:     const again = readHolder();
  490:     if (again === null) return null; // released while we looked; the loop takes the free path
  491:     if (typeof again.pid === 'number') return again;
  492: 
  493:     throw new Error(
  494:       `refusing to take over the claim at ${file}: it names no process id that this run can read, ` +
  495:         `so it cannot be shown to be dead â€” and a claim file being written right now looks exactly ` +
  496:         `like this. Nothing was taken over. If no run holds that stack, delete ${file} by hand ` +
  497:         `(checked ${where}).`,
  498:     );
  499:   };
  500: 
  501:   // Bounded: every retry follows another process winning the gate, which cannot repeat forever.
  502:   for (let attempt = 0; attempt < 20; attempt++) {
  503:     const claimed = claim();
  504:     if (claimed) return claimed;
  505: 
  506:     const read = readHolder();
  507:     if (read === null) continue; // released between the failed claim and the read
  508:     const holder = identified(read, 'before the takeover gate');
  509:     if (holder === null) continue;
  510:     if (holderIsLive(holder, policy)) throw heldByAnotherRun(holder, file);
  511: 
  512:     // Stale. Enter the takeover gate â€” the only place the live lock path may be removed.
  513:     let gateFd: number;
  514:     try {
  515:       gateFd = openSync(gate, 'wx');
  516:     } catch (err) {
  517:       if ((err as NodeJS.ErrnoException).code !== 'EEXIST') throw err;
  518:       clearStrandedGate(gate);
  519:       pause(10);
  520:       continue;
  521:     }
  522: 
  523:     try {
  524:       writeSync(gateFd, JSON.stringify({ pid: process.pid, at: new Date().toISOString() }));
  525:       const readInside = readHolder();
  526:       if (readInside === null) continue; // released while we were entering; the next claim takes it
  527:       // The same guard as above: the gate must not be able to remove an unidentifiable file either.
  528:       const inside = identified(readInside, 'inside the takeover gate');
  529:       if (inside === null) continue;
  530:       if (holderIsLive(inside, policy)) continue; // refreshed under us; the next pass refuses it properly
  531: 
  532:       rmSync(file, { force: true });
  533:       const takeover = claim(inside);
  534:       if (!takeover) continue; // a third process claimed the free path first â€” delete nothing more
  535: 
  536:       console.log(
  537:         `at:verify â€” took over a stale stack lock (holder pid ${inside.pid ?? 'unknown'} ` +
  538:           `${typeof inside.pid === 'number' && processIsAlive(inside.pid) ? `is older than ${LOCK_STALE_MINUTES} minutes` : 'is no longer running'})`,
  539:       );
  540:       return takeover;
  541:     } finally {
  542:       closeSync(gateFd);
  543:       rmSync(gate, { force: true });
  544:     }
  545:   }
  546: 
  547:   throw new Error(`could not acquire the stack lock at ${file} â€” it kept changing hands; try again`);
  548: }
  549: 
  550: /* -------------------------------------------------------------------- the stack's own report */
  551: 
  552: export interface StackStatus {
  553:   apiUrl: string;
  554:   dbUrl: string;
  555:   anonKey: string;
  556:   serviceRoleKey: string;
  557:   /**
  558:    * WHERE THE STACK'S OWN MAIL CATCHER ANSWERS, as the stack itself reports it.
  559:    *
  560:    * OPTIONAL, and that is not laziness. The four fields above are REQUIRED because nothing can run
  561:    * without them; a catcher is needed only by a suite that reads mail, and the CLI has renamed this
  562:    * field once already (`INBUCKET_URL` became `MAILPIT_URL` when the catcher changed, and both are
  563:    * emitted today). Making it required would turn a rename into an infrastructure failure for every
  564:    * run, including the ones that never read a message. A suite that DOES need it refuses loudly at
  565:    * its own construction â€” `live-email.ts` says exactly that â€” which is where the refusal belongs.
  566:    *
  567:    * It is read here rather than recomputed from `[local_smtp] port` plus the pool's per-slot offset,
  568:    * so there is one statement of the catcher's address rather than two that can disagree.
  569:    */
  570:   mailUrl?: string;
  571: }
  572: 
  573: const REQUIRED_STATUS_FIELDS: Record<'apiUrl' | 'dbUrl' | 'anonKey' | 'serviceRoleKey', string> = {
  574:   apiUrl: 'API_URL',
  575:   dbUrl: 'DB_URL',
  576:   anonKey: 'ANON_KEY',
  577:   serviceRoleKey: 'SERVICE_ROLE_KEY',
  578: };
  579: 
  580: export function supabaseArgs(...args: string[]): string[] {
  581:   if (!existsSync(SUPABASE_ENTRY)) throw new Error(`the Supabase CLI is not installed at ${SUPABASE_ENTRY} â€” run \`bun install\``);
  582:   return ['--no-env-file', SUPABASE_ENTRY, ...args];
  583: }
  584: 
  585: /**
  586:  * WHICH PROJECT an invocation acts on. A target names both halves of an identity, because either
  587:  * half alone is a hybrid.
  588:  */
  589: export interface CliTarget {
  590:   /** The directory that CONTAINS the `supabase/` project folder â€” what `--workdir` names. */
  591:   workdir: string;
  592:   /** The project id the invocation must resolve, stated POSITIVELY in `SUPABASE_PROJECT_ID`. */
  593:   projectId: string;
  594: }
  595: 
  596: export interface CliInvocation {
  597:   args: string[];
  598:   cwd: string;
  599:   env: Record<string, string>;
  600: }
  601: 
  602: /**
  603:  * THE ONE SEAM every Supabase CLI invocation is built at. Nothing in this repository assembles a
  604:  * CLI command line, working directory or environment anywhere else, and that single seam is the
  605:  * whole wall â€” a wall with two builders is a wall with a gap.
  606:  *
  607:  * THREE THINGS HAVE TO AGREE, and the reason each is here was measured, not reasoned about:
  608:  *
  609:  *   1. `SUPABASE_PROJECT_ID`, set POSITIVELY to the target's project id. The CLI treats that
  610:  *      variable as an OVERRIDE of `project_id` in `config.toml`. The repo's tracked `.env` carries
  611:  *      it, bun loads `.env` into this process, and on 2026-08-09 a `db reset` aimed at slot 2
  612:  *      destroyed the founder's personal database because the environment supplied the identity
  613:  *      while the slot's config supplied the ports. The wall is stating the identity, never merely
  614:  *      avoiding an override: an absence can be reintroduced by any parent process, a positive
  615:  *      value cannot.
  616:  *   2. NO OTHER `SUPABASE_*` variable. `childEnv` is an allowlist that carries none, and this
  617:  *      function asserts that rather than trusting it, because the allowlist is edited by people.
  618:  *   3. The WORKING DIRECTORY, equal to `--workdir`. Measured 2026-08-10: when the CLI's working
  619:  *      directory is itself a Supabase project, `--workdir <other>` produces a hybrid â€” the other
  620:  *      project's ports beside the working directory's project's containers. Run from a directory
  621:  *      that is not a project, the same command correctly says
  622:  *      `No such container: supabase_db_ai4good-slot-1`.
  623:  *
  624:  * `bun --no-env-file` (in `supabaseArgs`) closes the fourth route: a child that re-reads `.env`
  625:  * for itself.
  626:  *
  627:  * No target means the repository's own project, exactly as every call site behaved before targets
  628:  * existed: no `--workdir`, the repo root, and an environment carrying no `SUPABASE_*` at all.
  629:  */
  630: export function supabaseInvocation(target: CliTarget | undefined, args: string[]): CliInvocation {
  631:   if (!target) return { args: supabaseArgs(...args), cwd: REPO_ROOT, env: childEnv() };
  632: 
  633:   const env = childEnv({ SUPABASE_PROJECT_ID: target.projectId });
  634:   const foreign = Object.keys(env).filter((name) => /^SUPABASE_/i.test(name) && name.toUpperCase() !== 'SUPABASE_PROJECT_ID');
  635:   if (foreign.length) {
  636:     throw new Error(
  637:       `refusing to run the Supabase CLI against ${target.projectId}: the child environment would also carry ` +
  638:         `${foreign.join(', ')}, and a second SUPABASE_* variable can override the identity this invocation states.`,
  639:     );
  640:   }
  641:   if (env.SUPABASE_PROJECT_ID !== target.projectId) {
  642:     throw new Error(`refusing to run the Supabase CLI: SUPABASE_PROJECT_ID would not be "${target.projectId}"`);
  643:   }
  644:   return { args: supabaseArgs('--workdir', target.workdir, ...args), cwd: target.workdir, env };
  645: }
  646: 
  647: export interface CliResult {
  648:   status: number | null;
  649:   signal?: NodeJS.Signals | null;
  650:   stdout: string;
  651:   stderr: string;
  652:   error?: Error;
  653: }
  654: 
  655: /** Run the pinned CLI through the seam and hand back the RAW result. The caller decides what to
  656:  * read and what may be printed â€” raw output carries every key the stack issues. */
  657: export function runSupabaseCli(target: CliTarget | undefined, args: string[]): CliResult {
  658:   const invocation = supabaseInvocation(target, args);
  659:   const res = spawnSync(bunExecutable(), invocation.args, { cwd: invocation.cwd, env: invocation.env, encoding: 'utf8' });
  660:   return {
  661:     status: res.status,
  662:     signal: res.signal,
  663:     stdout: res.stdout ?? '',
  664:     stderr: res.stderr ?? '',
  665:     error: res.error as Error | undefined,
  666:   };
  667: }
  668: 
  669: /**
  670:  * Ask the running stack to describe itself. The raw output is NEVER printed: it contains every
  671:  * key the stack issues. Only field names travel into error messages.
  672:  */
  673: export function readStackStatus(target?: CliTarget): StackStatus {
  674:   return parseStackStatus(runSupabaseCli(target, ['status', '-o', 'json']));
  675: }
  676: 
  677: /**
  678:  * The status parser, separate from the invocation so that a caller which needs the RAW output for
  679:  * its own checks (the slot pool's identity read) reads it once and parses the same result, rather
  680:  * than running the CLI twice or keeping a second copy of this parser.
  681:  */
  682: export function parseStackStatus(res: CliResult): StackStatus {
  683:   if (res.error) {
  684:     const err = res.error as NodeJS.ErrnoException;
  685:     throw new Error(`could not launch the Supabase CLI (${err.code ?? 'spawn error'}): ${diagnostic(err.message)}`);
  686:   }
  687: 
  688:   const stdout = res.stdout ?? '';
  689:   const open = stdout.indexOf('{');
  690:   const close = stdout.lastIndexOf('}');
  691:   if (open < 0 || close <= open) {
  692:     throw new Error(
  693:       `\`supabase status\` reported no JSON (exit ${res.status}${res.signal ? `, signal ${res.signal}` : ''}): ` +
  694:         `${diagnostic(res.stderr) || '(no error output)'}`,
  695:     );
  696:   }
  697: 
  698:   // The CLI exits non-zero merely because config.toml disables imgproxy and the pooler. That is
  699:   // not a failure; anything ELSE reported stopped is.
  700:   const notice = `${stdout.slice(0, open)}\n${res.stderr ?? ''}`;
  701:   const stopped = /Stopped services:\s*\[([^\]]*)\]/.exec(notice)?.[1] ?? '';
  702:   const unexpectedStopped = stopped.split(/\s+/).filter((name) => name && !DISABLED_SERVICES.test(name));
  703:   if (unexpectedStopped.length) {
  704:     throw new Error(`the stack reports stopped services: ${unexpectedStopped.join(', ')} â€” start them before running the suite`);
  705:   }
  706: 
  707:   let parsed: Record<string, unknown>;
  708:   try {
  709:     parsed = JSON.parse(stdout.slice(open, close + 1)) as Record<string, unknown>;
  710:   } catch (err) {
  711:     throw new Error(`\`supabase status\` produced unparseable JSON: ${(err as Error).message}`);
  712:   }
  713: 
  714:   const status: Partial<StackStatus> = {};
  715:   const missing: string[] = [];
  716:   for (const [field, key] of Object.entries(REQUIRED_STATUS_FIELDS) as [keyof typeof REQUIRED_STATUS_FIELDS, string][]) {
  717:     const value = parsed[key];
  718:     if (typeof value !== 'string' || value.trim() === '') missing.push(key);
  719:     else status[field] = value;
  720:   }
  721:   if (missing.length) throw new Error(`\`supabase status\` reported no ${missing.join(', no ')}`);
  722: 
  723:   // BOTH NAMES, newest first. The CLI emits `MAILPIT_URL` today and still emits the older
  724:   // `INBUCKET_URL` beside it; reading both means a CLI that drops either one keeps working, and a
  725:   // CLI that drops both leaves this undefined rather than silently wrong.
  726:   for (const key of ['MAILPIT_URL', 'INBUCKET_URL']) {
  727:     const value = parsed[key];
  728:     if (typeof value === 'string' && value.trim() !== '') {
  729:       status.mailUrl = value;
  730:       break;
  731:     }
  732:   }
  733:   return status as StackStatus;
  734: }
  735: 
  736: /* --------------------------------------------------------- proving the stack is the LOCAL one */
  737: 
  738: const LOOPBACK = new Set(['127.0.0.1', 'localhost', '::1', '[::1]']);
  739: 
  740: function decodeJwtClaims(token: string): Record<string, unknown> | null {
  741:   const parts = token.split('.');
  742:   if (parts.length !== 3) return null;
  743:   try {
  744:     return JSON.parse(Buffer.from(parts[1], 'base64url').toString('utf8')) as Record<string, unknown>;
  745:   } catch {
  746:     return null;
  747:   }
  748: }
  749: 
  750: /**
  751:  * Refuse to touch anything that is not demonstrably the local development stack. Returns the
  752:  * names of the checks that failed â€” never the values, which are keys and connection strings.
  753:  */
  754: export function localStackProblems(status: StackStatus, config: LocalConfig): string[] {
  755:   const problems: string[] = [];
  756: 
  757:   const checkUrl = (label: string, raw: string, expectedPort: number) => {
  758:     let url: URL;
  759:     try {
  760:       url = new URL(raw);
  761:     } catch {
  762:       problems.push(`${label} is not a URL`);
  763:       return;
  764:     }
  765:     if (!LOOPBACK.has(url.hostname)) problems.push(`${label} does not point at the loopback address`);
  766:     if (url.port !== String(expectedPort)) problems.push(`${label} port is not the ${expectedPort} configured in supabase/config.toml`);
  767:   };
  768: 
  769:   checkUrl('API_URL', status.apiUrl, config.apiPort);
  770:   checkUrl('DB_URL', status.dbUrl, config.dbPort);
  771: 
  772:   /*
  773:    * THE MAIL CATCHER URL IS CHECKED TOO (gate-2 ruling S1-6), because it travels into the child
  774:    * exactly as the other coordinates do â€” `stackEnv` puts it in `AT_SUPABASE_MAIL_URL` and the live
  775:    * email capability reads mail through it. It used to flow from `supabase status` into the child
  776:    * with nothing looking at it, so the one coordinate that is not a credential was also the one
  777:    * coordinate nothing proved was this slot's.
  778:    *
  779:    * ONLY WHEN A CATCHER IS REPORTED. A stack with no catcher is not a failure â€” the field is
  780:    * optional in both directions, and a suite that needs one refuses at its own construction. What
  781:    * IS a failure is a reported catcher this config cannot vouch for, and that is said rather than
  782:    * skipped.
  783:    */
  784:   if (status.mailUrl !== undefined) {
  785:     if (config.mailPort === undefined) {
  786:       problems.push('MAIL_URL was reported but supabase/config.toml states no [local_smtp] port to check it against');
  787:     } else {
  788:       checkUrl('MAIL_URL', status.mailUrl, config.mailPort);
  789:     }
  790:   }
  791: 
  792:   const checkKey = (label: string, token: string, expectedRole: string) => {
  793:     const claims = decodeJwtClaims(token);
  794:     if (!claims) {
  795:       problems.push(`${label} is not a decodable local development JWT`);
  796:       return;
  797:     }
  798:     if (claims.iss !== 'supabase-demo') problems.push(`${label} was not issued by the local development issuer`);
  799:     if (claims.role !== expectedRole) problems.push(`${label} does not carry the ${expectedRole} role`);
  800:     if (typeof claims.ref === 'string') problems.push(`${label} carries a hosted project reference`);
  801:   };
  802: 
  803:   checkKey('ANON_KEY', status.anonKey, 'anon');
  804:   checkKey('SERVICE_ROLE_KEY', status.serviceRoleKey, 'service_role');
  805: 
  806:   return problems;
  807: }
  808: 
  809: /* --------------------------------------------------------------------------------- readiness */
  810: 
  811: interface BunSqlClient {
  812:   (strings: TemplateStringsArray, ...values: unknown[]): Promise<unknown>;
  813:   close(): Promise<void>;
  814: }
  815: type BunSqlCtor = new (url: string) => BunSqlClient;
  816: 
  817: /** Postgres itself answers a query â€” not "the port is open", which a half-started stack satisfies. */
  818: async function databaseAnswers(dbUrl: string): Promise<string | null> {
  819:   const SQL = (globalThis as { Bun?: { SQL?: BunSqlCtor } }).Bun?.SQL;
  820:   if (!SQL) return 'this runtime has no SQL client (expected bun)';
  821:   let sql: BunSqlClient | null = null;
  822:   try {
  823:     sql = new SQL(dbUrl);
  824:     await sql`select 1`;
  825:     return null;
  826:   } catch (err) {
  827:     return diagnostic((err as Error).message);
  828:   } finally {
  829:     await sql?.close().catch(() => undefined);
  830:   }
  831: }
  832: 
  833: /** One request that only succeeds if Kong routed it, PostgREST served it, and Postgres answered. */
  834: async function gatewayAnswers(status: StackStatus): Promise<string | null> {
  835:   try {
  836:     const res = await fetch(`${status.apiUrl.replace(/\/$/, '')}/rest/v1/`, {
  837:       headers: { apikey: status.anonKey, Authorization: `Bearer ${status.anonKey}` },
  838:       signal: AbortSignal.timeout(5000),
  839:     });
  840:     if (!res.ok) return `the API gateway answered ${res.status}`;
  841:     const type = res.headers.get('content-type') ?? '';
  842:     if (!type.includes('json')) return `the API gateway answered 200 but served ${type || 'no content type'}`;
  843:     return null;
  844:   } catch (err) {
  845:     return diagnostic((err as Error).message);
  846:   }
  847: }
  848: 
  849: /**
  850:  * Wait until the stack is genuinely usable, or give up. "Something answered on the port" is not
  851:  * readiness: a half-started stack answers 502/503, and a run launched against it fails in ways
  852:  * that look like test failures instead of infrastructure failures.
  853:  */
  854: export async function waitForReady(status: StackStatus, phase: string): Promise<void> {
  855:   const deadline = Date.now() + READY_TIMEOUT_MS;
  856:   let lastProblem = 'not attempted';
  857:   let delay = 250;
  858: 
  859:   while (Date.now() < deadline) {
  860:     const db = await databaseAnswers(status.dbUrl);
  861:     if (db === null) {
  862:       const gateway = await gatewayAnswers(status);
  863:       if (gateway === null) return;
  864:       lastProblem = gateway;
  865:     } else {
  866:       lastProblem = `the database did not answer: ${db}`;
  867:     }
  868:     await new Promise((resolve) => setTimeout(resolve, delay));
  869:     delay = Math.min(delay * 2, 2000);
  870:   }
  871: 
  872:   throw new Error(`the stack was still not ready ${phase} after ${Math.round(READY_TIMEOUT_MS / 1000)}s â€” last problem: ${lastProblem}`);
  873: }
  874: 
  875: /* --------------------------------------------------------------------- the migration-set proof */
  876: 
  877: /** Counted, not just proved â€” the pool's evidence line has to state the migration state it saw. */
  878: export interface MigrationProof {
  879:   expected: number;
  880:   applied: number;
  881: }
  882: 
  883: /**
  884:  * The migrations the reset is supposed to replay, read from disk. The CLI names them
  885:  * `<timestamp>_name.sql` and records the timestamp as the applied version, so the timestamp is
  886:  * the identity. `.gitkeep` and `README.md` are not migrations and are ignored.
  887:  */
  888: export function expectedMigrations(root: string = REPO_ROOT): string[] {
  889:   const dir = join(root, 'supabase', 'migrations');
  890:   if (!existsSync(dir)) return [];
  891:   return readdirSync(dir)
  892:     .map((name) => /^(\d{14})_.*\.sql$/.exec(name)?.[1])
  893:     .filter((version): version is string => Boolean(version))
  894:     .sort();
  895: }
  896: 
  897: /** What the database says it actually replayed. */
  898: async function appliedMigrations(dbUrl: string): Promise<string[]> {
  899:   const SQL = (globalThis as { Bun?: { SQL?: BunSqlCtor } }).Bun?.SQL;
  900:   if (!SQL) throw new Error('this runtime has no SQL client (expected bun)');
  901:   let sql: BunSqlClient | null = null;
  902:   try {
  903:     sql = new SQL(dbUrl);
  904:     const rows = (await sql`select version from supabase_migrations.schema_migrations order by version`) as {
  905:       version: string;
  906:     }[];
  907:     return rows.map((row) => String(row.version)).sort();
  908:   } catch (err) {
  909:     // A database that has never had a migration applied has no history table at all. "No table"
  910:     // and "empty table" mean the same thing â€” nothing was applied â€” and saying so lets the
  911:     // comparison below name exactly which migrations are missing instead of reporting a SQL error.
  912:     const message = (err as Error).message ?? '';
  913:     if (/schema_migrations/.test(message) && /does not exist/i.test(message)) return [];
  914:     throw new Error(`could not read the migration history: ${diagnostic(message)}`);
  915:   } finally {
  916:     await sql?.close().catch(() => undefined);
  917:   }
  918: }
  919: 
  920: /** Exact set equality, both directions, named plainly. */
  921: export function migrationSetProblems(expected: string[], applied: string[]): string[] {
  922:   const missing = expected.filter((version) => !applied.includes(version));
  923:   const extra = applied.filter((version) => !expected.includes(version));
  924:   const problems: string[] = [];
  925:   if (missing.length) problems.push(`never applied: ${missing.join(', ')}`);
  926:   if (extra.length) problems.push(`applied but not in supabase/migrations: ${extra.join(', ')}`);
  927:   return problems;
  928: }
  929: 
  930: /**
  931:  * Prove the rebuild actually replayed the migration set â€” the promise `supabase/migrations/README.md`
  932:  * makes. "The reset command exited zero" is not that proof: a reset that replays NOTHING also exits
  933:  * zero, and a suite then grades an empty schema while believing it graded the real one.
  934:  *
  935:  * An empty expected set is legitimate today (no migrations have been written yet) and is allowed â€”
  936:  * but it is STATED on every run, so an empty rebuild can never be silently mistaken for a real one.
  937:  */
  938: export async function proveMigrationsReplayed(status: StackStatus, root: string = REPO_ROOT): Promise<MigrationProof> {
  939:   const expected = expectedMigrations(root);
  940:   const applied = await appliedMigrations(status.dbUrl);
  941:   const problems = migrationSetProblems(expected, applied);
  942: 
  943:   const summary = `${expected.length} migration${expected.length === 1 ? '' : 's'} expected, ${applied.length} applied`;
  944:   if (problems.length) {
  945:     throw new Error(`the rebuilt database does not match supabase/migrations (${summary}) â€” ${problems.join('; ')}`);
  946:   }
  947:   console.log(
  948:     expected.length === 0
  949:       ? `at:verify â€” ${summary} â€” the schema is empty by design at this stage`
  950:       : `at:verify â€” ${summary} â€” the rebuilt schema matches supabase/migrations exactly`,
  951:   );
  952:   return { expected: expected.length, applied: applied.length };
  953: }
  954: 
  955: /* ------------------------------------------------------------------------------------- reset */
  956: 
  957: /**
  958:  * WHAT A PRE-DESTRUCTIVE IDENTITY READ PROVED (audit ruling B2, decision D13).
  959:  *
  960:  * The read itself lives beside the pool, because only the pool knows what a slot is. What travels
  961:  * from the read to the destructive act is this: the project id the CLI's own output POSITIVELY
  962:  * named, or `null` when the read proved no project at all.
  963:  */
  964: export interface SlotIdentityProof {
  965:   /** The project id the identity read proved, from the CLI's own container names. */
  966:   provenProjectId: string | null;
  967: }
  968: 
  969: /**
  970:  * Rebuild the local database from `supabase/migrations` â€” the same work `bun run db:reset` does,
  971:  * invoked at the pinned CLI so failures are catchable and bounded.
  972:  *
  973:  * WHY EVERY RUN: without it the second run works on the first run's leftover rows, and on a
  974:  * schema missing whatever migration landed since â€” a suite grading a database nobody established.
  975:  *
  976:  * A TARGET COSTS A PROOF, AND THE TYPE SYSTEM COLLECTS IT (audit ruling B2). D13 rules the identity
  977:  * read structurally ON the destructive path, "never a separate call a caller can skip". Before this
  978:  * signature the read sat at the one call site instead, so any importer could aim a reset at a slot
  979:  * with no read at all and still compile. Now a target demands the proof object the read returns:
  980:  * the overloads make the skip a compile error, and a proof that names another project â€” or names
  981:  * none â€” is a named refusal here, before anything is spawned. No target is the repository's own
  982:  * project and is unchanged, exactly as it behaved before targets existed.
  983:  */
  984: export async function resetLocalDatabase(): Promise<void>;
  985: export async function resetLocalDatabase(target: CliTarget, proof: SlotIdentityProof): Promise<void>;
  986: export async function resetLocalDatabase(target?: CliTarget, proof?: SlotIdentityProof): Promise<void> {
  987:   if (target && proof?.provenProjectId !== target.projectId) {
  988:     throw new Error(
  989:       `REFUSING TO RESET ${target.projectId}: the identity read handed to this reset ` +
  990:         `${proof?.provenProjectId ? `proves ${proof.provenProjectId}` : 'proves no project at all'}, not ${target.projectId}. ` +
  991:         `A reset aimed at a target is only permitted on the read that proved that target. Nothing was done.`,
  992:     );
  993:   }
  994:   const invocation = supabaseInvocation(target, ['db', 'reset', '--local']);
  995:   const child = spawn(bunExecutable(), invocation.args, {
  996:     cwd: invocation.cwd,
  997:     env: invocation.env,
  998:     // progress is worth watching (a reset replays every migration); stderr is captured so a
  999:     // failure can be reported in our own words rather than scrolling past.
 1000:     stdio: ['ignore', 'inherit', 'pipe'],
 1001:   });
 1002: 
 1003:   let stderr = '';
 1004:   child.stderr?.on('data', (chunk: Buffer) => {
 1005:     stderr = (stderr + chunk.toString('utf8')).slice(-8000);
 1006:   });
 1007: 
 1008:   let timedOut = false;
 1009:   const timer = setTimeout(() => {
 1010:     timedOut = true;
 1011:     // Kill the TREE: the CLI shells out to the container runtime, and killing only the parent
 1012:     // leaves a migration running against the database this run is about to test.
 1013:     if (child.pid && process.platform === 'win32') spawnSync('taskkill', ['/PID', String(child.pid), '/T', '/F'], { stdio: 'ignore' });
 1014:     else child.kill('SIGKILL');
 1015:   }, RESET_TIMEOUT_MS);
 1016: 
 1017:   try {
 1018:     await new Promise<void>((resolve, reject) => {
 1019:       child.once('error', (err) => {
 1020:         const e = err as NodeJS.ErrnoException;
 1021:         reject(new Error(`the reset process could not be launched (${e.code ?? 'spawn error'}): ${diagnostic(e.message)}`));
 1022:       });
 1023:       child.once('close', (code, signal) => {
 1024:         if (timedOut) {
 1025:           reject(new Error(`the reset did not finish within ${Math.round(RESET_TIMEOUT_MS / 1000)}s and its process tree was killed`));
 1026:         } else if (code === 0) {
 1027:           resolve();
 1028:         } else {
 1029:           const how = code === null ? `was killed by signal ${signal}` : `exited ${code}`;
 1030:           reject(new Error(`\`supabase db reset\` ${how}: ${diagnostic(stderr) || '(no error output)'}`));
 1031:         }
 1032:       });
 1033:     });
 1034:   } finally {
 1035:     clearTimeout(timer);
 1036:   }
 1037: }
 1038: 
 1039: /* --------------------------------------------------------------------------- vitest json shape */
 1040: 
 1041: export interface AssertionResult {
 1042:   title?: string;
 1043:   fullName?: string;
 1044:   status?: string;
 1045:   failureMessages?: string[];
 1046: }
 1047: 
 1048: /**
 1049:  * The report's own arithmetic, alongside the per-test results. `--expect` needs both: the id
 1050:  * parser only sees tests whose titles carry an AT id, so an untagged `it()` that fails is
 1051:  * invisible to it and visible in these counts. Optional because this describes a file on disk â€”
 1052:  * a missing field is validated at runtime (see `reportAccountingDeviations`), not asserted here.
 1053:  */
 1054: interface VitestJson {
 1055:   /**
 1056:    * One entry per test FILE. `status` and `message` are kept alongside the assertions because a
 1057:    * file that fails to import, or whose hook throws, changes no test's status: that failure is
 1058:    * visible here and nowhere else in the report.
 1059:    */
 1060:   testResults?: { name?: string; status?: string; message?: string; assertionResults?: AssertionResult[] }[];
 1061:   numTotalTests?: number;
 1062:   numPassedTests?: number;
 1063:   numFailedTests?: number;
 1064:   numPendingTests?: number;
 1065:   numTodoTests?: number;
 1066:   success?: boolean;
 1067: }
 1068: 
 1069: export interface IdRow {
 1070:   id: string;
 1071:   status: 'green' | 'red' | 'missing';
 1072:   detail: string;
 1073: }
 1074: 
 1075: export interface RuntimeRegistration {
 1076:   atId: string;
 1077:   title: string;
 1078:   surface: string;
 1079: }
 1080: 
 1081: export interface ReportAnalysis {
 1082:   rows: IdRow[];
 1083:   unexpected: string[];
 1084: }
 1085: 
 1086: function assertionId(assertion: AssertionResult): string | null {
 1087:   return /^(AT-[\d.]+[a-z]?)\s+â€”/.exec(assertion.title ?? assertion.fullName ?? '')?.[1] ?? null;
 1088: }
 1089: 
 1090: export function analyzeReportedTests(
 1091:   expected: string[],
 1092:   registrations: RuntimeRegistration[],
 1093:   assertions: AssertionResult[],
 1094: ): ReportAnalysis {
 1095:   const registrationGroups = new Map<string, RuntimeRegistration[]>();
 1096:   for (const registration of registrations) {
 1097:     const group = registrationGroups.get(registration.atId) ?? [];
 1098:     group.push(registration);
 1099:     registrationGroups.set(registration.atId, group);
 1100:   }
 1101: 
 1102:   const assertionGroups = new Map<string, AssertionResult[]>();
 1103:   for (const assertion of assertions) {
 1104:     const id = assertionId(assertion);
 1105:     if (!id) continue;
 1106:     const group = assertionGroups.get(id) ?? [];
 1107:     group.push(assertion);
 1108:     assertionGroups.set(id, group);
 1109:   }
 1110: 
 1111:   const rows: IdRow[] = expected.map((id) => {
 1112:     const runtime = registrationGroups.get(id) ?? [];
 1113:     const results = assertionGroups.get(id) ?? [];
 1114:     if (runtime.length !== 1) {
 1115:       return {
 1116:         id,
 1117:         status: 'red',
 1118:         detail:
 1119:           runtime.length === 0
 1120:             ? 'no runtime registration emitted by atTest'
 1121:             : `${runtime.length} runtime registrations emitted by atTest; expected exactly 1`,
 1122:       };
 1123:     }
 1124:     if (results.length !== 1) {
 1125:       return {
 1126:         id,
 1127:         status: 'red',
 1128:         detail: `${results.length} Vitest results reported; expected exactly 1`,
 1129:       };
 1130:     }
 1131: 
 1132:     const result = results[0];
 1133:     const expectedTitle = `${id} â€” ${runtime[0].title}`;
 1134:     if (result.title !== expectedTitle) {
 1135:       return {
 1136:         id,
 1137:         status: 'red',
 1138:         detail: `Vitest title ${JSON.stringify(result.title)} does not match runtime registration ${JSON.stringify(expectedTitle)}`,
 1139:       };
 1140:     }
 1141:     if (result.status !== 'passed') {
 1142:       return {
 1143:         id,
 1144:         status: 'red',
 1145:         detail: firstLine(result.failureMessages?.join('\n'), `status "${result.status}"`),
 1146:       };
 1147:     }
 1148:     return { id, status: 'green', detail: runtime[0].title };
 1149:   });
 1150: 
 1151:   const observed = new Set([...registrationGroups.keys(), ...assertionGroups.keys()]);
 1152:   const unexpected = [...observed].filter((id) => !expected.includes(id)).sort();
 1153:   return { rows, unexpected };
 1154: }
 1155: 
 1156: function runtimeRegistrations(dir: string): RuntimeRegistration[] {
 1157:   const registrations: RuntimeRegistration[] = [];
 1158:   for (const file of readdirSync(dir, { withFileTypes: true })) {
 1159:     if (!file.isFile() || !file.name.endsWith('.jsonl')) continue;
 1160:     const lines = readFileSync(join(dir, file.name), 'utf8').split(/\r?\n/).filter(Boolean);
 1161:     for (const line of lines) registrations.push(JSON.parse(line) as RuntimeRegistration);
 1162:   }
 1163:   return registrations;
 1164: }
 1165: 
 1166: export interface ProcessOutcome {
 1167:   error?: unknown;
 1168:   status: number | null;
 1169:   signal?: NodeJS.Signals | null;
 1170: }
 1171: 
 1172: /**
 1173:  * The verdict is NOT "did every row go green". A vitest process can report twelve green
 1174:  * assertions and still exit non-zero â€” a global teardown that threw, an unhandled rejection, a
 1175:  * worker that died after its last test. Treating that as success is exactly the false green this
 1176:  * harness exists to prevent, so the process's own exit is part of the verdict, and a discrepancy
 1177:  * between green rows and a non-zero exit is called out rather than smoothed over.
 1178:  */
 1179: export function runVerdict(rows: IdRow[], unexpected: string[], run: ProcessOutcome): string[] {
 1180:   const problems: string[] = [];
 1181:   const red = rows.filter((r) => r.status === 'red').length;
 1182:   const missing = rows.filter((r) => r.status === 'missing').length;
 1183: 
 1184:   if (red) problems.push(`${red} id${red === 1 ? '' : 's'} red`);
 1185:   if (missing) problems.push(`${missing} id${missing === 1 ? '' : 's'} missing`);
 1186:   if (unexpected.length) {
 1187:     problems.push(`${unexpected.length} registered id${unexpected.length === 1 ? '' : 's'} not P0 of this requirement`);
 1188:   }
 1189: 
 1190:   if (run.error) {
 1191:     const err = run.error as NodeJS.ErrnoException;
 1192:     problems.push(`the test process could not be launched (${err.code ?? 'spawn error'}): ${diagnostic(err.message)}`);
 1193:   } else if (run.status !== 0) {
 1194:     const how = run.status === null ? `was killed by signal ${run.signal}` : `exited ${run.status}`;
 1195:     problems.push(
 1196:       red || missing
 1197:         ? `the test process ${how}`
 1198:         : `the test process ${how} even though every id reported green â€” something failed outside the ` +
 1199:             `assertions (a teardown, an unhandled rejection, a worker that died). This run is a FAILURE.`,
 1200:     );
 1201:   }
 1202: 
 1203:   return problems;
 1204: }
 1205: 
 1206: /**
 1207:  * End-of-run housekeeping. The lock release lives in a `finally` of its OWN so that it cannot be
 1208:  * skipped: on Windows, removing the report directory can throw EPERM while a file in it is still
 1209:  * open, and if that throw escaped, the stack lock would be stranded and every later run would
 1210:  * find a leftover it has to reason about. A lost temp directory is untidy; a stranded lock blocks
 1211:  * work, so the release always wins and the cleanup failure is reported instead of hidden.
 1212:  */
 1213: export function cleanupRun(reportDir: string, lock: { release(): void } | null): void {
 1214:   try {
 1215:     rmSync(reportDir, { recursive: true, force: true });
 1216:   } catch (err) {
 1217:     console.error(`at:verify â€” could not remove the report directory ${reportDir}: ${diagnostic((err as Error).message)}`);
 1218:   } finally {
 1219:     lock?.release();
 1220:   }
 1221: }
 1222: 
 1223: function firstLine(text: string | undefined, fallback: string): string {
 1224:   const line = redact(text ?? '')
 1225:     .split('\n')
 1226:     .map((l) => l.trim())
 1227:     .find((l) => l.length > 0);
 1228:   return line ?? fallback;
 1229: }
 1230: 
 1231: /* --------------------------------------------------------------------------------------- main */
 1232: 
 1233: async function main(argv: string[]): Promise<number> {
 1234:   let args: Args;
 1235:   try {
 1236:     args = parseArgs(argv);
 1237:   } catch (err) {
 1238:     console.error(`at:verify â€” ${(err as Error).message}`);
 1239:     console.error(USAGE);
 1240:     return 2;
 1241:   }
 1242: 
 1243:   const { requirement, tier, wired, expectDeclared } = args;
 1244: 
 1245:   if (wired) {
 1246:     console.error(
 1247:       `at:verify req-${requirement} --wired â€” the screen driver does not exist yet. Wired re-runs ` +
 1248:         `drive the ui-marked ids through real screens; that driver is a later AI4DEV-3 slice, so ` +
 1249:         `there is nothing to re-run against and a silent fixture run would be a false green.`,
 1250:     );
 1251:     return 3;
 1252:   }
 1253: 
 1254:   const dir = suiteDir(requirement);
 1255:   if (!existsSync(dir)) {
 1256:     console.error(`at:verify req-${requirement} â€” no suite at ${dir}`);
 1257:     return 2;
 1258:   }
 1259: 
 1260:   let expected: string[];
 1261:   try {
 1262:     const preflight = inspectBijection(requirement);
 1263:     expected = preflight.expected;
 1264:     if (preflight.problems.length) {
 1265:       console.error(`at:verify req-${requirement} â€” ATâ†”code preflight refused the run: ${preflight.problems.join('; ')}`);
 1266:       return 2;
 1267:     }
 1268:   } catch (err) {
 1269:     console.error(`at:verify req-${requirement} â€” ${(err as Error).message}`);
 1270:     return 2;
 1271:   }
 1272: 
 1273:   // The declaration preflight sits HERE for two reasons, both load-bearing. It needs the
 1274:   // acceptance file's P0 id set, which only exists after the bijection preflight above; and every
 1275:   // refusal must run NO tests, so it must precede the vitest spawn. Placing it before the stack
 1276:   // sequence as well means a bad declaration never takes the machine-wide lock, never talks to
 1277:   // Docker and never resets a database â€” the refusal costs nothing at any tier.
 1278:   let expectation: TierExpectation | null = null;
 1279:   if (expectDeclared) {
 1280:     try {
 1281:       expectation = loadTierExpectation(requirement, tier, expected);
 1282:     } catch (err) {
 1283:       console.error(`at:verify req-${requirement} --tier ${tier} --expect â€” DECLARATION REFUSED: ${(err as Error).message}`);
 1284:       console.error(`No tests were run. The declaration is the contract; fix ${expectedManifestPath(requirement)}.`);
 1285:       return 2;
 1286:     }
 1287:   }
 1288: 
 1289:   const infra = (message: string): number => {
 1290:     console.error(`at:verify req-${requirement} --tier ${tier} â€” INFRASTRUCTURE: ${message}`);
 1291:     console.error('No tests were run. This is an infrastructure failure, not a test failure.');
 1292:     return 3;
 1293:   };
 1294: 
 1295:   const stackHelp =
 1296:     `Two things cause this:\n` +
 1297:     `  1. Docker Desktop is not installed, or is installed but not running, or its CLI is not on ` +
 1298:     `PATH â€” a slot's stack is a set of Docker containers and cannot run without it.\n` +
 1299:     `  2. Docker is fine but the pool was never set up on this machine â€” run ` +
