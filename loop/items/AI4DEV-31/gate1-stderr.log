 506:   maybeBody?: AtTestBody<Sut, W>,
 507: ): void {
 508:   const opts: AtTestOptions = typeof optsOrBody === 'function' ? {} : optsOrBody;
 509:   const body = (typeof optsOrBody === 'function' ? optsOrBody : maybeBody) as AtTestBody<Sut, W>;
 510:   if (typeof body !== 'function') throw new Error(`${atId}: atTest was given no test body`);
 511: 
 512:   const parsed = parseAtId(atId);
 513:   const previous = registrations.get(atId);
 514:   if (previous) throw new Error(`${atId} is registered twice ("${previous.title}" and "${title}") â€” one id, one test`);
 515:   const registration = { ...parsed, title, surface: opts.surface ?? 'backend' };
 516:   registrations.set(atId, registration);
 517:   emitRuntimeRegistration(registration);
 518: 
 519:   const sutKey = opts.sut ?? '';
 520:   const sutMissing =
 521:     opts.sutMissingDetail ?? `REQ-${parsed.requirement}'s implementation is not in the tree â€” harness.sut.${sutKey} is absent`;
 522: 
 523:   it(`${atId} â€” ${title}`, async () => {
 524:     expect.hasAssertions();
 525: 
 526:     const worlds: TrackedTeardown[] = [];
 527:     const harnesses: TrackedTeardown[] = [];
 528:     const usage: Usage = { opens: 0, captures: 0 };
 529:     const ctx: InternalContext<Sut, W> = {
 530:       atId,
 531:       [USAGE]: usage,
 532:       open: async (fixture = `req-${parsed.requirement}/base`, opts) => {
 533:         const { opened, harness } = await openWorld({
 534:           atId,
 535:           requirement: parsed.requirement,
 536:           sutKey,
 537:           sutMissing,
 538:           fixture,
 539:           configOverrides: opts?.config,
 540:         });
 541:         harnesses.push({ what: `harness for fixture world ${JSON.stringify(fixture)}`, teardown: () => harness.teardown() });
 542:         worlds.push({ what: `fixture world ${JSON.stringify(fixture)}`, teardown: () => opened.w.teardown() });
 543:         usage.opens += 1;
 544:         return opened as OpenWorld<Sut, W>;
 545:       },
 546:       capture: async (evidence) => {
 547:         const value = await evidence.consume(ctx);
 548:         usage.captures += 1;
 549:         return value;
 550:       },
 551:     };
 552: 
 553:     await runTrackedTest(atId, () => executeRegisteredBody(atId, body, ctx, usage), worlds, harnesses);
 554:   });
