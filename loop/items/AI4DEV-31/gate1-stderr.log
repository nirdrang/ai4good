  79:     `  atTest('${atId}', 'a pending one', async ({ open }) => {\n` +
  80:     `    const { sut } = await open();\n` +
  81:     `    expect(await sut.ping()).toBe('pong');\n` +
  82:     `    throw new CapabilityPending(['${PENDING_CAPABILITY}']);\n` +
  83:     `  });\n`
  84:   );
  85: }
