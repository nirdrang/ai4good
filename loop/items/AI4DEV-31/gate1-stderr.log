 352:  *
 353:  * Attempting all of them is the point: giving up after one rejection leaves the rest of the stack
 354:  * standing, and a frozen clock, an armed fault or a vendor counter that survives into the next id
 355:  * is exactly the cross-test leak the per-test teardown exists to prevent.
 356:  */
 357: export async function drainTeardowns(worlds: TrackedTeardown[], harnesses: TrackedTeardown[]): Promise<TeardownFailure[]> {
 358:   const failures: TeardownFailure[] = [];
 359:   const drain = async (stack: TrackedTeardown[]) => {
 360:     while (stack.length) {
 361:       const entry = stack.pop()!;
 362:       try {
 363:         await entry.teardown();
 364:       } catch (err) {
 365:         failures.push({ what: entry.what, error: err });
 366:       }
 367:     }
 368:   };
 369:   await drain(worlds);
 370:   await drain(harnesses);
 371:   return failures;
 372: }
