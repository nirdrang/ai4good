  34:       for (const event of MUST_BE_GUARDED) {
  35:         expect(guarded, `${event} dropped out of the guarded matrix â€” the parameterization narrowed`).toContain(event);
  36:       }
  37: 
  38:       // That the requested point is one the product actually exposes, that a handle is armed
  39:       // where it was asked to be, and that the fault genuinely FIRED are the harness's
  40:       // obligations, checked once in harness/guards.ts (faultPointProblem, faultFiredProblem).
  41:       const problems: string[] = [];
  42:       for (const row of GUARDED_ROWS) {
  43:         // (1) CONTROL, in its own world: without the fault this row must commit BOTH sides.
  44:         // Without this, a row that silently no-ops satisfies "neither committed" and the
  45:         // atomicity oracle passes on a transition that never happened.
  46:         {
  47:           const { w, sut } = await open();
  48:           await w.fire(row.event);
