  92:   `throw new Error('this file blows up at import time');\n` +
  93:   `describe('never reached', () => { it('nothing', () => { expect(true).toBe(true); }); });\n`;
  94: 
  95: /** The two-id suite every case shares, so the only variable between cases is the declaration. */
  96: function twoIdSuite(
  97:   requirement: string,
  98:   opts: { secondIsRed?: boolean; untaggedFailure?: boolean; brokenImport?: boolean } = {},
  99: ): Record<string, string> {
 100:   const { secondIsRed = true, untaggedFailure = false, brokenImport = false } = opts;
 101:   const files: Record<string, string> = {
 102:     'a-two-ids.test.ts':
 103:       suitePreamble() +
 104:       `describe('two ids', () => {\n` +
 105:       greenTest(`AT-${requirement}.01`) +
 106:       (secondIsRed ? redTest(`AT-${requirement}.02`) : greenTest(`AT-${requirement}.02`)) +
 107:       (untaggedFailure ? `  it('a failure no id claims', () => { expect(1).toBe(2); });\n` : '') +
 108:       `});\n`,
 109:   };
 110:   if (brokenImport) files['z-broken.test.ts'] = IMPORT_FAILURE_FILE;
 111:   return files;
 112: }
