  63: /** A green id: opens a world and asserts something the fixture adapter really answers. */
  64: function greenTest(atId: string): string {
  65:   return (
  66:     `  atTest('${atId}', 'a green one', async ({ open }) => {\n` +
  67:     `    const { sut } = await open();\n` +
  68:     `    expect(await sut.ping()).toBe('pong');\n` +
  69:     `  });\n`
  70:   );
