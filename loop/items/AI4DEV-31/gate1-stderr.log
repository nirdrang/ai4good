 252:   if (Array.isArray(object)) {
 253:     for (const [index, child] of object.entries()) freezeEvidence(child, `${path}[${index}]`, seen);
 254:     return Object.freeze(value);
 255:   }
 256: 
 257:   const proto = Object.getPrototypeOf(object);
 258:   if (proto !== null && proto !== Object.prototype) {
 259:     throw new Error(
