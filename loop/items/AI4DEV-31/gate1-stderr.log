  54: function suitePreamble(): string {
  55:   return (
  56:     `import { describe, expect, it } from 'vitest';\n` +
  57:     `import { bindSuite } from '${REGISTRY_URL}';\n` +
  58:     `import { CapabilityPending } from '${CAPABILITIES_URL}';\n` +
