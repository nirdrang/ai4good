 124: interface ExpectTree {
 125:   requirement: string;
 126:   acceptance: string;
 127:   files: Record<string, string>;
 128:   /** raw text written to <tree>/tests/at/expected/req-<NNN>.json; omit to plant no declaration */
 129:   manifest?: string;
 130:   /** pass --expect to the runner */
 131:   expect: boolean;
 132: }
