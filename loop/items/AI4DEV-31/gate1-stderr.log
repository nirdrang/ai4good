 223:  *
 224:  * `Object.freeze` is shallow in a second sense nobody expects: it seals a Map's own properties
 225:  * and leaves `set`/`delete` fully working, and the same is true of a Set, a Date and any class
 226:  * instance with mutating methods. So a capture carrying one of those LOOKS frozen and is not â€”
 227:  * which defeats the whole point of capture-once/assert-many, where one lens normalizing or
 228:  * de-duplicating evidence in place would hide it from the next lens. Silently freezing such a
 229:  * value is worse than rejecting it, because the immutability the suites are told to rely on
 230:  * would be a lie in exactly the cases that matter.
 231:  *
 232:  * So the accepted shapes are the ones freezing genuinely closes: primitives, arrays, and plain
 233:  * objects (`Object.prototype` or a null prototype â€” what `structuredClone` and object literals
 234:  * produce). Everything else throws, naming the path, so the producer converts it to inert data
 235:  * (a Date to an ISO string, a Map to entries) where the conversion is visible.
 236:  */
 237: export function freezeEvidence<T>(value: T, path = '', seen = new WeakSet<object>()): T {
 238:   if (value === null) return value;
 239:   const type = typeof value;
 240:   if (type === 'undefined' || type === 'string' || type === 'number' || type === 'boolean' || type === 'bigint') return value;
 241:   if (type === 'function') {
 242:     throw new Error(`${evidencePath(path)} is a function â€” captured evidence must be inert data, not something that can still run`);
 243:   }
 244:   if (type === 'symbol') {
 245:     throw new Error(`${evidencePath(path)} is a symbol â€” captured evidence must be inert data an assertion can read`);
 246:   }
