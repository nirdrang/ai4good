  53:             problems.push(
  54:               `${row.event}: control run (no fault) produced transition=${transition} event=${written} â€” ` +
  55:                 `the fault run's "neither committed" would be indistinguishable from a no-op fixture`,
  56:             );
  57:             continue;
  58:           }
  59:         }
