 134: /**
 135:  * Plant a tree, run the real runner against it at the loop tier, remove the tree.
 136:  *
 137:  * The declaration is written under the TREE, not the checkout â€” which is why
 138:  * `expectedManifestPath` must resolve from the AT_REPO_ROOT-overridable data root rather than the
 139:  * install root. That is a hard constraint on the module, not a preference.
 140:  */
 141: function runExpectTree(spec: ExpectTree): RunnerOutcome {
 142:   const tree = mkdtempSync(join(tmpdir(), 'at-expect-'));
 143:   try {
 144:     const suiteDir = join(tree, 'tests', 'at', 'suites', `req-${spec.requirement}`);
 145:     mkdirSync(suiteDir, { recursive: true });
 146:     mkdirSync(join(tree, '.taskmaster', 'docs', 'acceptance'), { recursive: true });
 147:     writeFileSync(join(tree, '.taskmaster', 'docs', 'acceptance', `at-req-${spec.requirement}.md`), spec.acceptance, 'utf8');
 148:     writeFileSync(join(tree, 'tests', 'at', 'vitest.config.ts'), FIXTURE_VITEST_CONFIG, 'utf8');
 149:     writeFileSync(join(suiteDir, '_fixture.ts'), FIXTURE_ADAPTER, 'utf8');
 150:     for (const [name, content] of Object.entries(spec.files)) writeFileSync(join(suiteDir, name), content, 'utf8');
 151: 
 152:     if (spec.manifest !== undefined) {
 153:       const expectedDir = join(tree, 'tests', 'at', 'expected');
 154:       mkdirSync(expectedDir, { recursive: true });
 155:       writeFileSync(join(expectedDir, `req-${spec.requirement}.json`), spec.manifest, 'utf8');
 156:     }
 157: 
 158:     const argv = [`req-${spec.requirement}`, '--tier', 'loop', ...(spec.expect ? ['--expect'] : [])];
 159:     const run = spawnSync(bunExecutable(), ['--no-env-file', RUNNER, ...argv], {
 160:       cwd: INSTALL_ROOT,
 161:       env: childEnv({ AT_REPO_ROOT: tree }),
 162:       encoding: 'utf8',
 163:     });
 164: 
 165:     const stdout = run.stdout ?? '';
 166:     const stderr = run.stderr ?? '';
 167:     return { status: run.status, stdout, stderr, output: `${stdout}\n${stderr}` };
 168:   } finally {
 169:     for (let attempt = 0; attempt < 2; attempt++) {
 170:       try {
 171:         rmSync(tree, { recursive: true, force: true });
 172:         break;
 173:       } catch {
 174:         /* retry once â€” Windows can hold a handle open for a moment after the child exits */
 175:       }
 176:     }
 177:   }
 178: }
