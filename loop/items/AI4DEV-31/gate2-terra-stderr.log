 116: export type EmailProviderSim<Channel extends string = string> = {
 117:   /** next N sends are rejected / never accepted (AT-016.11) */
 118:   rejectNext(count: number): void;
 119:   /** next N sends are ACCEPTED by the provider but the ack is lost (AT-016.11) */
 120:   acceptButLoseAck(count: number): void;
 121:   /** everything the provider actually accepted, in order */
 122:   accepted(): ProviderAttempt<Channel>[];
 123:   /**
 124:    * EVERY send that arrived at the provider seam, accepted or not, in order.
 125:    * This is the out-of-band trace: it is recorded by the simulator, not by the SUT, so it
 126:    * can contradict the SUT's own attempt counter (AT-016.11's retry proof, AT-016.01's
 127:    * "no path around the emitter").
 128:    */
 129:   attempts(): ProviderAttempt<Channel>[];
 130: };
 131: 
 132: export type Vendors<Channel extends string = string> = {
 133:   email: EmailProviderSim<Channel>;
 134: };
