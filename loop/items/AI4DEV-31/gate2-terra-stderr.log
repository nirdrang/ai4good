 718:           requirement: parsed.requirement,
 719:           sutKey,
 720:           sutMissing,
 721:           fixture,
 722:           configOverrides: openOpts?.config,
 723:         });
 724:         harnesses.push({ what: `harness for fixture world ${JSON.stringify(fixture)}`, teardown: () => harness.teardown() });
 725:         worlds.push({ what: `fixture world ${JSON.stringify(fixture)}`, teardown: () => opened.w.teardown() });
 726:         usage.opens += 1;
