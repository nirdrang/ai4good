  38: /**
  39:  * Time, under the test's control â€” funding's 7-day expiry, the UTC daily credit reset, blocker
  40:  * aging, abandonment, link expiry.
  41:  *
  42:  * There is deliberately NO `observedByProduct()` here. A method by which the clock reports its
  43:  * own time cannot distinguish a clock the product reads from one that only moves the test's
  44:  * notion of time â€” it is the clock answering a question about itself. That wiring is proven
  45:  * BEHAVIOURALLY instead: move the clock, then assert product behaviour that depends on time
  46:  * changed (the anti-spam window in AT-016.08). Sampling the clock from inside the product process
  47:  * is a real capability, but it needs a product process to sample, so it belongs to a later
  48:  * integration-tier slice, not to a self-report.
  49:  */
  50: export type Clock = {
  51:   freezeAt(iso: string): Promise<void>;
  52:   advance(ms: number): Promise<void>;
  53: };
