 409: /**
 410:  * An immutable capture, consumable by any test in the suite that defined it.
 411:  *
 412:  * A TYPE, never the class â€” and named by a requirement and a sut key, never by a shape. Both halves
 413:  * matter: the class would expose a constructor that takes a producer at any types, and shape
 414:  * parameters would let a body widen the context it is handed. See `SeamOpenWorld`.
 415:  */
 416: export type EvidenceCapture<T, R extends SuiteId, K extends SutKeyOf<R>> = EvidenceCaptureImpl<T, SutOf<R, K>, WorldOf<R>>;
 417: 
 418: /**
 419:  * `defineEvidenceCapture` was the SECOND door to the seam AI4DEV-31 closes, and closing `bindSuite`
 420:  * alone would have moved the defect rather than removed it: this function handed its producer a
 421:  * full `AtContext<Sut, W>` at whatever types the caller named, so a suite that never called
 422:  * `bindSuite` could still declare a system under test and a world out of nothing and read both green.
 423:  *
 424:  * So it takes the BINDING and derives, exactly as `atTest` does. There is no type argument left to
 425:  * lie with: `SutOf<R, K>` and `WorldOf<R>` come from the adapter registered under `R`.
 426:  *
 427:  * A `const` typed by a call-signature alias, NOT an exported `function` declaration â€” that is not
 428:  * stylistic. Gate 1 measured that an exported function declaration can be given a fresh generic
 429:  * overload through `declare module`, restoring the fabricated type argument, and that type aliases
 430:  * do not protect it. A `const` has no declaration to merge an overload into.
 431:  */
 432: type DefineEvidenceCaptureFn = <T, R extends SuiteId, K extends SutKeyOf<R>>(
 433:   binding: SuiteBinding<R, K>,
 434:   name: string,
 435:   producer: (ctx: AtContext<R, K>) => Promise<T>,
 436: ) => EvidenceCapture<T, R, K>;
 437: 
 438: export const defineEvidenceCapture: DefineEvidenceCaptureFn = (binding, name, producer) =>
 439:   new EvidenceCaptureImpl(name, binding.requirement, producer);
