  28: /** The minimum every fixture world owes the harness: it can be given back. */
  29: export type WorldSeam = {
  30:   teardown(): Promise<void>;
  31: };
  32: 
  33: /** A suite parameterizes this with its own world type; the seam is the same for all of them. */
  34: export type Fixtures<W extends WorldSeam = WorldSeam> = {
  35:   world(name: string): Promise<W>;
  36: };
