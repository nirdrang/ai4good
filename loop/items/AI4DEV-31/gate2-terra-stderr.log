 283: const USAGE = Symbol('at-context-usage');
 284: 
 285: interface Usage {
 286:   opens: number;
 287:   captures: number;
 288: }
 289: 
 290: /**
 291:  * NOT EXPORTED, and a type alias rather than an interface, for the two different reasons this file
 292:  * keeps apart: not exported so no suite can name it, an alias so nothing can merge a member into it
 293:  * even from inside this module. It is reachable from a test body â€” `capture()` hands it to an
 294:  * evidence producer â€” and everything on that path obeys the alias rule.
 295:  */
 296: type InternalContext<Sut, W extends WorldLike> = SeamContext<Sut, W> & {
 297:   [USAGE]: Usage;
 298: };
