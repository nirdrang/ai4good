  68: export type FaultHandle = {
  69:   /** the point this handle is armed at â€” echoed back so a silent re-point is visible */
  70:   point: string;
  71:   /** how many times execution actually REACHED the armed point (0 = the fault never fired) */
  72:   triggerCount(): Promise<number>;
  73:   clear(): Promise<void>;
  74: };
  75: 
  76: export type Faults = {
  77:   /** the fault points the product actually exposes â€” arming an unknown point must not be a no-op */
  78:   points(): Promise<string[]>;
  79:   /**
  80:    * Induce a fault at a named point in the product.
  81:    * 'notifications.between_transition_and_event_write' is AT-016.09's point.
  82:    * MUST reject a point that is not in points().
  83:    */
  84:   at(point: string, kind: 'crash' | 'reject' | 'lose_ack'): Promise<FaultHandle>;
  85:   /** kill and restart the delivery process mid-flight (AT-016.07) */
  86:   processRestart(): Promise<void>;
  87:   /** identity of the delivery process; MUST change across processRestart() */
  88:   processEpoch(): Promise<string>;
