--- /dev/null
+++ b/tests/at/typeprobes/gate2-intersection.probe.ts
@@ -0,0 +1,35 @@
+import { atTest, bindSuite, defineEvidenceCapture } from '../harness/registry.ts';
+import type { AtContext, AtTestBody, EvidenceCapture, OpenWorld } from '../harness/registry.ts';
+
+type DerivedOpenWorld = OpenWorld<'req-016', 'notifications'>;
+type WidenedOpenWorld = DerivedOpenWorld & {
+  sut: { inventedSut?: string };
+  w: { inventedWorld?: string };
+};
+type WidenedContext = Omit<AtContext<'req-016', 'notifications'>, 'open'> & {
+  open(fixture?: string): Promise<WidenedOpenWorld>;
+};
+
+const binding = { requirement: 'req-016', sut: 'notifications' } as const;
+const suite = bindSuite(binding);
+
+const body: AtTestBody<'req-016', 'notifications'> = async (ctx: WidenedContext) => {
+  const { sut, w } = await ctx.open();
+  void sut.inventedSut;
+  void w.inventedWorld;
+};
+
+suite.atTest('AT-016.95', 'widened through bound atTest', body);
+atTest('AT-016.96', 'widened through raw atTest', binding, async (ctx: WidenedContext) => {
+  const { sut, w } = await ctx.open();
+  void sut.inventedSut;
+  void w.inventedWorld;
+});
+
+defineEvidenceCapture(binding, 'widened through raw capture', async (ctx: WidenedContext) => {
+  const { sut, w } = await ctx.open();
+  return `${sut.inventedSut}${w.inventedWorld}`;
+});
+
+declare const existingCapture: EvidenceCapture<string, 'req-016', 'notifications'>;
+void existingCapture;
