 576:       'harness-missing',
 577:       `AI4DEV-3 capability modules (H2 fixtures/clock, H3 sentinels/faults, H4 oracles, ` +
 578:         `H5 vendor sims) are not in the tree: cannot resolve "${HARNESS_MODULE}" ` +
 579:         `from tests/at/harness (${harnessResolveError})`,
 580:     );
