 360: export function captureProducerProblem(opensBefore: number, opensAfter: number): string | null {
 361:   return opensAfter === opensBefore ? 'capture producer completed without open()' : null;
 362: }
 363: 
 364: /**
 365:  * The implementation class, DELIBERATELY NOT EXPORTED â€” only the type alias below is.
 366:  *
 367:  * An exported class is a value with a public constructor, so `new EvidenceCapture<T, Anything,
 368:  * AnythingElse>(name, producer)` was a way to hand a producer a fabricated `AtContext` without ever
 369:  * touching `bindSuite`: the same lie as the one AI4DEV-31 closes at `open()`, reached through a
 370:  * `new`. Exporting only the type removes the constructor from a suite's reach, and has the second
 371:  * effect of making `EvidenceCapture` a type ALIAS, which declaration merging cannot open.
 372:  */
 373: class EvidenceCaptureImpl<T, Sut = unknown, W extends WorldLike = WorldLike> {
 374:   private result: Promise<T> | null = null;
 375:   private producerAtId = '';
 376: 
 377:   constructor(
 378:     readonly name: string,
 379:     /** the suite this capture reads the seam of â€” it is in the failure text so a red says whose */
 380:     readonly requirement: string,
 381:     private readonly producer: (ctx: SeamContext<Sut, W>) => Promise<T>,
 382:   ) {}
 383: 
 384:   consume(ctx: InternalContext<Sut, W>): Promise<T> {
 385:     if (!this.result) {
 386:       this.producerAtId = ctx.atId;
 387:       const opensBefore = ctx[USAGE].opens;
 388:       this.result = (async () => {
 389:         try {
 390:           const value = await this.producer(ctx);
 391:           const problem = captureProducerProblem(opensBefore, ctx[USAGE].opens);
 392:           if (problem) {
 393:             throw new Error(`evidence capture ${JSON.stringify(this.name)} produced by ${ctx.atId} â€” ${problem}`);
 394:           }
 395:           return freezeEvidence(value);
 396:         } catch (err) {
 397:           const detail = err instanceof Error ? err.message : String(err);
 398:           throw new Error(
 399:             `evidence capture ${JSON.stringify(this.name)} (${this.requirement}) produced by ${this.producerAtId} failed â€” ${detail}`,
 400:             { cause: err },
 401:           );
 402:         }
 403:       })();
 404:     }
 405:     return this.result;
 406:   }
 407: }
