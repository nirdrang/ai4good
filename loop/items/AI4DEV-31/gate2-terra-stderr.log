  93:  * AT-016.01's sole-writer claim is unfalsifiable if the only witnesses are `senders()` and
  94:  * `Delivery.emittedBy` â€” both produced by the component under test.
  95:  */
  96: export type StaticScan = {
  97:   /** components whose SOURCE imports a comms-provider client or reads a provider credential */
  98:   providerClientImporters(): Promise<string[]>;
  99: };
 100: 
 101: /* ------------------------------------------------------------------- H5 vendor sims */
 102: 
 103: export type ProviderOutcome = 'accepted' | 'rejected' | 'ack_lost';
 104: 
 105: /**
 106:  * Channels are named by the requirement that owns them (REQ-016's are 'email' and 'inapp'), so
 107:  * the vendor types are generic over the channel name rather than hard-coding one suite's set.
 108:  */
 109: export type ProviderAttempt<Channel extends string = string> = {
 110:   recipientId: string;
 111:   eventId: string;
 112:   channel: Channel;
 113:   outcome: ProviderOutcome;
 114: };
