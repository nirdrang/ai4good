  79: }
  80: 
  81: function defaults(): DocumentedDefault[] {
  82:   return TAXONOMY.map((row) => ({
  83:     event: row.event,
  84:     channels: channelsFor(row),
  85:     source: row.channels ? `REQ-016 taxonomy row ${row.event}` : `REQ-016 documented ${row.class} delivery default`,
  86:   }));
  87: }
  88: 
  89: function payloadFor(row: TaxonomyRow, params: Record<string, unknown>): Record<string, unknown> {
  90:   const payload: Record<string, unknown> = { ...params };
  91:   const named: Record<string, unknown> = {
  92:     marketplaceVisibility: true,
  93:     reason: 'The scope needs a clearer measurable outcome',
  94:     consentCta: 'Confirm consent',
  95:     fundToKickOff: 'Fund to kick off',
  96:     replacementOnDashboard: 'Find the replacement on your dashboard',
  97:     whatToDoInstead: 'Use the supported status command to continue',
  98:     // d89 decline-then-review rows
  99:     declineCause: 'ongoing_developer_maintenance',
 100:     reshapingSuggestion: 'Consider reshaping this as a staffer-maintainable intake tool',
 101:     oversightSentence: 'A person reads every decline; if we got it wrong, we will reach out',
 102:     discoveryReopened: true,
 103:   };
 104:   for (const key of row.payloadKeys ?? []) payload[key] = named[key] ?? `${row.event} ${key}`;
 105:   return payload;
 106: }
 107: 
 108: function bodyFor(row: TaxonomyRow, payload: Record<string, unknown>): string {
 109:   const carried = Object.values(payload)
 110:     .filter((value): value is string => typeof value === 'string')
 111:     .join(' ');
 112:   const base =
 113:     row.event === 'leftover.released'
 114:       ? 'Unused fuel was released to the NGO general balance.'
 115:       : `${row.event.replaceAll(/[._]/g, ' ')} notification.`;
 116:   return `${base}${carried ? ` ${carried}` : ''}`;
 117: }
 118: 
 119: class NotificationFixtureWorld implements World {
 120:   readonly actors: Record<Role, string>;
 121: 
 122:   constructor(
 123:     private readonly base: FixtureWorld,
 124:     private readonly emitKnown: (
 125:       world: NotificationFixtureWorld,
 126:       event: string,
 127:       params?: Record<string, unknown>,
 128:     ) => Promise<{ eventId: string }>,
 129:     private readonly burstComments: (world: NotificationFixtureWorld, count: number) => Promise<void>,
 130:     private readonly state: MutableState,
 131:   ) {
 132:     this.actors = base.state.actors;
 133:   }
 134: 
 135:   async fire(event: string, params: Record<string, unknown> = {}): Promise<{ eventId: string }> {
 136:     this.base.assertActive();
 137:     return this.emitKnown(this, event, params);
 138:   }
 139: 
 140:   async transitionCommitted(event: string): Promise<boolean> {
 141:     this.base.assertActive();
 142:     return this.state.transitions.get(event) ?? false;
 143:   }
 144: 
 145:   async reassignRole(role: Role, toActorId: string): Promise<string> {
 146:     this.base.assertActive();
 147:     this.actors[role] = toActorId;
 148:     return toActorId;
 149:   }
 150: 
 151:   async burstThreadComments(count: number): Promise<void> {
 152:     this.base.assertActive();
 153:     await this.burstComments(this, count);
 154:   }
 155: 
 156:   async teardown(): Promise<void> {
 157:     await this.base.teardown();
 158:   }
 159: }
 160: 
 161: function clone<T>(value: T): T {
 162:   return structuredClone(value);
 163: }
 164: 
 165: export function createFixtureAdapter({ clock, worlds, config }: AdapterOptions) {
 166:   const state: MutableState = {
 167:     events: [],
 168:     deliveries: [],
 169:     opsItems: [],
 170:     transitions: new Map(),
 171:     nextId: 1,
 172:   };
 173:   const openedWorlds = new Set<NotificationFixtureWorld>();
 174:   let currentWorld: NotificationFixtureWorld | null = null;
 175:   let commentWindowStart: number | null = null;
 176:   let commentsInWindow = 0;
 177:   let coalescedInWindow = false;
 178: 
 179:   const emitKnown = async (
 180:     world: NotificationFixtureWorld,
 181:     event: string,
 182:     params: Record<string, unknown> = {},
 183:   ): Promise<{ eventId: string }> => {
 184:     const row = TAXONOMY.find((candidate) => candidate.event === event);
 185:     if (!row) throw new Error(`fixture cannot fire unregistered notification event ${JSON.stringify(event)}`);
 186:     const eventId = `event-${state.nextId++}`;
 187:     const channels = channelsFor(row);
 188:     const payload = payloadFor(row, params);
 189:     const recipients = row.recipients.map((role) => ({
 190:       role,
 191:       recipientId: world.actors[role],
 192:       channels: [...channels],
 193:     }));
 194:     state.events.push({
 195:       id: eventId,
 196:       type: event,
 197:       recipients: clone(recipients),
 198:       state: 'pending',
 199:       attempts: 0,
 200:     });
 201:     for (const recipient of recipients) {
 202:       for (const channel of recipient.channels) {
 203:         state.deliveries.push({
 204:           eventId,
 205:           type: event,
 206:           role: recipient.role,
 207:           recipientId: recipient.recipientId,
 208:           channel,
 209:           state: 'pending',
 210:           emittedBy: 'notifications.emitter',
 211:           payload: clone(payload),
 212:           body: bodyFor(row, payload),
 213:         });
 214:       }
 215:     }
 216:     if (row.opsItem) {
 217:       state.opsItems.push({ id: `ops-${eventId}`, kind: row.event, linkedEventId: eventId });
 218:     }
 219:     state.transitions.set(event, true);
 220:     return { eventId };
 221:   };
 222: 
 223:   const sut: NotificationsSut = {
 224:     senders: async () => clone(SENDERS),
 225:     taxonomy: async (): Promise<RegisteredRow[]> =>
 226:       TAXONOMY.map((row) => ({
 227:         event: row.event,
 228:         recipients: [...row.recipients],
 229:         channels: row.channels ? [...row.channels] : null,
 230:         tone: row.tone,
 231:       })),
 232:     documentedDefaults: async () => clone(defaults()),
 233:     runtimeRegistrationSurface: async () => [],
 234:     emit: async (request): Promise<EmitResult> => {
 235:       const row = TAXONOMY.find((candidate) => candidate.event === request.type);
 236:       if (!row) return { accepted: false, reason: 'unregistered event type' };
 237:       if (!currentWorld) return { accepted: false, reason: 'no fixture world is open' };
 238:       const { eventId } = await emitKnown(currentWorld, request.type, request.ctx);
 239:       return { accepted: true, eventId };
 240:     },
 241:     events: async (filter) => clone(state.events.filter((event) => !filter?.type || event.type === filter.type)),
 242:     deliveries: async (filter) => clone(state.deliveries.filter((delivery) => !filter?.type || delivery.type === filter.type)),
 243:     opsItems: async (filter) =>
 244:       clone(state.opsItems.filter((item) => !filter?.linkedEventId || item.linkedEventId === filter.linkedEventId)),
 245:     drainDeliveries: async () => {
 246:       for (const delivery of state.deliveries) delivery.state = 'sent';
 247:       for (const event of state.events) {
 248:         if (event.state === 'pending' || event.state === 'retrying') {
 249:           event.state = 'sent';
 250:           event.attempts += 1;
 251:         }
 252:       }
 253:     },
 254:   };
 255: 
 256:   return {
 257:     sut: { notifications: sut },
 258:     fixtures: {
 259:       world: async (name: string) => {
 260:         const base = await worlds.world(name);
 261:         const burstComments = async (world: NotificationFixtureWorld, count: number) => {
 262:           // Read at guard-evaluation time, not at construction: the configuration is what this
 263:           // world was opened with, and a value captured once could not be re-tuned per world.
 264:           const cap = config.get<number>(GUARD_CAP_KEY);
 265:           const windowMs = config.get<number>(GUARD_WINDOW_KEY);
 266:           const coalesce = config.get<boolean>(GUARD_COALESCE_KEY);
 267: 
 268:           const now = clock.now();
 269:           if (commentWindowStart === null || now - commentWindowStart >= windowMs) {
 270:             commentWindowStart = now;
 271:             commentsInWindow = 0;
 272:             coalescedInWindow = false;
 273:           }
 274:           for (let index = 0; index < count; index++) {
 275:             if (coalesce) {
 276:               // Coalescing: the whole burst becomes ONE notification for the window.
 277:               if (!coalescedInWindow) {
 278:                 await emitKnown(world, 'thread.comment');
 279:                 coalescedInWindow = true;
 280:               }
 281:             } else if (commentsInWindow < cap) {
 282:               await emitKnown(world, 'thread.comment');
 283:             }
 284:             commentsInWindow += 1;
 285:           }
 286:         };
 287:         const world = new NotificationFixtureWorld(base, emitKnown, burstComments, state);
 288:         openedWorlds.add(world);
 289:         currentWorld = world;
 290:         return world;
 291:       },
 292:     },
 293:     teardown: async () => {
 294:       await Promise.all([...openedWorlds].map((world) => world.teardown()));
 295:       openedWorlds.clear();
 296:       currentWorld = null;
 297:       state.events.length = 0;
 298:       state.deliveries.length = 0;
 299:       state.opsItems.length = 0;
 300:       state.transitions.clear();
 301:       commentWindowStart = null;
 302:       commentsInWindow = 0;
 303:       coalescedInWindow = false;
 304:     },
 305:   };
 306: }

