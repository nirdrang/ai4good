 300: /** Where in the captured structure a value sits, said in words a test author can act on. */
 301: function evidencePath(path: string): string {
 302:   return path ? `the captured value at ${JSON.stringify(path)}` : 'the captured value';
 303: }
 304: 
 305: function constructorName(value: object): string {
 306:   return Object.getPrototypeOf(value)?.constructor?.name ?? 'an object with an exotic prototype';
 307: }
 308: 
 309: /**
 310:  * Deep-freeze a capture â€” and REFUSE anything that freezing does not actually make immutable.
 311:  *
 312:  * `Object.freeze` is shallow in a second sense nobody expects: it seals a Map's own properties
 313:  * and leaves `set`/`delete` fully working, and the same is true of a Set, a Date and any class
 314:  * instance with mutating methods. So a capture carrying one of those LOOKS frozen and is not â€”
 315:  * which defeats the whole point of capture-once/assert-many, where one lens normalizing or
 316:  * de-duplicating evidence in place would hide it from the next lens. Silently freezing such a
 317:  * value is worse than rejecting it, because the immutability the suites are told to rely on
 318:  * would be a lie in exactly the cases that matter.
 319:  *
 320:  * So the accepted shapes are the ones freezing genuinely closes: primitives, arrays, and plain
 321:  * objects (`Object.prototype` or a null prototype â€” what `structuredClone` and object literals
 322:  * produce). Everything else throws, naming the path, so the producer converts it to inert data
 323:  * (a Date to an ISO string, a Map to entries) where the conversion is visible.
 324:  */
 325: export function freezeEvidence<T>(value: T, path = '', seen = new WeakSet<object>()): T {
 326:   if (value === null) return value;
 327:   const type = typeof value;
 328:   if (type === 'undefined' || type === 'string' || type === 'number' || type === 'boolean' || type === 'bigint') return value;
 329:   if (type === 'function') {
 330:     throw new Error(`${evidencePath(path)} is a function â€” captured evidence must be inert data, not something that can still run`);
 331:   }
 332:   if (type === 'symbol') {
 333:     throw new Error(`${evidencePath(path)} is a symbol â€” captured evidence must be inert data an assertion can read`);
 334:   }
 335: 
 336:   const object = value as unknown as object;
 337:   if (seen.has(object)) return value;
 338:   seen.add(object);
 339: 
 340:   if (Array.isArray(object)) {
 341:     for (const [index, child] of object.entries()) freezeEvidence(child, `${path}[${index}]`, seen);
 342:     return Object.freeze(value);
 343:   }
 344: 
 345:   const proto = Object.getPrototypeOf(object);
 346:   if (proto !== null && proto !== Object.prototype) {
 347:     throw new Error(
 348:       `${evidencePath(path)} is a ${constructorName(object)} â€” freezeEvidence accepts only primitives, ` +
 349:         `arrays and plain objects, because Object.freeze leaves a Map, Set, Date or class instance ` +
 350:         `mutable through its own methods. Capture it as inert data instead.`,
 351:     );
 352:   }
 353: 
 354:   for (const [key, child] of Object.entries(object as Record<string, unknown>)) {
 355:     freezeEvidence(child, path ? `${path}.${key}` : key, seen);
 356:   }
 357:   return Object.freeze(value);
 358: }
