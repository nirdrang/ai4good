@@ -0,0 +1,37 @@
+import { atTest, defineEvidenceCapture } from '../harness/registry.ts';
+import type { AtContext, AtTestBody, EvidenceCapture, OpenWorld } from '../harness/registry.ts';
+import type { NotificationsSut, World } from '../suites/req-016/_contract.ts';
+
+type FabricatedSut = { inventedSut(): Promise<void> };
+type FabricatedWorld = World & { inventedWorld?: string };
+
+type OpenWorldAttack = OpenWorld<FabricatedSut, FabricatedWorld>;
+type AtContextAttack = AtContext<FabricatedSut, FabricatedWorld>;
+type AtTestBodyAttack = AtTestBody<FabricatedSut, FabricatedWorld>;
+type EvidenceCaptureAttack = EvidenceCapture<string, FabricatedSut, FabricatedWorld>;
+void (null as unknown as OpenWorldAttack);
+void (null as unknown as AtContextAttack);
+void (null as unknown as AtTestBodyAttack);
+void (null as unknown as EvidenceCaptureAttack);
+
+atTest<FabricatedSut, FabricatedWorld>(
+  'AT-016.97',
+  'direct atTest with invented seam',
+  { requirement: 'req-016', sut: 'notifications' },
+  async ({ open }) => {
+    const { sut, w } = await open();
+    await sut.inventedSut();
+    void w.inventedWorld;
+  },
+);
+
+defineEvidenceCapture<string, FabricatedSut, FabricatedWorld>(
+  { requirement: 'req-016', sut: 'notifications' },
+  'direct evidence capture with invented seam',
+  async ({ open }) => {
+    const { sut, w } = await open();
+    return `${await sut.inventedSut()}${w.inventedWorld}`;
+  },
+);
+
+void (null as unknown as NotificationsSut);
