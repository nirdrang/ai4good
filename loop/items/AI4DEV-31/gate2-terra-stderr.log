 705: 
 706:   it(`${atId} â€” ${title}`, async () => {
 707:     expect.hasAssertions();
 708: 
 709:     const worlds: TrackedTeardown[] = [];
 710:     const harnesses: TrackedTeardown[] = [];
 711:     const usage: Usage = { opens: 0, captures: 0 };
 712:     const ctx: InternalContext<SutOf<R, K>, WorldOf<R>> = {
 713:       atId,
 714:       [USAGE]: usage,
 715:       open: async (fixture = `req-${parsed.requirement}/base`, openOpts) => {
 716:         const { opened, harness } = await openWorld({
