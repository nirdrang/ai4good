 492: export async function drainTeardowns(worlds: TrackedTeardown[], harnesses: TrackedTeardown[]): Promise<TeardownFailure[]> {
 493:   const failures: TeardownFailure[] = [];
 494:   const drain = async (stack: TrackedTeardown[]) => {
 495:     while (stack.length) {
 496:       const entry = stack.pop()!;
 497:       try {
 498:         await entry.teardown();
 499:       } catch (err) {
 500:         failures.push({ what: entry.what, error: err });
 501:       }
 502:     }
 503:   };
 504:   await drain(worlds);
 505:   await drain(harnesses);
 506:   return failures;
