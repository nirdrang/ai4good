 782:  * an extra generic overload onto it through `declare module` and restore the fabricated arguments.
 783:  */
 784: type BindSuiteFn = <R extends SuiteId, K extends SutKeyOf<R>>(
 785:   binding: SuiteBinding<R, K>,
 786: ) => {
 787:   atTest: BoundAtTest<R, K>;
 788:   defineEvidenceCapture: BoundDefineEvidenceCapture<R, K>;
 789: };
 790: 
 791: export const bindSuite: BindSuiteFn = <R extends SuiteId, K extends SutKeyOf<R>>(binding: SuiteBinding<R, K>) => {
 792:   const boundAtTest = (
 793:     atId: string,
 794:     title: string,
 795:     optsOrBody: AtTestOptions | AtTestBody<R, K>,
 796:     maybeBody?: AtTestBody<R, K>,
 797:   ): void => {
 798:     const opts: AtTestOptions = typeof optsOrBody === 'function' ? {} : optsOrBody;
 799:     const body = (typeof optsOrBody === 'function' ? optsOrBody : maybeBody) as AtTestBody<R, K>;
 800:     atTest<R, K>(atId, title, { ...opts, ...binding }, body);
 801:   };
 802: 
 803:   // Annotated here rather than left to the contextual type from `BindSuiteFn`: inside the object
 804:   // literal the context would supply that alias's own `R`/`K`, which TypeScript treats as unrelated
 805:   // to this implementation's â€” the "two different types with this name exist" rejection. Naming the
 806:   // type against the local parameters is what makes `binding` line up with the call below.
 807:   const boundCapture: BoundDefineEvidenceCapture<R, K> = (name, producer) =>
 808:     defineEvidenceCapture(binding, name, producer);
 809: 
 810:   return {
 811:     atTest: boundAtTest,
 812:     defineEvidenceCapture: boundCapture,
 813:   };
 814: };

