 564: /**
 565:  * Builds a harness and a world, at the types the HARNESS can actually prove: `sut` is `unknown`
 566:  * (`h.sut[key]` on a concrete `AtHarness`) and `w` is a bare `WorldLike`. It deliberately knows
 567:  * nothing about any suite â€” the narrowing to that suite's derived types happens once, at the end of
 568:  * `open()`, where the comment says exactly what is still taken on trust.
 569:  */
 570: async function openWorld(o: OpenOptions): Promise<{ opened: SeamOpenWorld; harness: AtHarness }> {
 571:   if (TIER === null) throw new AtPending(o.atId, 'tier-unset', tierError(o.requirement));
 572: 
 573:   if (!harnessModule) {
 574:     throw new AtPending(
