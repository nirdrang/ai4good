 271: /** The STRUCTURE of what a test body is given â€” not exported, for the reason on `SeamOpenWorld`. */
 272: type SeamContext<Sut = unknown, W extends WorldLike = WorldLike> = {
 273:   atId: string;
 274:   /** build a fresh "Given" world (and its own harness). Call it more than once for isolation. */
 275:   open(fixture?: string, opts?: OpenOverrides): Promise<SeamOpenWorld<Sut, W>>;
 276:   /** consume an immutable capture whose producer proved at least one real open() */
 277:   capture<T>(evidence: EvidenceCaptureImpl<T, Sut, W>): Promise<T>;
 278: };
