 760: type BoundAtTest<R extends SuiteId, K extends SutKeyOf<R>> = {
 761:   (atId: string, title: string, opts: AtTestOptions, body: AtTestBody<R, K>): void;
 762:   (atId: string, title: string, body: AtTestBody<R, K>): void;
 763: };
 764: 
 765: /** `defineEvidenceCapture`, with the binding already applied. */
 766: type BoundDefineEvidenceCapture<R extends SuiteId, K extends SutKeyOf<R>> = <T>(
 767:   name: string,
 768:   producer: (ctx: AtContext<R, K>) => Promise<T>,
 769: ) => EvidenceCapture<T, R, K>;
