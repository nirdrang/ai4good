 509: /**
 510:  * One acceptance test's whole lifecycle: run the body, tear everything down, then decide.
 511:  *
 512:  * WHY THE VERDICT LIVES HERE rather than in a `finally` that swallows teardown rejections â€”
 513:  * which is what this used to do: a world whose teardown rejected did NOT release what it holds,
 514:  * so the next id inherits it. Reporting that as green is a false green of the worst kind, because
 515:  * the damage lands on a different test and the report blames the wrong id.
 516:  *
 517:  * When the body already failed, the body's error still wins the report: it is the more specific
 518:  * fact, and a teardown that rejects because the body left the world half-built is a symptom, not
 519:  * the cause. The teardown failures are printed so they are never invisible.
 520:  */
 521: export async function runTrackedTest(
 522:   atId: string,
 523:   run: () => Promise<void>,
 524:   worlds: TrackedTeardown[],
 525:   harnesses: TrackedTeardown[],
 526: ): Promise<void> {
 527:   let bodyFailed = false;
 528:   let bodyError: unknown;
 529:   try {
 530:     await run();
 531:   } catch (err) {
 532:     bodyFailed = true;
 533:     bodyError = err;
 534:   }
 535: 
 536:   const failures = await drainTeardowns(worlds, harnesses);
 537: 
 538:   if (bodyFailed) {
 539:     for (const failure of failures) {
 540:       console.error(`${atId} â€” teardown ALSO failed (${failure.what}): ${errorText(failure.error)}`);
 541:     }
 542:     throw bodyError;
 543:   }
 544: 
 545:   if (failures.length) {
 546:     const summary = failures.map((failure) => `${failure.what}: ${errorText(failure.error)}`).join('; ');
 547:     throw new AggregateError(
 548:       failures.map((failure) => (failure.error instanceof Error ? failure.error : new Error(errorText(failure.error)))),
 549:       `${atId} INVALID â€” the body passed but ${failures.length} teardown${failures.length === 1 ? '' : 's'} failed, ` +
 550:         `so state this test built leaks into the next id: ${summary}`,
 551:     );
 552:   }
 553: }
