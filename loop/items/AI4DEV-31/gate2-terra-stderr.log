 468: /** One thing a test built and must give back, named so a failure says which one. */
 469: export interface TrackedTeardown {
 470:   /** plain words for the thing being torn down, e.g. `fixture world "req-016/base"` */
 471:   what: string;
 472:   teardown(): Promise<void>;
 473: }
