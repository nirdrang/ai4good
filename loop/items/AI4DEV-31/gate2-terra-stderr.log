 620: /**
 621:  * THE ONE PLACE the AT id's requirement and the binding's requirement are made to agree.
 622:  *
 623:  * They are two independent strings that must denote the same suite: the id decides which fixture
 624:  * adapter `createHarness()` loads at RUN time (`openWorld` passes `parsed.requirement` straight
 625:  * through), while the binding decides which adapter the TYPES were read off at compile time. Left
 626:  * unchecked, `AT-017.03` registered through a suite bound to `req-016` would drive req-017's
 627:  * implementation while every type in the body described req-016's, and both halves would look fine.
 628:  *
 629:  * The formats differ and the comparison must normalize, or it would reject every valid suite:
 630:  * `parseAtId('AT-016.01').requirement` is `"016"`, whereas the binding and the registry key are
 631:  * `"req-016"`.
 632:  *
 633:  * The field stays MANDATORY. Making the check fire only when a requirement happens to be supplied
 634:  * would reopen the hole through the door marked convenience â€” so a binding with no requirement is
 635:  * its own error, not a skipped check.
 636:  */
 637: export function requirementMismatch(atId: string, parsedRequirement: string, bound: string): string | null {
 638:   if (!bound) {
 639:     return (
 640:       `${atId} was registered with no requirement â€” atTest cannot check that the suite whose types ` +
 641:       `were used is the suite whose fixture adapter will be loaded. Bind the suite with ` +
 642:       `bindSuite({ requirement: 'req-${parsedRequirement}', sut: â€¦ }).`
 643:     );
 644:   }
 645:   const fromId = `req-${parsedRequirement}`;
 646:   if (fromId === bound) return null;
 647:   return (
 648:     `${atId} was registered through a suite bound to ${bound} â€” at run time the harness would load ` +
 649:     `${fromId}'s fixture adapter, because the requirement comes from the AT id, while the ` +
 650:     `type-check described ${bound}'s. One id, one suite: correct the id or correct the binding.`
 651:   );
 652: }
