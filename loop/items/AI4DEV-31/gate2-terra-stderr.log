  22: // nowhere else. The harness types take a requirement and a sut key rather than a system-under-test
  23: // shape precisely so that annotating a body cannot widen the seam; see `SeamOpenWorld` in
  24: // `harness/registry.ts` for the attack that forced it.
  25: export type AtContext = HarnessAtContext<'req-016', 'notifications'>;
