  82:   /** the requirement this suite tests, e.g. 'req-016' */
  83:   requirement: R;
  84:   /** which member of `harness.sut` the whole suite drives, e.g. 'notifications' */
  85:   sut: K;
  86:   /** the suite's own words for "the implementation has not landed yet" */
  87:   sutMissingDetail?: string;
  88: }
  89: 
  90: export interface Registration extends ParsedAtId {
  91:   title: string;
  92:   surface: Surface;
  93: }
  94: 
  95: const registrations = new Map<string, Registration>();
  96: 
  97: /** Everything registered in the modules loaded so far. `--wired` selects the ui-marked ids. */
  98: export function registeredTests(): Registration[] {
  99:   return [...registrations.values()];
 100: }
