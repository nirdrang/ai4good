 136: /* ----------------------------------------------------------------------- the harness */
 137: 
 138: /**
 139:  * What `createHarness()` hands a suite. A suite names its own system-under-test map and world
 140:  * type; everything else is the same for all thirty of them.
 141:  *
 142:  * A TYPE ALIAS, NOT AN INTERFACE, and that is load-bearing. An interface is open to declaration
 143:  * merging, so a suite could write `declare module './contracts.ts' { interface AtHarness { auditLog?: string[] } }`
 144:  * and then read `h.auditLog` with a green type-check, against a harness that supplies no such thing.
 145:  * The member being OPTIONAL is what makes it slip through: `createHarness()` still satisfies its
 146:  * annotation, so nothing anywhere goes red. That is the same lie a free harness type parameter used
 147:  * to permit, arriving by a different door and needing no `any` and no suppression. A type alias
 148:  * cannot be merged into, so this door is shut, and `tests/at/typeprobes/` keeps the attack on file
 149:  * as an executable negative test.
 150:  *
 151:  * EVERY CAPABILITY CONTRACT IN THIS FILE IS AN ALIAS FOR THE SAME REASON. Closing only the type
 152:  * below left the identical attack open one level down, and worse there: `sentinels`, `faults`,
 153:  * `static` and `vendors` come from `pendingCapability<T>()`, which casts a Proxy `as T`, so a
 154:  * merged-in member did not break `index.ts` even when it was REQUIRED â€” where the same member added
 155:  * to this type fails with TS2741. `ConfigRegistry` in `config.ts` is an alias for the same reason.
 156:  *
 157:  * So the rule is: contracts are type aliases, never interfaces. It covers everything reachable from
 158:  * the harness object AND the objects `open()` hands a test body â€” `OpenWorld`, `AtContext` and
 159:  * `WorldLike` in `registry.ts` obey it for the same reason these do. `WorldLike` was briefly
 160:  * excluded as belonging to AI4DEV-31's seam; that conflated two different defects. The suite's `W`
 161:  * being an unverified claim was AI4DEV-31's, and that item has since closed it: the seam types are derived from the
 162:  * fixture adapter that produces them, so a suite can no longer name either one. The interface being augmentable is
 163:  * this one â€” and `w` is handed to the body exactly as `h` is.
 164:  *
 165:  * `tests/at/typeprobes/` carries an attack for every protected type, and
 166:  * `type-invention.selftest.ts` fails by name if any of them becomes an interface again.
 167:  */
 168: export type AtHarness<Sut = Record<string, unknown>, W extends WorldSeam = WorldSeam, Channel extends string = string> = {
 169:   tier: Tier;
 170:   /**
 171:    * Capability names this harness STUBBED for the running tier (e.g. 'vendors.email',
 172:    * 'sut.notifications'). MUST be empty above `loop` â€” otherwise an integration-tier run,
 173:    * which is the /pm-done gate, can silently stub the thing it is gating.
 174:    */
 175:   stubbedCapabilities(): Promise<string[]>;
 176:   clock: Clock;
 177:   fixtures: Fixtures<W>;
 178:   sentinels: Sentinels;
 179:   faults: Faults;
 180:   static: StaticScan;
 181:   config: ConfigRegistry;
 182:   vendors: Vendors<Channel>;
 183:   sut: Sut;
 184:   /** REQUIRED, not optional: frozen clocks, vendor counters and fault state leak without it */
 185:   teardown(): Promise<void>;
 186: };

