 741:         // built at run time really is the one that module's `createFixtureAdapter()` returned. That
 742:         // holds unless somebody casts inside `index.ts` or mutates the adapter after it is built â€”
 743:         // both trusted-author escapes this item does not claim to close.
 744:         return opened as OpenWorld<R, K>;
 745:       },
 746:       capture: async (evidence) => {
 747:         const value = await evidence.consume(ctx);
 748:         usage.captures += 1;
 749:         return value;
 750:       },
 751:     };
 752: 
 753:     await runTrackedTest(atId, () => executeRegisteredBody(atId, body, ctx, usage), worlds, harnesses);
 754:   });
 755: };
