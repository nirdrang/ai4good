 612: 
 613: function emitRuntimeRegistration(registration: Registration): void {
 614:   const dir = process.env.AT_REGISTRATION_DIR;
 615:   if (!dir) return;
 616:   mkdirSync(dir, { recursive: true });
 617:   appendFileSync(join(dir, `registration-${process.pid}.jsonl`), `${JSON.stringify(registration)}\n`, 'utf8');
 618: }
