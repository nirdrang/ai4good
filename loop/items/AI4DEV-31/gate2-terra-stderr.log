  56: /** Surface is an axis independent of tier: one authored body, driven through different drivers. */
  57: export type Surface = 'backend' | 'ui' | 'skill';
  58: 
  59: /**
  60:  * What a suite may vary PER TEST.
  61:  *
  62:  * Neither the requirement nor the system-under-test key is here any more. Both come from the
  63:  * binding, and both now determine TYPES (`SutOf` / `WorldOf`), so a per-test override would let one
  64:  * test in a suite describe a different seam from the one its neighbours describe â€” which is the
  65:  * drift this whole item exists to make impossible.
  66:  */
  67: export interface AtTestOptions {
  68:   /** `ui` marks the test as part of a wiring leaf's `--wired` re-run selection */
  69:   surface?: Surface;
  70: }
  71: 
  72: /**
  73:  * WHICH SUITE THIS IS. The two facts a suite supplies, and the only two it is allowed to supply.
  74:  *
  75:  * `requirement` is a key of `suite-adapters.ts`'s registry, so it is not a free string: a
  76:  * requirement with no registered adapter cannot be bound at all. `sut` is constrained to the keys
  77:  * that adapter really exposes, so a misspelling is a compile error instead of a run-time
  78:  * `sut-missing`. Everything else about the seam â€” the system under test's shape and the fixture
  79:  * world's shape â€” is DERIVED from those two, never stated.
  80:  */
