===== tests/at/harness/type-invention.selftest.ts =====
   1: /**
   2:  * The type-invention attacks, kept dead by an executable test rather than by memory.
   3:  *
   4:  * AI4DEV-24 exists to make `bun run typecheck` mean something. The thing that would quietly undo it
   5:  * is a suite declaring members no runtime value supplies and reading them green â€” a type-check that
   6:  * lies, which is worse than no type-check at all because it is believed.
   7:  *
   8:  * Two families live here now. AI4DEV-24's is HARNESS invention: a suite declaring seams
   9:  * `createHarness()` never produces. AI4DEV-31's is SUT-AND-WORLD invention: a suite declaring what
  10:  * its system under test and its fixture world are, when the adapter that really supplies them says
  11:  * otherwise. None of the attacks needs `any` and none needs a suppression, so grepping for those
  12:  * would not have caught any of them.
  13:  *
  14:  * THE PROBES ARE COMPILED PER FILE, not only as one program, and that is load-bearing. A combined
  15:  * exit code is satisfied by ANY error anywhere: a protection could be removed and the suite would
  16:  * stay green on the strength of its neighbours' diagnostics. Each probe file therefore has its own
  17:  * committed child config, and each protection is asserted against the output of the file that
  18:  * attacks it.
  19:  */
  20: 
  21: import { spawnSync } from 'node:child_process';
  22: import { describe, expect, it } from 'vitest';
  23: 
  24: import { INSTALL_ROOT } from './check.ts';
  25: import { pinnedTsc } from '../typecheck.ts';
  26: 
  27: const PROBE_PROJECT = 'tests/at/typeprobes/tsconfig.json';
  28: /** AI4DEV-31's attacks in the API that ALLOWED them â€” the red half of that item's proof. */
  29: const LEGACY_SEAM_PROJECT = 'tests/at/typeprobes/tsconfig.sut-seam-legacy.json';
  30: /** AI4DEV-31's attacks in the API that REPLACED it â€” only meaningful after the change. */
  31: const SEAM_PROJECT = 'tests/at/typeprobes/tsconfig.sut-seam.json';
  32: 
  33: interface ProbeRun {
  34:   status: number | null;
  35:   output: string;
  36:   /** every file tsc actually put in the program â€” the control against an empty-program exit 0 */
  37:   files: string[];
  38: }
  39: 
  40: function typecheckProbes(project: string): ProbeRun {
  41:   // The same pinned compiler `bun run typecheck` uses. A negative test is only meaningful if the
  42:   // compiler rejecting the attack is the compiler that will check everything else.
  43:   //
  44:   // `--listFiles` is not decoration: a tsconfig that matches NO files also exits 0 and reports
  45:   // nothing, so "the attack was rejected" and "the attack was never compiled" are indistinguishable
  46:   // without it. Every per-file assertion below leans on `compiled()` to rule that out.
  47:   const result = spawnSync(
  48:     process.execPath,
  49:     [pinnedTsc(INSTALL_ROOT), '--noEmit', '--pretty', 'false', '--listFiles', '-p', project],
  50:     { cwd: INSTALL_ROOT, encoding: 'utf8' },
  51:   );
  52:   if (result.error) throw new Error(`could not run the compiler over ${project}: ${result.error.message}`);
  53:   const raw = `${result.stdout ?? ''}${result.stderr ?? ''}`;
  54:   const lines = raw.split('\n');
  55:   // `--listFiles` interleaves the program's files with the diagnostics. The listed files are
  56:   // ABSOLUTE, while diagnostics name their file relative to the cwd and their continuation lines are
  57:   // indented â€” so the leading drive letter separates the two without guessing at message text.
  58:   const isListedFile = (line: string) => /^[A-Za-z]:[\\/]/.test(line);
  59:   return {
  60:     status: result.status,
  61:     output: lines.filter((line) => !isListedFile(line)).join('\n'),
  62:     files: lines.filter(isListedFile).map((line) => line.trim()),
  63:   };
  64: }
  65: 
  66: /** Did tsc really read this probe? Guards every assertion below against a program matching nothing. */
  67: function compiled(run: ProbeRun, probeFile: string): boolean {
  68:   return run.files.some((file) => file.endsWith(probeFile));
  69: }
  70: 
  71: /**
  72:  * TypeScript reports a blocked merge two different ways: `TS2300 Duplicate identifier 'X'` for a
  73:  * single clash, and one `TS6200` listing every identifier when a file has several at once. Both are
  74:  * the rejection these tests assert, so either is accepted â€” matching only the first form would make
  75:  * a test pass or fail on how many attacks happen to share a file.
  76:  */
  77: function rejects(output: string, name: string): boolean {
  78:   if (output.includes(`Duplicate identifier '${name}'`)) return true;
  79:   return output
  80:     .split('\n')
  81:     .filter((line) => line.includes('conflict with those in another file:'))
  82:     .some((line) => line.split(':').pop()!.split(',').some((entry) => entry.trim() === name));
  83: }
  84: 
  85: describe('harness invention is rejected by the compiler', () => {
  86:   const probe = typecheckProbes(PROBE_PROJECT);
  87: 
  88:   it('compiles the probes it claims to check', () => {
  89:     // The empty-program control. A config that matches nothing exits 0 and says nothing, so without
  90:     // this every assertion below could be passing because the attack was never read.
  91:     expect(compiled(probe, 'harness-invention.probe.ts'), `${PROBE_PROJECT} did not compile the probe file`).toBe(true);
  92:   });
  93: 
  94:   it('the probe program does not compile â€” if it ever does, an attack has reopened', () => {
  95:     expect(
  96:       probe.status,
  97:       `${PROBE_PROJECT} compiled clean. Every construct in it is a way for a suite to declare harness ` +
  98:         `members the factory never produces; a green run means one of them is legal again and the ` +
  99:         `type-check is once more able to promise a runtime shape nothing establishes.\n${probe.output}`,
 100:     ).not.toBe(0);
 101:   });
 102: 
 103:   it('rejects a harness type invented through an intersection', () => {
 104:     // `AtHarness & { auditLog }` is a SUBTYPE of AtHarness, so it satisfies any `extends` constraint.
 105:     // The defence is that the harness is not a type parameter at all â€” hence an arity error.
 106:     expect(probe.output, 'the intersection attack was not rejected by arity').toContain('TS2558');
 107:   });
 108: 
 109:   /**
