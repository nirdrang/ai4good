 589:   try {
 590:     expect(h.tier, `harness built tier "${h.tier}" for a --tier ${TIER} run`).toBe(TIER);
 591: 
 592:     // Tier semantics: above `loop`, nothing the suite leans on may be a stand-in.
 593:     if (TIER !== 'loop') {
 594:       expect(await h.stubbedCapabilities(), `a ${TIER}-tier run stubbed capabilities â€” the gate would be grading a stand-in`).toEqual([]);
 595:     }
 596: 
 597:     const sut = h.sut?.[o.sutKey];
 598:     if (!sut) throw new AtPending(o.atId, 'sut-missing', o.sutMissing);
 599: 
 600:     const w = await h.fixtures.world(o.fixture);
 601:     return { opened: { h, w, sut }, harness: h };
 602:   } catch (err) {
 603:     await h.teardown().catch(() => undefined);
 604:     throw err;
 605:   }
 606: }
