  36: // (`bindSuite<NotificationsSut, World>`), and that was two independent statements about one thing:
  37: // this file said what the seam is, `_fixture.ts` built what the seam is, and nothing compared them
  38: // - so any pair of type arguments type-checked green and a body could read members no adapter
  39: // supplies. Both shapes are now DERIVED from the adapter registered under 'req-016' in
  40: // `harness/suite-adapters.ts`, which is the module that really answers `open()`. There is one
  41: // statement, made where it is already checked, and no type argument left to disagree with it.
  42: export const { atTest, defineEvidenceCapture } = bindSuite({
  43:   requirement: 'req-016',
  44:   sut: 'notifications',
  45:   sutMissingDetail:
  46:     `REQ-016's notification emitter is not implemented â€” harness.sut.notifications is absent ` +
  47:     `(loop/decomp/req-016.md D1.L1 "one shared emitter is the sole writer" has not landed)`,
  48: });

