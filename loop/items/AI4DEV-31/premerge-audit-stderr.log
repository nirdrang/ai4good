  94:   'req-016': typeof import('../suites/req-016/_fixture.ts');
  95: }>;
  96: 
  97: /** Every requirement that has a registered adapter. A suite outside this set cannot bind. */
  98: export type SuiteId = keyof AdapterModules & string;
  99: 
 100: /** What the adapter's factory really returns, awaited â€” the single source for everything below. */
