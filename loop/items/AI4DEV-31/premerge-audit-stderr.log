 145:   emit(req: { type: string; ctx?: Record<string, unknown> }): Promise<EmitResult>;
 146:   events(filter?: { type?: string }): Promise<NotificationEvent[]>;
 147:   deliveries(filter?: { type?: string }): Promise<Delivery[]>;
 148:   opsItems(filter?: { linkedEventId?: string }): Promise<OpsItem[]>;
