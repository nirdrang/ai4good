   1: /**
   2:  * THE DEFECT AI4DEV-31 CLOSES, WRITTEN IN THE API THAT ALLOWED IT â€” and kept for ever.
   3:  *
   4:  * Every statement below is an attack in the form a suite could write on the PRE-FIX tree, where
   5:  * `bindSuite<Sut, W>` and `defineEvidenceCapture<T, Sut, W>` took the suite's OWN type arguments and
   6:  * `open()` relabelled the harness's `unknown` sut and its `WorldSeam` world with them. Nothing
   7:  * checked that the adapter supplied either shape, so all four attacks below compiled clean and read
   8:  * members that do not exist at run time.
   9:  *
  10:  * THAT IS WHY THIS FILE IS HERE RATHER THAN IN THE COMMIT MESSAGE. At the pre-fix commit it compiles
  11:  * with EXIT 0 under its own config (`tsconfig.sut-seam-legacy.json`), and that transcript â€” the hole
  12:  * executed rather than described â€” is `loop/items/AI4DEV-31/proof-red.txt`. After the fix the same
  13:  * file, compiled by the same command, must FAIL. A claim of "it fails now" without a recorded "it
  14:  * passed before" is not evidence, and this item is entirely about evidence.
  15:  *
  16:  * It is compiled ALONE, by a child config listing only this file, for two reasons the whole-program
  17:  * probe cannot serve: `typeprobes/tsconfig.json` is expected to fail as a whole, so its exit code
  18:  * can never isolate one attack; and `harness-invention.probe.ts`'s `declare module` blocks are
  19:  * program-wide, so anything sharing a program with them inherits diagnostics that have nothing to do
  20:  * with this seam.
  21:  *
  22:  * `type-invention.selftest.ts` asserts each attack below by name, per file, so a regression names
  23:  * itself instead of hiding inside a combined exit code.
  24:  */
  25: 
  26: import { defineEvidenceCapture, bindSuite } from '../harness/registry.ts';
  27: import type { NotificationsSut, World } from '../suites/req-016/_contract.ts';
  28: 
  29: /**
  30:  * A world shape the REQ-016 adapter does not produce. It satisfies `W extends WorldLike` because it
  31:  * carries `teardown()` â€” the constraint only ever asked for that much, so ANY superset passed.
  32:  */
  33: type FabricatedWorld = {
  34:   teardown(): Promise<void>;
  35:   inventedByTheSuite: string;
  36: };
  37: 
  38: /* ------------------------------------------- ATTACK A: fabricate the SUT through bindSuite */
  39: 
  40: /**
  41:  * The suite declares a system under test with a method the adapter never exposes, and reads it off
  42:  * `open().sut`. `openWorld()` really produced `unknown` here (`h.sut[key]` on a concrete `AtHarness`)
  43:  * and the cast at the end of `open()` relabelled it with whatever the suite asked for.
  44:  */
  45: export const fabricatedSutViaBindSuite = bindSuite<{ notThere(): Promise<void> }, World>({
  46:   sut: 'notifications',
  47: });
  48: 
  49: fabricatedSutViaBindSuite('AT-016.90', 'reads a sut member no adapter supplies', async ({ open }) => {
  50:   const { sut } = await open();
  51:   await sut.notThere();
  52: });
  53: 
  54: /* ----------------------------------------- ATTACK B: fabricate the world through bindSuite */
  55: 
  56: /**
  57:  * The same lie on the other axis. `h.fixtures.world()` really produced `WorldSeam` â€” teardown and
  58:  * nothing else â€” and the suite's `W` renamed it, so a member the fixture world never defines was
  59:  * readable with a green type-check.
  60:  */
  61: export const fabricatedWorldViaBindSuite = bindSuite<NotificationsSut, FabricatedWorld>({
  62:   sut: 'notifications',
  63: });
  64: 
  65: fabricatedWorldViaBindSuite('AT-016.91', 'reads a world member no fixture supplies', async ({ open }) => {
  66:   const { w } = await open();
  67:   void w.inventedByTheSuite.length;
  68: });
  69: 
  70: /* ------------------------------- ATTACK C: the same two, through the evidence-capture door */
  71: 
  72: /**
  73:  * `bindSuite` was never the only entrance. `defineEvidenceCapture<T, Sut, W>` handed its producer a
  74:  * full `AtContext<Sut, W>`, so a suite that never called `bindSuite` at all could declare both
  75:  * shapes and read them green â€” the identical defect, one import further along.
  76:  */
  77: export const fabricatedThroughEvidenceCapture = defineEvidenceCapture<
  78:   string,
  79:   { notThere(): Promise<string> },
  80:   FabricatedWorld
  81: >('a capture that invents both axes', async ({ open }) => {
  82:   const { sut, w } = await open();
  83:   return `${await sut.notThere()}${w.inventedByTheSuite}`;
  84: });
