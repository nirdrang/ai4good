 105: 
 106: /** The keys a suite may legally bind to. A misspelling is a compile error, not a run-time `sut-missing`. */
 107: export type SutKeyOf<R extends SuiteId> = keyof SutMapOf<R> & string;
 108: 
 109: /** The system under test at one key, exactly as the adapter declares it. */
 110: export type SutOf<R extends SuiteId, K extends SutKeyOf<R>> = SutMapOf<R>[K];
 111: 
 112: /**
 113:  * The world the adapter's `fixtures.world()` really produces.
