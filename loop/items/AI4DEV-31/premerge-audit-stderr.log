    const hookFailure = totals({
      numTotalTests: 1,
      numPassedTests: 1,
      numFailedTests: 0,
      testResults: [
        {
          name: 'C:\\tmp\\tree\\tests\\at\\suites\\req-900\\a-green.test.ts',
          status: 'failed',
          message: '',
          assertionResults: [{ status: 'passed' }],
