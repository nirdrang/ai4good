 113:     {
 114:       ok: true,
 115:       accountId: result?.account_id ?? caller.id,
 116:       accountType: result?.account_type ?? accountType,
 117:       organizationId: result?.organization_id ?? null,
 118:     },
 119:     200,
 120:   );
 121: }));

