 151: /**
 152:  * REQ-001's accounts system under test.
 153:  *
 154:  * The split is the point. `completeSignup` and `createOrganization` are the two PRODUCT OPERATIONS
 155:  * â€” at loop tier the adapter runs them over its own storage but delegates every judgement to
 156:  * `supabase/functions/_shared/accounts.ts`, the module the edge functions import; at integration
 157:  * tier they would be the deployed edge functions. Everything else here is either Supabase Auth's
 158:  * half (registration and sign-in, which are not this leaf's code) or read-back.
 159:  */
 160: export type AccountsSut = {
 161:   /** AT-001.07's second clause: which types the PUBLIC signup surface offers. */
 162:   publicSignupAccountTypes(): Promise<readonly string[]>;
 163: 
 164:   /* --- Supabase Auth's half. Not this leaf's code; it is what produces a session to complete. --- */
 165: 
 166:   /** Register an auth user with an email and a password, and return the resulting session. */
 167:   registerWithEmailPassword(email: string, password: string): Promise<Session>;
 168:   /**
 169:    * A session Auth recorded as having come from an external provider.
 170:    *
 171:    * It performs NO handshake and fabricates no authorization code or token exchange: it is the state
 172:    * Auth is in AFTER a consent round trip, which is the only part of the story any agent can reach.
 173:    */
 174:   registerWithProvider(provider: SessionProvider, email: string): Promise<Session>;
 175:   /**
 176:    * A GitHub OAuth signup, as Auth records it: a session established by GitHub whose account already
 177:    * carries the linked GitHub identity â€” AT-001.02's "signs up via GitHub OAuth".
 178:    *
 179:    * Like `registerWithProvider` it performs NO handshake. It is `registerWithProvider('github', â€¦)`
 180:    * plus the fact that a GitHub signup necessarily links the GitHub identity it signed up with, and
 181:    * it is a separate member rather than an argument because that second half is what AT-001.02's
 182:    * "the GitHub identity is linked to it" clause is about.
 183:    */
 184:   registerWithGithub(email: string, githubHandle: string): Promise<Session>;
 185:   /**
 186:    * The state Auth is in after a `linkIdentity` round trip â€” AT-001.04's "linking completes signup".
 187:    *
 188:    * A LINKED IDENTITY IS NOT THE ESTABLISHING PROVIDER, and keeping the two apart is the point of
 189:    * this member existing at all: an email- or Google-established volunteer links GitHub and their
 190:    * session's `provider` does not change. The gate in
 191:    * `supabase/functions/_shared/accounts.ts` reads the link; nothing shipped reads the provider.
 192:    *
 193:    * Same posture as every other Auth member here â€” no handshake, no fabricated authorization code.
 194:    */
 195:   linkGithubIdentity(session: Session, githubHandle: string): Promise<void>;
 196:   /** Return sign-in with the same credentials â€” AT-001.01's final clause. */
 197:   signInWithEmailPassword(email: string, password: string): Promise<SignInOutcome>;
 198:   /**
 199:    * The return visit through an external provider â€” AT-001.02's "a later sign-in via GitHub returns
 200:    * to the same account".
 201:    *
 202:    * What it asserts is IDENTITY CONTINUITY, which is the half of that clause reachable without a
 203:    * person: an existing user whose account carries that provider's identity signs in to the SAME
 204:    * account rather than to a second one. The consent round trip itself is not performed and is named
 205:    * unproved in the plan's per-id table.
 206:    */
 207:   signInWithProvider(provider: SessionProvider, email: string): Promise<SignInOutcome>;
 208: 
 209:   /* ----------------------------------- the two product operations ----------------------------- */
 210: 
 211:   /** `supabase/functions/complete-signup` â€” turns an authenticated auth user into a typed account. */
 212:   completeSignup(session: Session, request: CompleteSignupRequest, ip: string): Promise<CompleteSignupOutcome>;
 213:   /** `supabase/functions/create-organization` â€” the NGO-only action AT-001.06 drives. */
 214:   createOrganization(session: Session, organizationName: string): Promise<CreateOrganizationOutcome>;
 215: 
 216:   /* ------------------------------------------- read-back -------------------------------------- */
 217: 
 218:   account(accountId: string): Promise<AccountRow | null>;
 219:   organization(organizationId: string): Promise<OrganizationRow | null>;
 220:   membership(organizationId: string, accountId: string): Promise<MembershipRow | null>;
 221:   acknowledgments(accountId: string): Promise<AcknowledgmentRow[]>;
 222:   /**
 223:    * The volunteer's imported GitHub profile, or `null` â€” AT-001.05's observable.
 224:    *
 225:    * `null` is a real and asserted answer, not merely the empty case: AT-001.05's pre-completion
 226:    * negative reads it AFTER the identity is linked and BEFORE the signup completes, and requires
 227:    * null there. That is what proves the population is CAUSED by completion rather than sitting in a
 228:    * queue somewhere waiting to be drained.
 229:    */
 230:   volunteerProfile(accountId: string): Promise<VolunteerProfileRow | null>;
 231: 
 232:   /**
 233:    * The two read-backs a REFUSED action needs, which the keyed ones above cannot serve.
 234:    *
 235:    * Asserting that a rejection wrote nothing means looking for rows whose identifiers were never
 236:    * handed out â€” a refused `createOrganization` returns no organisation id. So one search by the
 237:    * name that was attempted, and one listing of everything an account is a member of. Without them
 238:    * the strongest statement available is "the call said no", and an implementation that writes both
 239:    * rows and then says no would satisfy it.
 240:    */
 241:   organizationsNamed(name: string): Promise<OrganizationRow[]>;
 242:   membershipsOf(accountId: string): Promise<MembershipRow[]>;
 243:   /**
 244:    * `public.has_platform_acknowledgment(account_id)` â€” the observable form of AT-001.01's "before
 245:    * any project creation is possible".
 246:    *
 247:    * It MUST DISCRIMINATE: false for an authenticated user who has not completed signup, true after.
 248:    * The body asserts both halves for exactly that reason.
 249:    *
 250:    * WHICH IMPLEMENTATION THAT ASSERTION REACHES depends on the tier, and the difference matters. At
 251:    * loop tier it reaches the fixture adapter's storage query, so what goes green is the RULE and the
 252:    * adapter's storage â€” the shipped SQL function could return true unconditionally and the loop tier
 253:    * would not notice. `public.has_platform_acknowledgment` itself is proved by step 7(h) of the
 254:    * plan, against the live database, and by nothing else in this item.
 255:    *
 256:    * What this leaf cannot do at either tier is ENFORCE the clause â€” nothing in the tree creates a
 257:    * project, and building project creation belongs to another requirement. This is the hook the leaf
 258:    * that lands project creation must call.
 259:    */
 260:   hasPlatformAcknowledgment(accountId: string): Promise<boolean>;
 261: 
 262:   /* ------------------------------------ the provisioned admin --------------------------------- */
 263: 
 264:   /**
 265:    * Provision a `platform_admin` â€” the ONLY legal way one exists, because the public path refuses
 266:    * the type. It sits apart from `completeSignup` rather than being one of its options for that
 267:    * reason.
 268:    *
 269:    * ON THE LIVE STACK THIS IS **NOT** A SERVICE-ROLE WRITE, and the correction matters more than
 270:    * most: this comment used to say it was, and a later reader following it would have granted the
 271:    * service role an INSERT on `public.accounts` â€” a write path straight past `complete_signup`'s
 272:    * `platform_admin` refusal, which is the one guard that sits on the only write path. The service
 273:    * role holds no INSERT anywhere in this schema, by measurement and by decision. Provisioning is a
 274:    * direct database operation by an operator: a NARROWER authority than the service role, not a
 275:    * wider one, and not one any running service holds.
 276:    */
 277:   provisionPlatformAdmin(email: string, password: string): Promise<Session>;
 278: };
