 177: /**
 178:  * The address the request came from â€” AT-001.01 records it on the acknowledgment.
 179:  *
 180:  * `x-forwarded-for` may carry a chain; the FIRST entry is the original client and the rest are
 181:  * proxies. `null` rather than a placeholder when there is nothing to record:
 182:  * `public.acknowledgments` permits a null `ip`, and inventing `0.0.0.0` would put a value in the
 183:  * column that reads like a measurement and is not one.
 184:  *
 185:  * IT IS VALIDATED BEFORE IT LEAVES HERE, because `public.complete_signup`'s fifth parameter is
 186:  * `p_ip inet` and the header is a client-supplied string. An unparseable value made PostgREST fail
 187:  * the cast, which arrived as a 4xx, which `complete-signup` maps to 409 with the database's message
 188:  * â€” so a perfectly well-formed signup was refused with something that read like a signup conflict.
 189:  * Anything that is not a well-formed IPv4 or IPv6 address therefore records nothing at all, which
 190:  * is honest, rather than breaking a signup.
 191:  *
 192:  * THE TRUST BOUNDARY, stated because the column looks like a measurement: this is what the gateway
 193:  * chain REPORTED, and it is NOT authenticated. On any path where no trusted proxy overwrites the
 194:  * header, a caller chooses it. Which entry of the chain a deployment should believe depends on the
 195:  * proxies actually in front of it, which is not observable from this tree; whoever lands the hosted
 196:  * deployment settles it with that chain in view. Until then the acknowledgment records AN address,
 197:  * never a verified source address, and the plan's per-id table says so in those words.
 198:  */
 199: export function callerIp(request: Request): string | null {
 200:   const forwarded = request.headers.get('x-forwarded-for');
 201:   const first = forwarded?.split(',')[0]?.trim();
 202:   if (!first || first === '') return null;
 203:   const candidate = first.startsWith('[') && first.endsWith(']') ? first.slice(1, -1) : first;
 204:   return isIpv4(candidate) || isIpv6(candidate) ? candidate : null;
 205: }
