 207: /** The result of a database function call: its value, or the database's own refusal. */
 208: export type RpcOutcome = { ok: true; value: unknown } | { ok: false; status: number; message: string };
 209: 
 210: /**
 211:  * Call one `public.` function, with the service role, in ONE round trip.
 212:  *
 213:  * One round trip is one implicit transaction, which is the whole reason the signup writes live
 214:  * inside a database function rather than being issued as separate Data API calls from here. Four
 215:  * calls would be four transactions, and a failure partway would leave an account with no
 216:  * organisation, membership or acknowledgment.
 217:  *
 218:  * The service role bypasses row-level security, which is why the database functions perform their
 219:  * own checks: nothing else is standing on this path.
 220:  */
 221: export async function callDatabaseFunction(
 222:   supabaseUrl: string,
 223:   serviceRoleKey: string,
 224:   name: string,
 225:   args: Record<string, unknown>,
 226: ): Promise<RpcOutcome> {
 227:   const response = await fetch(`${supabaseUrl}/rest/v1/rpc/${name}`, {
 228:     method: 'POST',
 229:     headers: {
 230:       'content-type': 'application/json',
 231:       apikey: serviceRoleKey,
 232:       Authorization: `Bearer ${serviceRoleKey}`,
 233:     },
 234:     body: JSON.stringify(args),
 235:   });
 236: 
 237:   const text = await response.text();
 238:   if (!response.ok) {
 239:     // PostgREST wraps a raised exception as `{ message, code, details, hint }`. The message is the
 240:     // sentence the database function chose, so it is passed through rather than replaced with a
 241:     // generic one â€” those functions raise sentences precisely so a caller can act on them.
 242:     let message = text;
 243:     try {
 244:       const body = JSON.parse(text) as { message?: unknown };
 245:       if (typeof body.message === 'string') message = body.message;
 246:     } catch {
 247:       // A non-JSON body from PostgREST means something other than a raised exception went wrong;
 248:       // the raw text is then the most informative thing available.
 249:     }
 250:     return { ok: false, status: response.status, message };
 251:   }
 252: 
 253:   return { ok: true, value: text === '' ? null : (JSON.parse(text) as unknown) };
 254: }
 255: 
 256: /** Read a JSON request body, or refuse â€” a malformed body must not read as an empty one. */
 257: export async function readJsonBody(request: Request): Promise<{ ok: true; value: Record<string, unknown> } | { ok: false; reason: string }> {
 258:   let text: string;
 259:   try {
 260:     text = await request.text();
 261:   } catch {
 262:     return { ok: false, reason: 'the request body could not be read' };
 263:   }
 264:   if (text.trim() === '') return { ok: true, value: {} };
 265:   try {
 266:     const parsed = JSON.parse(text) as unknown;
 267:     if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) {
 268:       return { ok: false, reason: 'the request body must be a JSON object' };
 269:     }
 270:     return { ok: true, value: parsed as Record<string, unknown> };
 271:   } catch {
 272:     return { ok: false, reason: 'the request body is not valid JSON' };
 273:   }
 274: }
   1: /**
