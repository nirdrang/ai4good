  93:  * THE STATS ARE THE STUB IMPORT FIXTURE'S, NOT GITHUB'S. `stubGithubStatsFor` in
  94:  * `supabase/functions/_shared/github.ts` produces them, the decomposition manifest's cross-contract
  95:  * ratifies that stand-in ("stub import fixture until W3"), and no code in this item calls
  96:  * api.github.com. What the row proves is that onboarding FIRED and landed POPULATED â€” the
  97:  * criterion's "a queued-but-empty import fails this test" â€” and not that any statistic is real.
  98:  */
  99: export type VolunteerProfileRow = {
 100:   accountId: string;
 101:   /** the handle of the GitHub identity linked to the account â€” AT-001.05's "linked handle" */
 102:   githubHandle: string;
 103:   /** AT-001.05's "top languages"; never empty, in the schema by CHECK and here by assertion */
 104:   topLanguages: string[];
