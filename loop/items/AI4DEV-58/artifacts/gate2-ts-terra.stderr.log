 156: function isIpv4(value: string): boolean {
 157:   const parts = value.split('.');
 158:   return parts.length === 4 && parts.every((part) => /^\d{1,3}$/.test(part) && Number(part) <= 255);
 159: }
 160: 
 161: function isIpv6(value: string): boolean {
 162:   if (value.split('::').length > 2) return false;
 163:   const abbreviated = value.includes('::');
 164:   const groups = value.split(':').filter((group) => group !== '');
 165:   if (groups.length === 0) return abbreviated; // `::` itself
 166:   const last = groups[groups.length - 1];
 167:   // `::ffff:127.0.0.1` is a legal IPv6 address whose final element is a dotted IPv4 and occupies
 168:   // two of the eight groups.
 169:   const trailingIpv4 = last.includes('.');
 170:   if (trailingIpv4 && !isIpv4(last)) return false;
 171:   const hexGroups = trailingIpv4 ? groups.slice(0, -1) : groups;
 172:   if (!hexGroups.every((group) => /^[0-9a-fA-F]{1,4}$/.test(group))) return false;
 173:   const count = hexGroups.length + (trailingIpv4 ? 2 : 0);
 174:   return abbreviated ? count < 8 : count === 8;
 175: }
