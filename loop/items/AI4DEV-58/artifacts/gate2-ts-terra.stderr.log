  48:   id: string;
  49:   accountType: AccountType;
  50: };
  51: 
  52: /** One row of `public.organizations`. */
  53: export type OrganizationRow = {
  54:   id: string;
  55:   name: string;
  56: };
  57: 
  58: /** One row of `public.org_memberships` â€” the per-NGO role, which is NOT the global account type. */
  59: export type MembershipRow = {
  60:   organizationId: string;
  61:   accountId: string;
  62:   role: 'admin' | 'member';
  63: };
  64: 
  65: /**
  66:  * One row of `public.acknowledgments` â€” EXACTLY the three fields AT-001.01 names recorded, plus the
