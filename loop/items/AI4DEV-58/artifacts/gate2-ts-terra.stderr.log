   1: -- REQ-001 D1.L1 â€” accounts, organizations, memberships and the platform acknowledgment.
   2: --
   3: -- The first product migration in this repository. It lands exactly what four acceptance criteria
   4: -- need â€” AT-001.01, .03, .06 and .07 â€” and deliberately nothing else. Structure for the other 33
   5: -- P0 ids of REQ-001 arrives with the leaves that test it; a column nothing enforces looks like a
   6: -- requirement being met and is not one.
   7: --
   8: -- WHAT IS DELIBERATELY ABSENT, so a reader does not read the absence as an oversight:
   9: --   * no trigger on `auth.users`. The account row is created by the `complete-signup` edge
  10: --     function. A user who authenticated but never completed signup is a real and honest state â€”
  11: --     it is literally what AT-001.04 tests for â€” and a trigger here would be a footgun whose
  12: --     failure mode is a 500 inside Supabase Auth.
  13: --   * no lifecycle / deactivation column. AT-001.29-31 need a gate every write route registers
  14: --     through, which is another leaf's work; a flag nothing reads enforces nothing.
  15: --   * no name / title / authority-attestation columns on `acknowledgments`. Those are AT-001.19's
  16: --     fields and belong to the acknowledgment-identity deliverable.
  17: --   * no tenant-isolation policy set. Row-level security is ENABLED on all four tables and the
  18: --     policies added are only the ones this leaf's own tests need. Everything else stays denied,
  19: --     which is both the minimal change and the safe default.
  20: 
  21: /* ============================================================ the two closed vocabularies ==== */
  22: 
  23: -- Mirrors `ACCOUNT_TYPES` in `supabase/functions/_shared/accounts.ts`. Two statements of one fact,
  24: -- and this is the one that wins: `complete_signup` below re-checks the type itself rather than
  25: -- trusting the TypeScript, so an omitted or regressed `parseAccountType` still cannot mint an
  26: -- administrator.
  27: create type public.account_type as enum ('ngo', 'volunteer', 'platform_admin');
  28: 
  29: -- The PER-NGO role, which is a different axis from the global account type. "NGO admin" means the
  30: -- admin role in THAT NGO (AT-001.36), so it is held on the membership and never on the account.
  31: create type public.org_role as enum ('admin', 'member');
  32: 
  33: /* ========================================================================== the four tables ==== */
  34: 
  35: -- ONE ROW PER AUTH USER. The primary key IS the auth user's id, which is what makes "one account
  36: -- holds exactly one global type" structural rather than a rule somebody remembers to apply. There
  37: -- is no second row to hold a second type, and no path that could write one.
  38: create table public.accounts (
  39:   id uuid primary key references auth.users (id) on delete cascade,
  40:   account_type public.account_type not null,
  41:   created_at timestamptz not null default now()
  42: );
  43: 
  44: comment on table public.accounts is
  45:   'One row per authenticated user, holding exactly one global account type (REQ-001, AT-001.01/.06/.07).';
  46: 
  47: create table public.organizations (
  48:   id uuid primary key default gen_random_uuid(),
  49:   name text not null check (length(btrim(name)) > 0),
  50:   created_at timestamptz not null default now()
  51: );
  52: 
  53: -- The composite primary key is the multi-NGO invariant in structural form: one row per
  54: -- (organisation, account) pair, so an account can belong to several organisations with a different
  55: -- role in each, and cannot hold two roles in one. AT-001.16 and AT-001.36 test the behaviour that
  56: -- rests on this; neither is landed here.
  57: create table public.org_memberships (
  58:   org_id uuid not null references public.organizations (id) on delete cascade,
  59:   account_id uuid not null references public.accounts (id) on delete cascade,
  60:   role public.org_role not null,
  61:   created_at timestamptz not null default now(),
  62:   primary key (org_id, account_id)
  63: );
  64: 
  65: -- EXACTLY the three fields AT-001.01 names recorded â€” timestamp, IP and text version â€” beside the
  66: -- account and the kind that identify the acknowledgment.
  67: --
  68: -- `text_version` carries a non-empty CHECK, and that constraint is load-bearing rather than
  69: -- decorative: an acknowledgment that does not say WHICH text was accepted records nothing, and the
  70: -- constraint is also what the atomicity proof in `loop/items/AI4DEV-57/proof-local.ts` uses to make
  71: -- `complete_signup` fail on its LAST write after its first three have succeeded.
  72: create table public.acknowledgments (
  73:   id uuid primary key default gen_random_uuid(),
  74:   account_id uuid not null references public.accounts (id) on delete cascade,
  75:   kind text not null check (length(btrim(kind)) > 0),
  76:   acknowledged_at timestamptz not null default now(),
  77:   ip inet,
  78:   text_version text not null check (length(btrim(text_version)) > 0)
  79: );
  80: 
  81: create index acknowledgments_account_id_kind_idx on public.acknowledgments (account_id, kind);
  82: 
  83: /* ================================================================ the acknowledgment predicate == */
  84: 
  85: -- AT-001.01 requires the acknowledgment "before any project creation is possible", and no projects
  86: -- table exists in this tree. This predicate is the OBSERVABLE FORM of that clause: the leaf that
  87: -- lands project creation calls it, and until then it is the hook and nothing more.
  88: --
  89: -- IT DISCRIMINATES, and the acceptance test asserts both halves â€” false for an authenticated user
  90: -- who has not completed signup, true for one who has. A `return true` implementation would FAIL
  91: -- AT-001.01 rather than satisfy it. What this leaf cannot do is ENFORCE the clause; saying so here
  92: -- keeps the predicate's existence from implying otherwise.
  93: create function public.has_platform_acknowledgment(p_account_id uuid)
  94: returns boolean
  95: language sql
  96: stable
  97: security definer
  98: set search_path = ''
  99: as $$
 100:   select exists (
 101:     select 1
 102:       from public.acknowledgments
 103:      where account_id = p_account_id
 104:        and kind = 'platform_tos_and_promise'
 105:   );
 106: $$;
 107: 
 108: comment on function public.has_platform_acknowledgment(uuid) is
 109:   'True once the account has accepted the ToS + Platform Promise (REQ-001, AT-001.01). The gate that consumes it lands with project creation.';
 110: 
 111: /* ============================================================= the one transactional write path == */
 112: 
 113: -- ALL FOUR WRITES, OR NONE.
 114: --
 115: -- The signup completion writes an account row, and for an NGO an organisation and an `admin`
 116: -- membership, and an acknowledgment. Performed as separate Data API calls those would be four
 117: -- separate transactions, and a partial failure would leave an account with no organisation,
 118: -- membership or acknowledgment â€” a state no acceptance criterion describes and nothing would ever
 119: -- repair. A single function call is one round trip and one implicit transaction, which is what
 120: -- makes "in one transaction" true rather than merely stated.
 121: --
 122: -- IT RE-CHECKS THE ACCOUNT TYPE ITSELF AND RAISES ON `platform_admin`. That duplicates a check
 123: -- `parseAccountType` in `supabase/functions/_shared/accounts.ts` already makes, and the duplication
 124: -- is the point: it is written down here so a later reader does not delete it as redundant.
 125: --
 126: -- Why the duplication is needed at all, stated exactly, because an earlier version of this
 127: -- reasoning was wrong. Row-level security is NOT in the signup path: the public edge function must
 128: -- write with the service role, and the service role bypasses row-level security entirely. So the
 129: -- missing insert policy stops a browser holding the public key and stops NOTHING on the path that
 130: -- actually writes. Before this check, `parseAccountType` was the only thing between an anonymous
 131: -- HTTP request and a minted platform administrator. This check lives in the database, sits on the
 132: -- only write path, and does not depend on the edge function's TypeScript.
 133: create function public.complete_signup(
 134:   p_account_id uuid,
 135:   p_account_type text,
 136:   p_organization_name text,
 137:   p_acknowledgment_text_version text,
 138:   p_ip inet
 139: )
 140: returns jsonb
 141: language plpgsql
 142: -- SECURITY DEFINER, and this is what makes the guard below MEAN something.
 143: --
 144: -- Measured on the replayed database: `service_role` holds no SELECT and no INSERT on any of these
 145: -- four tables. It has BYPASSRLS, which is why it is easy to assume it can do anything, and it
 146: -- cannot â€” row-level security and table privileges are different mechanisms and only the first is
 147: -- bypassed. So a SECURITY INVOKER function called with the service role fails on its first insert,
 148: -- and both edge functions would have been broken against the real database.
 149: --
 150: -- The fix could have been `grant insert on â€¦ to service_role`, and that would have been worse. It
 151: -- would give the service role a direct write path into `public.accounts`, so anyone holding that
 152: -- key could write `account_type = 'platform_admin'` straight into the table and never come near the
 153: -- refusal below â€” and the whole point of that refusal is that it sits on the ONLY write path.
 154: -- Running as the owner instead, with no table privileges granted to the service role at all, is
 155: -- what makes "the only write path" literally true.
 156: --
 157: -- `set search_path = ''` is mandatory on a definer function and every name below is
 158: -- schema-qualified for it. Without it, a caller who can create objects in a schema earlier in the
 159: -- path can make this function resolve their table instead of ours, while running as the owner.
 160: security definer
 161: set search_path = ''
 162: as $$
 163: declare
 164:   v_account_type public.account_type;
 165:   v_organization_id uuid := null;
 166: begin
 167:   -- THE INDEPENDENT GUARD. Named before the general enum check so the refusal says the right thing:
 168:   -- `platform_admin` is not an unknown type, it is a real one that this path may never produce.
 169:   if p_account_type = 'platform_admin' then
 170:     raise exception
 171:       'complete_signup refuses account type platform_admin: a platform administrator is provisioned, never self-signed-up'
 172:       using errcode = '42501';
 173:   end if;
 174: 
 175:   if p_account_type is null or p_account_type not in ('ngo', 'volunteer') then
 176:     raise exception 'complete_signup refuses account type %: public signup offers ngo or volunteer',
 177:       coalesce(p_account_type, '<null>')
 178:       using errcode = '22023';
 179:   end if;
 180: 
 181:   v_account_type := p_account_type::public.account_type;
 182: 
 183:   if v_account_type = 'ngo' and (p_organization_name is null or length(btrim(p_organization_name)) = 0) then
 184:     raise exception 'complete_signup refuses an NGO completion with no organisation name'
 185:       using errcode = '22023';
 186:   end if;
 187: 
 188:   if v_account_type = 'volunteer' and p_organization_name is not null then
 189:     raise exception 'complete_signup refuses an organisation name on a volunteer completion: one account holds exactly one global type'
 190:       using errcode = '22023';
 191:   end if;
 192: 
 193:   -- (1) the account. The primary key does the "already completed" refusal on its own; catching it
 194:   -- turns a raw unique-violation into a sentence a caller can pass on.
 195:   begin
 196:     insert into public.accounts (id, account_type)
 197:     values (p_account_id, v_account_type);
 198:   exception
 199:     when unique_violation then
 200:       raise exception 'complete_signup refuses %: this account has already completed signup', p_account_id
 201:         using errcode = '23505';
 202:   end;
 203: 
 204:   -- (2) and (3) the organisation and its admin membership, for an NGO only.
 205:   if v_account_type = 'ngo' then
 206:     insert into public.organizations (name)
 207:     values (btrim(p_organization_name))
 208:     returning id into v_organization_id;
 209: 
 210:     insert into public.org_memberships (org_id, account_id, role)
 211:     values (v_organization_id, p_account_id, 'admin');
 212:   end if;
 213: 
 214:   -- (4) the ToS + Platform Promise acknowledgment.
 215:   --
 216:   -- RECORDED FOR BOTH ACCOUNT TYPES, and this is a reading of the plan rather than a copy of it.
 217:   -- AT-001.01 states the criterion for an NGO, but the completion request requires an
 218:   -- acknowledgment text version from every caller (see `validateCompleteSignup`), and requiring a
 219:   -- field and then discarding it for one of the two types is not defensible: it would mean a
 220:   -- volunteer accepted the terms and the platform kept no record of which terms. The organisation
 221:   -- and the membership stay NGO-only.
 222:   insert into public.acknowledgments (account_id, kind, ip, text_version)
 223:   values (p_account_id, 'platform_tos_and_promise', p_ip, p_acknowledgment_text_version);
 224: 
 225:   return jsonb_build_object(
 226:     'account_id', p_account_id,
 227:     'account_type', v_account_type,
 228:     'organization_id', v_organization_id
 229:   );
 230: end;
 231: $$;
