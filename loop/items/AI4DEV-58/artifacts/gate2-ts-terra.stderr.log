 282: /**
 283:  * What REQ-001's fixture world adds to the shared seam.
 284:  *
 285:  * An INTERSECTION, not `interface World extends WorldSeam`, for the alias reason above.
 286:  *
 287:  * One member, and it earns its place: every test in this suite registers auth users, and two tests
 288:  * that happened to pick the same address would interfere in a way that looks like a product defect.
 289:  * `email()` namespaces an address to the world that issued it, so isolation is structural rather
 290:  * than a convention each body has to remember.
 291:  */
 292: export type World = WorldSeam & {
 293:   /** a mail address unique to THIS world, e.g. `email('ngo')` */
 294:   email(local: string): string;
 295: };
   1: /**
   2:  * REQ-001's fixture adapter â€” STORAGE ONLY. Every judgement is the shipped module's.
   3:  *
   4:  * READ THIS BEFORE TRUSTING A GREEN FROM THIS SUITE, because the honest claim is narrower than
   5:  * "REQ-001 works" and wider than what most acceptance adapters can say.
   6:  *
   7:  * `adapterDerivedCapability()` in `tests/at/harness/capabilities.ts` stamps every `sut.<key>` a
   8:  * STAND-IN unconditionally, and the registry refuses a stand-in above the loop tier. So nothing here
   9:  * can reach the integration-tier run that is the evidence gate. What a loop-tier green from this
  10:  * suite means is exactly this:
  11:  *
  12:  *   - PROVED: the decisions in `supabase/functions/_shared/accounts.ts` and
  13:  *     `supabase/functions/_shared/github.ts` â€” the modules the two edge functions import, byte for
  14:  *     byte the code that ships â€” behave as the seven acceptance criteria this suite lands require.
  15:  *     Every accept and every refusal below comes from those modules, and so does the onboarding
  16:  *     import's content. There is no second copy of the rules in this file, deliberately: the moment
  17:  *     there is one, this suite is grading a puppet and the green is worth nothing.
  18:  *   - NOT PROVED: that the migration is correct, that either edge function works, that row-level
  19:  *     security denies what it should, that Supabase Auth is configured, or that Google sign-in
  20:  *     works. None of that is reachable from here â€” the storage below is a Map. The evidence for
  21:  *     that half is `loop/items/AI4DEV-57/proof-local.txt`, which was produced against the live
  22:  *     local stack on one machine and EXISTS: 14 checks, 13 passed, 0 failed, one skipped. The skip
  23:  *     is the Google handshake, because no OAuth credential was in the environment â€” so "Google
  24:  *     sign-in works" is not proved by the live tier either, and no amount of green anywhere in this
  25:  *     item proves it. A reviewer cannot reproduce that transcript; it is one machine's word.
  26:  *
  27:  * WHAT THE STORAGE HALF DOES MIRROR, because a stand-in that mirrors nothing tests nothing: one
  28:  * account row per auth user (so "one account holds exactly one global type" is structural here as it
  29:  * is in the schema, not a rule the adapter remembers), and completion is all-or-nothing (so a body
  30:  * asserting no partial state is asserting the same shape the database's `complete_signup` function
  31:  * guarantees). It mirrors the SHAPE; the database's own guarantee is proved on the live stack.
  32:  */
  33: 
  34: import type { FixtureWorld, FixtureWorldStore } from '../../harness/fixtures.ts';
  35: import {
  36:   PLATFORM_ACKNOWLEDGMENT_KIND,
  37:   PUBLIC_SIGNUP_ACCOUNT_TYPES,
  38:   ngoOnlyActionAllowed,
  39:   validateCompleteSignup,
  40:   validateOrganizationName,
  41:   type AccountType,
  42:   type CompleteSignupRequest,
  43: } from '../../../../supabase/functions/_shared/accounts.ts';
  44: // The IMPORT SOURCE is the shipped stub, not a copy living in this file. AT-001.05 compares the
  45: // profile it reads back against `stubGithubStatsFor`, so if the two were separate implementations
  46: // the test would grade the fixture's copy and say nothing about what the edge function writes.
  47: import { stubGithubStatsFor } from '../../../../supabase/functions/_shared/github.ts';
  48: import type {
  49:   AccountRow,
  50:   AccountsSut,
  51:   AcknowledgmentRow,
  52:   CompleteSignupOutcome,
  53:   CreateOrganizationOutcome,
  54:   MembershipRow,
  55:   OrganizationRow,
  56:   Session,
  57:   SessionProvider,
  58:   SignInOutcome,
