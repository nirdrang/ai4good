 260: create function public.create_organization(
 261:   p_account_id uuid,
 262:   p_name text
 263: )
 264: returns jsonb
 265: language plpgsql
 266: -- SECURITY DEFINER for the same measured reason as `complete_signup`: the service role has no
 267: -- INSERT on `public.organizations` or `public.org_memberships`, so an invoker function would fail
 268: -- on its first write.
 269: security definer
 270: set search_path = ''
 271: as $$
 272: declare
 273:   v_organization_id uuid;
 274:   v_account_type public.account_type;
 275: begin
 276:   if p_name is null or length(btrim(p_name)) = 0 then
 277:     raise exception 'create_organization refuses an empty organisation name'
 278:       using errcode = '22023';
 279:   end if;
 280: 
 281:   -- THE BACKSTOP. It fires only on a call that did not come through the edge function, because the
 282:   -- edge function refuses a non-NGO caller before ever reaching here.
 283:   select account_type into v_account_type
 284:     from public.accounts
 285:    where id = p_account_id;
 286: 
 287:   if v_account_type is null then
 288:     raise exception 'create_organization refuses %: no account has completed signup for this user', p_account_id
 289:       using errcode = '23503';
 290:   end if;
 291: 
 292:   if v_account_type <> 'ngo' then
 293:     raise exception 'create_organization refuses account type %: creating an organisation is an NGO-only action', v_account_type
 294:       using errcode = '42501';
 295:   end if;
 296: 
 297:   insert into public.organizations (name)
 298:   values (btrim(p_name))
 299:   returning id into v_organization_id;
 300: 
 301:   insert into public.org_memberships (org_id, account_id, role)
 302:   values (v_organization_id, p_account_id, 'admin');
 303: 
 304:   return jsonb_build_object('organization_id', v_organization_id);
 305: end;
 306: $$;
