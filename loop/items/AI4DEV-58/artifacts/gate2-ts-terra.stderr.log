  62: 
  63: /**
  64:  * WHICH REQUIREMENT THIS ADAPTER IS, declared by the adapter itself.
  65:  *
  66:  * `harness/suite-adapters.ts` constrains its map entry to match this literal, and `loadAdapter()` in
  67:  * `harness/index.ts` re-checks it against the requirement it was asked for. Without it the
  68:  * type-check could describe one suite while the run drove another.
  69:  */
  70: export const requirement = 'req-001' as const;
  71: 
  72: interface AdapterOptions {
  73:   worlds: FixtureWorldStore;
  74: }
  75: 
  76: /** An auth user as Supabase Auth holds one: credentials and the provider that established them. */
  77: interface AuthUser {
  78:   id: string;
  79:   email: string;
  80:   password: string | null;
  81:   provider: SessionProvider;
  82:   /**
  83:    * The handle of a LINKED GitHub identity, or null â€” Auth's `identities[]` narrowed to the one
  84:    * field anything here reads.
  85:    *
  86:    * It is stored on the auth user and NOT on the session, which is the whole reason the gate is a
  87:    * caller fact: linking happens after a session exists, changes nothing about how that session was
  88:    * established, and is a property of the user Auth answers for.
  89:    */
  90:   githubHandle: string | null;
  91: }
  92: 
  93: interface StoredAcknowledgment extends AcknowledgmentRow {}
  94: 
  95: interface State {
  96:   authUsers: Map<string, AuthUser>;
  97:   /** email -> auth user id, because sign-in arrives with an address rather than an id */
  98:   byEmail: Map<string, string>;
  99:   accounts: Map<string, AccountRow>;
 100:   organizations: Map<string, OrganizationRow>;
 101:   /** `${organizationId}:${accountId}` -> row */
 102:   memberships: Map<string, MembershipRow>;
 103:   acknowledgments: StoredAcknowledgment[];
 104:   /** account id -> the imported volunteer profile, mirroring `public.volunteer_profiles`'s primary key */
 105:   volunteerProfiles: Map<string, VolunteerProfileRow>;
 106:   nextId: number;
 107: }
 108: 
 109: function membershipKey(organizationId: string, accountId: string): string {
 110:   return `${organizationId}:${accountId}`;
 111: }
 112: 
 113: function clone<T>(value: T): T {
 114:   return structuredClone(value);
 115: }
