 168:       // person. AT-001.03's other clause â€” "sign-in via Google succeeds on return visits" â€” is a
 169:       // real consent round trip, is NOT proved by this test or anywhere in this item, and is named
 170:       // unproved in the plan's per-id table and in the merge ruling.
 171:       const googleSession = await sut.registerWithProvider('google', w.email('google-ngo'));
