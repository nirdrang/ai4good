 137:   if (value.split('::').length > 2) return false;
 138:   const abbreviated = value.includes('::');
 139:   const groups = value.split(':').filter((group) => group !== '');
 140:   if (groups.length === 0) return abbreviated; // `::` itself
 141:   const last = groups[groups.length - 1];
 142:   // `::ffff:127.0.0.1` is a legal IPv6 address whose final element is a dotted IPv4 and occupies
 143:   // two of the eight groups.
 144:   const trailingIpv4 = last.includes('.');
 145:   if (trailingIpv4 && !isIpv4(last)) return false;
 146:   const hexGroups = trailingIpv4 ? groups.slice(0, -1) : groups;
 147:   if (!hexGroups.every((group) => /^[0-9a-fA-F]{1,4}$/.test(group))) return false;
