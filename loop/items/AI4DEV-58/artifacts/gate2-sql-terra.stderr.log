 117: /** What arrives on the wire â€” every field `unknown`, because it came from a client. */
 118: export type CompleteSignupRequest = {
 119:   accountType?: unknown;
 120:   organizationName?: unknown;
 121:   acknowledgmentTextVersion?: unknown;
