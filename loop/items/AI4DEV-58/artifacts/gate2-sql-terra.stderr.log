  68: /* ====================================================== the write path, recreated with the gate == */
  69: 
  70: -- THE DROP IS LOAD-BEARING, not tidiness.
  71: --
  72: -- `create function` with a new signature would OVERLOAD `public.complete_signup` rather than replace
  73: -- it, and PostgREST refuses an rpc name it cannot resolve to one function â€” the deployed edge
  74: -- function would start failing on a name that had worked for months, with an error about ambiguity
  75: -- that says nothing about this migration. Dropping first and recreating is one statement pair in one
  76: -- migration, which is one transaction: there is no window in which no `complete_signup` exists.
  77: --
  78: -- THE ONLY CALLER IS UPDATED IN THE SAME CHANGE. `supabase/functions/complete-signup/index.ts` is
  79: -- the sole caller of this function in the tree, and it passes the four new parameters as of this
  80: -- item. Nothing else in the repository names it.
  81: --
  82: -- The privileges go with the dropped function and are re-granted below, which is why the revoke and
  83: -- grant statements are repeated rather than assumed to survive: they do not.
  84: drop function public.complete_signup(uuid, text, text, text, inet);
  85: 
  86: -- EVERYTHING THE FIRST VERSION DID, UNCHANGED, PLUS THE VOLUNTEER GITHUB BRANCH.
  87: --
  88: -- Every refusal the previous version raised is reproduced here word for word â€” the `platform_admin`
  89: -- guard, the unknown-type refusal, the NGO-name rules, the already-completed refusal â€” because a
  90: -- recreation is an opportunity to lose behaviour silently and the acceptance suite's four existing
  91: -- green ids would not all notice. What is NEW is the volunteer branch's four-parameter requirement,
  92: -- the identity backstop, and the profile insert that joins the same transaction.
  93: --
  94: -- ALL WRITES, OR NONE, still. The account, the organisation and membership for an NGO, the imported
  95: -- profile for a volunteer, and the acknowledgment are one round trip and therefore one implicit
  96: -- transaction. That is what makes "queued-but-empty is impossible" structural: there is no moment at
  97: -- which a volunteer account exists without its profile, because the two rows land together or
  98: -- neither lands.
  99: create function public.complete_signup(
 100:   p_account_id uuid,
 101:   p_account_type text,
 102:   p_organization_name text,
 103:   p_acknowledgment_text_version text,
 104:   p_ip inet,
 105:   p_github_handle text,
 106:   p_github_top_languages text[],
 107:   p_github_repository_count integer,
 108:   p_github_contribution_summary text
 109: )
 110: returns jsonb
 111: language plpgsql
 112: -- SECURITY DEFINER for the measured reason the first migration states at length: `service_role`
 113: -- holds no INSERT on any table in this schema, so an invoker function would fail on its first write,
 114: -- and granting it INSERT instead would open a direct write path around the refusals below. That
 115: -- reasoning is unchanged and applies to `public.volunteer_profiles` exactly as it does to the other
 116: -- four tables â€” the service role has no INSERT there either.
 117: --
 118: -- `set search_path = ''` is mandatory on a definer function and every name below is
 119: -- schema-qualified for it, INCLUDING `auth.identities`.
 120: security definer
 121: set search_path = ''
 122: as $$
 123: declare
 124:   v_account_type public.account_type;
 125:   v_organization_id uuid := null;
 126:   v_github_handle text := btrim(p_github_handle);
 127: begin
 128:   -- THE INDEPENDENT GUARD. Named before the general enum check so the refusal says the right thing:
 129:   -- `platform_admin` is not an unknown type, it is a real one that this path may never produce.
 130:   if p_account_type = 'platform_admin' then
 131:     raise exception
 132:       'complete_signup refuses account type platform_admin: a platform administrator is provisioned, never self-signed-up'
 133:       using errcode = '42501';
 134:   end if;
 135: 
 136:   if p_account_type is null or p_account_type not in ('ngo', 'volunteer') then
 137:     raise exception 'complete_signup refuses account type %: public signup offers ngo or volunteer',
 138:       coalesce(p_account_type, '<null>')
 139:       using errcode = '22023';
 140:   end if;
 141: 
 142:   v_account_type := p_account_type::public.account_type;
 143: 
 144:   if v_account_type = 'ngo' and (p_organization_name is null or length(btrim(p_organization_name)) = 0) then
 145:     raise exception 'complete_signup refuses an NGO completion with no organisation name'
 146:       using errcode = '22023';
 147:   end if;
 148: 
 149:   if v_account_type = 'volunteer' and p_organization_name is not null then
 150:     raise exception 'complete_signup refuses an organisation name on a volunteer completion: one account holds exactly one global type'
 151:       using errcode = '22023';
 152:   end if;
 153: 
 154:   /* ------------------------------------------------------- the volunteer GitHub link and import */
 155: 
 156:   if v_account_type = 'volunteer' then
 157:     -- (a) the link itself. This is the database's own statement of AT-001.04, and it is not the
 158:     -- user-facing one: `validateCompleteSignup` in `supabase/functions/_shared/accounts.ts` refuses
 159:     -- the same completion first, with the sentence a person reads. This one exists for the caller
 160:     -- that never went through the edge function at all.
 161:     if v_github_handle is null or length(v_github_handle) = 0 then
 162:       raise exception
 163:         'complete_signup refuses a volunteer completion with no linked GitHub handle: linking a GitHub account is required to complete volunteer signup'
 164:         using errcode = '42501';
 165:     end if;
 166: 
 167:     -- (b) THE BACKSTOP, AND IT BINDS THE HANDLE RATHER THAN MERELY ASKING WHETHER ONE EXISTS.
 168:     --
 169:     -- Checking only that SOME GitHub identity is linked would answer a different question from the
 170:     -- one the row records. The row records A SPECIFIC HANDLE, so an existence-only check leaves
 171:     -- exactly this gap: a service-role caller supplies a linked account id together with a
 172:     -- DIFFERENT handle and non-empty stats, and a profile commits under a handle the account never
 173:     -- linked. The edge-function path can never exercise that gap â€” it derives the handle from the
 174:     -- same identity it checks â€” so no test driving the edge function would have found it.
 175:     --
 176:     -- `identity_data->>'user_name'` is GoTrue's field for the GitHub login, and this is the SECOND
 177:     -- of the two places in this repository that read it; the first is `extractGithubHandle` in
 178:     -- `supabase/functions/_shared/github.ts`. If that field ever turns out to be spelled
 179:     -- differently when a real OAuth app first arrives, the change is a two-place change: the
 180:     -- extractor, and a follow-up migration recreating this function.
 181:     if not exists (
 182:       select 1
 183:         from auth.identities
 184:        where user_id = p_account_id
 185:          and provider = 'github'
 186:          and identity_data->>'user_name' = v_github_handle
 187:     ) then
 188:       raise exception
 189:         'complete_signup refuses volunteer %: no GitHub identity with handle % is linked to this auth user',
 190:         p_account_id, v_github_handle
 191:         using errcode = '42501';
 192:     end if;
 193: 
 194:     -- (c) the import must have arrived POPULATED. Raised in the function body as well as enforced by
 195:     -- the table's CHECK constraints, so a caller gets a stated reason it can act on rather than a
 196:     -- bare constraint violation naming a constraint it has never heard of.
 197:     --
 198:     -- `cardinality(...) < 1` catches the empty array; the `is null` disjunct catches a missing one.
 199:     -- See the table's own comment for why `array_length` would have caught neither.
 200:     if p_github_top_languages is null or cardinality(p_github_top_languages) < 1 then
 201:       raise exception
 202:         'complete_signup refuses a volunteer completion whose imported top languages are missing or empty: a queued-but-empty import is not an import'
 203:         using errcode = '22023';
 204:     end if;
 205: 
 206:     if p_github_repository_count is null or p_github_repository_count < 0 then
 207:       raise exception
 208:         'complete_signup refuses a volunteer completion whose imported repository count is missing or negative'
 209:         using errcode = '22023';
 210:     end if;
 211: 
 212:     if p_github_contribution_summary is null or length(btrim(p_github_contribution_summary)) = 0 then
 213:       raise exception
 214:         'complete_signup refuses a volunteer completion whose imported contribution summary is missing or empty'
 215:         using errcode = '22023';
 216:     end if;
 217:   else
 218:     -- THE MIRROR OF THE ORGANISATION-NAME RULE. GitHub import parameters on an NGO completion mean
 219:     -- the caller and the server disagree about what is being created, and silently dropping them
 220:     -- would let that disagreement reach the database as a missing row instead of surfacing as a
 221:     -- refusal.
 222:     if p_github_handle is not null
 223:        or p_github_top_languages is not null
 224:        or p_github_repository_count is not null
 225:        or p_github_contribution_summary is not null then
 226:       raise exception
 227:         'complete_signup refuses GitHub import parameters on a % completion: the GitHub link and its onboarding import belong to volunteer signup',
 228:         v_account_type
 229:         using errcode = '22023';
 230:     end if;
 231:   end if;
 232: 
 233:   -- (1) the account. The primary key does the "already completed" refusal on its own; catching it
 234:   -- turns a raw unique-violation into a sentence a caller can pass on.
 235:   begin
 236:     insert into public.accounts (id, account_type)
 237:     values (p_account_id, v_account_type);
 238:   exception
 239:     when unique_violation then
 240:       raise exception 'complete_signup refuses %: this account has already completed signup', p_account_id
 241:         using errcode = '23505';
 242:   end;
 243: 
 244:   -- (2) and (3) the organisation and its admin membership, for an NGO only.
 245:   if v_account_type = 'ngo' then
 246:     insert into public.organizations (name)
 247:     values (btrim(p_organization_name))
 248:     returning id into v_organization_id;
 249: 
 250:     insert into public.org_memberships (org_id, account_id, role)
 251:     values (v_organization_id, p_account_id, 'admin');
 252:   end if;
 253: 
 254:   -- (3b) the volunteer's imported GitHub profile, for a volunteer only â€” AT-001.05's "onboarding
 255:   -- fires". It is written HERE, between the account and the acknowledgment, because that is what
 256:   -- makes the firing part of the completion rather than a consequence of it: there is no queue, no
 257:   -- job and no second request, so the profile is observable the instant completion returns.
 258:   if v_account_type = 'volunteer' then
 259:     insert into public.volunteer_profiles (
 260:       account_id, github_handle, top_languages, repository_count, contribution_summary
 261:     )
 262:     values (
 263:       p_account_id,
 264:       v_github_handle,
 265:       p_github_top_languages,
 266:       p_github_repository_count,
 267:       btrim(p_github_contribution_summary)
 268:     );
 269:   end if;
 270: 
 271:   -- (4) the ToS + Platform Promise acknowledgment.
 272:   --
 273:   -- RECORDED FOR BOTH ACCOUNT TYPES, and this is a reading of the plan rather than a copy of it.
 274:   -- AT-001.01 states the criterion for an NGO, but the completion request requires an
 275:   -- acknowledgment text version from every caller (see `validateCompleteSignup`), and requiring a
 276:   -- field and then discarding it for one of the two types is not defensible: it would mean a
 277:   -- volunteer accepted the terms and the platform kept no record of which terms. The organisation
 278:   -- and the membership stay NGO-only.
 279:   --
 280:   -- IT STAYS LAST, and that placement is depended upon: the atomicity proof makes this write fail
 281:   -- after the earlier ones have succeeded, which is how "all or none" is demonstrated rather than
 282:   -- asserted. A volunteer profile inserted above it is part of what must disappear.
 283:   insert into public.acknowledgments (account_id, kind, ip, text_version)
 284:   values (p_account_id, 'platform_tos_and_promise', p_ip, p_acknowledgment_text_version);
 285: 
 286:   return jsonb_build_object(
 287:     'account_id', p_account_id,
 288:     'account_type', v_account_type,
 289:     'organization_id', v_organization_id
 290:   );
 291: end;
 292: $$;
 293: 
 294: comment on function public.complete_signup(uuid, text, text, text, inet, text, text[], integer, text) is
 295:   'The one transactional signup-completion write path (REQ-001, AT-001.01/.03/.04/.05). All rows or none; refuses platform_admin, and refuses a volunteer completion whose GitHub identity is not linked with the handle it claims.';
