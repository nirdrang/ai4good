 184:       // A CONTROL, not decoration: if the session is not github-established, every clause below is
 185:       // being asserted about some other signup path and the test compares nothing.
 186:       expect(
 187:         session.provider,
 188:         'this test is about a github-established session; if it is not github, nothing below is about AT-001.02',
 189:       ).toBe('github');
