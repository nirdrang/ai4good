 121:  * the cheap answer â€” decode the payload and read `sub` â€” would mean trusting a base64 blob because
 122:  * something upstream is believed to have checked it. So the token is presented to `/auth/v1/user`
 123:  * instead and Auth answers. One extra round trip, no cryptography in our code, and no dependency:
 124:  * `fetch` is enough.
 125:  */
 126: export async function resolveCaller(request: Request, supabaseUrl: string, anonKey: string): Promise<Caller | null> {
 127:   const authorization = request.headers.get('Authorization');
 128:   if (!authorization) return null;
 129: 
 130:   const response = await fetch(`${supabaseUrl}/auth/v1/user`, {
 131:     headers: { Authorization: authorization, apikey: anonKey },
 132:   });
 133:   if (!response.ok) return null;
 134: 
 135:   const user = (await response.json()) as unknown;
 136:   const id = (user as { id?: unknown }).id;
 137:   if (typeof id !== 'string') return null;
 138: 
 139:   // THE ID AND THE LINKED GITHUB HANDLE â€” and still NOT the establishing provider.
 140:   //
 141:   // This is the one-line extension the previous version of this comment reserved for "the leaf that
 142:   // needs either", and it takes exactly one of the two. The GitHub handle is carried because
 143:   // `validateCompleteSignup` gates volunteer completion on it and a client must not be able to
 144:   // assert it; the ADDRESS and the ESTABLISHING PROVIDER are still left behind, because nothing on
 145:   // either path reads them and a `provider` field sitting on this type would be a standing
 146:   // suggestion that email-vs-Google participates in a decision here. It does not â€” that is the whole
 147:   // of what AT-001.03 establishes, and a LINKED identity is a different fact from the one that
 148:   // established the session.
 149:   //
 150:   // `extractGithubHandle` is given the WHOLE response rather than a pre-narrowed field: it does the
 151:   // shape checking, in the pure module the acceptance suite also drives, so the judgement about what
 152:   // counts as a linked GitHub identity has one home.
 153:   return { id, githubHandle: extractGithubHandle(user) };
 154: }
