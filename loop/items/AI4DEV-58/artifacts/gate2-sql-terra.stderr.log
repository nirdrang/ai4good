   1: /**
   2:  * The plumbing both edge functions need: read the environment, answer with JSON, establish WHO is
   3:  * calling, and reach the database.
   4:  *
   5:  * It is deliberately separate from `accounts.ts`. That module holds the DECISIONS and is imported by
   6:  * the acceptance adapter, which puts it inside a strict TypeScript program with `types: ["node"]`
   7:  * and no Deno global â€” so it may contain no I/O and no `Deno` reference. This file is the opposite
   8:  * half: nothing but I/O, Deno-only, and imported by no test. Merging the two would drag `Deno` into
   9:  * the acceptance program and the whole shared-logic arrangement with it.
  10:  *
  11:  * NO TYPE-CHECKER COVERS THIS FILE, and that is stated rather than hoped. `bun run typecheck` runs
  12:  * over the root project (whose `include` is `src/**` plus two config files) and the `tests/at`
  13:  * project (whose `include` is `tests/at/**` plus whatever those files import). Neither reaches an
  14:  * edge-function entry point or this module. What covers them instead is that both functions are
  15:  * served and exercised against the live stack in `loop/items/AI4DEV-57/proof-local.ts` â€” weaker in
  16:  * some ways and stronger in others, and named honestly either way.
  17:  *
  18:  * ONE IMPORT CROSSES INTO THE PURE HALF: `extractGithubHandle` from `./github.ts`. That direction is
  19:  * the safe one and the arrangement is unchanged by it â€” a Deno-only file may import a pure one,
  20:  * while the reverse would drag `Deno` into the strict acceptance program. The judgement about which
  21:  * identity counts as a linked GitHub identity belongs on the pure side, where a test can reach it.
  22:  */
  23: 
  24: import { extractGithubHandle } from './github.ts';
  25: 
  26: /**
  27:  * A required environment variable, or a loud failure at first use.
  28:  *
  29:  * `SUPABASE_SERVICE_ROLE_KEY` is accepted under either of its two names because the CLI has been
  30:  * renaming its key vocabulary â€” newer versions inject `SUPABASE_SECRET_KEY` â€” and a function that
  31:  * boots and then 500s on its first database call because it read `undefined` is much harder to
  32:  * diagnose than one that says which variable it wanted.
  33:  */
  34: export function requireEnv(...names: string[]): string {
  35:   for (const name of names) {
  36:     const value = Deno.env.get(name);
  37:     if (value && value.trim() !== '') return value;
  38:   }
  39:   throw new Error(`none of ${names.join(', ')} is set in this function's environment`);
  40: }
  41: 
  42: /**
  43:  * WHAT A BROWSER IS ALLOWED TO SEND, and why this list is exactly this list.
  44:  *
  45:  * A signup from the app's own origin is a cross-origin authenticated JSON request, so the browser
  46:  * sends a preflight first and refuses to make the real call unless the answer permits the method
  47:  * and every header. `supabase-js`'s `functions.invoke` sends `authorization`, `apikey`,
  48:  * `content-type` and `x-client-info`; omitting any one of them fails the preflight, and the failure
  49:  * surfaces in the browser as a network error with no reason attached.
  50:  *
  51:  * THE ORIGIN IS `*` DELIBERATELY, and it is not a shortcut. An allow-list would need the deployed
  52:  * app origins, which are not knowable from this tree â€” inventing one would be a guess wearing the
  53:  * costume of a security control. It is safe here for a reason specific to these two endpoints:
  54:  * BOTH AUTHENTICATE BY `Authorization` HEADER AND NEITHER READS A COOKIE, so a hostile page that
  55:  * reaches them carries no ambient authority; it would have to already hold the user's access token,
  56:  * and if it holds that it does not need a browser. This is the Supabase standard posture for edge
  57:  * functions. A deployment that later authenticates by cookie must revisit this line first.
  58:  */
  59: const CORS_HEADERS: Record<string, string> = {
  60:   'access-control-allow-origin': '*',
  61:   'access-control-allow-headers': 'authorization, apikey, content-type, x-client-info',
  62:   'access-control-allow-methods': 'POST, OPTIONS',
  63: };
  64: 
  65: export function json(body: unknown, status: number): Response {
  66:   return new Response(JSON.stringify(body), {
  67:     status,
  68:     headers: { ...CORS_HEADERS, 'content-type': 'application/json' },
  69:   });
  70: }
  71: 
  72: /** A refusal a caller can act on: the reason travels, never a bare status. */
  73: export function refusal(reason: string, status: number): Response {
  74:   return json({ ok: false, reason }, status);
  75: }
  76: 
  77: /**
  78:  * The two conventions EVERY entry point here needs, applied once instead of twice.
  79:  *
  80:  *   * THE PREFLIGHT. Both functions refuse any method that is not POST, so without this an
  81:  *     `OPTIONS` would be answered 405 and no browser would ever reach the real call.
  82:  *   * NOTHING ESCAPES AS A BARE STATUS. A rejected `fetch` (Auth or the Data API unreachable) or a
  83:  *     non-JSON success body throws, and an exception out of a `Deno.serve` handler becomes a 500
  84:  *     with no body â€” precisely the case where a caller most needs to tell a refusal from an outage.
  85:  *     Anything thrown becomes a shaped 502 carrying a sentence, which is this file's standing
  86:  *     contract: the reason travels, never a bare status.
  87:  */
  88: export function edgeHandler(
  89:   name: string,
  90:   handler: (request: Request) => Promise<Response>,
  91: ): (request: Request) => Promise<Response> {
  92:   return async (request: Request): Promise<Response> => {
  93:     if (request.method === 'OPTIONS') return new Response(null, { status: 204, headers: CORS_HEADERS });
  94:     try {
  95:       return await handler(request);
  96:     } catch (error) {
  97:       const detail = error instanceof Error ? error.message : String(error);
  98:       return refusal(`${name} could not complete the request: ${detail}`, 502);
  99:     }
 100:   };
 101: }
