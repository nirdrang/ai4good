 297: /* ============================================================================ privilege posture == */
 298: 
 299: -- IDENTICAL TO THE FIRST MIGRATION'S, AND RE-STATED BECAUSE THE DROP TOOK THE OLD ONE WITH IT.
 300: --
 301: -- PostgreSQL grants EXECUTE on a new function to PUBLIC by default and every Data API role inherits
 302: -- that, so the freshly created function above is executable by `anon` until this revoke runs. The
 303: -- first migration found that by measuring with `has_function_privilege` rather than by reasoning,
 304: -- and the same measurement is repeated against this signature in the migration-replay capture.
 305: revoke execute on function public.complete_signup(uuid, text, text, text, inet, text, text[], integer, text) from public;
 306: grant execute on function public.complete_signup(uuid, text, text, text, inet, text, text[], integer, text) to service_role;
 307: 
 308: -- NO GRANT ON `public.volunteer_profiles` TO ANY ROLE. `[api] auto_expose_new_tables` is unset, so
 309: -- the table is unreachable through the Data API entirely â€” stricter than the grant-and-deny-by-policy
 310: -- posture `public.accounts` needs, and appropriate here because nothing client-side reads it yet.
 311: -- The service role writes it only through the definer function above.
 312: 
 313: -- PostgREST caches the schema. Without this, the first call to the recreated function is a 404 from
 314: -- the schema cache rather than a real answer â€” and after a DROP the stale entry would name a
 315: -- signature that no longer exists.
 316: notify pgrst, 'reload schema';

