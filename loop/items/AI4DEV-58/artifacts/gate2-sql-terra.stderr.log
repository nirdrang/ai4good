 430:   atTest(
 431:     'AT-001.05',
 432:     'linking GitHub fires volunteer onboarding with the public stats observably imported',
 433:     async ({ open }) => {
 434:       const { w, sut } = await open();
 435: 
 436:       // WHERE THE STATS COME FROM, STATED BEFORE THEY ARE ASSERTED SO NO GREEN CAN BE MISREAD.
 437:       //
 438:       // `stubGithubStatsFor` is a STUB. It calls nothing, fetches nothing, and reaches no part of
 439:       // GitHub. It is the "stub import fixture until W3" the decomposition manifest's own
 440:       // cross-contract ratifies, and the real import belongs to the volunteer-profile requirement in
 441:       // a later wave. So this test may NEVER be reported as "profile import from GitHub works".
 442:       //
 443:       // ASSERTING THE STUB'S EXACT VALUES IS NEVERTHELESS THE HONEST STRONG ORACLE HERE, because the
 444:       // stub IS the declared source: what the criterion puts under test is that onboarding FIRES and
 445:       // that what it produced arrives POPULATED on the profile, not that any statistic is true of a
 446:       // real person. A weaker "something non-empty is there" would pass against an implementation
 447:       // that wrote a placeholder, which is precisely the "queued-but-empty" state the criterion's
 448:       // last sentence forbids. Both strengths are asserted below: the structural non-emptiness AND
 449:       // the by-value equality.
 450:       const HANDLE = 'riverside-contributor';
 451:       const expected = stubGithubStatsFor(HANDLE);
 452: 
 453:       const session = await sut.registerWithEmailPassword(w.email('volunteer-import'), PASSWORD);
 454:       await sut.linkGithubIdentity(session, HANDLE);
 455: 
 456:       // THE PRE-COMPLETION NEGATIVE. The identity is linked and the signup has NOT completed, and at
 457:       // this instant there must be no profile at all.
 458:       //
 459:       // It is what makes the causal claim testable rather than merely stated. Without it, an
 460:       // implementation that populated the profile at link time â€” or one that had queued an empty row
 461:       // waiting to be filled â€” would satisfy every assertion after the completion below, and the
 462:       // criterion's "when the link completes, onboarding fires" would be untested. With it, the
 463:       // population is provably CAUSED by the completion and nothing sits queued in between.
 464:       expect(
 465:         await sut.volunteerProfile(session.accountId),
 466:         'a profile existed after linking and BEFORE completion â€” the import is not caused by completion, or an empty row is queued',
 467:       ).toBeNull();
 468: 
 469:       const completion = await sut.completeSignup(
 470:         session,
 471:         { accountType: 'volunteer', acknowledgmentTextVersion: TEXT_VERSION },
 472:         CLIENT_IP,
 473:       );
 474:       expect(completion, 'the linked volunteer signup was refused, so onboarding had nothing to fire from').toMatchObject({
 475:         ok: true,
 476:       });
 477:       if (!completion.ok) return;
 478: 
 479:       // IMMEDIATELY â€” the very next read after completion returns, with no retry, no polling and no
 480:       // queue to drain. If the import were deferred to a job, this read would find nothing, which is
 481:       // exactly the failure the criterion's last sentence describes.
 482:       const profile = await sut.volunteerProfile(completion.accountId);
 483:       expect(profile, 'volunteer onboarding did not fire: no profile exists after a linked completion').not.toBeNull();
 484:       if (!profile) return;
 485: 
 486:       // "the linked handle AND the imported public stats â€¦ are observably populated on the profile"
 487:       // â€” all four values, each by its own assertion, because a row with three empty fields in it
 488:       // records nothing while looking like a record.
 489:       expect(profile.githubHandle, 'the profile does not carry the handle that was linked').toBe(HANDLE);
 490: 
 491:       expect(
 492:         profile.topLanguages.length,
 493:         'top languages came back empty â€” a queued-but-empty import fails this test',
 494:       ).toBeGreaterThan(0);
 495:       expect(profile.topLanguages, 'top languages are not what the declared import source produced for this handle').toEqual(
 496:         expected.topLanguages,
 497:       );
 498: 
 499:       expect(
 500:         Number.isInteger(profile.repositoryCount) && profile.repositoryCount >= 0,
 501:         `repository count ${JSON.stringify(profile.repositoryCount)} is not a non-negative whole number of repositories`,
 502:       ).toBe(true);
 503:       expect(profile.repositoryCount).toBe(expected.repositoryCount);
 504: 
 505:       expect(
 506:         profile.contributionSummary.trim(),
 507:         'the contribution summary is blank â€” a queued-but-empty import fails this test',
 508:       ).not.toBe('');
 509:       expect(profile.contributionSummary).toBe(expected.contributionSummary);
 510: 
 511:       // The import landed WITH the account, not merely near it: the account exists, holds the
 512:       // volunteer type, and the acknowledgment of the same completion is recorded. All of it or none
 513:       // of it â€” which is the shape the database's single-transaction write path guarantees and the
 514:       // reason "queued-but-empty" is unrepresentable here rather than merely untested.
 515:       expect(await sut.account(completion.accountId)).toMatchObject({ accountType: 'volunteer' });
 516:       expect(
 517:         await sut.hasPlatformAcknowledgment(completion.accountId),
 518:         'the completion that fired the import recorded no acknowledgment, so the rows did not land together',
 519:       ).toBe(true);
 520:     },
 521:   );
