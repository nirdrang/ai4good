 257: export async function readJsonBody(request: Request): Promise<{ ok: true; value: Record<string, unknown> } | { ok: false; reason: string }> {
 258:   let text: string;
 259:   try {
 260:     text = await request.text();
 261:   } catch {
 262:     return { ok: false, reason: 'the request body could not be read' };
 263:   }
 264:   if (text.trim() === '') return { ok: true, value: {} };
 265:   try {
 266:     const parsed = JSON.parse(text) as unknown;
 267:     if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) {
 268:       return { ok: false, reason: 'the request body must be a JSON object' };
 269:     }
 270:     return { ok: true, value: parsed as Record<string, unknown> };
 271:   } catch {
 272:     return { ok: false, reason: 'the request body is not valid JSON' };
 273:   }
 274: }
