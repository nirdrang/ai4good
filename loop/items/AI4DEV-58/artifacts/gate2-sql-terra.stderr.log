 523:   atTest(
 524:     'AT-001.06',
 525:     'a volunteer is refused the NGO-only action while an NGO account performs it successfully',
 526:     async ({ open }) => {
 527:       const { w, sut } = await open();
 528: 
 529:       // THE CONTROL IS NOT OPTIONAL. A rejection with no working control proves only that the path
 530:       // is broken â€” an operation that refuses everybody would pass the negative half on its own. So
 531:       // the NGO succeeds FIRST, and the volunteer's refusal is then attributable to the account
 532:       // type and to nothing else.
 533:       const ngoSession = await sut.registerWithEmailPassword(w.email('ngo-actor'), 'correct horse battery staple');
 534:       const ngoCompletion = await sut.completeSignup(
 535:         ngoSession,
 536:         { accountType: 'ngo', organizationName: 'Riverside Shelter', acknowledgmentTextVersion: TEXT_VERSION },
 537:         CLIENT_IP,
 538:       );
 539:       expect(ngoCompletion, 'the NGO control could not complete signup').toMatchObject({ ok: true });
 540:       if (!ngoCompletion.ok) return;
 541: 
 542:       const ngoAction = await sut.createOrganization(ngoSession, 'Riverside Shelter Second Programme');
 543:       expect(ngoAction, 'the NGO control was refused the NGO-only action, so the refusal below proves nothing').toMatchObject({
 544:         ok: true,
 545:       });
 546:       if (!ngoAction.ok) return;
 547:       // The control SUCCEEDED, observably: the organisation exists and the actor is its admin.
 548:       expect(await sut.organization(ngoAction.organizationId)).toMatchObject({
 549:         name: 'Riverside Shelter Second Programme',
 550:       });
 551:       expect(await sut.membership(ngoAction.organizationId, ngoCompletion.accountId)).toMatchObject({ role: 'admin' });
 552: 
 553:       // Now the volunteer, driven through THE SAME BOUNDARY â€” the `create-organization` operation,
 554:       // not the helper behind it. Calling `ngoOnlyActionAllowed` here would prove a helper behaves
 555:       // and say nothing about whether the application enforces it.
 556:       const volunteerSession = await sut.registerWithEmailPassword(w.email('volunteer-actor'), PASSWORD);
 557:       // A PRECONDITION, not part of what this test asserts: since the GitHub leaf a volunteer cannot
 558:       // complete signup without a linked GitHub identity. The refusal under test below is the
 559:       // NGO-only one, and it must be attributable to the account type â€” so the volunteer has to
 560:       // reach the state of being a fully signed-up volunteer first. AT-001.04 owns the link rule and
 561:       // tests it; the assertions in this test are unchanged.
 562:       await sut.linkGithubIdentity(volunteerSession, 'volunteer-actor-handle');
 563:       const volunteerCompletion = await sut.completeSignup(
 564:         volunteerSession,
 565:         { accountType: 'volunteer', acknowledgmentTextVersion: TEXT_VERSION },
 566:         CLIENT_IP,
 567:       );
 568:       expect(volunteerCompletion, 'the volunteer could not complete signup, so the refusal below is not the one under test').toMatchObject({
 569:         ok: true,
 570:       });
 571:       if (!volunteerCompletion.ok) return;
 572: 
 573:       const REFUSED_NAME = 'Riverside Shelter Copy';
 574:       const volunteerAction = await sut.createOrganization(volunteerSession, REFUSED_NAME);
 575:       expect(volunteerAction.ok, 'a volunteer account performed an NGO-only action').toBe(false);
 576:       if (volunteerAction.ok) return;
 577: 
 578:       // "THE ACTION IS REJECTED" INCLUDES ITS WRITES NOT HAPPENING. The weakest implementation that
 579:       // passes the assertion above writes the organisation and its membership and then reports a
 580:       // refusal, which is not a rejection â€” it is a success with a rude message. So: the volunteer
 581:       // holds no membership anywhere, and no organisation by the attempted name exists.
 582:       const organizations = await sut.organizationsNamed(REFUSED_NAME);
 583:       expect(organizations, `the refused action created an organisation named ${JSON.stringify(REFUSED_NAME)}`).toEqual([]);
 584:       expect(
 585:         await sut.membershipsOf(volunteerCompletion.accountId),
 586:         'the refused action left the volunteer holding a membership',
 587:       ).toEqual([]);
 588:       // The refusal must STATE why. A bare failure leaves the caller unable to act, and the
 589:       // criterion's own wording â€” "one account holds exactly one global type; the NGO path requires
 590:       // a separate account" â€” is what the reason has to convey.
 591:       expect(volunteerAction.reason).toMatch(/NGO accounts only/i);
 592:       expect(volunteerAction.reason).toMatch(/volunteer/i);
 593:     },
 594:   );
