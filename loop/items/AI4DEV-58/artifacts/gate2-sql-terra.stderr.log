 596:   atTest(
 597:     'AT-001.07',
 598:     'a provisioned platform admin authenticates and carries the type; public signup offers only the two',
 599:     { surface: 'ui' },
 600:     async ({ open }) => {
 601:       const { w, sut } = await open();
 602: 
 603:       // Clause one, at the tier this test actually runs at. Two different strengths of evidence sit
 604:       // in this test and the difference is the whole point of the comment:
 605:       //
 606:       //   - that the public completion path REFUSES to mint a `platform_admin` (the third block) is
 607:       //     a real property of the shipped decision module â€” `validateCompleteSignup` in
 608:       //     `supabase/functions/_shared/accounts.ts`, which this suite imports rather than copies;
 609:       //   - that the type is CARRIED â€” provisioned with it, reads back with it, and a session
 610:       //     resolves to the same account â€” is the ADAPTER'S STORAGE answering, not shipped code.
 611:       //     Provisioning and sign-in are fixture stand-ins here, so this half proves the test is
 612:       //     well-formed and says nothing about the real schema or a real Auth.
 613:       //
 614:       // IT IS NOT A CLAIM THAT AN ADMINISTRATOR REALLY AUTHENTICATES, and this comment used to make
 615:       // one: `provisionPlatformAdmin` writes into a Map two lines below. A real administrator, in a
 616:       // real Auth, really signing in against the real schema is step 7(g) of the plan, on the live
 617:       // stack, and the per-id table assigns that clause there and not here.
 618:       const adminEmail = w.email('platform-admin');
 619:       const adminPassword = 'correct horse battery staple';
 620:       const provisioned = await sut.provisionPlatformAdmin(adminEmail, adminPassword);
 621: 
 622:       const signedIn = await sut.signInWithEmailPassword(adminEmail, adminPassword);
 623:       expect(signedIn, 'the provisioned platform admin could not sign in').toMatchObject({ ok: true });
 624:       if (!signedIn.ok) return;
 625:       expect(signedIn.session.accountId).toBe(provisioned.accountId);
 626:       expect(
 627:         await sut.account(signedIn.session.accountId),
 628:         'the signed-in administrator does not carry the platform_admin global type',
 629:       ).toMatchObject({ accountType: 'platform_admin' });
 630: 
 631:       // Clause two: "the public signup surfaces offer only NGO/volunteer". Exact equality, not
 632:       // containment â€” a third option added later must fail this.
 633:       expect(await sut.publicSignupAccountTypes()).toEqual(['ngo', 'volunteer']);
 634: 
 635:       // Clause two, in its behavioural form, because a list is a claim and a refusal is a fact. The
 636:       // public completion path must REFUSE the administrator type and leave no account behind.
 637:       const visitor = await sut.registerWithEmailPassword(w.email('would-be-admin'), adminPassword);
 638:       const escalation = await sut.completeSignup(
 639:         visitor,
 640:         { accountType: 'platform_admin', acknowledgmentTextVersion: TEXT_VERSION },
