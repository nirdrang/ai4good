   1: /**
   2:  * THE IDS REQ-001 HAS NOT LANDED YET, and the leaf that will land each one. There are 30 of them as
   3:  * of the GitHub leaf; there were 33 before it, and the count moves down as leaves land.
   4:  *
   5:  * WHY THEY EXIST AT ALL. `harness/check.ts`'s `bijectionProblems()` refuses a run when any expected
   6:  * id has no registered call site, and `runner.ts` turns any such problem into exit 2 with NOTHING
   7:  * graded. The expected set is every `AT-001.NN (P0)` in `.taskmaster/docs/acceptance/at-req-001.md`
   8:  * â€” all 37 of them. So the moment `tests/at/suites/req-001/` exists, all 37 need executable call
   9:  * sites; there is no partial suite. Seven are written â€” AT-001.01 through .07, across the first
  10:  * accounts leaf and the GitHub one. The other 30 are declared, not faked: each one throws, loudly,
  11:  * stamped with its own id and with the manifest leaf that will make it real.
  12:  *
  13:  * THEY CANNOT SILENTLY GO GREEN. `AtPending` is a thrown error, so the id is RED, and
  14:  * `tests/at/expected/req-001.json` declares that red by SHAPE â€” `expected.ts` rebuilds the anchored
  15:  * prefix `AtPending: <id> PENDING [sut-missing] â€” ` from the declaration and compares it from
  16:  * position 0. A red of any other cause fails the declaration instead of hiding inside it, and a red
  17:  * that turns green fails it too, so a later leaf must update the ledger in the same change that
  18:  * lands its id. That file is REQ-001's live progress ledger from this item onward.
  19:  *
  20:  * WHAT THE PREFIX DOES NOT CHECK, said plainly because it is the reason every leaf writes a ledger
  21:  * of its own (`loop/items/AI4DEV-57/pending-ledger.txt`, then
  22:  * `loop/items/AI4DEV-58/pending-ledger.txt`): the tail after the em dash is FREE. `expected.ts`
  23:  * anchors on the prefix only, so a stub whose detail read "todo" would pass every command in this
  24:  * repository. Nothing mechanical holds the detail below to the truth. The check that does is a
  25:  * written one â€” every leaf named here appears in `loop/decomp/req-001.md`, and the ledger is the
  26:  * artifact a reviewer compares against the manifest.
  27:  */
  28: 
  29: import { AtPending, type AtContext } from './_bind.ts';
  30: 
  31: /**
  32:  * The manifest's leaves, in the manifest's own words shortened to a recall hint. The keys are the
  33:  * deliverable-and-leaf labels from `loop/decomp/req-001.md`; the letters there are the MANIFEST's
  34:  * deliverables and are not the plan's decision letters, which use the same alphabet for a different
  35:  * purpose.
  36:  */
  37: export const LEAF = {
  38:   // D1.L2 â€” GitHub OAuth signup and the mandatory GitHub link at volunteer signup â€” is GONE from
  39:   // this map rather than kept for symmetry. It landed AT-001.02, .04 and .05, so its label had no
  40:   // remaining user, and a leaf label sitting here with nothing pointing at it is a claim that
  41:   // something is still pending when nothing is. `tests/at/expected/req-001.json` declares those
  42:   // three ids green in the same change.
  43:   D2_L1: 'D2.L1 (email verification and the unverified-write gate on Discovery messages)',
  44:   D2_L2: 'D2.L2 (session expiry and revocation, auto-refresh, password reset, wrong-password rejection)',
  45:   D3_L1: 'D3.L1 (per-NGO admin/member roles and multi-NGO membership isolation)',
  46:   D3_L2: 'D3.L2 (the single-seat NGO and the single-dev project invariant)',
  47:   D3_L3: 'D3.L3 (the cross-surface single-seat integration)',
  48:   D4_L1: 'D4.L1 (acknowledgment identity capture â€” name, title, authority attestation)',
  49:   D5_L1: 'D5.L1 (cross-NGO denial and unassigned-volunteer denial)',
  50:   D5_L2: 'D5.L2 (assigned-volunteer scope, platform-admin reach, logged-out visibility)',
  51:   D6_L1: 'D6.L1 (contact transfer, lost-access recovery and the escalation contact)',
  52:   D6_L2: 'D6.L2 (the lifecycle gate every write route registers through)',
  53:   D6_L3: 'D6.L3 (the append-only audit for role changes and transfer, and sign-in rate limiting)',
  54: } as const;
  55: 
  56: export type LeafLabel = (typeof LEAF)[keyof typeof LEAF];
  57: 
  58: /**
  59:  * One not-yet-landed id's whole body.
  60:  *
  61:  * `sut-missing` rather than `harness-missing` is the honest phase word: the harness is up â€” this
  62:  * suite's own four ids run against it â€” and what is absent is the system under test for these
  63:  * criteria. The detail is what makes that word honest, by naming WHICH system under test.
  64:  */
  65: export function notLanded(leaf: LeafLabel): (ctx: AtContext) => Promise<void> {
  66:   return async (ctx: AtContext): Promise<void> => {
  67:     throw new AtPending(ctx.atId, 'sut-missing', `REQ-001 ${leaf} has not landed`);
  68:   };
  69: }
