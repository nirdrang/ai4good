 234:   atTest(
 235:     'AT-001.03',
 236:     'a session established by Google completes signup through the same path, with the same result as email',
 237:     { surface: 'ui' },
 238:     async ({ open }) => {
 239:       const { w, sut } = await open();
 240: 
 241:       // WHAT THIS TEST ASSERTS, AND WHAT IT REFUSES TO PRETEND.
 242:       //
 243:       // The shipped code in this leaf is the decision module, and it never reads the provider â€” it
 244:       // is never GIVEN one. `CompleteSignupRequest` has no provider field, and the adapter's
 245:       // `completeSignup` passes the account id together with ONE fact about the caller â€” whether a
 246:       // GitHub identity is linked â€” and nothing else, so the comparison below establishes that the
 247:       // shipped path ignores the provider BECAUSE IT NEVER RECEIVES ONE.
 248:       //
 249:       // A LINKED-GITHUB FACT IS NOT THE SESSION PROVIDER, and the distinction is why this paragraph
 250:       // survived the GitHub leaf unchanged in substance. The decision path still cannot tell an
 251:       // email-established session from a Google-established one â€” that is what makes this test's
 252:       // equivalence claim exactly as narrow now as it was before, no narrower and no wider.
 253:       //
 254:       // WHICH MEANS THIS COMPARISON WOULD NOT CATCH A PROVIDER BRANCH, and an earlier version of
 255:       // this comment claimed it would. A branch treating Google differently would have to live in
 256:       // an edge function or in Auth, and no code this test drives can express one; both halves of
 257:       // the comparison would keep agreeing while the shipped behaviour diverged. What carries the
 258:       // weight here is the PINNED-VALUE block below â€” two identically wrong results satisfy an
 259:       // equality check, and the pinned expectations are what refuse them.
 260:       //
 261:       // IT SIMULATES NO HANDSHAKE. There is no fabricated authorization code, no token exchange and
 262:       // no fake redirect anywhere in the adapter; `registerWithProvider` produces the state Auth is
 263:       // in AFTER a consent round trip, which is the only part of the story reachable without a
 264:       // person. AT-001.03's other clause â€” "sign-in via Google succeeds on return visits" â€” is a
 265:       // real consent round trip, is NOT proved by this test or anywhere in this item, and is named
 266:       // unproved in the plan's per-id table and in the merge ruling.
 267:       const googleSession = await sut.registerWithProvider('google', w.email('google-ngo'));
 268:       expect(
 269:         googleSession.provider,
 270:         'this test compares a google-established session against an email one; if it is not google, it compares nothing',
 271:       ).toBe('google');
 272: 
 273:       const emailSession = await sut.registerWithEmailPassword(w.email('email-ngo'), 'correct horse battery staple');
 274:       expect(emailSession.provider).toBe('email');
 275: 
 276:       const request = {
 277:         accountType: 'ngo' as const,
 278:         organizationName: 'Riverside Shelter',
 279:         acknowledgmentTextVersion: TEXT_VERSION,
 280:       };
 281: 
 282:       const viaGoogle = await sut.completeSignup(googleSession, request, CLIENT_IP);
 283:       const viaEmail = await sut.completeSignup(emailSession, request, CLIENT_IP);
 284:       expect(viaGoogle, 'a signup whose session came from Google was refused').toMatchObject({ ok: true });
 285:       expect(viaEmail, 'the email control signup was refused, so there is nothing to compare against').toMatchObject({ ok: true });
 286:       if (!viaGoogle.ok || !viaEmail.ok) return;
 287: 
 288:       // EVERY OBSERVABLE, COMPARED â€” not just "both succeeded". Identifiers differ by construction
 289:       // and are excluded on purpose; everything the criterion cares about must match.
 290:       const observable = async (accountId: string, organizationId: string | null) => {
 291:         const acknowledgments = await sut.acknowledgments(accountId);
 292:         return {
 293:           accountType: (await sut.account(accountId))?.accountType ?? null,
 294:           organizationName: organizationId ? ((await sut.organization(organizationId))?.name ?? null) : null,
 295:           membershipRole: organizationId ? ((await sut.membership(organizationId, accountId))?.role ?? null) : null,
 296:           acknowledgmentCount: acknowledgments.length,
 297:           acknowledgmentTextVersion: acknowledgments[0]?.textVersion ?? null,
 298:           acknowledgmentIp: acknowledgments[0]?.ip ?? null,
 299:           holdsPlatformAcknowledgment: await sut.hasPlatformAcknowledgment(accountId),
 300:         };
 301:       };
 302: 
 303:       const googleResult = await observable(viaGoogle.accountId, viaGoogle.organizationId);
 304:       expect(googleResult, 'signup via Google produced a different result from signup via email').toEqual(
 305:         await observable(viaEmail.accountId, viaEmail.organizationId),
 306:       );
 307:       // Pinned rather than left to the comparison alone: two identically WRONG results would satisfy
 308:       // an equality check on its own.
 309:       expect(googleResult).toMatchObject({
 310:         accountType: 'ngo',
 311:         membershipRole: 'admin',
 312:         acknowledgmentCount: 1,
 313:         acknowledgmentTextVersion: TEXT_VERSION,
 314:         holdsPlatformAcknowledgment: true,
 315:       });
 316: 
 317:       // "as either account type" â€” the volunteer half of the criterion, through the same path.
 318:       //
 319:       // THE LINK IS A PRECONDITION HERE, NOT AN ASSERTION. Since the GitHub leaf, a volunteer cannot
 320:       // complete signup without a linked GitHub identity (AT-001.04, which owns that rule and tests
 321:       // it). Adding the link is what keeps THIS test about what it has always been about â€” that a
 322:       // Google-established session completes through the same path as an email one â€” instead of
 323:       // silently becoming a second, worse test of the GitHub gate. Nothing below this line changed.
 324:       const googleVolunteer = await sut.registerWithProvider('google', w.email('google-volunteer'));
 325:       await sut.linkGithubIdentity(googleVolunteer, 'google-volunteer-handle');
 326:       const volunteerCompletion = await sut.completeSignup(
 327:         googleVolunteer,
 328:         { accountType: 'volunteer', acknowledgmentTextVersion: TEXT_VERSION },
 329:         CLIENT_IP,
 330:       );
 331:       expect(volunteerCompletion, 'a volunteer signup whose session came from Google was refused').toMatchObject({ ok: true });
 332:       if (!volunteerCompletion.ok) return;
 333:       expect(await sut.account(volunteerCompletion.accountId)).toMatchObject({ accountType: 'volunteer' });
 334:       expect(volunteerCompletion.organizationId, 'a volunteer completion must create no organisation').toBeNull();
 335:     },
