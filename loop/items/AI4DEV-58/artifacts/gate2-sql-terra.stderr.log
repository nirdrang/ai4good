 338:   atTest(
 339:     'AT-001.04',
 340:     'volunteer signup cannot complete without a linked GitHub account',
 341:     { surface: 'ui' },
 342:     async ({ open }) => {
 343:       const { w, sut } = await open();
 344: 
 345:       // THE CRITERION NAMES BOTH ESTABLISHING PROVIDERS â€” "completing volunteer signup by email or
 346:       // Google (no GitHub identity yet)" â€” so both are driven. That is not redundancy: the gate reads
 347:       // a LINKED identity, and if it had accidentally been written against the SESSION provider
 348:       // instead, an email session and a Google session would behave differently and only running
 349:       // both would show it.
 350:       const request = { accountType: 'volunteer' as const, acknowledgmentTextVersion: TEXT_VERSION };
 351: 
 352:       const byEmail = await sut.registerWithEmailPassword(w.email('email-volunteer'), PASSWORD);
 353:       const byGoogle = await sut.registerWithProvider('google', w.email('google-volunteer'));
 354:       expect(byEmail.provider).toBe('email');
 355:       expect(byGoogle.provider, 'the google half of this criterion is not being driven by a google session').toBe('google');
 356: 
 357:       for (const session of [byEmail, byGoogle]) {
 358:         const refused = await sut.completeSignup(session, request, CLIENT_IP);
 359:         expect(
 360:           refused.ok,
 361:           `a ${session.provider}-established volunteer completed signup with no linked GitHub account`,
 362:         ).toBe(false);
 363:         if (refused.ok) return;
 364: 
 365:         // "BLOCKED WITH THE GITHUB-LINK REQUIREMENT STATED" â€” the reason is half the criterion. A
 366:         // bare refusal leaves the caller with nothing to do differently, and the screen the wiring
 367:         // leaf builds has nothing to display.
 368:         expect(refused.reason, 'the refusal does not name GitHub').toMatch(/github/i);
 369:         expect(refused.reason, 'the refusal does not say that LINKING is what is required').toMatch(/link/i);
 370: 
 371:         // NO PARTIAL STATE. The weakest implementation that passes the assertions above writes the
 372:         // account row and then reports a refusal, which is not a refusal â€” it is a half-completed
 373:         // signup with a rude message. All four observables of a completion must be absent.
 374:         expect(await sut.account(session.accountId), 'the blocked completion left an account row behind').toBeNull();
 375:         expect(
 376:           await sut.volunteerProfile(session.accountId),
 377:           'the blocked completion imported a GitHub profile anyway',
 378:         ).toBeNull();
 379:         expect(
 380:           await sut.acknowledgments(session.accountId),
 381:           'the blocked completion recorded an acknowledgment anyway',
 382:         ).toEqual([]);
 383:         expect(
 384:           await sut.hasPlatformAcknowledgment(session.accountId),
 385:           'the blocked completion left the account holding the platform acknowledgment',
 386:         ).toBe(false);
 387:       }
 388: 
 389:       // "LINKING COMPLETES SIGNUP" â€” and the request is byte-identical to the one just refused. That
 390:       // is what makes the link the cause: if anything else about the request had changed, the
 391:       // success would be attributable to that instead.
 392:       for (const session of [byEmail, byGoogle]) {
 393:         await sut.linkGithubIdentity(session, `${session.provider}-volunteer-handle`);
 394:         const completion = await sut.completeSignup(session, request, CLIENT_IP);
 395:         expect(
 396:           completion,
 397:           `linking GitHub did not unblock the ${session.provider}-established volunteer's completion`,
 398:         ).toMatchObject({ ok: true });
 399:         if (!completion.ok) return;
 400:         expect(await sut.account(completion.accountId)).toMatchObject({ accountType: 'volunteer' });
 401:         expect(
 402:           await sut.hasPlatformAcknowledgment(completion.accountId),
 403:           'the completion that the link unblocked recorded no acknowledgment',
 404:         ).toBe(true);
 405:       }
 406: 
 407:       // THE NGO CONTROL, AND IT IS NOT OPTIONAL. A gate that refused EVERY completion would satisfy
 408:       // both refusals above, and the two successes after linking would not catch it either if the
 409:       // gate had simply been written as "refuse until any identity is linked". The criterion scopes
 410:       // itself to VOLUNTEER signup, so an NGO must still complete with no GitHub identity at all â€”
 411:       // that is the assertion which makes the gate's shape, and not merely its existence, correct.
 412:       const ngoSession = await sut.registerWithEmailPassword(w.email('ngo-control'), PASSWORD);
 413:       const ngoCompletion = await sut.completeSignup(
 414:         ngoSession,
 415:         { accountType: 'ngo', organizationName: 'Riverside Shelter', acknowledgmentTextVersion: TEXT_VERSION },
 416:         CLIENT_IP,
 417:       );
 418:       expect(
 419:         ngoCompletion,
 420:         'the GitHub gate leaked onto NGO signup, which links no GitHub account and is outside this criterion',
 421:       ).toMatchObject({ ok: true });
 422:       if (!ngoCompletion.ok) return;
 423:       expect(
 424:         await sut.volunteerProfile(ngoCompletion.accountId),
 425:         'an NGO completion wrote a volunteer GitHub profile',
 426:       ).toBeNull();
 427:     },
 428:   );
