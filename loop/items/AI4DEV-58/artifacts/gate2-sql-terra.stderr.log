 192:       return refuse('an NGO signup must carry a non-empty organisation name');
 193:     }
 194:     organizationName = rawName.trim();
 195:   } else if (rawName !== undefined && rawName !== null) {
 196:     // Refused rather than ignored. A volunteer has no organisation, so a name arriving on a
 197:     // volunteer request means the caller and the server disagree about what is being created, and
 198:     // silently dropping it would let that disagreement reach the database as a missing row instead
 199:     // of surfacing as a refusal.
 200:     return refuse('a volunteer signup carries no organisation name â€” one account holds exactly one global type');
 201:   }
 202: 
 203:   // THE CALLER FACT, read defensively â€” see the fail-closed paragraph above. A missing argument, a
 204:   // null, or a blank string all mean the same thing here: no GitHub identity is linked.
 205:   const linkedGithubHandle =
 206:     typeof caller?.githubHandle === 'string' && caller.githubHandle.trim() !== '' ? caller.githubHandle.trim() : null;
