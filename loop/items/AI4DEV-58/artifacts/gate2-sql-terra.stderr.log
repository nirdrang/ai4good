  46: // the test would grade the fixture's copy and say nothing about what the edge function writes.
  47: import { stubGithubStatsFor } from '../../../../supabase/functions/_shared/github.ts';
  48: import type {
  49:   AccountRow,
  50:   AccountsSut,
  51:   AcknowledgmentRow,
  52:   CompleteSignupOutcome,
  53:   CreateOrganizationOutcome,
  54:   MembershipRow,
  55:   OrganizationRow,
  56:   Session,
  57:   SessionProvider,
  58:   SignInOutcome,
  59:   VolunteerProfileRow,
  60:   World,
  61: } from './_contract.ts';
  62: 
  63: /**
  64:  * WHICH REQUIREMENT THIS ADAPTER IS, declared by the adapter itself.
  65:  *
  66:  * `harness/suite-adapters.ts` constrains its map entry to match this literal, and `loadAdapter()` in
  67:  * `harness/index.ts` re-checks it against the requirement it was asked for. Without it the
  68:  * type-check could describe one suite while the run drove another.
  69:  */
  70: export const requirement = 'req-001' as const;
  71: 
  72: interface AdapterOptions {
  73:   worlds: FixtureWorldStore;
  74: }
  75: 
  76: /** An auth user as Supabase Auth holds one: credentials and the provider that established them. */
  77: interface AuthUser {
  78:   id: string;
  79:   email: string;
  80:   password: string | null;
  81:   provider: SessionProvider;
  82:   /**
  83:    * The handle of a LINKED GitHub identity, or null â€” Auth's `identities[]` narrowed to the one
  84:    * field anything here reads.
  85:    *
  86:    * It is stored on the auth user and NOT on the session, which is the whole reason the gate is a
  87:    * caller fact: linking happens after a session exists, changes nothing about how that session was
  88:    * established, and is a property of the user Auth answers for.
  89:    */
  90:   githubHandle: string | null;
  91: }
  92: 
  93: interface StoredAcknowledgment extends AcknowledgmentRow {}
  94: 
  95: interface State {
  96:   authUsers: Map<string, AuthUser>;
  97:   /** email -> auth user id, because sign-in arrives with an address rather than an id */
  98:   byEmail: Map<string, string>;
  99:   accounts: Map<string, AccountRow>;
 100:   organizations: Map<string, OrganizationRow>;
 101:   /** `${organizationId}:${accountId}` -> row */
 102:   memberships: Map<string, MembershipRow>;
 103:   acknowledgments: StoredAcknowledgment[];
 104:   /** account id -> the imported volunteer profile, mirroring `public.volunteer_profiles`'s primary key */
 105:   volunteerProfiles: Map<string, VolunteerProfileRow>;
 106:   nextId: number;
 107: }
 108: 
 109: function membershipKey(organizationId: string, accountId: string): string {
 110:   return `${organizationId}:${accountId}`;
 111: }
 112: 
 113: function clone<T>(value: T): T {
 114:   return structuredClone(value);
 115: }
 116: 
 117: class AccountsFixtureWorld implements World {
 118:   constructor(
 119:     private readonly base: FixtureWorld,
 120:     private readonly serial: number,
 121:   ) {}
 122: 
 123:   email(local: string): string {
 124:     return `${local}+w${this.serial}@example.test`;
 125:   }
 126: 
 127:   async teardown(): Promise<void> {
 128:     await this.base.teardown();
 129:   }
 130: }
 131: 
 132: export function createFixtureAdapter({ worlds }: AdapterOptions) {
 133:   const state: State = {
 134:     authUsers: new Map(),
 135:     byEmail: new Map(),
 136:     accounts: new Map(),
 137:     organizations: new Map(),
 138:     memberships: new Map(),
 139:     acknowledgments: [],
 140:     volunteerProfiles: new Map(),
 141:     nextId: 1,
 142:   };
 143:   const openedWorlds = new Set<AccountsFixtureWorld>();
 144:   let worldSerial = 0;
 145: 
 146:   const nextId = (prefix: string): string => `${prefix}-${state.nextId++}`;
 147: 
 148:   const register = (
 149:     email: string,
 150:     password: string | null,
 151:     provider: SessionProvider,
 152:     githubHandle: string | null = null,
 153:   ): Session => {
 154:     // Supabase Auth's own uniqueness, mirrored: a second registration on one address is not a new
 155:     // user. Left out, a body could accidentally create two auth users for one address and then read
 156:     // back "one account per user" from a situation the real system cannot be in.
 157:     const existing = state.byEmail.get(email);
 158:     if (existing) throw new Error(`fixture: ${email} is already registered â€” Supabase Auth would refuse this`);
 159:     const user: AuthUser = { id: nextId('user'), email, password, provider, githubHandle };
 160:     state.authUsers.set(user.id, user);
 161:     state.byEmail.set(email, user.id);
 162:     return { accountId: user.id, email: user.email, provider: user.provider };
 163:   };
 164: 
 165:   /**
 166:    * Which providers can sign this user back in â€” Auth's `identities[]`, reduced to what AT-001.02
 167:    * asks about.
 168:    *
 169:    * A GitHub signup and a later GitHub LINK produce the same answer here, deliberately: after either,
 170:    * the account carries a GitHub identity, and "a later sign-in via GitHub returns to the same
 171:    * account" is a statement about the identity, not about which provider happened to create the user.
 172:    */
 173:   const reachableThroughProvider = (user: AuthUser, provider: SessionProvider): boolean =>
 174:     provider === 'github' ? user.githubHandle !== null : user.provider === provider;
 175: 
 176:   /**
 177:    * The `complete-signup` operation, at the loop tier.
 178:    *
 179:    * EVERY DECISION ON THIS PATH COMES FROM THE SHIPPED MODULE. What is left here is the four writes,
 180:    * performed together or not at all â€” which is the shape `public.complete_signup` guarantees inside
 181:    * one transaction on the real database, and which step 7 of the plan proves there.
 182:    */
 183:   const completeSignup = async (
 184:     session: Session,
 185:     request: CompleteSignupRequest,
 186:     ip: string,
 187:   ): Promise<CompleteSignupOutcome> => {
 188:     const authUser = state.authUsers.get(session.accountId);
 189:     if (!authUser) {
 190:       return { ok: false, reason: 'no authenticated user â€” sign in before completing signup' };
 191:     }
 192: 
 193:     // THE CALLER FACT COMES FROM THE STORED AUTH USER, never from the request. That is the same
 194:     // shape the edge function has, where it comes from `/auth/v1/user` â€” a client cannot assert it
 195:     // in either place, which is the whole security property of the volunteer gate.
 196:     const decision = validateCompleteSignup(request, { githubHandle: authUser.githubHandle });
 197:     if (!decision.ok) return { ok: false, reason: decision.reason };
 198:     const { accountType, organizationName, acknowledgmentTextVersion, githubHandle } = decision.value;
 199: 
 200:     // ONE ROW PER AUTH USER is what makes "one account holds exactly one global type" structural
 201:     // rather than remembered â€” the schema states it as a primary key, and this states it as a
 202:     // refusal at the same point.
 203:     if (state.accounts.has(session.accountId)) {
 204:       return { ok: false, reason: 'this account has already completed signup â€” one account holds exactly one global type' };
 205:     }
 206: 
 207:     const account: AccountRow = { id: session.accountId, accountType };
 208:     let organization: OrganizationRow | null = null;
 209:     let membership: MembershipRow | null = null;
 210: 
 211:     if (organizationName !== null) {
 212:       organization = { id: nextId('org'), name: organizationName };
 213:       membership = { organizationId: organization.id, accountId: account.id, role: 'admin' };
 214:     }
 215: 
 216:     // THE ONBOARDING IMPORT, COMPUTED HERE AND WRITTEN BELOW WITH EVERYTHING ELSE â€” which is the
 217:     // shape `public.complete_signup` guarantees inside one transaction on the real database. There
 218:     // is no queue and no deferred job: a volunteer completion either lands the account AND the
 219:     // populated profile, or lands nothing. AT-001.05's "a queued-but-empty import fails this test"
 220:     // is unrepresentable rather than merely untested.
 221:     let volunteerProfile: VolunteerProfileRow | null = null;
 222:     if (githubHandle !== null) {
 223:       const stats = stubGithubStatsFor(githubHandle);
 224:       volunteerProfile = {
 225:         accountId: session.accountId,
 226:         githubHandle,
 227:         topLanguages: stats.topLanguages,
 228:         repositoryCount: stats.repositoryCount,
 229:         contributionSummary: stats.contributionSummary,
 230:         // Fixed rather than read from a clock, for the same reason the acknowledgment's instant is:
 231:         // nothing in these criteria depends on WHICH instant, and the live-stack proof reads the
 232:         // database's own `now()`.
 233:         importedAt: '2026-01-01T00:00:00.000Z',
 234:       };
 235:     }
 236: 
 237:     const acknowledgment: StoredAcknowledgment = {
 238:       accountId: account.id,
 239:       kind: PLATFORM_ACKNOWLEDGMENT_KIND,
 240:       // Fixed rather than read from a clock: nothing in this leaf's four criteria depends on WHICH
 241:       // instant it is, only that one is recorded, and a real timestamp would make the capture
 242:       // non-deterministic for no gain. The live-stack proof reads `now()` from the database.
 243:       acknowledgedAt: '2026-01-01T00:00:00.000Z',
 244:       ip,
 245:       textVersion: acknowledgmentTextVersion,
 246:     };
 247: 
 248:     // All of them, together. Nothing above this line has mutated `state`.
 249:     state.accounts.set(account.id, account);
 250:     if (organization) state.organizations.set(organization.id, organization);
 251:     if (membership) state.memberships.set(membershipKey(membership.organizationId, membership.accountId), membership);
 252:     if (volunteerProfile) state.volunteerProfiles.set(volunteerProfile.accountId, volunteerProfile);
 253:     state.acknowledgments.push(acknowledgment);
 254: 
 255:     return { ok: true, accountId: account.id, organizationId: organization?.id ?? null };
 256:   };
 257: 
 258:   const sut: AccountsSut = {
 259:     // Read straight off the shipped constant. A literal here would be a second statement of the same
 260:     // fact, and AT-001.07 would then be asserting what this file says rather than what ships.
 261:     publicSignupAccountTypes: async () => [...PUBLIC_SIGNUP_ACCOUNT_TYPES],
 262: 
 263:     registerWithEmailPassword: async (email, password) => register(email, password, 'email'),
 264:     registerWithProvider: async (provider, email) => register(email, null, provider),
 265:     // A GitHub signup links the GitHub identity it signed up with â€” that is what makes it a GitHub
 266:     // signup rather than a session that merely says 'github'. Both halves are recorded here in one
 267:     // step because Auth performs them in one round trip.
 268:     registerWithGithub: async (email, githubHandle) => register(email, null, 'github', githubHandle),
 269: 
 270:     linkGithubIdentity: async (session, githubHandle) => {
 271:       const user = state.authUsers.get(session.accountId);
 272:       // A throw, not a refusal: a body that links an identity onto a user Auth never registered has
 273:       // a bug in the TEST, and returning a polite outcome would let that bug read as a product
 274:       // refusal further down.
 275:       if (!user) throw new Error(`fixture: no auth user ${session.accountId} to link a GitHub identity to`);
 276:       user.githubHandle = githubHandle;
 277:     },
 278: 
 279:     signInWithEmailPassword: async (email, password): Promise<SignInOutcome> => {
 280:       const userId = state.byEmail.get(email);
 281:       const user = userId ? state.authUsers.get(userId) : undefined;
 282:       // One reason for both branches: telling "no such account" apart from "wrong password" is an
 283:       // existence oracle, and REQ-001 spends AT-001.21 forbidding exactly that shape elsewhere.
 284:       if (!user || user.password === null || user.password !== password) {
 285:         return { ok: false, reason: 'the email or password is incorrect' };
 286:       }
 287:       return { ok: true, session: { accountId: user.id, email: user.email, provider: user.provider } };
 288:     },
 289: 
 290:     signInWithProvider: async (provider, email): Promise<SignInOutcome> => {
 291:       const userId = state.byEmail.get(email);
 292:       const user = userId ? state.authUsers.get(userId) : undefined;
 293:       // One reason again, for the AT-001.21 reason above: "no such account" and "that provider is
 294:       // not linked to it" must not be distinguishable to a caller.
 295:       if (!user || !reachableThroughProvider(user, provider)) {
 296:         return { ok: false, reason: `no account of this address is reachable through ${provider}` };
 297:       }
 298:       // THE SAME ACCOUNT, which is the clause under test. The id comes from the stored user, so a
 299:       // second identity minted per sign-in would show up as a different `accountId` rather than
 300:       // being invisible.
 301:       return { ok: true, session: { accountId: user.id, email: user.email, provider } };
 302:     },
 303: 
 304:     completeSignup,
 305: 
 306:     createOrganization: async (session, organizationName): Promise<CreateOrganizationOutcome> => {
 307:       const account = state.accounts.get(session.accountId);
 308:       if (!account) return { ok: false, reason: 'complete signup before creating an organisation' };
 309: 
 310:       // THE REFUSAL IS THE SHIPPED MODULE'S, not this file's. That is what makes AT-001.06 a test of
 311:       // an application boundary rather than of a helper called directly from a test body.
 312:       const allowed = ngoOnlyActionAllowed(account.accountType);
 313:       if (!allowed.ok) return { ok: false, reason: allowed.reason };
 314: 
 315:       // The name rule is the shipped module's too. It used to be spelled out here, which made this
 316:       // file hold a second copy of a rule â€” the one thing its opening paragraph promises it does
 317:       // not do.
 318:       const name = validateOrganizationName(organizationName);
 319:       if (!name.ok) return { ok: false, reason: name.reason };
 320: 
 321:       const organization: OrganizationRow = { id: nextId('org'), name: name.value };
 322:       const membership: MembershipRow = { organizationId: organization.id, accountId: account.id, role: 'admin' };
 323:       state.organizations.set(organization.id, organization);
 324:       state.memberships.set(membershipKey(organization.id, account.id), membership);
 325:       return { ok: true, organizationId: organization.id };
 326:     },
 327: 
 328:     account: async (accountId) => clone(state.accounts.get(accountId) ?? null),
 329:     organization: async (organizationId) => clone(state.organizations.get(organizationId) ?? null),
 330:     membership: async (organizationId, accountId) => clone(state.memberships.get(membershipKey(organizationId, accountId)) ?? null),
 331:     acknowledgments: async (accountId) => clone(state.acknowledgments.filter((row) => row.accountId === accountId)),
 332:     volunteerProfile: async (accountId) => clone(state.volunteerProfiles.get(accountId) ?? null),
 333: 
 334:     // The two searches a refused action needs: it hands back no identifier, so the rows it must NOT
 335:     // have written can only be looked for by the name that was attempted and by who holds what.
 336:     organizationsNamed: async (name) => clone([...state.organizations.values()].filter((row) => row.name === name.trim())),
 337:     membershipsOf: async (accountId) => clone([...state.memberships.values()].filter((row) => row.accountId === accountId)),
 338: 
 339:     // DISCRIMINATING â€” and WHICH predicate that green grades is worth being exact about, because
 340:     // this one is not the shipped one. `public.has_platform_acknowledgment` is SQL, and a
 341:     // TypeScript module cannot supply a SQL predicate; the one judgement inside it â€” which
 342:     // acknowledgment kind counts â€” is shared, which is why the constant below is imported rather
 343:     // than spelled. So AT-001.01's loop-tier green proves THE RULE and THIS storage: a completion
 344:     // writes the row, and the answer is false before and true after. The shipped SQL predicate
 345:     // could still return true unconditionally and this would stay green. What proves that one is
 346:     // step 7(h) of the plan, against the live database, and nothing else in this item.
 347:     hasPlatformAcknowledgment: async (accountId) =>
 348:       state.acknowledgments.some((row) => row.accountId === accountId && row.kind === PLATFORM_ACKNOWLEDGMENT_KIND),
 349: 
 350:     provisionPlatformAdmin: async (email, password) => {
 351:       const session = register(email, password, 'email');
 352:       // Written directly, bypassing `completeSignup` â€” which is not a shortcut but the point:
 353:       // `parseAccountType` refuses this type, so the public path CANNOT produce it, and the only way
 354:       // an administrator exists is an authority the public never holds. The type is still taken from
 355:       // the shipped vocabulary rather than spelled as a literal.
 356:       const accountType: AccountType = 'platform_admin';
 357:       state.accounts.set(session.accountId, { id: session.accountId, accountType });
 358:       return session;
 359:     },
 360:   };
 361: 
 362:   return {
 363:     sut: { accounts: sut },
 364:     fixtures: {
 365:       world: async (name: string) => {
 366:         const base = await worlds.world(name);
 367:         const world = new AccountsFixtureWorld(base, ++worldSerial);
 368:         openedWorlds.add(world);
 369:         return world;
 370:       },
 371:     },
 372:     teardown: async () => {
 373:       await Promise.all([...openedWorlds].map((world) => world.teardown()));
 374:       openedWorlds.clear();
 375:       state.authUsers.clear();
 376:       state.byEmail.clear();
 377:       state.accounts.clear();
 378:       state.organizations.clear();
 379:       state.memberships.clear();
 380:       state.acknowledgments.length = 0;
 381:       state.volunteerProfiles.clear();
 382:       state.nextId = 1;
 383:     },
 384:   };
 385: }
