161: function isIpv4(value: string): boolean {
162:   const parts = value.split('.');
163:   return parts.length === 4 && parts.every((part) => /^\d{1,3}$/.test(part) && Number(part) <= 255);
164: }
165: 
166: function isIpv6(value: string): boolean {
167:   if (value.split('::').length > 2) return false;
168:   const abbreviated = value.includes('::');
169:   const groups = value.split(':').filter((group) => group !== '');
170:   if (groups.length === 0) return abbreviated; // `::` itself
171:   const last = groups[groups.length - 1];
172:   // `::ffff:127.0.0.1` is a legal IPv6 address whose final element is a dotted IPv4 and occupies
173:   // two of the eight groups.
174:   const trailingIpv4 = last.includes('.');
175:   if (trailingIpv4 && !isIpv4(last)) return false;
176:   const hexGroups = trailingIpv4 ? groups.slice(0, -1) : groups;
177:   if (!hexGroups.every((group) => /^[0-9a-fA-F]{1,4}$/.test(group))) return false;
178:   const count = hexGroups.length + (trailingIpv4 ? 2 : 0);
179:   return abbreviated ? count < 8 : count === 8;
180: }
