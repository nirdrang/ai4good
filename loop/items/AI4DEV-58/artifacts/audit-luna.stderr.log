212: /** The result of a database function call: its value, or the database's own refusal. */
213: export type RpcOutcome = { ok: true; value: unknown } | { ok: false; status: number; message: string };
214: 
215: /**
216:  * Call one `public.` function, with the service role, in ONE round trip.
217:  *
218:  * One round trip is one implicit transaction, which is the whole reason the signup writes live
219:  * inside a database function rather than being issued as separate Data API calls from here. Four
220:  * calls would be four transactions, and a failure partway would leave an account with no
221:  * organisation, membership or acknowledgment.
222:  *
223:  * The service role bypasses row-level security, which is why the database functions perform their
224:  * own checks: nothing else is standing on this path.
225:  */
226: export async function callDatabaseFunction(
227:   supabaseUrl: string,
228:   serviceRoleKey: string,
229:   name: string,
230:   args: Record<string, unknown>,
231: ): Promise<RpcOutcome> {
232:   const response = await fetch(`${supabaseUrl}/rest/v1/rpc/${name}`, {
233:     method: 'POST',
234:     headers: {
235:       'content-type': 'application/json',
236:       apikey: serviceRoleKey,
237:       Authorization: `Bearer ${serviceRoleKey}`,
238:     },
239:     body: JSON.stringify(args),
240:   });
241: 
242:   const text = await response.text();
243:   if (!response.ok) {
244:     // PostgREST wraps a raised exception as `{ message, code, details, hint }`. The message is the
245:     // sentence the database function chose, so it is passed through rather than replaced with a
246:     // generic one â€” those functions raise sentences precisely so a caller can act on them.
247:     let message = text;
248:     try {
249:       const body = JSON.parse(text) as { message?: unknown };
250:       if (typeof body.message === 'string') message = body.message;
251:     } catch {
252:       // A non-JSON body from PostgREST means something other than a raised exception went wrong;
253:       // the raw text is then the most informative thing available.
254:     }
255:     return { ok: false, status: response.status, message };
256:   }
257: 
258:   return { ok: true, value: text === '' ? null : (JSON.parse(text) as unknown) };
259: }
260: 
261: /** Read a JSON request body, or refuse â€” a malformed body must not read as an empty one. */
262: export async function readJsonBody(request: Request): Promise<{ ok: true; value: Record<string, unknown> } | { ok: false; reason: string }> {
263:   let text: string;
264:   try {
265:     text = await request.text();
266:   } catch {
267:     return { ok: false, reason: 'the request body could not be read' };
268:   }
269:   if (text.trim() === '') return { ok: true, value: {} };
270:   try {
271:     const parsed = JSON.parse(text) as unknown;
272:     if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) {
273:       return { ok: false, reason: 'the request body must be a JSON object' };
274:     }
275:     return { ok: true, value: parsed as Record<string, unknown> };
276:   } catch {
277:     return { ok: false, reason: 'the request body is not valid JSON' };
278:   }
279: }

