99: type AuthSession = { accessToken: string; userId: string };
100: 
101: async function signUp(email: string): Promise<AuthSession> {
102:   const response = await fetch(`${API_URL}/auth/v1/signup`, {
103:     method: 'POST',
104:     headers: { 'content-type': 'application/json', apikey: PUBLIC_KEY },
