35: import { SQL } from 'bun';
36: // THE SHIPPED STUB, IMPORTED RATHER THAN MIRRORED. Check (b) compares the row the real database
37: // holds against the real module's judgement for that handle, so "the profile is populated" is a
38: // statement about the values the edge function actually computed and not about "something non-empty
39: // is there".
40: import { stubGithubStatsFor } from '../../../supabase/functions/_shared/github.ts';
41: 
42: /* ------------------------------------------------------------------------ reporting machinery */
43: 
44: type Outcome = 'pass' | 'fail' | 'skip';
45: type Check = { id: string; title: string; outcome: Outcome; note: string };
46: 
47: const results: Check[] = [];
48: 
49: function record(id: string, title: string, passed: boolean, note: string): void {
50:   results.push({ id, title, outcome: passed ? 'pass' : 'fail', note });
51:   console.log(`${passed ? 'PASS' : 'FAIL'}  (${id}) ${title}\n        ${note}`);
52: }
53: 
54: /**
55:  * A check that could not be attempted. Never a pass and never a failure â€” a skip says the evidence
56:  * is MISSING, which is a different statement from the claim being false, and both differ from the
57:  * claim being proved.
58:  */
59: function skip(id: string, title: string, why: string): void {
60:   results.push({ id, title, outcome: 'skip', note: `SKIPPED â€” ${why}` });
61:   console.log(`SKIP  (${id}) ${title}\n        ${why}`);
62: }
63: 
64: function fail(message: string): never {
65:   console.error(`\nPRECONDITION FAILED: ${message}`);
66:   process.exit(2);
67: }
68: 
69: /* --------------------------------------------------------------------------- the environment */
70: 
71: const status = await (async () => {
72:   const proc = Bun.spawnSync(['bunx', 'supabase', 'status', '-o', 'json'], { stdout: 'pipe', stderr: 'pipe' });
73:   const text = new TextDecoder().decode(proc.stdout);
74:   const start = text.indexOf('{');
75:   // The raw text is NOT included in this message, deliberately: it is the whole status payload and it
76:   // carries key material. A failure here says what to do, not what it read.
77:   if (start < 0) fail('could not read `supabase status -o json` â€” is the stack up? (bun run db:start)');
78:   return JSON.parse(text.slice(start)) as Record<string, string>;
79: })();
80: 
81: const API_URL = status.API_URL ?? fail('supabase status reported no API_URL');
82: const DB_URL = status.DB_URL ?? fail('supabase status reported no DB_URL');
83: /** The browser's key. Everything a signed-out or signed-in visitor could do uses this and no other. */
84: const PUBLIC_KEY = status.ANON_KEY ?? status.PUBLISHABLE_KEY ?? fail('supabase status reported no client key');
85: /** The server's key. Used ONLY where the check is about what a server-side caller may do. */
86: const SECRET_KEY = status.SERVICE_ROLE_KEY ?? status.SECRET_KEY ?? fail('supabase status reported no service key');
