 214:         }
 215:     }
 216:     catch {
 217:         $extra += ('window check degraded: ' + ($_.Exception.Message -replace '[\r\n]', ' '))
 218:     }
 219: 
 220:     $script:Actor = if ($top -match '[\\/]\.claude[\\/]worktrees[\\/]') { 'AGENT' } else { 'COORDINATOR' }
 221: 
 222:     # SUPERVISED AGENTS (founder 2026-08-05). From the MAIN checkout, every platform agent
 223:     # worktree gets its own derived stamp appended, so the founder sees the whole supervision
 224:     # tree on every prompt without asking. Each agent line is this hook re-run against that
 225:     # worktree - ONE derivation logic, never a second formula that could drift. An agent
 226:     # worktree itself skips this block (its stamp IS the agent line), which also terminates
 227:     # the recursion; the path guard matches both slash directions because git reports forward
 228:     # slashes on Windows.
 229:     try {
 230:         $wtRoot = Join-Path $top '.claude/worktrees'
 231:         if ((-not $env:AI4GOOD_STAMP_CHILD) -and ($top -notmatch '[\\/]\.claude[\\/]worktrees[\\/]') -and (Test-Path -LiteralPath $wtRoot)) {
 232:             $savedEnv = $env:CLAUDE_PROJECT_DIR
 233:             $env:AI4GOOD_STAMP_CHILD = '1'
 234:             foreach ($d in (Get-ChildItem -LiteralPath $wtRoot -Directory -ErrorAction SilentlyContinue)) {
 235:                 # ONLY a real worktree is recursed into. `.claude/worktrees` also holds ordinary
 236:                 # directories - the artifacts directory the conductor keeps per item - and those
 237:                 # are INSIDE this repository, so git answers with the MAIN checkout's toplevel.
 238:                 # The old guard tested that answer, saw the main checkout, and enumerated this
 239:                 # directory again: unbounded self-spawning that hung the hook for minutes and
 240:                 # printed nothing. A stamp that does not appear is the one failure this file
 241:                 # exists to prevent, so the test is now "is this directory itself a worktree",
 242:                 # and AI4GOOD_STAMP_CHILD makes any future path incapable of recursing at all.
 243:                 $childTop = (& git -C $d.FullName rev-parse --show-toplevel 2>$null)
 244:                 if (-not $childTop) { continue }
 245:                 $a = [System.IO.Path]::GetFullPath(($childTop.Trim() -replace '/', '\')).TrimEnd('\')
 246:                 $b = [System.IO.Path]::GetFullPath($d.FullName).TrimEnd('\')
 247:                 if (-not $a.Equals($b, [System.StringComparison]::OrdinalIgnoreCase)) { continue }
 248: 
 249:                 $env:CLAUDE_PROJECT_DIR = $d.FullName
 250:                 $child = @(& powershell -NoProfile -File $PSCommandPath 2>$null)
 251:                 if ($child.Count -ge 2) {
 252:                     # Verbatim, plus an OWNERSHIP tag (founder 2026-08-09). These lines print in
 253:                     # EVERY session opened in this folder - the tree is derived from disk - so a
 254:                     # parallel session reads them as its own agents unless each line says whose
 255:                     # agent it is. The owner is recorded by /work at spawn; absent records and an
 256:                     # unknown session id both degrade to words, never to a guess.
 257:                     # A DIFFERENT SPAWNER ID IS NOT ANOTHER SESSION (founder catch 2026-08-12).
 258:                     # The founder's one thread of work can span several session ids: /clear
 259:                     # always mints a new id, resume can fork onto one, and a resume aimed at an
 260:                     # explicit id can land on an OLDER trunk than the session it meant to
 261:                     # continue (measured 2026-08-12: a stale dispatch pointer did exactly that,
 262:                     # and agents spawned in the post-clear session read as id mismatches in the
 263:                     # resumed trunk). The old wording asserted "ANOTHER session's agent" on any
 264:                     # mismatch, and the coordinator believed it over the founder's own account.
 265:                     # No repair is derivable: the hook payload names no predecessor id and
 266:                     # transcripts carry only their own id. So the label states exactly what the
 267:                     # comparison knows - the spawner's tag, and the mismatch's readings - and
 268:                     # the reader resolves it by asking or from conversation memory.
 269:                     $who = 'spawner unrecorded - not necessarily this session''s'
 270:                     try {
 271:                         # GIT'S OWN STRING, never $a. The worktree id is a hash of the toplevel
 272:                         # TEXT, so `C:/x` and `C:\x` hash differently: $a is the backslash form
 273:                         # built for the path-equality test above, and passing it here missed a
 274:                         # record that existed and printed "spawner unrecorded" for my own agent
 275:                         # (measured 2026-08-09, first live use). Every writer uses git's forward-
 276:                         # slash output, so every reader must too.
 277:                         $own = Get-OwnerForWorktreeRoot ($childTop.Trim())
 278:                         $ownSid = if ($own) { [string]$own.sessionId } else { '' }
 279:                         if ($ownSid -and $script:SessionId) {
 280:                             if ($ownSid -eq $script:SessionId) { $who = 'this session''s agent' }
 281:                             else {
 282:                                 $ownTag = if ($ownSid.Length -ge 8) { $ownSid.Substring(0, 8) } else { $ownSid }
 283:                                 $who = ('spawner session ' + $ownTag + ' - another session, or this one before a resume')
 284:                             }
 285:                         }
 286:                         elseif ($ownSid) { $who = 'spawner recorded; this session''s id unknown' }
 287:                     }
 288:                     catch { }
 289:                     $script:AgentLines += ([string]$child[0] + '   [' + $who + ']')
 290:                     $script:AgentLines += ([string]$child[1])
 291:                     # AND ITS WARNINGS. Forwarding only the first two lines silently dropped every
 292:                     # qualifier the child raised - STALE, CHAIN UNRESOLVED, BRANCH NAMES 2 ITEMS,
 293:                     # an ignored held item. An agent whose branch named two items therefore showed
 294:                     # as "WORKING ON nothing" in the supervision tree, indistinguishable from one
 295:                     # that simply had not switched branch yet - and that exact display was on
 296:                     # screen this morning for an innocent reason, which is what makes the
 297:                     # ambiguity dangerous. A warning nobody can see is the failure this file
 298:                     # exists to prevent. The machine tag is the child's own and is not repeated.
 299:                     for ($i = 2; $i -lt $child.Count; $i++) {
 300:                         $w = [string]$child[$i]
 301:                         if ($w -and ($w -notmatch '^<ai4good-attribution')) { $script:AgentLines += ('            ' + $w) }
 302:                     }
 303:                 }
 304:             }
 305:             $env:CLAUDE_PROJECT_DIR = $savedEnv
 306:             $env:AI4GOOD_STAMP_CHILD = $null
 307:         }
 308:     }
 309:     catch {
 310:         # Never silent, never fatal: a broken enumeration names itself and the main stamp stands.
 311:         $script:AgentLines += ('AGENT       (enumeration failed: ' + ($_.Exception.Message -replace '[\r\n]', ' ') + ')')
 312:     }
