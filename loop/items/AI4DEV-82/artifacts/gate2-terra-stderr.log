 347:     $ids = @(Get-BranchItems $branch)
 348:     $item = ''
 349:     if ($ids.Count -eq 1) { $item = $ids[0] }
 350:     elseif ($ids.Count -gt 1) {
 351:         $extra += ('BRANCH NAMES ' + $ids.Count + ' ITEMS (' + ($ids -join ', ') + ') - unresolved; rename the branch or say which')
 352:     }
 353: 
 354:     # "folder", not "wt": an abbreviation nobody outside this repository can expand is exactly the
 355:     # shorthand the founder's standing instruction forbids, and this line is read by the founder.
 356:     # The SHORT SESSION TAG (founder 2026-08-11: "I want a hash or something unique that can
 357:     # identify the session... short since session ids are long"): the first 8 characters of the
 358:     # session id — already random hex, so no hashing is needed, and the founder can match it to
 359:     # a window at a glance. A new tag after a compact or resume is a FEATURE: identity rotation
 360:     # becomes visible instead of silent. Child re-runs carry no session id and print no tag.
 361:     $line2 = ('folder {0} - branch {1}' -f $wt, $branch)
 362:     if ($script:SessionId -and $script:SessionId.Length -ge 8) {
 363:         $line2 += (' - session ' + $script:SessionId.Substring(0, 8))
 364:     }
