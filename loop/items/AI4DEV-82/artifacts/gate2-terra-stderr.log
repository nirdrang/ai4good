thing at all.\\n1477:     [\\n1478:       'the BEFORE snapshot recorded at least one personal container and one personal volume',\\n1479:       before.containers.length > 0 && before.volumes.length > 0,\\n1480:     ],\\n1481:     ['the personal docker snapshots are equal on every identity field', differences.length === 0],\\n1482:   ];\\n1483:   console.log('=== the done-criterion, item by item ===');\\n1484:   for (const [what, met] of criteria) console.log(`  ${met ? 'PASS' : 'FAIL'}  ${what}`);\\n1485:   const passed = criteria.every(([, met]) => met);\\n1486:   console.log('');\\n1487:   console.log(passed ? 'THE SPIKE PASSED: the wall holds under the exact condition that broke it.' : 'THE SPIKE FAILED. The wall is NOT proven.');\\n1488:   console.log('');\\n1489:   console.log('Residue: slot 1 keeps a public.spike_canary table until its next occupancy, which resets it.');\\n1490:   console.log('END OF S3 TRANSCRIPT (re-proof)');\\n1491:   return passed ? 0 : 1;\\n1492: }\\n1493: \\n1494: function usage(): void {\\n1495:   console.error('usage: bun tests/at/harness/db-pool.ts <setup|status|spike>');\\n1496: }\\n1497: \\n1498: async function main(argv: string[]): Promise<number> {\\n1499:   const command = argv[0] ?? '';\\n1500:   if (command === 'setup') return setup();\\n1501:   if (command === 'spike') return spike();\\n1502:   if (command === 'status') {\\n1503:     for (const view of readPool()) {\\n1504:       console.log(\\n1505:         `slot ${view.slot}: ${view.configured ? `${view.projectId}, api ${view.apiPort}` : 'NOT CONFIGURED'}` +\\n1506:           `, reservation ${view.reservation ? `${view.reservation.item} (${view.reservation.at})` : 'none'}` +\\n1507:           `, occupancy ${view.occupiedBy ? `pid ${view.occupiedBy.pid} for ${view.occupiedBy.requirement}` : 'none'}`,\\n1508:       );\\n1509:     }\\n1510:     return 0;\\n1511:   }\\n1512:   usage();\\n1513:   return 2;\\n1514: }\\n1515: \\n1516: if (import.meta.main) {\\n1517:   try {\\n1518: