 335:     # that, taking up an item and later switching to main would keep claiming the old item forever.
 336:     # An id that fails validation is discarded outright: one containing newlines would forge extra
 337:     # stamp lines and a fake attribution tag - the very output the founder is told to trust.
 338:     $held = $null
 339:     try { $held = Get-HeldItem -SessionId $script:SessionId } catch { }
 340:     $heldId = ''
 341:     $heldStale = ''
