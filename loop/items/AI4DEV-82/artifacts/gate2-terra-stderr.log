 314:     # Named git states. The earlier design printed "nothing" during a rebase or a bisect - hours of
 315:     # genuinely attributed work reported as unattributed, which teaches you to ignore the line.
 316:     if ((Test-Path (Join-Path $gitDir 'rebase-merge')) -or (Test-Path (Join-Path $gitDir 'rebase-apply'))) {
 317:         $extra += 'REBASE IN PROGRESS - closure blocked until it finishes'
 318:     }
