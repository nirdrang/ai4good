  statuses.set(slot, read.status);\\n1410:       console.log(`  slot ${slot}  API ${read.status.apiUrl}  DB ${redactDbUrl(read.status.dbUrl)}`);\\n1411:     }\\n1412:     const slot1 = statuses.get(1) as StackStatus;\\n1413:     const slot2 = statuses.get(2) as StackStatus;\\n1414:     console.log('');\\n1415: \\n1416:     console.log('=== (c) canary row in slot 1 — the bystander that must SURVIVE ===');\\n1417:     await writeCanary(1, slot1, 'slot-1 canary');\\n1418:     console.log(`  slot 1 canary written: ${JSON.stringify(await readCanary(1, slot1))}`);\\n1419:     console.log('');\\n1420: \\n1421:     console.log('=== (d) canary row in slot 2 — the row the reset must DESTROY ===');\\n1422:     await writeCanary(2, slot2, 'slot-2 canary');\\n1423:     console.log(`  slot 2 canary written: ${JSON.stringify(await readCanary(2, slot2))}`);\\n1424:     console.log('');\\n1425: \\n1426:     console.log('=== (e) the pre-destructive identity read on slot 2 ===');\\n1427:     const read = proveSlotTarget(2, 'reset', REPO_ROOT, true);\\n1428:     if (!read.status) throw new Error(`slot 2 reported no running stack: ${read.notRunning}`);\\n1429:     preReadShown = true;\\n1430:     console.log('  the line above is the helper stating which project the CLI resolved, before anything destructive.');\\n1431:     console.log('');\\n1432: \\n1433:     console.log('=== (f) supabase db reset, aimed at slot 2, through the helper, hostile variable present ===');\\n1434:     await resetSlotDatabase(2);\\n1435:     resetDone = true;\\n1436:     console.log('  the reset exited zero.');\\n1437:     console.log('');\\n1438: \\n1439:     console.log('=== (g) the canaries after the reset ===');\\n1440:     slot1Canary = await readCanary(1, slot1);\\n1441:     slot2Canary = await readCanary(2, slot2);\\n1442:     console.log(`  slot 1 canary: ${JSON.stringify(slot1Canary)}`);\\n1443:     console.log(`  slot 2 canary: ${JSON.stringify(slot2Canary)}`);\\n1444:     console.log('');\\n1445:   }