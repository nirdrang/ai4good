===== capture-gauge.ps1 =====
   1: # capture-gauge.ps1 - capture the FULL CLI surface of window-gauge.ps1 over a fixed synthetic set.
   2: #
   3: # WHY IT EXISTS (gate 1 finding 2, AI4DEV-82). window-sim.ps1 asserts selected JSON properties and
   4: # throws the human output away, so a green sim does not prove that extracting the verdict logic
   5: # into a library moved nothing. This captures EVERY byte the CLI emits - human lines, JSON, exit
   6: # codes, in every mode - over a fixed set of synthetic snapshots. Run once BEFORE the extraction
   7: # and once AFTER; the two files must be identical.
   8: #
   9: # WHAT IS NORMALISED, AND WHY. Two families of number move with the wall clock between the two
  10: # runs and carry no behavioural meaning:
  11: #   - the reading age (readingAgeMin, and the same number quoted inside a reason sentence), which
  12: #     grows by one per minute because capturedAt is written at capture time;
  13: #   - the minutes until reset (resetsInMin, and the same number in the human "(in N min)" column),
  14: #     which counts down toward the FIXED absolute reset timestamps below.
  15: # Both are replaced by <NORM>. Everything else - verdicts, reasons, window names, percentages,
  16: # the local reset time, resetsAtUtc, line layout and exit codes - is compared byte for byte.
  17: #
  18: # The reset timestamps are FIXED absolute instants rather than offsets from now, so the local
  19: # HH:mm the human line prints and the resetsAtUtc the JSON prints are stable across runs.
  20: #
  21: # The captures are pinned to the pause line the gauge DEFAULTS to. No -PauseAt is passed on
  22: # purpose: a refactor that changed the default must show up as a diff. Both halves of the
  23: # AI4DEV-82 capture-diff were therefore taken while that default was 90.
  24: #
  25: # Run: powershell -NoProfile -File loop/items/AI4DEV-82/artifacts/capture-gauge.ps1 -Out <file>
  26: 
  27: [CmdletBinding()]
  28: param(
  29:     [Parameter(Mandatory = $true)][string]$Out,
  30:     [string]$Label = ''
  31: )
  32: 
  33: $ErrorActionPreference = 'SilentlyContinue'
  34: $here  = Split-Path -Parent $MyInvocation.MyCommand.Path
  35: $repo  = (Resolve-Path (Join-Path $here '..\..\..\..')).Path
  36: $gauge = Join-Path $repo 'loop\work\window-gauge.ps1'
  37: $snap  = Join-Path $env:TEMP ('gauge-capture-' + [guid]::NewGuid().ToString('N').Substring(0, 8) + '.json')
  38: 
  39: # Fixed instants, so every reset-derived STRING is stable between the two runs.
  40: $futureReset = [DateTimeOffset]::Parse('2026-12-31T12:00:00Z').ToUnixTimeSeconds()
  41: 
  42: function Set-Snapshot([hashtable]$windows, [double]$ageMinutes) {
  43:     $o = [ordered]@{
  44:         capturedAt = (Get-Date).ToUniversalTime().AddMinutes(-$ageMinutes).ToString('o')
  45:         sessionId  = 'capture'
  46:         version    = 'capture'
  47:         rateLimits = $windows
  48:     }
  49:     [IO.File]::WriteAllText($snap, ($o | ConvertTo-Json -Depth 6))
  50: }
  51: function Set-Raw([string]$text) { [IO.File]::WriteAllText($snap, $text) }
  52: function Remove-Snapshot() { Remove-Item $snap -Force -ErrorAction SilentlyContinue }
  53: 
  54: function Normalize([string]$text) {
  55:     $n = $text
  56:     $n = [regex]::Replace($n, '"readingAgeMin"\s*:\s*-?[0-9]+(\.[0-9]+)?', '"readingAgeMin":  <NORM>')
  57:     $n = [regex]::Replace($n, '"resetsInMin"\s*:\s*-?[0-9]+(\.[0-9]+)?', '"resetsInMin":  <NORM>')
  58:     $n = [regex]::Replace($n, '\(in -?[0-9]+(\.[0-9]+)? min\)', '(in <NORM> min)')
  59:     $n = [regex]::Replace($n, 'reading is -?[0-9]+(\.[0-9]+)? min old', 'reading is <NORM> min old')
  60:     return $n
  61: }
  62: 
  63: # The fixed synthetic set named in step 1's done-criterion.
  64: $cases = [ordered]@{
  65:     'ok'              = { Set-Snapshot @{ five_hour = @{ used_percentage = 50; resets_at = $futureReset } } 0 }
  66:     'pause'           = { Set-Snapshot @{ five_hour = @{ used_percentage = 95; resets_at = $futureReset } } 0 }
  67:     'stale-high'      = { Set-Snapshot @{ five_hour = @{ used_percentage = 97; resets_at = $futureReset } } 60 }
  68:     'stale-low'       = { Set-Snapshot @{ five_hour = @{ used_percentage = 40; resets_at = $futureReset } } 60 }
  69:     'missing-file'    = { Remove-Snapshot }
  70:     'unparseable'     = { Set-Raw 'this is not json {{{' }
  71:     'no-rate-limits'  = { Set-Raw '{"capturedAt":"2026-08-07T00:00:00Z","rateLimits":null}' }
  72: }
  73: 
  74: # Every mode the CLI has: human lines, JSON, and the wait-condition exit code in both shapes.
  75: $modes = [ordered]@{
  76:     'human'                = @()
  77:     'json'                 = @('-Json')
  78:     'exitonready-human'    = @('-ExitOnReady')
  79:     'exitonready-json'     = @('-Json', '-ExitOnReady')
  80: }
  81: 
  82: $lines = @()
  83: $lines += '# window-gauge.ps1 CLI capture'
  84: if ($Label) { $lines += ('# label: ' + $Label) }
  85: $lines += '# normalised: readingAgeMin, resetsInMin, "(in N min)", "reading is N min old"'
  86: $lines += ''
  87: 
  88: try {
  89:     foreach ($caseName in $cases.Keys) {
  90:         & $cases[$caseName]
  91:         foreach ($modeName in $modes.Keys) {
  92:             $args = @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', $gauge) + $modes[$modeName] + @('-SnapshotPath', $snap)
  93:             $stdout = @(& powershell @args)
  94:             $code = $LASTEXITCODE
  95:             $lines += ('===== case={0} mode={1} =====' -f $caseName, $modeName)
  96:             $lines += ('exit={0}' -f $code)
  97:             foreach ($l in $stdout) { $lines += (Normalize ([string]$l)) }
  98:             $lines += ''
  99:         }
 100:     }
 101: }
 102: finally {
 103:     Remove-Snapshot
 104: }
 105: 
 106: [IO.File]::WriteAllText($Out, (($lines -join "`r`n") + "`r`n"), (New-Object System.Text.UTF8Encoding($false)))
 107: Write-Output ('captured {0} bytes to {1}' -f (Get-Item $Out).Length, $Out)

===== settings-proof-probe.ps1 (first 280) =====
   1: # settings-proof-probe.ps1 - prove the DEPLOYED hook entries load and fire, not merely that the
   2: # JSON parses.
   3: #
   4: # WHY (gate 1 finding 6). "The JSON parses and the files exist" proves nothing about whether Claude
   5: # Code loaded the entries, matched the tool, and delivered the text. This drives a real headless
   6: # `claude -p` run against each deployed entry shape and reads the answer out of the transcript.
   7: #
   8: # PATH HONESTY. The committed .claude/settings.json carries MAIN-checkout absolute paths, which
   9: # only exist after the merge - window-gate.ps1 and window-alarm.cmd are not in the main checkout
  10: # yet. So the probe generates a TWIN of the committed file whose command paths are rewritten to
  11: # this worktree. Everything else is copied through untouched: the same event names, the same
  12: # matchers, the same JSON shape, the same invocation style. Only the path prefix differs, and the
  13: # twin is written beside the evidence so a reader can diff it against the committed file. What
  14: # this proves is that the ENTRY SHAPES load and fire. The merge sitting still checks the live
  15: # firing of the main-checkout paths afterwards; that is the second half, no longer the only half.
  16: #
  17: # NO LOGGING HOOKS ARE ADDED. Extra entries would no longer be the deployed shape. Every piece of
  18: # evidence therefore comes from the transcript, which is also the only place that proves the MODEL
  19: # actually saw the text.
  20: #
  21: # COST. Five short headless runs on trivial prompts. It is not free, unlike the drill, which is
  22: # why it is a one-time proof and the drill is the permanent net.
  23: #
  24: # Run: powershell -NoProfile -File loop/items/AI4DEV-82/artifacts/settings-proof-probe.ps1
  25: # Evidence lands in loop/items/AI4DEV-82/artifacts/settings-proof/ (raw transcripts kept).
  26: 
  27: [CmdletBinding()]
  28: param(
  29:     # The Claude Code binary. Overridable so the probe can be pointed at a specific install.
