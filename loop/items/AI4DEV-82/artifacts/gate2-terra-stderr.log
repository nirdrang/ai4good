 366:     # CONFLICT outranks everything. Never pick a side: exactly one of the two describes work that
 367:     # is not happening, and that is the condition the old design could never see.
 368:     if ($item -and $heldId -and $item -ne $heldId) {
 369:         Emit ('CONFLICT - branch says ' + $item + ', session holds ' + $heldId) $line2 `
 370:         ($extra + 'Attribution unresolved until you say which is right. Building is not blocked; closing is.') 'conflict' 'conflict'
 371:         exit 0
 372:     }
 373: 
 374:     # Branch names nothing, but the session took an item up ON THIS BRANCH: fill the gap, and say
 375:     # it is a gap. This is also how COORDINATOR LIGHT WORK attributes (founder 2026-08-09): work
 376:     # ruled onto main outside an item records a held item, and this line then carries it.
 377:     $heldFill = $false
 378:     $heldLabel = ''
 379:     if (-not $item -and $heldId -and $ids.Count -eq 0) {
