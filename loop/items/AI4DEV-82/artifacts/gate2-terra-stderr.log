 391:         # something - board, relays, sweeps, folds - it just claims no ITEM. So the coordinator's
 392:         # idle line names its standing work instead of an absence, and the nudge tells it how to
 393:         # attribute item-scoped light work: hold the item. An AGENT keeps the bare wording - it
 394:         # was spawned for one item, and "coordination" would be false there.
 395:         if ($script:Actor -eq 'AGENT') {
 396:             Emit 'nothing - this branch names no item yet' $line2 $extra 'none' 'none'
 397:         }
 398:         elseif ($script:AgentLines.Count -gt 0) {
 399:             Emit 'coordination, no item claimed here - the items below run in their own folders' $line2 $extra 'none' 'none'
 400:         }
 401:         else {
 402:             Emit 'coordination, no item claimed - board, relays, sweeps and folds happen here' $line2 ($extra + 'item-scoped light work? hold the item so this line attributes it; exploring? say so') 'none' 'none'
 403:         }
 404:         exit 0
 405:     }
 406: 
 407:     # The chain, from cache. Keyed by worktree id + branch, so two clones never share an entry
 408:     # and a branch renamed into a previously-cached name misses instead of hitting.
 409:     $chain = $null
 410:     try { $chain = Get-Chain $branch } catch { }
 411: 
 412:     # An unresolved chain claims NO root. The earlier version fell back to the item itself, which
 413:     # printed pm="AI4DEV-36" - asserting an item is its own root when the parent is simply unknown.
 414:     # Unknown is a value; inventing one is the failure this whole design exists to prevent.
 415:     $root = '-'
 416:     if (Test-Chain $chain $branch $item) {
 417:         $nodes = @($chain.chain)
