 id 4f0cbd08610dfdd42c6c93fb9abf1eed25ecf5043bab3afa24bdad364837795d | created 2026-08-09T22:30:36.397633849Z | image public.ecr.aws/supabase/logflare:1.47.1 | ports {\"4000/tcp\":[{\"HostIp\":\"\",\"HostPort\":\"54327\"}]}\n22:   /supabase_auth_poancmeitlmxejofwzuu | id 38d058a45856033b6715edbb78b4fce73392283ff9930e9043fe490031d324f0 | created 2026-08-09T22:30:38.180055558Z | image public.ecr.aws/supabase/gotrue:v2.193.0 | ports {}\n23:   /supabase_db_poancmeitlmxejofwzuu | id a9fc53b713132db35df62f08563a31552eb93662efd925e6e35efe19b9e7c588 | created 2026-08-09T22:30:25.016886496Z | image public.ecr.aws/supabase/postgres:17.6.1.143 | ports {\"5432/tcp\":[{\"HostIp\":\"\",\"HostPort\":\"54322\"}]}\n24:   /supabase_inbucket_poancmeitlmxejofwzuu | id 05a41d3f900184d874744b3f69099877ddcaad0facc5cdedeab768acb03e6937 | created 2026-08-09T22:30:38.737406565Z | image public.ecr.aws/supabase/mailpit:v1.30.2 | ports {\"8025/tcp\":[{\"HostIp\":\"\",\"HostPort\":\"54324\"}]}\n25:   /supabase_kong_poancmeitlmxejofwzuu | id c60a42f259068af05d0cffe4a8a2e21e49378fe644d69c1d0a144c747a20ba10 | created 2026-08-09T22:30:37.447243163Z | image public.ecr.aws/supabase/kong:2.8.1 | ports {\"8000/tcp\":[{\"HostIp\":\"\",\"HostPort\":\"54321\"}]}\n26:   /supabase_pg_meta_poancmeitlmxejofwzuu | id dd9e8be3bb873f596ff92236e3d604ac10303cd5da8c5227e50e7b9f6d54dafd | created 2026-08-09T22:30:41.700396649Z | image public.ecr.aws/supabase/postgres-meta:v0.96.6 | ports {}\n27:   /supabase_realtime_poancmeitlmxejofwzuu | id e1a443bf280ab38ab8bf6cfdc3947bda9540f0fda03557188b94d50a0ca75f2b | created 2026-08-09T22:30:39.298314473Z | image public.ecr.aws/supabase/realtime:v2.113.4 | ports {}\n28:   /supabase_rest_poancmeitlmxejofwzuu | id 720fc47910c49a2e12f0b6ef8386a29b651ed61ba01611aad962c580f2a798ef | created 2026-08-09T22:30:39.873216866Z | image public.ecr.aws/supabase/postgrest:v14.15 | ports {}\n29:   /supabase_storage_poancmeitlmxejofwzuu | id e38f52bfb2c2b847d7b28db03b04c921cfaef24e4e680b25feb9