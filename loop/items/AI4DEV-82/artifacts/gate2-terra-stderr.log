 309: # ---- usage-window watchdog: the sensor, the spawn gate, the per-tool alarm and the prompt stamp
 310: # must agree about one synthetic reading. It owns its own PASS/FAIL lines, so only its verdict is
 311: # folded here; its failures are echoed so a red names itself without a second run.
 312: $watchdog = @(& powershell -NoProfile -File (Join-Path $here 'window-watchdog-drill.ps1'))
 313: $watchdogCode = $LASTEXITCODE
 314: Assert 'window-watchdog' 'the usage-window watchdog holds at every checkpoint' ($watchdogCode -eq 0)
 315: if ($watchdogCode -ne 0) {
 316:     foreach ($w in $watchdog) { if ($w -match '^\s*FAIL' -or $w -match '^ABORTING') { Write-Output ('      ' + $w) } }
 317: }
 318: 
 319: # ---- Report ----
 320: # COMPUTED AFTER EVERY ASSERT, deliberately. See the note above the folded guards.
 321: $failed = @($results | Where-Object { -not $_.Pass })
 322: 
 323: foreach ($r in $results) {
 324:     $mark = if ($r.Pass) { 'PASS' } else { 'FAIL' }
 325:     Write-Output ('{0}  [{1}] {2}' -f $mark, $r.Drill, $r.Claim)
 326: }
 327: Write-Output ''
 328: Write-Output ('{0} of {1} assertions green' -f (@($results | Where-Object { $_.Pass }).Count), $results.Count)
 329: if ($failed.Count -gt 0) {
 330:     Write-Output 'RED - the hand-offs above broke.'
 331:     exit 1
 332: }
 333: Write-Output 'All control hand-offs held.'
 334: exit 0

