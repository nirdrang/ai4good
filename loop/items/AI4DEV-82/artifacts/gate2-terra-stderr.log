de\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\loop\\\\items\\\\AI4DEV-79\\\\artifacts\\\\audit-flash-output.pid\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\loop\\\\items\\\\AI4DEV-79\\\\artifacts\\\\audit-flash-output.events.jsonl\",\"metadata\":{\"count\":36,\"truncated\":false},\"title\":\"\",\"time\":{\"start\":1786349831076,\"end\":1786349831142}},\"id\":\"prt_feabf4334001xKkCrJ8YVMG4rW\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"messageID\":\"msg_feabeffb8001ZG6ZlgIwLjekMR\"}}\r\n+{\"type\":\"text\",\"timestamp\":1786349831312,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feabf42c7001K20gyYlfaqCyVC\",\"messageID\":\"msg_feabeffb8001ZG6ZlgIwLjekMR\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"type\":\"text\",\"text\":\"Now let me look at the git state and the diff scope.\",\"time\":{\"start\":1786349830855,\"end\":1786349831309}}}\r\n+{\"type\":\"tool_use\",\"timestamp\":1786349831321,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"type\":\"tool\",\"tool\":\"glob\",\"callID\":\"call_01_Jfo1tU7iRctJ2VWMtLu11145\",\"state\":{\"status\":\"completed\",\"input\":{\"pattern\":\"tests/at/harness/*\"},\"output\":\"C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\oracles.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\oracles.selftest.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\index.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\guards.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\fixtures.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\faults.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\registry.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\expected.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\expected.selftest.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\db-pool.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\db-pool.selftest.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\contracts.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\conformance.selftest.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\config.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\clock.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\check.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\capabilities.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\atconfig.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\record-oracles.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\runner.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\runner.selftest.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\runner-expect.selftest.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\runner-blackbox.selftest.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\vendors.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\vendors.selftest.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\type-invention.selftest.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\suite-adapters.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\shipped-verification.selftest.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\sentinels.ts\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\req016-oracles.selftest.ts\",\"metadata\":{\"count\":30,\"truncated\":false},\"title\":\"\",\"time\":{\"start\":1786349831264,\"end\":1786349831318}},\"id\":\"prt_feabf43c60018PUnxyn6CTq7Zp\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"messageID\":\"msg_feabeffb8001ZG6ZlgIwLjekMR\"}}\r\n+{\"type\":\"step_finish\",\"timestamp\":1786349831751,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feabf462d001GLT5kWuslYDGDE\",\"reason\":\"tool-calls\",\"snapshot\":\"0d5714e6c95b562a54393b639047abb52ac16685\",\"messageID\":\"msg_feabeffb8001ZG6ZlgIwLjekMR\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"type\":\"step-finish\",\"tokens\":{\"total\":30013,\"input\":5239,\"output\":100,\"reasoning\":226,\"cache\":{\"write\":0,\"read\":24448}},\"cost\":0.0004465972}}\r\n+{\"type\":\"step_start\",\"timestamp\":1786349846536,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feabf8005001HnmhHsdBhWrYPa\",\"messageID\":\"msg_feabf480d001BtXcgLc77qaukr\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"snapshot\":\"a33fb8fef8490069461118f4ec11e40f6038c5fb\",\"type\":\"step-start\"}}\r\n+{\"type\":\"tool_use\",\"timestamp\":1786349850317,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"type\":\"tool\",\"tool\":\"read\",\"callID\":\"call_00_ZonrKmTIpFna9RwwUBg69109\",\"state\":{\"status\":\"completed\",\"input\":{\"filePath\":\"C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\db-pool.ts\"},\"output\":\"<path>C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\db-pool.ts</path>\\n<type>file</type>\\n<content>\\n1: /**\\n2:  * The local database slot pool — a small number of standing Supabase stacks (\\\"slots\\\") so that\\n3:  * several items can verify at the same time without resetting each other's database.\\n4:  *\\n5:  * THE SHAPE, as ruled:\\n6:  *\\n7:  *   - Two standing slots. Concurrency is the pool size; a full pool REJECTS the next\\n8:  *     database-needing item at start rather than queueing it.\\n9:  *   - The stack on the 54321 block is the founder's personal stack. It is OUTSIDE the pool and\\n10:  *     untouchable, and `personalBlockProblems` below makes that a check in code rather than a\\n11:  *     convention: no slot may carry the repo's project id, a port in 54320–54329, or inspector\\n12:  *     port 8083, and the check runs before anything destructive, every time.\\n13:  *   - One claim file per slot, two states, three owners: the coordinator RESERVES a slot when an\\n14:  *     item starts, the harness runner OCCUPIES it for each verify window, the coordinator\\n15:  *     RELEASES the reservation at the item sweep.\\n16:  *   - STATE IS NEVER INHERITED. The first act of every occupancy is to copy the item tree's own\\n17:  *     `supabase/` directory into the slot and reset the database from it. The previous holder is\\n18:  *     never trusted, including a crashed one.\\n19:  *   - IDENTITY IS PERMANENT, EVERYTHING ELSE IS DATA. A slot permanently owns its project id and\\n20:  *     its port block; every other setting comes from the item tree's own `config.toml` on every\\n21:  *     occupancy, because auth flags and seed paths change per item and a stack started with a\\n22:  *     stale one would grade the wrong behaviour.\\n23:  *\\n24:  * WHY THE CONFIG IS REGENERATED RATHER THAN COPIED OR FROZEN: a frozen slot config drifts from\\n25:  * the item tree, and a copied one carries the personal stack's identity straight into the slot.\\n26:  * Regeneration takes the item tree's file verbatim and overlays ONLY the identity fields, so a\\n27:  * slot is always the item's own configuration wearing the slot's identity.\\n28:  *\\n29:  * WHY THIS FILE OWNS ALL THE TOML: the PowerShell helpers in `loop/work/db-slots.ps1` do file\\n30:  * operations only — reserve, release, list. If both sides generated configs, the overlay rule\\n31:  * could fork, and two rules for one identity is how a slot ends up on a personal port.\\n32:  *\\n33:  * The import of `runner.ts` is deliberate and the cycle it forms with the runner's own import of\\n34:  * this file is safe: neither module calls the other at module scope, and both sides export\\n35:  * hoisted function declarations.\\n36:  */\\n37: \\n38: import { spawnSync } from 'node:child_process';\\n39: import { createHash } from 'node:crypto';\\n40: import { cpSync, existsSync, mkdirSync, readFileSync, readdirSync, rmSync, writeFileSync } from 'node:fs';\\n41: import { hostname, tmpdir } from 'node:os';\\n42: import { isAbsolute, join, relative, resolve } from 'node:path';\\n43: \\n44: import { REPO_ROOT } from './check.ts';\\n45: import {\\n46:   acquireStackLock,\\n47:   childEnv,\\n48:   diagnostic,\\n49:   localStackProblems,\\n50:   parseStackStatus,\\n51:   proveMigrationsReplayed,\\n52:   readLocalConfig,\\n53:   readStackStatus,\\n54:   resetLocalDatabase,\\n55:   runSupabaseCli,\\n56:   stackLockPath,\\n57:   waitForReady,\\n58:   type CliResult,\\n59:   type CliTarget,\\n60:   type Holder,\\n61:   type LocalConfig,\\n62:   type MigrationProof,\\n63:   type StackLock,\\n64:   type StackStatus,\\n65: } from './runner.ts';\\n66: \\n67: /** Ruled: two standing slots. Concurrency IS the pool size. */\\n68: export const POOL_SIZE = 2;\\n69: \\n70: /** The founder's personal stack. Nothing in the pool may carry any of these. */\\n71: const PERSONAL_PORT_LOW = 54320;\\n72: const PERSONAL_PORT_HIGH = 54329;\\n73: const PERSONAL_INSPECTOR_PORT = 8083;\\n74: \\n75: /** The band a port must sit in for the slot overlay to know how to move it. */\\n76: const MAPPABLE_PORT_LOW = 54000;\\n77: const MAPPABLE_PORT_HIGH = 54999;\\n78: \\n79: /* ------------------------------------------------------------------------------ pool locations */\\n80: \\n81: /**\\n82:  * The pool lives beside the locks it cooperates with and OUTSIDE every worktree: a slot outlives\\n83:  * the item that used it, and a directory inside a worktree dies with the worktree.\\n84:  *\\n85:  * `AT_DB_POOL_ROOT` overrides it for the selftests, the same pattern as `AT_REPO_ROOT`.\\n86:  */\\n87: export function poolRoot(): string {\\n88:   const override = process.env.AT_DB_POOL_ROOT?.trim();\\n89:   const dir = override\\n90:     ? override\\n91:     : join(process.env.LOCALAPPDATA ?? process.env.XDG_CACHE_HOME ?? tmpdir(), 'ai4good-build', 'db-slots');\\n92:   mkdirSync(dir, { recursive: true });\\n93:   return dir;\\n94: }\\n95: \\n96: /** Slot numbers are 1..POOL_SIZE. Anything else is a caller error, named rather than clamped. */\\n97: export function assertSlotNumber(slot: number): number {\\n98:   if (!Number.isInteger(slot) || slot < 1 || slot > POOL_SIZE) {\\n99:     throw new Error(`\\\"${slot}\\\" is not a slot in this pool — the slots are 1 to ${POOL_SIZE}`);\\n100:   }\\n101:   return slot;\\n102: }\\n103: \\n104: /** The directory that CONTAINS the slot's `supabase/` project folder — what `--workdir` names. */\\n105: export function slotDir(slot: number): string {\\n106:   return join(poolRoot(), `slot-${assertSlotNumber(slot)}`);\\n107: }\\n108: \\n109: export function slotConfigPath(slot: number): string {\\n110:   return join(slotDir(slot), 'supabase', 'config.toml');\\n111: }\\n112: \\n113: /** Written only after a successful start; see `prepare`. */\\n114: export function slotMarkerPath(slot: number): string {\\n115:   return join(slotDir(slot), '.last-start.json');\\n116: }\\n117: \\n118: export function reservationPath(slot: number): string {\\n119:   return join(poolRoot(), 'reservations', `slot-${assertSlotNumber(slot)}.json`);\\n120: }\\n121: \\n122: /** A distinct project id is what gives a slot distinct Docker containers and volumes. */\\n123: export function slotProjectId(slot: number): string {\\n124:   return `ai4good-slot-${assertSlotNumber(slot)}`;\\n125: }\\n126: \\n127: /**\\n128:  * A slot's PERMANENT identity, used for one purpose: naming the occupancy claim file (ruling T6).\\n129:  *\\n130:  * The runner's claim path is built from a project id and an api port, and for a repository stack\\n131:  * both are permanent. A SLOT's ports are not: `prepare` lawfully rewrites them from the item\\n132:  * tree's own config on every occupancy, so two runs bracketing a port change would hold two\\n133:  * DIFFERENT claim files for one slot and neither would see the other. The claim therefore keys on\\n134:  * the slot's project id — which never changes — and on a fixed sentinel in place of the port.\\n135:  *\\n136:  * The sentinel is 0, which is not a port. It only has to be constant. The PowerShell helper globs\\n137:  * `at-verify-ai4good-slot-N-*.lock`, so it matches this and every earlier name unchanged.\\n138:  */\\n139: export function slotClaimKey(slot: number): LocalConfig {\\n140:   return { projectId: slotProjectId(slot), apiPort: 0, dbPort: 0 };\\n141: }\\n142: \\n143: /* --------------------------------------------------------------------------- config.toml scan */\\n144: \\n145: interface ConfigEntry {\\n146:   line: number;\\n147:   section: string;\\n148:   key: string;\\n149:   value: string;\\n150: }\\n151: \\n152: /**\\n153:  * Every ACTIVE `key = value` in the file, with the section it sits in. Commented lines are not\\n154:  * settings and are skipped — which is the whole reason the scan is section-aware rather than a\\n155:  * set of regular expressions over the file: `port` appears in nine places and most of them are\\n156:  * examples in comments.\\n157:  *\\n158:  * Multi-line array values are not read as one value. Nothing in this repo's config uses one, and\\n159:  * a value this scanner cannot see is a value it never rewrites, so the failure mode is a config\\n160:  * that is copied verbatim rather than one that is silently mis-edited.\\n161:  */\\n162: export function scanConfig(text: string): ConfigEntry[] {\\n163:   const entries: ConfigEntry[] = [];\\n164:   let section = '';\\n165:   const lines = text.split('\\\\n');\\n166:   for (let index = 0; index < lines.length; index++) {\\n167:     const line = lines[index].trim();\\n168:     if (line.startsWith('#') || line === '') continue;\\n169:     const header = /^\\\\[([^\\\\]]+)\\\\]/.exec(line);\\n170:     if (header) {\\n171:       section = header[1];\\n172:       continue;\\n173:     }\\n174:     const setting = /^([A-Za-z_][A-Za-z0-9_]*)\\\\s*=\\\\s*(.*)$/.exec(line);\\n175:     if (setting) entries.push({ line: index, section, key: setting[1], value: setting[2].trim() });\\n176:   }\\n177:   return entries;\\n178: }\\n179: \\n180: function isPortKey(key: string): boolean {\\n181:   return key === 'port' || key.endsWith('_port');\\n182: }\\n183: \\n184: /**\\n185:  * THE LOCAL STACK'S OWN LISTENER PORTS — the only ports a slot's identity moves (ruling E4).\\n186:  *\\n187:  * A `config.toml` holds two kinds of port. A LISTENER port is a socket this machine opens for\\n188:  * this stack, so two stacks that share one collide, and the overlay must move it. A CLIENT port\\n189:  * is part of an address of somebody else's service — `[auth.email.smtp] port = 587` is Postmark's\\n190:  * port, not ours — so it is DATA, and moving it or refusing it would break a slot that is\\n191:  * configured exactly like the tree it grades.\\n192:  *\\n193:  * The list is exact section + key pairs, so `[api] port` moves while `[api.tls] port` (were one\\n194:  * added) does not silently inherit the rule.\\n195:  */\\n196: const LISTENER_PORTS: readonly { section: string; key: string }[] = [\\n197:   { section: 'api', key: 'port' },\\n198:   { section: 'db', key: 'port' },\\n199:   { section: 'db', key: 'shadow_port' },\\n200:   { section: 'db.pooler', key: 'port' },\\n201:   { section: 'studio', key: 'port' },\\n202:   { section: 'local_smtp', key: 'port' },\\n203:   { section: 'local_smtp', key: 'smtp_port' },\\n204:   { section: 'local_smtp', key: 'pop3_port' },\\n205:   { section: 'analytics', key: 'port' },\\n206:   { section: 'edge_runtime', key: 'inspector_port' },\\n207: ];\\n208: \\n209: function isListenerPort(section: string, key: string): boolean {\\n210:   return LISTENER_PORTS.some((listener) => listener.section === section && listener.key === key);\\n211: }\\n212: \\n213: export interface PortMapping {\\n214:   section: string;\\n215:   key: string;\\n216:   line: number;\\n217:   from: number;\\n218:   to: number;\\n219: }\\n220: \\n221: /**\\n222:  * The identity overlay's port rule (ruling E4).\\n223:  *\\n224:  *   - a LISTENER port (see `LISTENER_PORTS`) in 54000–54999 moves by 1000 per slot;\\n225:  *     `edge_runtime.inspector_port` set to EXACTLY 8083 moves by 10 per slot, because the ruled\\n226:  *     inspector value is 8083 and it is not in that band. Any OTHER inspector value falls to the\\n227:  *     generic rule below, so it maps when it is in band and refuses when it is not — a +10 applied\\n228:  *     to a value nobody ruled is a guess, and D2 forbids guesses.\\n229:  *   - a listener port outside those bands REFUSES loudly as unmappable. A guess here is a port\\n230:  *     collision with software nobody in this process knows about, so a person decides.\\n231:  *   - any OTHER port-valued key passes through unchanged: it addresses somebody else's service and\\n232:  *     is data, not identity.\\n233:  *   - except that a non-listener port sitting in 54000–54999 also REFUSES. It looks exactly like a\\n234:  *     local stack port and this rule does not recognise it, and treating an unrecognised local port\\n235:  *     as data would hand two slots the same socket. Fail closed, and a person decides.\\n236:  *\\n237:  * `personalBlockProblems` stays broad over EVERY port key regardless of this rule, so a port in the\\n238:  * founder's own block can never reach a slot by being classified as data.\\n239:  */\\n240: export function portMappings(text: string, slot: number): { mappings: PortMapping[]; problems: string[] } {\\n241:   assertSlotNumber(slot);\\n242:   const mappings: PortMapping[] = [];\\n243:   const problems: string[] = [];\\n244: \\n245:   for (const entry of scanConfig(text)) {\\n246:     if (!isPortKey(entry.key)) continue;\\n247:     const literal = /^(\\\\d+)/.exec(entry.value);\\n248:     const from = literal ? Number(literal[1]) : NaN;\\n249:     const listener = isListenerPort(entry.section, entry.key);\\n250: \\n251:     if (!listener) {\\n252:       if (Number.isFinite(from) && from >= MAPPABLE_PORT_LOW && from <= MAPPABLE_PORT_HIGH) {\\n253:         problems.push(\\n254:           `[${entry.section}] ${entry.key} = ${from} is not a listener port this rule knows, but it sits in the local ` +\\n255:             `stack's band ${MAPPABLE_PORT_LOW}–${MAPPABLE_PORT_HIGH} — decide by hand whether the slot moves it`,\\n256:         );\\n257:       }\\n258:       continue; // a client-connection port is data and travels unchanged\\n259:     }\\n260: \\n261:     if (!literal) {\\n262:       problems.push(`[${entry.section}] ${entry.key} = ${entry.value} is not a plain port number, so the slot overlay cannot move it`);\\n263:       continue;\\n264:     }\\n265:     if (entry.section === 'edge_runtime' && entry.key === 'inspector_port' && from === PERSONAL_INSPECTOR_PORT) {\\n266:       mappings.push({ section: entry.section, key: entry.key, line: entry.line, from, to: from + slot * 10 });\\n267:       continue;\\n268:     }\\n269:     if (from >= MAPPABLE_PORT_LOW && from <= MAPPABLE_PORT_HIGH) {\\n270:       mappings.push({ section: entry.section, key: entry.key, line: entry.line, from, to: from + slot * 1000 });\\n271:       continue;\\n272:     }\\n273:     problems.push(\\n274:       `[${entry.section}] ${entry.key} = ${from} is outside ${MAPPABLE_PORT_LOW}–${MAPPABLE_PORT_HIGH}, so the slot ` +\\n275:         `overlay does not know where to move it — decide the slot's port for this setting by hand`,\\n276:     );\\n277:   }\\n278: \\n279:   return { mappings, problems };\\n280: }\\n281: \\n282: /**\\n283:  * The item tree's own config, wearing the slot's identity. Everything that is not an identity\\n284:  * field is returned byte for byte, including comments, blank lines and line endings — a\\n285:  * regenerated config differing anywhere else would mean the slot grades different behaviour from\\n286:  * the tree that asked for the run.\\n287:  */\\n288: export function generateSlotConfig(sourceText: string, slot: number): string {\\n289:   assertSlotNumber(slot);\\n290:   const { mappings, problems } = portMappings(sourceText, slot);\\n291:   if (problems.length) {\\n292:     throw new Error(`the slot ${slot} config cannot be generated from this supabase/config.toml — ${problems.join('; ')}`);\\n293:   }\\n294: \\n295:   const projectIdEntry = scanConfig(sourceText).find((entry) => entry.section === '' && entry.key === 'project_id');\\n296:   if (!projectIdEntry) throw new Error('supabase/config.toml carries no top-level project_id, so a slot identity cannot be built from it');\\n297: \\n298:   const lines = sourceText.split('\\\\n');\\n299:   lines[projectIdEntry.line] = lines[projectIdEntry.line].replace(/^(\\\\s*project_id\\\\s*=\\\\s*)\\\"[^\\\"]*\\\"/, `$1\\\"${slotProjectId(slot)}\\\"`);\\n300:   for (const mapping of mappings) {\\n301:     const pattern = new RegExp(`^(\\\\\\\\s*${mapping.key}\\\\\\\\s*=\\\\\\\\s*)\\\\\\\\d+`);\\n302:     lines[mapping.line] = lines[mapping.line].replace(pattern, `$1${mapping.to}`);\\n303:   }\\n304:   return lines.join('\\\\n');\\n305: }\\n306: \\n307: /* ------------------------------------------------------- the personal stack, refused in code */\\n308: \\n309: /**\\n310:  * The \\\"untouchable\\\" ruling as an executable guard. Called before every destructive act and before\\n311:  * any env is emitted, because a convention that is only written down is one a later change can\\n312:  * step over without noticing.\\n313:  *\\n314:  * It scans EVERY active port-valued key, not a fixed list: the danger is a port in the personal\\n315:  * block reaching a slot, and it does not matter which setting carried it there.\\n316:  */\\n317: export function personalBlockProblems(slotConfigText: string, personalProjectId: string): string[] {\\n318:   const problems: string[] = [];\\n319:   const entries = scanConfig(slotConfigText);\\n320: \\n321:   const projectId = entries.find((entry) => entry.section === '' && entry.key === 'project_id');\\n322:   const value = /^\\\"([^\\\"]*)\\\"/.exec(projectId?.value ?? '')?.[1] ?? '';\\n323:   if (!value) problems.push('the slot config carries no project_id, so it cannot be told apart from the personal stack');\\n324:   else if (value === personalProjectId) problems.push(`the slot config carries the personal stack's project id \\\"${personalProjectId}\\\"`);\\n325: \\n326:   for (const entry of entries) {\\n327:     if (!isPortKey(entry.key)) continue;\\n328:     const port = Number(/^(\\\\d+)/.exec(entry.value)?.[1] ?? NaN);\\n329:     if (!Number.isFinite(port)) continue;\\n330:     if (port >= PERSONAL_PORT_LOW && port <= PERSONAL_PORT_HIGH) {\\n331:       problems.push(`[${entry.section}] ${entry.key} = ${port} is inside the personal stack's port block ${PERSONAL_PORT_LOW}–${PERSONAL_PORT_HIGH}`);\\n332:     }\\n333:     if (entry.key === 'inspector_port' && port === PERSONAL_INSPECTOR_PORT) {\\n334:       problems.push(`[${entry.section}] inspector_port = ${port} is the personal stack's inspector port`);\\n335:     }\\n336:   }\\n337: \\n338:   return problems;\\n339: }\\n340: \\n341: /** The identity the pool must never wear. Read from the item tree, never hard-coded. */\\n342: export function personalProjectId(itemRoot: string = REPO_ROOT): string {\\n343:   return readLocalConfig(itemRoot).projectId;\\n344: }\\n345: \\n346: function refusePersonal(slotConfigText: string, itemRoot: string, act: string): void {\\n347:   const problems = personalBlockProblems(slotConfigText, personalProjectId(itemRoot));\\n348:   if (problems.length) {\\n349:     throw new Error(\\n350:       `refusing to ${act}: this configuration is not provably outside the founder's personal stack. ` +\\n351:         `Failed checks: ${problems.join('; ')}. The personal stack is untouchable, so nothing was done.`,\\n352:     );\\n353:   }\\n354: }\\n355: \\n356: /**\\n357:  * The same guard, over a slot's config AS IT SITS ON DISK (rulings T7 and F1).\\n358:  *\\n359:  * `occupy` and `prepare` run the guard over text they hold in hand. The other three entry points —\\n360:  * reset, stop and the env emitter — are exported and reachable directly, so each runs the guard\\n361:  * for itself over the file. A guard that only the usual caller runs is a convention, not a guard.\\n362:  */\\n363: function refusePersonalSlotConfig(slot: number, itemRoot: string, act: string): void {\\n364:   const configPath = slotConfigPath(slot);\\n365:   if (!existsSync(configPath)) {\\n366:     throw new Error(\\n367:       `refusing to ${act} slot ${slot}: it has no config at ${configPath}, so it cannot be shown to be outside the ` +\\n368:         `founder's personal stack. Run \\\\`bun tests/at/harness/db-pool.ts setup\\\\`. Nothing was done.`,\\n369:     );\\n370:   }\\n371:   refusePersonal(readFileSync(configPath, 'utf8'), itemRoot, `${act} slot ${slot}`);\\n372: }\\n373: \\n374: /* ------------------------------------------------------------------------- the path closure */\\n375: \\n376: /** Config settings whose value names a file or directory the stack has to be able to read. */\\n377: const PATH_KEYS = new Set([\\n378:   'sql_paths',\\n379:   'schema_paths',\\n380:   'content_path',\\n381:   'cert_path',\\n382:   'key_path',\\n383:   'signing_keys_path',\\n384:   'objects_path',\\n385:   'declarative_schema_path',\\n386: ]);\\n387: \\n388: function stringValues(raw: string): string[] {\\n389:   const array = /^\\\\[(.*)\\\\]$/.exec(raw);\\n390:   const body = array ? array[1] : raw;\\n391:   return [...body.matchAll(/\\\"([^\\\"]*)\\\"/g)].map((match) => match[1]).filter((value) => value.trim() !== '');\\n392: }\\n393: \\n394: /**\\n395:  * Fail closed on what the config asks for but the mirror cannot deliver.\\n396:  *\\n397:  * `prepare` mirrors the item tree's whole `supabase/` directory into the slot, so every path\\n398:  * UNDER that directory is provided exactly as the item tree has it — present if present, absent\\n399:  * if absent. A configured path that is absent in the item tree is therefore not a problem: the\\n400:  * slot is then in the same state the repo-configured stack would be in, which is the state the\\n401:  * item asked for. (`[db.seed] sql_paths = [\\\"./seed.sql\\\"]` with no `seed.sql` in the tree is\\n402:  * exactly today's arrangement on the personal stack.)\\n403:  *\\n404:  * A path that points OUTSIDE `supabase/` is a different thing: the mirror cannot deliver it, so\\n405:  * the slot would start half-provisioned and grade against a file it does not have. That refuses\\n406:  * loudly and a person decides. The same applies to the two directories the mirror EXCLUDES\\n407:  * (`MIRROR_EXCLUSIONS`): a config that names a file inside the CLI's own runtime state is naming\\n408:  * something the slot will not have, so the closure stays honest about the exclusions.\\n409:  *\\n410:  * A VALUE THIS SCANNER CANNOT SEE REFUSES rather than passing. `scanConfig` reads one line per\\n411:  * setting, so a multi-line array — `sql_paths = [` on its own line — yields the value `[` and no\\n412:  * paths at all. For the OVERLAY an invisible value is harmless: it is copied verbatim. For the\\n413:  * CLOSURE it is a missed refusal, which is the failure this function exists to prevent.\\n414:  */\\n415: export function pathClosureProblems(configText: string, itemRoot: string): string[] {\\n416:   const problems: string[] = [];\\n417:   const base = resolve(join(itemRoot, 'supabase'));\\n418: \\n419:   for (const entry of scanConfig(configText)) {\\n420:     if (!PATH_KEYS.has(entry.key)) continue;\\n421:     if (entry.value.startsWith('[') && !entry.value.includes(']')) {\\n422:       problems.push(\\n423:         `[${entry.section}] ${entry.key} opens an array that does not close on the same line, so this check ` +\\n424:           `cannot see the paths it names — write the value on one line (${entry.key} = [\\\"./a.sql\\\", \\\"./b.sql\\\"]) ` +\\n425:           `and run this again`,\\n426:       );\\n427:       continue;\\n428:     }\\n429:     for (const value of stringValues(entry.value)) {\\n430:       if (/^[a-z][a-z0-9+.-]*:\\\\/\\\\//i.test(value)) {\\n431:         problems.push(`[${entry.section}] ${entry.key} names \\\"${value}\\\", which is a URL rather than a file the slot can be given`);\\n432:         continue;\\n433:       }\\n434:       if (isAbsolute(value)) {\\n435:         problems.push(`[${entry.section}] ${entry.key} names the absolute path \\\"${value}\\\", which the slot mirror cannot reproduce`);\\n436:         continue;\\n437:       }\\n438:       const target = resolve(base, value);\\n439:       const inside = relative(base, target);\\n440:       if (inside.startsWith('..')) {\\n441:         problems.push(\\n442:           `[${entry.section}] ${entry.key} names \\\"${value}\\\", which is outside supabase/ — the slot mirror copies supabase/ ` +\\n443:             `and nothing else, so this file would be missing from the slot`,\\n444:         );\\n445:         continue;\\n446:       }\\n447:       const first = inside.split(/[\\\\\\\\/]/)[0];\\n448:       if (MIRROR_EXCLUSIONS.includes(first)) {\\n449:         problems.push(\\n450:           `[${entry.section}] ${entry.key} names \\\"${value}\\\", which resolves into supabase/${first} — the slot mirror ` +\\n451:             `deliberately does not copy that directory (it is the CLI's own runtime state about another stack), so ` +\\n452:             `this file would be missing from the slot`,\\n453:         );\\n454:       }\\n455:     }\\n456:   }\\n457: \\n458:   return problems;\\n459: }\\n460: \\n461: /* -------------------------------------------------------------------------------- the mirror */\\n462: \\n463: /**\\n464:  * What the mirror does NOT carry into a slot (rulings T3, F3 and T11). Top-level entries of\\n465:  * `supabase/` only, so the list cannot quietly grow into a filter on file names.\\n466:  *\\n467:  *   - `.temp` and `.branches` are the CLI's OWN RUNTIME STATE, not project source. `.temp` holds\\n468:  *     the CLI's record of the stack it last ran — the founder's personal one — and `.gitignore`\\n469:  *     itself says its `start-secrets/**` \\\"must NEVER be committed\\\". Copying it carries another\\n470:  *     stack's identity residue and its secrets into every slot.\\n471:  *   - `config.toml` is the slot's IDENTITY, and the item tree's copy carries the personal\\n472:  *     identity. Excluding it means no slot config ever holds that identity, not even for the\\n473:  *     instant between the mirror and the regenerated write — and a crash in that instant leaves\\n474:  *     NO config rather than a personal one.\\n475:  */\\n476: export const MIRROR_EXCLUSIONS: readonly string[] = ['.temp', '.branches', 'config.toml'];\\n477: \\n478: /**\\n479:  * Every symlink under a directory tree. A pre-copy scan, because a symlink is not a file the\\n480:  * mirror can reproduce: `cpSync` would copy it as a link, and the link points wherever it likes —\\n481:  * including straight back at the personal stack's own directory.\\n482:  */\\n483: function symlinksUnder(dir: string): string[] {\\n484:   const found: string[] = [];\\n485:   const walk = (current: string): void => {\\n486:     for (const entry of readdirSync(current, { withFileTypes: true })) {\\n487:       const full = join(current, entry.name);\\n488:       if (entry.isSymbolicLink()) {\\n489:         found.push(full);\\n490:         continue; // never follow it — that is the whole point\\n491:       }\\n492:       if (entry.isDirectory()) walk(full);\\n493:     }\\n494:   };\\n495:   walk(dir);\\n496:   return found;\\n497: }\\n498: \\n499: /**\\n500:  * Copy the item tree's `supabase/` into the slot, having first removed the slot's copy.\\n501:  *\\n502:  * DELETE THEN COPY, never merge: the previous holder's leftover migration or leftover function is\\n503:  * exactly the state this pool exists to make impossible.\\n504:  *\\n505:  * THE PROJECT SOURCE ENTIRE, and nothing else (ruling E3 as narrowed by T3, F3 and T11). Every\\n506:  * path the config names under `supabase/` arrives in the slot exactly as the item tree has it —\\n507:  * present if present, absent if absent — and `pathClosureProblems` refuses any config path that\\n508:  * names one of the three excluded entries, so the closure guarantee stays honest about them.\\n509:  * (`README.md` and `.gitkeep` therefore travel into the slot's `migrations/` too. The CLI reads\\n510:  * only `<timestamp>_name.sql` there, and the runner's migration proof counts exactly those.)\\n511:  *\\n512:  * A SYMLINK ANYWHERE UNDER `supabase/` REFUSES THE WHOLE MIRROR (ruling T13). The tree carries\\n513:  * none today, so nothing breaks; one smuggled in later refuses loudly instead of being copied as\\n514:  * a link into a directory the pool then resets.\\n515:  */\\n516: export function mirrorItemTree(itemRoot: string, slot: number): void {\\n517:   const source = join(itemRoot, 'supabase');\\n518:   const destination = join(slotDir(slot), 'supabase');\\n519:   if (!existsSync(source)) throw new Error(`${source} does not exist — there is no project to give the slot`);\\n520: \\n521:   const links = symlinksUnder(source);\\n522:   if (links.length) {\\n523:     throw new Error(\\n524:       `refusing to mirror ${source} into slot ${slot}: it contains ${links.length} symlink(s) — ${links.join(', ')}. ` +\\n525:         `A symlink is not a file the mirror can reproduce, and a link copied into a slot points wherever it likes, ` +\\n526:         `including outside the pool. Replace them with real files, or decide by hand. Nothing was copied.`,\\n527:     );\\n528:   }\\n529: \\n530:   rmSync(destination, { recursive: true, force: true });\\n531:   mkdirSync(destination, { recursive: true });\\n532:   cpSync(source, destination, {\\n533:     recursive: true,\\n534:     filter: (from: string) => {\\n535:       const inside = relative(source, from);\\n536:       if (inside === '') return true;\\n537:       return !MIRROR_EXCLUSIONS.includes(inside.split(/[\\\\\\\\/]/)[0]);\\n538:     },\\n539:   });\\n540: }\\n541: \\n542: /* --------------------------------------------------------------------------- the reservation */\\n543: \\n544: export interface Reservation {\\n545:   slot: number;\\n546:   item: string;\\n547:   branch: string;\\n548:   at: string;\\n549:   holder: string;\\n550: }\\n551: \\n552: export function readReservation(slot: number): Reservation | null {\\n553:   try {\\n554:     return JSON.parse(readFileSync(reservationPath(slot), 'utf8')) as Reservation;\\n555:   } catch {\\n556:     return null;\\n557:   }\\n558: }\\n559: \\n560: /** The slot reserved for this item, or null. Derived from the file, never declared by a caller. */\\n561: export function slotForItem(item: string): number | null {\\n562:   for (let slot = 1; slot <= POOL_SIZE; slot++) {\\n563:     if (readReservation(slot)?.item === item) return slot;\\n564:   }\\n565:   return null;\\n566: }\\n567: \\n568: /**\\n569:  * The item id a branch names — a pure function over the branch string, and it FAILS CLOSED.\\n570:  *\\n571:  * Exactly one id, or it refuses naming the condition. Never the first match of several: a branch\\n572:  * carrying two ids is a question about which item is being verified, and answering it by\\n573:  * position would attach a run, a reservation and a database to the wrong item silently.\\n574:  */\\n575: export function itemFromBranch(branch: string): string {\\n576:   const raw = String(branch ?? '').trim();\\n577:   if (raw === '') throw new Error('the branch name is empty, so no item id can be derived from it');\\n578:   if (raw === 'HEAD') throw new Error('HEAD is detached, so the branch names no item — check out the item branch, or set AT_DB_SLOT');\\n579: \\n580:   const ids = [...new Set([...raw.matchAll(/\\\\b(ai4dev|ai4pm)-(\\\\d+)\\\\b/gi)].map((match) => `${match[1].toUpperCase()}-${Number(match[2])}`))];\\n581:   if (ids.length === 0) throw new Error(`the branch \\\"${raw}\\\" names no item id, so no reserved slot can be found for it`);\\n582:   if (ids.length > 1) throw new Error(`the branch \\\"${raw}\\\" names ${ids.length} item ids (${ids.join(', ')}) — a person decides which one this run verifies`);\\n583:   return ids[0];\\n584: }\\n585: \\n586: /** The branch this tree is on. A git failure refuses; it never falls back to a guess. */\\n587: export function currentBranch(root: string = REPO_ROOT): string {\\n588:   const res = spawnSync('git', ['-C', root, 'rev-parse', '--abbrev-ref', 'HEAD'], { encoding: 'utf8', env: childEnv() });\\n589:   if (res.error) throw new Error(`git could not be run to read the current branch (${diagnostic((res.error as Error).message)})`);\\n590:   if (res.status !== 0) throw new Error(`git could not report the current branch (exit ${res.status}): ${diagnostic(res.stderr) || '(no error output)'}`);\\n591:   return (res.stdout ?? '').trim();\\n592: }\\n593: \\n594: /* ------------------------------------------------------------------------------- the pool view */\\n595: \\n596: export interface PoolSlotView {\\n597:   slot: number;\\n598:   dir: string;\\n599:   configured: boolean;\\n600:   projectId: string | null;\\n601:   apiPort: number | null;\\n602:   dbPort: number | null;\\n603:   reservation: Reservation | null;\\n604:   occupiedBy: Holder | null;\\n605: }\\n606: \\n607: /** What the pool looks like right now — for the setup report, the helpers, and a person asking. */\\n608: export function readPool(): PoolSlotView[] {\\n609:   const views: PoolSlotView[] = [];\\n610:   for (let slot = 1; slot <= POOL_SIZE; slot++) {\\n611:     const dir = slotDir(slot);\\n612:     let config: LocalConfig | null = null;\\n613:     try {\\n614:       config = readLocalConfig(dir);\\n615:     } catch {\\n616:       config = null;\\n617:     }\\n618:     // The claim is keyed on the slot's PERMANENT identity (ruling T6), so this read finds it even\\n619:     // when the slot has no config yet and even after `prepare` has moved the slot's ports.\\n620:     let occupiedBy: Holder | null = null;\\n621:     try {\\n622:       occupiedBy = JSON.parse(readFileSync(stackLockPath(slotClaimKey(slot)), 'utf8')) as Holder;\\n623:     } catch {\\n624:       occupiedBy = null;\\n625:     }\\n626:     views.push({\\n627:       slot,\\n628:       dir,\\n629:       configured: config !== null,\\n630:       projectId: config?.projectId ?? null,\\n631:       apiPort: config?.apiPort ?? null,\\n632:       dbPort: config?.dbPort ?? null,\\n633:       reservation: readReservation(slot),\\n634:       occupiedBy,\\n635:     });\\n636:   }\\n637:   return views;\\n638: }\\n639: \\n640: /* ---------------------------------------------------------------------------------- occupancy */\\n641: \\n642: export interface Occupancy {\\n643:   slot: number;\\n644:   dir: string;\\n645:   config: LocalConfig;\\n646:   /** The item this occupancy belongs to, or `null` when it came from the AT_DB_SLOT override. */\\n647:   item: string | null;\\n648:   via: 'reservation' | 'override';\\n649:   claim: StackLock;\\n650:   release(): void;\\n651: }\\n652: \\n653: export interface OccupyOptions {\\n654:   /** The item id. Derived from the branch when absent. */\\n655:   item?: string;\\n656:   /** The AT_DB_SLOT override — for runs outside an item: the founder, the evidence gate, a spike. */\\n657:   slot?: number;\\n658: }\\n659: \\n660: /**\\n661:  * Take a slot for one verify window.\\n662:  *\\n663:  * ADMISSION CONTROL IS THE COORDINATOR'S, NOT THE RUNNER'S. A run whose item holds no reservation\\n664:  * refuses and names the helper that makes one; it never falls back onto a free slot, because a\\n665:  * silent fallback is how a pool of two quietly becomes a pool of one shared stack.\\n666:  *\\n667:  * The claim is the runner's existing stack lock, with the takeover policy the ruled text asks\\n668:  * for: a DEAD holder pid is broken loudly, a live holder is never displaced at any age.\\n669:  *\\n670:  * THE OVERRIDE SKIPS ADMISSION CONTROL, NOT OWNERSHIP (ruling T5). `AT_DB_SLOT` is ruled — the\\n671:  * founder, the evidence gate and the spike all use it — and slot STATE is disposable by design, so\\n672:  * the reservation is not what protects a slot; the occupancy claim is, and the override keeps it.\\n673:  * But taking a slot another item is holding is a silent collision and costs nothing to refuse, so\\n674:  * an override run refuses loudly when the target slot's reservation names a DIFFERENT item than\\n675:  * this run can derive. A run that can derive no item at all treats ANY reservation as foreign.\\n676:  */\\n677: export function occupy(requirement: string, options: OccupyOptions = {}): Occupancy {\\n678:   let slot: number;\\n679:   let item: string | null = null;\\n680:   let via: 'reservation' | 'override';\\n681: \\n682:   if (options.slot !== undefined) {\\n683:     slot = assertSlotNumber(options.slot);\\n684:     item = options.item ?? null;\\n685:     via = 'override';\\n686: \\n687:     let derived: string | null = options.item ?? null;\\n688:     if (derived === null) {\\n689:       try {\\n690:         derived = itemFromBranch(currentBranch());\\n691:       } catch {\\n692:         derived = null; // no item derivable — every reservation is then somebody else's\\n693:       }\\n694:     }\\n695:     const reserved = readReservation(slot);\\n696:     if (reserved && reserved.item !== derived) {\\n697:       throw new Error(\\n698:         `refusing to take slot ${slot} with AT_DB_SLOT: it is reserved for ${reserved.item} ` +\\n699:           `(branch ${reserved.branch || 'unrecorded'}, taken ${reserved.at}, holder ${reserved.holder}) and this run ` +\\n700:           `${derived === null ? 'can derive no item of its own' : `belongs to ${derived}`}. Every occupancy resets the ` +\\n701:           `slot's database from its own tree, so this run would rebuild that item's database under it. Use a slot the ` +\\n702:           `pool shows free, or release that reservation first.`,\\n703:       );\\n704:     }\\n705:   } else {\\n706:     item = options.item ?? itemFromBranch(currentBranch());\\n707:     const reserved = slotForItem(item);\\n708:     if (reserved === null) {\\n709:       throw new Error(\\n710:         `no database slot is reserved for ${item}. The coordinator reserves a slot when the item starts — ` +\\n711:           `run \\\\`Reserve-DbSlot -Item ${item}\\\\` from loop/work/db-slots.ps1, or set AT_DB_SLOT=<n> for a run ` +\\n712:           `outside an item. There is deliberately no fallback onto a free slot: admission control belongs to ` +\\n713:           `the coordinator, not to this run.`,\\n714:       );\\n715:     }\\n716:     slot = reserved;\\n717:     via = 'reservation';\\n718:   }\\n719: \\n720:   const dir = slotDir(slot);\\n721:   const configPath = slotConfigPath(slot);\\n722:   if (!existsSync(configPath)) {\\n723:     // TWO CAUSES, and the repair is the same one command (ruling T11). Either the pool was never\\n724:     // set up on this machine, or a `prepare` died between the mirror — which removes the slot's\\n725:     // config on purpose, so no slot ever holds the personal identity — and the regenerated write\\n726:     // that immediately follows it. A missing config is the safe end of that window, never a wrong\\n727:     // one, and it is not permanent.\\n728:     throw new Error(\\n729:       `slot ${slot} has no config at ${configPath}. Either the pool was never set up on this machine, or a ` +\\n730:         `previous run stopped between the mirror and the write that follows it — the mirror removes the slot's ` +\\n731:         `config on purpose, so a slot never carries the personal identity even for an instant. Either way the ` +\\n732:         `repair is one command: \\\\`bun tests/at/harness/db-pool.ts setup\\\\`.`,\\n733:     );\\n734:   }\\n735:   refusePersonal(readFileSync(configPath, 'utf8'), REPO_ROOT, `occupy slot ${slot}`);\\n736: \\n737:   const config = readLocalConfig(dir);\\n738:   // Keyed on the slot's PERMANENT identity, never on the config's current ports (ruling T6).\\n739:   const claim = acquireStackLock(slotClaimKey(slot), requirement, { takeover: 'dead-pid-only' });\\n740: \\n741:   // The reservation is re-read AFTER the claim. Between the lookup above and this line the\\n742:   // coordinator may have released the slot and given it to another item, and a run that resets a\\n743:   // database another item now owns is the exact collision this pool exists to prevent.\\n744:   if (via === 'reservation' && item !== null) {\\n745:     const still = readReservation(slot);\\n746:     if (still?.item !== item) {\\n747:       claim.release();\\n748:       throw new Error(\\n749:         `slot ${slot} was reserved for ${item} when this run started and now names ${still?.item ?? 'nobody'} — ` +\\n750:           `the reservation changed under the run, so nothing was reset and nothing was run.`,\\n751:       );\\n752:     }\\n753:   }\\n754: \\n755:   return {\\n756:     slot,\\n757:     dir,\\n758:     config,\\n759:     item,\\n760:     via,\\n761:     claim,\\n762:     release: () => claim.release(),\\n763:   };\\n764: }\\n765: \\n766: /** Release an occupancy. Null-safe so it can sit in a `finally` beside a claim that never happened. */\\n767: export function release(occupancy: Occupancy | null | undefined): void {\\n768:   occupancy?.release();\\n769: }\\n770: \\n771: /* ----------------------------------------------------------------------------------- prepare */\\n772: \\n773: export interface PrepareResult {\\n774:   status: StackStatus;\\n775:   migrations: MigrationProof;\\n776:   /** True when the slot's stack had to be restarted because its configuration changed. */\\n777:   restarted: boolean;\\n778: }\\n779: \\n780: interface StartMarker {\\n781:   configHash: string;\\n782:   at: string;\\n783:   pid: number;\\n784: }\\n785: \\n786: function hashConfig(text: string): string {\\n787:   return createHash('sha256').update(text, 'utf8').digest('hex');\\n788: }\\n789: \\n790: function readMarker(slot: number): StartMarker | null {\\n791:   try {\\n792:     return JSON.parse(readFileSync(slotMarkerPath(slot), 'utf8')) as StartMarker;\\n793:   } catch {\\n794:     return null;\\n795:   }\\n796: }\\n797: \\n798: /**\\n799:  * Run the pinned CLI against one slot. Raw output is never printed: `supabase start` prints keys.\\n800:  *\\n801:  * THIS IS THE ONE HELPER (ruling E1, decision D13). No role hand-writes a slot CLI command: the\\n802:  * incident of 2026-08-09 was a hand-written spike script that closed neither route the identity\\n803:  * override travels by, and it destroyed the founder's database. Everything the wall is made of\\n804:  * lives in `supabaseInvocation` in runner.ts — the positive `SUPABASE_PROJECT_ID`, the refusal of\\n805:  * any other `SUPABASE_*`, `bun --no-env-file`, and the working directory equal to `--workdir` —\\n806:  * and `slotTarget` is the only thing this file has to get right.\\n807:  *\\n808:  * It is for commands that must EXIT ZERO. `status` does not (the config disables imgproxy and the\\n809:  * pooler), so the identity read below runs the CLI through the same seam and parses the result\\n810:  * with the runner's own parser instead.\\n811:  */\\n812: function runSlotCli(slot: number, args: string[], what: string): void {\\n813:   const res = runSupabaseCli(slotTarget(slot), args);\\n814:   if (res.error) {\\n815:     throw new Error(`could not launch the Supabase CLI to ${what} slot ${slot} (${diagnostic(res.error.message)})`);\\n816:   }\\n817:   if (res.status !== 0) {\\n818:     throw new Error(`\\\\`supabase ${args.join(' ')}\\\\` could not ${what} slot ${slot} (exit ${res.status}): ${diagnostic(res.stderr) || diagnostic(res.stdout) || '(no error output)'}`);\\n819:   }\\n820: }\\n821: \\n822: /** Both halves of a slot's identity, in the shape the shared CLI seam takes. */\\n823: export function slotTarget(slot: number): CliTarget {\\n824:   return { workdir: slotDir(slot), projectId: slotProjectId(slot) };\\n825: }\\n826: \\n827: /**\\n828:  * The Supabase container names in a piece of CLI output that do NOT belong to this slot.\\n829:  *\\n830:  * The CLI names its containers `supabase_<service>_<project id>`, and it prints them: a healthy\\n831:  * `supabase status` opens with `Stopped services: [supabase_imgproxy_<id> supabase_pooler_<id>]`,\\n832:  * and its error paths say things like `No such container: supabase_db_<id>`. That line is the\\n833:  * CLI's own statement of WHICH PROJECT it resolved, and it is the instrument that would have\\n834:  * caught the incident: on 2026-08-10 a hybrid invocation reported the slot's ports beside\\n835:  * `supabase_imgproxy_poancmeitlmxejofwzuu` — the personal project — in the same output.\\n836:  *\\n837:  * The rule is a suffix match and it is deliberately strict: a `supabase_…` token that does not end\\n838:  * in this slot's project id is reported, whatever it is. A false report costs a loud refusal on a\\n839:  * read; a missed one costs a database.\\n840:  */\\n841: export function foreignContainerNames(text: string, slotProject: string): string[] {\\n842:   const names = [...String(text ?? '').matchAll(/\\\\bsupabase_[A-Za-z0-9][A-Za-z0-9_.-]*/g)].map((match) => match[0]);\\n843:   return [...new Set(names.filter((name) => !name.endsWith(`_${slotProject}`)))];\\n844: }\\n845: \\n846: /**\\n847:  * The Supabase container names in a piece of CLI output that DO belong to this slot — the positive\\n848:  * half of the same instrument (ruling T2).\\n849:  *\\n850:  * MEASURED BEFORE THIS WAS WRITTEN, 2026-08-10, read-only, both slots: `status -o json` through the\\n851:  * shared helper prints exactly two such tokens on stderr —\\n852:  * `Stopped services: [supabase_imgproxy_ai4good-slot-N supabase_pooler_ai4good-slot-N]` — and zero\\n853:  * tokens that belong to any other project. So the evidence this check demands is evidence the CLI\\n854:  * really does produce.\\n855:  *\\n856:  * Absence is not innocence: `foreignContainerNames` finds nothing in an output that names no\\n857:  * container at all, which is exactly the hybrid shape the 2026-08-09 incident wore (the slot's\\n858:  * ports beside another project's containers). A destructive act therefore requires at least one\\n859:  * name that IS this slot's, never merely the lack of one that is not.\\n860:  *\\n861:  * Residual, recorded rather than hidden: those two tokens exist because the tracked config disables\\n862:  * imgproxy and the pooler. A config that enables both would print no \\\"Stopped services\\\" line, this\\n863:  * check would find no evidence, and the destructive act would REFUSE. That is the fail-closed\\n864:  * direction (ruling E7) and it is loud, but it is a real coupling to the config and to the pinned\\n865:  * CLI's output shape (residual F4 in the plan).\\n866:  */\\n867: export function ownContainerNames(text: string, slotProject: string): string[] {\\n868:   const names = [...String(text ?? '').matchAll(/\\\\bsupabase_[A-Za-z0-9][A-Za-z0-9_.-]*/g)].map((match) => match[0]);\\n869:   return [...new Set(names.filter((name) => name.endsWith(`_${slotProject}`)))];\\n870: }\\n871: \\n872: /**\\n873:  * DOCKER'S OWN ANSWER, on the destructive path, every time (ruling T2).\\n874:  *\\n875:  * The CLI's status output is one instrument and it is coupled to the CLI's version. Docker is a\\n876:  * second, independent one: before a reset, docker must show this slot's OWN database container\\n877:  * running. A docker read is the only interaction anything here is permitted to have with the\\n878:  * founder's stack, and it is unrestricted on slots.\\n879:  *\\n880:  * It fails closed. If docker cannot be run, or reports no container of this slot's own, the reset\\n881:  * refuses: an instrument that cannot answer is not an answer of \\\"yes\\\".\\n882:  */\\n883: export function slotDbContainers(slot: number): string[] {\\n884:   const project = slotProjectId(slot);\\n885:   const res = spawnSync('docker', ['ps', '--filter', `name=supabase_db_${project}`, '--format', '{{.Names}}'], {\\n886:     env: childEnv(),\\n887:     encoding: 'utf8',\\n888:   });\\n889:   if (res.error) throw new Error(`docker could not be run to confirm slot ${slot}'s database container (${diagnostic((res.error as Error).message)})`);\\n890:   if (res.status !== 0) throw new Error(`\\\\`docker ps\\\\` exited ${res.status} while confirming slot ${slot}'s database container: ${diagnostic(res.stderr) || '(no error output)'}`);\\n891:   return (res.stdout ?? '')\\n892:     .split('\\\\n')\\n893:     .map((line) => line.trim())\\n894:     .filter(Boolean);\\n895: }\\n896: \\n897: function proveSlotDbContainer(slot: number, act: string): void {\\n898:   const project = slotProjectId(slot);\\n899:   const names = slotDbContainers(slot);\\n900:   const own = names.filter((name) => name.includes(project));\\n901:   if (own.length !== names.length || own.length === 0) {\\n902:     throw new Error(\\n903:       `REFUSING TO ${act.toUpperCase()} SLOT ${slot}: docker does not confirm this slot's own database container. ` +\\n904:         `\\\\`docker ps\\\\` named ${names.length ? names.join(', ') : 'no running container'} for ${project}. ` +\\n905:         `Start the slot (\\\\`bun tests/at/harness/db-pool.ts setup\\\\`) and try again. Nothing was done.`,\\n906:     );\\n907:   }\\n908:   console.log(`db-pool — docker confirms slot ${slot}'s own database container before the ${act}: ${own.join(', ')}`);\\n909: }\\n910: \\n911: export interface SlotIdentityRead {\\n912:   /** The stack's own report, when a stack answered. */\\n913:   status: StackStatus | null;\\n914:   /** Why no stack answered, when none did. Never a mismatch — a mismatch throws. */\\n915:   notRunning: string | null;\\n916: }\\n917: \\n918: /**\\n919:  * THE PRE-DESTRUCTIVE IDENTITY READ (ruling E1, decision D13).\\n920:  *\\n921:  * Before anything destructive, the CLI is asked — through the same helper, so the read and the\\n922:  * destructive act resolve identically — to say what it resolves. Three things must hold, and any\\n923:  * one of them failing refuses loudly and does nothing:\\n924:  *\\n925:  *   1. every Supabase container name in the output belongs to this slot's project;\\n926:  *   2. the founder's personal project id appears nowhere in the output;\\n927:  *   3. the ports and keys the stack reports are the slot's own, loopback, locally issued\\n928:  *      (`localStackProblems`, against the SLOT's config).\\n929:  *\\n930:  * A DESTRUCTIVE act adds a fourth, and it is the one that closes the vacuous pass (ruling T2):\\n931:  *\\n932:  *   4. at least one Supabase container name in the output IS this slot's own.\\n933:  *\\n934:  * The first three can all hold over an output that names no container at all, and an output that\\n935:  * names no container is precisely what the 2026-08-09 hybrid produced when it reported the slot's\\n936:  * ports while resolving another project. Absence of contrary evidence is not identity.\\n937:  *\\n938:  * A stack that is simply not running is not a mismatch: it is reported as `notRunning` so the\\n939:  * caller can decide (there is nothing to stop), and only a real disagreement throws.\\n940:  */\\n941: export function proveSlotTarget(slot: number, act: string, itemRoot: string = REPO_ROOT, destructive = false): SlotIdentityRead {\\n942:   const project = slotProjectId(slot);\\n943:   const res: CliResult = runSupabaseCli(slotTarget(slot), ['status', '-o', 'json']);\\n944:   if (res.error) {\\n945:     throw new Error(`refusing to ${act} slot ${slot}: the Supabase CLI could not be launched to read its identity (${diagnostic(res.error.message)})`);\\n946:   }\\n947: \\n948:   const raw = `${res.stdout}\\\\n${res.stderr}`;\\n949:   const personal = personalProjectId(itemRoot);\\n950:   const foreign = foreignContainerNames(raw, project);\\n951:   const carriesPersonal = personal !== '' && raw.includes(personal);\\n952:   if (foreign.length || carriesPersonal) {\\n953:     throw new Error(\\n954:       `REFUSING TO ${act.toUpperCase()} SLOT ${slot}: the identity read did not resolve to ${project}. ` +\\n955:         (foreign.length ? `The CLI named ${foreign.join(', ')}. ` : '') +\\n956:         (carriesPersonal ? `The founder's personal project id appears in the output. ` : '') +\\n957:         `Nothing was done.`,\\n958:     );\\n959:   }\\n960: \\n961:   let status: StackStatus;\\n962:   try {\\n963:     status = parseStackStatus(res);\\n964:   } catch (err) {\\n965:     return { status: null, notRunning: diagnostic((err as Error).message) };\\n966:   }\\n967: \\n968:   const config = readLocalConfig(slotDir(slot));\\n969:   const problems = localStackProblems(status, config);\\n970:   if (problems.length) {\\n971:     throw new Error(\\n972:       `REFUSING TO ${act.toUpperCase()} SLOT ${slot}: the stack that answered is not provably slot ${slot}'s own. ` +\\n973:         `Failed checks: ${problems.join('; ')}. (Values are deliberately not printed.) Nothing was done.`,\\n974:     );\\n975:   }\\n976: \\n977:   const own = ownContainerNames(raw, project);\\n978:   if (destructive && own.length === 0) {\\n979:     throw new Error(\\n980:       `REFUSING TO ${act.toUpperCase()} SLOT ${slot}: the identity read names no container belonging to ${project}, ` +\\n981:         `so it carries no positive evidence of which project the CLI resolved. The ports alone are not identity — ` +\\n982:         `the 2026-08-09 incident reported the right ports while resolving another project. Nothing was done.`,\\n983:     );\\n984:   }\\n985: \\n986:   console.log(\\n987:     `db-pool — slot ${slot} identity proven before the ${act}: project ${project}, api ${config.apiPort}, db ${config.dbPort}` +\\n988:       (own.length ? `, containers ${own.join(', ')}` : ''),\\n989:   );\\n990:   return { status, notRunning: null };\\n991: }\\n992: \\n993: /**\\n994:  * `db reset` on a slot. THE IDENTITY READ IS INSIDE, so no caller can reach the reset without it —\\n995:  * that is what \\\"structurally on the destructive path\\\" means, as opposed to a rule someone follows.\\n996:  */\\n997: export async function resetSlotDatabase(slot: number, itemRoot: string = REPO_ROOT): Promise<StackStatus> {\\n998:   // The BROAD guard first (rulings T7 and F1). D5's ruled sentence names \\\"occupy, prepare, reset or\\n999:   // emit env\\\", and this is an exported entry point a caller reaches directly — the spike does — so\\n1000:   // it runs the guard itself instead of trusting whoever called it to have run it.\\n1001:   refusePersonalSlotConfig(slot, itemRoot, 'reset');\\n1002:   const read = proveSlotTarget(slot, 'reset', itemRoot, true);\\n1003:   if (!read.status) {\\n1004:     throw new Error(\\n1005:       `refusing to reset slot ${slot}: it reported no running stack, so its identity could not be proven ` +\\n1006:         `(${read.notRunning}). Start the slot first; nothing was reset.`,\\n1007:     );\\n1008:   }\\n1009:   proveSlotDbContainer(slot, 'reset');\\n1010:   await resetLocalDatabase(slotTarget(slot));\\n1011:   return read.status;\\n1012: }\\n1013: \\n1014: /** `stop` on a slot, behind the same guard and the same read. A slot with no stack has nothing to stop. */\\n1015: export function stopSlotStack(slot: number, itemRoot: string = REPO_ROOT): void {\\n1016:   refusePersonalSlotConfig(slot, itemRoot, 'stop');\\n1017:   const read = proveSlotTarget(slot, 'stop', itemRoot, true);\\n1018:   if (!read.status) {\\n1019:     console.log(`db-pool — slot ${slot} reported no running stack (${read.notRunning}); there is nothing to stop`);\\n1020:     return;\\n1021:   }\\n1022:   runSlotCli(slot, ['stop'], 'stop');\\n1023: }\\n1024: \\n1025: /** `start` on a slot. Not destructive, and a stack that is down cannot be asked who it is first. */\\n1026: export function startSlotStack(slot: number): void {\\n1027:   runSlotCli(slot, ['start'], 'start');\\n1028: }\\n1029: \\n1030: /**\\n1031:  * Make the slot's database be the item tree's database, and prove it.\\n1032:  *\\n1033:  * The order is load-bearing: mirror the tree, regenerate the identity-overlaid config, restart the\\n1034:  * stack IF the configuration it was started with has changed, then read the stack, prove it is\\n1035:  * local, wait for readiness, reset, wait again, and prove the migration set replayed.\\n1036:  *\\n1037:  * WHY A MARKER RATHER THAN THE FILE ITSELF decides the restart: the file says what the slot SHOULD\\n1038:  * be running; only a marker written after a successful start says what it IS running. A crash\\n1039:  * between writing the config and restarting would otherwise leave equal text over a stack still\\n1040:  * serving the old auth behaviour, and the next occupancy would trust it.\\n1041:  */\\n1042: export async function prepare(occupancy: Occupancy, itemRoot: string = REPO_ROOT): Promise<PrepareResult> {\\n1043:   const { slot, dir } = occupancy;\\n1044:   const sourceText = readFileSync(join(itemRoot, 'supabase', 'config.toml'), 'utf8');\\n1045:   const generated = generateSlotConfig(sourceText, slot);\\n1046: \\n1047:   refusePersonal(generated, itemRoot, `prepare slot ${slot}`);\\n1048: \\n1049:   const closure = pathClosureProblems(generated, itemRoot);\\n1050:   if (closure.length) {\\n1051:     throw new Error(\\n1052:       `slot ${slot} would start half-provisioned: ${closure.join('; ')}. No stack was started and nothing was reset.`,\\n1053:     );\\n1054:   }\\n1055: \\n1056:   // THE MIRROR AND THE CONFIG WRITE ARE ONE STEP (ruling T11). The mirror excludes `config.toml`\\n1057:   // and removes the slot's copy, so between these two statements the slot has NO config — never the\\n1058:   // item tree's one, which carries the personal identity. A crash in the window leaves a slot with\\n1059:   // nothing, which `occupy` refuses loudly and one `setup` repairs. The write is unconditional:\\n1060:   // the mirror has just deleted whatever was there.\\n1061:   mirrorItemTree(itemRoot, slot);\\n1062:   const configPath = slotConfigPath(slot);\\n1063:   mkdirSync(join(dir, 'supabase'), { recursive: true });\\n1064:   writeFileSync(configPath, generated, 'utf8');\\n1065: \\n1066:   const hash = hashConfig(generated);\\n1067:   const marker = readMarker(slot);\\n1068:   const restarted = marker?.configHash !== hash;\\n1069:   if (restarted) {\\n1070:     // The auth container reads config at START, not at reset, so a changed config that is not\\n1071:     // restarted into would grade the previous item's auth behaviour.\\n1072:     console.log(`at:verify — db slot ${slot} configuration changed since its last start; restarting the slot's stack`);\\n1073:     stopSlotStack(slot, itemRoot);\\n1074:     startSlotStack(slot);\\n1075:     const proven: StartMarker = { configHash: hash, at: new Date().toISOString(), pid: process.pid };\\n1076:     writeFileSync(slotMarkerPath(slot), JSON.stringify(proven), 'utf8');\\n1077:   }\\n1078: \\n1079:   // The identity read doubles as the prove-local check against the SLOT's config, and it is the\\n1080:   // same read the reset performs again for itself immediately before acting.\\n1081:   const read = proveSlotTarget(slot, 'prepare', itemRoot);\\n1082:   if (!read.status) {\\n1083:     throw new Error(`slot ${slot} reported no running stack (${read.notRunning}), so nothing was reset and nothing was run`);\\n1084:   }\\n1085:   const status = read.status;\\n1086: \\n1087:   await waitForReady(status, `before the slot ${slot} reset`);\\n1088:   await resetSlotDatabase(slot, itemRoot);\\n1089:   await waitForReady(status, `after the slot ${slot} reset`);\\n1090:   const migrations = await proveMigrationsReplayed(status, itemRoot);\\n1091: \\n1092:   return { status, migrations, restarted };\\n1093: }\\n1094: \\n1095: /* ------------------------------------------------------------------------------- env and evidence */\\n1096: \\n1097: /**\\n1098:  * The coordinates a suite is allowed to see. Nothing else about the slot travels into the child,\\n\\n(Output capped at 50 KB. Showing lines 1-1098. Use offset=1099 to continue.)\\n</content>\",\"metadata\":{\"preview\":\"/**\\n * The local database slot pool — a small number of standing Supabase stacks (\\\"slots\\\") so that\\n * several items can verify at the same time without resetting each other's database.\\n *\\n * THE SHAPE, as ruled:\\n *\\n *   - Two standing slots. Concurrency is the pool size; a full pool REJECTS the next\\n *     database-needing item at start rather than queueing it.\\n *   - The stack on the 54321 block is the founder's personal stack. It is OUTSIDE the pool and\\n *     untouchable, and `personalBlockProblems` below makes that a check in code rather than a\\n *     convention: no slot may carry the repo's project id, a port in 54320–54329, or inspector\\n *     port 8083, and the check runs before anything destructive, every time.\\n *   - One claim file per slot, two states, three owners: the coordinator RESERVES a slot when an\\n *     item starts, the harness runner OCCUPIES it for each verify window, the coordinator\\n *     RELEASES the reservation at the item sweep.\\n *   - STATE IS NEVER INHERITED. The first act of every occupancy is to copy the item tree's own\\n *     `supabase/` directory into the slot and reset the database from it. The previous holder is\\n *     never trusted, including a crashed one.\\n *   - IDENTITY IS PERMANENT, EVERYTHING ELSE IS DATA. A slot permanently owns its project id and\\n *     its port block; every other setting comes from the item tree's own `config.toml` on every\",\"truncated\":true,\"loaded\":[],\"display\":{\"type\":\"file\",\"path\":\"C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\db-pool.ts\",\"text\":\"/**\\n * The local database slot pool — a small number of standing Supabase stacks (\\\"slots\\\") so that\\n * several items can verify at the same time without resetting each other's database.\\n *\\n * THE SHAPE, as ruled:\\n *\\n *   - Two standing slots. Concurrency is the pool size; a full pool REJECTS the next\\n *     database-needing item at start rather than queueing it.\\n *   - The stack on the 54321 block is the founder's personal stack. It is OUTSIDE the pool and\\n *     untouchable, and `personalBlockProblems` below makes that a check in code rather than a\\n *     convention: no slot may carry the repo's project id, a port in 54320–54329, or inspector\\n *     port 8083, and the check runs before anything destructive, every time.\\n *   - One claim file per slot, two states, three owners: the coordinator RESERVES a slot when an\\n *     item starts, the harness runner OCCUPIES it for each verify window, the coordinator\\n *     RELEASES the reservation at the item sweep.\\n *   - STATE IS NEVER INHERITED. The first act of every occupancy is to copy the item tree's own\\n *     `supabase/` directory into the slot and reset the database from it. The previous holder is\\n *     never trusted, including a crashed one.\\n *   - IDENTITY IS PERMANENT, EVERYTHING ELSE IS DATA. A slot permanently owns its project id and\\n *     its port block; every other setting comes from the item tree's own `config.toml` on every\\n *     occupancy, because auth flags and seed paths change per item and a stack started with a\\n *     stale one would grade the wrong behaviour.\\n *\\n * WHY THE CONFIG IS REGENERATED RATHER THAN COPIED OR FROZEN: a frozen slot config drifts from\\n * the item tree, and a copied one carries the personal stack's identity straight into the slot.\\n * Regeneration takes the item tree's file verbatim and overlays ONLY the identity fields, so a\\n * slot is always the item's own configuration wearing the slot's identity.\\n *\\n * WHY THIS FILE OWNS ALL THE TOML: the PowerShell helpers in `loop/work/db-slots.ps1` do file\\n * operations only — reserve, release, list. If both sides generated configs, the overlay rule\\n * could fork, and two rules for one identity is how a slot ends up on a personal port.\\n *\\n * The import of `runner.ts` is deliberate and the cycle it forms with the runner's own import of\\n * this file is safe: neither module calls the other at module scope, and both sides export\\n * hoisted function declarations.\\n */\\n\\nimport { spawnSync } from 'node:child_process';\\nimport { createHash } from 'node:crypto';\\nimport { cpSync, existsSync, mkdirSync, readFileSync, readdirSync, rmSync, writeFileSync } from 'node:fs';\\nimport { hostname, tmpdir } from 'node:os';\\nimport { isAbsolute, join, relative, resolve } from 'node:path';\\n\\nimport { REPO_ROOT } from './check.ts';\\nimport {\\n  acquireStackLock,\\n  childEnv,\\n  diagnostic,\\n  localStackProblems,\\n  parseStackStatus,\\n  proveMigrationsReplayed,\\n  readLocalConfig,\\n  readStackStatus,\\n  resetLocalDatabase,\\n  runSupabaseCli,\\n  stackLockPath,\\n  waitForReady,\\n  type CliResult,\\n  type CliTarget,\\n  type Holder,\\n  type LocalConfig,\\n  type MigrationProof,\\n  type StackLock,\\n  type StackStatus,\\n} from './runner.ts';\\n\\n/** Ruled: two standing slots. Concurrency IS the pool size. */\\nexport const POOL_SIZE = 2;\\n\\n/** The founder's personal stack. Nothing in the pool may carry any of these. */\\nconst PERSONAL_PORT_LOW = 54320;\\nconst PERSONAL_PORT_HIGH = 54329;\\nconst PERSONAL_INSPECTOR_PORT = 8083;\\n\\n/** The band a port must sit in for the slot overlay to know how to move it. */\\nconst MAPPABLE_PORT_LOW = 54000;\\nconst MAPPABLE_PORT_HIGH = 54999;\\n\\n/* ------------------------------------------------------------------------------ pool locations */\\n\\n/**\\n * The pool lives beside the locks it cooperates with and OUTSIDE every worktree: a slot outlives\\n * the item that used it, and a directory inside a worktree dies with the worktree.\\n *\\n * `AT_DB_POOL_ROOT` overrides it for the selftests, the same pattern as `AT_REPO_ROOT`.\\n */\\nexport function poolRoot(): string {\\n  const override = process.env.AT_DB_POOL_ROOT?.trim();\\n  const dir = override\\n    ? override\\n    : join(process.env.LOCALAPPDATA ?? process.env.XDG_CACHE_HOME ?? tmpdir(), 'ai4good-build', 'db-slots');\\n  mkdirSync(dir, { recursive: true });\\n  return dir;\\n}\\n\\n/** Slot numbers are 1..POOL_SIZE. Anything else is a caller error, named rather than clamped. */\\nexport function assertSlotNumber(slot: number): number {\\n  if (!Number.isInteger(slot) || slot < 1 || slot > POOL_SIZE) {\\n    throw new Error(`\\\"${slot}\\\" is not a slot in this pool — the slots are 1 to ${POOL_SIZE}`);\\n  }\\n  return slot;\\n}\\n\\n/** The directory that CONTAINS the slot's `supabase/` project folder — what `--workdir` names. */\\nexport function slotDir(slot: number): string {\\n  return join(poolRoot(), `slot-${assertSlotNumber(slot)}`);\\n}\\n\\nexport function slotConfigPath(slot: number): string {\\n  return join(slotDir(slot), 'supabase', 'config.toml');\\n}\\n\\n/** Written only after a successful start; see `prepare`. */\\nexport function slotMarkerPath(slot: number): string {\\n  return join(slotDir(slot), '.last-start.json');\\n}\\n\\nexport function reservationPath(slot: number): string {\\n  return join(poolRoot(), 'reservations', `slot-${assertSlotNumber(slot)}.json`);\\n}\\n\\n/** A distinct project id is what gives a slot distinct Docker containers and volumes. */\\nexport function slotProjectId(slot: number): string {\\n  return `ai4good-slot-${assertSlotNumber(slot)}`;\\n}\\n\\n/**\\n * A slot's PERMANENT identity, used for one purpose: naming the occupancy claim file (ruling T6).\\n *\\n * The runner's claim path is built from a project id and an api port, and for a repository stack\\n * both are permanent. A SLOT's ports are not: `prepare` lawfully rewrites them from the item\\n * tree's own config on every occupancy, so two runs bracketing a port change would hold two\\n * DIFFERENT claim files for one slot and neither would see the other. The claim therefore keys on\\n * the slot's project id — which never changes — and on a fixed sentinel in place of the port.\\n *\\n * The sentinel is 0, which is not a port. It only has to be constant. The PowerShell helper globs\\n * `at-verify-ai4good-slot-N-*.lock`, so it matches this and every earlier name unchanged.\\n */\\nexport function slotClaimKey(slot: number): LocalConfig {\\n  return { projectId: slotProjectId(slot), apiPort: 0, dbPort: 0 };\\n}\\n\\n/* --------------------------------------------------------------------------- config.toml scan */\\n\\ninterface ConfigEntry {\\n  line: number;\\n  section: string;\\n  key: string;\\n  value: string;\\n}\\n\\n/**\\n * Every ACTIVE `key = value` in the file, with the section it sits in. Commented lines are not\\n * settings and are skipped — which is the whole reason the scan is section-aware rather than a\\n * set of regular expressions over the file: `port` appears in nine places and most of them are\\n * examples in comments.\\n *\\n * Multi-line array values are not read as one value. Nothing in this repo's config uses one, and\\n * a value this scanner cannot see is a value it never rewrites, so the failure mode is a config\\n * that is copied verbatim rather than one that is silently mis-edited.\\n */\\nexport function scanConfig(text: string): ConfigEntry[] {\\n  const entries: ConfigEntry[] = [];\\n  let section = '';\\n  const lines = text.split('\\\\n');\\n  for (let index = 0; index < lines.length; index++) {\\n    const line = lines[index].trim();\\n    if (line.startsWith('#') || line === '') continue;\\n    const header = /^\\\\[([^\\\\]]+)\\\\]/.exec(line);\\n    if (header) {\\n      section = header[1];\\n      continue;\\n    }\\n    const setting = /^([A-Za-z_][A-Za-z0-9_]*)\\\\s*=\\\\s*(.*)$/.exec(line);\\n    if (setting) entries.push({ line: index, section, key: setting[1], value: setting[2].trim() });\\n  }\\n  return entries;\\n}\\n\\nfunction isPortKey(key: string): boolean {\\n  return key === 'port' || key.endsWith('_port');\\n}\\n\\n/**\\n * THE LOCAL STACK'S OWN LISTENER PORTS — the only ports a slot's identity moves (ruling E4).\\n *\\n * A `config.toml` holds two kinds of port. A LISTENER port is a socket this machine opens for\\n * this stack, so two stacks that share one collide, and the overlay must move it. A CLIENT port\\n * is part of an address of somebody else's service — `[auth.email.smtp] port = 587` is Postmark's\\n * port, not ours — so it is DATA, and moving it or refusing it would break a slot that is\\n * configured exactly like the tree it grades.\\n *\\n * The list is exact section + key pairs, so `[api] port` moves while `[api.tls] port` (were one\\n * added) does not silently inherit the rule.\\n */\\nconst LISTENER_PORTS: readonly { section: string; key: string }[] = [\\n  { section: 'api', key: 'port' },\\n  { section: 'db', key: 'port' },\\n  { section: 'db', key: 'shadow_port' },\\n  { section: 'db.pooler', key: 'port' },\\n  { section: 'studio', key: 'port' },\\n  { section: 'local_smtp', key: 'port' },\\n  { section: 'local_smtp', key: 'smtp_port' },\\n  { section: 'local_smtp', key: 'pop3_port' },\\n  { section: 'analytics', key: 'port' },\\n  { section: 'edge_runtime', key: 'inspector_port' },\\n];\\n\\nfunction isListenerPort(section: string, key: string): boolean {\\n  return LISTENER_PORTS.some((listener) => listener.section === section && listener.key === key);\\n}\\n\\nexport interface PortMapping {\\n  section: string;\\n  key: string;\\n  line: number;\\n  from: number;\\n  to: number;\\n}\\n\\n/**\\n * The identity overlay's port rule (ruling E4).\\n *\\n *   - a LISTENER port (see `LISTENER_PORTS`) in 54000–54999 moves by 1000 per slot;\\n *     `edge_runtime.inspector_port` set to EXACTLY 8083 moves by 10 per slot, because the ruled\\n *     inspector value is 8083 and it is not in that band. Any OTHER inspector value falls to the\\n *     generic rule below, so it maps when it is in band and refuses when it is not — a +10 applied\\n *     to a value nobody ruled is a guess, and D2 forbids guesses.\\n *   - a listener port outside those bands REFUSES loudly as unmappable. A guess here is a port\\n *     collision with software nobody in this process knows about, so a person decides.\\n *   - any OTHER port-valued key passes through unchanged: it addresses somebody else's service and\\n *     is data, not identity.\\n *   - except that a non-listener port sitting in 54000–54999 also REFUSES. It looks exactly like a\\n *     local stack port and this rule does not recognise it, and treating an unrecognised local port\\n *     as data would hand two slots the same socket. Fail closed, and a person decides.\\n *\\n * `personalBlockProblems` stays broad over EVERY port key regardless of this rule, so a port in the\\n * founder's own block can never reach a slot by being classified as data.\\n */\\nexport function portMappings(text: string, slot: number): { mappings: PortMapping[]; problems: string[] } {\\n  assertSlotNumber(slot);\\n  const mappings: PortMapping[] = [];\\n  const problems: string[] = [];\\n\\n  for (const entry of scanConfig(text)) {\\n    if (!isPortKey(entry.key)) continue;\\n    const literal = /^(\\\\d+)/.exec(entry.value);\\n    const from = literal ? Number(literal[1]) : NaN;\\n    const listener = isListenerPort(entry.section, entry.key);\\n\\n    if (!listener) {\\n      if (Number.isFinite(from) && from >= MAPPABLE_PORT_LOW && from <= MAPPABLE_PORT_HIGH) {\\n        problems.push(\\n          `[${entry.section}] ${entry.key} = ${from} is not a listener port this rule knows, but it sits in the local ` +\\n            `stack's band ${MAPPABLE_PORT_LOW}–${MAPPABLE_PORT_HIGH} — decide by hand whether the slot moves it`,\\n        );\\n      }\\n      continue; // a client-connection port is data and travels unchanged\\n    }\\n\\n    if (!literal) {\\n      problems.push(`[${entry.section}] ${entry.key} = ${entry.value} is not a plain port number, so the slot overlay cannot move it`);\\n      continue;\\n    }\\n    if (entry.section === 'edge_runtime' && entry.key === 'inspector_port' && from === PERSONAL_INSPECTOR_PORT) {\\n      mappings.push({ section: entry.section, key: entry.key, line: entry.line, from, to: from + slot * 10 });\\n      continue;\\n    }\\n    if (from >= MAPPABLE_PORT_LOW && from <= MAPPABLE_PORT_HIGH) {\\n      mappings.push({ section: entry.section, key: entry.key, line: entry.line, from, to: from + slot * 1000 });\\n      continue;\\n    }\\n    problems.push(\\n      `[${entry.section}] ${entry.key} = ${from} is outside ${MAPPABLE_PORT_LOW}–${MAPPABLE_PORT_HIGH}, so the slot ` +\\n        `overlay does not know where to move it — decide the slot's port for this setting by hand`,\\n    );\\n  }\\n\\n  return { mappings, problems };\\n}\\n\\n/**\\n * The item tree's own config, wearing the slot's identity. Everything that is not an identity\\n * field is returned byte for byte, including comments, blank lines and line endings — a\\n * regenerated config differing anywhere else would mean the slot grades different behaviour from\\n * the tree that asked for the run.\\n */\\nexport function generateSlotConfig(sourceText: string, slot: number): string {\\n  assertSlotNumber(slot);\\n  const { mappings, problems } = portMappings(sourceText, slot);\\n  if (problems.length) {\\n    throw new Error(`the slot ${slot} config cannot be generated from this supabase/config.toml — ${problems.join('; ')}`);\\n  }\\n\\n  const projectIdEntry = scanConfig(sourceText).find((entry) => entry.section === '' && entry.key === 'project_id');\\n  if (!projectIdEntry) throw new Error('supabase/config.toml carries no top-level project_id, so a slot identity cannot be built from it');\\n\\n  const lines = sourceText.split('\\\\n');\\n  lines[projectIdEntry.line] = lines[projectIdEntry.line].replace(/^(\\\\s*project_id\\\\s*=\\\\s*)\\\"[^\\\"]*\\\"/, `$1\\\"${slotProjectId(slot)}\\\"`);\\n  for (const mapping of mappings) {\\n    const pattern = new RegExp(`^(\\\\\\\\s*${mapping.key}\\\\\\\\s*=\\\\\\\\s*)\\\\\\\\d+`);\\n    lines[mapping.line] = lines[mapping.line].replace(pattern, `$1${mapping.to}`);\\n  }\\n  return lines.join('\\\\n');\\n}\\n\\n/* ------------------------------------------------------- the personal stack, refused in code */\\n\\n/**\\n * The \\\"untouchable\\\" ruling as an executable guard. Called before every destructive act and before\\n * any env is emitted, because a convention that is only written down is one a later change can\\n * step over without noticing.\\n *\\n * It scans EVERY active port-valued key, not a fixed list: the danger is a port in the personal\\n * block reaching a slot, and it does not matter which setting carried it there.\\n */\\nexport function personalBlockProblems(slotConfigText: string, personalProjectId: string): string[] {\\n  const problems: string[] = [];\\n  const entries = scanConfig(slotConfigText);\\n\\n  const projectId = entries.find((entry) => entry.section === '' && entry.key === 'project_id');\\n  const value = /^\\\"([^\\\"]*)\\\"/.exec(projectId?.value ?? '')?.[1] ?? '';\\n  if (!value) problems.push('the slot config carries no project_id, so it cannot be told apart from the personal stack');\\n  else if (value === personalProjectId) problems.push(`the slot config carries the personal stack's project id \\\"${personalProjectId}\\\"`);\\n\\n  for (const entry of entries) {\\n    if (!isPortKey(entry.key)) continue;\\n    const port = Number(/^(\\\\d+)/.exec(entry.value)?.[1] ?? NaN);\\n    if (!Number.isFinite(port)) continue;\\n    if (port >= PERSONAL_PORT_LOW && port <= PERSONAL_PORT_HIGH) {\\n      problems.push(`[${entry.section}] ${entry.key} = ${port} is inside the personal stack's port block ${PERSONAL_PORT_LOW}–${PERSONAL_PORT_HIGH}`);\\n    }\\n    if (entry.key === 'inspector_port' && port === PERSONAL_INSPECTOR_PORT) {\\n      problems.push(`[${entry.section}] inspector_port = ${port} is the personal stack's inspector port`);\\n    }\\n  }\\n\\n  return problems;\\n}\\n\\n/** The identity the pool must never wear. Read from the item tree, never hard-coded. */\\nexport function personalProjectId(itemRoot: string = REPO_ROOT): string {\\n  return readLocalConfig(itemRoot).projectId;\\n}\\n\\nfunction refusePersonal(slotConfigText: string, itemRoot: string, act: string): void {\\n  const problems = personalBlockProblems(slotConfigText, personalProjectId(itemRoot));\\n  if (problems.length) {\\n    throw new Error(\\n      `refusing to ${act}: this configuration is not provably outside the founder's personal stack. ` +\\n        `Failed checks: ${problems.join('; ')}. The personal stack is untouchable, so nothing was done.`,\\n    );\\n  }\\n}\\n\\n/**\\n * The same guard, over a slot's config AS IT SITS ON DISK (rulings T7 and F1).\\n *\\n * `occupy` and `prepare` run the guard over text they hold in hand. The other three entry points —\\n * reset, stop and the env emitter — are exported and reachable directly, so each runs the guard\\n * for itself over the file. A guard that only the usual caller runs is a convention, not a guard.\\n */\\nfunction refusePersonalSlotConfig(slot: number, itemRoot: string, act: string): void {\\n  const configPath = slotConfigPath(slot);\\n  if (!existsSync(configPath)) {\\n    throw new Error(\\n      `refusing to ${act} slot ${slot}: it has no config at ${configPath}, so it cannot be shown to be outside the ` +\\n        `founder's personal stack. Run \\\\`bun tests/at/harness/db-pool.ts setup\\\\`. Nothing was done.`,\\n    );\\n  }\\n  refusePersonal(readFileSync(configPath, 'utf8'), itemRoot, `${act} slot ${slot}`);\\n}\\n\\n/* ------------------------------------------------------------------------- the path closure */\\n\\n/** Config settings whose value names a file or directory the stack has to be able to read. */\\nconst PATH_KEYS = new Set([\\n  'sql_paths',\\n  'schema_paths',\\n  'content_path',\\n  'cert_path',\\n  'key_path',\\n  'signing_keys_path',\\n  'objects_path',\\n  'declarative_schema_path',\\n]);\\n\\nfunction stringValues(raw: string): string[] {\\n  const array = /^\\\\[(.*)\\\\]$/.exec(raw);\\n  const body = array ? array[1] : raw;\\n  return [...body.matchAll(/\\\"([^\\\"]*)\\\"/g)].map((match) => match[1]).filter((value) => value.trim() !== '');\\n}\\n\\n/**\\n * Fail closed on what the config asks for but the mirror cannot deliver.\\n *\\n * `prepare` mirrors the item tree's whole `supabase/` directory into the slot, so every path\\n * UNDER that directory is provided exactly as the item tree has it — present if present, absent\\n * if absent. A configured path that is absent in the item tree is therefore not a problem: the\\n * slot is then in the same state the repo-configured stack would be in, which is the state the\\n * item asked for. (`[db.seed] sql_paths = [\\\"./seed.sql\\\"]` with no `seed.sql` in the tree is\\n * exactly today's arrangement on the personal stack.)\\n *\\n * A path that points OUTSIDE `supabase/` is a different thing: the mirror cannot deliver it, so\\n * the slot would start half-provisioned and grade against a file it does not have. That refuses\\n * loudly and a person decides. The same applies to the two directories the mirror EXCLUDES\\n * (`MIRROR_EXCLUSIONS`): a config that names a file inside the CLI's own runtime state is naming\\n * something the slot will not have, so the closure stays honest about the exclusions.\\n *\\n * A VALUE THIS SCANNER CANNOT SEE REFUSES rather than passing. `scanConfig` reads one line per\\n * setting, so a multi-line array — `sql_paths = [` on its own line — yields the value `[` and no\\n * paths at all. For the OVERLAY an invisible value is harmless: it is copied verbatim. For the\\n * CLOSURE it is a missed refusal, which is the failure this function exists to prevent.\\n */\\nexport function pathClosureProblems(configText: string, itemRoot: string): string[] {\\n  const problems: string[] = [];\\n  const base = resolve(join(itemRoot, 'supabase'));\\n\\n  for (const entry of scanConfig(configText)) {\\n    if (!PATH_KEYS.has(entry.key)) continue;\\n    if (entry.value.startsWith('[') && !entry.value.includes(']')) {\\n      problems.push(\\n        `[${entry.section}] ${entry.key} opens an array that does not close on the same line, so this check ` +\\n          `cannot see the paths it names — write the value on one line (${entry.key} = [\\\"./a.sql\\\", \\\"./b.sql\\\"]) ` +\\n          `and run this again`,\\n      );\\n      continue;\\n    }\\n    for (const value of stringValues(entry.value)) {\\n      if (/^[a-z][a-z0-9+.-]*:\\\\/\\\\//i.test(value)) {\\n        problems.push(`[${entry.section}] ${entry.key} names \\\"${value}\\\", which is a URL rather than a file the slot can be given`);\\n        continue;\\n      }\\n      if (isAbsolute(value)) {\\n        problems.push(`[${entry.section}] ${entry.key} names the absolute path \\\"${value}\\\", which the slot mirror cannot reproduce`);\\n        continue;\\n      }\\n      const target = resolve(base, value);\\n      const inside = relative(base, target);\\n      if (inside.startsWith('..')) {\\n        problems.push(\\n          `[${entry.section}] ${entry.key} names \\\"${value}\\\", which is outside supabase/ — the slot mirror copies supabase/ ` +\\n            `and nothing else, so this file would be missing from the slot`,\\n        );\\n        continue;\\n      }\\n      const first = inside.split(/[\\\\\\\\/]/)[0];\\n      if (MIRROR_EXCLUSIONS.includes(first)) {\\n        problems.push(\\n          `[${entry.section}] ${entry.key} names \\\"${value}\\\", which resolves into supabase/${first} — the slot mirror ` +\\n            `deliberately does not copy that directory (it is the CLI's own runtime state about another stack), so ` +\\n            `this file would be missing from the slot`,\\n        );\\n      }\\n    }\\n  }\\n\\n  return problems;\\n}\\n\\n/* -------------------------------------------------------------------------------- the mirror */\\n\\n/**\\n * What the mirror does NOT carry into a slot (rulings T3, F3 and T11). Top-level entries of\\n * `supabase/` only, so the list cannot quietly grow into a filter on file names.\\n *\\n *   - `.temp` and `.branches` are the CLI's OWN RUNTIME STATE, not project source. `.temp` holds\\n *     the CLI's record of the stack it last ran — the founder's personal one — and `.gitignore`\\n *     itself says its `start-secrets/**` \\\"must NEVER be committed\\\". Copying it carries another\\n *     stack's identity residue and its secrets into every slot.\\n *   - `config.toml` is the slot's IDENTITY, and the item tree's copy carries the personal\\n *     identity. Excluding it means no slot config ever holds that identity, not even for the\\n *     instant between the mirror and the regenerated write — and a crash in that instant leaves\\n *     NO config rather than a personal one.\\n */\\nexport const MIRROR_EXCLUSIONS: readonly string[] = ['.temp', '.branches', 'config.toml'];\\n\\n/**\\n * Every symlink under a directory tree. A pre-copy scan, because a symlink is not a file the\\n * mirror can reproduce: `cpSync` would copy it as a link, and the link points wherever it likes —\\n * including straight back at the personal stack's own directory.\\n */\\nfunction symlinksUnder(dir: string): string[] {\\n  const found: string[] = [];\\n  const walk = (current: string): void => {\\n    for (const entry of readdirSync(current, { withFileTypes: true })) {\\n      const full = join(current, entry.name);\\n      if (entry.isSymbolicLink()) {\\n        found.push(full);\\n        continue; // never follow it — that is the whole point\\n      }\\n      if (entry.isDirectory()) walk(full);\\n    }\\n  };\\n  walk(dir);\\n  return found;\\n}\\n\\n/**\\n * Copy the item tree's `supabase/` into the slot, having first removed the slot's copy.\\n *\\n * DELETE THEN COPY, never merge: the previous holder's leftover migration or leftover function is\\n * exactly the state this pool exists to make impossible.\\n *\\n * THE PROJECT SOURCE ENTIRE, and nothing else (ruling E3 as narrowed by T3, F3 and T11). Every\\n * path the config names under `supabase/` arrives in the slot exactly as the item tree has it —\\n * present if present, absent if absent — and `pathClosureProblems` refuses any config path that\\n * names one of the three excluded entries, so the closure guarantee stays honest about them.\\n * (`README.md` and `.gitkeep` therefore travel into the slot's `migrations/` too. The CLI reads\\n * only `<timestamp>_name.sql` there, and the runner's migration proof counts exactly those.)\\n *\\n * A SYMLINK ANYWHERE UNDER `supabase/` REFUSES THE WHOLE MIRROR (ruling T13). The tree carries\\n * none today, so nothing breaks; one smuggled in later refuses loudly instead of being copied as\\n * a link into a directory the pool then resets.\\n */\\nexport function mirrorItemTree(itemRoot: string, slot: number): void {\\n  const source = join(itemRoot, 'supabase');\\n  const destination = join(slotDir(slot), 'supabase');\\n  if (!existsSync(source)) throw new Error(`${source} does not exist — there is no project to give the slot`);\\n\\n  const links = symlinksUnder(source);\\n  if (links.length) {\\n    throw new Error(\\n      `refusing to mirror ${source} into slot ${slot}: it contains ${links.length} symlink(s) — ${links.join(', ')}. ` +\\n        `A symlink is not a file the mirror can reproduce, and a link copied into a slot points wherever it likes, ` +\\n        `including outside the pool. Replace them with real files, or decide by hand. Nothing was copied.`,\\n    );\\n  }\\n\\n  rmSync(destination, { recursive: true, force: true });\\n  mkdirSync(destination, { recursive: true });\\n  cpSync(source, destination, {\\n    recursive: true,\\n    filter: (from: string) => {\\n      const inside = relative(source, from);\\n      if (inside === '') return true;\\n      return !MIRROR_EXCLUSIONS.includes(inside.split(/[\\\\\\\\/]/)[0]);\\n    },\\n  });\\n}\\n\\n/* --------------------------------------------------------------------------- the reservation */\\n\\nexport interface Reservation {\\n  slot: number;\\n  item: string;\\n  branch: string;\\n  at: string;\\n  holder: string;\\n}\\n\\nexport function readReservation(slot: number): Reservation | null {\\n  try {\\n    return JSON.parse(readFileSync(reservationPath(slot), 'utf8')) as Reservation;\\n  } catch {\\n    return null;\\n  }\\n}\\n\\n/** The slot reserved for this item, or null. Derived from the file, never declared by a caller. */\\nexport function slotForItem(item: string): number | null {\\n  for (let slot = 1; slot <= POOL_SIZE; slot++) {\\n    if (readReservation(slot)?.item === item) return slot;\\n  }\\n  return null;\\n}\\n\\n/**\\n * The item id a branch names — a pure function over the branch string, and it FAILS CLOSED.\\n *\\n * Exactly one id, or it refuses naming the condition. Never the first match of several: a branch\\n * carrying two ids is a question about which item is being verified, and answering it by\\n * position would attach a run, a reservation and a database to the wrong item silently.\\n */\\nexport function itemFromBranch(branch: string): string {\\n  const raw = String(branch ?? '').trim();\\n  if (raw === '') throw new Error('the branch name is empty, so no item id can be derived from it');\\n  if (raw === 'HEAD') throw new Error('HEAD is detached, so the branch names no item — check out the item branch, or set AT_DB_SLOT');\\n\\n  const ids = [...new Set([...raw.matchAll(/\\\\b(ai4dev|ai4pm)-(\\\\d+)\\\\b/gi)].map((match) => `${match[1].toUpperCase()}-${Number(match[2])}`))];\\n  if (ids.length === 0) throw new Error(`the branch \\\"${raw}\\\" names no item id, so no reserved slot can be found for it`);\\n  if (ids.length > 1) throw new Error(`the branch \\\"${raw}\\\" names ${ids.length} item ids (${ids.join(', ')}) — a person decides which one this run verifies`);\\n  return ids[0];\\n}\\n\\n/** The branch this tree is on. A git failure refuses; it never falls back to a guess. */\\nexport function currentBranch(root: string = REPO_ROOT): string {\\n  const res = spawnSync('git', ['-C', root, 'rev-parse', '--abbrev-ref', 'HEAD'], { encoding: 'utf8', env: childEnv() });\\n  if (res.error) throw new Error(`git could not be run to read the current branch (${diagnostic((res.error as Error).message)})`);\\n  if (res.status !== 0) throw new Error(`git could not report the current branch (exit ${res.status}): ${diagnostic(res.stderr) || '(no error output)'}`);\\n  return (res.stdout ?? '').trim();\\n}\\n\\n/* ------------------------------------------------------------------------------- the pool view */\\n\\nexport interface PoolSlotView {\\n  slot: number;\\n  dir: string;\\n  configured: boolean;\\n  projectId: string | null;\\n  apiPort: number | null;\\n  dbPort: number | null;\\n  reservation: Reservation | null;\\n  occupiedBy: Holder | null;\\n}\\n\\n/** What the pool looks like right now — for the setup report, the helpers, and a person asking. */\\nexport function readPool(): PoolSlotView[] {\\n  const views: PoolSlotView[] = [];\\n  for (let slot = 1; slot <= POOL_SIZE; slot++) {\\n    const dir = slotDir(slot);\\n    let config: LocalConfig | null = null;\\n    try {\\n      config = readLocalConfig(dir);\\n    } catch {\\n      config = null;\\n    }\\n    // The claim is keyed on the slot's PERMANENT identity (ruling T6), so this read finds it even\\n    // when the slot has no config yet and even after `prepare` has moved the slot's ports.\\n    let occupiedBy: Holder | null = null;\\n    try {\\n      occupiedBy = JSON.parse(readFileSync(stackLockPath(slotClaimKey(slot)), 'utf8')) as Holder;\\n    } catch {\\n      occupiedBy = null;\\n    }\\n    views.push({\\n      slot,\\n      dir,\\n      configured: config !== null,\\n      projectId: config?.projectId ?? null,\\n      apiPort: config?.apiPort ?? null,\\n      dbPort: config?.dbPort ?? null,\\n      reservation: readReservation(slot),\\n      occupiedBy,\\n    });\\n  }\\n  return views;\\n}\\n\\n/* ---------------------------------------------------------------------------------- occupancy */\\n\\nexport interface Occupancy {\\n  slot: number;\\n  dir: string;\\n  config: LocalConfig;\\n  /** The item this occupancy belongs to, or `null` when it came from the AT_DB_SLOT override. */\\n  item: string | null;\\n  via: 'reservation' | 'override';\\n  claim: StackLock;\\n  release(): void;\\n}\\n\\nexport interface OccupyOptions {\\n  /** The item id. Derived from the branch when absent. */\\n  item?: string;\\n  /** The AT_DB_SLOT override — for runs outside an item: the founder, the evidence gate, a spike. */\\n  slot?: number;\\n}\\n\\n/**\\n * Take a slot for one verify window.\\n *\\n * ADMISSION CONTROL IS THE COORDINATOR'S, NOT THE RUNNER'S. A run whose item holds no reservation\\n * refuses and names the helper that makes one; it never falls back onto a free slot, because a\\n * silent fallback is how a pool of two quietly becomes a pool of one shared stack.\\n *\\n * The claim is the runner's existing stack lock, with the takeover policy the ruled text asks\\n * for: a DEAD holder pid is broken loudly, a live holder is never displaced at any age.\\n *\\n * THE OVERRIDE SKIPS ADMISSION CONTROL, NOT OWNERSHIP (ruling T5). `AT_DB_SLOT` is ruled — the\\n * founder, the evidence gate and the spike all use it — and slot STATE is disposable by design, so\\n * the reservation is not what protects a slot; the occupancy claim is, and the override keeps it.\\n * But taking a slot another item is holding is a silent collision and costs nothing to refuse, so\\n * an override run refuses loudly when the target slot's reservation names a DIFFERENT item than\\n * this run can derive. A run that can derive no item at all treats ANY reservation as foreign.\\n */\\nexport function occupy(requirement: string, options: OccupyOptions = {}): Occupancy {\\n  let slot: number;\\n  let item: string | null = null;\\n  let via: 'reservation' | 'override';\\n\\n  if (options.slot !== undefined) {\\n    slot = assertSlotNumber(options.slot);\\n    item = options.item ?? null;\\n    via = 'override';\\n\\n    let derived: string | null = options.item ?? null;\\n    if (derived === null) {\\n      try {\\n        derived = itemFromBranch(currentBranch());\\n      } catch {\\n        derived = null; // no item derivable — every reservation is then somebody else's\\n      }\\n    }\\n    const reserved = readReservation(slot);\\n    if (reserved && reserved.item !== derived) {\\n      throw new Error(\\n        `refusing to take slot ${slot} with AT_DB_SLOT: it is reserved for ${reserved.item} ` +\\n          `(branch ${reserved.branch || 'unrecorded'}, taken ${reserved.at}, holder ${reserved.holder}) and this run ` +\\n          `${derived === null ? 'can derive no item of its own' : `belongs to ${derived}`}. Every occupancy resets the ` +\\n          `slot's database from its own tree, so this run would rebuild that item's database under it. Use a slot the ` +\\n          `pool shows free, or release that reservation first.`,\\n      );\\n    }\\n  } else {\\n    item = options.item ?? itemFromBranch(currentBranch());\\n    const reserved = slotForItem(item);\\n    if (reserved === null) {\\n      throw new Error(\\n        `no database slot is reserved for ${item}. The coordinator reserves a slot when the item starts — ` +\\n          `run \\\\`Reserve-DbSlot -Item ${item}\\\\` from loop/work/db-slots.ps1, or set AT_DB_SLOT=<n> for a run ` +\\n          `outside an item. There is deliberately no fallback onto a free slot: admission control belongs to ` +\\n          `the coordinator, not to this run.`,\\n      );\\n    }\\n    slot = reserved;\\n    via = 'reservation';\\n  }\\n\\n  const dir = slotDir(slot);\\n  const configPath = slotConfigPath(slot);\\n  if (!existsSync(configPath)) {\\n    // TWO CAUSES, and the repair is the same one command (ruling T11). Either the pool was never\\n    // set up on this machine, or a `prepare` died between the mirror — which removes the slot's\\n    // config on purpose, so no slot ever holds the personal identity — and the regenerated write\\n    // that immediately follows it. A missing config is the safe end of that window, never a wrong\\n    // one, and it is not permanent.\\n    throw new Error(\\n      `slot ${slot} has no config at ${configPath}. Either the pool was never set up on this machine, or a ` +\\n        `previous run stopped between the mirror and the write that follows it — the mirror removes the slot's ` +\\n        `config on purpose, so a slot never carries the personal identity even for an instant. Either way the ` +\\n        `repair is one command: \\\\`bun tests/at/harness/db-pool.ts setup\\\\`.`,\\n    );\\n  }\\n  refusePersonal(readFileSync(configPath, 'utf8'), REPO_ROOT, `occupy slot ${slot}`);\\n\\n  const config = readLocalConfig(dir);\\n  // Keyed on the slot's PERMANENT identity, never on the config's current ports (ruling T6).\\n  const claim = acquireStackLock(slotClaimKey(slot), requirement, { takeover: 'dead-pid-only' });\\n\\n  // The reservation is re-read AFTER the claim. Between the lookup above and this line the\\n  // coordinator may have released the slot and given it to another item, and a run that resets a\\n  // database another item now owns is the exact collision this pool exists to prevent.\\n  if (via === 'reservation' && item !== null) {\\n    const still = readReservation(slot);\\n    if (still?.item !== item) {\\n      claim.release();\\n      throw new Error(\\n        `slot ${slot} was reserved for ${item} when this run started and now names ${still?.item ?? 'nobody'} — ` +\\n          `the reservation changed under the run, so nothing was reset and nothing was run.`,\\n      );\\n    }\\n  }\\n\\n  return {\\n    slot,\\n    dir,\\n    config,\\n    item,\\n    via,\\n    claim,\\n    release: () => claim.release(),\\n  };\\n}\\n\\n/** Release an occupancy. Null-safe so it can sit in a `finally` beside a claim that never happened. */\\nexport function release(occupancy: Occupancy | null | undefined): void {\\n  occupancy?.release();\\n}\\n\\n/* ----------------------------------------------------------------------------------- prepare */\\n\\nexport interface PrepareResult {\\n  status: StackStatus;\\n  migrations: MigrationProof;\\n  /** True when the slot's stack had to be restarted because its configuration changed. */\\n  restarted: boolean;\\n}\\n\\ninterface StartMarker {\\n  configHash: string;\\n  at: string;\\n  pid: number;\\n}\\n\\nfunction hashConfig(text: string): string {\\n  return createHash('sha256').update(text, 'utf8').digest('hex');\\n}\\n\\nfunction readMarker(slot: number): StartMarker | null {\\n  try {\\n    return JSON.parse(readFileSync(slotMarkerPath(slot), 'utf8')) as StartMarker;\\n  } catch {\\n    return null;\\n  }\\n}\\n\\n/**\\n * Run the pinned CLI against one slot. Raw output is never printed: `supabase start` prints keys.\\n *\\n * THIS IS THE ONE HELPER (ruling E1, decision D13). No role hand-writes a slot CLI command: the\\n * incident of 2026-08-09 was a hand-written spike script that closed neither route the identity\\n * override travels by, and it destroyed the founder's database. Everything the wall is made of\\n * lives in `supabaseInvocation` in runner.ts — the positive `SUPABASE_PROJECT_ID`, the refusal of\\n * any other `SUPABASE_*`, `bun --no-env-file`, and the working directory equal to `--workdir` —\\n * and `slotTarget` is the only thing this file has to get right.\\n *\\n * It is for commands that must EXIT ZERO. `status` does not (the config disables imgproxy and the\\n * pooler), so the identity read below runs the CLI through the same seam and parses the result\\n * with the runner's own parser instead.\\n */\\nfunction runSlotCli(slot: number, args: string[], what: string): void {\\n  const res = runSupabaseCli(slotTarget(slot), args);\\n  if (res.error) {\\n    throw new Error(`could not launch the Supabase CLI to ${what} slot ${slot} (${diagnostic(res.error.message)})`);\\n  }\\n  if (res.status !== 0) {\\n    throw new Error(`\\\\`supabase ${args.join(' ')}\\\\` could not ${what} slot ${slot} (exit ${res.status}): ${diagnostic(res.stderr) || diagnostic(res.stdout) || '(no error output)'}`);\\n  }\\n}\\n\\n/** Both halves of a slot's identity, in the shape the shared CLI seam takes. */\\nexport function slotTarget(slot: number): CliTarget {\\n  return { workdir: slotDir(slot), projectId: slotProjectId(slot) };\\n}\\n\\n/**\\n * The Supabase container names in a piece of CLI output that do NOT belong to this slot.\\n *\\n * The CLI names its containers `supabase_<service>_<project id>`, and it prints them: a healthy\\n * `supabase status` opens with `Stopped services: [supabase_imgproxy_<id> supabase_pooler_<id>]`,\\n * and its error paths say things like `No such container: supabase_db_<id>`. That line is the\\n * CLI's own statement of WHICH PROJECT it resolved, and it is the instrument that would have\\n * caught the incident: on 2026-08-10 a hybrid invocation reported the slot's ports beside\\n * `supabase_imgproxy_poancmeitlmxejofwzuu` — the personal project — in the same output.\\n *\\n * The rule is a suffix match and it is deliberately strict: a `supabase_…` token that does not end\\n * in this slot's project id is reported, whatever it is. A false report costs a loud refusal on a\\n * read; a missed one costs a database.\\n */\\nexport function foreignContainerNames(text: string, slotProject: string): string[] {\\n  const names = [...String(text ?? '').matchAll(/\\\\bsupabase_[A-Za-z0-9][A-Za-z0-9_.-]*/g)].map((match) => match[0]);\\n  return [...new Set(names.filter((name) => !name.endsWith(`_${slotProject}`)))];\\n}\\n\\n/**\\n * The Supabase container names in a piece of CLI output that DO belong to this slot — the positive\\n * half of the same instrument (ruling T2).\\n *\\n * MEASURED BEFORE THIS WAS WRITTEN, 2026-08-10, read-only, both slots: `status -o json` through the\\n * shared helper prints exactly two such tokens on stderr —\\n * `Stopped services: [supabase_imgproxy_ai4good-slot-N supabase_pooler_ai4good-slot-N]` — and zero\\n * tokens that belong to any other project. So the evidence this check demands is evidence the CLI\\n * really does produce.\\n *\\n * Absence is not innocence: `foreignContainerNames` finds nothing in an output that names no\\n * container at all, which is exactly the hybrid shape the 2026-08-09 incident wore (the slot's\\n * ports beside another project's containers). A destructive act therefore requires at least one\\n * name that IS this slot's, never merely the lack of one that is not.\\n *\\n * Residual, recorded rather than hidden: those two tokens exist because the tracked config disables\\n * imgproxy and the pooler. A config that enables both would print no \\\"Stopped services\\\" line, this\\n * check would find no evidence, and the destructive act would REFUSE. That is the fail-closed\\n * direction (ruling E7) and it is loud, but it is a real coupling to the config and to the pinned\\n * CLI's output shape (residual F4 in the plan).\\n */\\nexport function ownContainerNames(text: string, slotProject: string): string[] {\\n  const names = [...String(text ?? '').matchAll(/\\\\bsupabase_[A-Za-z0-9][A-Za-z0-9_.-]*/g)].map((match) => match[0]);\\n  return [...new Set(names.filter((name) => name.endsWith(`_${slotProject}`)))];\\n}\\n\\n/**\\n * DOCKER'S OWN ANSWER, on the destructive path, every time (ruling T2).\\n *\\n * The CLI's status output is one instrument and it is coupled to the CLI's version. Docker is a\\n * second, independent one: before a reset, docker must show this slot's OWN database container\\n * running. A docker read is the only interaction anything here is permitted to have with the\\n * founder's stack, and it is unrestricted on slots.\\n *\\n * It fails closed. If docker cannot be run, or reports no container of this slot's own, the reset\\n * refuses: an instrument that cannot answer is not an answer of \\\"yes\\\".\\n */\\nexport function slotDbContainers(slot: number): string[] {\\n  const project = slotProjectId(slot);\\n  const res = spawnSync('docker', ['ps', '--filter', `name=supabase_db_${project}`, '--format', '{{.Names}}'], {\\n    env: childEnv(),\\n    encoding: 'utf8',\\n  });\\n  if (res.error) throw new Error(`docker could not be run to confirm slot ${slot}'s database container (${diagnostic((res.error as Error).message)})`);\\n  if (res.status !== 0) throw new Error(`\\\\`docker ps\\\\` exited ${res.status} while confirming slot ${slot}'s database container: ${diagnostic(res.stderr) || '(no error output)'}`);\\n  return (res.stdout ?? '')\\n    .split('\\\\n')\\n    .map((line) => line.trim())\\n    .filter(Boolean);\\n}\\n\\nfunction proveSlotDbContainer(slot: number, act: string): void {\\n  const project = slotProjectId(slot);\\n  const names = slotDbContainers(slot);\\n  const own = names.filter((name) => name.includes(project));\\n  if (own.length !== names.length || own.length === 0) {\\n    throw new Error(\\n      `REFUSING TO ${act.toUpperCase()} SLOT ${slot}: docker does not confirm this slot's own database container. ` +\\n        `\\\\`docker ps\\\\` named ${names.length ? names.join(', ') : 'no running container'} for ${project}. ` +\\n        `Start the slot (\\\\`bun tests/at/harness/db-pool.ts setup\\\\`) and try again. Nothing was done.`,\\n    );\\n  }\\n  console.log(`db-pool — docker confirms slot ${slot}'s own database container before the ${act}: ${own.join(', ')}`);\\n}\\n\\nexport interface SlotIdentityRead {\\n  /** The stack's own report, when a stack answered. */\\n  status: StackStatus | null;\\n  /** Why no stack answered, when none did. Never a mismatch — a mismatch throws. */\\n  notRunning: string | null;\\n}\\n\\n/**\\n * THE PRE-DESTRUCTIVE IDENTITY READ (ruling E1, decision D13).\\n *\\n * Before anything destructive, the CLI is asked — through the same helper, so the read and the\\n * destructive act resolve identically — to say what it resolves. Three things must hold, and any\\n * one of them failing refuses loudly and does nothing:\\n *\\n *   1. every Supabase container name in the output belongs to this slot's project;\\n *   2. the founder's personal project id appears nowhere in the output;\\n *   3. the ports and keys the stack reports are the slot's own, loopback, locally issued\\n *      (`localStackProblems`, against the SLOT's config).\\n *\\n * A DESTRUCTIVE act adds a fourth, and it is the one that closes the vacuous pass (ruling T2):\\n *\\n *   4. at least one Supabase container name in the output IS this slot's own.\\n *\\n * The first three can all hold over an output that names no container at all, and an output that\\n * names no container is precisely what the 2026-08-09 hybrid produced when it reported the slot's\\n * ports while resolving another project. Absence of contrary evidence is not identity.\\n *\\n * A stack that is simply not running is not a mismatch: it is reported as `notRunning` so the\\n * caller can decide (there is nothing to stop), and only a real disagreement throws.\\n */\\nexport function proveSlotTarget(slot: number, act: string, itemRoot: string = REPO_ROOT, destructive = false): SlotIdentityRead {\\n  const project = slotProjectId(slot);\\n  const res: CliResult = runSupabaseCli(slotTarget(slot), ['status', '-o', 'json']);\\n  if (res.error) {\\n    throw new Error(`refusing to ${act} slot ${slot}: the Supabase CLI could not be launched to read its identity (${diagnostic(res.error.message)})`);\\n  }\\n\\n  const raw = `${res.stdout}\\\\n${res.stderr}`;\\n  const personal = personalProjectId(itemRoot);\\n  const foreign = foreignContainerNames(raw, project);\\n  const carriesPersonal = personal !== '' && raw.includes(personal);\\n  if (foreign.length || carriesPersonal) {\\n    throw new Error(\\n      `REFUSING TO ${act.toUpperCase()} SLOT ${slot}: the identity read did not resolve to ${project}. ` +\\n        (foreign.length ? `The CLI named ${foreign.join(', ')}. ` : '') +\\n        (carriesPersonal ? `The founder's personal project id appears in the output. ` : '') +\\n        `Nothing was done.`,\\n    );\\n  }\\n\\n  let status: StackStatus;\\n  try {\\n    status = parseStackStatus(res);\\n  } catch (err) {\\n    return { status: null, notRunning: diagnostic((err as Error).message) };\\n  }\\n\\n  const config = readLocalConfig(slotDir(slot));\\n  const problems = localStackProblems(status, config);\\n  if (problems.length) {\\n    throw new Error(\\n      `REFUSING TO ${act.toUpperCase()} SLOT ${slot}: the stack that answered is not provably slot ${slot}'s own. ` +\\n        `Failed checks: ${problems.join('; ')}. (Values are deliberately not printed.) Nothing was done.`,\\n    );\\n  }\\n\\n  const own = ownContainerNames(raw, project);\\n  if (destructive && own.length === 0) {\\n    throw new Error(\\n      `REFUSING TO ${act.toUpperCase()} SLOT ${slot}: the identity read names no container belonging to ${project}, ` +\\n        `so it carries no positive evidence of which project the CLI resolved. The ports alone are not identity — ` +\\n        `the 2026-08-09 incident reported the right ports while resolving another project. Nothing was done.`,\\n    );\\n  }\\n\\n  console.log(\\n    `db-pool — slot ${slot} identity proven before the ${act}: project ${project}, api ${config.apiPort}, db ${config.dbPort}` +\\n      (own.length ? `, containers ${own.join(', ')}` : ''),\\n  );\\n  return { status, notRunning: null };\\n}\\n\\n/**\\n * `db reset` on a slot. THE IDENTITY READ IS INSIDE, so no caller can reach the reset without it —\\n * that is what \\\"structurally on the destructive path\\\" means, as opposed to a rule someone follows.\\n */\\nexport async function resetSlotDatabase(slot: number, itemRoot: string = REPO_ROOT): Promise<StackStatus> {\\n  // The BROAD guard first (rulings T7 and F1). D5's ruled sentence names \\\"occupy, prepare, reset or\\n  // emit env\\\", and this is an exported entry point a caller reaches directly — the spike does — so\\n  // it runs the guard itself instead of trusting whoever called it to have run it.\\n  refusePersonalSlotConfig(slot, itemRoot, 'reset');\\n  const read = proveSlotTarget(slot, 'reset', itemRoot, true);\\n  if (!read.status) {\\n    throw new Error(\\n      `refusing to reset slot ${slot}: it reported no running stack, so its identity could not be proven ` +\\n        `(${read.notRunning}). Start the slot first; nothing was reset.`,\\n    );\\n  }\\n  proveSlotDbContainer(slot, 'reset');\\n  await resetLocalDatabase(slotTarget(slot));\\n  return read.status;\\n}\\n\\n/** `stop` on a slot, behind the same guard and the same read. A slot with no stack has nothing to stop. */\\nexport function stopSlotStack(slot: number, itemRoot: string = REPO_ROOT): void {\\n  refusePersonalSlotConfig(slot, itemRoot, 'stop');\\n  const read = proveSlotTarget(slot, 'stop', itemRoot, true);\\n  if (!read.status) {\\n    console.log(`db-pool — slot ${slot} reported no running stack (${read.notRunning}); there is nothing to stop`);\\n    return;\\n  }\\n  runSlotCli(slot, ['stop'], 'stop');\\n}\\n\\n/** `start` on a slot. Not destructive, and a stack that is down cannot be asked who it is first. */\\nexport function startSlotStack(slot: number): void {\\n  runSlotCli(slot, ['start'], 'start');\\n}\\n\\n/**\\n * Make the slot's database be the item tree's database, and prove it.\\n *\\n * The order is load-bearing: mirror the tree, regenerate the identity-overlaid config, restart the\\n * stack IF the configuration it was started with has changed, then read the stack, prove it is\\n * local, wait for readiness, reset, wait again, and prove the migration set replayed.\\n *\\n * WHY A MARKER RATHER THAN THE FILE ITSELF decides the restart: the file says what the slot SHOULD\\n * be running; only a marker written after a successful start says what it IS running. A crash\\n * between writing the config and restarting would otherwise leave equal text over a stack still\\n * serving the old auth behaviour, and the next occupancy would trust it.\\n */\\nexport async function prepare(occupancy: Occupancy, itemRoot: string = REPO_ROOT): Promise<PrepareResult> {\\n  const { slot, dir } = occupancy;\\n  const sourceText = readFileSync(join(itemRoot, 'supabase', 'config.toml'), 'utf8');\\n  const generated = generateSlotConfig(sourceText, slot);\\n\\n  refusePersonal(generated, itemRoot, `prepare slot ${slot}`);\\n\\n  const closure = pathClosureProblems(generated, itemRoot);\\n  if (closure.length) {\\n    throw new Error(\\n      `slot ${slot} would start half-provisioned: ${closure.join('; ')}. No stack was started and nothing was reset.`,\\n    );\\n  }\\n\\n  // THE MIRROR AND THE CONFIG WRITE ARE ONE STEP (ruling T11). The mirror excludes `config.toml`\\n  // and removes the slot's copy, so between these two statements the slot has NO config — never the\\n  // item tree's one, which carries the personal identity. A crash in the window leaves a slot with\\n  // nothing, which `occupy` refuses loudly and one `setup` repairs. The write is unconditional:\\n  // the mirror has just deleted whatever was there.\\n  mirrorItemTree(itemRoot, slot);\\n  const configPath = slotConfigPath(slot);\\n  mkdirSync(join(dir, 'supabase'), { recursive: true });\\n  writeFileSync(configPath, generated, 'utf8');\\n\\n  const hash = hashConfig(generated);\\n  const marker = readMarker(slot);\\n  const restarted = marker?.configHash !== hash;\\n  if (restarted) {\\n    // The auth container reads config at START, not at reset, so a changed config that is not\\n    // restarted into would grade the previous item's auth behaviour.\\n    console.log(`at:verify — db slot ${slot} configuration changed since its last start; restarting the slot's stack`);\\n    stopSlotStack(slot, itemRoot);\\n    startSlotStack(slot);\\n    const proven: StartMarker = { configHash: hash, at: new Date().toISOString(), pid: process.pid };\\n    writeFileSync(slotMarkerPath(slot), JSON.stringify(proven), 'utf8');\\n  }\\n\\n  // The identity read doubles as the prove-local check against the SLOT's config, and it is the\\n  // same read the reset performs again for itself immediately before acting.\\n  const read = proveSlotTarget(slot, 'prepare', itemRoot);\\n  if (!read.status) {\\n    throw new Error(`slot ${slot} reported no running stack (${read.notRunning}), so nothing was reset and nothing was run`);\\n  }\\n  const status = read.status;\\n\\n  await waitForReady(status, `before the slot ${slot} reset`);\\n  await resetSlotDatabase(slot, itemRoot);\\n  await waitForReady(status, `after the slot ${slot} reset`);\\n  const migrations = await proveMigrationsReplayed(status, itemRoot);\\n\\n  return { status, migrations, restarted };\\n}\\n\\n/* ------------------------------------------------------------------------------- env and evidence */\\n\\n/**\\n * The coordinates a suite is allowed to see. Nothing else about the slot travels into the child,\",\"lineStart\":1,\"lineEnd\":1098,\"totalLines\":1099,\"truncated\":true}},\"title\":\"tests\\\\at\\\\harness\\\\db-pool.ts\",\"time\":{\"start\":1786349850291,\"end\":1786349850310}},\"id\":\"prt_feabf8db0001XdOdXbs39872jI\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"messageID\":\"msg_feabf480d001BtXcgLc77qaukr\"}}\r\n+{\"type\":\"text\",\"timestamp\":1786349850361,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feabf8cac001ddebcFGjzte5jG\",\"messageID\":\"msg_feabf480d001BtXcgLc77qaukr\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"type\":\"text\",\"text\":\"I have no shell tool, so I'll verify the diff scope by reading the declared changed files directly. Let me read the new pool module.\",\"time\":{\"start\":1786349849772,\"end\":1786349850359}}}\r\n+{\"type\":\"step_finish\",\"timestamp\":1786349850778,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feabf907d001F1RjS64v2LuTqq\",\"reason\":\"tool-calls\",\"snapshot\":\"435be3ef7ad0d4e3cf3a157e7242b72bd6019cf7\",\"messageID\":\"msg_feabf480d001BtXcgLc77qaukr\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"type\":\"step-finish\",\"tokens\":{\"total\":33724,\"input\":3279,\"output\":114,\"reasoning\":379,\"cache\":{\"write\":0,\"read\":29952}},\"cost\":0.0003404828}}\r\n+{\"type\":\"step_start\",\"timestamp\":1786349852592,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feabf97ae001PcqJR5Ht7mBHcK\",\"messageID\":\"msg_feabf923c001H1e2Z4vWGLd52O\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"snapshot\":\"49bbad20fb156985b7b2a841372bdc5257eccd08\",\"type\":\"step-start\"}}\r\n+{\"type\":\"tool_use\",\"timestamp\":1786349854100,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"type\":\"tool\",\"tool\":\"read\",\"callID\":\"call_00_jXd3erJY4EtFmYxeLKE25766\",\"state\":{\"status\":\"completed\",\"input\":{\"filePath\":\"C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\db-pool.ts\",\"offset\":1099},\"output\":\"<path>C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\db-pool.ts</path>\\n<type>file</type>\\n<content>\\n1099:  * and the personal guard runs here too: env is how a stack reaches a test, so emitting the wrong\\n1100:  * one is as destructive as resetting the wrong one.\\n1101:  *\\n1102:  * TWO CHECKS, and they see different things (rulings T7 and F1). The broad guard reads the slot's\\n1103:  * CONFIG, which is where a personal identity would arrive from; the inline checks below read the\\n1104:  * STATUS, which is what actually answered, and the config guard cannot see that.\\n1105:  */\\n1106: export function stackEnv(occupancy: Occupancy, status: StackStatus, itemRoot: string = REPO_ROOT): Record<string, string> {\\n1107:   refusePersonalSlotConfig(occupancy.slot, itemRoot, 'emit the coordinates of');\\n1108: \\n1109:   for (const [label, raw] of [\\n1110:     ['AT_SUPABASE_URL', status.apiUrl],\\n1111:     ['AT_SUPABASE_DB_URL', status.dbUrl],\\n1112:   ] as const) {\\n1113:     const port = Number(new URL(raw).port);\\n1114:     if (port >= PERSONAL_PORT_LOW && port <= PERSONAL_PORT_HIGH) {\\n1115:       throw new Error(`refusing to emit ${label}: it points at port ${port}, inside the founder's personal stack's port block`);\\n1116:     }\\n1117:   }\\n1118:   if (occupancy.config.projectId === personalProjectId()) {\\n1119:     throw new Error(`refusing to emit slot ${occupancy.slot}'s coordinates: its project id is the personal stack's`);\\n1120:   }\\n1121:   return {\\n1122:     AT_SUPABASE_URL: status.apiUrl,\\n1123:     AT_SUPABASE_DB_URL: status.dbUrl,\\n1124:     AT_SUPABASE_ANON_KEY: status.anonKey,\\n1125:     AT_SUPABASE_SERVICE_ROLE_KEY: status.serviceRoleKey,\\n1126:   };\\n1127: }\\n1128: \\n1129: /**\\n1130:  * The one line the verify transcript carries about the database it ran against: which slot, that\\n1131:  * the reset happened, and what the migration state was. A green that cannot name its reset ran\\n1132:  * against unknown state.\\n1133:  */\\n1134: export function evidence(occupancy: Occupancy, result: PrepareResult): string {\\n1135:   return (\\n1136:     `at:verify — db slot ${occupancy.slot} (${occupancy.config.projectId}, api ${occupancy.config.apiPort}) — ` +\\n1137:     `reset OK — migrations: ${result.migrations.expected} expected, ${result.migrations.applied} applied`\\n1138:   );\\n1139: }\\n1140: \\n1141: /* --------------------------------------------------------------------------------- setup CLI */\\n1142: \\n1143: /**\\n1144:  * The one-time bring-up: create both slot directories, generate both configs from the current\\n1145:  * tree, start both stacks, and report. It never resets and never touches the personal stack — the\\n1146:  * personal report at the end is a plain read, printed so the transcript shows the stack that must\\n1147:  * stay untouched was still on its own ports afterwards.\\n1148:  */\\n1149: async function setup(): Promise<number> {\\n1150:   const sourceText = readFileSync(join(REPO_ROOT, 'supabase', 'config.toml'), 'utf8');\\n1151:   console.log(`db-pool setup — pool root ${poolRoot()}`);\\n1152:   console.log(`db-pool setup — source configuration ${join(REPO_ROOT, 'supabase', 'config.toml')}`);\\n1153:   console.log(`db-pool setup — personal stack project id ${personalProjectId()} (read only; never started, stopped or reset here)`);\\n1154: \\n1155:   for (let slot = 1; slot <= POOL_SIZE; slot++) {\\n1156:     const dir = slotDir(slot);\\n1157:     console.log('');\\n1158:     console.log(`db-pool setup — slot ${slot} at ${dir}`);\\n1159:     const generated = generateSlotConfig(sourceText, slot);\\n1160:     refusePersonal(generated, REPO_ROOT, `set up slot ${slot}`);\\n1161: \\n1162:     const { mappings } = portMappings(sourceText, slot);\\n1163:     for (const mapping of mappings) console.log(`  port  [${mapping.section}] ${mapping.key}: ${mapping.from} -> ${mapping.to}`);\\n1164: \\n1165:     mirrorItemTree(REPO_ROOT, slot);\\n1166:     mkdirSync(join(dir, 'supabase'), { recursive: true });\\n1167:     writeFileSync(slotConfigPath(slot), generated, 'utf8');\\n1168:     mkdirSync(join(poolRoot(), 'reservations'), { recursive: true });\\n1169:     console.log(`  wrote ${slotConfigPath(slot)} (project_id ${slotProjectId(slot)})`);\\n1170: \\n1171:     // STOP BEFORE START (ruling F6). The marker written below means \\\"the stack was started with\\n1172:     // exactly this config\\\", and S2's own transcript measured that `supabase start` on an\\n1173:     // already-running project exits zero having started nothing. A no-op start would write a\\n1174:     // marker that says the slot runs a config it has never read. Stopping first removes the\\n1175:     // condition instead of measuring around it; on a slot that is down this only prints a line.\\n1176:     console.log(`  stopping slot ${slot} first, so the start below is a real one`);\\n1177:     stopSlotStack(slot, REPO_ROOT);\\n1178:     console.log(`  starting slot ${slot} — this pulls container images on a first run`);\\n1179:     startSlotStack(slot);\\n1180:     writeFileSync(slotMarkerPath(slot), JSON.stringify({ configHash: hashConfig(generated), at: new Date().toISOString(), pid: process.pid }), 'utf8');\\n1181: \\n1182:     const read = proveSlotTarget(slot, 'status report', REPO_ROOT);\\n1183:     if (!read.status) throw new Error(`slot ${slot} started but reported no running stack: ${read.notRunning}`);\\n1184:     const status = read.status;\\n1185:     console.log(`  slot ${slot} API_URL ${status.apiUrl}`);\\n1186:     console.log(`  slot ${slot} DB_URL  ${redactDbUrl(status.dbUrl)}`);\\n1187:     console.log(`  slot ${slot} keys    issued (values deliberately not printed)`);\\n1188:   }\\n1189: \\n1190:   console.log('');\\n1191:   console.log('db-pool setup — reading the personal stack (a read; nothing is written to it)');\\n1192:   try {\\n1193:     const personal = readStackStatus();\\n1194:     console.log(`  personal API_URL ${personal.apiUrl}`);\\n1195:     console.log(`  personal DB_URL  ${redactDbUrl(personal.dbUrl)}`);\\n1196:   } catch (err) {\\n1197:     console.log(`  personal stack did not report: ${diagnostic((err as Error).message)}`);\\n1198:   }\\n1199: \\n1200:   console.log('');\\n1201:   for (const view of readPool()) {\\n1202:     console.log(\\n1203:       `db-pool setup — slot ${view.slot}: ${view.configured ? `${view.projectId}, api ${view.apiPort}, db ${view.dbPort}` : 'NOT CONFIGURED'}` +\\n1204:         `, reservation ${view.reservation ? view.reservation.item : 'none'}, occupancy ${view.occupiedBy ? `pid ${view.occupiedBy.pid}` : 'none'}`,\\n1205:     );\\n1206:   }\\n1207:   return 0;\\n1208: }\\n1209: \\n1210: /** The database URL carries the password. Print the coordinates, never the credential. */\\n1211: function redactDbUrl(url: string): string {\\n1212:   return url.replace(/(postgres(?:ql)?:\\\\/\\\\/)[^@\\\\s/]+@/i, '$1<redacted>@');\\n1213: }\\n1214: \\n1215: /* ---------------------------------------------------------------------------------- spike CLI */\\n1216: \\n1217: /**\\n1218:  * THE ISOLATION SPIKE, step S3 as amended by ruling E5 — a CLI entry of this module, never a\\n1219:  * hand-written script. The first spike WAS a hand-written script; it closed neither route the\\n1220:  * identity override travels by, and it destroyed the founder's personal database. So the thing\\n1221:  * that proves the wall is now the thing that IS the wall: every CLI call below goes through the\\n1222:  * same helper the runner uses.\\n1223:  *\\n1224:  * IT TOUCHES THE PERSONAL STACK NOT AT ALL. Its instrument for the personal stack is a docker-level\\n1225:  * identity snapshot — a read — taken before and after, and compared on identity fields only. The\\n1226:  * breach signature was RECREATION (a new container id, a new volume timestamp), so identity-field\\n1227:  * equality is the direct negative of the breach. Run state is excluded on purpose: one container\\n1228:  * (`vector`) restart-loops on all three stacks by itself.\\n1229:  *\\n1230:  * THE HOSTILE CONDITION IS MANDATORY. The spike refuses to run unless its own process carries\\n1231:  * `SUPABASE_PROJECT_ID=<the personal project id>` — the exact override that caused the incident.\\n1232:  * A pass therefore proves the helper closes the route WHILE the route is loaded, rather than\\n1233:  * proving the route happened to be empty that day.\\n1234:  */\\n1235: \\n1236: /** bun's SQL client. Described here rather than imported: the runner keeps its own private copy. */\\n1237: interface BunSqlClient {\\n1238:   (strings: TemplateStringsArray, ...values: unknown[]): Promise<unknown>;\\n1239:   close(): Promise<void>;\\n1240: }\\n1241: type BunSqlCtor = new (url: string) => BunSqlClient;\\n1242: \\n1243: /** A canary connection may only ever reach a slot; the personal block is refused at the socket. */\\n1244: async function withSlotSql<T>(slot: number, status: StackStatus, fn: (sql: BunSqlClient) => Promise<T>): Promise<T> {\\n1245:   const port = Number(new URL(status.dbUrl).port);\\n1246:   if (!Number.isFinite(port) || (port >= PERSONAL_PORT_LOW && port <= PERSONAL_PORT_HIGH)) {\\n1247:     throw new Error(`refusing to open a connection for slot ${slot}: port ${port} is inside the founder's personal port block`);\\n1248:   }\\n1249:   const SQL = (globalThis as { Bun?: { SQL?: BunSqlCtor } }).Bun?.SQL;\\n1250:   if (!SQL) throw new Error('this runtime has no SQL client (expected bun)');\\n1251:   const sql = new SQL(status.dbUrl);\\n1252:   try {\\n1253:     return await fn(sql);\\n1254:   } finally {\\n1255:     await sql.close().catch(() => undefined);\\n1256:   }\\n1257: }\\n1258: \\n1259: /**\\n1260:  * DROP AND RECREATE, never `create table if not exists`: the first spike left a `spike_canary`\\n1261:  * table of its own shape in slot 1, and an insert against somebody else's columns fails on a\\n1262:  * constraint rather than writing the canary. The canary has to be this run's own table.\\n1263:  */\\n1264: async function writeCanary(slot: number, status: StackStatus, note: string): Promise<void> {\\n1265:   await withSlotSql(slot, status, async (sql) => {\\n1266:     await sql`drop table if exists public.spike_canary`;\\n1267:     await sql`create table public.spike_canary (note text)`;\\n1268:     await sql`insert into public.spike_canary (note) values (${note})`;\\n1269:   });\\n1270: }\\n1271: \\n1272: /** The canary's note, or null when the table or the row is gone — which is what a reset does. */\\n1273: async function readCanary(slot: number, status: StackStatus): Promise<string | null> {\\n1274:   return withSlotSql(slot, status, async (sql) => {\\n1275:     try {\\n1276:       const rows = (await sql`select note from public.spike_canary`) as { note?: unknown }[];\\n1277:       return rows.length ? String(rows[0].note) : null;\\n1278:     } catch (err) {\\n1279:       const message = (err as Error).message ?? '';\\n1280:       if (/spike_canary/.test(message) && /does not exist/i.test(message)) return null;\\n1281:       throw err;\\n1282:     }\\n1283:   });\\n1284: }\\n1285: \\n1286: function dockerLines(args: string[]): string[] {\\n1287:   const res = spawnSync('docker', args, { env: childEnv(), encoding: 'utf8' });\\n1288:   if (res.error) throw new Error(`docker could not be run (${diagnostic((res.error as Error).message)})`);\\n1289:   if (res.status !== 0) throw new Error(`\\\\`docker ${args.slice(0, 2).join(' ')}\\\\` exited ${res.status}: ${diagnostic(res.stderr) || '(no error output)'}`);\\n1290:   return (res.stdout ?? '')\\n1291:     .split('\\\\n')\\n1292:     .map((line) => line.trim())\\n1293:     .filter(Boolean);\\n1294: }\\n1295: \\n1296: interface DockerSnapshot {\\n1297:   containers: string[];\\n1298:   volumes: string[];\\n1299: }\\n1300: \\n1301: /**\\n1302:  * A READ-ONLY identity record of the personal stack's docker objects. Only `ps`, `inspect`,\\n1303:  * `volume ls` and `volume inspect` are used, and only identity fields are recorded: container id,\\n1304:  * created timestamp, image and port bindings; volume name and CreatedAt. No run state.\\n1305:  */\\n1306: function personalDockerSnapshot(personal: string): DockerSnapshot {\\n1307:   const containerNames = dockerLines(['ps', '-a', '--filter', `name=${personal}`, '--format', '{{.Names}}']).sort();\\n1308:   const containers = containerNames.length\\n1309:     ? dockerLines([\\n1310:         'inspect',\\n1311:         '--format',\\n1312:         '{{.Name}} | id {{.Id}} | created {{.Created}} | image {{.Config.Image}} | ports {{json .HostConfig.PortBindings}}',\\n1313:         ...containerNames,\\n1314:       ]).sort()\\n1315:     : [];\\n1316:   const volumeNames = dockerLines(['volume', 'ls', '--filter', `name=${personal}`, '--format', '{{.Name}}']).sort();\\n1317:   const volumes = volumeNames.length\\n1318:     ? dockerLines(['volume', 'inspect', '--format', '{{.Name}} | created {{.CreatedAt}}', ...volumeNames]).sort()\\n1319:     : [];\\n1320:   return { containers, volumes };\\n1321: }\\n1322: \\n1323: function snapshotDifferences(before: DockerSnapshot, after: DockerSnapshot): string[] {\\n1324:   const differences: string[] = [];\\n1325:   const pairs = [\\n1326:     ['container', before.containers, after.containers],\\n1327:     ['volume', before.volumes, after.volumes],\\n1328:   ] as const;\\n1329:   for (const [what, first, second] of pairs) {\\n1330:     for (const line of first) if (!second.includes(line)) differences.push(`${what} recorded BEFORE and not after: ${line}`);\\n1331:     for (const line of second) if (!first.includes(line)) differences.push(`${what} recorded AFTER and not before: ${line}`);\\n1332:   }\\n1333:   return differences;\\n1334: }\\n1335: \\n1336: function gitHead(): string {\\n1337:   const res = spawnSync('git', ['-C', REPO_ROOT, 'rev-parse', 'HEAD'], { encoding: 'utf8', env: childEnv() });\\n1338:   return (res.stdout ?? '').trim() || '(git could not report the head)';\\n1339: }\\n1340: \\n1341: async function spike(): Promise<number> {\\n1342:   const personal = personalProjectId();\\n1343:   const hostile = process.env.SUPABASE_PROJECT_ID ?? '';\\n1344: \\n1345:   console.log('');\\n1346:   console.log('AI4DEV-79 (parallel DB slot pool) - step S3 as amended by ruling E5, the isolation re-proof.');\\n1347:   console.log('');\\n1348:   console.log('REDACTION: database passwords and any key-shaped token are replaced before printing.');\\n1349:   console.log('Container names, project ids and ports are kept: they are the evidence.');\\n1350:   console.log('');\\n1351:   console.log(`date      : ${new Date().toISOString()}`);\\n1352:   console.log(`machine   : ${hostname()}`);\\n1353:   console.log(`worktree  : ${REPO_ROOT}`);\\n1354:   console.log(`branch    : ${(() => { try { return currentBranch(); } catch { return '(unreadable)'; } })()}`);\\n1355:   console.log(`head      : ${gitHead()}`);\\n1356:   console.log(`pool root : ${poolRoot()}`);\\n1357:   console.log('');\\n1358: \\n1359:   console.log('=== the hostile condition, mandatory ===');\\n1360:   if (hostile !== personal) {\\n1361:     console.log(`REFUSING TO RUN. The parent process carries SUPABASE_PROJECT_ID=\\\"${hostile}\\\" and the proof needs \\\"${personal}\\\".`);\\n1362:     console.log('Run this entry so the tracked .env loads into the parent, or set the variable in the parent shell.');\\n1363:     console.log('A pass under a clean environment would prove nothing: the route this helper closes would not be loaded.');\\n1364:     return 2;\\n1365:   }\\n1366:   console.log(`SUPABASE_PROJECT_ID IS PRESENT IN THIS PROCESS: \\\"${hostile}\\\".`);\\n1367:   console.log('That is the founder\\\\'s personal project id, and it is the exact override that destroyed the personal');\\n1368:   console.log('database on 2026-08-09. It stays in this process for the whole run. Every CLI call below is made');\\n1369:   console.log('through the shared helper, which states the slot identity positively in the child environment.');\\n1370:   console.log('');\\n1371: \\n1372:   console.log('=== (a) BEFORE: docker identity snapshot of the personal stack (a READ; nothing is written) ===');\\n1373:   const before = personalDockerSnapshot(personal);\\n1374:   for (const line of before.containers) console.log(`  ${line}`);\\n1375:   for (const line of before.