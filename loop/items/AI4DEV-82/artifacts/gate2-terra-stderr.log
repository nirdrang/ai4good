   1: # window-lib.ps1 - ONE implementation of the usage-window verdict, shared by every reader.
   2: #
   3: # WHY A LIBRARY. The verdict is now read in four places: the gauge CLI, the status line (which is
   4: # the only place Claude Code delivers the numbers), the spawn gate, and the prompt stamp. The
   5: # status line must compute it IN PROCESS - its cost doctrine forbids a second powershell spawn per
   6: # refresh - so a copy of the logic inside statusline.ps1 was the obvious move and is exactly the
   7: # drift class this project has already paid for once (statusline.ps1's own header records it:
   8: # code that reimplemented an API instead of calling it, and grepping for the API missed it).
   9: # So there is one body of logic here, and every reader calls it.
  10: #
  11: # WHAT IS HERE AND WHAT IS NOT. This file computes and formats. It never decides, never messages,
  12: # never waits, never writes a file. The gauge CLI owns the human lines and the exit codes; the
  13: # sensor owns the files; the gate owns the deny. A library that acted would be a brake nobody can
  14: # see.
  15: #
  16: # THE VERDICT LOGIC IS UNCHANGED. Get-WindowVerdict is window-gauge.ps1's body, moved verbatim
  17: # apart from returning the result instead of printing it. The one-time proof that the move changed
  18: # nothing is the capture-diff in loop/items/AI4DEV-82/artifacts/ (every byte of the CLI surface
  19: # over a fixed synthetic set, before and after); window-sim.ps1 remains the permanent net.
  20: 
  21: # THE PAUSE LINE - founder's number (2026-08-12): stop work at 85 percent of a window. This
  22: # supersedes the 90 of 2026-08-06; only the NUMBER moved. The principle behind it stands
  23: # unchanged: ONE line, no lower "start nothing new" band - alarm and park are the same line.
  24: #
  25: # The number appears in three param defaults: here (every library caller), window-gauge.ps1 and
  26: # window-wait.ps1 (their CLI defaults, which callers pass through). They move together, and
  27: # window-sim.ps1 pins the gauge's default at exactly 84/85 so a half-moved line goes red.
  28: $script:WindowPauseLine = 85
  29: 
  30: # Older than this and the reading is admitted to be unreadable rather than reported as current.
  31: $script:WindowStaleMinutes = 15
  32: 
  33: # WHERE THE FILES LIVE. One formula, so the sensor that writes and the four readers that read can
  34: # never disagree about the path. AI4GOOD_WINDOW_DIR redirects the whole directory: it exists so
  35: # the drill can exercise the mechanism end to end against synthetic readings without touching the
  36: # live snapshot the founder's status line is writing. The drill asserts its own directory is not
  37: # the live one.
  38: function Get-WindowDir {
  39:     if ($env:AI4GOOD_WINDOW_DIR) { return $env:AI4GOOD_WINDOW_DIR }
  40:     return (Join-Path $env:LOCALAPPDATA 'ai4good-build\nirdrang-ai4good')
  41: }
  42: function Get-WindowSnapshotPath { return (Join-Path (Get-WindowDir) 'rate-limits.json') }
  43: function Get-WindowVerdictPath { return (Join-Path (Get-WindowDir) 'window-verdict.txt') }
  44: 
  45: # Get-WindowVerdict - the whole verdict, from a snapshot OBJECT (the status line has one in
  46: # memory) or from a snapshot PATH (everyone else). Returns the result shape window-gauge.ps1 has
  47: # always emitted, so -Json output is byte-identical.
  48: function Get-WindowVerdict {
  49:     [CmdletBinding()]
  50:     param(
  51:         # An already-parsed snapshot. Wins over -SnapshotPath when supplied.
  52:         $Snapshot = $null,
  53: 
  54:         # Read a different snapshot. Empty means the live one (or whatever AI4GOOD_WINDOW_DIR says).
  55:         [string]$SnapshotPath = '',
  56: 
  57:         [int]$PauseAt = $script:WindowPauseLine,
  58: 
  59:         [int]$StaleMinutes = $script:WindowStaleMinutes
  60:     )
  61: 
  62:     # Function-scoped on purpose. A caller running under 'Stop' - the stamp hook does - must not
  63:     # turn a tolerated read failure here into a thrown exception, and this restores on return.
  64:     $ErrorActionPreference = 'SilentlyContinue'
  65: 
  66:     $result = [ordered]@{
  67:         verdict      = 'UNKNOWN'
  68:         reason       = ''
  69:         worstWindow  = ''
  70:         worstPercent = $null
  71:         resetsAtUtc  = ''
  72:         resetsInMin  = $null
  73:         readingAgeMin = $null
  74:         windows      = @()
  75:     }
  76: 
  77:     $snap = $Snapshot
  78:     if ($null -eq $Snapshot) {
  79:         $snapPath = if ($SnapshotPath) { $SnapshotPath } else { Get-WindowSnapshotPath }
  80: 
  81:         if (-not (Test-Path $snapPath)) {
  82:             $result.reason = 'no reading yet - the status line has not refreshed since the sensor was installed'
  83:             return $result
  84:         }
  85: 
  86:         try { $snap = Get-Content $snapPath -Raw | ConvertFrom-Json } catch { $snap = $null }
  87:         if (-not $snap) {
  88:             $result.reason = 'the snapshot could not be parsed'
  89:             return $result
  90:         }
  91:     }
  92: 
  93:     # Age first: everything below is only meaningful if the reading is current.
  94:     $ageMin = $null
  95:     try {
  96:         $ageMin = [math]::Round(((Get-Date).ToUniversalTime() - [datetime]::Parse($snap.capturedAt).ToUniversalTime()).TotalMinutes, 1)
  97:     } catch { }
  98:     $result.readingAgeMin = $ageMin
  99: 
 100:     if (-not $snap.rateLimits) {
 101:         # The field is absent rather than the file missing - a real answer, and a different one.
 102:         $result.reason = 'this build reports no usage windows'
 103:         return $result
 104:     }
 105: 
 106:     $now = Get-Date
 107:     foreach ($name in $snap.rateLimits.PSObject.Properties.Name) {
 108:         $w = $snap.rateLimits.$name
 109:         if ($null -eq $w.used_percentage) { continue }
 110:         # The percentages arrive as floats carrying binary noise - 7 comes through as
 111:         # 7.000000000000001 - so round before any comparison or a threshold test misbehaves
 112:         # exactly at the boundary, which is the one place it must not.
 113:         $pct = [int][math]::Round([double]$w.used_percentage)
 114:         $resetLocal = $null; $inMin = $null; $resetUtc = ''
 115:         if ($null -ne $w.resets_at) {
 116:             try {
 117:                 $dto = [DateTimeOffset]::FromUnixTimeSeconds([int64]$w.resets_at)
 118:                 $resetLocal = $dto.LocalDateTime
 119:                 $resetUtc = $dto.UtcDateTime.ToString('o')
 120:                 $inMin = [int][math]::Round(($resetLocal - $now).TotalMinutes)
 121:             } catch { }
 122:         }
 123:         # A PSCustomObject, NOT a hashtable: `Sort-Object percent` below silently does nothing to
 124:         # dictionary entries, because a dictionary has no such property. That bug shipped, and the
 125:         # live reading hid it - the worst window was simply whichever enumerated first, which
 126:         # happened to be the right answer. A weekly window at 95% beside a fresh five-hour one read
 127:         # OK. Found by window-sim.ps1 on its first run.
 128:         $result.windows += [pscustomobject][ordered]@{
 129:             name        = $name
 130:             percent     = $pct
 131:             resetsLocal = $(if ($resetLocal) { $resetLocal.ToString('HH:mm') } else { '?' })
 132:             resetsInMin = $inMin
 133:             resetsAtUtc = $resetUtc
 134:         }
 135:     }
 136: 
 137:     if ($result.windows.Count -eq 0) {
 138:         $result.reason = 'no window carried a usable percentage'
 139:         return $result
 140:     }
 141: 
 142:     # The binding constraint is whichever window is furthest along, not the five-hour one by habit.
 143:     $worst = $result.windows | Sort-Object percent -Descending | Select-Object -First 1
 144:     $result.worstWindow  = $worst.name
 145:     $result.worstPercent = $worst.percent
 146:     $result.resetsAtUtc  = $worst.resetsAtUtc
 147:     $result.resetsInMin  = $worst.resetsInMin
 148: 
 149:     if ($null -ne $ageMin -and $ageMin -gt $StaleMinutes) {
 150:         # A stale reading proves a FLOOR, not a level: inside one window the figure only ever climbs.
 151:         # So if the reading was already over the line AND its own window has not reset since, the
 152:         # level still stands and parking is the evidenced answer, not a cautious guess. Only once the
 153:         # reset has passed does the old number stop meaning anything - that is the case where we
 154:         # genuinely cannot say, and where a low stale reading always sat, since it may have climbed.
 155:         if ($worst.percent -ge $PauseAt -and $null -ne $worst.resetsInMin -and $worst.resetsInMin -gt 0) {
 156:             $result.verdict = 'PAUSE'
 157:             $result.reason  = ("{0} at {1}% (pause line {2}%) - reading is {3} min old, but that window has not reset, and a window only climbs" -f `
 158:                 $worst.name, $worst.percent, $PauseAt, $ageMin)
 159:             return $result
 160:         }
 161:         $result.verdict = 'UNKNOWN'
 162:         $result.reason  = ("last reading is {0} min old (limit {1}) - treat as unknown, never as low" -f $ageMin, $StaleMinutes)
 163:         return $result
 164:     }
 165: 
 166:     if ($worst.percent -ge $PauseAt) {
 167:         $result.verdict = 'PAUSE'
 168:         $result.reason  = ("{0} at {1}% (pause line {2}%) - resets {3}" -f $worst.name, $worst.percent, $PauseAt, $worst.resetsLocal)
 169:     } else {
 170:         $result.verdict = 'OK'
 171:         $result.reason  = ("{0} at {1}%" -f $worst.name, $worst.percent)
 172:     }
 173: 
 174:     return $result
 175: }
 176: 
 177: # Format-WindowVerdictLine - the ONE line the sensor writes to window-verdict.txt.
 178: #
 179: # EXACTLY ONE LINE, three forms, and the FIRST TOKEN is the machine anchor - window-alarm.cmd
 180: # matches it with `findstr /b`, which is all a per-tool checkpoint can afford:
 181: #
 182: #   OK
 183: #   ALARM WINDOW <window> at <pct>% (line <n>%), resets <HH:mm> - finish the current work item, commit, park.
 184: #   UNKNOWN <reason>
 185: #
 186: # The rest of the ALARM form is the whole sentence the model hears. The sensor composes it once
 187: # per refresh; the checkpoint regurgitates it. Nothing downstream has to know how to phrase a
 188: # window alarm, which is what keeps the wording in one place.
 189: function Format-WindowVerdictLine {
 190:     [CmdletBinding()]
 191:     param(
 192:         $Verdict,
 193:         [int]$PauseAt = $script:WindowPauseLine
 194:     )
 195: 
 196:     if ($null -eq $Verdict) { return 'UNKNOWN no verdict was computed' }
 197: 
 198:     $v = [string]$Verdict.verdict
 199:     if ($v -eq 'OK') { return 'OK' }
 200: 
 201:     if ($v -eq 'PAUSE') {
 202:         # The reset time belongs to the window that BLOCKED. Reporting another window's reset would
 203:         # point the reader at the wrong clock, which on this account is up to eighty hours out.
 204:         $reset = '?'
 205:         foreach ($w in @($Verdict.windows)) {
 206:             if (([string]$w.name) -eq ([string]$Verdict.worstWindow)) { $reset = [string]$w.resetsLocal; break }
 207:         }
 208:         return ('ALARM WINDOW {0} at {1}% (line {2}%), resets {3} - finish the current work item, commit, park.' -f `
 209:             $Verdict.worstWindow, $Verdict.worstPercent, $PauseAt, $reset)
 210:     }
 211: 
 212:     # Newlines are stripped rather than trusted: a one-line contract that can be broken by its own
 213:     # payload is not a contract, and the alarm anchors on the first token of the first line.
 214:     $reason = (([string]$Verdict.reason) -replace '[\r\n]', ' ').Trim()
 215:     if (-not $reason) { $reason = 'the reading cannot be trusted' }
 216:     return ('UNKNOWN ' + $reason)
 217: }

