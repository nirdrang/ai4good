   1: # window-gauge.ps1 - read the Anthropic usage windows and say what may proceed.
   2: #
   3: # WHERE THE NUMBERS COME FROM. Claude Code delivers `rate_limits` to the STATUS LINE and nowhere
   4: # else - hooks receive a different payload entirely - so statusline.ps1 snapshots it on every
   5: # refresh and this script reads that snapshot.
   6: #
   7: # ONE LINE ONLY (founder 2026-08-06): OK below the pause line, PAUSE at it, UNKNOWN when the
   8: # reading cannot be trusted. Two consequences worth holding on to:
   9: #   1. The reading is only as fresh as the last status-line refresh, which happens on every turn
  10: #      of the interactive session. While the coordinator is dormant, nothing updates it - which
  11: #      is exactly why the conductor sends a keep-alive pulse: a pulse wakes the coordinator, the
  12: #      wake refreshes the status line, and the refresh refreshes this gauge. The heartbeat is
  13: #      what keeps the gauge honest, not a timer inside this script.
  14: #   2. A stale reading is NOT a low reading. Age is reported and, past the limit, the verdict is
  15: #      UNKNOWN - never OK. Treating "I cannot see" as "all clear" is how a guard fails silently.
  16: #
  17: # WHAT IT DOES NOT DO. It reads and reports. It never pauses anything, never messages an agent,
  18: # never waits. The coordinator owns every decision; this is its instrument, not a second
  19: # authority. A gauge that acts is a brake nobody can see.
  20: #
  21: # The account reports two windows today (five_hour, seven_day). The binary supports three more
  22: # (seven_day_overage_included, seven_day_sonnet, seven_day_opus) which appear on other plans, so
  23: # every window present is evaluated by name rather than assumed - a plan change must not silently
  24: # narrow the guard to the windows we happened to know about.
  25: 
  26: [CmdletBinding()]
  27: param(
  28:     # PAUSE line - founder's number (2026-08-06): stop work at 90 percent of a window.
  29:     [int]$PauseAt = 90,
  30: 
  31:     # There is deliberately NO second, lower line (founder 2026-08-06). A "start nothing new"
  32:     # band would have to be justified by the cost of a sitting, which nobody has measured, so it
  33:     # could only ever be a number that felt safe. One line, and a sitting that meets it mid-flight
  34:     # parks at its last committed work item - the per-work-item commits are the recovery.
  35: 
  36:     # Older than this and the gauge admits it cannot see, rather than reporting a stale number as
  37:     # if it were current.
  38:     [int]$StaleMinutes = 15,
  39: 
  40:     # Emit the machine shape instead of the human lines.
  41:     [switch]$Json,
  42: 
  43:     # Read a different snapshot. Exists so the mechanism can be exercised end to end against
  44:     # synthetic readings without spending a single token, and without disturbing the live file
  45:     # the status line is writing. Defaults to the real one, so no caller has to know.
  46:     [string]$SnapshotPath = '',
  47: 
  48:     # Exit 0 only when work may proceed (verdict OK). For use as a wait condition: the coordinator
  49:     # parks and polls this until it succeeds, rather than sleeping on a computed duration - the
  50:     # window is authoritative about its own reset, our arithmetic is not.
  51:     [switch]$ExitOnReady
  52: )
  53: 
  54: $ErrorActionPreference = 'SilentlyContinue'
  55: 
  56: $snapPath = if ($SnapshotPath) { $SnapshotPath } else { Join-Path $env:LOCALAPPDATA 'ai4good-build\nirdrang-ai4good\rate-limits.json' }
  57: 
  58: $result = [ordered]@{
  59:     verdict      = 'UNKNOWN'
  60:     reason       = ''
  61:     worstWindow  = ''
  62:     worstPercent = $null
  63:     resetsAtUtc  = ''
  64:     resetsInMin  = $null
  65:     readingAgeMin = $null
  66:     windows      = @()
  67: }
  68: 
  69: function Emit($r) {
  70:     if ($Json) {
  71:         $r | ConvertTo-Json -Depth 6
  72:     } else {
  73:         $head = "WINDOW  {0}" -f $r.verdict
  74:         if ($r.reason) { $head += "  - " + $r.reason }
  75:         Write-Output $head
  76:         foreach ($w in $r.windows) {
  77:             Write-Output ("        {0,-28} {1,3}%   resets {2}  (in {3} min)" -f $w.name, $w.percent, $w.resetsLocal, $w.resetsInMin)
  78:         }
  79:         if ($null -ne $r.readingAgeMin) {
  80:             Write-Output ("        reading is {0} min old" -f $r.readingAgeMin)
  81:         }
  82:     }
  83:     if ($ExitOnReady) { if ($r.verdict -eq 'OK') { exit 0 } else { exit 1 } }
  84:     exit 0
  85: }
  86: 
  87: if (-not (Test-Path $snapPath)) {
  88:     $result.reason = 'no reading yet - the status line has not refreshed since the sensor was installed'
  89:     Emit $result
  90: }
  91: 
  92: try { $snap = Get-Content $snapPath -Raw | ConvertFrom-Json } catch { $snap = $null }
  93: if (-not $snap) {
  94:     $result.reason = 'the snapshot could not be parsed'
  95:     Emit $result
  96: }
  97: 
  98: # Age first: everything below is only meaningful if the reading is current.
  99: $ageMin = $null
 100: try {
 101:     $ageMin = [math]::Round(((Get-Date).ToUniversalTime() - [datetime]::Parse($snap.capturedAt).ToUniversalTime()).TotalMinutes, 1)
 102: } catch { }
 103: $result.readingAgeMin = $ageMin
 104: 
 105: if (-not $snap.rateLimits) {
 106:     # The field is absent rather than the file missing - a real answer, and a different one.
 107:     $result.reason = 'this build reports no usage windows'
 108:     Emit $result
 109: }
 110: 
 111: $now = Get-Date
 112: foreach ($name in $snap.rateLimits.PSObject.Properties.Name) {
 113:     $w = $snap.rateLimits.$name
 114:     if ($null -eq $w.used_percentage) { continue }
 115:     # The percentages arrive as floats carrying binary noise - 7 comes through as
 116:     # 7.000000000000001 - so round before any comparison or a threshold test misbehaves
 117:     # exactly at the boundary, which is the one place it must not.
 118:     $pct = [int][math]::Round([double]$w.used_percentage)
 119:     $resetLocal = $null; $inMin = $null; $resetUtc = ''
 120:     if ($null -ne $w.resets_at) {
 121:         try {
 122:             $dto = [DateTimeOffset]::FromUnixTimeSeconds([int64]$w.resets_at)
 123:             $resetLocal = $dto.LocalDateTime
 124:             $resetUtc = $dto.UtcDateTime.ToString('o')
 125:             $inMin = [int][math]::Round(($resetLocal - $now).TotalMinutes)
 126:         } catch { }
 127:     }
 128:     # A PSCustomObject, NOT a hashtable: `Sort-Object percent` below silently does nothing to
 129:     # dictionary entries, because a dictionary has no such property. That bug shipped, and the
 130:     # live reading hid it - the worst window was simply whichever enumerated first, which
 131:     # happened to be the right answer. A weekly window at 95% beside a fresh five-hour one read
 132:     # OK. Found by window-sim.ps1 on its first run.
 133:     $result.windows += [pscustomobject][ordered]@{
 134:         name        = $name
 135:         percent     = $pct
 136:         resetsLocal = $(if ($resetLocal) { $resetLocal.ToString('HH:mm') } else { '?' })
 137:         resetsInMin = $inMin
 138:         resetsAtUtc = $resetUtc
 139:     }
 140: }
 141: 
 142: if ($result.windows.Count -eq 0) {
 143:     $result.reason = 'no window carried a usable percentage'
 144:     Emit $result
 145: }
 146: 
 147: # The binding constraint is whichever window is furthest along, not the five-hour one by habit.
 148: $worst = $result.windows | Sort-Object percent -Descending | Select-Object -First 1
 149: $result.worstWindow  = $worst.name
 150: $result.worstPercent = $worst.percent
 151: $result.resetsAtUtc  = $worst.resetsAtUtc
 152: $result.resetsInMin  = $worst.resetsInMin
 153: 
 154: if ($null -ne $ageMin -and $ageMin -gt $StaleMinutes) {
 155:     # A stale reading proves a FLOOR, not a level: inside one window the figure only ever climbs.
 156:     # So if the reading was already over the line AND its own window has not reset since, the
 157:     # level still stands and parking is the evidenced answer, not a cautious guess. Only once the
 158:     # reset has passed does the old number stop meaning anything - that is the case where we
 159:     # genuinely cannot say, and where a low stale reading always sat, since it may have climbed.
 160:     if ($worst.percent -ge $PauseAt -and $null -ne $worst.resetsInMin -and $worst.resetsInMin -gt 0) {
 161:         $result.verdict = 'PAUSE'
 162:         $result.reason  = ("{0} at {1}% (pause line {2}%) - reading is {3} min old, but that window has not reset, and a window only climbs" -f `
 163:             $worst.name, $worst.percent, $PauseAt, $ageMin)
 164:         Emit $result
 165:     }
 166:     $result.verdict = 'UNKNOWN'
 167:     $result.reason  = ("last reading is {0} min old (limit {1}) - treat as unknown, never as low" -f $ageMin, $StaleMinutes)
 168:     Emit $result
 169: }
 170: 
 171: if ($worst.percent -ge $PauseAt) {
 172:     $result.verdict = 'PAUSE'
 173:     $result.reason  = ("{0} at {1}% (pause line {2}%) - resets {3}" -f $worst.name, $worst.percent, $PauseAt, $worst.resetsLocal)
 174: } else {
 175:     $result.verdict = 'OK'
 176:     $result.reason  = ("{0} at {1}%" -f $worst.name, $worst.percent)
 177: }
 178: 
 179: Emit $result

