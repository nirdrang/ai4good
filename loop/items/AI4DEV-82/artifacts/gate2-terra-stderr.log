     # under a running verify window. Fail closed, exactly as the harness does.\\n        $alive = $false\\n        if ($holder.pid) {\\n            try {\\n                Get-Process -Id ([int]$holder.pid) -ErrorAction Stop | Out-Null\\n                $alive = $true\\n            } catch {\\n                if ($_.FullyQualifiedErrorId -like 'NoProcessFoundForGivenId*') { $alive = $false } else { $alive = $true }\\n            }\\n        }\\n        if ($alive) {\\n            return @{ file = $f.FullName; holderPid = [int]$holder.pid; requirement = [string]$holder.requirement; startedAt = [string]$holder.startedAt }\\n        }\\n    }\\n    return $null\\n}\\n\\n# What the pool looks like right now. Read-only.\\nfunction Get-DbSlotPool {\\n    $out = @()\\n    for ($slot = 1; $slot -le $script:DbSlotPoolSize; $slot++) {\\n        $r = Read-DbSlotReservation $slot\\n        $o = Get-DbSlotOccupancy $slot\\n        $item = ''\\n        if ($r) { $item = [string]$r.item }\\n        $out += @{ slot = $slot; reservedFor = $item; reservation = $r; occupancy = $o }\\n    }\\n    return $out\\n}\\n\\n# Take a slot for one item. Exclusive create, so two coordinators cannot take the same slot.\\n#\\n# A FULL POOL IS A REJECTION, NOT A WAIT. The ruled design says the next database-needing item is\\n# rejected at start; a wait here would turn admission control into a queue nobody can see.\\nfunction Reserve-DbSlot([string]$Item, [string]$Branch = '') {\\n    if (-not (Test-DbSlotItemId $Item)) { throw ('not a valid item id: ' + $Item) }\\n\\n    for ($slot = 1; $slot -le $script:DbSlotPoolSize; $slot++) {\\n        $r = Read-DbSlotReservation $slot\\n        if ($r -and ([string]$r.item) -eq $Item) {\\n            return @{ ok = $true; slot = $slot; alreadyHeld = $true }\\n        }\\n    }\\n\\n    $held = @()\\n    for ($slot = 1; $slot -le $script:DbSlotPoolSize; $slot++) {\\n        $path = Get-DbSlotReservationPath $slot\\n        $fs = $null\\n        try {\\n            $fs = [System.IO.File]::Open($path, [System.IO.FileMode]::CreateNew, [System.IO.FileAccess]::Write)\\n            $o = @{ slot = $slot; item = $Item; branch = $Branch; at = (Get-Date).ToUniversalTime().ToString('o'); holder = ('pid=' + $PID) }\\n            $bytes = [System.Text.Encoding]::UTF8.GetBytes(($o | ConvertTo-Json -Depth 4))\\n            $fs.Write($bytes, 0, $bytes.Length)\\n            return @{ ok = $true; slot = $slot; alreadyHeld = $false }\\n        } catch {\\n            # RE-READ, THEN DECIDE. Two calls for the SAME item can both pass the already-held scan\\n            # above; one wins slot 1, and without this the loser would read \\\"taken\\\", advance, and\\n            # win slot 2 - one item holding the whole pool of two. If the reservation that beat us\\n            # names this same item, this item already has the slot, so say so and stop.\\n            #\\n            # The read WAITS OUT THE WRITE WINDOW (see Read-DbSlotReservationWait; NOT ruled by\\n            # gate 2, the executor's completion of T10, awaiting ratification). A reservation still\\n            # unreadable after the wait REJECTS this item rather than giving it a second slot: a\\n            # false rejection is loud and costs one look, a silent double-take costs the pool.\\n            $r = Read-DbSlotReservationWait $slot\\n            if ($r) {\\n                if (([string]$r.item) -eq $Item) { return @{ ok = $true; slot = $slot; alreadyHeld = $true } }\\n                $held += ('slot ' + $slot + ' -> ' + [string]$r.item)\\n            } elseif (Test-Path (Get-DbSlotReservationPath $slot)) {\\n                return @{ ok = $false; rejected = $true; reason = ('slot ' + $slot + ' holds a reservation this call cannot read, so it cannot tell whether that reservation belongs to ' + $Item + '. This item is REJECTED at start rather than given a second slot. Look at ' + (Get-DbSlotReservationPath $slot) + ' and run this again.') }\\n            } else {\\n                $held += ('slot ' + $slot + ' -> taken')\\n            }\\n        } finally {\\n            if ($fs) { $fs.Dispose() }\\n        }\\n    }\\n\\n    return @{ ok = $false; rejected = $true; reason = ('the database slot pool is full (' + ($held -join '; ') + '). This item is REJECTED at start, not queued. Finish one of those items, or start an item that needs no database.') }\\n}\\n\\n# Give a slot back at the item sweep.\\n#\\n# TWO REFUSALS, both of them the point. A reservation is deleted only when it NAMES the item being\\n# swept, so a sweep can never hand another item's slot away. And a reservation is never deleted\\n# while a live occupancy claim sits on that slot, because the run holding it is about to reset\\n# that database and the next item would be given a stack under a running reset.\\nfunction Release-DbSlot([string]$Item, [int]$Slot = 0) {\\n    if (-not (Test-DbSlotItemId $Item)) { throw ('not a valid item id: ' + $Item) }\\n\\n    $target = 0\\n    if ($Slot -gt 0) {\\n        $r = Read-DbSlotReservation $Slot\\n        if (-not $r) { return @{ ok = $true; released = $false; reason = ('slot ' + $Slot + ' holds no reservation') } }\\n        if (([string]$r.item) -ne $Item) {\\n            return @{ ok = $false; released = $false; reason = ('REFUSING: slot ' + $Slot + ' is reserved for ' + [string]$r.item + ', not for ' + $Item) }\\n        }\\n        $target = $Slot\\n    } else {\\n        for ($slot = 1; $slot -le $script:DbSlotPoolSize; $slot++) {\\n            $r = Read-DbSlotReservation $slot\\n            if ($r -and ([string]$r.item) -eq $Item) { $target = $slot; break }\\n        }\\n        if ($target -eq 0) { return @{ ok = $true; released = $false; reason = ('no slot is reserved for ' + $Item) } }\\n    }\\n\\n    # RESIDUAL, ruled and accepted (gate-2 T9): the window between this check and the delete below\\n    # is real, and it changes nothing destructive. The serializer for destructive acts is the\\n    # OCCUPANCY CLAIM, which is dead-pid-only - a live holder is never displaced. A runner that\\n    # slips into this window still holds its own claim, so the worst outcome is the NEXT item's\\n    # occupy refusing loudly until the window closes: a loud refusal, never a reset under a live\\n    # run. An atomic two-file handoff here would buy no safety the claim does not already give.\\n    $o = Get-DbSlotOccupancy $target\\n    if ($o) {\\n        return @{ ok = $false; released = $false; slot = $target; reason = ('REFUSING: slot ' + $target + ' is OCCUPIED right now by pid ' + $o.holderPid + ' running ' + $o.requirement + ' since ' + $o.startedAt + '. A verify window is open on that database. Wait for it to finish.') }\\n    }\\n\\n    Remove-Item (Get-DbSlotReservationPath $target) -Force\\n    return @{ ok = $true; released = $true; slot = $target }\\n}\",\"lineStart\":1,\"lineEnd\":235,\"totalLines\":235,\"truncated\":false}},\"title\":\"loop\\\\work\\\\db-slots.ps1\",\"time\":{\"start\":1786349903122,\"end\":1786349903138}},\"id\":\"prt_feac05ce9001PnYaFe4qhvUz0e\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"messageID\":\"msg_feac04b80001PC4AFK3cW6EF3F\"}}\r\n+{\"type\":\"text\",\"timestamp\":1786349903209,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feac05c0d0015BfmvSDRLkd5b5\",\"messageID\":\"msg_feac04b80001PC4AFK3cW6EF3F\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"type\":\"text\",\"text\":\"Now the PowerShell helpers and the SKILL.md process lines.\",\"time\":{\"start\":1786349902861,\"end\":1786349903207}}}\r\n+{\"type\":\"step_finish\",\"timestamp\":1786349903608,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feac05ee1001oyOykBKSjPfW8z\",\"reason\":\"tool-calls\",\"snapshot\":\"406336b6e25d5335208c49e121cae5d4cb482d77\",\"messageID\":\"msg_feac04b80001PC4AFK3cW6EF3F\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"type\":\"step-finish\",\"tokens\":{\"total\":85734,\"input\":7410,\"output\":96,\"reasoning\":276,\"cache\":{\"write\":0,\"read\":77952}},\"cost\":0.0006799128}}\r\n+{\"type\":\"step_start\",\"timestamp\":1786349905675,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feac06709001iOwMIQFOOcOWvc\",\"messageID\":\"msg_feac0608a001uAm1yP93gcsbaW\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"snapshot\":\"a713a98c892a8a80469db8e099004b480466012b\",\"type\":\"step-start\"}}\r\n+{\"type\":\"tool_use\",\"timestamp\":1786349911384,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"type\":\"tool\",\"tool\":\"grep\",\"callID\":\"call_00_oOqxjGgN0kWZvDQPjn7w8074\",\"state\":{\"status\":\"completed\",\"input\":{\"pattern\":\"DbSlot|db slot|reservation|Reserve-DbSlot|Release-DbSlot|Get-DbSlotPool\",\"path\":\"C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\.claude\\\\skills\\\\work\\\\SKILL.md\"},\"output\":\"Found 5 matches\\nC:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\.claude\\\\skills\\\\work\\\\SKILL.md:\\n  Line 94: 5. **Reserve a database slot, BEFORE the claim** — `Reserve-DbSlot -Item <id> -Branch <branch>`\\r\\n\\n  Line 98:    needs no database skips the reservation**, and you say at start that it is skipping it, so a\\r\\n\\n  Line 99:    later \\\"why has it no slot?\\\" has an answer in the record. Reserve before claiming: a reservation\\r\\n\\n  Line 183:    **`Release-DbSlot -Item <id>`** from `loop/work/db-slots.ps1` gives the slot back. It refuses a\\r\\n\\n  Line 184:    reservation naming a different item, and it refuses while a verify window is still open on that\\r\\n\",\"metadata\":{\"matches\":5,\"truncated\":false},\"title\":\"DbSlot|db slot|reservation|Reserve-DbSlot|Release-DbSlot|Get-DbSlotPool\",\"time\":{\"start\":1786349911337,\"end\":1786349911382}},\"id\":\"prt_feac07b460017Nv70TXwCUWPnv\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"messageID\":\"msg_feac0608a001uAm1yP93gcsbaW\"}}\r\n+{\"type\":\"text\",\"timestamp\":1786349911415,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feac07acd0016peRW9ZjcZqJjn\",\"messageID\":\"msg_feac0608a001uAm1yP93gcsbaW\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"type\":\"text\",\"text\":\"Now the SKILL.md touch points.\",\"time\":{\"start\":1786349910734,\"end\":1786349911412}}}\r\n+{\"type\":\"step_finish\",\"timestamp\":1786349911812,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feac07ef0001mtjryQOlvD6oL3\",\"reason\":\"tool-calls\",\"snapshot\":\"cc2f500543752379bfed2e656889ddea2933cfb3\",\"messageID\":\"msg_feac0608a001uAm1yP93gcsbaW\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"type\":\"step-finish\",\"tokens\":{\"total\":90478,\"input\":4189,\"output\":132,\"reasoning\":525,\"cache\":{\"write\":0,\"read\":85632}},\"cost\":0.0005050948}}\r\n+{\"type\":\"step_start\",\"timestamp\":1786349913864,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feac08706001K2WEmXZ8PxD65b\",\"messageID\":\"msg_feac080c0001eqZEbWCQD3JWB7\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"snapshot\":\"74367aa49fb7747404cc891b6c7fc05cf7d2cf91\",\"type\":\"step-start\"}}\r\n+{\"type\":\"tool_use\",\"timestamp\":1786349915065,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"type\":\"tool\",\"tool\":\"read\",\"callID\":\"call_00_ET_7uR5zoFnQgNEV322EVLg3348\",\"state\":{\"status\":\"completed\",\"input\":{\"filePath\":\"C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\.claude\\\\skills\\\\work\\\\SKILL.md\",\"offset\":80,\"limit\":130},\"output\":\"<path>C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\.claude\\\\skills\\\\work\\\\SKILL.md</path>\\n<type>file</type>\\n<content>\\n80: 2. Startability: missing, Done, Cancelled, or an open blocker → stop and say which. Attribution\\n81:    failures print and continue.\\n82: 3. **If the CHAIN'S ROOT has nothing above it, ask — once, at pickup, about the ROOT, not the\\n83:    item.** A parented item can sit under a bare root and inherit the gap silently. Ask with\\n84:    ranked suggestions, never open-ended: a dev item that already has children; an `AI4PM`\\n85:    requirement the text points at; a free-text grouping label; or \\\"standalone — its own root\\\",\\n86:    always offered and always legitimate. Record it so it is asked once ever. If the board is\\n87:    unreadable, **do not ask** — print `CHAIN UNRESOLVED`, carry on, retry at the next boundary; a\\n88:    guess would be baked in permanently.\\n89: 4. **Branch name from the board's `gitBranchName`, verbatim.** Never invented; validate that it\\n90:    tokenises to exactly this item. That is what makes the pull request close the right item.\\n91:    **Create it from `origin/main` after a fetch, never from local `main`** — local `main` can carry\\n92:    unpushed work that is not yours (a founder commit landed there mid-session once), and a pull\\n93:    request is precisely where someone else's commit becomes a wrong attribution.\\n94: 5. **Reserve a database slot, BEFORE the claim** — `Reserve-DbSlot -Item <id> -Branch <branch>`\\n95:    from `loop/work/db-slots.ps1`. There are two slots, so two items verify at once without\\n96:    resetting each other's database. **A full pool REJECTS this item at start** — say so, name the\\n97:    two items holding the slots, and stop; there is no queue and no flagged limbo. **An item that\\n98:    needs no database skips the reservation**, and you say at start that it is skipping it, so a\\n99:    later \\\"why has it no slot?\\\" has an answer in the record. Reserve before claiming: a reservation\\n100:    that fails must not leave an item falsely In Progress.\\n101: 6. Claim: assign, In Progress.\\n102: 7. Spawn the conductor: `Agent(subagent_type: \\\"conductor\\\", model: \\\"sonnet\\\",\\n103:    run_in_background: true, prompt: <item id, branch name, reserved database slot, what has\\n104:    already happened>)`.\\n105:    **A spawn prompt is item facts only.** It states what to RESOLVE, never a resolved value — no\\n106:    chain, no parent, no label — and it never carries process instructions, because process lives\\n107:    in the contracts and a spawn prompt is reviewed by nobody. One once told an item to queue\\n108:    auto-merge at pull-request time, which would have merged it before a single gate ran; Gate 1\\n109:    caught it on the plan. The reserved slot is an item fact and belongs here: only the coordinator\\n110:    reserves, and the item's verify runs have to know which slot they own.\\n111: 8. **Record the chain FOR the agent's worktree, right after the spawn** (founder 2026-08-07):\\n112:    `Set-ChainForWorktree <worktreePath> <branch> <item> <chain>` from `work-lib.ps1`, using the\\n113:    chain you already walked in step 1 — **as an array of `@{ id; label }` nodes, never a\\n114:    sentence** (a prose chain fails validation and the stamp prints `CHAIN UNRESOLVED`). The chain\\n115:    cache is worktree-scoped, so a chain you resolved in the main checkout is invisible to the\\n116:    agent's own stamp — skip this and the founder's supervision tree degrades to `AGENT AI4DEV-nn`\\n117:    with no parents, which is the one thing the stamp exists to show. This is not a fact handed to\\n118:    the agent: it is the coordinator filing what only the coordinator can read, where the hook\\n119:    will look for it.\\n120: 9. **Record the spawner too**: `Set-OwnerForWorktree <worktreePath> <yourSessionId>` — the\\n121:    session id is the GUID in your scratchpad path. The supervision tree prints in EVERY session\\n122:    opened in this folder, so each agent line carries whose agent it is: `[this session's agent]`\\n123:    here, `[ANOTHER session's agent]` in a parallel session (founder 2026-08-09 — unlabeled agent\\n124:    lines in a parallel session read as that session's own work). A missing record degrades to\\n125:    `[spawner unrecorded]`, loudly, never to a guess.\\n126: \\n127: The conductor is born in the item's one worktree — the platform creates it at spawn, because\\n128: the definition carries worktree isolation — installs once, and runs the item from there. You do\\n129: not follow it in.\\n130: \\n131: ## While an item runs\\n132: \\n133: You receive one flow line per phase change and one completion. That is the whole of your\\n134: involvement unless something asks for you.\\n135: \\n136: **COMMENCEMENT DEADLINE — a claim with no first flow line is a STARTUP STALL (founder\\n137: 2026-08-09).** A spawned conductor must produce its first flow line within ten minutes of the\\n138: spawn. Until that line arrives the item has no clock owner: the board says In Progress and\\n139: nothing is watching, and the drill review ranked this gap's six failure shapes — spawn rejected,\\n140: receipt lost, death before the first turn, setup hung, first watch never armed, first line\\n141: dropped — as the costliest uncovered class in the system. So commencement is its own bounded\\n142: wait, sharper and earlier than the general silence check: no flow line at ten minutes → check\\n143: that the task exists and its transcript is growing, and report a startup stall to the founder\\n144: either way. A lost commencement left to the general check can cost a working day.\\n145: \\n146: **Relay, never rule.** A question from an item reaches you verbatim and reaches the founder\\n147: verbatim. You do not answer it, soften it, or decide it is unnecessary. Exactly two things are\\n148: supposed to arrive: a finding that contradicts ratified text, and real scope growth.\\n149: \\n150: **A `STALL` line is a signal, not noise.** Investigate immediately — silence looks identical to\\n151: progress, and the one time it was shrugged off it cost four idle hours.\\n152: \\n153: **BACKSTOP, NEVER THE MECHANISM — YOUR BOUNDARY IS AS REAL AS THEIRS (founder ruling 2026-08-07).**\\n154: Silence longer than about twenty minutes earns ONE bounded read-only check: is the process alive,\\n155: did the file land, what does the `.stderr.log` say. That check has repeatedly caught what nothing\\n156: else caught, and it stays.\\n157: What it must never become is the item's clock. On AI4DEV-48 the coordinator detected six\\n158: consecutive phase changes and woke the conductor for each; the item finished, and the conductor's\\n159: own alarms were never once exercised. That is a boundary crossed by the actor with the best\\n160: intentions, and it hides the very defect it compensates for — after six silent saves, nobody can\\n161: tell a working conductor from an absent one.\\n162: - **Report every wake you send as a conductor defect**, in the same breath, to the founder. Never\\n163:   quietly absorb it. A save you do not name is a measurement you destroyed.\\n164: - **Two in one item means the design is not working** — say so plainly and propose the fix rather\\n165:   than carrying the item on your back to the end.\\n166: - **You still never write in the item's tree, rule on its content, or run its commands.** Rescuing\\n167:   unpushed work after a confirmed death is the one exception, and it is recorded AS a rescue.\\n168: \\n169: **Fable out of credit** → tell the conductor to spawn `orchestrator-opus` for subsequent\\n170: sittings, and say so in the report; the handoff is manual because `--fallback-model` never fires\\n171: on billing errors. **A session limit is not out of credit** — it is the five-hour window, it is\\n172: account-wide, and it heals itself. Never set a timer for the reset: it would fire into a\\n173: credit-dead account, and a reset time already past rolls a full day.\\n174: \\n175: ## Phase C — close the item\\n176: \\n177: The conductor reports the merge. Then:\\n178: \\n179: 1. **Sweep**: release the database slot, then remove the item's worktree, its generated\\n180:    `worktree-agent-*` branch, and its artifacts directory — after confirming the raw critiques and\\n181:    distillates were committed into the record by the fix and audit sittings. Only you can sweep —\\n182:    the permission classifier blocks subagents from removing a worktree.\\n183:    **`Release-DbSlot -Item <id>`** from `loop/work/db-slots.ps1` gives the slot back. It refuses a\\n184:    reservation naming a different item, and it refuses while a verify window is still open on that\\n185:    slot — both refusals are loud, and both mean the sweep is early, not that the helper is broken.\\n186:    **`locked` does NOT mean an agent is alive** (measured 2026-08-07). The lock reason names the\\n187:    PARENT SESSION's pid, not the agent's — read it and you will find your own `claude.exe\\n188:    --resume <this session>`. It clears when the platform tears the agent down cleanly, and\\n189:    survives when the agent dies abruptly, so on a stood-down item the lock outlives the agent and\\n190:    would keep every stale worktree in the founder's project folder for the rest of the session.\\n191:    Judge liveness by the AGENT, not the lock: its task is gone and its transcript is not growing.\\n192:    Then confirm the tree is clean and its head is on the remote, `git worktree unlock`, and\\n193:    remove. The tree of an agent that is genuinely still running is still never touched.\\n194: 2. **Fold upward**: re-read the parent's children **fresh**; all Done or Cancelled → fold,\\n195:    cascading, stopping below a requirement, naming every cancelled child.\\n196: 3. **Release**: print `session is free`, report open siblings with labels, suggest the next\\n197:    `/work`.\\n198: \\n199: **When git and the board disagree, git is truth for merge state and the board mirrors it.**\\n200: Repairing from primary evidence is legitimate and is recorded AS a repair; asserting a state you\\n201: never observed is not. Webhook slow → a bounded re-read. Two siblings merging at once → confirm\\n202: YOUR item Done before reading siblings, so whoever finishes second sees the complete set. No\\n203: locks by design: converge on re-read.\\n204: \\n205: ## Requirement evidence gate — pinned, not asserted\\n206: \\n207: An exhaustive leaf snapshot at a named commit · attribution resolved · the suite green at\\n208: integration tier at that commit with named checks and timestamps · a recorded founder attestation\\n209: with a date · an explicit recorded waiver path. **`/work` proposes; it never closes a requirement\\n\\n(Showing lines 80-209 of 264. Use offset=210 to continue.)\\n</content>\",\"metadata\":{\"preview\":\"2. Startability: missing, Done, Cancelled, or an open blocker → stop and say which. Attribution\\n   failures print and continue.\\n3. **If the CHAIN'S ROOT has nothing above it, ask — once, at pickup, about the ROOT, not the\\n   item.** A parented item can sit under a bare root and inherit the gap silently. Ask with\\n   ranked suggestions, never open-ended: a dev item that already has children; an `AI4PM`\\n   requirement the text points at; a free-text grouping label; or \\\"standalone — its own root\\\",\\n   always offered and always legitimate. Record it so it is asked once ever. If the board is\\n   unreadable, **do not ask** — print `CHAIN UNRESOLVED`, carry on, retry at the next boundary; a\\n   guess would be baked in permanently.\\n4. **Branch name from the board's `gitBranchName`, verbatim.** Never invented; validate that it\\n   tokenises to exactly this item. That is what makes the pull request close the right item.\\n   **Create it from `origin/main` after a fetch, never from local `main`** — local `main` can carry\\n   unpushed work that is not yours (a founder commit landed there mid-session once), and a pull\\n   request is precisely where someone else's commit becomes a wrong attribution.\\n5. **Reserve a database slot, BEFORE the claim** — `Reserve-DbSlot -Item <id> -Branch <branch>`\\n   from `loop/work/db-slots.ps1`. There are two slots, so two items verify at once without\\n   resetting each other's database. **A full pool REJECTS this item at start** — say so, name the\\n   two items holding the slots, and stop; there is no queue and no flagged limbo. **An item that\\n   needs no database skips the reservation**, and you say at start that it is skipping it, so a\\n   later \\\"why has it no slot?\\\" has an answer in the record. Reserve before claiming: a reservation\",\"truncated\":true,\"loaded\":[],\"display\":{\"type\":\"file\",\"path\":\"C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\.claude\\\\skills\\\\work\\\\SKILL.md\",\"text\":\"2. Startability: missing, Done, Cancelled, or an open blocker → stop and say which. Attribution\\n   failures print and continue.\\n3. **If the CHAIN'S ROOT has nothing above it, ask — once, at pickup, about the ROOT, not the\\n   item.** A parented item can sit under a bare root and inherit the gap silently. Ask with\\n   ranked suggestions, never open-ended: a dev item that already has children; an `AI4PM`\\n   requirement the text points at; a free-text grouping label; or \\\"standalone — its own root\\\",\\n   always offered and always legitimate. Record it so it is asked once ever. If the board is\\n   unreadable, **do not ask** — print `CHAIN UNRESOLVED`, carry on, retry at the next boundary; a\\n   guess would be baked in permanently.\\n4. **Branch name from the board's `gitBranchName`, verbatim.** Never invented; validate that it\\n   tokenises to exactly this item. That is what makes the pull request close the right item.\\n   **Create it from `origin/main` after a fetch, never from local `main`** — local `main` can carry\\n   unpushed work that is not yours (a founder commit landed there mid-session once), and a pull\\n   request is precisely where someone else's commit becomes a wrong attribution.\\n5. **Reserve a database slot, BEFORE the claim** — `Reserve-DbSlot -Item <id> -Branch <branch>`\\n   from `loop/work/db-slots.ps1`. There are two slots, so two items verify at once without\\n   resetting each other's database. **A full pool REJECTS this item at start** — say so, name the\\n   two items holding the slots, and stop; there is no queue and no flagged limbo. **An item that\\n   needs no database skips the reservation**, and you say at start that it is skipping it, so a\\n   later \\\"why has it no slot?\\\" has an answer in the record. Reserve before claiming: a reservation\\n   that fails must not leave an item falsely In Progress.\\n6. Claim: assign, In Progress.\\n7. Spawn the conductor: `Agent(subagent_type: \\\"conductor\\\", model: \\\"sonnet\\\",\\n   run_in_background: true, prompt: <item id, branch name, reserved database slot, what has\\n   already happened>)`.\\n   **A spawn prompt is item facts only.** It states what to RESOLVE, never a resolved value — no\\n   chain, no parent, no label — and it never carries process instructions, because process lives\\n   in the contracts and a spawn prompt is reviewed by nobody. One once told an item to queue\\n   auto-merge at pull-request time, which would have merged it before a single gate ran; Gate 1\\n   caught it on the plan. The reserved slot is an item fact and belongs here: only the coordinator\\n   reserves, and the item's verify runs have to know which slot they own.\\n8. **Record the chain FOR the agent's worktree, right after the spawn** (founder 2026-08-07):\\n   `Set-ChainForWorktree <worktreePath> <branch> <item> <chain>` from `work-lib.ps1`, using the\\n   chain you already walked in step 1 — **as an array of `@{ id; label }` nodes, never a\\n   sentence** (a prose chain fails validation and the stamp prints `CHAIN UNRESOLVED`). The chain\\n   cache is worktree-scoped, so a chain you resolved in the main checkout is invisible to the\\n   agent's own stamp — skip this and the founder's supervision tree degrades to `AGENT AI4DEV-nn`\\n   with no parents, which is the one thing the stamp exists to show. This is not a fact handed to\\n   the agent: it is the coordinator filing what only the coordinator can read, where the hook\\n   will look for it.\\n9. **Record the spawner too**: `Set-OwnerForWorktree <worktreePath> <yourSessionId>` — the\\n   session id is the GUID in your scratchpad path. The supervision tree prints in EVERY session\\n   opened in this folder, so each agent line carries whose agent it is: `[this session's agent]`\\n   here, `[ANOTHER session's agent]` in a parallel session (founder 2026-08-09 — unlabeled agent\\n   lines in a parallel session read as that session's own work). A missing record degrades to\\n   `[spawner unrecorded]`, loudly, never to a guess.\\n\\nThe conductor is born in the item's one worktree — the platform creates it at spawn, because\\nthe definition carries worktree isolation — installs once, and runs the item from there. You do\\nnot follow it in.\\n\\n## While an item runs\\n\\nYou receive one flow line per phase change and one completion. That is the whole of your\\ninvolvement unless something asks for you.\\n\\n**COMMENCEMENT DEADLINE — a claim with no first flow line is a STARTUP STALL (founder\\n2026-08-09).** A spawned conductor must produce its first flow line within ten minutes of the\\nspawn. Until that line arrives the item has no clock owner: the board says In Progress and\\nnothing is watching, and the drill review ranked this gap's six failure shapes — spawn rejected,\\nreceipt lost, death before the first turn, setup hung, first watch never armed, first line\\ndropped — as the costliest uncovered class in the system. So commencement is its own bounded\\nwait, sharper and earlier than the general silence check: no flow line at ten minutes → check\\nthat the task exists and its transcript is growing, and report a startup stall to the founder\\neither way. A lost commencement left to the general check can cost a working day.\\n\\n**Relay, never rule.** A question from an item reaches you verbatim and reaches the founder\\nverbatim. You do not answer it, soften it, or decide it is unnecessary. Exactly two things are\\nsupposed to arrive: a finding that contradicts ratified text, and real scope growth.\\n\\n**A `STALL` line is a signal, not noise.** Investigate immediately — silence looks identical to\\nprogress, and the one time it was shrugged off it cost four idle hours.\\n\\n**BACKSTOP, NEVER THE MECHANISM — YOUR BOUNDARY IS AS REAL AS THEIRS (founder ruling 2026-08-07).**\\nSilence longer than about twenty minutes earns ONE bounded read-only check: is the process alive,\\ndid the file land, what does the `.stderr.log` say. That check has repeatedly caught what nothing\\nelse caught, and it stays.\\nWhat it must never become is the item's clock. On AI4DEV-48 the coordinator detected six\\nconsecutive phase changes and woke the conductor for each; the item finished, and the conductor's\\nown alarms were never once exercised. That is a boundary crossed by the actor with the best\\nintentions, and it hides the very defect it compensates for — after six silent saves, nobody can\\ntell a working conductor from an absent one.\\n- **Report every wake you send as a conductor defect**, in the same breath, to the founder. Never\\n  quietly absorb it. A save you do not name is a measurement you destroyed.\\n- **Two in one item means the design is not working** — say so plainly and propose the fix rather\\n  than carrying the item on your back to the end.\\n- **You still never write in the item's tree, rule on its content, or run its commands.** Rescuing\\n  unpushed work after a confirmed death is the one exception, and it is recorded AS a rescue.\\n\\n**Fable out of credit** → tell the conductor to spawn `orchestrator-opus` for subsequent\\nsittings, and say so in the report; the handoff is manual because `--fallback-model` never fires\\non billing errors. **A session limit is not out of credit** — it is the five-hour window, it is\\naccount-wide, and it heals itself. Never set a timer for the reset: it would fire into a\\ncredit-dead account, and a reset time already past rolls a full day.\\n\\n## Phase C — close the item\\n\\nThe conductor reports the merge. Then:\\n\\n1. **Sweep**: release the database slot, then remove the item's worktree, its generated\\n   `worktree-agent-*` branch, and its artifacts directory — after confirming the raw critiques and\\n   distillates were committed into the record by the fix and audit sittings. Only you can sweep —\\n   the permission classifier blocks subagents from removing a worktree.\\n   **`Release-DbSlot -Item <id>`** from `loop/work/db-slots.ps1` gives the slot back. It refuses a\\n   reservation naming a different item, and it refuses while a verify window is still open on that\\n   slot — both refusals are loud, and both mean the sweep is early, not that the helper is broken.\\n   **`locked` does NOT mean an agent is alive** (measured 2026-08-07). The lock reason names the\\n   PARENT SESSION's pid, not the agent's — read it and you will find your own `claude.exe\\n   --resume <this session>`. It clears when the platform tears the agent down cleanly, and\\n   survives when the agent dies abruptly, so on a stood-down item the lock outlives the agent and\\n   would keep every stale worktree in the founder's project folder for the rest of the session.\\n   Judge liveness by the AGENT, not the lock: its task is gone and its transcript is not growing.\\n   Then confirm the tree is clean and its head is on the remote, `git worktree unlock`, and\\n   remove. The tree of an agent that is genuinely still running is still never touched.\\n2. **Fold upward**: re-read the parent's children **fresh**; all Done or Cancelled → fold,\\n   cascading, stopping below a requirement, naming every cancelled child.\\n3. **Release**: print `session is free`, report open siblings with labels, suggest the next\\n   `/work`.\\n\\n**When git and the board disagree, git is truth for merge state and the board mirrors it.**\\nRepairing from primary evidence is legitimate and is recorded AS a repair; asserting a state you\\nnever observed is not. Webhook slow → a bounded re-read. Two siblings merging at once → confirm\\nYOUR item Done before reading siblings, so whoever finishes second sees the complete set. No\\nlocks by design: converge on re-read.\\n\\n## Requirement evidence gate — pinned, not asserted\\n\\nAn exhaustive leaf snapshot at a named commit · attribution resolved · the suite green at\\nintegration tier at that commit with named checks and timestamps · a recorded founder attestation\\nwith a date · an explicit recorded waiver path. **`/work` proposes; it never closes a requirement\",\"lineStart\":80,\"lineEnd\":209,\"totalLines\":264,\"truncated\":true}},\"title\":\".claude\\\\skills\\\\work\\\\SKILL.md\",\"time\":{\"start\":1786349915036,\"end\":1786349915063}},\"id\":\"prt_feac08a36001nuQOSdwczDeUkw\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"messageID\":\"msg_feac080c0001eqZEbWCQD3JWB7\"}}\r\n+{\"type\":\"step_finish\",\"timestamp\":1786349915538,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feac08d85001hUZvx4DVhXF457\",\"reason\":\"tool-calls\",\"snapshot\":\"6b943ffd152a2c0995246203f99d68f3798f3e4b\",\"messageID\":\"msg_feac080c0001eqZEbWCQD3JWB7\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"type\":\"step-finish\",\"tokens\":{\"total\":90817,\"input\":332,\"output\":117,\"reasoning\":0,\"cache\":{\"write\":0,\"read\":90368}},\"cost\":0.0001661352}}\r\n+{\"type\":\"step_start\",\"timestamp\":1786349917761,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feac09639001lki4eLwwuahUWL\",\"messageID\":\"msg_feac08f60001H5Uv59Rrx8doMv\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"snapshot\":\"6a0f6975983d1016adb4b88ae55280b854dc84be\",\"type\":\"step-start\"}}\r\n+{\"type\":\"tool_use\",\"timestamp\":1786349920259,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"type\":\"tool\",\"tool\":\"read\",\"callID\":\"call_00_TENtbB1As7PX5a6y0GSa8100\",\"state\":{\"status\":\"completed\",\"input\":{\"filePath\":\"C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\loop\\\\items\\\\AI4DEV-79\\\\setup-pool.txt\"},\"output\":\"<path>C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\loop\\\\items\\\\AI4DEV-79\\\\setup-pool.txt</path>\\n<type>file</type>\\n<content>\\n1: \\n2: AI4DEV-79 (parallel DB slot pool) - step S2, the one-time pool setup on the dev machine.\\n3: \\n4: REDACTION: every line below passed a redactor before it was written. JWT tokens (eyJ...),\\n5: sb_ keys, database passwords, the JWT secret and the S3 protocol keys are replaced. Nothing\\n6: was removed for any other reason. Container names and ports are kept: they are the evidence.\\n7: \\n8: date            : 2026-08-10T00:59:58.7763402+03:00\\n9: machine         : MYPC\\n10: worktree        : C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\n11: branch          : nirdrang/ai4dev-79-a-pool-of-local-database-slots-so-items-verify-in-parallel\\n12: head            : 109c25a288dd92fcc404ad28382d395d64ec67fe\\n13: pool root       : C:\\\\Users\\\\nirdr\\\\AppData\\\\Local\\\\ai4good-build\\\\db-slots\\n14: \\n15: WHAT THIS TRANSCRIPT SETTLES. The plan recorded the Supabase CLI global --workdir flag as\\n16: UNVERIFIED and asked this step to settle it. It is only HALF true, and the half that is\\n17: false is dangerous, so the measurement is recorded here before the setup that depends on it.\\n18: \\n19: === docker server version ===\\n20: 29.6.2\\n21: \\n22: === containers running BEFORE setup ===\\n23: ai4good-runner | Up 3 days\\n24: supabase_analytics_poancmeitlmxejofwzuu | Up 6 hours (healthy)\\n25: supabase_auth_poancmeitlmxejofwzuu | Up 6 hours (healthy)\\n26: supabase_db_poancmeitlmxejofwzuu | Up 7 hours (healthy)\\n27: supabase_edge_runtime_poan