\n  const registrationDir = join(reportDir, 'registrations');\\n  mkdirSync(registrationDir);\\n  const cleanup = () => {\\n    cleanupRun(reportDir, lock);\\n    lock = null;\\n  };\\n  const onSignal = () => {\\n    cleanup();\\n    process.exit(130);\\n  };\\n  process.once('SIGINT', onSignal);\\n  process.once('SIGTERM', onSignal);\\n\\n  try {\\n    // THE DRILL TIER RESOLVES NO DATABASE. It used to reach the stack described by the repository's\\n    // own `supabase/config.toml` — which is the founder's personal stack — and reset it. Nothing in\\n    // this tree invokes the tier, so refusing costs nothing, and it closes the last path in the\\n    // harness that could reset that stack. The item that decides drill's stack replaces this.\\n    if (tier === 'drill') {\\n      return infra(\\n        `the drill tier's stack is not yet decided, so this tier resolves no database at all. It used ` +\\n          `to reset the stack described by the repository's own supabase/config.toml, which is the ` +\\n          `founder's personal stack, and that stack is untouchable.`,\\n      );\\n    }\\n\\n    if (tier === 'integration') {\\n      // THE STACK IS RESOLVED ONLY THROUGH THE POOL. Occupy a slot, make its database be this\\n      // tree's database, and hand the suite the slot's coordinates. The repo-configured stack is\\n      // never read, never locked and never reset from here.\\n      let occupancy: Occupancy;\\n      try {\\n        const override = process.env.AT_DB_SLOT?.trim();\\n        occupancy = occupy(`req-${requirement}`, override ? { slot: Number(override) } : {});\\n      } catch (err) {\\n        return infra((err as Error).message);\\n      }\\n      // The claim goes into the SAME `lock` variable `cleanupRun` already releases, so the release\\n      // stays in the one `finally` chain that exists rather than in a second one nobody can see.\\n      lock = occupancy.claim;\\n\\n      let prepared: PrepareResult;\\n      try {\\n        // prepare() mirrors this tree into the slot, regenerates the slot's identity, proves the\\n        // stack that answers is the slot's own, resets it, and proves the migration set replayed.\\n        prepared = await prepare(occupancy);\\n      } catch (err) {\\n        return infra(\\n          `slot ${occupancy.slot} could not be prepared: ${(err as Error).message}\\\\n` +\\n            `The integration tier rebuilds its slot's database from supabase/migrations on every run, ` +\\n            `so that a suite never grades leftover rows or a schema missing a migration; if that ` +\\n            `rebuild fails, the state under test is unknown and the run stops here.\\\\n${stackHelp}`,\\n        );\\n      }\\n\\n      // The ruled evidence line: which slot, that the reset happened, and the migration state.\\n      console.log(evidence(occupancy, prepared));\\n      Object.assign(stackEnv, slotStackEnv(occupancy, prepared.status));\\n    }\\n\\n    // The suites and their vitest root come from the DATA root; vitest itself comes from the\\n    // install root, so a run pointed at a disposable tree still runs the pinned test framework.\\n    const atRoot = join(REPO_ROOT, 'tests', 'at');\\n    const outputFile = join(reportDir, 'vitest-report.json');\\n    const rootOverride: Record<string, string> = {};\\n    if (process.env.AT_REPO_ROOT?.trim()) rootOverride.AT_REPO_ROOT = process.env.AT_REPO_ROOT.trim();\\n\\n    const run = spawnSync(\\n      bunExecutable(),\\n      [\\n        '--no-env-file',\\n        join(INSTALL_ROOT, 'node_modules', 'vitest', 'vitest.mjs'),\\n        'run',\\n        '--root',\\n        atRoot,\\n        '--config',\\n        join(atRoot, 'vitest.config.ts'),\\n        '--reporter=json',\\n        `--outputFile=${outputFile}`,\\n        `suites/req-${requirement}/`,\\n      ],\\n      {\\n        cwd: INSTALL_ROOT,\\n        env: childEnv({ ...stackEnv, ...rootOverride, AT_TIER: tier, AT_REGISTRATION_DIR: registrationDir }),\\n        stdio: ['ignore', 'inherit', 'inherit'],\\n      },\\n    );\\n\\n    if (!existsSync(outputFile)) {\\n      console.error(\\n        `at:verify req-${requirement} — vitest produced no report ` +\\n          `(exit ${run.status}${run.signal ? `, signal ${run.signal}` : ''}` +\\n          `${run.error ? `, ${diagnostic((run.error as Error).message)}` : ''})`,\\n      );\\n      return 4;\\n    }\\n\\n    let report: VitestJson;\\n    try {\\n      report = JSON.parse(readFileSync(outputFile, 'utf8')) as VitestJson;\\n    } catch (err) {\\n      console.error(`at:verify req-${requirement} — unreadable vitest report: ${(err as Error).message}`);\\n      return 4;\\n    }\\n\\n    const assertions = (report.testResults ?? []).flatMap((r) => r.assertionResults ?? []);\\n    const analysis = analyzeReportedTests(expected, runtimeRegistrations(registrationDir), assertions);\\n    const { rows, unexpected } = analysis;\\n\\n    console.log('');\\n    console.log(`at:verify req-${requirement} --tier ${tier}`);\\n    for (const row of rows) console.log(`  ${row.id.padEnd(12)} ${row.status.padEnd(8)} ${row.detail}`);\\n    for (const id of unexpected) console.log(`  ${id.padEnd(12)} ${'extra'.padEnd(8)} registered but not a P0 of this requirement`);\\n\\n    const green = rows.filter((r) => r.status === 'green').length;\\n    const red = rows.filter((r) => r.status === 'red').length;\\n    const missing = rows.filter((r) => r.status === 'missing').length;\\n    console.log(\\n      `  ${rows.length} P0: ${green} green, ${red} red, ${missing} missing${unexpected.length ? `, ${unexpected.length} extra` : ''}`,\\n    );\\n\\n    if (!expectation) {\\n      const verdict = runVerdict(rows, unexpected, run as ProcessOutcome);\\n      if (verdict.length === 0) return 0;\\n      for (const problem of verdict) console.log(`  FAILURE: ${problem}`);\\n      return 1;\\n    }\\n\\n    // Both deviation sets are computed and printed: an id-level and a report-level problem in the\\n    // same run are two facts an author needs at once, and printing only the first costs a second\\n    // run to find the second.\\n    const deviations = [\\n      ...expectationDeviations(rows, unexpected, expectation),\\n      ...reportAccountingDeviations(report, run as ProcessOutcome, expectation),\\n    ];\\n    if (deviations.length === 0) {\\n      console.log(\\n        `  EXPECTED: the run matches ${expectedManifestPath(requirement)} exactly ` +\\n          `(${expectation.green.length} declared green, ${Object.keys(expectation.red).length} declared red)`,\\n      );\\n      return 0;\\n    }\\n    for (const deviation of deviations) console.log(`  DEVIATION: ${deviation}`);\\n    console.log(\\n      `  EXPECT FAILURE: ${deviations.length} deviation(s) from the declaration. A red that turned green is a ` +\\n        `failure too — if reality improved, update the declaration in the same change.`,\\n    );\\n    return 1;\\n  } finally {\\n    process.off('SIGINT', onSignal);\\n    process.off('SIGTERM', onSignal);\\n    cleanup();\\n  }\\n}\\n\\nif (import.meta.main) process.exit(await main(process.argv.slice(2)));\",\"lineStart\":1195,\"lineEnd\":1372,\"totalLines\":1372,\"truncated\":false}},\"title\":\"tests\\\\at\\\\harness\\\\runner.ts\",\"time\":{\"start\":1786349875239,\"end\":1786349875268}},\"id\":\"prt_feabfeeff001xztloqd779yqwX\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"messageID\":\"msg_feabfe102001YSc6qNV0MQf28X\"}}\r\n+{\"type\":\"step_finish\",\"timestamp\":1786349875711,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feabff1f3001flPrU0xvtIqfAs\",\"reason\":\"tool-calls\",\"snapshot\":\"0d51d8f4d77b792f709f68aa52a24ad3a75effa6\",\"messageID\":\"msg_feabfe102001YSc6qNV0MQf28X\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"type\":\"step-finish\",\"tokens\":{\"total\":74439,\"input\":15959,\"output\":101,\"reasoning\":11,\"cache\":{\"write\":0,\"read\":58368}},\"cost\":0.0012145252}}\r\n+{\"type\":\"step_start\",\"timestamp\":1786349890247,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feac02ac5001YXz7IAM7LzQnGR\",\"messageID\":\"msg_feabff3b8001bLuMZ9f58S189R\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"snapshot\":\"42f01e7412c793966762b479258eab221f9c3a67\",\"type\":\"step-start\"}}\r\n+{\"type\":\"tool_use\",\"timestamp\":1786349897726,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"type\":\"tool\",\"tool\":\"read\",\"callID\":\"call_00_g4ob0GFJRAg8DCm4995n1755\",\"state\":{\"status\":\"completed\",\"input\":{\"filePath\":\"C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\db-pool.selftest.ts\"},\"output\":\"<path>C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\db-pool.selftest.ts</path>\\n<type>file</type>\\n<content>\\n1: /**\\n2:  * Tests OF the database slot pool, not tests run BY it.\\n3:  *\\n4:  * THEY RUN WITH NO DOCKER, NO STACK AND NO SLOT DIRECTORY ON THIS MACHINE, because CI runs them\\n5:  * that way (no Docker step, either runner) and a test that quietly needs a live stack would be\\n6:  * green on the dev machine and absent everywhere else. So the pool root is a temporary directory\\n7:  * (`AT_DB_POOL_ROOT`), the claim directory is a temporary directory (`AT_LOCK_DIR`), and the only\\n8:  * thing that is real is the claim protocol and the configuration arithmetic — which is exactly\\n9:  * what these tests are about.\\n10:  *\\n11:  * WHAT THEY DO NOT CLAIM: nothing here proves the isolation wall. A Dockerless test cannot reset a\\n12:  * database, so it cannot prove that a reset lands where it was aimed. That proof is the committed\\n13:  * spike transcript, taken once on the dev machine against three real stacks.\\n14:  */\\n15: \\n16: import { spawn, spawnSync } from 'node:child_process';\\n17: import { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, symlinkSync, writeFileSync } from 'node:fs';\\n18: import { tmpdir } from 'node:os';\\n19: import { join } from 'node:path';\\n20: import { afterAll, beforeAll, describe, expect, it, vi } from 'vitest';\\n21: \\n22: import { REPO_ROOT } from './check.ts';\\n23: import { bunExecutable, stackLockPath, type StackStatus } from './runner.ts';\\n24: import {\\n25:   evidence,\\n26:   generateSlotConfig,\\n27:   itemFromBranch,\\n28:   mirrorItemTree,\\n29:   occupy,\\n30:   pathClosureProblems,\\n31:   personalBlockProblems,\\n32:   portMappings,\\n33:   release,\\n34:   reservationPath,\\n35:   slotClaimKey,\\n36:   slotConfigPath,\\n37:   slotDir,\\n38:   slotProjectId,\\n39:   type Occupancy,\\n40:   type PrepareResult,\\n41: } from './db-pool.ts';\\n42: \\n43: const REPO_CONFIG = readFileSync(join(REPO_ROOT, 'supabase', 'config.toml'), 'utf8');\\n44: \\n45: let poolTemp = '';\\n46: let lockTemp = '';\\n47: let previousPool: string | undefined;\\n48: let previousLocks: string | undefined;\\n49: \\n50: /** Write a slot's `config.toml` into the temporary pool, exactly as `setup` would. */\\n51: function installSlot(slot: number): void {\\n52:   mkdirSync(join(slotDir(slot), 'supabase'), { recursive: true });\\n53:   writeFileSync(slotConfigPath(slot), generateSlotConfig(REPO_CONFIG, slot), 'utf8');\\n54: }\\n55: \\n56: /**\\n57:  * Where the occupancy claim for a slot lives.\\n58:  *\\n59:  * IT IS DERIVED FROM THE SLOT NUMBER, never from the slot's current config (ruling T6). A test that\\n60:  * read the config for the api port would be asserting against a name `prepare` is allowed to move,\\n61:  * and would keep passing while the two runs it is meant to serialize held different files.\\n62:  */\\n63: function claimPath(slot: number): string {\\n64:   return stackLockPath(slotClaimKey(slot));\\n65: }\\n66: \\n67: /** A process id that is PROVABLY dead: a real child, started, waited for, and gone (ruling F9). */\\n68: function deadPid(): number {\\n69:   const child = spawnSync(bunExecutable(), ['--no-env-file', '-e', 'process.exit(0)'], { encoding: 'utf8' });\\n70:   expect(typeof child.pid, 'the probe child reported no process id, so nothing provably dead exists to plant').toBe('number');\\n71:   return child.pid as number;\\n72: }\\n73: \\n74: function writeReservation(slot: number, item: string): void {\\n75:   mkdirSync(join(poolTemp, 'reservations'), { recursive: true });\\n76:   writeFileSync(\\n77:     reservationPath(slot),\\n78:     JSON.stringify({ slot, item, branch: 'test', at: new Date().toISOString(), holder: 'selftest' }),\\n79:     'utf8',\\n80:   );\\n81: }\\n82: \\n83: function plantClaim(slot: number, holder: Record<string, unknown>): void {\\n84:   writeFileSync(claimPath(slot), JSON.stringify(holder), 'utf8');\\n85: }\\n86: \\n87: /** A claim file exactly as it looks mid-write, or after a crash: present, and saying nothing. */\\n88: function plantRawClaim(slot: number, text: string): void {\\n89:   writeFileSync(claimPath(slot), text, 'utf8');\\n90: }\\n91: \\n92: function scrubClaim(slot: number): void {\\n93:   rmSync(claimPath(slot), { force: true });\\n94: }\\n95: \\n96: beforeAll(() => {\\n97:   previousPool = process.env.AT_DB_POOL_ROOT;\\n98:   previousLocks = process.env.AT_LOCK_DIR;\\n99:   poolTemp = mkdtempSync(join(tmpdir(), 'at-db-pool-'));\\n100:   lockTemp = mkdtempSync(join(tmpdir(), 'at-db-locks-'));\\n101:   process.env.AT_DB_POOL_ROOT = poolTemp;\\n102:   process.env.AT_LOCK_DIR = lockTemp;\\n103: });\\n104: \\n105: afterAll(() => {\\n106:   if (previousPool === undefined) delete process.env.AT_DB_POOL_ROOT;\\n107:   else process.env.AT_DB_POOL_ROOT = previousPool;\\n108:   if (previousLocks === undefined) delete process.env.AT_LOCK_DIR;\\n109:   else process.env.AT_LOCK_DIR = previousLocks;\\n110:   rmSync(poolTemp, { recursive: true, force: true });\\n111:   rmSync(lockTemp, { recursive: true, force: true });\\n112: });\\n113: \\n114: describe('one slot has exactly one occupier', () => {\\n115:   it('two concurrent occupies on one slot end with exactly one winner', async () => {\\n116:     installSlot(1);\\n117:     const moduleUrl = new URL('./db-pool.ts', import.meta.url).href;\\n118:     const startAt = Date.now() + 800;\\n119: \\n120:     const contender = (): Promise<string> => {\\n121:       const code =\\n122:         `const { occupy } = await import(${JSON.stringify(moduleUrl)});\\\\n` +\\n123:         `while (Date.now() < ${startAt}) {}\\\\n` + // a barrier, so both attempt at the same instant\\n124:         `try {\\\\n` +\\n125:         `  const held = occupy('req-000', { slot: 1 });\\\\n` +\\n126:         `  console.log('ACQUIRED');\\\\n` +\\n127:         `  await Bun.sleep(600);\\\\n` + // hold it, so the loser meets a LIVE holder\\n128:         `  held.release();\\\\n` +\\n129:         `} catch { console.log('REFUSED'); }\\\\n`;\\n130:       // spawn, NOT spawnSync: a synchronous spawn would run the contenders one after the other,\\n131:       // and the second would find the claim already released — a race that never raced.\\n132:       return new Promise<string>((resolve) => {\\n133:         const child = spawn(bunExecutable(), ['--no-env-file', '-e', code], {\\n134:           env: { ...process.env, AT_DB_POOL_ROOT: poolTemp, AT_LOCK_DIR: lockTemp } as NodeJS.ProcessEnv,\\n135:           stdio: ['ignore', 'pipe', 'pipe'],\\n136:         });\\n137:         let out = '';\\n138:         child.stdout.on('data', (chunk: Buffer) => (out += chunk.toString('utf8')));\\n139:         child.stderr.on('data', (chunk: Buffer) => (out += chunk.toString('utf8')));\\n140:         child.once('error', (err) => resolve(`ERROR ${err.message}`));\\n141:         child.once('close', () => resolve(out));\\n142:       });\\n143:     };\\n144: \\n145:     const [a, b] = await Promise.all([contender(), contender()]);\\n146:     const outcomes = [a, b].map((out) => (out.includes('ACQUIRED') ? 'ACQUIRED' : out.includes('REFUSED') ? 'REFUSED' : `UNKNOWN(${out.trim()})`));\\n147: \\n148:     try {\\n149:       expect(outcomes.filter((o) => o === 'ACQUIRED'), `outcomes were ${JSON.stringify(outcomes)}`).toHaveLength(1);\\n150:       expect(outcomes.filter((o) => o === 'REFUSED'), `outcomes were ${JSON.stringify(outcomes)}`).toHaveLength(1);\\n151:       expect(existsSync(claimPath(1)), 'the winner did not release its claim').toBe(false);\\n152:     } finally {\\n153:       scrubClaim(1);\\n154:     }\\n155:   }, 60_000);\\n156: \\n157:   it('breaks a dead holder LOUDLY and records the takeover in the new claim', () => {\\n158:     installSlot(1);\\n159:     // A REAL process id, from a child that has already exited (ruling F9). A made-up large number\\n160:     // is only ASSUMED dead, and a busy machine can legitimately be holding it — which would make\\n161:     // the one test that guards the takeover rule fail for a reason that has nothing to do with it.\\n162:     const gone = deadPid();\\n163:     plantClaim(1, { pid: gone, host: 'gone', requirement: 'req-000', startedAt: new Date().toISOString() });\\n164:     const said = vi.spyOn(console, 'log').mockImplementation(() => undefined);\\n165:     try {\\n166:       const held = occupy('req-016', { slot: 1 });\\n167:       const claim = JSON.parse(readFileSync(held.claim.file, 'utf8')) as {\\n168:         pid?: number;\\n169:         tookOverFrom?: { pid?: number; requirement?: string };\\n170:       };\\n171:       expect(claim.pid, 'the takeover did not record this process as the holder').toBe(process.pid);\\n172:       expect(claim.tookOverFrom?.pid, 'the displaced holder was not recorded IN the claim').toBe(gone);\\n173:       expect(claim.tookOverFrom?.requirement).toBe('req-000');\\n174:       expect(said.mock.calls.flat().join(' '), 'the takeover was silent').toContain('took over a stale stack lock');\\n175:       held.release();\\n176:     } finally {\\n177:       said.mockRestore();\\n178:       scrubClaim(1);\\n179:     }\\n180:   });\\n181: \\n182:   it('never takes over a LIVE holder, at any age, and names it', () => {\\n183:     installSlot(1);\\n184:     // Alive (this very process) and old enough that the runner's own stale window would displace\\n185:     // it. The pool passes dead-pid-only, so it must not.\\n186:     plantClaim(1, {\\n187:       pid: process.pid,\\n188:       host: 'here',\\n189:       requirement: 'req-000',\\n190:       startedAt: new Date(Date.now() - 48 * 60 * 60 * 1000).toISOString(),\\n191:     });\\n192:     try {\\n193:       expect(() => occupy('req-016', { slot: 1 })).toThrow(new RegExp(`another at:verify run holds this stack \\\\\\\\(pid ${process.pid}`));\\n194:     } finally {\\n195:       scrubClaim(1);\\n196:     }\\n197:   });\\n198: \\n199:   it('never takes over a claim file it cannot identify, and names the file (ruling T1)', () => {\\n200:     installSlot(1);\\n201:     // AN EMPTY FILE IS WHAT A LIVE CLAIM LOOKS LIKE MID-WRITE. The exclusive create and the write\\n202:     // that fills it are two acts, and between them the file exists and says nothing. Under\\n203:     // dead-pid-only that must NEVER read as a dead holder: taking it over would delete a live\\n204:     // run's brand-new claim, which is the one thing this policy exists to make impossible.\\n205:     for (const planted of ['', '   \\\\n', '{\\\"pid\\\":', 'not json at all']) {\\n206:       plantRawClaim(1, planted);\\n207:       try {\\n208:         expect(() => occupy('req-016', { slot: 1 }), `a claim file containing ${JSON.stringify(planted)} was taken over`).toThrow(\\n209:           /names no process id that this run can read/,\\n210:         );\\n211:         expect(() => occupy('req-016', { slot: 1 })).toThrow(claimPath(1));\\n212:         expect(existsSync(claimPath(1)), 'the refusal deleted the file it could not identify').toBe(true);\\n213:       } finally {\\n214:         scrubClaim(1);\\n215:       }\\n216:     }\\n217:   }, 30_000);\\n218: \\n219:   it('releases from a `finally` when the caller throws', () => {\\n220:     installSlot(1);\\n221:     let held: Occupancy | null = null;\\n222:     expect(() => {\\n223:       try {\\n224:         held = occupy('req-016', { slot: 1 });\\n225:         throw new Error('the suite blew up');\\n226:       } finally {\\n227:         release(held);\\n228:       }\\n229:     }).toThrow('the suite blew up');\\n230:     expect(existsSync(claimPath(1)), 'a throwing caller stranded the occupancy claim').toBe(false);\\n231:   });\\n232: });\\n233: \\n234: describe('admission control belongs to the coordinator, not to the run', () => {\\n235:   it('refuses a run whose item holds no reservation, and names the helper that makes one', () => {\\n236:     rmSync(reservationPath(1), { force: true });\\n237:     rmSync(reservationPath(2), { force: true });\\n238:     expect(() => occupy('req-016', { item: 'AI4DEV-999' })).toThrow(/Reserve-DbSlot -Item AI4DEV-999/);\\n239:     expect(() => occupy('req-016', { item: 'AI4DEV-999' })).toThrow(/no fallback onto a free slot/);\\n240:   });\\n241: \\n242:   it('finds the slot the reservation names', () => {\\n243:     installSlot(2);\\n244:     writeReservation(2, 'AI4DEV-79');\\n245:     try {\\n246:       const held = occupy('req-016', { item: 'AI4DEV-79' });\\n247:       expect(held.slot).toBe(2);\\n248:       expect(held.via).toBe('reservation');\\n249:       held.release();\\n250:     } finally {\\n251:       rmSync(reservationPath(2), { force: true });\\n252:       scrubClaim(2);\\n253:     }\\n254:   });\\n255: \\n256:   it('refuses an AT_DB_SLOT run aimed at a slot another item holds (ruling T5)', () => {\\n257:     installSlot(2);\\n258:     writeReservation(2, 'AI4DEV-900');\\n259:     try {\\n260:       expect(() => occupy('req-016', { slot: 2, item: 'AI4DEV-79' })).toThrow(/reserved for AI4DEV-900/);\\n261:       expect(existsSync(claimPath(2)), 'the refusal still took the claim').toBe(false);\\n262:     } finally {\\n263:       rmSync(reservationPath(2), { force: true });\\n264:       scrubClaim(2);\\n265:     }\\n266:   });\\n267: \\n268:   it('lets an AT_DB_SLOT run take a slot reserved for its OWN item', () => {\\n269:     installSlot(2);\\n270:     writeReservation(2, 'AI4DEV-79');\\n271:     try {\\n272:       const held = occupy('req-016', { slot: 2, item: 'AI4DEV-79' });\\n273:       expect(held.via).toBe('override');\\n274:       expect(held.slot).toBe(2);\\n275:       held.release();\\n276:     } finally {\\n277:       rmSync(reservationPath(2), { force: true });\\n278:       scrubClaim(2);\\n279:     }\\n280:   });\\n281: });\\n282: \\n283: describe('the branch parser fails closed', () => {\\n284:   it('accepts exactly one item id', () => {\\n285:     expect(itemFromBranch('nirdrang/ai4dev-79-a-pool-of-local-database-slots')).toBe('AI4DEV-79');\\n286:     expect(itemFromBranch('feature/AI4PM-19-auth')).toBe('AI4PM-19');\\n287:   });\\n288: \\n289:   it('refuses zero ids, several ids, an empty name and a detached HEAD', () => {\\n290:     expect(() => itemFromBranch('main')).toThrow(/names no item id/);\\n291:     expect(() => itemFromBranch('nirdrang/ai4dev-79-and-ai4dev-80')).toThrow(/names 2 item ids/);\\n292:     expect(() => itemFromBranch('')).toThrow(/branch name is empty/);\\n293:     expect(() => itemFromBranch('HEAD')).toThrow(/HEAD is detached/);\\n294:   });\\n295: });\\n296: \\n297: describe('the personal stack is refused in code', () => {\\n298:   it('refuses the repo project id and any port in the personal block', () => {\\n299:     const personal = /project_id\\\\s*=\\\\s*\\\"([^\\\"]+)\\\"/.exec(REPO_CONFIG)?.[1] ?? '';\\n300:     expect(personal, 'the repository config carries no project_id to test against').not.toBe('');\\n301: \\n302:     const problems = personalBlockProblems(REPO_CONFIG, personal);\\n303:     expect(problems.join(' '), 'the repo config was not recognised as the personal identity').toContain(`project id \\\"${personal}\\\"`);\\n304:     expect(problems.join(' '), 'a 54321-block port was not refused').toMatch(/is inside the personal stack's port block/);\\n305:     expect(problems.join(' '), 'the personal inspector port was not refused').toContain('inspector_port');\\n306:   });\\n307: \\n308:   it('accepts a generated slot config, which is the same file wearing a slot identity', () => {\\n309:     const personal = /project_id\\\\s*=\\\\s*\\\"([^\\\"]+)\\\"/.exec(REPO_CONFIG)?.[1] ?? '';\\n310:     expect(personalBlockProblems(generateSlotConfig(REPO_CONFIG, 1), personal)).toEqual([]);\\n311:     expect(personalBlockProblems(generateSlotConfig(REPO_CONFIG, 2), personal)).toEqual([]);\\n312:   });\\n313: });\\n314: \\n315: describe('the identity overlay moves the identity and nothing else', () => {\\n316:   it('changes exactly the project id and the listener ports, byte for byte elsewhere', () => {\\n317:     const generated = generateSlotConfig(REPO_CONFIG, 1);\\n318:     const source = REPO_CONFIG.split('\\\\n');\\n319:     const slot = generated.split('\\\\n');\\n320:     expect(slot.length, 'the overlay changed the number of lines').toBe(source.length);\\n321: \\n322:     const changed = source.map((line, index) => (line === slot[index] ? -1 : index)).filter((index) => index >= 0);\\n323:     const { mappings } = portMappings(REPO_CONFIG, 1);\\n324:     expect(changed.length, 'the overlay changed lines that are not identity fields').toBe(mappings.length + 1);\\n325: \\n326:     for (const mapping of mappings) {\\n327:       expect(changed, `[${mapping.section}] ${mapping.key} was not rewritten`).toContain(mapping.line);\\n328:       expect(slot[mapping.line]).toContain(String(mapping.to));\\n329:     }\\n330:     expect(generated).toContain(`project_id = \\\"${slotProjectId(1)}\\\"`);\\n331:   });\\n332: \\n333:   it('maps an enabled smtp_port, passes a client port through, and refuses what it cannot place', () => {\\n334:     const withSmtp =\\n335:       'project_id = \\\"demo\\\"\\\\n[local_smtp]\\\\nport = 54324\\\\nsmtp_port = 54325\\\\n[auth.email.smtp]\\\\nport = 587\\\\nhost = \\\"smtp.example.com\\\"\\\\n';\\n336:     const mapped = portMappings(withSmtp, 1);\\n337:     expect(mapped.problems, 'a legitimate configuration was refused').toEqual([]);\\n338:     expect(mapped.mappings.map((m) => `${m.section}.${m.key}:${m.from}->${m.to}`)).toEqual([\\n339:       'local_smtp.port:54324->55324',\\n340:       'local_smtp.smtp_port:54325->55325',\\n341:     ]);\\n342:     // Ruling E4: a client-connection port is data. It is neither moved nor refused.\\n343:     expect(generateSlotConfig(withSmtp, 1)).toContain('port = 587');\\n344: \\n345:     const outOfBand = portMappings('project_id = \\\"demo\\\"\\\\n[api]\\\\nport = 9999\\\\n', 1);\\n346:     expect(outOfBand.problems.join(' '), 'a listener port outside the band was silently kept').toContain('does not know where to move it');\\n347: \\n348:     const strayLocal = portMappings('project_id = \\\"demo\\\"\\\\n[storage]\\\\nport = 54500\\\\n', 1);\\n349:     expect(strayLocal.problems.join(' '), 'an unrecognised port in the local band was treated as data').toContain('decide by hand');\\n350:   });\\n351: \\n352:   it('moves the ruled inspector port by ten and refuses to guess at any other (ruling T8)', () => {\\n353:     // 8083 is the RULED value, and +N*10 is the rule written for it. Applying that same arithmetic\\n354:     // to a value nobody ruled is a guess, and a guess about a port is a collision with software\\n355:     // nobody in this process knows about.\\n356:     const ruled = portMappings('project_id = \\\"demo\\\"\\\\n[edge_runtime]\\\\ninspector_port = 8083\\\\n', 1);\\n357:     expect(ruled.problems, 'the ruled inspector port was refused').toEqual([]);\\n358:     expect(ruled.mappings.map((m) => `${m.from}->${m.to}`)).toEqual(['8083->8093']);\\n359: \\n360:     const other = portMappings('project_id = \\\"demo\\\"\\\\n[edge_runtime]\\\\ninspector_port = 9229\\\\n', 1);\\n361:     expect(other.problems.join(' '), 'an unruled inspector port was moved by a guess').toContain('does not know where to move it');\\n362:     expect(other.mappings, 'an unruled inspector port was mapped anyway').toEqual([]);\\n363: \\n364:     // In the local stack's own band it is an ordinary listener again, and the generic rule places it.\\n365:     const inBand = portMappings('project_id = \\\"demo\\\"\\\\n[edge_runtime]\\\\ninspector_port = 54444\\\\n', 2);\\n366:     expect(inBand.problems).toEqual([]);\\n367:     expect(inBand.mappings.map((m) => `${m.from}->${m.to}`)).toEqual(['54444->56444']);\\n368:   });\\n369: });\\n370: \\n371: describe('the path closure fails closed on what it cannot deliver', () => {\\n372:   it('accepts this repository\\\\'s config as it stands', () => {\\n373:     expect(pathClosureProblems(REPO_CONFIG, REPO_ROOT)).toEqual([]);\\n374:   });\\n375: \\n376:   it('refuses a path key whose array does not close on the same line (ruling F5)', () => {\\n377:     // `scanConfig` reads one line per setting, so this value is `[` and no path is extracted. For\\n378:     // the overlay an unseen value is copied verbatim and is safe; for the closure it is a missed\\n379:     // refusal, which is the whole thing this check exists to prevent.\\n380:     const multiLine = 'project_id = \\\"demo\\\"\\\\n[db.seed]\\\\nsql_paths = [\\\\n  \\\"./seed.sql\\\"\\\\n]\\\\n';\\n381:     const problems = pathClosureProblems(multiLine, REPO_ROOT);\\n382:     expect(problems.join(' '), 'a value this check cannot see passed silently').toContain('does not close on the same line');\\n383:     expect(problems.join(' '), 'the refusal did not name the repair').toContain('write the value on one line');\\n384: \\n385:     // The same paths on one line are visible again, and are inside supabase/, so they pass.\\n386:     expect(pathClosureProblems('project_id = \\\"demo\\\"\\\\n[db.seed]\\\\nsql_paths = [\\\"./seed.sql\\\"]\\\\n', REPO_ROOT)).toEqual([]);\\n387:   });\\n388: \\n389:   it('refuses a path outside supabase/ and a path inside a directory the mirror excludes', () => {\\n390:     expect(pathClosureProblems('project_id = \\\"demo\\\"\\\\n[db.seed]\\\\nsql_paths = [\\\"../seed.sql\\\"]\\\\n', REPO_ROOT).join(' ')).toContain('outside supabase/');\\n391:     expect(pathClosureProblems('project_id = \\\"demo\\\"\\\\n[db.seed]\\\\nsql_paths = [\\\"/etc/seed.sql\\\"]\\\\n', REPO_ROOT).join(' ')).toContain('absolute path');\\n392:     expect(\\n393:       pathClosureProblems('project_id = \\\"demo\\\"\\\\n[db.seed]\\\\nsql_paths = [\\\"./.temp/seed.sql\\\"]\\\\n', REPO_ROOT).join(' '),\\n394:       'a path into the CLI runtime state the mirror leaves behind was accepted',\\n395:     ).toContain('supabase/.temp');\\n396:   });\\n397: });\\n398: \\n399: describe('the mirror carries the project source and nothing else', () => {\\n400:   it('leaves out the CLI runtime directories and the item tree config (rulings T3, F3, T11)', () => {\\n401:     const item = mkdtempSync(join(tmpdir(), 'at-item-tree-'));\\n402:     mkdirSync(join(item, 'supabase', 'migrations'), { recursive: true });\\n403:     mkdirSync(join(item, 'supabase', 'functions', 'hello'), { recursive: true });\\n404:     mkdirSync(join(item, 'supabase', '.temp', 'start-secrets'), { recursive: true });\\n405:     mkdirSync(join(item, 'supabase', '.branches'), { recursive: true });\\n406:     writeFileSync(join(item, 'supabase', 'config.toml'), 'project_id = \\\"the-personal-identity\\\"\\\\n', 'utf8');\\n407:     writeFileSync(join(item, 'supabase', 'migrations', '20260101000000_a.sql'), 'select 1;\\\\n', 'utf8');\\n408:     writeFileSync(join(item, 'supabase', 'functions', 'hello', 'index.ts'), 'export default 1;\\\\n', 'utf8');\\n409:     writeFileSync(join(item, 'supabase', '.temp', 'start-secrets', 'anon'), 'a secret\\\\n', 'utf8');\\n410:     writeFileSync(join(item, 'supabase', '.branches', '_current_branch'), 'main\\\\n', 'utf8');\\n411: \\n412:     try {\\n413:       mirrorItemTree(item, 1);\\n414:       const slot = join(slotDir(1), 'supabase');\\n415:       expect(existsSync(join(slot, 'migrations', '20260101000000_a.sql')), 'a migration did not reach the slot').toBe(true);\\n416:       expect(existsSync(join(slot, 'functions', 'hello', 'index.ts')), 'an edge function did not reach the slot').toBe(true);\\n417:       expect(existsSync(join(slot, 'config.toml')), 'the item tree config reached the slot, carrying the personal identity').toBe(false);\\n418:       expect(existsSync(join(slot, '.temp')), 'the CLI runtime state about another stack reached the slot').toBe(false);\\n419:       expect(existsSync(join(slot, '.branches')), 'the CLI branch state reached the slot').toBe(false);\\n420:     } finally {\\n421:       rmSync(item, { recursive: true, force: true });\\n422:       rmSync(join(slotDir(1), 'supabase'), { recursive: true, force: true });\\n423:     }\\n424:   });\\n425: \\n426:   it('refuses the whole mirror when a symlink sits under supabase/ (ruling T13)', () => {\\n427:     const item = mkdtempSync(join(tmpdir(), 'at-item-link-'));\\n428:     mkdirSync(join(item, 'supabase', 'migrations'), { recursive: true });\\n429:     mkdirSync(join(item, 'elsewhere'), { recursive: true });\\n430:     // A directory junction on Windows needs no privilege; on other systems this is a plain symlink.\\n431:     symlinkSync(join(item, 'elsewhere'), join(item, 'supabase', 'migrations', 'linked'), 'junction');\\n432: \\n433:     try {\\n434:       expect(() => mirrorItemTree(item, 1)).toThrow(/symlink/);\\n435:       expect(() => mirrorItemTree(item, 1)).toThrow(/Nothing was copied/);\\n436:     } finally {\\n437:       rmSync(item, { recursive: true, force: true });\\n438:       rmSync(join(slotDir(1), 'supabase'), { recursive: true, force: true });\\n439:     }\\n440:   });\\n441: });\\n442: \\n443: describe('the evidence names the slot it ran against', () => {\\n444:   it('carries the slot, the project id, the api port, the reset and the migration state', () => {\\n445:     const held = {\\n446:       slot: 2,\\n447:       dir: slotDir(2),\\n448:       config: { projectId: 'ai4good-slot-2', apiPort: 56321, dbPort: 56322 },\\n449:       item: 'AI4DEV-79',\\n450:       via: 'reservation',\\n451:       claim: { file: '', release: () => undefined },\\n452:       release: () => undefined,\\n453:     } as Occupancy;\\n454:     const result: PrepareResult = {\\n455:       status: {} as StackStatus,\\n456:       migrations: { expected: 2, applied: 2 },\\n457:       restarted: false,\\n458:     };\\n459: \\n460:     const line = evidence(held, result);\\n461:     expect(line).toContain('db slot 2');\\n462:     expect(line).toContain('ai4good-slot-2');\\n463:     expect(line).toContain('api 56321');\\n464:     expect(line).toContain('reset OK');\\n465:     expect(line).toContain('2 expected, 2 applied');\\n466:   });\\n467: });\\n\\n(End of file - total 467 lines)\\n</content>\",\"metadata\":{\"preview\":\"/**\\n * Tests OF the database slot pool, not tests run BY it.\\n *\\n * THEY RUN WITH NO DOCKER, NO STACK AND NO SLOT DIRECTORY ON THIS MACHINE, because CI runs them\\n * that way (no Docker step, either runner) and a test that quietly needs a live stack would be\\n * green on the dev machine and absent everywhere else. So the pool root is a temporary directory\\n * (`AT_DB_POOL_ROOT`), the claim directory is a temporary directory (`AT_LOCK_DIR`), and the only\\n * thing that is real is the claim protocol and the configuration arithmetic — which is exactly\\n * what these tests are about.\\n *\\n * WHAT THEY DO NOT CLAIM: nothing here proves the isolation wall. A Dockerless test cannot reset a\\n * database, so it cannot prove that a reset lands where it was aimed. That proof is the committed\\n * spike transcript, taken once on the dev machine against three real stacks.\\n */\\n\\nimport { spawn, spawnSync } from 'node:child_process';\\nimport { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, symlinkSync, writeFileSync } from 'node:fs';\\nimport { tmpdir } from 'node:os';\\nimport { join } from 'node:path';\\nimport { afterAll, beforeAll, describe, expect, it, vi } from 'vitest';\",\"truncated\":false,\"loaded\":[],\"display\":{\"type\":\"file\",\"path\":\"C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\tests\\\\at\\\\harness\\\\db-pool.selftest.ts\",\"text\":\"/**\\n * Tests OF the database slot pool, not tests run BY it.\\n *\\n * THEY RUN WITH NO DOCKER, NO STACK AND NO SLOT DIRECTORY ON THIS MACHINE, because CI runs them\\n * that way (no Docker step, either runner) and a test that quietly needs a live stack would be\\n * green on the dev machine and absent everywhere else. So the pool root is a temporary directory\\n * (`AT_DB_POOL_ROOT`), the claim directory is a temporary directory (`AT_LOCK_DIR`), and the only\\n * thing that is real is the claim protocol and the configuration arithmetic — which is exactly\\n * what these tests are about.\\n *\\n * WHAT THEY DO NOT CLAIM: nothing here proves the isolation wall. A Dockerless test cannot reset a\\n * database, so it cannot prove that a reset lands where it was aimed. That proof is the committed\\n * spike transcript, taken once on the dev machine against three real stacks.\\n */\\n\\nimport { spawn, spawnSync } from 'node:child_process';\\nimport { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, symlinkSync, writeFileSync } from 'node:fs';\\nimport { tmpdir } from 'node:os';\\nimport { join } from 'node:path';\\nimport { afterAll, beforeAll, describe, expect, it, vi } from 'vitest';\\n\\nimport { REPO_ROOT } from './check.ts';\\nimport { bunExecutable, stackLockPath, type StackStatus } from './runner.ts';\\nimport {\\n  evidence,\\n  generateSlotConfig,\\n  itemFromBranch,\\n  mirrorItemTree,\\n  occupy,\\n  pathClosureProblems,\\n  personalBlockProblems,\\n  portMappings,\\n  release,\\n  reservationPath,\\n  slotClaimKey,\\n  slotConfigPath,\\n  slotDir,\\n  slotProjectId,\\n  type Occupancy,\\n  type PrepareResult,\\n} from './db-pool.ts';\\n\\nconst REPO_CONFIG = readFileSync(join(REPO_ROOT, 'supabase', 'config.toml'), 'utf8');\\n\\nlet poolTemp = '';\\nlet lockTemp = '';\\nlet previousPool: string | undefined;\\nlet previousLocks: string | undefined;\\n\\n/** Write a slot's `config.toml` into the temporary pool, exactly as `setup` would. */\\nfunction installSlot(slot: number): void {\\n  mkdirSync(join(slotDir(slot), 'supabase'), { recursive: true });\\n  writeFileSync(slotConfigPath(slot), generateSlotConfig(REPO_CONFIG, slot), 'utf8');\\n}\\n\\n/**\\n * Where the occupancy claim for a slot lives.\\n *\\n * IT IS DERIVED FROM THE SLOT NUMBER, never from the slot's current config (ruling T6). A test that\\n * read the config for the api port would be asserting against a name `prepare` is allowed to move,\\n * and would keep passing while the two runs it is meant to serialize held different files.\\n */\\nfunction claimPath(slot: number): string {\\n  return stackLockPath(slotClaimKey(slot));\\n}\\n\\n/** A process id that is PROVABLY dead: a real child, started, waited for, and gone (ruling F9). */\\nfunction deadPid(): number {\\n  const child = spawnSync(bunExecutable(), ['--no-env-file', '-e', 'process.exit(0)'], { encoding: 'utf8' });\\n  expect(typeof child.pid, 'the probe child reported no process id, so nothing provably dead exists to plant').toBe('number');\\n  return child.pid as number;\\n}\\n\\nfunction writeReservation(slot: number, item: string): void {\\n  mkdirSync(join(poolTemp, 'reservations'), { recursive: true });\\n  writeFileSync(\\n    reservationPath(slot),\\n    JSON.stringify({ slot, item, branch: 'test', at: new Date().toISOString(), holder: 'selftest' }),\\n    'utf8',\\n  );\\n}\\n\\nfunction plantClaim(slot: number, holder: Record<string, unknown>): void {\\n  writeFileSync(claimPath(slot), JSON.stringify(holder), 'utf8');\\n}\\n\\n/** A claim file exactly as it looks mid-write, or after a crash: present, and saying nothing. */\\nfunction plantRawClaim(slot: number, text: string): void {\\n  writeFileSync(claimPath(slot), text, 'utf8');\\n}\\n\\nfunction scrubClaim(slot: number): void {\\n  rmSync(claimPath(slot), { force: true });\\n}\\n\\nbeforeAll(() => {\\n  previousPool = process.env.AT_DB_POOL_ROOT;\\n  previousLocks = process.env.AT_LOCK_DIR;\\n  poolTemp = mkdtempSync(join(tmpdir(), 'at-db-pool-'));\\n  lockTemp = mkdtempSync(join(tmpdir(), 'at-db-locks-'));\\n  process.env.AT_DB_POOL_ROOT = poolTemp;\\n  process.env.AT_LOCK_DIR = lockTemp;\\n});\\n\\nafterAll(() => {\\n  if (previousPool === undefined) delete process.env.AT_DB_POOL_ROOT;\\n  else process.env.AT_DB_POOL_ROOT = previousPool;\\n  if (previousLocks === undefined) delete process.env.AT_LOCK_DIR;\\n  else process.env.AT_LOCK_DIR = previousLocks;\\n  rmSync(poolTemp, { recursive: true, force: true });\\n  rmSync(lockTemp, { recursive: true, force: true });\\n});\\n\\ndescribe('one slot has exactly one occupier', () => {\\n  it('two concurrent occupies on one slot end with exactly one winner', async () => {\\n    installSlot(1);\\n    const moduleUrl = new URL('./db-pool.ts', import.meta.url).href;\\n    const startAt = Date.now() + 800;\\n\\n    const contender = (): Promise<string> => {\\n      const code =\\n        `const { occupy } = await import(${JSON.stringify(moduleUrl)});\\\\n` +\\n        `while (Date.now() < ${startAt}) {}\\\\n` + // a barrier, so both attempt at the same instant\\n        `try {\\\\n` +\\n        `  const held = occupy('req-000', { slot: 1 });\\\\n` +\\n        `  console.log('ACQUIRED');\\\\n` +\\n        `  await Bun.sleep(600);\\\\n` + // hold it, so the loser meets a LIVE holder\\n        `  held.release();\\\\n` +\\n        `} catch { console.log('REFUSED'); }\\\\n`;\\n      // spawn, NOT spawnSync: a synchronous spawn would run the contenders one after the other,\\n      // and the second would find the claim already released — a race that never raced.\\n      return new Promise<string>((resolve) => {\\n        const child = spawn(bunExecutable(), ['--no-env-file', '-e', code], {\\n          env: { ...process.env, AT_DB_POOL_ROOT: poolTemp, AT_LOCK_DIR: lockTemp } as NodeJS.ProcessEnv,\\n          stdio: ['ignore', 'pipe', 'pipe'],\\n        });\\n        let out = '';\\n        child.stdout.on('data', (chunk: Buffer) => (out += chunk.toString('utf8')));\\n        child.stderr.on('data', (chunk: Buffer) => (out += chunk.toString('utf8')));\\n        child.once('error', (err) => resolve(`ERROR ${err.message}`));\\n        child.once('close', () => resolve(out));\\n      });\\n    };\\n\\n    const [a, b] = await Promise.all([contender(), contender()]);\\n    const outcomes = [a, b].map((out) => (out.includes('ACQUIRED') ? 'ACQUIRED' : out.includes('REFUSED') ? 'REFUSED' : `UNKNOWN(${out.trim()})`));\\n\\n    try {\\n      expect(outcomes.filter((o) => o === 'ACQUIRED'), `outcomes were ${JSON.stringify(outcomes)}`).toHaveLength(1);\\n      expect(outcomes.filter((o) => o === 'REFUSED'), `outcomes were ${JSON.stringify(outcomes)}`).toHaveLength(1);\\n      expect(existsSync(claimPath(1)), 'the winner did not release its claim').toBe(false);\\n    } finally {\\n      scrubClaim(1);\\n    }\\n  }, 60_000);\\n\\n  it('breaks a dead holder LOUDLY and records the takeover in the new claim', () => {\\n    installSlot(1);\\n    // A REAL process id, from a child that has already exited (ruling F9). A made-up large number\\n    // is only ASSUMED dead, and a busy machine can legitimately be holding it — which would make\\n    // the one test that guards the takeover rule fail for a reason that has nothing to do with it.\\n    const gone = deadPid();\\n    plantClaim(1, { pid: gone, host: 'gone', requirement: 'req-000', startedAt: new Date().toISOString() });\\n    const said = vi.spyOn(console, 'log').mockImplementation(() => undefined);\\n    try {\\n      const held = occupy('req-016', { slot: 1 });\\n      const claim = JSON.parse(readFileSync(held.claim.file, 'utf8')) as {\\n        pid?: number;\\n        tookOverFrom?: { pid?: number; requirement?: string };\\n      };\\n      expect(claim.pid, 'the takeover did not record this process as the holder').toBe(process.pid);\\n      expect(claim.tookOverFrom?.pid, 'the displaced holder was not recorded IN the claim').toBe(gone);\\n      expect(claim.tookOverFrom?.requirement).toBe('req-000');\\n      expect(said.mock.calls.flat().join(' '), 'the takeover was silent').toContain('took over a stale stack lock');\\n      held.release();\\n    } finally {\\n      said.mockRestore();\\n      scrubClaim(1);\\n    }\\n  });\\n\\n  it('never takes over a LIVE holder, at any age, and names it', () => {\\n    installSlot(1);\\n    // Alive (this very process) and old enough that the runner's own stale window would displace\\n    // it. The pool passes dead-pid-only, so it must not.\\n    plantClaim(1, {\\n      pid: process.pid,\\n      host: 'here',\\n      requirement: 'req-000',\\n      startedAt: new Date(Date.now() - 48 * 60 * 60 * 1000).toISOString(),\\n    });\\n    try {\\n      expect(() => occupy('req-016', { slot: 1 })).toThrow(new RegExp(`another at:verify run holds this stack \\\\\\\\(pid ${process.pid}`));\\n    } finally {\\n      scrubClaim(1);\\n    }\\n  });\\n\\n  it('never takes over a claim file it cannot identify, and names the file (ruling T1)', () => {\\n    installSlot(1);\\n    // AN EMPTY FILE IS WHAT A LIVE CLAIM LOOKS LIKE MID-WRITE. The exclusive create and the write\\n    // that fills it are two acts, and between them the file exists and says nothing. Under\\n    // dead-pid-only that must NEVER read as a dead holder: taking it over would delete a live\\n    // run's brand-new claim, which is the one thing this policy exists to make impossible.\\n    for (const planted of ['', '   \\\\n', '{\\\"pid\\\":', 'not json at all']) {\\n      plantRawClaim(1, planted);\\n      try {\\n        expect(() => occupy('req-016', { slot: 1 }), `a claim file containing ${JSON.stringify(planted)} was taken over`).toThrow(\\n          /names no process id that this run can read/,\\n        );\\n        expect(() => occupy('req-016', { slot: 1 })).toThrow(claimPath(1));\\n        expect(existsSync(claimPath(1)), 'the refusal deleted the file it could not identify').toBe(true);\\n      } finally {\\n        scrubClaim(1);\\n      }\\n    }\\n  }, 30_000);\\n\\n  it('releases from a `finally` when the caller throws', () => {\\n    installSlot(1);\\n    let held: Occupancy | null = null;\\n    expect(() => {\\n      try {\\n        held = occupy('req-016', { slot: 1 });\\n        throw new Error('the suite blew up');\\n      } finally {\\n        release(held);\\n      }\\n    }).toThrow('the suite blew up');\\n    expect(existsSync(claimPath(1)), 'a throwing caller stranded the occupancy claim').toBe(false);\\n  });\\n});\\n\\ndescribe('admission control belongs to the coordinator, not to the run', () => {\\n  it('refuses a run whose item holds no reservation, and names the helper that makes one', () => {\\n    rmSync(reservationPath(1), { force: true });\\n    rmSync(reservationPath(2), { force: true });\\n    expect(() => occupy('req-016', { item: 'AI4DEV-999' })).toThrow(/Reserve-DbSlot -Item AI4DEV-999/);\\n    expect(() => occupy('req-016', { item: 'AI4DEV-999' })).toThrow(/no fallback onto a free slot/);\\n  });\\n\\n  it('finds the slot the reservation names', () => {\\n    installSlot(2);\\n    writeReservation(2, 'AI4DEV-79');\\n    try {\\n      const held = occupy('req-016', { item: 'AI4DEV-79' });\\n      expect(held.slot).toBe(2);\\n      expect(held.via).toBe('reservation');\\n      held.release();\\n    } finally {\\n      rmSync(reservationPath(2), { force: true });\\n      scrubClaim(2);\\n    }\\n  });\\n\\n  it('refuses an AT_DB_SLOT run aimed at a slot another item holds (ruling T5)', () => {\\n    installSlot(2);\\n    writeReservation(2, 'AI4DEV-900');\\n    try {\\n      expect(() => occupy('req-016', { slot: 2, item: 'AI4DEV-79' })).toThrow(/reserved for AI4DEV-900/);\\n      expect(existsSync(claimPath(2)), 'the refusal still took the claim').toBe(false);\\n    } finally {\\n      rmSync(reservationPath(2), { force: true });\\n      scrubClaim(2);\\n    }\\n  });\\n\\n  it('lets an AT_DB_SLOT run take a slot reserved for its OWN item', () => {\\n    installSlot(2);\\n    writeReservation(2, 'AI4DEV-79');\\n    try {\\n      const held = occupy('req-016', { slot: 2, item: 'AI4DEV-79' });\\n      expect(held.via).toBe('override');\\n      expect(held.slot).toBe(2);\\n      held.release();\\n    } finally {\\n      rmSync(reservationPath(2), { force: true });\\n      scrubClaim(2);\\n    }\\n  });\\n});\\n\\ndescribe('the branch parser fails closed', () => {\\n  it('accepts exactly one item id', () => {\\n    expect(itemFromBranch('nirdrang/ai4dev-79-a-pool-of-local-database-slots')).toBe('AI4DEV-79');\\n    expect(itemFromBranch('feature/AI4PM-19-auth')).toBe('AI4PM-19');\\n  });\\n\\n  it('refuses zero ids, several ids, an empty name and a detached HEAD', () => {\\n    expect(() => itemFromBranch('main')).toThrow(/names no item id/);\\n    expect(() => itemFromBranch('nirdrang/ai4dev-79-and-ai4dev-80')).toThrow(/names 2 item ids/);\\n    expect(() => itemFromBranch('')).toThrow(/branch name is empty/);\\n    expect(() => itemFromBranch('HEAD')).toThrow(/HEAD is detached/);\\n  });\\n});\\n\\ndescribe('the personal stack is refused in code', () => {\\n  it('refuses the repo project id and any port in the personal block', () => {\\n    const personal = /project_id\\\\s*=\\\\s*\\\"([^\\\"]+)\\\"/.exec(REPO_CONFIG)?.[1] ?? '';\\n    expect(personal, 'the repository config carries no project_id to test against').not.toBe('');\\n\\n    const problems = personalBlockProblems(REPO_CONFIG, personal);\\n    expect(problems.join(' '), 'the repo config was not recognised as the personal identity').toContain(`project id \\\"${personal}\\\"`);\\n    expect(problems.join(' '), 'a 54321-block port was not refused').toMatch(/is inside the personal stack's port block/);\\n    expect(problems.join(' '), 'the personal inspector port was not refused').toContain('inspector_port');\\n  });\\n\\n  it('accepts a generated slot config, which is the same file wearing a slot identity', () => {\\n    const personal = /project_id\\\\s*=\\\\s*\\\"([^\\\"]+)\\\"/.exec(REPO_CONFIG)?.[1] ?? '';\\n    expect(personalBlockProblems(generateSlotConfig(REPO_CONFIG, 1), personal)).toEqual([]);\\n    expect(personalBlockProblems(generateSlotConfig(REPO_CONFIG, 2), personal)).toEqual([]);\\n  });\\n});\\n\\ndescribe('the identity overlay moves the identity and nothing else', () => {\\n  it('changes exactly the project id and the listener ports, byte for byte elsewhere', () => {\\n    const generated = generateSlotConfig(REPO_CONFIG, 1);\\n    const source = REPO_CONFIG.split('\\\\n');\\n    const slot = generated.split('\\\\n');\\n    expect(slot.length, 'the overlay changed the number of lines').toBe(source.length);\\n\\n    const changed = source.map((line, index) => (line === slot[index] ? -1 : index)).filter((index) => index >= 0);\\n    const { mappings } = portMappings(REPO_CONFIG, 1);\\n    expect(changed.length, 'the overlay changed lines that are not identity fields').toBe(mappings.length + 1);\\n\\n    for (const mapping of mappings) {\\n      expect(changed, `[${mapping.section}] ${mapping.key} was not rewritten`).toContain(mapping.line);\\n      expect(slot[mapping.line]).toContain(String(mapping.to));\\n    }\\n    expect(generated).toContain(`project_id = \\\"${slotProjectId(1)}\\\"`);\\n  });\\n\\n  it('maps an enabled smtp_port, passes a client port through, and refuses what it cannot place', () => {\\n    const withSmtp =\\n      'project_id = \\\"demo\\\"\\\\n[local_smtp]\\\\nport = 54324\\\\nsmtp_port = 54325\\\\n[auth.email.smtp]\\\\nport = 587\\\\nhost = \\\"smtp.example.com\\\"\\\\n';\\n    const mapped = portMappings(withSmtp, 1);\\n    expect(mapped.problems, 'a legitimate configuration was refused').toEqual([]);\\n    expect(mapped.mappings.map((m) => `${m.section}.${m.key}:${m.from}->${m.to}`)).toEqual([\\n      'local_smtp.port:54324->55324',\\n      'local_smtp.smtp_port:54325->55325',\\n    ]);\\n    // Ruling E4: a client-connection port is data. It is neither moved nor refused.\\n    expect(generateSlotConfig(withSmtp, 1)).toContain('port = 587');\\n\\n    const outOfBand = portMappings('project_id = \\\"demo\\\"\\\\n[api]\\\\nport = 9999\\\\n', 1);\\n    expect(outOfBand.problems.join(' '), 'a listener port outside the band was silently kept').toContain('does not know where to move it');\\n\\n    const strayLocal = portMappings('project_id = \\\"demo\\\"\\\\n[storage]\\\\nport = 54500\\\\n', 1);\\n    expect(strayLocal.problems.join(' '), 'an unrecognised port in the local band was treated as data').toContain('decide by hand');\\n  });\\n\\n  it('moves the ruled inspector port by ten and refuses to guess at any other (ruling T8)', () => {\\n    // 8083 is the RULED value, and +N*10 is the rule written for it. Applying that same arithmetic\\n    // to a value nobody ruled is a guess, and a guess about a port is a collision with software\\n    // nobody in this process knows about.\\n    const ruled = portMappings('project_id = \\\"demo\\\"\\\\n[edge_runtime]\\\\ninspector_port = 8083\\\\n', 1);\\n    expect(ruled.problems, 'the ruled inspector port was refused').toEqual([]);\\n    expect(ruled.mappings.map((m) => `${m.from}->${m.to}`)).toEqual(['8083->8093']);\\n\\n    const other = portMappings('project_id = \\\"demo\\\"\\\\n[edge_runtime]\\\\ninspector_port = 9229\\\\n', 1);\\n    expect(other.problems.join(' '), 'an unruled inspector port was moved by a guess').toContain('does not know where to move it');\\n    expect(other.mappings, 'an unruled inspector port was mapped anyway').toEqual([]);\\n\\n    // In the local stack's own band it is an ordinary listener again, and the generic rule places it.\\n    const inBand = portMappings('project_id = \\\"demo\\\"\\\\n[edge_runtime]\\\\ninspector_port = 54444\\\\n', 2);\\n    expect(inBand.problems).toEqual([]);\\n    expect(inBand.mappings.map((m) => `${m.from}->${m.to}`)).toEqual(['54444->56444']);\\n  });\\n});\\n\\ndescribe('the path closure fails closed on what it cannot deliver', () => {\\n  it('accepts this repository\\\\'s config as it stands', () => {\\n    expect(pathClosureProblems(REPO_CONFIG, REPO_ROOT)).toEqual([]);\\n  });\\n\\n  it('refuses a path key whose array does not close on the same line (ruling F5)', () => {\\n    // `scanConfig` reads one line per setting, so this value is `[` and no path is extracted. For\\n    // the overlay an unseen value is copied verbatim and is safe; for the closure it is a missed\\n    // refusal, which is the whole thing this check exists to prevent.\\n    const multiLine = 'project_id = \\\"demo\\\"\\\\n[db.seed]\\\\nsql_paths = [\\\\n  \\\"./seed.sql\\\"\\\\n]\\\\n';\\n    const problems = pathClosureProblems(multiLine, REPO_ROOT);\\n    expect(problems.join(' '), 'a value this check cannot see passed silently').toContain('does not close on the same line');\\n    expect(problems.join(' '), 'the refusal did not name the repair').toContain('write the value on one line');\\n\\n    // The same paths on one line are visible again, and are inside supabase/, so they pass.\\n    expect(pathClosureProblems('project_id = \\\"demo\\\"\\\\n[db.seed]\\\\nsql_paths = [\\\"./seed.sql\\\"]\\\\n', REPO_ROOT)).toEqual([]);\\n  });\\n\\n  it('refuses a path outside supabase/ and a path inside a directory the mirror excludes', () => {\\n    expect(pathClosureProblems('project_id = \\\"demo\\\"\\\\n[db.seed]\\\\nsql_paths = [\\\"../seed.sql\\\"]\\\\n', REPO_ROOT).join(' ')).toContain('outside supabase/');\\n    expect(pathClosureProblems('project_id = \\\"demo\\\"\\\\n[db.seed]\\\\nsql_paths = [\\\"/etc/seed.sql\\\"]\\\\n', REPO_ROOT).join(' ')).toContain('absolute path');\\n    expect(\\n      pathClosureProblems('project_id = \\\"demo\\\"\\\\n[db.seed]\\\\nsql_paths = [\\\"./.temp/seed.sql\\\"]\\\\n', REPO_ROOT).join(' '),\\n      'a path into the CLI runtime state the mirror leaves behind was accepted',\\n    ).toContain('supabase/.temp');\\n  });\\n});\\n\\ndescribe('the mirror carries the project source and nothing else', () => {\\n  it('leaves out the CLI runtime directories and the item tree config (rulings T3, F3, T11)', () => {\\n    const item = mkdtempSync(join(tmpdir(), 'at-item-tree-'));\\n    mkdirSync(join(item, 'supabase', 'migrations'), { recursive: true });\\n    mkdirSync(join(item, 'supabase', 'functions', 'hello'), { recursive: true });\\n    mkdirSync(join(item, 'supabase', '.temp', 'start-secrets'), { recursive: true });\\n    mkdirSync(join(item, 'supabase', '.branches'), { recursive: true });\\n    writeFileSync(join(item, 'supabase', 'config.toml'), 'project_id = \\\"the-personal-identity\\\"\\\\n', 'utf8');\\n    writeFileSync(join(item, 'supabase', 'migrations', '20260101000000_a.sql'), 'select 1;\\\\n', 'utf8');\\n    writeFileSync(join(item, 'supabase', 'functions', 'hello', 'index.ts'), 'export default 1;\\\\n', 'utf8');\\n    writeFileSync(join(item, 'supabase', '.temp', 'start-secrets', 'anon'), 'a secret\\\\n', 'utf8');\\n    writeFileSync(join(item, 'supabase', '.branches', '_current_branch'), 'main\\\\n', 'utf8');\\n\\n    try {\\n      mirrorItemTree(item, 1);\\n      const slot = join(slotDir(1), 'supabase');\\n      expect(existsSync(join(slot, 'migrations', '20260101000000_a.sql')), 'a migration did not reach the slot').toBe(true);\\n      expect(existsSync(join(slot, 'functions', 'hello', 'index.ts')), 'an edge function did not reach the slot').toBe(true);\\n      expect(existsSync(join(slot, 'config.toml')), 'the item tree config reached the slot, carrying the personal identity').toBe(false);\\n      expect(existsSync(join(slot, '.temp')), 'the CLI runtime state about another stack reached the slot').toBe(false);\\n      expect(existsSync(join(slot, '.branches')), 'the CLI branch state reached the slot').toBe(false);\\n    } finally {\\n      rmSync(item, { recursive: true, force: true });\\n      rmSync(join(slotDir(1), 'supabase'), { recursive: true, force: true });\\n    }\\n  });\\n\\n  it('refuses the whole mirror when a symlink sits under supabase/ (ruling T13)', () => {\\n    const item = mkdtempSync(join(tmpdir(), 'at-item-link-'));\\n    mkdirSync(join(item, 'supabase', 'migrations'), { recursive: true });\\n    mkdirSync(join(item, 'elsewhere'), { recursive: true });\\n    // A directory junction on Windows needs no privilege; on other systems this is a plain symlink.\\n    symlinkSync(join(item, 'elsewhere'), join(item, 'supabase', 'migrations', 'linked'), 'junction');\\n\\n    try {\\n      expect(() => mirrorItemTree(item, 1)).toThrow(/symlink/);\\n      expect(() => mirrorItemTree(item, 1)).toThrow(/Nothing was copied/);\\n    } finally {\\n      rmSync(item, { recursive: true, force: true });\\n      rmSync(join(slotDir(1), 'supabase'), { recursive: true, force: true });\\n    }\\n  });\\n});\\n\\ndescribe('the evidence names the slot it ran against', () => {\\n  it('carries the slot, the project id, the api port, the reset and the migration state', () => {\\n    const held = {\\n      slot: 2,\\n      dir: slotDir(2),\\n      config: { projectId: 'ai4good-slot-2', apiPort: 56321, dbPort: 56322 },\\n      item: 'AI4DEV-79',\\n      via: 'reservation',\\n      claim: { file: '', release: () => undefined },\\n      release: () => undefined,\\n    } as Occupancy;\\n    const result: PrepareResult = {\\n      status: {} as StackStatus,\\n      migrations: { expected: 2, applied: 2 },\\n      restarted: false,\\n    };\\n\\n    const line = evidence(held, result);\\n    expect(line).toContain('db slot 2');\\n    expect(line).toContain('ai4good-slot-2');\\n    expect(line).toContain('api 56321');\\n    expect(line).toContain('reset OK');\\n    expect(line).toContain('2 expected, 2 applied');\\n  });\\n});\",\"lineStart\":1,\"lineEnd\":467,\"totalLines\":467,\"truncated\":false}},\"title\":\"tests\\\\at\\\\harness\\\\db-pool.selftest.ts\",\"time\":{\"start\":1786349897696,\"end\":1786349897719}},\"id\":\"prt_feac046ef001X5oMXwATPr1MfT\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"messageID\":\"msg_feabff3b8001bLuMZ9f58S189R\"}}\r\n+{\"type\":\"text\",\"timestamp\":1786349897768,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feac04612001t5kNoTszpfSWIy\",\"messageID\":\"msg_feabff3b8001bLuMZ9f58S189R\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"type\":\"text\",\"text\":\"The runner seam and lock look right so far. Now the selftest and the PowerShell helpers.\",\"time\":{\"start\":1786349897234,\"end\":1786349897765}}}\r\n+{\"type\":\"step_finish\",\"timestamp\":1786349898180,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feac049b600166ciz1dIvCn8tm\",\"reason\":\"tool-calls\",\"snapshot\":\"bf0a88dd6bcb2268676b839763610545c2986225\",\"messageID\":\"msg_feabff3b8001bLuMZ9f58S189R\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"type\":\"step-finish\",\"tokens\":{\"total\":78033,\"input\":2720,\"output\":109,\"reasoning\":836,\"cache\":{\"write\":0,\"read\":74368}},\"cost\":0.0004268152}}\r\n+{\"type\":\"step_start\",\"timestamp\":1786349900233,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"id\":\"prt_feac051c7001IR4eqhBLTFwZMM\",\"messageID\":\"msg_feac04b80001PC4AFK3cW6EF3F\",\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"snapshot\":\"b4253cdce748ea8cef6229f1c0c049a17c65b797\",\"type\":\"step-start\"}}\r\n+{\"type\":\"tool_use\",\"timestamp\":1786349903141,\"sessionID\":\"ses_01541a198ffeMeZOHEAs76N82N\",\"part\":{\"type\":\"tool\",\"tool\":\"read\",\"callID\":\"call_00_MqTHW9kFMHxHkDzxLPlR9748\",\"state\":{\"status\":\"completed\",\"input\":{\"filePath\":\"C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\loop\\\\work\\\\db-slots.ps1\"},\"output\":\"<path>C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\loop\\\\work\\\\db-slots.ps1</path>\\n<type>file</type>\\n<content>\\n1: # db-slots.ps1 - the coordinator's half of the local database slot pool (ASCII-only; PowerShell 5.1).\\n2: #\\n3: # A slot is one standing local Supabase stack. There are two of them, so two items can verify at\\n4: # the same time without resetting each other's database. The pool has two states and three owners:\\n5: #\\n6: #   RESERVED  - the coordinator takes a slot when an item starts. That is ADMISSION CONTROL: a full\\n7: #               pool means the next database-needing item is REJECTED at start, never queued.\\n8: #   OCCUPIED  - the harness runner takes the slot for each verify window, and releases it in a\\n9: #               finally. That claim is written by tests/at/harness/db-pool.ts, not by this file.\\n10: #   released  - the coordinator deletes the reservation at the item sweep.\\n11: #\\n12: # THIS FILE DOES FILE OPERATIONS ONLY - reserve, release, list. It reads no config.toml and writes\\n13: # no config.toml. All TOML lives in tests/at/harness/db-pool.ts, because two rules for one identity\\n14: # is how a slot ends up on a personal port.\\n15: \\n16: $ErrorActionPreference = 'Stop'\\n17: \\n18: $script:DbSlotPoolSize = 2\\n19: \\n20: # THE SAME BASE-RESOLUTION CHAIN AS THE HARNESS, all three steps of it: LOCALAPPDATA, then\\n21: # XDG_CACHE_HOME, then the system temp path. The harness resolves it that way (poolRoot and\\n22: # lockDir in tests/at/harness/), and two resolution rules for one pool is how the two halves stop\\n23: # seeing each other's files - this side would write a reservation the runner never reads.\\n24: function Get-DbSlotBaseDir([string]$leaf) {\\n25:     if ($env:LOCALAPPDATA) { $base = $env:LOCALAPPDATA }\\n26:     elseif ($env:XDG_CACHE_HOME) { $base = $env:XDG_CACHE_HOME }\\n27:     else { $base = [System.IO.Path]::GetTempPath() }\\n28:     return (Join-Path $base ('ai4good-build\\\\' + $leaf))\\n29: }\\n30: \\n31: # The pool lives beside the claims it cooperates with and outside every worktree.\\n32: # AT_DB_POOL_ROOT overrides it, for tests only.\\n33: function Get-DbSlotPoolRoot {\\n34:     if ($env:AT_DB_POOL_ROOT) { $root = $env:AT_DB_POOL_ROOT }\\n35:     else { $root = Get-DbSlotBaseDir 'db-slots' }\\n36:     if (-not (Test-Path $root)) { New-Item -ItemType Directory -Force $root | Out-Null }\\n37:     return $root\\n38: }\\n39: \\n40: function Get-DbSlotReservationDir {\\n41:     $d = Join-Path (Get-DbSlotPoolRoot) 'reservations'\\n42:     if (-not (Test-Path $d)) { New-Item -ItemType Directory -Force $d | Out-Null }\\n43:     return $d\\n44: }\\n45: \\n46: function Get-DbSlotReservationPath([int]$slot) {\\n47:     return Join-Path (Get-DbSlotReservationDir) ('slot-' + $slot + '.json')\\n48: }\\n49: \\n50: # Where the harness runner writes its occupancy claims. Same chain, same override, same reason.\\n51: function Get-DbSlotClaimDir {\\n52:     if ($env:AT_LOCK_DIR) { $d = $env:AT_LOCK_DIR }\\n53:     else { $d = Get-DbSlotBaseDir 'at-locks' }\\n54:     if (-not (Test-Path $d)) { New-Item -ItemType Directory -Force $d | Out-Null }\\n55:     return $d\\n56: }\\n57: \\n58: function Test-DbSlotItemId([string]$item) {\\n59:     return ($item -match '^(AI4DEV|AI4PM)-[0-9]+$')\\n60: }\\n61: \\n62: function Read-DbSlotReservation([int]$slot) {\\n63:     $p = Get-DbSlotReservationPath $slot\\n64:     if (-not (Test-Path $p)) { return $null }\\n65:     try { return (Get-Content $p -Raw | ConvertFrom-Json) } catch { return $null }\\n66: }\\n67: \\n68: # THE SAME READ, BUT IT WAITS OUT THE WRITE WINDOW.\\n69: #\\n70: # NOT RULED BY GATE 2. Ruling T10 asks the create-failure path in Reserve-DbSlot to re-read the\\n71: # reservation; measurement showed that re-read cannot see the winner's file, so the ruled fix alone\\n72: # left the defect open. This function and the block that calls it are the executor's completion of\\n73: # T10 and need the orchestrator's ratification. Reverting this one commit restores exactly the\\n74: # ruled text.\\n75: #\\n76: # THE MEASUREMENT, on this machine, 2026-08-10. A reservation file is created EXCLUSIVELY and\\n77: # filled a moment later. Between those two acts the file EXISTS and cannot be read at all: the\\n78: # creating handle holds it with no sharing, so a second reader gets a sharing violation, not an\\n79: # empty file. The loser of the race is inside that window by definition - it lost by microseconds.\\n80: # With the plain read above, five races out of five ended with one item holding BOTH slots; with\\n81: # this read, eight races out of eight ended with one item holding exactly one slot and the loser\\n82: # correctly told it already held it.\\n83: #\\n84: # One second of retries is thousands of times the window. It is the same remedy ruling T1 applies\\n85: # to the same window shape in the harness's own claim files.\\n86: function Read-DbSlotReservationWait([int]$slot) {\\n87:     $p = Get-DbSlotReservationPath $slot\\n88:     for ($try = 0; $try -lt 40; $try++) {\\n89:         if (-not (Test-Path $p)) { return $null }\\n90:         $raw = $null\\n91:         try { $raw = Get-Content $p -Raw -ErrorAction Stop } catch { $raw = $null }\\n92:         if ($raw -and $raw.Trim()) {\\n93:             try { return ($raw | ConvertFrom-Json) } catch { }\\n94:         }\\n95:         Start-Sleep -Milliseconds 25\\n96:     }\\n97:     return $null\\n98: }\\n99: \\n100: # The occupancy claim the harness writes, if one exists and its holder is still alive.\\n101: #\\n102: # The claim file name carries the slot's api port, which this file deliberately does not know - it\\n103: # reads no config.toml - so the lookup is a glob on the project id. A claim whose pid is gone is\\n104: # STALE, not live: the run that wrote it died, and the harness itself would take it over.\\n105: function Get-DbSlotOccupancy([int]$slot) {\\n106:     $pattern = 'at-verify-ai4good-slot-' + $slot + '-*.lock'\\n107:     $files = @(Get-ChildItem -Path (Get-DbSlotClaimDir) -Filter $pattern -File -ErrorAction SilentlyContinue)\\n108:     foreach ($f in $files) {\\n109:         $holder = $null\\n110:         try { $holder = (Get-Content $f.FullName -Raw | ConvertFrom-Json) } catch { $holder = $null }\\n111:         if (-not $holder) { continue }\\n112:         # NOT-FOUND MEANS DEAD; EVERY OTHER FAILURE MEANS ALIVE. Get-Process reports one specific\\n113:         # error when no process holds that id, and it can fail for other reasons - a process owned\\n114:         # by another user, for one. The harness's own liveness test treats a permission error as\\n115:         # ALIVE, and it has to: an occupancy misread as dead lets Release-DbSlot hand the slot away\\n116:         # under a running verify window. Fail closed, exactly as the harness does.\\n117:         $alive = $false\\n118:         if ($holder.pid) {\\n119:             try {\\n120:                 Get-Process -Id ([int]$holder.pid) -ErrorAction Stop | Out-Null\\n121:                 $alive = $true\\n122:             } catch {\\n123:                 if ($_.FullyQualifiedErrorId -like 'NoProcessFoundForGivenId*') { $alive = $false } else { $alive = $true }\\n124:             }\\n125:         }\\n126:         if ($alive) {\\n127:             return @{ file = $f.FullName; holderPid = [int]$holder.pid; requirement = [string]$holder.requirement; startedAt = [string]$holder.startedAt }\\n128:         }\\n129:     }\\n130:     return $null\\n131: }\\n132: \\n133: # What the pool looks like right now. Read-only.\\n134: function Get-DbSlotPool {\\n135:     $out = @()\\n136:     for ($slot = 1; $slot -le $script:DbSlotPoolSize; $slot++) {\\n137:         $r = Read-DbSlotReservation $slot\\n138:         $o = Get-DbSlotOccupancy $slot\\n139:         $item = ''\\n140:         if ($r) { $item = [string]$r.item }\\n141:         $out += @{ slot = $slot; reservedFor = $item; reservation = $r; occupancy = $o }\\n142:     }\\n143:     return $out\\n144: }\\n145: \\n146: # Take a slot for one item. Exclusive create, so two coordinators cannot take the same slot.\\n147: #\\n148: # A FULL POOL IS A REJECTION, NOT A WAIT. The ruled design says the next database-needing item is\\n149: # rejected at start; a wait here would turn admission control into a queue nobody can see.\\n150: function Reserve-DbSlot([string]$Item, [string]$Branch = '') {\\n151:     if (-not (Test-DbSlotItemId $Item)) { throw ('not a valid item id: ' + $Item) }\\n152: \\n153:     for ($slot = 1; $slot -le $script:DbSlotPoolSize; $slot++) {\\n154:         $r = Read-DbSlotReservation $slot\\n155:         if ($r -and ([string]$r.item) -eq $Item) {\\n156:             return @{ ok = $true; slot = $slot; alreadyHeld = $true }\\n157:         }\\n158:     }\\n159: \\n160:     $held = @()\\n161:     for ($slot = 1; $slot -le $script:DbSlotPoolSize; $slot++) {\\n162:         $path = Get-DbSlotReservationPath $slot\\n163:         $fs = $null\\n164:         try {\\n165:             $fs = [System.IO.File]::Open($path, [System.IO.FileMode]::CreateNew, [System.IO.FileAccess]::Write)\\n166:             $o = @{ slot = $slot; item = $Item; branch = $Branch; at = (Get-Date).ToUniversalTime().ToString('o'); holder = ('pid=' + $PID) }\\n167:             $bytes = [System.Text.Encoding]::UTF8.GetBytes(($o | ConvertTo-Json -Depth 4))\\n168:             $fs.Write($bytes, 0, $bytes.Length)\\n169:             return @{ ok = $true; slot = $slot; alreadyHeld = $false }\\n170:         } catch {\\n171:             # RE-READ, THEN DECIDE. Two calls for the SAME item can both pass the already-held scan\\n172:             # above; one wins slot 1, and without this the loser would read \\\"taken\\\", advance, and\\n173:             # win slot 2 - one item holding the whole pool of two. If the reservation that beat us\\n174:             # names this same item, this item already has the slot, so say so and stop.\\n175:             #\\n176:             # The read WAITS OUT THE WRITE WINDOW (see Read-DbSlotReservationWait; NOT ruled by\\n177:             # gate 2, the executor's completion of T10, awaiting ratification). A reservation still\\n178:             # unreadable after the wait REJECTS this item rather than giving it a second slot: a\\n179:             # false rejection is loud and costs one look, a silent double-take costs the pool.\\n180:             $r = Read-DbSlotReservationWait $slot\\n181:             if ($r) {\\n182:                 if (([string]$r.item) -eq $Item) { return @{ ok = $true; slot = $slot; alreadyHeld = $true } }\\n183:                 $held += ('slot ' + $slot + ' -> ' + [string]$r.item)\\n184:             } elseif (Test-Path (Get-DbSlotReservationPath $slot)) {\\n185:                 return @{ ok = $false; rejected = $true; reason = ('slot ' + $slot + ' holds a reservation this call cannot read, so it cannot tell whether that reservation belongs to ' + $Item + '. This item is REJECTED at start rather than given a second slot. Look at ' + (Get-DbSlotReservationPath $slot) + ' and run this again.') }\\n186:             } else {\\n187:                 $held += ('slot ' + $slot + ' -> taken')\\n188:             }\\n189:         } finally {\\n190:             if ($fs) { $fs.Dispose() }\\n191:         }\\n192:     }\\n193: \\n194:     return @{ ok = $false; rejected = $true; reason = ('the database slot pool is full (' + ($held -join '; ') + '). This item is REJECTED at start, not queued. Finish one of those items, or start an item that needs no database.') }\\n195: }\\n196: \\n197: # Give a slot back at the item sweep.\\n198: #\\n199: # TWO REFUSALS, both of them the point. A reservation is deleted only when it NAMES the item being\\n200: # swept, so a sweep can never hand another item's slot away. And a reservation is never deleted\\n201: # while a live occupancy claim sits on that slot, because the run holding it is about to reset\\n202: # that database and the next item would be given a stack under a running reset.\\n203: function Release-DbSlot([string]$Item, [int]$Slot = 0) {\\n204:     if (-not (Test-DbSlotItemId $Item)) { throw ('not a valid item id: ' + $Item) }\\n205: \\n206:     $target = 0\\n207:     if ($Slot -gt 0) {\\n208:         $r = Read-DbSlotReservation $Slot\\n209:         if (-not $r) { return @{ ok = $true; released = $false; reason = ('slot ' + $Slot + ' holds no reservation') } }\\n210:         if (([string]$r.item) -ne $Item) {\\n211:             return @{ ok = $false; released = $false; reason = ('REFUSING: slot ' + $Slot + ' is reserved for ' + [string]$r.item + ', not for ' + $Item) }\\n212:         }\\n213:         $target = $Slot\\n214:     } else {\\n215:         for ($slot = 1; $slot -le $script:DbSlotPoolSize; $slot++) {\\n216:             $r = Read-DbSlotReservation $slot\\n217:             if ($r -and ([string]$r.item) -eq $Item) { $target = $slot; break }\\n218:         }\\n219:         if ($target -eq 0) { return @{ ok = $true; released = $false; reason = ('no slot is reserved for ' + $Item) } }\\n220:     }\\n221: \\n222:     # RESIDUAL, ruled and accepted (gate-2 T9): the window between this check and the delete below\\n223:     # is real, and it changes nothing destructive. The serializer for destructive acts is the\\n224:     # OCCUPANCY CLAIM, which is dead-pid-only - a live holder is never displaced. A runner that\\n225:     # slips into this window still holds its own claim, so the worst outcome is the NEXT item's\\n226:     # occupy refusing loudly until the window closes: a loud refusal, never a reset under a live\\n227:     # run. An atomic two-file handoff here would buy no safety the claim does not already give.\\n228:     $o = Get-DbSlotOccupancy $target\\n229:     if ($o) {\\n230:         return @{ ok = $false; released = $false; slot = $target; reason = ('REFUSING: slot ' + $target + ' is OCCUPIED right now by pid ' + $o.holderPid + ' running ' + $o.requirement + ' since ' + $o.startedAt + '. A verify window is open on that database. Wait for it to finish.') }\\n231:     }\\n232: \\n233:     Remove-Item (Get-DbSlotReservationPath $target) -Force\\n234:     return @{ ok = $true; released = $true; slot = $target }\\n235: }\\n\\n(End of file - total 235 lines)\\n</content>\",\"metadata\":{\"preview\":\"# db-slots.ps1 - the coordinator's half of the local database slot pool (ASCII-only; PowerShell 5.1).\\n#\\n# A slot is one standing local Supabase stack. There are two of them, so two items can verify at\\n# the same time without resetting each other's database. The pool has two states and three owners:\\n#\\n#   RESERVED  - the coordinator takes a slot when an item starts. That is ADMISSION CONTROL: a full\\n#               pool means the next database-needing item is REJECTED at start, never queued.\\n#   OCCUPIED  - the harness runner takes the slot for each verify window, and releases it in a\\n#               finally. That claim is written by tests/at/harness/db-pool.ts, not by this file.\\n#   released  - the coordinator deletes the reservation at the item sweep.\\n#\\n# THIS FILE DOES FILE OPERATIONS ONLY - reserve, release, list. It reads no config.toml and writes\\n# no config.toml. All TOML lives in tests/at/harness/db-pool.ts, because two rules for one identity\\n# is how a slot ends up on a personal port.\\n\\n$ErrorActionPreference = 'Stop'\\n\\n$script:DbSlotPoolSize = 2\\n\\n# THE SAME BASE-RESOLUTION CHAIN AS THE HARNESS, all three steps of it: LOCALAPPDATA, then\",\"truncated\":false,\"loaded\":[],\"display\":{\"type\":\"file\",\"path\":\"C:\\\\Users\\\\nirdr\\\\Downloads\\\\ai4good\\\\.claude\\\\worktrees\\\\agent-a064eb77d7bb37dd7\\\\loop\\\\work\\\\db-slots.ps1\",\"text\":\"# db-slots.ps1 - the coordinator's half of the local database slot pool (ASCII-only; PowerShell 5.1).\\n#\\n# A slot is one standing local Supabase stack. There are two of them, so two items can verify at\\n# the same time without resetting each other's database. The pool has two states and three owners:\\n#\\n#   RESERVED  - the coordinator takes a slot when an item starts. That is ADMISSION CONTROL: a full\\n#               pool means the next database-needing item is REJECTED at start, never queued.\\n#   OCCUPIED  - the harness runner takes the slot for each verify window, and releases it in a\\n#               finally. That claim is written by tests/at/harness/db-pool.ts, not by this file.\\n#   released  - the coordinator deletes the reservation at the item sweep.\\n#\\n# THIS FILE DOES FILE OPERATIONS ONLY - reserve, release, list. It reads no config.toml and writes\\n# no config.toml. All TOML lives in tests/at/harness/db-pool.ts, because two rules for one identity\\n# is how a slot ends up on a personal port.\\n\\n$ErrorActionPreference = 'Stop'\\n\\n$script:DbSlotPoolSize = 2\\n\\n# THE SAME BASE-RESOLUTION CHAIN AS THE HARNESS, all three steps of it: LOCALAPPDATA, then\\n# XDG_CACHE_HOME, then the system temp path. The harness resolves it that way (poolRoot and\\n# lockDir in tests/at/harness/), and two resolution rules for one pool is how the two halves stop\\n# seeing each other's files - this side would write a reservation the runner never reads.\\nfunction Get-DbSlotBaseDir([string]$leaf) {\\n    if ($env:LOCALAPPDATA) { $base = $env:LOCALAPPDATA }\\n    elseif ($env:XDG_CACHE_HOME) { $base = $env:XDG_CACHE_HOME }\\n    else { $base = [System.IO.Path]::GetTempPath() }\\n    return (Join-Path $base ('ai4good-build\\\\' + $leaf))\\n}\\n\\n# The pool lives beside the claims it cooperates with and outside every worktree.\\n# AT_DB_POOL_ROOT overrides it, for tests only.\\nfunction Get-DbSlotPoolRoot {\\n    if ($env:AT_DB_POOL_ROOT) { $root = $env:AT_DB_POOL_ROOT }\\n    else { $root = Get-DbSlotBaseDir 'db-slots' }\\n    if (-not (Test-Path $root)) { New-Item -ItemType Directory -Force $root | Out-Null }\\n    return $root\\n}\\n\\nfunction Get-DbSlotReservationDir {\\n    $d = Join-Path (Get-DbSlotPoolRoot) 'reservations'\\n    if (-not (Test-Path $d)) { New-Item -ItemType Directory -Force $d | Out-Null }\\n    return $d\\n}\\n\\nfunction Get-DbSlotReservationPath([int]$slot) {\\n    return Join-Path (Get-DbSlotReservationDir) ('slot-' + $slot + '.json')\\n}\\n\\n# Where the harness runner writes its occupancy claims. Same chain, same override, same reason.\\nfunction Get-DbSlotClaimDir {\\n    if ($env:AT_LOCK_DIR) { $d = $env:AT_LOCK_DIR }\\n    else { $d = Get-DbSlotBaseDir 'at-locks' }\\n    if (-not (Test-Path $d)) { New-Item -ItemType Directory -Force $d | Out-Null }\\n    return $d\\n}\\n\\nfunction Test-DbSlotItemId([string]$item) {\\n    return ($item -match '^(AI4DEV|AI4PM)-[0-9]+$')\\n}\\n\\nfunction Read-DbSlotReservation([int]$slot) {\\n    $p = Get-DbSlotReservationPath $slot\\n    if (-not (Test-Path $p)) { return $null }\\n    try { return (Get-Content $p -Raw | ConvertFrom-Json) } catch { return $null }\\n}\\n\\n# THE SAME READ, BUT IT WAITS OUT THE WRITE WINDOW.\\n#\\n# NOT RULED BY GATE 2. Ruling T10 asks the create-failure path in Reserve-DbSlot to re-read the\\n# reservation; measurement showed that re-read cannot see the winner's file, so the ruled fix alone\\n# left the defect open. This function and the block that calls it are the executor's completion of\\n# T10 and need the orchestrator's ratification. Reverting this one commit restores exactly the\\n# ruled text.\\n#\\n# THE MEASUREMENT, on this machine, 2026-08-10. A reservation file is created EXCLUSIVELY and\\n# filled a moment later. Between those two acts the file EXISTS and cannot be read at all: the\\n# creating handle holds it with no sharing, so a second reader gets a sharing violation, not an\\n# empty file. The loser of the race is inside that window by definition - it lost by microseconds.\\n# With the plain read above, five races out of five ended with one item holding BOTH slots; with\\n# this