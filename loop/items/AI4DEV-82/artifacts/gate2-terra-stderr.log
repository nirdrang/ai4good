/ stack that answers is the slot's own, resets it, and proves the migration set replayed.\\n1262:         prepared = await prepare(occupancy);\\n1263:       } catch (err) {\\n1264:         return infra(\\n1265:           `slot ${occupancy.slot} could not be prepared: ${(err as Error).message}\\\\n` +\\n1266:             `The integration tier rebuilds its slot's database from supabase/migrations on every run, ` +\\n1267:             `so that a suite never grades leftover rows or a schema missing a migration; if that ` +\\n1268:             `rebuild fails, the state under test is unknown and the run stops here.\\\\n${stackHelp}`,\\n1269:         );\\n1270:       }\\n1271: \\n1272:       // The ruled evidence line: which slot, that the reset happened, and the migration state.\\n1273:       console.log(evidence(occupancy, prepared));\\n1274:       Object.assign(stackEnv, slotStackEnv(occupancy, prepared.status));\\n1275:     }\\n1276: \\n1277:     // The suites and their vitest root come from the DATA root; vitest itself comes from the\\n1278:     // install root, so a run pointed at a disposable tree still runs the pinned test framework.\\n1279:     const atRoot = join(REPO_ROOT, 'tests', 'at');\\n1280:     const outputFile = join(reportDir, 'vitest-report.json');\\n1281:     const rootOverride: Record<string, string> = {};\\n1282:     if (process.env.AT_REPO_ROOT?.trim()) rootOverride.AT_REPO_ROOT = process.env.AT_REPO_ROOT.trim();\\n1283: \\n1284:     const run = spawnSync(\\n1285:       bunExecutable(),\\n1286:       [\\n1287:         '--no-env-file',\\n1288:         join(INSTALL_ROOT, 'node_modules', 'vitest', 'vitest.mjs'),\\n1289:         'run',\\n1290:         '--root',\\n1291:         atRoot,\\n1292:         '--config',\\n1293:         join(atRoot, 'vitest.config.ts'),\\n1294:         '--reporter=json',\\n1295:         `--outputFile=${outputFile}`,\\n1296:         `suites/req-${requirement}/`,\\n1297:       ],\\n1298:       {\\n1299:         cwd: INSTALL_ROOT,\