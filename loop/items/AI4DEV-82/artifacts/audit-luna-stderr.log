 181:     # Moving the line proves the threshold is a parameter and not baked into the logic.
 182:     Set-Reading @{ five_hour = (W 50 60) }
 183:     & powershell -NoProfile -ExecutionPolicy Bypass -File $wait -SnapshotPath $snap -PollSeconds 1 -PauseAt 40 -MaxHours 0 | Out-Null
 184:     Check 'a lowered line parks work that was fine before' $LASTEXITCODE 1
