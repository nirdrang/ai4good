 243:     Set-Reading @{ five_hour = (W 2 300) }
 244:     Check 'a genuinely new window -> release the work' (Verdict) 'OK'
 245:     # The reset can roll forward: the window turned over but the level did not fall enough, or a
 246:     # different window is now the blocker. Re-park, do not proceed because the clock said so.
 247:     Set-Reading @{ five_hour = (W 94 300) }
 248:     Check 'still over the line after the reset -> park again' (Verdict) 'PAUSE'
 249:     & powershell -NoProfile -ExecutionPolicy Bypass -File $wait -SnapshotPath $snap -PollSeconds 1 -MaxHours 0 | Out-Null
 250:     Check 'and the park is re-enterable' $LASTEXITCODE 1
 251:     # The degradation path: nothing refreshed the reading, so it is old AND its reset has gone by.
 252:     # The old number now proves nothing, so this is UNKNOWN - reported, not halted, by the rule.
 253:     Set-Reading @{ five_hour = (W 96 -20) } 45
 254:     Check 'nothing refreshed it after the park -> UNKNOWN, not a false PAUSE' (Verdict) 'UNKNOWN'
 255:     # And the weekly window is unmoved by a five-hour reset - a release must not be granted by the
 256:     # wrong window turning over.
