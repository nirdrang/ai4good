  29: function Set-Reading([hashtable]$windows, [double]$ageMinutes = 0) {
  30:     $o = [ordered]@{
  31:         capturedAt = (Get-Date).ToUniversalTime().AddMinutes(-$ageMinutes).ToString('o')
  32:         sessionId  = 'sim'; version = 'sim'
  33:         rateLimits = $windows
