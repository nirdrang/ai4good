 187:     '7. A live park, with the world changing underneath it'
 188:     # This exercises the loop rather than a single decision.
 189:     Set-Reading @{ five_hour = (W 93 45) }
 190:     $job = Start-Job -ScriptBlock {
 191:         param($w, $s)
 192:         $o = & powershell -NoProfile -ExecutionPolicy Bypass -File $w -SnapshotPath $s -PollSeconds 2
 193:         [pscustomobject]@{ code = $LASTEXITCODE; out = ($o -join "`n") }
 194:     } -ArgumentList $wait, $snap
 195:     Start-Sleep -Seconds 3
 196:     Check 'parked, and still waiting after 3s' ($job.State -eq 'Running') 'True'
 197:     Set-Reading @{ five_hour = (W 8 300) }          # another session refreshed it; window reopened
 198:     $done = Wait-Job $job -Timeout 25
 199:     $r = Receive-Job $job; Remove-Job $job -Force
 200:     Check 'released once the reading cleared' ([bool]$done) 'True'
 201:     Check 'exit 0 on early release' $r.code 0
 202:     Check 'said it cleared early' ([bool]($r.out -match 'cleared early')) 'True'
 203: 
 204:     # A park must survive its own instrument breaking. The snapshot disappearing mid-wait leaves
 205:     # the target it captured at the start, so it still releases on the clock rather than hanging.
 206:     Set-Reading @{ five_hour = (W 94 0.6) }
 207:     $job2 = Start-Job -ScriptBlock {
 208:         param($w, $s)
 209:         $o = & powershell -NoProfile -ExecutionPolicy Bypass -File $w -SnapshotPath $s -PollSeconds 2
 210:         [pscustomobject]@{ code = $LASTEXITCODE; out = ($o -join "`n") }
 211:     } -ArgumentList $wait, $snap
 212:     Start-Sleep -Seconds 2
 213:     Remove-Item $snap -Force                        # the sensor dies mid-park
 214:     $done2 = Wait-Job $job2 -Timeout 180
 215:     $r2 = Receive-Job $job2; Remove-Job $job2 -Force
 216:     Check 'survives its snapshot vanishing mid-park' ([bool]$done2) 'True'
 217:     Check 'and still releases on the clock' $r2.code 0
 218: 
 219:     ''
 220:     '8. Coming out the other side of a park'
 221:     # Everything above started with the reset already behind us. This is the real shape: park
 222:     # while the reset is still ahead, sit through it, and come out.
 223:     Set-Reading @{ five_hour = (W 96 0.15) }        # resets in ~9 seconds
 224:     $t0 = Get-Date
 225:     $out = & powershell -NoProfile -ExecutionPolicy Bypass -File $wait -SnapshotPath $snap -PollSeconds 2 -SlackMinutes 0
 226:     $elapsed = ((Get-Date) - $t0).TotalSeconds
 227:     Check 'crossed the reset boundary and released' $LASTEXITCODE 0
 228:     Check 'and actually waited for it, rather than short-circuiting' ([bool]($elapsed -ge 6)) 'True'
