   1: # window-sim.ps1 - exercise the usage-window guard end to end, spending nothing.
   2: #
   3: # The whole mechanism reads exactly ONE file, so driving that file drives everything: no API
   4: # calls, no tokens, no waiting for a real window to fill. Every reading here is synthetic and
   5: # written to a scratch path, so the live snapshot the status line maintains is never touched.
   6: #
   7: # WHAT THIS CAN AND CANNOT PROVE. It proves the parts we wrote behave: the gauge's verdicts, the
   8: # park's exits, the early release. It does NOT prove the sensor is reading Anthropic correctly -
   9: # the synthetic readings are shaped the way we BELIEVE the real one is shaped, so a change in the
  10: # provider's payload would sail straight through this green. That gap is covered by the live
  11: # reading, not here.
  12: #
  13: # It found a real bug on its first run: the gauge picked the binding window with Sort-Object over
  14: # dictionary entries, which silently does nothing, so "worst" was whichever enumerated first. The
  15: # live reading agreed with the right answer by luck for weeks. Cases that can DISAGREE are the
  16: # whole point of this file - a test that only reproduces the situation you already have proves
  17: # nothing.
  18: #
  19: # Run: powershell -NoProfile -File loop/work/window-sim.ps1
  20: 
  21: $ErrorActionPreference = 'SilentlyContinue'
  22: $here  = $PSScriptRoot
  23: $gauge = Join-Path $here 'window-gauge.ps1'
  24: $wait  = Join-Path $here 'window-wait.ps1'
  25: $snap  = Join-Path $env:TEMP ('window-sim-' + [guid]::NewGuid().ToString('N').Substring(0,8) + '.json')
  26: 
  27: $pass = 0; $fail = 0; $failed = @()
  28: 
  29: function Set-Reading([hashtable]$windows, [double]$ageMinutes = 0) {
  30:     $o = [ordered]@{
  31:         capturedAt = (Get-Date).ToUniversalTime().AddMinutes(-$ageMinutes).ToString('o')
  32:         sessionId  = 'sim'; version = 'sim'
  33:         rateLimits = $windows
  34:     }
  35:     [IO.File]::WriteAllText($snap, ($o | ConvertTo-Json -Depth 6))
  36: }
  37: function Set-Raw([string]$text) { [IO.File]::WriteAllText($snap, $text) }
  38: 
  39: # A window: percent used, and how many minutes until it resets.
  40: function W($pct, [double]$resetInMinutes) {
  41:     @{ used_percentage = $pct; resets_at = [DateTimeOffset]::UtcNow.AddMinutes($resetInMinutes).ToUnixTimeSeconds() }
  42: }
  43: 
  44: function Check([string]$label, $got, $want) {
  45:     if ("$got" -eq "$want") { $script:pass++; "  PASS  {0}" -f $label }
  46:     else { $script:fail++; $script:failed += $label; "  FAIL  {0}  (got '{1}', wanted '{2}')" -f $label, $got, $want }
  47: }
  48: 
  49: function Gauge() {
  50:     & powershell -NoProfile -ExecutionPolicy Bypass -File $gauge -Json -SnapshotPath $snap | ConvertFrom-Json
  51: }
  52: function Verdict() { (Gauge).verdict }
