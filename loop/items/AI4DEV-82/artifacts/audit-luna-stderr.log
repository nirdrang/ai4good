  54: $pass = 0; $fail = 0; $failed = @()
  55: function Check([string]$claim, [bool]$ok, [string]$note = '') {
  56:     if ($ok) { $script:pass++; Write-Output ('  PASS  ' + $claim) }
  57:     else { $script:fail++; $script:failed += $claim; Write-Output ('  FAIL  ' + $claim + $(if ($note) { '  (' + $note + ')' } else { '' })) }
