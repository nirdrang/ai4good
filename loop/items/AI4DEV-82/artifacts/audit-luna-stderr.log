  29: # Write the line as UTF-8 BYTES straight to the standard output handle. PowerShell 5.1 would
  30: # otherwise re-encode Write-Output through the console code page, which shreds the bar's block
  31: # glyphs into replacement characters when Claude Code spawns this without a real console.
  32: function Write-Line([string]$text) {
  33:     try {
  34:         $out = [Console]::OpenStandardOutput()
  35:         $bytes = [System.Text.Encoding]::UTF8.GetBytes($text + "`n")
