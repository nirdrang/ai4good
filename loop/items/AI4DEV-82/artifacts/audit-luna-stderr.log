  46: $here = Split-Path -Parent $MyInvocation.MyCommand.Path
  47: $repo = (Resolve-Path (Join-Path $here '..\..\..\..')).Path
  48: if (-not $OutDir) { $OutDir = Join-Path $here 'settings-proof' }
  49: New-Item -ItemType Directory -Force -Path $OutDir | Out-Null
