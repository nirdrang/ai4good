 259:     Check 'and the weekly one is still named as the blocker' (Gauge).worstWindow 'seven_day'
 260: 
 261:     ''
 262:     '9. The library itself, and the copies pinned to it'
 263:     # Everything above drives the gauge CLI, which always reads JSON off disk. Three things never
 264:     # travel that path and can only be pinned here: the in-memory snapshot shape the status line
 265:     # holds, the exact prefix the stamp rewrites, and the alarm batch file's copy of the path
 266:     # formula.
 267:     . (Join-Path $here 'window-lib.ps1')
 268: 
 269:     # THE READING ARRIVES IN TWO SHAPES. The status line holds a Hashtable in memory; every other
 270:     # reader parses JSON and holds a PSCustomObject. Both must reach the same verdict AND name the
 271:     # same window. They did not: PSObject.Properties.Name over a Hashtable enumerates the .NET
 272:     # members - Keys, Values, Count - so the worst window came out named "Values", in the very line
 273:     # the founder reads. Two windows on purpose, because with one the wrong answer looks right.
 274:     $hashSnap = [ordered]@{
 275:         capturedAt = (Get-Date).ToUniversalTime().ToString('o')
 276:         rateLimits = @{ five_hour = (W 12 200); seven_day = (W 95 5000) }
 277:     }
 278:     $jsonSnap = $hashSnap | ConvertTo-Json -Depth 6 | ConvertFrom-Json
 279:     $vh = Get-WindowVerdict -Snapshot $hashSnap
 280:     $vj = Get-WindowVerdict -Snapshot $jsonSnap
 281:     Check 'an in-memory reading verdicts the same as a parsed one' $vh.verdict $vj.verdict
 282:     Check 'and both name the window that actually blocked' ($vh.worstWindow + '/' + $vj.worstWindow) 'seven_day/seven_day'
 283: 
 284:     # AN AGE THAT CANNOT BE COMPUTED IS UNKNOWN, NEVER FRESH. An unparseable capturedAt used to
 285:     # skip the staleness rules altogether, so a corrupt-but-low reading scored OK for as long as it
 286:     # sat there. Over the line it still proves a floor - a window only climbs - and under it, it
 287:     # proves nothing.
 288:     $noTime = [ordered]@{ capturedAt = 'not-a-date'; rateLimits = @{ five_hour = (W 95 60) } } | ConvertTo-Json -Depth 6 | ConvertFrom-Json
 289:     Check 'no usable timestamp, over the line -> PAUSE on the floor it still proves' (Get-WindowVerdict -Snapshot $noTime).verdict 'PAUSE'
 290:     $noTimeLow = [ordered]@{ capturedAt = ''; rateLimits = @{ five_hour = (W 40 60) } } | ConvertTo-Json -Depth 6 | ConvertFrom-Json
 291:     $vlow = Get-WindowVerdict -Snapshot $noTimeLow
 292:     Check 'no usable timestamp, under the line -> UNKNOWN, never scored as current' $vlow.verdict 'UNKNOWN'
 293:     Check 'and the reason names the timestamp it could not use' ([bool]($vlow.reason -match 'capturedAt')) 'True'
 294: 
 295:     # THE PREFIX THE STAMP STRIPS. stamp-hook.ps1 rewrites '^ALARM WINDOW ' off this line before
 296:     # printing its own 'WINDOW ALARM' prefix, and nothing else pins the two together. A one
 297:     # character drift either double-prints the founder's alarm or leaves it half-printed.
 298:     $pauseLine = Format-WindowVerdictLine (Get-WindowVerdict -Snapshot $noTime)
 299:     Check "the PAUSE line begins with exactly 'ALARM WINDOW '" ([bool]($pauseLine -cmatch '^ALARM WINDOW \S')) 'True'
 300: 
 301:     # THE ALARM'S SECOND COPY OF THE PATH FORMULA. window-alarm.cmd is a batch file and cannot call
 302:     # the library, so its fallback directory is spelled out - the one place in production where the
 303:     # formula exists twice. The copy stays; this is the check that goes red when the two drift.
 304:     $cmdText = [IO.File]::ReadAllText((Join-Path $here 'window-alarm.cmd'))
 305:     $m = [regex]::Match($cmdText, 'else \(set "AI4GOOD_WD=([^"]+)"\)')
 306:     Check 'the alarm still carries a fallback path literal to compare' ([bool]$m.Success) 'True'
 307:     $savedWinDir = $env:AI4GOOD_WINDOW_DIR
 308:     Remove-Item Env:\AI4GOOD_WINDOW_DIR -ErrorAction SilentlyContinue
 309:     $libDir = Get-WindowDir
 310:     if ($savedWinDir) { $env:AI4GOOD_WINDOW_DIR = $savedWinDir }
 311:     Check "the alarm's own path literal still equals the library's formula" `
 312:         ([Environment]::ExpandEnvironmentVariables($m.Groups[1].Value).TrimEnd('\')) ($libDir.TrimEnd('\'))
 313: 
 314:     ''
 315:     "RESULT: {0} passed, {1} failed" -f $pass, $fail
 316:     if ($fail -gt 0) { ''; 'failed:'; $failed | ForEach-Object { '  - ' + $_ }; exit 1 }
 317: } finally {
 318:     Remove-Item $snap -Force -ErrorAction SilentlyContinue
 319:     Get-Job | Where-Object { $_.Command -match 'window-wait' } | Remove-Job -Force -ErrorAction SilentlyContinue
 320: }

