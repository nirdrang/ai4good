 154:     # The binding constraint is whichever window is furthest along, not the five-hour one by habit.
 155:     $worst = $result.windows | Sort-Object percent -Descending | Select-Object -First 1
 156:     $result.worstWindow  = $worst.name
 157:     $result.worstPercent = $worst.percent
 158:     $result.resetsAtUtc  = $worst.resetsAtUtc
 159:     $result.resetsInMin  = $worst.resetsInMin
 160: 
 161:     # AN AGE THAT COULD NOT BE COMPUTED IS AN UNKNOWN AGE, NEVER A FRESH ONE. A capturedAt that is
 162:     # absent, empty or unparseable leaves $ageMin null, and the staleness branch below is guarded on
 163:     # a non-null age - so a corrupt-but-low reading used to skip the staleness rules entirely and be
 164:     # scored as current, for as long as it sat there. That inverts this file's own doctrine: a
 165:     # broken instrument is not a spent window, and it is not a fresh one either.
 166:     #
 167:     # The floor reasoning of the stale branch applies unchanged. A window only climbs, so a reading
 168:     # already at or over the line still evidences the level whenever it was taken; below the line it
 169:     # evidences nothing at all, because it may have climbed since.
 170:     if ($null -eq $ageMin) {
 171:         if ($worst.percent -ge $PauseAt) {
 172:             $result.verdict = 'PAUSE'
 173:             $result.reason  = ("{0} at {1}% (pause line {2}%) - the reading carries no usable timestamp, but a window only climbs" -f `
 174:                 $worst.name, $worst.percent, $PauseAt)
 175:             return $result
 176:         }
 177:         $result.verdict = 'UNKNOWN'
 178:         $result.reason  = 'the reading carries no usable capturedAt timestamp, so its age cannot be established - treat as unknown, never as current'
 179:         return $result
 180:     }
 181: 
 182:     if ($ageMin -gt $StaleMinutes) {
 183:         # A stale reading proves a FLOOR, not a level: inside one window the figure only ever climbs.
 184:         # So if the reading was already over the line AND its own window has not reset since, the
 185:         # level still stands and parking is the evidenced answer, not a cautious guess. Only once the
 186:         # reset has passed does the old number stop meaning anything - that is the case where we
 187:         # genuinely cannot say, and where a low stale reading always sat, since it may have climbed.
 188:         if ($worst.percent -ge $PauseAt -and $null -ne $worst.resetsInMin -and $worst.resetsInMin -gt 0) {
 189:             $result.verdict = 'PAUSE'
 190:             $result.reason  = ("{0} at {1}% (pause line {2}%) - reading is {3} min old, but that window has not reset, and a window only climbs" -f `
 191:                 $worst.name, $worst.percent, $PauseAt, $ageMin)
 192:             return $result
 193:         }
 194:         $result.verdict = 'UNKNOWN'
 195:         $result.reason  = ("last reading is {0} min old (limit {1}) - treat as unknown, never as low" -f $ageMin, $StaleMinutes)
 196:         return $result
 197:     }
 198: 
 199:     if ($worst.percent -ge $PauseAt) {
 200:         $result.verdict = 'PAUSE'
 201:         $result.reason  = ("{0} at {1}% (pause line {2}%) - resets {3}" -f $worst.name, $worst.percent, $PauseAt, $worst.resetsLocal)
 202:     } else {
 203:         $result.verdict = 'OK'
 204:         $result.reason  = ("{0} at {1}%" -f $worst.name, $worst.percent)
 205:     }
 206: 
 207:     return $result
 208: }
 209: 
 210: # Format-WindowVerdictLine - the ONE line the sensor writes to window-verdict.txt.
 211: #
 212: # EXACTLY ONE LINE, three forms, and the FIRST TOKEN is the machine anchor - window-alarm.cmd
 213: # matches it with `findstr /b`, which is all a per-tool checkpoint can afford:
 214: #
 215: #   OK
 216: #   ALARM WINDOW <window> at <pct>% (line <n>%), resets <HH:mm> - finish the current work item, commit, park.
 217: #   UNKNOWN <reason>
 218: #
 219: # The rest of the ALARM form is the whole sentence the model hears. The sensor composes it once
 220: # per refresh; the checkpoint regurgitates it. Nothing downstream has to know how to phrase a
 221: # window alarm, which is what keeps the wording in one place.
 222: function Format-WindowVerdictLine {
 223:     [CmdletBinding()]
 224:     param(
 225:         $Verdict,
 226:         [int]$PauseAt = $script:WindowPauseLine
 227:     )
 228: 
 229:     if ($null -eq $Verdict) { return 'UNKNOWN no verdict was computed' }
 230: 
 231:     $v = [string]$Verdict.verdict
 232:     if ($v -eq 'OK') { return 'OK' }
 233: 
 234:     if ($v -eq 'PAUSE') {
 235:         # The reset time belongs to the window that BLOCKED. Reporting another window's reset would
 236:         # point the reader at the wrong clock, which on this account is up to eighty hours out.
 237:         $reset = '?'
 238:         foreach ($w in @($Verdict.windows)) {
 239:             if (([string]$w.name) -eq ([string]$Verdict.worstWindow)) { $reset = [string]$w.resetsLocal; break }
 240:         }
 241:         return ('ALARM WINDOW {0} at {1}% (line {2}%), resets {3} - finish the current work item, commit, park.' -f `
 242:             $Verdict.worstWindow, $Verdict.worstPercent, $PauseAt, $reset)
 243:     }
 244: 
 245:     # Newlines are stripped rather than trusted: a one-line contract that can be broken by its own
 246:     # payload is not a contract, and the alarm anchors on the first token of the first line.
 247:     $reason = (([string]$Verdict.reason) -replace '[\r\n]', ' ').Trim()
 248:     if (-not $reason) { $reason = 'the reading cannot be trusted' }
 249:     return ('UNKNOWN ' + $reason)
 250: }
===== loop\work\window-gauge.ps1 =====
   1: # window-gauge.ps1 - read the Anthropic usage windows and say what may proceed.
   2: #
   3: # WHERE THE NUMBERS COME FROM. Claude Code delivers `rate_limits` to the STATUS LINE and nowhere
   4: # else - hooks receive a different payload entirely - so statusline.ps1 snapshots it on every
   5: # refresh and this script reads that snapshot.
   6: #
   7: # ONE LINE ONLY (founder 2026-08-06, the number moved to 85 on 2026-08-12): OK below the pause
   8: # line, PAUSE at it, UNKNOWN when the reading cannot be trusted. Two consequences worth holding
   9: # on to:
  10: #   1. The reading is only as fresh as the last status-line refresh, which happens on every turn
  11: #      of the interactive session. While the coordinator is dormant, nothing updates it - which
  12: #      is exactly why the conductor sends a keep-alive pulse: a pulse wakes the coordinator, the
  13: #      wake refreshes the status line, and the refresh refreshes this gauge. The heartbeat is
  14: #      what keeps the gauge honest, not a timer inside this script.
  15: #   2. A stale reading is NOT a low reading. Age is reported and, past the limit, the verdict is
  16: #      UNKNOWN - never OK. Treating "I cannot see" as "all clear" is how a guard fails silently.
  17: #
  18: # WHAT IT DOES NOT DO. It reads and reports. It never pauses anything, never messages an agent,
  19: # never waits. The coordinator owns every decision; this is its instrument, not a second
  20: # authority. A gauge that acts is a brake nobody can see.
  21: #
  22: # THE VERDICT LOGIC LIVES IN window-lib.ps1. This file is the COMMAND LINE over it: the flags, the
  23: # human lines and the exit codes. The status line must compute the same verdict in its own
  24: # process (it cannot afford a second powershell spawn per refresh) and so must the spawn gate and
  25: # the prompt stamp, so the logic is a library and every reader calls it. One implementation, or
  26: # the readers drift - which is a failure this repository has already had once.
  27: #
  28: # The account reports two windows today (five_hour, seven_day). The binary supports three more
  29: # (seven_day_overage_included, seven_day_sonnet, seven_day_opus) which appear on other plans, so
  30: # every window present is evaluated by name rather than assumed - a plan change must not silently
  31: # narrow the guard to the windows we happened to know about.
  32: 
  33: [CmdletBinding()]
  34: param(
  35:     # PAUSE line - founder's number (2026-08-12): stop work at 85 percent of a window. This
  36:     # supersedes the 90 of 2026-08-06; only the number moved, the one-line principle below is
  37:     # unchanged. The same number is window-lib.ps1's own default, for the readers that call the
  38:     # library directly.
  39:     [int]$PauseAt = 85,
  40: 
  41:     # There is deliberately NO second, lower line (founder 2026-08-06). A "start nothing new" band
  42:     # would have to be justified by the cost of a sitting, which nobody has measured, so it
  43:     # could only ever be a number that felt safe. One line, and a sitting that meets it mid-flight
  44:     # parks at its last committed work item - the per-work-item commits are the recovery.
  45: 
  46:     # Older than this and the gauge admits it cannot see, rather than reporting a stale number as
  47:     # if it were current.
  48:     [int]$StaleMinutes = 15,
  49: 
  50:     # Emit the machine shape instead of the human lines.
  51:     [switch]$Json,
  52: 
  53:     # Read a different snapshot. Exists so the mechanism can be exercised end to end against
  54:     # synthetic readings without spending a single token, and without disturbing the live file
  55:     # the status line is writing. Defaults to the real one, so no caller has to know.
  56:     [string]$SnapshotPath = '',
  57: 
  58:     # Exit 0 only when work may proceed (verdict OK). For use as a wait condition: the coordinator
  59:     # parks and polls this until it succeeds, rather than sleeping on a computed duration - the
  60:     # window is authoritative about its own reset, our arithmetic is not.
  61:     [switch]$ExitOnReady
  62: )
  63: 
  64: $ErrorActionPreference = 'SilentlyContinue'
  65: 
  66: . (Join-Path $PSScriptRoot 'window-lib.ps1')
  67: 
  68: function Emit($r) {
  69:     if ($Json) {
  70:         $r | ConvertTo-Json -Depth 6
  71:     } else {
  72:         $head = "WINDOW  {0}" -f $r.verdict
  73:         if ($r.reason) { $head += "  - " + $r.reason }
  74:         Write-Output $head
  75:         foreach ($w in $r.windows) {
  76:             Write-Output ("        {0,-28} {1,3}%   resets {2}  (in {3} min)" -f $w.name, $w.percent, $w.resetsLocal, $w.resetsInMin)
  77:         }
  78:         if ($null -ne $r.readingAgeMin) {
  79:             Write-Output ("        reading is {0} min old" -f $r.readingAgeMin)
  80:         }
  81:     }
  82:     if ($ExitOnReady) { if ($r.verdict -eq 'OK') { exit 0 } else { exit 1 } }
  83:     exit 0
  84: }
  85: 
  86: Emit (Get-WindowVerdict -SnapshotPath $SnapshotPath -PauseAt $PauseAt -StaleMinutes $StaleMinutes)
===== loop\work\window-gate.ps1 =====
   1: # window-gate.ps1 - PreToolUse on the Agent tool: no NEW work starts once the window is spent.
   2: #
   3: # WHY THE SPAWN BOUNDARY. The line is 85 percent (founder 2026-08-12), and running work is never
   4: # interrupted - a sitting killed mid-write leaves a record that lies about where the work got to.
   5: # So the one place to act is the moment somebody tries to start something NEW, and in this relay
   6: # every new thing is an Agent spawn: coordinator to conductor, conductor to sitting, conductor to
   7: # reviewer-runner, orchestrator to executor and to mechanical. One hook entry covers every one of
   8: # them. Measured for this item: PreToolUse fires for Agent calls made INSIDE a spawned agent, and
   9: # the deny reason reaches the denied actor transcript.
  10: #
  11: # THIS DECIDES NOTHING. The founder set the line; the coordinator owns every judgement about work.
  12: # This is the same class of machinery as the prompt stamp: it applies a standing decision
  13: # mechanically, at the moment it bites, and it is deliberately incapable of anything else. It
  14: # cannot stop running work, it cannot message anyone, and it cannot be turned off by the actor it
  15: # denies.
  16: #
  17: # THE DENY REASON CARRIES THE CHOREOGRAPHY. The reason string reaches the model that tried to
  18: # spawn, so it says what to do: write state, commit, push, report PARKED to your spawner, end.
  19: # Putting it here rather than in five role contracts means the instruction arrives at the moment
  20: # it is needed, and cannot drift between contracts.
  21: #
  22: # IT COMPUTES, IT DOES NOT READ THE VERDICT LINE. A spawn is rare, so the full gauge logic is
  23: # affordable here, and this is the one checkpoint that must never act on a stale composition. The
  24: # per-tool alarm is the dumb reader; this is not.
  25: #
  26: # FAILURE IS OPEN, BUT NEVER MUTE. A broken guard must not stop spawns - that would halt the whole
  27: # relay over a bug in a guard. But it says so, in both channels, so a guard that has quietly
  28: # stopped guarding cannot look exactly like a clear window.
  29: #
  30: # Contract: PreToolUse, matcher Agent. Exit 0 always; the decision is the JSON on stdout.
  31: 
  32: $ErrorActionPreference = 'SilentlyContinue'
  33: 
  34: # additionalContext is the MODEL-visible field on an allow; systemMessage is shown to the USER.
  35: # Both are emitted for a warning, because the two readers can act on different things: the model
  36: # can hold off on more work, the founder can fix the sensor.
  37: function Write-Decision([string]$decision, [string]$reason, [string]$context, [string]$userMessage) {
  38:     $hso = [ordered]@{
  39:         hookEventName          = 'PreToolUse'
  40:         permissionDecision     = $decision
  41:         permissionDecisionReason = $reason
  42:     }
  43:     if ($context) { $hso['additionalContext'] = $context }
  44:     $out = [ordered]@{ hookSpecificOutput = $hso }
  45:     if ($userMessage) { $out['systemMessage'] = $userMessage }
  46:     Write-Output ($out | ConvertTo-Json -Depth 6 -Compress)
  47: }
  48: 
  49: try {
  50:     # Drain stdin so the caller pipe is never left waiting. The payload is not needed: the matcher
  51:     # already selected the Agent tool, and the verdict comes from the snapshot, not from the call.
  52:     if ([Console]::IsInputRedirected) { [void][Console]::In.ReadToEnd() }
  53: 
  54:     . (Join-Path $PSScriptRoot 'window-lib.ps1')
  55:     $v = Get-WindowVerdict
  56: 
  57:     if ($v.verdict -eq 'PAUSE') {
  58:         $reset = '?'
  59:         foreach ($w in @($v.windows)) {
  60:             if (([string]$w.name) -eq ([string]$v.worstWindow)) { $reset = [string]$w.resetsLocal; break }
  61:         }
  62:         $reason = @"
  63: WINDOW GUARD: no new work may start. $($v.worstWindow) is at $($v.worstPercent)% of its usage window (the line is $($script:WindowPauseLine)%), and it resets at $reset local. Reading: $($v.reason)
  64: 
  65: This spawn is refused, and it is the only thing refused - work already running is never interrupted.
  66: 
  67: Do this now, in this order:
  68:   1. finish or abandon the step you are on, and write your state to disk;
  69:   2. commit and push, so the work survives;
  70:   3. report PARKED - window low to whoever spawned you, naming the item, the next phase and the pushed head;
  71:   4. end.
  72: 
  73: Your spawner does the same, one level at a time, until the conductor parks the item with a park note. The coordinator restarts the work when the window reopens - one item at a time. Nobody waits inside a running agent.
  74: "@
  75:         Write-Decision 'deny' $reason '' ('WINDOW GUARD: spawn denied - {0} at {1}% (line {2}%), resets {3}.' -f $v.worstWindow, $v.worstPercent, $script:WindowPauseLine, $reset)
  76:         exit 0
  77:     }
  78: 
  79:     # OK - silent. This runs at every spawn in the relay; a line of chatter here is a line in
  80:     # every actor transcript forever.
  81:     #
  82:     # SILENCE IS SPELLED OUT, NOT REACHED BY FALLING THROUGH. This branch used to be the fall-
  83:     # through: anything that was not PAUSE and not UNKNOWN exited 0 without a word. It FIXES NO
  84:     # PROVEN DEFECT - Get-WindowVerdict returns only OK, PAUSE or UNKNOWN, so no other value can
  85:     # arrive here today, and the gate 2 ruling records plainly that nothing was shown broken. It is
  86:     # written this way because silence is the one answer this file must never give by accident: a
  87:     # verdict word this file has never heard of must be loud, and it now takes the warning path
  88:     # below rather than looking exactly like a clear window.
  89:     if ($v.verdict -eq 'OK') { exit 0 }
  90: 
  91:     # UNKNOWN, and any verdict this file does not recognise. A broken instrument is not a spent
  92:     # window. UNKNOWN reports loudly and halts nothing - the same rule attribution follows. Never
  93:     # let it pass silently as OK.
  94:     $warn = ('WINDOW GUARD: the usage-window sensor is {0} and cannot be trusted - {1}. This spawn is ALLOWED: a broken instrument is not a reason to stop working. Nobody can see how much of the window is left, so keep the work small and say so in your report.' -f $v.verdict, $v.reason)
  95:     Write-Decision 'allow' 'window sensor unreadable - allowed with a warning' $warn $warn
  96:     exit 0
  97: }
  98: catch {
  99:     # Fail OPEN, and say so. A guard that breaks silently is indistinguishable from a clear window.
 100:     try {
 101:         $msg = ('WINDOW GUARD FAILED and is allowing this spawn unguarded: ' + ($_.Exception.Message -replace '[\r\n]', ' ') + '. The usage window is NOT being checked at spawn boundaries until this is fixed.')
 102:         Write-Decision 'allow' 'window guard error - failing open' $msg $msg
 103:     }
 104:     catch { }
 105:     exit 0
 106: }
===== loop\work\window-wait.ps1 =====
   1: # window-wait.ps1 - block until the usage window has reopened, then exit 0.
   2: #
   3: # HOW IT IS MEANT TO BE USED. Run it as a BACKGROUND command. Its exit re-invokes the session,
   4: # which is the whole trick: the coordinator parks, this waits without spending anything, and the
   5: # founder's session continues in the same conversation with its context intact. Nothing is
   6: # resumed, nothing is restarted, no scheduled task is involved.
   7: #
   8: # WHY IT WAITS ON THE CLOCK AND NOT ON THE GAUGE. The gauge is refreshed by the status line, and
   9: # the status line only renders when the session takes a turn. A parked session takes no turns -
  10: # so during exactly the period this script is waiting, the reading it would like to poll is
  11: # frozen. Polling it alone would wait forever on a number that cannot change.
  12: #
  13: # So the wait is anchored on `resets_at`, which the provider states and which is true whether or
  14: # not anyone is looking. The gauge is still read every poll, because if some OTHER session in the
  15: # account renders its status line the snapshot updates and we can leave early - but the clock is
  16: # what guarantees an exit.
  17: #
  18: # THIS SCRIPT CANNOT CLEAR THE WINDOW, ONLY OBSERVE THAT IT SHOULD HAVE. Its exit means "the
  19: # stated reset time has passed", not "you have budget". The work skill already warns why that
  20: # distinction bites: a reset time that is already past rolls forward a full day, and a session
  21: # limit is not the same thing as being out of credit. **The caller MUST re-read the gauge on its
  22: # first turn after this exits** - that turn renders the status line, so it is the first genuinely
  23: # fresh reading available - and park again if it still says PAUSE.
  24: #
  25: # Exit 0: the window should be open, go and confirm. Exit 1: gave up (see -MaxHours), which is a
  26: # report to the founder, never a licence to carry on regardless.
  27: 
  28: [CmdletBinding()]
  29: param(
  30:     # How often to look. A parked session is spending nothing, so there is no reason to poll
  31:     # hard; a minute is far below the resolution of a five-hour window.
  32:     [int]$PollSeconds = 60,
  33: 
  34:     # Refuse to wait longer than this. A five-hour window cannot need more, so exceeding it means
  35:     # the blocking window is a WEEKLY one - days away, which is a founder decision about what to
  36:     # do next, not something a script should sit through silently.
  37:     [double]$MaxHours = 6,
  38: 
  39:     # Passed through, so a caller testing the mechanism can move the line without editing code.
  40:     # The default is the founder's number (2026-08-12): 85 percent, superseding the 90 of
  41:     # 2026-08-06. Only the number moved; one line still means alarm and park together. It matches
  42:     # window-gauge.ps1 and window-lib.ps1, and the three move together.
  43:     [int]$PauseAt = 85,
  44: 
  45:     # Passed through: exercise the park against a synthetic snapshot, spending nothing.
  46:     [string]$SnapshotPath = '',
  47: 
  48:     # Grace past the stated reset before releasing. A reset is a boundary the provider crosses,
  49:     # not an instant we control, so releasing on the exact second risks arriving early. Only the
  50:     # simulation sets this to zero, to cross a boundary in seconds instead of a minute.
  51:     [double]$SlackMinutes = 1
  52: )
  53: 
  54: $ErrorActionPreference = 'SilentlyContinue'
  55: $gauge = Join-Path $PSScriptRoot 'window-gauge.ps1'
  56: 
  57: function Read-Gauge {
  58:     try {
  59:         $a = @('-NoProfile','-ExecutionPolicy','Bypass','-File',$gauge,'-Json','-PauseAt',$PauseAt)
  60:         if ($SnapshotPath) { $a += @('-SnapshotPath', $SnapshotPath) }
  61:         $raw = & powershell @a
  62:         return ($raw | ConvertFrom-Json)
  63:     } catch { return $null }
  64: }
  65: 
  66: $started  = Get-Date
  67: $deadline = $started.AddHours($MaxHours)
  68: 
  69: $g = Read-Gauge
  70: if (-not $g) {
  71:     Write-Output 'WAIT  abandoned - the gauge could not be read at all'
  72:     exit 1
  73: }
  74: 
  75: if ($g.verdict -eq 'OK') {
  76:     Write-Output ("WAIT  nothing to wait for - " + $g.reason)
  77:     exit 0
  78: }
  79: 
  80: # The target comes from the provider's own statement of when this window resets. A minute of
  81: # slack because the reset is a boundary, not an instant we control.
  82: $target = $null
  83: if ($g.resetsAtUtc) { try { $target = ([datetime]::Parse($g.resetsAtUtc)).ToUniversalTime().AddMinutes($SlackMinutes) } catch { } }
  84: if (-not $target) {
  85:     Write-Output 'WAIT  abandoned - no reset time in the reading, so there is nothing to wait for'
  86:     exit 1
  87: }
  88: 
  89: Write-Output ("WAIT  parked on {0} at {1}% - reset stated for {2} local" -f `
  90:     $g.worstWindow, $g.worstPercent, ([datetime]$target).ToLocalTime().ToString('HH:mm'))
  91: 
  92: $lastSaid = Get-Date
  93: while ($true) {
  94:     $now = (Get-Date).ToUniversalTime()
  95: 
  96:     if ($now -ge $target) {
  97:         Write-Output 'WAIT  the stated reset time has passed - re-read the gauge before releasing work'
  98:         exit 0
  99:     }
 100: 
 101:     if ((Get-Date) -ge $deadline) {
 102:         Write-Output ("WAIT  gave up after {0}h - the blocking window is {1}, which resets {2} local. This is a founder decision, not something to wait out." -f `
 103:             $MaxHours, $g.worstWindow, ([datetime]$target).ToLocalTime().ToString('ddd HH:mm'))
 104:         exit 1
 105:     }
 106: 
 107:     # Another session in the account may have rendered its status line, which refreshes the shared
 108:     # snapshot. If it now reads clear, there is no reason to keep sitting here.
 109:     $fresh = Read-Gauge
 110:     if ($fresh -and $fresh.verdict -eq 'OK') {
 111:         Write-Output ("WAIT  cleared early - " + $fresh.reason)
 112:         exit 0
 113:     }
 114: 
 115:     # Say something every ten minutes. Silence and progress look identical, and a wait that never
 116:     # speaks is indistinguishable from a wait that died.
 117:     if (((Get-Date) - $lastSaid).TotalMinutes -ge 10) {
 118:         $left = [int]([math]::Ceiling(($target - $now).TotalMinutes))
 119:         Write-Output ("WAIT  still parked - about {0} min to the stated reset" -f $left)
 120:         $lastSaid = Get-Date
 121:     }
 122: 
 123:     Start-Sleep -Seconds $PollSeconds
 124: }
===== loop\work\window-alarm.cmd =====
   1: @echo off
   2: REM window-alarm.cmd - PostToolUse / PostToolUseFailure: put the window alarm in front of the model.
   3: REM
   4: REM WHY A BATCH FILE AND NOT POWERSHELL. This runs after EVERY tool call in the system, in every
   5: REM agent, forever. A `powershell -NoProfile` process costs roughly 200-400 ms on this machine and
   6: REM would be paid on every one of them. `findstr` is an order of magnitude cheaper. The cost is
   7: REM the whole reason the sensor composes the line and this only reads it.
   8: REM
   9: REM THE CHECKPOINT READS, IT NEVER COMPUTES. statusline.ps1 writes exactly one line to
  10: REM window-verdict.txt on every refresh - OK, or ALARM ... , or UNKNOWN ... - and the first token
  11: REM is the anchor. All this does is match that anchor and hand the line back.
  12: REM
  13: REM Exit 2 with text on stderr is the documented channel that shows the text to the model. Exit 0
  14: REM is silence. There is no third answer: UNKNOWN is deliberately silent here, because a running
  15: REM subagent can neither act on a broken sensor nor fix it, and an UNKNOWN alarm would fire on
  16: REM every tool call in the system for as long as the founder session sits idle. The actors who
  17: REM CAN act hear it loudly elsewhere - the spawn gate at every spawn, the stamp at every prompt.
  18: REM
  19: REM A missing verdict file is silence too. The gate and the stamp both report that state properly.
