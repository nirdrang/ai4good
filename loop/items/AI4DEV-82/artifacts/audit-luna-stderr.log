 210: # Format-WindowVerdictLine - the ONE line the sensor writes to window-verdict.txt.
 211: #
 212: # EXACTLY ONE LINE, three forms, and the FIRST TOKEN is the machine anchor - window-alarm.cmd
 213: # matches it with `findstr /b`, which is all a per-tool checkpoint can afford:
 214: #
 215: #   OK
 216: #   ALARM WINDOW <window> at <pct>% (line <n>%), resets <HH:mm> - finish the current work item, commit, park.
 217: #   UNKNOWN <reason>
 218: #
 219: # The rest of the ALARM form is the whole sentence the model hears. The sensor composes it once
 220: # per refresh; the checkpoint regurgitates it. Nothing downstream has to know how to phrase a
 221: # window alarm, which is what keeps the wording in one place.
 222: function Format-WindowVerdictLine {
 223:     [CmdletBinding()]
 224:     param(
 225:         $Verdict,
 226:         [int]$PauseAt = $script:WindowPauseLine
 227:     )
 228: 
 229:     if ($null -eq $Verdict) { return 'UNKNOWN no verdict was computed' }
 230: 
 231:     $v = [string]$Verdict.verdict
 232:     if ($v -eq 'OK') { return 'OK' }
 233: 
 234:     if ($v -eq 'PAUSE') {
 235:         # The reset time belongs to the window that BLOCKED. Reporting another window's reset would
 236:         # point the reader at the wrong clock, which on this account is up to eighty hours out.
 237:         $reset = '?'
 238:         foreach ($w in @($Verdict.windows)) {
 239:             if (([string]$w.name) -eq ([string]$Verdict.worstWindow)) { $reset = [string]$w.resetsLocal; break }
 240:         }
 241:         return ('ALARM WINDOW {0} at {1}% (line {2}%), resets {3} - finish the current work item, commit, park.' -f `
 242:             $Verdict.worstWindow, $Verdict.worstPercent, $PauseAt, $reset)
 243:     }
 244: 
 245:     # Newlines are stripped rather than trusted: a one-line contract that can be broken by its own
 246:     # payload is not a contract, and the alarm anchors on the first token of the first line.
 247:     $reason = (([string]$Verdict.reason) -replace '[\r\n]', ' ').Trim()
 248:     if (-not $reason) { $reason = 'the reading cannot be trusted' }
 249:     return ('UNKNOWN ' + $reason)
 250: }

