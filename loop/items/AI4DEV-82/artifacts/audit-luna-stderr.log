 155: # ---------- synthetic readings written straight to disk ----------
 156: #
 157: # The sensor always stamps capturedAt with the moment it ran, so a STALE reading cannot be
 158: # produced through it. Those cases are written here directly, in the shape the sensor writes.
 159: 
 160: function Set-Snapshot([hashtable]$windows, [double]$ageMinutes = 0) {
 161:     $o = [ordered]@{
 162:         capturedAt = (Get-Date).ToUniversalTime().AddMinutes(-$ageMinutes).ToString('o')
 163:         sessionId  = 'window-watchdog-drill'
 164:         version    = 'window-watchdog-drill'
 165:         rateLimits = $windows
 166:     }
 167:     [IO.File]::WriteAllText($snapFile, ($o | ConvertTo-Json -Depth 8), (New-Object System.Text.UTF8Encoding($false)))
 168: }
 169: function Set-VerdictLine([string]$line) {
 170:     $script:drillLines += $line
 171:     [IO.File]::WriteAllText($verdictFile, ($line + "`n"), (New-Object System.Text.UTF8Encoding($false)))
 172: }
 173: # EVERY VERDICT LINE THIS RUN PRODUCES IS REMEMBERED. The closing live-directory check needs to
 174: # know what this drill's own output looks like, because the live verdict file carries no sessionId
 175: # to match on the way the snapshot does.
 176: $script:drillLines = @()
 177: function Get-VerdictLine() {
 178:     if (-not (Test-Path $verdictFile)) { return '' }
 179:     $t = [IO.File]::ReadAllText($verdictFile)
 180:     $l = (($t -split "`n")[0]).TrimEnd("`r")

