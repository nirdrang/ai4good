  48: function Assert([string]$group, [string]$claim, [bool]$ok) {
  49:     if ($ok) { $script:pass++; Write-Output ('  PASS  [{0}] {1}' -f $group, $claim) }
  50:     else { $script:fail++; $script:failed += ('[' + $group + '] ' + $claim); Write-Output ('  FAIL  [{0}] {1}' -f $group, $claim) }
