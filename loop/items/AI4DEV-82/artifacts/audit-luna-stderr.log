  27: [CmdletBinding()]
  28: param(
  29:     # The Claude Code binary. Overridable so the probe can be pointed at a specific install.
  30:     [string]$ClaudeBin = 'claude',
  31: 
  32:     # Where the evidence is written. Defaults beside this script.
  33:     [string]$OutDir = '',
  34: 
  35:     # Headless runs need tools to be allowed to run. Hooks fire regardless of permission mode -
  36:     # that is the point of a hook - but if the PreToolUse deny does not appear, re-run with the
  37:     # default mode before concluding anything about the entry.
  38:     [string]$PermissionMode = 'bypassPermissions',
  39: 
  40:     # A single run that hangs must not hang the probe.
  41:     [int]$TimeoutSec = 180
