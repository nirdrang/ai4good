 177:     $out = & powershell -NoProfile -ExecutionPolicy Bypass -File $wait -SnapshotPath $snap -PollSeconds 1 -MaxHours 0
 178:     Check 'a weekly blocker -> gives up with exit 1' $LASTEXITCODE 1
 179:     Check 'and says it is a founder decision' ([bool]($out -match 'founder decision')) 'True'
