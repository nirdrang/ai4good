  76:     $a = @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', $script)
  77:     $proc = Start-Process -FilePath 'powershell' -ArgumentList $a -WorkingDirectory $repo `
  78:         -RedirectStandardInput $p.In -RedirectStandardOutput $p.Out -RedirectStandardError $p.Err `
  79:         -NoNewWindow -Wait -PassThru
  80:     return $proc.ExitCode
  81: }
