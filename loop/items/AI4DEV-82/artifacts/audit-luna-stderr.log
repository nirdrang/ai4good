 102: # context, the user-facing message, the raw stdout and the exit code.
 103: function Invoke-Gate() {
 104:     $p = New-IoPair 'gate'
 105:     Write-Payload $p.In @{
 106:         session_id      = 'drill'
 107:         cwd             = $repo
 108:         hook_event_name = 'PreToolUse'
 109:         tool_name       = 'Agent'
 110:         tool_input      = @{ subagent_type = 'executor'; description = 'drill spawn' }
 111:     }
 112:     $code = Start-Hook $gate $p
 113:     $raw = ''
 114:     if (Test-Path $p.Out) { $raw = [IO.File]::ReadAllText($p.Out) }
 115:     $j = $null
 116:     if ($raw.Trim()) { try { $j = ConvertFrom-Json $raw } catch { } }
 117:     return [pscustomobject]@{
 118:         Exit     = $code
 119:         Raw      = $raw
 120:         Decision = $(if ($j) { [string]$j.hookSpecificOutput.permissionDecision } else { '' })
 121:         Reason   = $(if ($j) { [string]$j.hookSpecificOutput.permissionDecisionReason } else { '' })
 122:         Context  = $(if ($j) { [string]$j.hookSpecificOutput.additionalContext } else { '' })
 123:         UserMsg  = $(if ($j) { [string]$j.systemMessage } else { '' })
 124:     }
 125: }
 126: 
 127: # THE ALARM, as PostToolUse runs it: a batch file, no stdin needed, exit 2 + stderr is the channel.
 128: function Invoke-Alarm() {
 129:     $p = New-IoPair 'alarm'
 130:     [IO.File]::WriteAllText($p.In, '')
 131:     if (-not (Test-Path $alarm)) {
 132:         return [pscustomobject]@{ Exit = 127; Err = ('not built: ' + $alarm); Out = '' }
 133:     }
 134:     $proc = Start-Process -FilePath $alarm -WorkingDirectory $repo `
 135:         -RedirectStandardInput $p.In -RedirectStandardOutput $p.Out -RedirectStandardError $p.Err `
 136:         -NoNewWindow -Wait -PassThru
 137:     $err = ''
 138:     if (Test-Path $p.Err) { $err = [IO.File]::ReadAllText($p.Err) }
 139:     $out = ''
 140:     if (Test-Path $p.Out) { $out = [IO.File]::ReadAllText($p.Out) }
 141:     return [pscustomobject]@{ Exit = $proc.ExitCode; Err = $err; Out = $out }
 142: }
 143: 
 144: # THE STAMP. No session_id in the payload on purpose: that skips the session freshness baseline,
 145: # so the drill writes nothing into the real session state directory.
 146: function Invoke-Stamp() {
 147:     $p = New-IoPair 'stamp'
 148:     Write-Payload $p.In @{ hook_event_name = 'UserPromptSubmit'; prompt = 'drill' }
 149:     $code = Start-Hook $stamp $p
 150:     $out = ''
 151:     if (Test-Path $p.Out) { $out = [IO.File]::ReadAllText($p.Out) }
 152:     return [pscustomobject]@{ Exit = $code; Out = $out }
 153: }
