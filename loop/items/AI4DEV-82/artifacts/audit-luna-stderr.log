 171:     Set-Reading @{ five_hour = (W 97 -3) }
 172:     $out = & powershell -NoProfile -ExecutionPolicy Bypass -File $wait -SnapshotPath $snap -PollSeconds 1
 173:     Check 'reset time already passed -> exits 0' $LASTEXITCODE 0
 174:     Check 'and tells the caller to re-read the gauge' ([bool]($out -match 're-read the gauge')) 'True'
