 135: function Invoke-Case([string]$name, [string]$windowDir, [string]$prompt) {
 136:     $pf  = Join-Path $OutDir ($name + '.prompt.txt')
 137:     $out = Join-Path $OutDir ($name + '.stream.jsonl')
 138:     $err = Join-Path $OutDir ($name + '.stderr.log')
 139:     [IO.File]::WriteAllText($pf, $prompt, (New-Object System.Text.UTF8Encoding($false)))
 140: 
 141:     # THE PROMPT GOES IN BY FILE. Inline quoted arguments mangled a nested payload during this
 142:     # item's hook measurement, and a probe that fails on its own quoting proves nothing.
 143:     $saved = $env:AI4GOOD_WINDOW_DIR
 144:     $env:AI4GOOD_WINDOW_DIR = $windowDir
 145:     $a = @('-p', '--settings', $twin, '--output-format', 'stream-json', '--verbose', '--permission-mode', $PermissionMode)
 146:     $proc = Start-Process -FilePath $ClaudeBin -ArgumentList $a -WorkingDirectory $work `
 147:         -RedirectStandardInput $pf -RedirectStandardOutput $out -RedirectStandardError $err `
 148:         -NoNewWindow -PassThru
 149:     if (-not $proc.WaitForExit($TimeoutSec * 1000)) {
 150:         try { $proc.Kill() } catch { }
 151:         Write-Output ('        ' + $name + ': TIMED OUT after ' + $TimeoutSec + 's')
 152:     }
 153:     $env:AI4GOOD_WINDOW_DIR = $saved
 154: 
 155:     $text = ''
 156:     if (Test-Path $out) { $text = [IO.File]::ReadAllText($out) }
 157:     return [pscustomobject]@{ Name = $name; Text = $text; Out = $out; Err = $err }
 158: }
