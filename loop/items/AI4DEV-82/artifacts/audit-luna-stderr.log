  96: # ---------- synthetic window directories ----------
  97: 
  98: function New-WindowDir([string]$name, [scriptblock]$fill) {
  99:     $d = Join-Path $OutDir ('windir-' + $name)
 100:     New-Item -ItemType Directory -Force -Path $d | Out-Null
 101:     Get-ChildItem $d | Remove-Item -Force -Recurse -ErrorAction SilentlyContinue
 102:     & $fill $d
 103:     return $d
 104: }
 105: 
 106: . (Join-Path $repo 'loop\work\window-lib.ps1')
 107: 
 108: function Write-Synthetic([string]$dir, $pct, [double]$resetMin) {
 109:     $snap = [ordered]@{
 110:         capturedAt = (Get-Date).ToUniversalTime().ToString('o')
 111:         sessionId  = 'settings-proof-probe'
 112:         version    = 'settings-proof-probe'
 113:         rateLimits = @{ five_hour = @{ used_percentage = $pct; resets_at = [DateTimeOffset]::UtcNow.AddMinutes($resetMin).ToUnixTimeSeconds() } }
 114:     }
 115:     # THE VERDICT IS COMPOSED FROM THE PRODUCTION SHAPE, NOT FROM THE HASHTABLE ABOVE. Every reader
 116:     # in production gets its snapshot from ConvertFrom-Json, so it holds a PSCustomObject; this
 117:     # file built one in memory and handed the library a Hashtable, and the line it composed named
 118:     # the worst window "Values" instead of five_hour. A probe that mis-composes the very line it
 119:     # exists to prove is worse than no probe, so the round trip through JSON happens FIRST and the
 120:     # exact bytes written to disk are the bytes the verdict was computed from.
 121:     $json = $snap | ConvertTo-Json -Depth 8
 122:     $utf8 = New-Object System.Text.UTF8Encoding($false)
 123:     [IO.File]::WriteAllText((Join-Path $dir 'window-verdict.txt'), ((Format-WindowVerdictLine (Get-WindowVerdict -Snapshot ($json | ConvertFrom-Json))) + "`n"), $utf8)
 124:     [IO.File]::WriteAllText((Join-Path $dir 'rate-limits.json'), $json, $utf8)
 125: }
 126: 
 127: $dirOver    = New-WindowDir 'over'    { param($d) Write-Synthetic $d 95 90 }
 128: $dirUnknown = New-WindowDir 'unknown' { param($d) [IO.File]::WriteAllText((Join-Path $d 'rate-limits.json'), 'this is not json {{{') }
