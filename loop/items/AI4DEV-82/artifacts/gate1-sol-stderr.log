   1: # Runs every relay control drill against the scripted fake actor. Free, deterministic, on demand.
   2: # Each drill encodes ONE real incident or one finding of the codex sol review
   3: # (loop/drills/records/codex-sol-review-2026-08-09.md); a red names the hand-off that broke.
   4: # Exit 1 on any red. v2 adds: commencement, phase-event fencing, strict landing, refusal paths,
   5: # CI outcomes, the closing edge, and an event trace.
   6: $ErrorActionPreference = 'Stop'
   7: $here  = Split-Path -Parent $MyInvocation.MyCommand.Path
   8: . (Join-Path $here 'control-lib.ps1')
   9: $actor   = Join-Path $here 'fake-actor.ps1'
  10: $prompts = Join-Path $here 'prompts'
  11: $root    = Join-Path $env:TEMP ('relay-drills-' + [guid]::NewGuid().ToString('N').Substring(0, 8))
  12: New-Item -ItemType Directory -Force -Path $root | Out-Null
  13: $trace   = Join-Path $root 'trace.log'
  14: $results = @()
  15: $cleanupPids = @()
  16: 
  17: function New-DrillDir([string]$name) {
  18:     $d = Join-Path $root $name
  19:     New-Item -ItemType Directory -Force -Path $d | Out-Null
  20:     return $d
  21: }
  22: function Assert([string]$drill, [string]$claim, [bool]$ok) {
  23:     $script:results += [pscustomobject]@{ Drill = $drill; Claim = $claim; Pass = $ok }
  24:     Add-DrillEvent -TraceFile $trace -Actor 'drill' -Event ("{0}:{1}" -f $drill, $(if ($ok) { 'pass' } else { 'FAIL' }))
  25: }
  26: 
  27: # =====================  v1 core - the original eight  =====================
  28: 
  29: # ---- happy path ----
  30: $d1 = New-DrillDir 'happy'
  31: $pid1 = Start-DetachedActor -ActorScript $actor -Mode 'happy' -Dir $d1
  32: $live = Get-ActorLiveness -ProcessId $pid1 -LogFile (Join-Path $d1 'actor.log')
  33: Assert 'happy-path' 'a running actor reads Alive-Working' ($live -eq 'Alive-Working')
  34: $channel = Wait-TwoChannel -NotifyFile (Join-Path $d1 'notify.txt') -ResultFile (Join-Path $d1 'result.txt') -TimeoutSec 10
  35: Assert 'happy-path' 'completion arrives on the notify channel' ($channel -eq 'notify')
  36: $phases = @(Get-Content (Join-Path $d1 'actor.log'))
  37: Assert 'happy-path' 'phases ran in order 1..5' (($phases -join ',') -eq 'phase 1,phase 2,phase 3,phase 4,phase 5')
  38: 
  39: # ---- dies at launch ----
  40: $d2 = New-DrillDir 'die-at-launch'
  41: $pid2 = Start-DetachedActor -ActorScript $actor -Mode 'die-at-launch' -Dir $d2
  42: Start-Sleep -Milliseconds 1500
  43: $trapFile = Join-Path $d2 'result.txt'
  44: Assert 'die-at-launch' 'the trap is real: output file exists and is empty' ((Test-Path $trapFile) -and ((Get-Item $trapFile).Length -eq 0))
  45: $live = Get-ActorLiveness -ProcessId $pid2 -LogFile (Join-Path $d2 'actor.log')
  46: Assert 'die-at-launch' 'liveness check says Dead despite the file' ($live -eq 'Dead')
  47: Assert 'die-at-launch' 'an empty result file is not COMPLETE - it reads RESTART' ((Get-ResumeState -Dir $d2) -eq 'RESTART')
  48: 
  49: # ---- detachment (simulation note: Windows never reaps children automatically; the
  50: # died-with-launcher case only occurs via harness teardown, which the explicit kill reproduces) ----
  51: $d3a = New-DrillDir 'detached-survives'
  52: $d3b = New-DrillDir 'detached-dies'
  53: $cmdA = "Set-Content -Path '$d3a\parent.pid' -Value `$PID; `$p = Start-Process powershell.exe -ArgumentList '-NoProfile','-ExecutionPolicy','Bypass','-File','$actor','-Mode','hang','-Dir','$d3a' -WindowStyle Hidden -PassThru; Set-Content -Path '$d3a\pid.txt' -Value `$p.Id"
  54: $cmdB = "`$p = Start-Process powershell.exe -ArgumentList '-NoProfile','-ExecutionPolicy','Bypass','-File','$actor','-Mode','hang','-Dir','$d3b' -WindowStyle Hidden -PassThru; Set-Content -Path '$d3b\pid.txt' -Value `$p.Id; Start-Sleep -Milliseconds 500; Stop-Process -Id `$p.Id -Force"
  55: & powershell.exe -NoProfile -Command $cmdA | Out-Null
  56: & powershell.exe -NoProfile -Command $cmdB | Out-Null
  57: Start-Sleep -Milliseconds 500
  58: $pidA = [int](Get-Content (Join-Path $d3a 'pid.txt'))
  59: $pidB = [int](Get-Content (Join-Path $d3b 'pid.txt'))
  60: $parentA = [int](Get-Content (Join-Path $d3a 'parent.pid'))
  61: $cleanupPids += $pidA
  62: Assert 'detachment' 'a true detach survives its launcher' ($null -ne (Get-Process -Id $pidA -ErrorAction SilentlyContinue))
  63: Assert 'detachment' 'a false detach is detected as Dead, not assumed running' ($null -eq (Get-Process -Id $pidB -ErrorAction SilentlyContinue))
  64: 
  65: # ---- orphan: the launcher is gone, the child is alive - detect, then abort by identity ----
  66: Assert 'orphan' 'a live child of a dead launcher classifies as ORPHANED' ((Test-Orphan -ParentProcessId $parentA -ChildProcessId $pidA) -eq 'ORPHANED')
  67: $idA = Get-ProcessIdentity -ProcessId $pidA
  68: Assert 'orphan' 'identity is verifiable before any abort' ($null -ne $idA -and (Test-SameProcess -ProcessId $pidA -RecordedStart $idA.Start))
  69: Stop-Process -Id $pidA -Force
  70: Start-Sleep -Milliseconds 300
  71: Assert 'orphan' 'the abort provably killed the reviewer' ($null -eq (Get-Process -Id $pidA -ErrorAction SilentlyContinue))
  72: $act = Invoke-WaitOutcome -Outcome 'ABORTED'
  73: Assert 'orphan' 'an aborted gate hands down as an anomaly, never advances' ((-not $act.advance) -and ($act.action -eq 'HAND-DOWN-ANOMALY'))
  74: 
  75: # ---- lost notification ----
  76: $d4 = New-DrillDir 'no-notify'
  77: Start-DetachedActor -ActorScript $actor -Mode 'finish-no-notify' -Dir $d4 | Out-Null
  78: $channel = Wait-TwoChannel -NotifyFile (Join-Path $d4 'notify.txt') -ResultFile (Join-Path $d4 'result.txt') -TimeoutSec 10
  79: Assert 'lost-notification' 'the backstop watch catches what the notify channel missed' ($channel -eq 'backstop')
  80: Assert 'lost-notification' 'the notify signal genuinely never arrived' (-not (Test-Path (Join-Path $d4 'notify.txt')))
  81: 
  82: # ---- watch expiry, plus the empty-file trap on the backstop ----
  83: $d5 = New-DrillDir 'expiry'
  84: $channel = Wait-TwoChannel -NotifyFile (Join-Path $d5 'notify.txt') -ResultFile (Join-Path $d5 'result.txt') -TimeoutSec 2
  85: Assert 'watch-expiry' 'an expired watch returns EXPIRED, distinct from every success value' ($channel -eq 'EXPIRED')
  86: New-Item -ItemType File -Path (Join-Path $d5 'result.txt') -Force | Out-Null
  87: $channel = Wait-TwoChannel -NotifyFile (Join-Path $d5 'notify.txt') -ResultFile (Join-Path $d5 'result.txt') -TimeoutSec 2
  88: Assert 'watch-expiry' 'a zero-byte result file cannot complete the backstop' ($channel -eq 'EXPIRED')
  89: $act = Invoke-WaitOutcome -Outcome 'EXPIRED'
  90: Assert 'watch-expiry' 'EXPIRED drives a stall report and never an advance' (($act.action -eq 'STALL-REPORT') -and (-not $act.advance) -and $act.rearm)
  91: 
  92: # ---- stall ----
  93: $d6 = New-DrillDir 'stall'
  94: $pid6 = Start-DetachedActor -ActorScript $actor -Mode 'hang' -Dir $d6
  95: $cleanupPids += $pid6
  96: Start-Sleep -Milliseconds 1000
  97: $live = Get-ActorLiveness -ProcessId $pid6 -LogFile (Join-Path $d6 'actor.log')
  98: Assert 'stall' 'a hung actor reads Alive-Stalled, not working and not dead' ($live -eq 'Alive-Stalled')
  99: 
 100: # ---- death mid-phase ----
 101: $d7 = New-DrillDir 'death-mid-phase'
 102: $pid7 = Start-DetachedActor -ActorScript $actor -Mode 'hang' -Dir $d7
 103: Start-Sleep -Milliseconds 800
 104: Stop-Process -Id $pid7 -Force
 105: Start-Sleep -Milliseconds 300
 106: Assert 'death-mid-phase' 'the resume point comes from disk, at the last recorded phase' ((Get-ResumeState -Dir $d7) -eq 'RESUME-FROM:phase 1')
 107: Assert 'death-mid-phase' 'a finished actor reads COMPLETE even though it died unnotified' ((Get-ResumeState -Dir $d4) -eq 'COMPLETE')
 108: 
 109: # ---- spawn-failure taxonomy (scoped in v2) ----
 110: Assert 'stale-registry' 'agent-type-not-found maps to STALL:STALE-REGISTRY' ((Get-SpawnFailureClass -ErrorText 'Agent type not found: conductor') -eq 'STALL:STALE-REGISTRY')
 111: Assert 'stale-registry' 'an unrelated file-not-found is NOT a stale registry' ((Get-SpawnFailureClass -ErrorText 'file not found: foo.ps1') -eq 'STALL:UNKNOWN')
 112: Assert 'stale-registry' 'an unreachable-agent error gets its own class' ((Get-SpawnFailureClass -ErrorText "No agent named 'agent-123' is reachable") -eq 'STALL:UNREACHABLE')
 113: 
 114: # =====================  v2: commencement - the lost-day class  =====================
 115: 
 116: $dc = New-DrillDir 'commencement'
 117: 
 118: $r = Invoke-Commencement -Spawn { @{ ok = $false; error = 'Agent type conductor not found' } } -FlowLineFile (Join-Path $dc 'flow1.txt') -DeadlineSec 2
 119: Assert 'commencement' 'a rejected spawn is a STARTUP-STALL now, with the error verbatim' (($r.state -eq 'STARTUP-STALL') -and ($r.why -eq 'SPAWN-REJECTED') -and ($r.error -match 'conductor'))
 120: Assert 'commencement' 'the rejected-spawn error classifies through the taxonomy' ((Get-SpawnFailureClass -ErrorText $r.error) -eq 'STALL:STALE-REGISTRY')
 121: 
 122: $r = Invoke-Commencement -Spawn { @{ ok = $true } } -FlowLineFile (Join-Path $dc 'flow2.txt') -DeadlineSec 2
 123: Assert 'commencement' 'a spawn with no receipt is a STARTUP-STALL, not a wait' (($r.state -eq 'STARTUP-STALL') -and ($r.why -eq 'NO-RECEIPT'))
 124: 
 125: Assert 'commencement' 'the single-conductor fence admits the first commencement' (Register-Commencement -Dir $dc -Item 'X')
 126: Assert 'commencement' 'the fence refuses a second commencement for the same item' (-not (Register-Commencement -Dir $dc -Item 'X'))
 127: 
 128: $dcd = New-DrillDir 'commence-dead'
 129: $r = Invoke-Commencement -Spawn {
 130:     $p = Start-DetachedActor -ActorScript $actor -Mode 'die-at-launch' -Dir $dcd
 131:     @{ ok = $true; taskId = 't-dead'; procId = $p }
 132: } -FlowLineFile (Join-Path $dcd 'flow.txt') -DeadlineSec 3 -TranscriptFile (Join-Path $dcd 'actor.log')
 133: Assert 'commencement' 'a conductor dead before its first line is a STARTUP-STALL:DEAD-TASK' (($r.state -eq 'STARTUP-STALL') -and ($r.why -eq 'DEAD-TASK'))
 134: 
 135: $dcs = New-DrillDir 'commence-silent'
 136: $script:pidSilent = 0
 137: $r = Invoke-Commencement -Spawn {
 138:     $script:pidSilent = Start-DetachedActor -ActorScript $actor -Mode 'hang' -Dir $dcs
 139:     @{ ok = $true; taskId = 't-silent'; procId = $script:pidSilent }
 140: } -FlowLineFile (Join-Path $dcs 'flow.txt') -DeadlineSec 3 -TranscriptFile (Join-Path $dcs 'actor.log')
 141: $cleanupPids += $script:pidSilent
 142: Assert 'commencement' 'alive but silent setup past the deadline is SETUP-SILENT' (($r.state -eq 'STARTUP-STALL') -and ($r.why -eq 'SETUP-SILENT'))
 143: 
 144: $dcw = New-DrillDir 'commence-working'
 145: $script:pidWork = 0
 146: $r = Invoke-Commencement -Spawn {
 147:     $script:pidWork = Start-DetachedActor -ActorScript $actor -Mode 'happy' -Dir $dcw
 148:     @{ ok = $true; taskId = 't-work'; procId = $script:pidWork }
 149: } -FlowLineFile (Join-Path $dcw 'never-flow.txt') -DeadlineSec 1 -TranscriptFile (Join-Path $dcw 'actor.log')
 150: Assert 'commencement' 'a growing transcript past the deadline distinguishes COMMENCING-LATE from silence' (($r.state -eq 'STARTUP-STALL') -and ($r.why -eq 'COMMENCING-LATE'))
 151: 
 152: $dcc = New-DrillDir 'commence-ok'
 153: $r = Invoke-Commencement -Spawn {
 154:     $p = Start-DetachedActor -ActorScript $actor -Mode 'happy' -Dir $dcc
 155:     @{ ok = $true; taskId = 't-ok'; procId = $p }
 156: } -FlowLineFile (Join-Path $dcc 'notify.txt') -DeadlineSec 8 -TranscriptFile (Join-Path $dcc 'actor.log')
 157: Assert 'commencement' 'a first flow line inside the deadline is COMMENCED - arrival, not sending' ($r.state -eq 'COMMENCED')
 158: 
 159: # ---- arming is not firing ----
 160: Assert 'watch-armed' 'no task id means the watch is NOT armed, whatever was claimed' ((Confirm-WatchArmed -TaskId '' -Probe { 'running' }) -eq 'STALL:WATCH-NOT-ARMED')
 161: Assert 'watch-armed' 'a rejected task probes as not armed' ((Confirm-WatchArmed -TaskId 't9' -Probe { 'rejected' }) -eq 'STALL:WATCH-NOT-ARMED')
 162: Assert 'watch-armed' 'armed means task exists AND probes running, named for the flow line' ((Confirm-WatchArmed -TaskId 't9' -Probe { 'running' }) -eq 'ARMED:t9')
 163: 
 164: # =====================  v2: hand-off fencing  =====================
 165: 
 166: $ledger = New-PhaseLedger
 167: $e1 = Register-PhaseEvent -Ledger $ledger -Generation 'gate1@abc123' -Channel 'backstop'
 168: $e2 = Register-PhaseEvent -Ledger $ledger -Generation 'gate1@abc123' -Channel 'tether'
 169: $e3 = Register-PhaseEvent -Ledger $ledger -Generation 'gate2@def456' -Channel 'tether'
 170: $e4 = Register-PhaseEvent -Ledger $ledger -Generation 'gate1@abc123' -Channel 'tether-late'
 171: Assert 'phase-fence' 'the first channel to fire advances the phase' ($e1.advance -and ($e1.channel -eq 'backstop'))
 172: Assert 'phase-fence' 'the second channel for the same generation is refused' (-not $e2.advance)
 173: Assert 'phase-fence' 'a late duplicate after the next phase started is refused' (-not $e4.advance)
 174: Assert 'phase-fence' 'the next generation advances normally, exactly once, in order' ($e3.advance -and (($ledger.order -join ',') -eq 'gate1@abc123,gate2@def456'))
 175: 
 176: Assert 'tip-baseline' 'a tip that moved inside the spawn-to-watch gap is still detected, because the baseline predates the spawn' (Test-TipMoved -BaselineHead 'aaa1111' -CurrentHead 'bbb2222')
 177: Assert 'tip-baseline' 'an unmoved tip does not false-fire' (-not (Test-TipMoved -BaselineHead 'aaa1111' -CurrentHead 'aaa1111'))
 178: 
 179: Assert 'generation' 'a missing state file or report holds the relay' ((Test-SittingGeneration -StateGeneration '' -ReportedHead 'abc' -RemoteHead 'abc') -eq 'HOLD:MISSING')
 180: Assert 'generation' 'a reported head that is not the remote tip holds the relay' ((Test-SittingGeneration -StateGeneration 'g1' -ReportedHead 'abc' -RemoteHead 'xyz') -eq 'HOLD:HEAD-MISMATCH')
 181: Assert 'generation' 'agreement of state, report and remote proceeds' ((Test-SittingGeneration -StateGeneration 'g1' -ReportedHead 'abc' -RemoteHead 'abc') -eq 'PROCEED')
 182: 
 183: # ---- pid reuse ----
 184: $dp = New-DrillDir 'pid-reuse'
 185: $pidX = Start-DetachedActor -ActorScript $actor -Mode 'hang' -Dir $dp
 186: $idX = Get-ProcessIdentity -ProcessId $pidX
 187: Start-Sleep -Milliseconds 1500
 188: $dp2 = New-DrillDir 'pid-reuse-b'
 189: $pidY = Start-DetachedActor -ActorScript $actor -Mode 'hang' -Dir $dp2
 190: $cleanupPids += $pidX; $cleanupPids += $pidY
 191: Assert 'pid-identity' 'a different process never passes as the recorded reviewer, whatever its pid' (-not (Test-SameProcess -ProcessId $pidY -RecordedStart $idX.Start))
 192: Assert 'pid-identity' 'the identity mismatch protected the bystander - it was not killed' ($null -ne (Get-Process -Id $pidY -ErrorAction SilentlyContinue))
 193: 
 194: # =====================  v2: strict review landing  =====================
 195: 
 196: $deadProbe = Start-Process powershell -ArgumentList '-NoProfile','-Command','exit' -WindowStyle Hidden -PassThru
 197: Wait-Process -Id $deadProbe.Id -ErrorAction SilentlyContinue
 198: $deadPid = $deadProbe.Id
 199: 
 200: # stale artifact from a previous run
 201: $dl = New-DrillDir 'landing-stale'
 202: $staleOut = Join-Path $dl 'out.md'; $staleErr = Join-Path $dl 'err.log'
 203: Set-Content -Path $staleOut -Value @('old findings', 'CODE REVIEW: 2 FINDINGS')
 204: (Get-Item $staleOut).LastWriteTime = (Get-Date).AddHours(-2)
 205: $v = Wait-ReviewLanding -Out $staleOut -Err $staleErr -ProcessId $deadPid -LaunchTime (Get-Date) -TimeoutSec 3
 206: Assert 'landing' 'a stale verdict from a previous run can never land a new gate' ($v -eq 'EMPTY-GATE')
 207: 
 208: # malformed marker
 209: $dm = New-DrillDir 'landing-malformed'
 210: $mOut = Join-Path $dm 'out.md'; $mErr = Join-Path $dm 'err.log'
 211: Set-Content -Path $mOut -Value 'CODE REVIEW: still working'
 212: $v = Wait-ReviewLanding -Out $mOut -Err $mErr -ProcessId $deadPid -LaunchTime (Get-Date).AddSeconds(-5) -TimeoutSec 3
 213: Assert 'landing' 'a malformed count line is not a landing' ($v -eq 'EMPTY-GATE')
 214: 
 215: # count line only in stderr
 216: $ds = New-DrillDir 'landing-stderr-only'
 217: $sOut = Join-Path $ds 'out.md'; $sErr = Join-Path $ds 'err.log'
 218: Set-Content -Path $sOut -Value 'narration only, no verdict here'
 219: Set-Content -Path $sErr -Value 'CODE REVIEW: CLEAN'
 220: $v = Wait-ReviewLanding -Out $sOut -Err $sErr -ProcessId $deadPid -LaunchTime (Get-Date).AddSeconds(-5) -TimeoutSec 3
 221: Assert 'landing' 'a count line only in stderr is AMBIGUOUS, never a clean landing' ($v -eq 'AMBIGUOUS:COUNT-IN-STDERR-ONLY')
 222: 
 223: # partial verdict: count line present, process still alive, more findings coming
 224: $de = New-DrillDir 'landing-partial'
 225: $eOut = Join-Path $de 'out.md'; $eErr = Join-Path $de 'err.log'
 226: $launch = Get-Date
 227: $pidE = Start-DetachedActor -ActorScript $actor -Mode 'drill-e' -Dir $de -Out $eOut -Err $eErr
 228: $cleanupPids += $pidE
 229: Start-Sleep -Seconds 3
 230: $v = Wait-ReviewLanding -Out $eOut -Err $eErr -ProcessId $pidE -LaunchTime $launch -TimeoutSec 4
 231: Assert 'landing' 'a count line with the process still alive is a partial verdict, not a landing' ($v -eq 'TIMEOUT')
 232: $v = Wait-ReviewLanding -Out $eOut -Err $eErr -ProcessId $pidE -LaunchTime $launch -TimeoutSec 20
 233: Assert 'landing' 'after exit and settlement the same gate lands' ($v -eq 'LANDED')
 234: Assert 'landing' 'the landed verdict is the LATE version, not the early one' ((Get-Content $eOut | Select-Object -Last 1) -eq 'CODE REVIEW: 3 FINDINGS')
 235: 
 236: # distillate integrity
 237: $dist = Join-Path $de 'distillate.md'
 238: Set-Content -Path $dist -Value @('FINDING 1 x', 'FINDING 2 y', 'FINDING 3 z')
 239: Assert 'distillate' 'a distillate matching the raw count is OK' ((Test-Distillate -RawFile $eOut -DistillateFile $dist) -eq 'OK')
 240: Set-Content -Path $dist -Value @('FINDING 1 x')
 241: Assert 'distillate' 'a truncated distillate is a count-mismatch anomaly, not a hand-off' ((Test-Distillate -RawFile $eOut -DistillateFile $dist) -match '^ANOMALY:COUNT-MISMATCH')
 242: Assert 'distillate' 'a missing distillate after a landed review is an anomaly' ((Test-Distillate -RawFile $eOut -DistillateFile (Join-Path $de 'nope.md')) -eq 'ANOMALY:MISSING')
 243: 
 244: $act = Invoke-WaitOutcome -Outcome 'EMPTY-GATE'
 245: Assert 'landing' 'an empty gate hands down as an anomaly and never advances' (($act.action -eq 'HAND-DOWN-ANOMALY') -and (-not $act.advance))
 246: $act = Invoke-WaitOutcome -Outcome 'LANDED'
 247: Assert 'landing' 'a landed gate proceeds' ($act.advance -and ($act.action -eq 'PROCEED'))
 248: 
 249: # =====================  v2: the refusal path, executable  =====================
 250: 
 251: $dr = New-DrillDir 'refused'
 252: $r = Invoke-GuardedLaunch -PromptFile (Join-Path $prompts 'gate-refused-drill.md') -OwnGateHeading '## The DRAFT CODE review' -Launch { throw 'must never launch' } -PidFile (Join-Path $dr 'x.pid')
 253: Assert 'refused' 'a leaky prompt is REFUSED before anything launches' (($r.state -eq 'REFUSED') -and ($r.why -match '^LEAKY:'))
 254: Assert 'refused' 'REFUSED leaves no pid file and no process' (-not (Test-Path (Join-Path $dr 'x.pid')))
 255: $noPolicy = Join-Path $dr 'no-policy.md'
 256: Set-Content -Path $noPolicy -Value @('# prompt', '## The DRAFT CODE review', 'review the code')
 257: $r = Invoke-GuardedLaunch -PromptFile $noPolicy -OwnGateHeading '## The DRAFT CODE review' -Launch { throw 'must never launch' } -PidFile (Join-Path $dr 'y.pid')
 258: Assert 'refused' 'a prompt without the write policy in words is REFUSED' (($r.state -eq 'REFUSED') -and ($r.why -eq 'LEAKY:NO-WRITE-POLICY'))
 259: $r = Invoke-GuardedLaunch -PromptFile (Join-Path $prompts 'gate2-code-drill.md') -OwnGateHeading '## The DRAFT CODE review' -Launch {
 260:     Start-DetachedActor -ActorScript $actor -Mode 'die-at-launch' -Dir $dr
 261: } -PidFile (Join-Path $dr 'z.pid')
 262: Assert 'refused' 'a clean prompt launches, and the pid is recorded' (($r.state -eq 'LAUNCHED') -and (Test-Path (Join-Path $dr 'z.pid')))
 263: 
 264: # =====================  v2: CI outcomes  =====================
 265: 
 266: Assert 'ci' 'no run for the head after the window is DISPATCH-PRODUCED-NOTHING, not a longer wait' ((Resolve-CiOutcome -RunExists $false -RunSha '' -FinalSha 'fff' -Conclusion '' -WindowExpired $true) -eq 'DISPATCH-PRODUCED-NOTHING')
 267: Assert 'ci' 'no run inside the window is still WAITING' ((Resolve-CiOutcome -RunExists $false -RunSha '' -FinalSha 'fff' -Conclusion '' -WindowExpired $false) -eq 'WAITING')
 268: Assert 'ci' 'a green on any head but the final one is nothing' ((Resolve-CiOutcome -RunExists $true -RunSha 'aaa' -FinalSha 'fff' -Conclusion 'success' -WindowExpired $false) -eq 'IGNORED:NON-FINAL-HEAD')
 269: Assert 'ci' 'cancelled is a terminal wake, never silence' ((Resolve-CiOutcome -RunExists $true -RunSha 'fff' -FinalSha 'fff' -Conclusion 'cancelled' -WindowExpired $false) -eq 'TERMINAL:cancelled')
 270: Assert 'ci' 'timed_out is a terminal wake' ((Resolve-CiOutcome -RunExists $true -RunSha 'fff' -FinalSha 'fff' -Conclusion 'timed_out' -WindowExpired $false) -eq 'TERMINAL:timed_out')
 271: Assert 'ci' 'success on the final head is the terminal green' ((Resolve-CiOutcome -RunExists $true -RunSha 'fff' -FinalSha 'fff' -Conclusion 'success' -WindowExpired $false) -eq 'TERMINAL:success')
 272: 
 273: # =====================  v2: the closing edge  =====================
 274: 
 275: $dgl = New-DrillDir 'close'
 276: $ledgerFile = Join-Path $dgl 'ledger.log'
 277: Assert 'closing' 'a lost final report with the merge on the remote repairs from primary evidence' ((Resolve-CloseRepair -MergedOnRemote $true -ReportArrived $false -LedgerFile $ledgerFile) -eq 'REPAIR:SET-DONE-FROM-PRIMARY-EVIDENCE')
 278: Assert 'closing' 'the repair is exactly-once - a second attempt is a NOOP' ((Resolve-CloseRepair -MergedOnRemote $true -ReportArrived $false -LedgerFile $ledgerFile) -eq 'NOOP:ALREADY-REPAIRED')
 279: Assert 'closing' 'no merge and no report is a stall, never an assumed close' ((Resolve-CloseRepair -MergedOnRemote $false -ReportArrived $false -LedgerFile (Join-Path $dgl 'l2.log')) -eq 'STALL:NO-EVIDENCE')
 280: Assert 'closing' 'a report that arrived closes normally' ((Resolve-CloseRepair -MergedOnRemote $true -ReportArrived $true -LedgerFile (Join-Path $dgl 'l3.log')) -eq 'NORMAL')
 281: 
 282: # =====================  v2: the trace is evidence  =====================
 283: 
 284: $lines = @(Get-Content $trace)
 285: $seqs = $lines | ForEach-Object { [int]($_.Split('|')[0]) }
 286: $monotonic = $true
 287: for ($i = 1; $i -lt $seqs.Count; $i++) { if ($seqs[$i] -ne $seqs[$i - 1] + 1) { $monotonic = $false } }
 288: Assert 'trace' 'every drill left a replayable event, in strict sequence' (($lines.Count -gt 40) -and $monotonic)
 289: 
 290: # ---- Cleanup ----
 291: foreach ($p in $cleanupPids) {
 292:     try { Stop-Process -Id $p -Force -ErrorAction Stop } catch {}
 293: }
 294: Remove-Item -Recurse -Force $root -ErrorAction SilentlyContinue
 295: 
 296: # ---- Report ----
 297: $failed = @($results | Where-Object { -not $_.Pass })
 298: # ---- twin guard: the orchestrator pair must be identical apart from the declared differences.
 299: # The rule drifted within a day of being relied on (2026-08-10); this assertion is that lesson.
 300: & powershell -NoProfile -File (Join-Path $here '..\work\twin-check.ps1') | Out-Null
 301: Assert 'twin-guard' 'orchestrator twins are in sync (edit both or neither)' ($LASTEXITCODE -eq 0)
 302: 
 303: foreach ($r in $results) {
 304:     $mark = if ($r.Pass) { 'PASS' } else { 'FAIL' }
 305:     Write-Output ('{0}  [{1}] {2}' -f $mark, $r.Drill, $r.Claim)
 306: }
 307: Write-Output ''
 308: Write-Output ('{0} of {1} assertions green' -f (@($results | Where-Object { $_.Pass }).Count), $results.Count)
 309: if ($failed.Count -gt 0) {
 310:     Write-Output 'RED - the hand-offs above broke.'
 311:     exit 1
 312: }
 313: Write-Output 'All control hand-offs held.'
 314: exit 0
