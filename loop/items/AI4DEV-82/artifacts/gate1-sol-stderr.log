FILE loop/work/window-wait.ps1
   1: # window-wait.ps1 - block until the usage window has reopened, then exit 0.
   2: #
   3: # HOW IT IS MEANT TO BE USED. Run it as a BACKGROUND command. Its exit re-invokes the session,
   4: # which is the whole trick: the coordinator parks, this waits without spending anything, and the
   5: # founder's session continues in the same conversation with its context intact. Nothing is
   6: # resumed, nothing is restarted, no scheduled task is involved.
   7: #
   8: # WHY IT WAITS ON THE CLOCK AND NOT ON THE GAUGE. The gauge is refreshed by the status line, and
   9: # the status line only renders when the session takes a turn. A parked session takes no turns -
  10: # so during exactly the period this script is waiting, the reading it would like to poll is
  11: # frozen. Polling it alone would wait forever on a number that cannot change.
  12: #
  13: # So the wait is anchored on `resets_at`, which the provider states and which is true whether or
  14: # not anyone is looking. The gauge is still read every poll, because if some OTHER session in the
  15: # account renders its status line the snapshot updates and we can leave early - but the clock is
  16: # what guarantees an exit.
  17: #
  18: # THIS SCRIPT CANNOT CLEAR THE WINDOW, ONLY OBSERVE THAT IT SHOULD HAVE. Its exit means "the
  19: # stated reset time has passed", not "you have budget". The work skill already warns why that
  20: # distinction bites: a reset time that is already past rolls forward a full day, and a session
  21: # limit is not the same thing as being out of credit. **The caller MUST re-read the gauge on its
  22: # first turn after this exits** - that turn renders the status line, so it is the first genuinely
  23: # fresh reading available - and park again if it still says PAUSE.
  24: #
  25: # Exit 0: the window should be open, go and confirm. Exit 1: gave up (see -MaxHours), which is a
  26: # report to the founder, never a licence to carry on regardless.
  27: 
  28: [CmdletBinding()]
  29: param(
  30:     # How often to look. A parked session is spending nothing, so there is no reason to poll
  31:     # hard; a minute is far below the resolution of a five-hour window.
  32:     [int]$PollSeconds = 60,
  33: 
  34:     # Refuse to wait longer than this. A five-hour window cannot need more, so exceeding it means
  35:     # the blocking window is a WEEKLY one - days away, which is a founder decision about what to
  36:     # do next, not something a script should sit through silently.
  37:     [double]$MaxHours = 6,
  38: 
  39:     # Passed through, so a caller testing the mechanism can move the line without editing code.
  40:     [int]$PauseAt = 90,
  41: 
  42:     # Passed through: exercise the park against a synthetic snapshot, spending nothing.
  43:     [string]$SnapshotPath = '',
  44: 
  45:     # Grace past the stated reset before releasing. A reset is a boundary the provider crosses,
  46:     # not an instant we control, so releasing on the exact second risks arriving early. Only the
  47:     # simulation sets this to zero, to cross a boundary in seconds instead of a minute.
  48:     [double]$SlackMinutes = 1
  49: )
  50: 
  51: $ErrorActionPreference = 'SilentlyContinue'
  52: $gauge = Join-Path $PSScriptRoot 'window-gauge.ps1'
  53: 
  54: function Read-Gauge {
  55:     try {
  56:         $a = @('-NoProfile','-ExecutionPolicy','Bypass','-File',$gauge,'-Json','-PauseAt',$PauseAt)
  57:         if ($SnapshotPath) { $a += @('-SnapshotPath', $SnapshotPath) }
  58:         $raw = & powershell @a
  59:         return ($raw | ConvertFrom-Json)
  60:     } catch { return $null }
  61: }
  62: 
  63: $started  = Get-Date
  64: $deadline = $started.AddHours($MaxHours)
  65: 
  66: $g = Read-Gauge
  67: if (-not $g) {
  68:     Write-Output 'WAIT  abandoned - the gauge could not be read at all'
  69:     exit 1
  70: }
  71: 
  72: if ($g.verdict -eq 'OK') {
  73:     Write-Output ("WAIT  nothing to wait for - " + $g.reason)
  74:     exit 0
  75: }
  76: 
  77: # The target comes from the provider's own statement of when this window resets. A minute of
  78: # slack because the reset is a boundary, not an instant we control.
  79: $target = $null
  80: if ($g.resetsAtUtc) { try { $target = ([datetime]::Parse($g.resetsAtUtc)).ToUniversalTime().AddMinutes($SlackMinutes) } catch { } }
  81: if (-not $target) {
  82:     Write-Output 'WAIT  abandoned - no reset time in the reading, so there is nothing to wait for'
  83:     exit 1
  84: }
  85: 
  86: Write-Output ("WAIT  parked on {0} at {1}% - reset stated for {2} local" -f `
  87:     $g.worstWindow, $g.worstPercent, ([datetime]$target).ToLocalTime().ToString('HH:mm'))
  88: 
  89: $lastSaid = Get-Date
  90: while ($true) {
  91:     $now = (Get-Date).ToUniversalTime()
  92: 
  93:     if ($now -ge $target) {
  94:         Write-Output 'WAIT  the stated reset time has passed - re-read the gauge before releasing work'
  95:         exit 0
  96:     }
  97: 
  98:     if ((Get-Date) -ge $deadline) {
  99:         Write-Output ("WAIT  gave up after {0}h - the blocking window is {1}, which resets {2} local. This is a founder decision, not something to wait out." -f `
 100:             $MaxHours, $g.worstWindow, ([datetime]$target).ToLocalTime().ToString('ddd HH:mm'))
 101:         exit 1
 102:     }
 103: 
 104:     # Another session in the account may have rendered its status line, which refreshes the shared
 105:     # snapshot. If it now reads clear, there is no reason to keep sitting here.
 106:     $fresh = Read-Gauge
 107:     if ($fresh -and $fresh.verdict -eq 'OK') {
 108:         Write-Output ("WAIT  cleared early - " + $fresh.reason)
 109:         exit 0
 110:     }
 111: 
 112:     # Say something every ten minutes. Silence and progress look identical, and a wait that never
 113:     # speaks is indistinguishable from a wait that died.
 114:     if (((Get-Date) - $lastSaid).TotalMinutes -ge 10) {
 115:         $left = [int]([math]::Ceiling(($target - $now).TotalMinutes))
 116:         Write-Output ("WAIT  still parked - about {0} min to the stated reset" -f $left)
 117:         $lastSaid = Get-Date
 118:     }
 119: 
 120:     Start-Sleep -Seconds $PollSeconds
 121: }

