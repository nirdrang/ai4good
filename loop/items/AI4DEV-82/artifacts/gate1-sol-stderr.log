  26: [CmdletBinding()]
  27: param(
  28:     # PAUSE line - founder's number (2026-08-06): stop work at 90 percent of a window.
  29:     [int]$PauseAt = 90,
  30: 
  31:     # There is deliberately NO second, lower line (founder 2026-08-06). A "start nothing new"
  32:     # band would have to be justified by the cost of a sitting, which nobody has measured, so it
  33:     # could only ever be a number that felt safe. One line, and a sitting that meets it mid-flight
  34:     # parks at its last committed work item - the per-work-item commits are the recovery.
  35: 
  36:     # Older than this and the gauge admits it cannot see, rather than reporting a stale number as
  37:     # if it were current.
  38:     [int]$StaleMinutes = 15,
  39: 
  40:     # Emit the machine shape instead of the human lines.
  41:     [switch]$Json,
  42: 
  43:     # Read a different snapshot. Exists so the mechanism can be exercised end to end against
  44:     # synthetic readings without spending a single token, and without disturbing the live file
  45:     # the status line is writing. Defaults to the real one, so no caller has to know.
  46:     [string]$SnapshotPath = '',
  47: 
  48:     # Exit 0 only when work may proceed (verdict OK). For use as a wait condition: the coordinator
  49:     # parks and polls this until it succeeds, rather than sleeping on a computed duration - the
  50:     # window is authoritative about its own reset, our arithmetic is not.
  51:     [switch]$ExitOnReady
