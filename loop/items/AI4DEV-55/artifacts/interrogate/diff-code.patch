+    } finally {
+      globalThis.fetch = original;
+    }
+  });
+
+  it('functionPostRaw returns the raw text and sends the anon key when bearer is null', async () => {
+    const original = globalThis.fetch;
+    try {
+      const { calls } = captureFetch();
