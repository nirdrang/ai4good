  263:  * body below may take one from here. The account id is a different kind of fact and is
  264:  * LIVE-FAITHFUL â€” a registered, unconfirmed user exists on the real stack and has an id there, and
  265:  * an operator reading `auth.sessions` needs exactly that id to read anything at all. AT-001.38 uses
===== tests/at/suites/req-001/b-verification-and-sessions.test.ts 260-440 =====
  260:  *
  261:  * IT RETURNS THE ADDRESS AND THE ACCOUNT ID, AND STILL NEVER THE REGISTRATION HANDLE. Withholding
  262:  * the handle is the point: the live stack with confirmations on issues no session at signup, so no
  263:  * body below may take one from here. The account id is a different kind of fact and is
  264:  * LIVE-FAITHFUL â€” a registered, unconfirmed user exists on the real stack and has an id there, and
  265:  * an operator reading `auth.sessions` needs exactly that id to read anything at all. AT-001.38 uses
  266:  * it to count sessions BEFORE the first sign-in, which is what turns "a sign-in mints a session"
  267:  * from a count above zero into a count that grew by one.
  268:  */
  269: const registerAndConfirm = async (
  270:   sut: AccountsSut,
  271:   email: string,
  272:   password: string,
  273: ): Promise<{ email: string; accountId: string }> => {
  274:   const registration = await sut.registerWithEmailPassword(email, password);
  275:   const link = await sut.emailedVerificationLink(email);
  276:   expect(link, `no verification link was emailed to ${email}`).not.toBeNull();
  277:   expect((await sut.useVerificationLink(link!)).ok, 'the emailed verification link was refused').toBe(true);
  278:   return { email, accountId: registration.accountId };
  279: };
