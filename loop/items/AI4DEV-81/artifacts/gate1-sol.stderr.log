    1: /**
    2:  * The ATâ†”code bijection checker â€” `bun run at:check req-0NN`.
    3:  *
    4:  * The code-level sibling of `loop/decomp/check-tree.ps1`: every P0 id in the requirement's
    5:  * acceptance file has exactly one executable test, and no executable test claims an id the
    6:  * acceptance file does not carry. Without it a suite can go green while quietly skipping ids.
    7:  *
    8:  * It reads the `atTest('AT-0NN.MM'` CALL SITES rather than importing the suite: the id is
    9:  * declared at that call site and nowhere else, and a static read needs neither a running
   10:  * test framework nor a harness that has not been built yet.
   11:  */
   12: 
   13: import { readdirSync, readFileSync } from 'node:fs';
   14: import { join } from 'node:path';
   15: 
   16: /**
   17:  * The real checkout this file was loaded from. Where `node_modules` lives, and the default answer
   18:  * for everything below.
   19:  */
   20: export const INSTALL_ROOT = new URL('../../../', import.meta.url).pathname.replace(/^\/([A-Za-z]:)/, '$1');
   21: 
   22: /**
   23:  * The tree the checker, the runner and the harness read acceptance files, suites and fixture
   24:  * adapters from â€” the real checkout unless `AT_REPO_ROOT` says otherwise.
   25:  *
   26:  * WHY THE OVERRIDE EXISTS: the runner's own black-box tests have to feed it whole malformed
   27:  * situations â€” an acceptance file that yields zero P0 ids, a suite claiming an id nothing
   28:  * registers, a test that reports twice â€” and observe the exit code and per-id report it produces.
   29:  * Planting those inside the real repository would mean the runner's tests could damage the tree
   30:  * they are checking. With the override the runner is pointed at a disposable tree that is complete
   31:  * in itself, and the paths it resolves stay consistent between the preflight, the harness and
   32:  * vitest's root.
   33:  *
   34:  * The override moves DATA only: `node_modules` is always resolved from INSTALL_ROOT, so a child
   35:  * still runs the pinned vitest and the pinned Supabase CLI. Unset â€” every ordinary run â€” it
   36:  * changes nothing at all.
   37:  */
   38: export const REPO_ROOT = process.env.AT_REPO_ROOT?.trim() ? process.env.AT_REPO_ROOT.trim() : INSTALL_ROOT;
   39: 
   40: /** `req-016` or `016` â†’ `016`. Throws on anything else. */
   41: export function normalizeRequirement(arg: string): string {
   42:   const m = /^(?:req-)?(\d{3}(?:\.\d+)*)$/.exec(arg ?? '');
   43:   if (!m) throw new Error(`"${arg}" is not a requirement â€” expected req-0NN, e.g. req-016 or req-005.5`);
   44:   return m[1];
   45: }
   46: 
   47: /** Every P0 id in `.taskmaster/docs/acceptance/at-req-0NN.md`, in file order. */
   48: export function acceptanceP0Ids(requirement: string): string[] {
   49:   const file = join(REPO_ROOT, '.taskmaster', 'docs', 'acceptance', `at-req-${requirement}.md`);
   50:   const text = readFileSync(file, 'utf8');
   51:   const escaped = requirement.replace(/\./g, '\\.');
   52:   const pattern = new RegExp(`AT-${escaped}\\.(\\d+[a-z]?)\\*?\\*?\\s*\\(P0\\)`, 'g');
   53:   const ids: string[] = [];
   54:   for (const m of text.matchAll(pattern)) {
   55:     const id = `AT-${requirement}.${m[1]}`;
   56:     if (!ids.includes(id)) ids.push(id);
   57:   }
   58:   return ids;
   59: }
   60: 
   61: export function suiteDir(requirement: string): string {
   62:   return join(REPO_ROOT, 'tests', 'at', 'suites', `req-${requirement}`);
   63: }
   64: 
   65: export interface SuiteRegistration {
   66:   atId: string;
   67:   file: string;
   68: }
   69: 
   70: /** Every `atTest('AT-â€¦'` call site under the requirement's suite directory. */
   71: export function registeredIds(requirement: string): SuiteRegistration[] {
   72:   const dir = suiteDir(requirement);
   73:   const found: SuiteRegistration[] = [];
   74:   for (const entry of readdirSync(dir, { withFileTypes: true })) {
   75:     if (!entry.isFile() || !entry.name.endsWith('.test.ts')) continue;
   76:     const text = readFileSync(join(dir, entry.name), 'utf8');
   77:     for (const m of text.matchAll(/atTest\(\s*['"`](AT-[\d.]+[a-z]?)['"`]/g)) {
   78:       found.push({ atId: m[1], file: entry.name });
   79:     }
   80:   }
   81:   return found;
   82: }
   83: 
   84: export interface BijectionReport {
   85:   expected: string[];
   86:   registered: SuiteRegistration[];
   87:   missing: string[];
   88:   extra: string[];
   89:   duplicate: string[];
   90:   problems: string[];
   91: }
   92: 
   93: export function bijectionProblems(expected: string[], registered: SuiteRegistration[]): string[] {
   94:   const registeredSet = [...new Set(registered.map((entry) => entry.atId))];
   95:   const missing = expected.filter((id) => !registeredSet.includes(id));
   96:   const extra = registeredSet.filter((id) => !expected.includes(id));
   97:   const duplicate = registeredSet.filter((id) => registered.filter((entry) => entry.atId === id).length > 1);
   98:   const problems: string[] = [];
   99:   if (expected.length === 0) problems.push('the acceptance parser found zero P0 ids');
  100:   if (missing.length) problems.push(`${missing.length} missing: ${missing.join(', ')}`);
  101:   if (extra.length) problems.push(`${extra.length} extra: ${extra.join(', ')}`);
  102:   if (duplicate.length) problems.push(`${duplicate.length} duplicated: ${duplicate.join(', ')}`);
  103:   return problems;
  104: }
  105: 
  106: export function inspectBijection(requirement: string): BijectionReport {
  107:   const expected = acceptanceP0Ids(requirement);
  108:   const registered = registeredIds(requirement);
  109:   const registeredSet = [...new Set(registered.map((entry) => entry.atId))];
  110:   const missing = expected.filter((id) => !registeredSet.includes(id));
  111:   const extra = registeredSet.filter((id) => !expected.includes(id));
  112:   const duplicate = registeredSet.filter((id) => registered.filter((entry) => entry.atId === id).length > 1);
  113:   return {
  114:     expected,
  115:     registered,
  116:     missing,
  117:     extra,
  118:     duplicate,
  119:     problems: bijectionProblems(expected, registered),
  120:   };
  121: }
  122: 
  123: function main(argv: string[]): number {
