  598:   if (!harnessModule) {
  599:     throw new AtPending(
  600:       o.atId,
  601:       'harness-missing',
  602:       `AI4DEV-3 capability modules (H2 fixtures/clock, H3 sentinels/faults, H4 oracles, ` +
  603:         `H5 vendor sims) are not in the tree: cannot resolve "${HARNESS_MODULE}" ` +
  604:         `from tests/at/harness (${harnessResolveError})`,
  605:     );
