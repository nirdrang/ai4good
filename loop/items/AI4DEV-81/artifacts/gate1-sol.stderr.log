  315:           # it, and the workflow failed to parse. The warning broke the file by demonstrating
  316:           # itself.
  317:           if ! pr=$(gh api "repos/${REPOSITORY}/pulls/${PR_NUMBER}" --jq '.title + "\n" + (.body // "")'); then
  318:             echo "::error::the pull request's title and body could not be read from the GitHub API â€” the guard does not pass text it could not read"
  319:             exit 1
