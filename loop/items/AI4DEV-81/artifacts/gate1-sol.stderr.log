  491: /* ------------------------------------------------------------------------ teardown accounting */
  492: 
  493: /** One thing a test built and must give back, named so a failure says which one. */
  494: export interface TrackedTeardown {
  495:   /** plain words for the thing being torn down, e.g. `fixture world "req-016/base"` */
  496:   what: string;
  497:   teardown(): Promise<void>;
  498: }
  499: 
  500: export interface TeardownFailure {
  501:   what: string;
  502:   error: unknown;
  503: }
  504: 
  505: function errorText(error: unknown): string {
  506:   return error instanceof Error ? error.message : String(error);
  507: }
  508: 
  509: /**
  510:  * Tear down everything the test built â€” worlds first, then harnesses, last-opened-first within
  511:  * each â€” ATTEMPTING EVERY ONE and collecting the rejections rather than stopping at the first.
  512:  *
  513:  * Attempting all of them is the point: giving up after one rejection leaves the rest of the stack
  514:  * standing, and a frozen clock, an armed fault or a vendor counter that survives into the next id
  515:  * is exactly the cross-test leak the per-test teardown exists to prevent.
  516:  */
  517: export async function drainTeardowns(worlds: TrackedTeardown[], harnesses: TrackedTeardown[]): Promise<TeardownFailure[]> {
  518:   const failures: TeardownFailure[] = [];
  519:   const drain = async (stack: TrackedTeardown[]) => {
  520:     while (stack.length) {
  521:       const entry = stack.pop()!;
  522:       try {
  523:         await entry.teardown();
  524:       } catch (err) {
  525:         failures.push({ what: entry.what, error: err });
  526:       }
  527:     }
  528:   };
  529:   await drain(worlds);
  530:   await drain(harnesses);
  531:   return failures;
  532: }
  533: 
  534: /**
  535:  * One acceptance test's whole lifecycle: run the body, tear everything down, then decide.
  536:  *
  537:  * WHY THE VERDICT LIVES HERE rather than in a `finally` that swallows teardown rejections â€”
  538:  * which is what this used to do: a world whose teardown rejected did NOT release what it holds,
  539:  * so the next id inherits it. Reporting that as green is a false green of the worst kind, because
  540:  * the damage lands on a different test and the report blames the wrong id.
  541:  *
  542:  * When the body already failed, the body's error still wins the report: it is the more specific
  543:  * fact, and a teardown that rejects because the body left the world half-built is a symptom, not
  544:  * the cause. The teardown failures are printed so they are never invisible.
  545:  */
  546: export async function runTrackedTest(
  547:   atId: string,
  548:   run: () => Promise<void>,
  549:   worlds: TrackedTeardown[],
  550:   harnesses: TrackedTeardown[],
  551: ): Promise<void> {
  552:   let bodyFailed = false;
  553:   let bodyError: unknown;
  554:   try {
  555:     await run();
  556:   } catch (err) {
  557:     bodyFailed = true;
  558:     bodyError = err;
  559:   }
  560: 
  561:   const failures = await drainTeardowns(worlds, harnesses);
  562: 
  563:   if (bodyFailed) {
  564:     for (const failure of failures) {
  565:       console.error(`${atId} â€” teardown ALSO failed (${failure.what}): ${errorText(failure.error)}`);
  566:     }
  567:     throw bodyError;
  568:   }
  569: 
  570:   if (failures.length) {
  571:     const summary = failures.map((failure) => `${failure.what}: ${errorText(failure.error)}`).join('; ');
  572:     throw new AggregateError(
  573:       failures.map((failure) => (failure.error instanceof Error ? failure.error : new Error(errorText(failure.error)))),
  574:       `${atId} INVALID â€” the body passed but ${failures.length} teardown${failures.length === 1 ? '' : 's'} failed, ` +
  575:         `so state this test built leaks into the next id: ${summary}`,
  576:     );
  577:   }
  578: }
