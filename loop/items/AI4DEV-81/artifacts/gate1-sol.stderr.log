  396:  * effect of making `EvidenceCapture` a type ALIAS, which declaration merging cannot open.
  397:  */
  398: class EvidenceCaptureImpl<T, Sut = unknown, W extends WorldLike = WorldLike> {
  399:   private result: Promise<T> | null = null;
  400:   private producerAtId = '';
