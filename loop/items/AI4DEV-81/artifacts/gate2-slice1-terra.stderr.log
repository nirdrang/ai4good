 597: interface OpenOptions {
 598:   atId: string;
 599:   requirement: string;
 600:   sutKey: string;
 601:   sutMissing: string;
 602:   fixture: string;
 603:   configOverrides?: ConfigOverrides;
 604: }
 605: 
 606: /**
 607:  * Builds a harness and a world, at the types the HARNESS can actually prove: `sut` is `unknown`
 608:  * (`h.sut[key]` on a concrete `AtHarness`) and `w` is a bare `WorldLike`. It deliberately knows
 609:  * nothing about any suite â€” the narrowing to that suite's derived types happens once, at the end of
 610:  * `open()`, where the comment says exactly what is still taken on trust.
 611:  */
 612: async function openWorld(o: OpenOptions): Promise<{ opened: SeamOpenWorld; harness: AtHarness }> {
 613:   if (TIER === null) throw new AtPending(o.atId, 'tier-unset', tierError(o.requirement));
 614: 
 615:   if (!harnessModule) {
 616:     throw new AtPending(
 617:       o.atId,
 618:       'harness-missing',
 619:       `AI4DEV-3 capability modules (H2 fixtures/clock, H3 sentinels/faults, H4 oracles, ` +
 620:         `H5 vendor sims) are not in the tree: cannot resolve "${HARNESS_MODULE}" ` +
 621:         `from tests/at/harness (${harnessResolveError})`,
 622:     );
 623:   }
 624: 
 625:   const h = await harnessModule.createHarness({
 626:     requirement: `req-${o.requirement}`,
 627:     tier: TIER,
 628:     configOverrides: o.configOverrides,
 629:   });
 630:   // Tracked from here on: every later failure must still tear the harness down.
 631:   try {
 632:     expect(h.tier, `harness built tier "${h.tier}" for a --tier ${TIER} run`).toBe(TIER);
 633: 
 634:     /*
 635:      * TIER SEMANTICS: above `loop`, nothing the suite leans on may be a stand-in. The RULE is
 636:      * unchanged and is not relaxed by one capability. What changed is the SHAPE OF THE REFUSAL.
 637:      *
 638:      * This was a bare `expect(await h.stubbedCapabilities()).toEqual([])`, and the failure it
 639:      * produced fit NEITHER declarable red kind â€” so an integration run of any suite was not merely
 640:      * red, it was UNDECLARABLE, and `--expect` could never be honoured at the tier that is the
 641:      * closing gate. A red nobody can describe exactly is a red nobody understands, which is the
 642:      * doctrine `expected.ts` states and this line contradicted.
 643:      *
 644:      * `CapabilityPending` names the exact stubbed capabilities, which is precisely the
 645:      * `capability-pending` shape a declaration rebuilds and compares from position 0. The gate is if
 646:      * anything STRICTER than before: the names travel into the report, so a declaration has to say
 647:      * WHICH capabilities are still stubbed rather than only that some are.
 648:      *
 649:      * `expect.hasAssertions()` is satisfied by the throw rather than by an assertion, exactly as it
 650:      * is for every `AtPending` body in every suite: a thrown error is the reported failure and the
 651:      * assertion count is not consulted.
 652:      */
 653:     const stubRefusal = aboveLoopStubbedRefusal(TIER, await h.stubbedCapabilities());
 654:     if (stubRefusal) throw stubRefusal;
 655: 
 656:     const sut = h.sut?.[o.sutKey];
 657:     if (!sut) throw new AtPending(o.atId, 'sut-missing', o.sutMissing);
 658: 
 659:     const w = await h.fixtures.world(o.fixture);
 660:     return { opened: { h, w, sut }, harness: h };
 661:   } catch (err) {
 662:     await h.teardown().catch(() => undefined);
 663:     throw err;
 664:   }
 665: }
