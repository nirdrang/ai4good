 883:   it('makes product behavior read the controlled clock, through the canonical assembly', async () => {
 884:     // Through createHarness(), not hand-built parts: the thing worth proving is that the clock the
 885:     // harness HANDS A TEST is the clock the product behaviour behind that harness reads. A clock
 886:     // wired up locally in this file proves that this file can wire a clock.
 887:     const h = await createHarness({ requirement: 'req-016', tier: 'loop' });
 888:     try {
 889:       const cap = h.config.get<number>(GUARD_CAP_KEY);
 890:       const windowMs = h.config.get<number>(GUARD_WINDOW_KEY);
 891:       const world = (await h.fixtures.world('clock-behavior')) as World;
 892:       const sut = h.sut.notifications as NotificationsSut;
 893: 
 894:       await h.clock.freezeAt('2026-07-01T00:00:00.000Z');
 895:       await world.burstThreadComments(cap + 3);
 896:       await sut.drainDeliveries();
 897:       expect(
 898:         await sut.deliveries({ type: 'thread.comment' }),
 899:         'the window guard did not cap the burst at the configured value',
 900:       ).toHaveLength(cap);
 901: 
 902:       // The only thing that changes here is the harness clock. If the guard read wall-clock time
 903:       // instead, nothing would reset and the count would stay at the cap.
 904:       await h.clock.advance(windowMs + 1);
 905:       await world.burstThreadComments(1);
 906:       await sut.drainDeliveries();
 907:       expect(
