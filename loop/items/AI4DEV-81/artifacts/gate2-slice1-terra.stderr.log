 795: 
 796:       await h.faults.processRestart();
 797:       const after = await h.faults.processEpoch();
 798:       await world.fire('payment.failed');
 799:       await sut.drainDeliveries();
 800: 
 801:       // WHAT `_contract.ts` PROMISES ABOUT `deliveredByProcess`: a send that happened after a
 802:       // restart carries a different string than one that happened before it. That is only true if
 803:       // the FIRST send owns the stamp â€” a drain that re-stamps every row it sweeps records the
 804:       // identity of the last drain instead, and the earlier send is retroactively attributed to a
 805:       // process that did not perform it. Nothing else in the tree can tell those two apart:
 806:       // AT-016.07 drains once, after its restart, so it reads the same value either way.
 807:       const sentBefore = (await sut.deliveries({ type: 'payment.succeeded' })).map((d) => d.deliveredByProcess);
 808:       const sentAfter = (await sut.deliveries({ type: 'payment.failed' })).map((d) => d.deliveredByProcess);
