 200: /** Strip anything key-shaped out of text that is about to be printed. */
 201: export function redact(text: string): string {
 202:   return String(text ?? '')
 203:     .replace(/eyJ[A-Za-z0-9_-]{5,}\.[A-Za-z0-9_-]{5,}\.[A-Za-z0-9_-]{5,}/g, '<redacted-jwt>')
 204:     .replace(/\bsb_[a-z]+_[A-Za-z0-9_-]{8,}/g, '<redacted-key>')
 205:     .replace(/(postgres(?:ql)?:\/\/)[^@\s/]+@/gi, '$1<redacted>@')
 206:     .replace(/[A-Za-z0-9_-]{40,}/g, '<redacted-token>');
 207: }
 208: 
 209: /** First non-empty line, redacted and length-capped â€” enough to diagnose, not enough to leak. */
 210: export function diagnostic(text: string | undefined, limit = 400): string {
 211:   const line =
 212:     redact(text ?? '')
 213:       .split('\n')
 214:       .map((l) => l.trim())
 215:       .find((l) => l.length > 0) ?? '';
 216:   return line.length > limit ? `${line.slice(0, limit)}â€¦` : line;
 217: }
