 279:     expect(witnessedCapability('oracles.judge', judge, { tier: 'loop', transport: 'fake' }).provenance).toBe('stand-in');
 280:     expect(witnessedCapability('oracles.judge', judge, { tier: 'integration', transport: 'live' }).provenance).toBe(
