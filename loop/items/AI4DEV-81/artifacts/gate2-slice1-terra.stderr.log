1517: function dockerLines(args: string[]): string[] {
1518:   const res = spawnSync('docker', args, { env: childEnv(), encoding: 'utf8' });
1519:   if (res.error) throw new Error(`docker could not be run (${diagnostic((res.error as Error).message)})`);
1520:   if (res.status !== 0) throw new Error(`\`docker ${args.slice(0, 2).join(' ')}\` exited ${res.status}: ${diagnostic(res.stderr) || '(no error output)'}`);
1521:   return (res.stdout ?? '')
1522:     .split('\n')
1523:     .map((line) => line.trim())
1524:     .filter(Boolean);
1525: }
1526: 
1527: interface DockerSnapshot {
1528:   containers: string[];
1529:   volumes: string[];
1530: }
1531: 
1532: /**
1533:  * A READ-ONLY identity record of the personal stack's docker objects. Only `ps`, `inspect`,
1534:  * `volume ls` and `volume inspect` are used, and only identity fields are recorded: container id,
1535:  * created timestamp, image and port bindings; volume name and CreatedAt. No run state.
1536:  */
1537: function personalDockerSnapshot(personal: string): DockerSnapshot {
1538:   const containerNames = dockerLines(['ps', '-a', '--filter', `name=${personal}`, '--format', '{{.Names}}']).sort();
1539:   const containers = containerNames.length
1540:     ? dockerLines([
1541:         'inspect',
1542:         '--format',
1543:         '{{.Name}} | id {{.Id}} | created {{.Created}} | image {{.Config.Image}} | ports {{json .HostConfig.PortBindings}}',
1544:         ...containerNames,
1545:       ]).sort()
1546:     : [];
1547:   const volumeNames = dockerLines(['volume', 'ls', '--filter', `name=${personal}`, '--format', '{{.Name}}']).sort();
1548:   const volumes = volumeNames.length
1549:     ? dockerLines(['volume', 'inspect', '--format', '{{.Name}} | created {{.CreatedAt}}', ...volumeNames]).sort()
1550:     : [];
1551:   return { containers, volumes };
1552: }
1553: 
1554: function snapshotDifferences(before: DockerSnapshot, after: DockerSnapshot): string[] {
1555:   const differences: string[] = [];
1556:   const pairs = [
1557:     ['container', before.containers, after.containers],
1558:     ['volume', before.volumes, after.volumes],
1559:   ] as const;
1560:   for (const [what, first, second] of pairs) {
1561:     for (const line of first) if (!second.includes(line)) differences.push(`${what} recorded BEFORE and not after: ${line}`);
1562:     for (const line of second) if (!first.includes(line)) differences.push(`${what} recorded AFTER and not before: ${line}`);
1563:   }
1564:   return differences;
1565: }
