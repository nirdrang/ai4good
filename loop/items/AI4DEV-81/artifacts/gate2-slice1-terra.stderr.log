 761:       return;
 762:     }
 763:     if (claims.iss !== 'supabase-demo') problems.push(`${label} was not issued by the local development issuer`);
 764:     if (claims.role !== expectedRole) problems.push(`${label} does not carry the ${expectedRole} role`);
 765:     if (typeof claims.ref === 'string') problems.push(`${label} carries a hosted project reference`);
 766:   };
 767: 
 768:   checkKey('ANON_KEY', status.anonKey, 'anon');
 769:   checkKey('SERVICE_ROLE_KEY', status.serviceRoleKey, 'service_role');
