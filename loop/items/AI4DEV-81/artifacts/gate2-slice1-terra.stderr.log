 456:  * parameters would let a body widen the context it is handed. See `SeamOpenWorld`.
 457:  */
 458: export type EvidenceCapture<T, R extends SuiteId, K extends SutKeyOf<R>> = EvidenceCaptureImpl<T, SutOf<R, K>, WorldOf<R>>;
 459: 
 460: /**
 461:  * `defineEvidenceCapture` was the SECOND door to the seam AI4DEV-31 closes, and closing `bindSuite`
 462:  * alone would have moved the defect rather than removed it: this function handed its producer a
 463:  * full `AtContext<Sut, W>` at whatever types the caller named, so a suite that never called
 464:  * `bindSuite` could still declare a system under test and a world out of nothing and read both green.
 465:  *
 466:  * So it takes the BINDING and derives, exactly as `atTest` does. There is no type argument left to
 467:  * lie with: `SutOf<R, K>` and `WorldOf<R>` come from the adapter registered under `R`.
 468:  *
 469:  * A `const` typed by a call-signature alias, NOT an exported `function` declaration â€” that is not
 470:  * stylistic. Gate 1 measured that an exported function declaration can be given a fresh generic
 471:  * overload through `declare module`, restoring the fabricated type argument, and that type aliases
 472:  * do not protect it. A `const` has no declaration to merge an overload into.
 473:  */
 474: type DefineEvidenceCaptureFn = <T, R extends SuiteId, K extends SutKeyOf<R>>(
 475:   binding: SuiteBinding<R, K>,
 476:   name: string,
 477:   producer: (ctx: AtContext<R, K>) => Promise<T>,
 478: ) => EvidenceCapture<T, R, K>;
 479: 
 480: export const defineEvidenceCapture: DefineEvidenceCaptureFn = (binding, name, producer) =>
 481:   new EvidenceCaptureImpl(name, binding.requirement, producer);
 482: 
 483: export function testUseProblem(opens: number, captures: number): string | null {
 484:   return opens === 0 && captures === 0 ? 'test body never opened a fixture world or consumed trusted captured evidence' : null;
 485: }
 486: 
 487: /**
 488:  * Runs one body and refuses a pass that observed nothing.
 489:  *
 490:  * Still parameterized by SHAPE rather than by `<R, K>`, and that is not an oversight. It is not a
 491:  * door to the seam: it never produces a harness-backed value, so the only context it can be given
 492:  * is one the caller built by hand â€” fabricating a type there is a caller lying to itself about its
 493:  * own object, with no harness claim anywhere in it. Keeping the structural signature is also what
 494:  * lets `conformance.selftest.ts` drive it with a hand-built context, which is the point of the
 495:  * false-green reproduction it appears in.
 496:  */
 497: export async function executeRegisteredBody<Sut, W extends WorldLike>(
 498:   atId: string,
 499:   body: (ctx: SeamContext<Sut, W>) => Promise<void>,
 500:   ctx: SeamContext<Sut, W>,
 501:   usage: Usage,
 502: ): Promise<void> {
 503:   await body(ctx);
 504:   const problem = testUseProblem(usage.opens, usage.captures);
 505:   if (problem) throw new Error(`${atId} INVALID â€” ${problem}`);
 506: }
