 529: 
 530:     /**
 531:      * THE PROVISIONED ADMINISTRATOR â€” the only legal way one exists, because the public path refuses
 532:      * the type.
 533:      *
 534:      * TWO AUTHORITIES, AND THEY ARE DIFFERENT ONES. The auth user is created through
 535:      * `POST /auth/v1/admin/users` with `email_confirm: true`, which is the recipe this repository
 536:      * records and which sends no email. The `public.accounts` row is written as the OPERATOR, over
 537:      * the database connection â€” NOT as the service role, which holds no INSERT on that table by
 538:      * measurement and by decision (migration 20260808120000 grants it `select` only). Provisioning
 539:      * is a narrower authority than the service role, not a wider one, and no running service holds
 540:      * it.
 541:      *
 542:      * IT RETURNS A REAL SESSION, unlike registration: the administrator is created confirmed, so the
 543:      * password grant works immediately and the handle this returns is one the live stack issued.
 544:      */
 545:     provisionPlatformAdmin: async (email, password): Promise<Session> => {
 546:       const created = await fetch(`${api}/auth/v1/admin/users`, {
 547:         method: 'POST',
 548:         headers: {
 549:           apikey: slot.serviceRoleKey,
 550:           Authorization: `Bearer ${slot.serviceRoleKey}`,
 551:           'Content-Type': 'application/json',
 552:         },
 553:         body: JSON.stringify({ email, password, email_confirm: true }),
 554:       });
 555:       if (created.status >= 400) throw new Error(`provisioning a platform administrator answered ${created.status}`);
 556:       const user = (await created.json()) as { id?: string };
 557:       const accountId = String(user.id ?? '');
 558:       if (!accountId) throw new Error('the admin user API answered 200 but named no user id');
 559:       await sql`insert into public.accounts (id, account_type) values (${accountId}::uuid, 'platform_admin')`;
 560: 
 561:       const signedIn = await authPost('/auth/v1/token?grant_type=password', { email, password });
 562:       const accessToken = String(signedIn.json.access_token ?? '');
 563:       if (!accessToken) throw new Error('a provisioned platform administrator could not sign in');
 564:       const sessionId = sessionIdOf(accessToken);
 565:       sessions.set(sessionId, { accessToken, refreshToken: String(signedIn.json.refresh_token ?? '') });
 566:       return { accountId, email, provider: 'email', sessionId };
 567:     },
 568: 
 569:     /* ------------------------------- the members this adapter does NOT back are absent on purpose */
 570:     //
 571:     // They are not written here as throwing stubs, and that is structural rather than stylistic: the
 572:     // harness's `pendingMethodProxy` supplies them, so the refusal text, the capability name and the
 573:     // declaration shape all come from ONE place. A hand-written stub here would be a second copy of
 574:     // a rule, which is how two copies come to disagree.
 575:   } as AccountsSut;
 576: 
 577:   /**
 578:    * A FIXTURE WORLD, against a database this run rebuilt from empty.
 579:    *
 580:    * There is nothing to tear down per world: `prepare()` resets the slot before the run, so a world
 581:    * is a namespace for addresses rather than a container of state. The namespace still matters â€”
