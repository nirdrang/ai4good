 237: /** One vote's answer to one criterion, after the local re-validation above. */
 238: export type JudgeAnswer =
 239:   | { criterionId: string; kind: 'semantic'; holds: boolean; evidence: string }
 240:   | { criterionId: string; kind: 'extraction'; value: number; evidence: string };
