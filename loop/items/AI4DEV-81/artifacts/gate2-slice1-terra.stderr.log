 516:     /**
 517:      * THE SHIPPED SQL PREDICATE, called as the predicate rather than reproduced as a query.
 518:      *
 519:      * `_fixture.ts`'s own comment says what a loop-tier green over this does NOT establish: it
 520:      * reaches the adapter's storage query, so `public.has_platform_acknowledgment` could return true
 521:      * unconditionally and the loop tier would not notice. This call is what notices.
 522:      */
 523:     hasPlatformAcknowledgment: async (accountId) => {
 524:       const found = await rows<{ held: boolean }>(
 525:         sql`select public.has_platform_acknowledgment(${accountId}::uuid) as held`,
 526:       );
