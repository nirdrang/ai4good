 385: /**
 386:  * THE ONE NON-IDENTITY SETTING every generated config carries, so a synthetic source in these tests
 387:  * is a source `generateSlotConfig` will accept. The generator FAILS CLOSED on an absent
 388:  * `[auth] jwt_expiry` â€” a slot silently running the shipped hour-long expiry would make the two
 389:  * session bodies hang rather than fail â€” so a fixture without it is not a smaller case, it is an
 390:  * invalid one.
 391:  */
 392: const SYNTHETIC_AUTH = '[auth]\njwt_expiry = 3600\n';
 393: 
 394: describe('the identity overlay moves the identity and nothing else', () => {
 395:   it('changes exactly the project id, the listener ports and the standing session lifetime, byte for byte elsewhere', () => {
 396:     const generated = generateSlotConfig(REPO_CONFIG, 1);
 397:     const source = REPO_CONFIG.split('\n');
 398:     const slot = generated.split('\n');
 399:     expect(slot.length, 'the overlay changed the number of lines').toBe(source.length);
 400: 
 401:     const changed = source.map((line, index) => (line === slot[index] ? -1 : index)).filter((index) => index >= 0);
 402:     const { mappings } = portMappings(REPO_CONFIG, 1);
 403:     // ONE MORE THAN THE IDENTITY FIELDS, and exactly one: the project id, every mapped listener
 404:     // port, and the standing `auth.jwt_expiry`. This count is the assertion that the permitted
 405:     // transform set did not grow again â€” a second non-identity edit fails here, naming its line.
 406:     expect(changed.length, 'the overlay changed lines that are neither identity fields nor the standing session lifetime').toBe(
 407:       mappings.length + 2,
 408:     );
 409: 
 410:     for (const mapping of mappings) {
 411:       expect(changed, `[${mapping.section}] ${mapping.key} was not rewritten`).toContain(mapping.line);
 412:       expect(slot[mapping.line]).toContain(String(mapping.to));
 413:     }
 414:     expect(generated).toContain(`project_id = "${slotProjectId(1)}"`);
 415: 
 416:     // THE STANDING LOW SESSION LIFETIME (D12). It is a value the slot runs permanently, not a
 417:     // transient override a test makes and restores: there is nothing to restore, so there is nothing
 418:     // to prove restored. The value is measured rather than chosen â€” the running GoTrue issues tokens
 419:     // with `expires_in` equal to it â€” and this item's verify-first record carries the reading.
 420:     expect(generated).toContain(`jwt_expiry = ${SLOT_JWT_EXPIRY_SECONDS}`);
 421:     expect(generated, 'the shipped hour-long expiry survived into the slot config').not.toMatch(/^\s*jwt_expiry\s*=\s*3600/m);
 422:     const expiryLine = source.findIndex((line) => /^\s*jwt_expiry\s*=/.test(line));
 423:     expect(changed, 'the jwt_expiry line was not the line that changed').toContain(expiryLine);
 424:   });
 425: 
 426:   it('refuses to generate a slot config from a source carrying no active [auth] jwt_expiry', () => {
 427:     // FAIL CLOSED, and this is the test that says why. A generator that quietly skipped the
 428:     // transform would hand back a config the CLI accepts and the stack starts â€” running the shipped
 429:     // hour-long expiry while every declaration downstream assumed two minutes. The two session
 430:     // bodies would then WAIT rather than fail, which is the worst shape of failure to diagnose.
 431:     expect(() => generateSlotConfig('project_id = "demo"\n[api]\nport = 54321\n', 1)).toThrow(/no active \[auth\] jwt_expiry/);
 432:     // A COMMENTED setting is not an active one, and `scanConfig` already knows the difference.
 433:     expect(() => generateSlotConfig('project_id = "demo"\n[auth]\n# jwt_expiry = 3600\n', 1)).toThrow(/no active \[auth\] jwt_expiry/);
