 264:     const badTransport = () => witnessedCapability('oracles.judge', judge, { tier: 'integration', transport: 'bogus' });
 265:     expect(badTransport, 'an unrecognised TRANSPORT brand was accepted and given a real verdict').toThrow(
 266:       /TRANSPORT axis was given "bogus"/,
