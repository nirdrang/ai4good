 298: /**
 299:  * AT-001.09 â€” email verification, PARAMETERIZED OVER BOTH email-capable account types.
 300:  *
 301:  * Gate 1's finding 8 is what makes this body cover two types rather than one: the criterion says
 302:  * "EITHER account type â€¦ (NGO and volunteer)" and carries the acceptance file's own
 303:  * "parameterized over account types" note, and the migrated NGO-only set proved half of it.
 304:  *
 305:  * WHAT IS LIVE HERE: the message is the one GoTrue really sent, held by the slot's own mail catcher;
 306:  * the link is followed by HTTP; and the verified fact is judged by the SHIPPED extractor over the
 307:  * real row rather than read as a boolean.
 308:  */
 309: export async function at00109(ctx: Ctx): Promise<void> {
 310:   const { w, sut } = await ctx.open();
 311: 
 312:   for (const kind of ['ngo', 'volunteer'] as const) {
 313:     const email = w.email(`${kind}-verify`);
 314:     const registered = await sut.registerWithEmailPassword(email, PASSWORD);
 315:     expect(registered.sessionId, 'the live registration issued a session, which under confirmations it must not').toBe('');
 316: 
 317:     // UNVERIFIED FIRST, and it must DISCRIMINATE: an extractor that answered true unconditionally
 318:     // would satisfy every assertion after the link is used.
 319:     expect(
 320:       await sut.emailVerified(registered.accountId),
 321:       `a fresh ${kind} registration is already reported verified â€” nothing below would then mean anything`,
 322:     ).toBe(false);
 323: 
 324:     // Auth itself refuses sign-in before confirmation, which is the state the criterion describes.
 325:     const early = await sut.signInWithEmailPassword(email, PASSWORD);
 326:     expect(early.ok, `an unconfirmed ${kind} account signed in`).toBe(false);
 327: 
 328:     const link = await sut.emailedVerificationLink(email);
 329:     expect(link, `no confirmation email reached the slot's mail catcher for the ${kind} address`).not.toBeNull();
 330: 
 331:     const used = await sut.useVerificationLink(link!);
 332:     expect(used.ok, `following the emailed ${kind} confirmation link was refused`).toBe(true);
 333:     expect(
 334:       await sut.emailVerified(registered.accountId),
 335:       `using the emailed link did not flip the ${kind} account to verified`,
 336:     ).toBe(true);
 337: 
 338:     const after = await sut.signInWithEmailPassword(email, PASSWORD);
 339:     expect(after, `a confirmed ${kind} account could not sign in`).toMatchObject({ ok: true });
 340:   }
 341: }
