 219: /* ------------------------------------------------------------------------ config.toml reading */
 220: 
 221: export interface LocalConfig {
 222:   projectId: string;
 223:   apiPort: number;
 224:   dbPort: number;
 225: }
 226: 
 227: /**
 228:  * Ports and project id come from `supabase/config.toml` â€” never guessed, never hard-coded.
 229:  *
 230:  * The root is a parameter so the database-slot pool can read a SLOT's own config with this exact
 231:  * scanner instead of a second copy of it. Unset â€” every ordinary run â€” it reads the repo tree, so
 232:  * the loop and integration call sites behave as they did before the parameter existed.
 233:  */
 234: export function readLocalConfig(root: string = REPO_ROOT): LocalConfig {
 235:   const file = join(root, 'supabase', 'config.toml');
 236:   const text = readFileSync(file, 'utf8');
 237:   let section = '';
 238:   let projectId = '';
 239:   let apiPort = 0;
 240:   let dbPort = 0;
 241: 
 242:   for (const raw of text.split('\n')) {
 243:     const line = raw.trim();
 244:     const header = /^\[([^\]]+)\]/.exec(line);
 245:     if (header) {
 246:       section = header[1];
 247:       continue;
 248:     }
 249:     const port = /^port\s*=\s*(\d+)/.exec(line);
 250:     if (section === '' && /^project_id\s*=/.test(line)) projectId = /"([^"]+)"/.exec(line)?.[1] ?? '';
 251:     else if (section === 'api' && port && !apiPort) apiPort = Number(port[1]);
 252:     else if (section === 'db' && port && !dbPort) dbPort = Number(port[1]);
 253:   }
 254: 
 255:   const missing = [projectId ? '' : 'project_id', apiPort ? '' : '[api] port', dbPort ? '' : '[db] port'].filter(Boolean);
 256:   if (missing.length) throw new Error(`${file} is missing ${missing.join(' and ')}`);
 257:   return { projectId, apiPort, dbPort };
 258: }
