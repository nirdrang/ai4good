  26: 
  27: /* ------------------------------------------------------------------------ the AT id grammar */
  28: 
  29: /**
  30:  * `AT-<requirement>.<number>` â€” the FINAL dot-segment is the test number and everything
  31:  * between `AT-` and it is the requirement id, because requirement ids may themselves carry a
  32:  * dot suffix (`005.5` is a real requirement, so `AT-005.5.03` is a real id).
  33:  */
  34: const AT_ID = /^AT-(\d{3}(?:\.\d+)*)\.(\d+[a-z]?)$/;
