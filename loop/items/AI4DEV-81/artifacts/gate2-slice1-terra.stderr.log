 951: /** `atTest`, with the binding already applied â€” so bodies say `atTest(id, title, body)`. */
 952: type BoundAtTest<R extends SuiteId, K extends SutKeyOf<R>> = {
 953:   (atId: string, title: string, opts: AtTestOptions, body: AtTestBody<R, K, 'loop'> | AtTestBodies<R, K>): void;
 954:   (atId: string, title: string, body: AtTestBody<R, K, 'loop'> | AtTestBodies<R, K>): void;
 955: };
 956: 
 957: /** `defineEvidenceCapture`, with the binding already applied. */
 958: type BoundDefineEvidenceCapture<R extends SuiteId, K extends SutKeyOf<R>> = <T>(
 959:   name: string,
 960:   producer: (ctx: AtContext<R, K>) => Promise<T>,
 961: ) => EvidenceCapture<T, R, K>;
 962: 
 963: /**
 964:  * A suite's ONE line of harness contact: name the requirement and the system-under-test key, and
 965:  * get back both entry points with the seam types already derived from that suite's adapter.
 966:  *
 967:  * BOTH are returned because both were doors. Closing `atTest` alone would have moved the defect one
 968:  * import along â€” `defineEvidenceCapture` handed its producer the same `AtContext`, so a suite could
 969:  * fabricate a system under test there instead and read it green, and the item would have shipped
 970:  * claiming a closure it did not have.
 971:  *
 972:  * It is the same `atTest` and the same `defineEvidenceCapture` as above: one implementation, not
 973:  * one per suite. And it is a `const`, not an exported `function` declaration, so no suite can merge
 974:  * an extra generic overload onto it through `declare module` and restore the fabricated arguments.
 975:  */
 976: type BindSuiteFn = <R extends SuiteId, K extends SutKeyOf<R>>(
 977:   binding: SuiteBinding<R, K>,
 978: ) => {
 979:   atTest: BoundAtTest<R, K>;
 980:   defineEvidenceCapture: BoundDefineEvidenceCapture<R, K>;
 981: };
 982: 
 983: export const bindSuite: BindSuiteFn = <R extends SuiteId, K extends SutKeyOf<R>>(binding: SuiteBinding<R, K>) => {
 984:   const boundAtTest = (
 985:     atId: string,
 986:     title: string,
 987:     optsOrBody: AtTestOptions | AtTestBody<R, K, 'loop'> | AtTestBodies<R, K>,
 988:     maybeBody?: AtTestBody<R, K, 'loop'> | AtTestBodies<R, K>,
 989:   ): void => {
 990:     // THREE SHAPES ARRIVE HERE and the discriminator is which of them the third argument is: a
 991:     // function is a single body, an options object comes with the body fourth, and a per-tier body
 992:     // MAP is an object too â€” told apart by carrying at least one body-shaped member. A map that
 993:     // names none of them is not silently read as options: `tierBodyProblem` refuses it by name.
 994:     const looksLikeBodies =
 995:       typeof optsOrBody === 'object' &&
 996:       optsOrBody !== null &&
 997:       (['default', ...TIERS] as const).some((key) => typeof (optsOrBody as Record<string, unknown>)[key] === 'function');
 998:     const givenBody = typeof optsOrBody === 'function' || looksLikeBodies;
 999:     const opts: AtTestOptions = givenBody ? {} : (optsOrBody as AtTestOptions);
1000:     const body = (givenBody ? optsOrBody : maybeBody) as AtTestBody<R, K, 'loop'> | AtTestBodies<R, K>;
1001:     atTest<R, K>(atId, title, { ...opts, ...binding }, body);
1002:   };
1003: 
1004:   // Annotated here rather than left to the contextual type from `BindSuiteFn`: inside the object
1005:   // literal the context would supply that alias's own `R`/`K`, which TypeScript treats as unrelated
1006:   // to this implementation's â€” the "two different types with this name exist" rejection. Naming the
1007:   // type against the local parameters is what makes `binding` line up with the call below.
1008:   const boundCapture: BoundDefineEvidenceCapture<R, K> = (name, producer) =>
1009:     defineEvidenceCapture(binding, name, producer);
1010: 
1011:   return {
1012:     atTest: boundAtTest,
1013:     defineEvidenceCapture: boundCapture,
1014:   };
1015: };

