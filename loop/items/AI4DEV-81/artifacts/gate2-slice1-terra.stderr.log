 303: /**
 304:  * The item tree's own config, wearing the slot's identity. Everything that is not an identity
 305:  * field is returned byte for byte, including comments, blank lines and line endings â€” a
 306:  * regenerated config differing anywhere else would mean the slot grades different behaviour from
 307:  * the tree that asked for the run.
 308:  */
 309: /**
 310:  * THE ONE NON-IDENTITY TRANSFORM A SLOT CONFIG CARRIES, and it is a standing value rather than a
 311:  * change anything makes at run time.
 312:  *
 313:  * WHY IT EXISTS. Two acceptance criteria are about what happens when an access token's own lifetime
 314:  * runs out â€” a session expiring, and a client refreshing itself before it does. Against a real
 315:  * GoTrue there is nothing to command: a controlled clock moves the test's notion of time and not the
 316:  * vendor's. The only way to reach the state the criteria describe is to WAIT, and at the shipped
 317:  * `jwt_expiry = 3600` that wait is an hour.
 318:  *
 319:  * WHY IT IS STANDING AND NOT TRANSIENT. The obvious alternative â€” lower the value for one test and
 320:  * put it back â€” has no safe mechanism and no oracle. `prepare()` owns the config mirror, the
 321:  * generated write, the start marker and the restarts, and a test body holds coordinates only: a body
 322:  * editing the repository's file changes nothing in the running slot, a body editing the slot's file
 323:  * breaks the marker discipline, and `git diff supabase/config.toml` measures the wrong object
 324:  * entirely. A standing value has nothing to restore, so there is nothing to prove restored. It rides
 325:  * the machinery that already exists: the generated config differs from the last start's hash, the
 326:  * slot restarts into it, and every run afterwards is identical.
 327:  *
 328:  * WHY 120 SECONDS. Measured, not chosen: the running GoTrue issues tokens with `expires_in=120` and
 329:  * an `exp - iat` of 120 at this value, and supabase-js's auto-refresh rotates about one tick in. Low
 330:  * enough that the two bodies that WANT an expiry wait about two minutes; high enough that no other
 331:  * body in the manifest ever meets one. The evidence is in this item's verify-first record.
 332:  *
 333:  * WHAT IT COSTS, said plainly: a slot grades session lifetime differently from the tree that asked
 334:  * for the run, and every id in the manifest runs under that difference. That is a deliberate,
 335:  * reviewed extension of this generator's permitted transform set â€” the ONLY one â€” and its selftests
 336:  * assert it is the only new difference the generator produces.
 337:  */
 338: export const SLOT_JWT_EXPIRY_SECONDS = 120;
 339: 
 340: export function generateSlotConfig(sourceText: string, slot: number): string {
 341:   assertSlotNumber(slot);
 342:   const { mappings, problems } = portMappings(sourceText, slot);
 343:   if (problems.length) {
 344:     throw new Error(`the slot ${slot} config cannot be generated from this supabase/config.toml â€” ${problems.join('; ')}`);
 345:   }
 346: 
 347:   const entries = scanConfig(sourceText);
 348:   const projectIdEntry = entries.find((entry) => entry.section === '' && entry.key === 'project_id');
 349:   if (!projectIdEntry) throw new Error('supabase/config.toml carries no top-level project_id, so a slot identity cannot be built from it');
 350: 
 351:   // FAIL CLOSED ON AN ABSENT SETTING. A generator that quietly skipped the transform would produce a
 352:   // slot running the shipped hour-long expiry while every declaration downstream assumed two
 353:   // minutes, and the two session bodies would hang rather than fail â€” the worst shape of failure to
 354:   // diagnose. The setting exists in this tree's config; if it ever stops existing, this says so.
 355:   const jwtExpiryEntry = entries.find((entry) => entry.section === 'auth' && entry.key === 'jwt_expiry');
 356:   if (!jwtExpiryEntry) {
 357:     throw new Error(
 358:       'supabase/config.toml carries no active [auth] jwt_expiry, so the slot config cannot pin the standing low ' +
 359:         'session lifetime the integration tier grades against. Add the setting, or change this generator deliberately.',
 360:     );
 361:   }
 362: 
 363:   const lines = sourceText.split('\n');
 364:   lines[projectIdEntry.line] = lines[projectIdEntry.line].replace(/^(\s*project_id\s*=\s*)"[^"]*"/, `$1"${slotProjectId(slot)}"`);
 365:   lines[jwtExpiryEntry.line] = lines[jwtExpiryEntry.line].replace(
 366:     /^(\s*jwt_expiry\s*=\s*)\d(?:_?\d)*/,
 367:     `$1${SLOT_JWT_EXPIRY_SECONDS}`,
 368:   );
 369:   for (const mapping of mappings) {
 370:     // The digits AND any TOML underscores between them, so a value written `54_321` is replaced
 371:     // whole. Replacing only the leading digits would leave the tail of the old value behind.
 372:     const pattern = new RegExp(`^(\\s*${mapping.key}\\s*=\\s*)\\d(?:_?\\d)*`);
 373:     lines[mapping.line] = lines[mapping.line].replace(pattern, `$1${mapping.to}`);
 374:   }
 375:   return lines.join('\n');
 376: }
