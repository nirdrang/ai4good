 538: /**
 539:  * H3's wall, and the reason it is not a formality.
 540:  *
 541:  * The blocks above test the guards AS PURE FUNCTIONS. That is not enough, and this file says so
 542:  * about itself thirty lines up: a problem computed and not acted on is "this tree's own recurring
 543:  * false-green shape". Nothing above proves that `plant`, `at`, `clear` and `processRestart` ever
 544:  * CALL the predicate that would refuse them.
 545:  *
 546:  * And for sentinels the stakes are higher still. `req-016` is the only suite that exists; its one
 547:  * sentinel consumer, `AT-016.01`, throws at `h.static.providerClientImporters()` on line 28 and never
 548:  * reaches `plant()` on line 50, and `scan()` has no caller anywhere in the tree. So a completely
 549:  * NO-OP `Sentinels` would satisfy `at:verify req-016 --tier loop --expect` from end to end. These
 550:  * tests are therefore not supporting evidence for half this capability â€” they are the entire
 551:  * evidence, and every one of them is written so that a no-op fails it.
 552:  *
 553:  * They drive `createHarness()` rather than hand-built parts wherever the real fixture can produce the
 554:  * condition, for the reason the clock test gives: what is worth proving is the object a suite is
 555:  * really handed. Only the two conditions the conforming fixture cannot produce â€” an unchanged epoch,
 556:  * and an adapter offering no seam at all â€” are built from stubs, and each says so where it sits.
 557:  */
 558: describe('the H3 wall: sentinels and fault injection call the guards, and refuse', () => {
 559:   it('plants a usable marker and refuses a blank, a short, a reused and an overlapping value', async () => {
 560:     const h = await createHarness({ requirement: 'req-016', tier: 'loop' });
 561:     try {
 562:       const value = 'conformance/plant/1767225600000';
 563:       const sentinel = await h.sentinels.plant('notification-body', value);
 564:       expect(sentinel.value, 'plant() did not hand back the value it was asked to plant').toBe(value);
 565:       expect(sentinel.id.length, 'the sentinel carries no id, so two plantings are indistinguishable').toBeGreaterThan(0);
 566: 
 567:       // The refusals are the guard's judgement, reached through the implementation rather than
 568:       // called directly: a plant() that computed sentinelValueProblem and ignored it passes every
 569:       // test in the block above and fails all four of these.
 570:       await expect(h.sentinels.plant('notification-body', 'short')).rejects.toThrow(/characters/);
 571:       await expect(h.sentinels.plant('notification-body', '   ')).rejects.toThrow(/non-empty/);
 572:       await expect(h.sentinels.plant('notification-body', value)).rejects.toThrow(/planted before/);
 573: 
 574:       // OVERLAP, through the implementation. `scan()` matches with `body.includes()`, so planting a
 575:       // value that extends a live one would make every body carrying the longer one report the
 576:       // shorter one present as well â€” a sentinel found in a scope no event carried it to.
 577:       await expect(
 578:         h.sentinels.plant('notification-body', `${value}/extended`),
 579:         'a value extending a planted one was accepted, so the scan can report it present off the other one alone',
 580:       ).rejects.toThrow(/overlaps/);
 581:     } finally {
 582:       await h.teardown();
 583:     }
 584:   });
