1137: /**
1138:  * The verdict is NOT "did every row go green". A vitest process can report twelve green
1139:  * assertions and still exit non-zero â€” a global teardown that threw, an unhandled rejection, a
1140:  * worker that died after its last test. Treating that as success is exactly the false green this
1141:  * harness exists to prevent, so the process's own exit is part of the verdict, and a discrepancy
1142:  * between green rows and a non-zero exit is called out rather than smoothed over.
1143:  */
1144: export function runVerdict(rows: IdRow[], unexpected: string[], run: ProcessOutcome): string[] {
1145:   const problems: string[] = [];
1146:   const red = rows.filter((r) => r.status === 'red').length;
1147:   const missing = rows.filter((r) => r.status === 'missing').length;
1148: 
1149:   if (red) problems.push(`${red} id${red === 1 ? '' : 's'} red`);
1150:   if (missing) problems.push(`${missing} id${missing === 1 ? '' : 's'} missing`);
1151:   if (unexpected.length) {
1152:     problems.push(`${unexpected.length} registered id${unexpected.length === 1 ? '' : 's'} not P0 of this requirement`);
1153:   }
1154: 
1155:   if (run.error) {
1156:     const err = run.error as NodeJS.ErrnoException;
1157:     problems.push(`the test process could not be launched (${err.code ?? 'spawn error'}): ${diagnostic(err.message)}`);
1158:   } else if (run.status !== 0) {
1159:     const how = run.status === null ? `was killed by signal ${run.signal}` : `exited ${run.status}`;
1160:     problems.push(
1161:       red || missing
1162:         ? `the test process ${how}`
1163:         : `the test process ${how} even though every id reported green â€” something failed outside the ` +
1164:             `assertions (a teardown, an unhandled rejection, a worker that died). This run is a FAILURE.`,
1165:     );
1166:   }
1167: 
1168:   return problems;
1169: }
