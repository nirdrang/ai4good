 810:       expect(sentAfter.length, 'the post-restart send produced no delivery to attribute').toBeGreaterThan(0);
 811:       expect(
 812:         [...new Set(sentBefore)],
 813:         'a delivery sent BEFORE the restart was re-stamped by the later drain â€” the field reports the last drain, not the process that sent it',
 814:       ).toEqual([before]);
 815:       expect(
 816:         [...new Set(sentAfter)],
 817:         'the post-restart send does not carry the identity the process had when it performed it',
 818:       ).toEqual([after]);
 819:     } finally {
 820:       await h.teardown();
 821:     }
 822:   });
