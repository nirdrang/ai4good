 260: /**
 261:  * AT-001.07 â€” a provisioned platform administrator authenticates and carries the type; the public
 262:  * signup surface offers only the two.
 263:  *
 264:  * THE SECOND CLAUSE IS PROVED DIFFERENTLY HERE, and that difference is the reason this body exists.
 265:  * At loop tier it reads `publicSignupAccountTypes()`, which is a constant a shipped module exports â€”
 266:  * a list is a claim. At this tier the live oracle is a REFUSAL, which is a fact: the DEPLOYED
 267:  * completion path is asked for a `platform_admin` and must refuse it and leave no row behind. That
 268:  * is a strictly stronger oracle, and it is why the constant is not among the methods the live
 269:  * adapter backs.
 270:  */
 271: export async function at00107(ctx: Ctx): Promise<void> {
 272:   const { w, sut } = await ctx.open();
 273: 
 274:   const adminEmail = w.email('platform-admin');
 275:   const provisioned = await sut.provisionPlatformAdmin(adminEmail, PASSWORD);
 276: 
 277:   const signedIn = await sut.signInWithEmailPassword(adminEmail, PASSWORD);
 278:   expect(signedIn, 'the provisioned platform admin could not sign in').toMatchObject({ ok: true });
 279:   if (!signedIn.ok) return;
 280:   expect(signedIn.session.accountId).toBe(provisioned.accountId);
 281:   expect(
 282:     await sut.account(signedIn.session.accountId),
 283:     'the signed-in administrator does not carry the platform_admin global type',
 284:   ).toMatchObject({ accountType: 'platform_admin' });
 285: 
 286:   const visitor = await registerConfirmAndSignIn(sut, w.email('would-be-admin'));
 287:   const escalation = await sut.completeSignup(
 288:     visitor,
 289:     { accountType: 'platform_admin', acknowledgmentTextVersion: TEXT_VERSION },
 290:     CLIENT_IP,
 291:   );
 292:   expect(escalation.ok, 'the DEPLOYED public signup path minted a platform administrator').toBe(false);
 293:   if (escalation.ok) return;
 294:   expect(escalation.reason).toMatch(/platform_admin/);
 295:   expect(await sut.account(visitor.accountId), 'the refused escalation left an account row behind').toBeNull();
 296: }
