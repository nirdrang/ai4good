  80:   AcknowledgmentRow,
  81:   CompleteSignupOutcome,
  82:   CompleteSignupRequest,
  83:   CreateOrganizationOutcome,
  84:   MembershipRow,
  85:   OrganizationRow,
  86:   RefreshSessionOutcome,
  87:   Session,
  88:   SignInOutcome,
  89:   VolunteerProfileRow,
  90:   World,
  91: } from './_contract.ts';
  92: 
  93: /** THE SELF-DECLARATION the loader checks against the requirement it was asked for. */
  94: export const requirement = 'req-001' as const;
  95: 
  96: /**
  97:  * THE CLOSED ENUMERATION. Every name here must exist below as a callable member, and every name NOT
  98:  * here refuses at use. This list IS the integration tier's claim about this suite.
  99:  */
 100: export const backedSutMethods = {
 101:   accounts: [
 102:     'registerWithEmailPassword',
 103:     'signInWithEmailPassword',
 104:     'linkGithubIdentity',
 105:     'signOut',
 106:     'refreshSession',
 107:     'sessionsOf',
 108:     'requestPasswordReset',
