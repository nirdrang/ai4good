 669: /** One authored test body, for the suite bound to requirement `R` and sut key `K`, at tier `T`. */
 670: export type AtTestBody<R extends SuiteId, K extends SutKeyOf<R>, T extends Tier = 'loop'> = (
 671:   ctx: AtContext<R, K, T>,
 672: ) => Promise<void>;
 673: 
 674: /**
 675:  * ONE BODY PER ID PER TIER â€” the per-tier body form.
 676:  *
 677:  * WHY IT EXISTS. Some acceptance criteria are proved by DIFFERENT PROCEDURES at different tiers,
 678:  * proving the same criterion. AT-001.12's expiry arm at loop tier commands a controlled clock
 679:  * forward; at integration there is nothing to command, and the same criterion is proved by waiting
 680:  * out a real access token against a real GoTrue. Writing one body that branched on the tier would put
 681:  * two procedures inside one function with a conditional deciding which claim was being made â€” and a
 682:  * body that reads `if (h.tier === â€¦)` is a body whose green means something different depending on a
 683:  * value the reader has to trace.
 684:  *
 685:  * WHAT DOES NOT FORK. The CRITERION never forks: both bodies carry the same acceptance text in their
 686:  * title, and the id is registered once. What forks is the procedure and, with it, the capabilities
 687:  * the procedure may reach â€” which is what the per-tier context types carry.
 688:  *
 689:  * EVERY TIER MUST BE COVERED, and that is refused rather than defaulted. `analyzeReportedTests()`
 690:  * requires EXACTLY ONE runtime registration and EXACTLY ONE vitest result per expected id; a map
 691:  * that named only `loop` would emit neither at integration, and the id would be reported `missing` â€”
 692:  * a state no declaration can describe. So a map either names every tier or supplies `default` for
 693:  * the ones it does not, and a map that leaves a hole is an error AT THE CALL SITE, where it is
 694:  * written, rather than a missing row three commands later.
 695:  */
 696: export type AtTestBodies<R extends SuiteId, K extends SutKeyOf<R>> = {
 697:   /**
 698:    * The body for every tier this map does not name â€” typed at the LOOP tier, exactly as the
 699:    * single-body form is, because it is the single-body form wearing a key. See `AtTestFn` for why
 700:    * that is the tier the shared shape is written at, and what it does and does not protect.
 701:    */
 702:   default?: AtTestBody<R, K, 'loop'>;
 703:   loop?: AtTestBody<R, K, 'loop'>;
 704:   integration?: AtTestBody<R, K, 'integration'>;
 705:   drill?: AtTestBody<R, K, 'drill'>;
 706: };
 707: 
 708: /**
 709:  * The tier's body, or the problem that means there is none. PURE, so the refusal is unit testable.
 710:  *
 711:  * A bare function is the single-body form and covers every tier â€” every suite in this tree is
 712:  * written that way and none of them changes.
 713:  */
 714: export function tierBodyProblem(bodies: Record<string, unknown>, atId: string): string | null {
 715:   const named = TIERS.filter((tier) => typeof bodies[tier] === 'function');
 716:   if (named.length === 0 && typeof bodies.default !== 'function') {
 717:     return (
 718:       `${atId} was registered with a per-tier body map that names no body at all â€” neither a tier nor a default. ` +
 719:       `One id, one body per tier.`
 720:     );
 721:   }
 722:   const uncovered = TIERS.filter((tier) => typeof bodies[tier] !== 'function');
 723:   if (uncovered.length && typeof bodies.default !== 'function') {
 724:     return (
 725:       `${atId} was registered with a per-tier body map that covers ${named.join(', ')} but not ` +
 726:       `${uncovered.join(', ')}, and supplies no default. An id with no body at a tier reports as MISSING there, ` +
 727:       `which no declaration can describe â€” supply a body for every tier, or a default.`
 728:     );
 729:   }
 730:   return null;
 731: }
 732: 
 733: /**
 734:  * WHICH body a per-tier map supplies for a tier. PURE, so the choice is unit testable without
 735:  * registering anything with vitest.
 736:  *
 737:  * `null` for the tier means the map named a body for a DIFFERENT tier and no default â€” which
 738:  * `tierBodyProblem` refuses before this is ever consulted in the real path. It is returned rather
 739:  * than thrown so the selftest can state the rule positively: a body written for one tier does not
 740:  * run at another.
 741:  */
 742: export function chooseTierBody<B>(bodies: Record<string, B | undefined>, tier: Tier | null): B | null {
 743:   const named = tier === null ? undefined : bodies[tier];
 744:   return named ?? bodies.default ?? bodies.loop ?? null;
 745: }
 746: 
 747: /**
 748:  * THE ABOVE-LOOP STAND-IN REFUSAL, as a value rather than as a statement inside `openWorld`.
 749:  *
 750:  * It is exported and pure for one reason: `expected.ts` rebuilds the text a declared
 751:  * `capability-pending` red must produce, and the ONLY way to know the two agree is to compare them.
 752:  * `live-ledger.selftest.ts` does exactly that, so a wording change on either side breaks a test
 753:  * instead of silently making every integration declaration unmatchable.
 754:  */
 755: export function aboveLoopStubbedRefusal(tier: Tier, stubbed: readonly string[]): CapabilityPending | null {
 756:   if (tier === 'loop' || stubbed.length === 0) return null;
 757:   return new CapabilityPending([...stubbed]);
 758: }
