 241: /**
 242:  * The identity overlay's port rule (ruling E4).
 243:  *
 244:  *   - a LISTENER port (see `LISTENER_PORTS`) in 54000â€“54999 moves by 1000 per slot;
 245:  *     `edge_runtime.inspector_port` set to EXACTLY 8083 moves by 10 per slot, because the ruled
 246:  *     inspector value is 8083 and it is not in that band. Any OTHER inspector value falls to the
 247:  *     generic rule below, so it maps when it is in band and refuses when it is not â€” a +10 applied
 248:  *     to a value nobody ruled is a guess, and D2 forbids guesses.
 249:  *   - a listener port outside those bands REFUSES loudly as unmappable. A guess here is a port
 250:  *     collision with software nobody in this process knows about, so a person decides.
 251:  *   - any OTHER port-valued key passes through unchanged: it addresses somebody else's service and
 252:  *     is data, not identity.
 253:  *   - except that a non-listener port sitting in 54000â€“54999 also REFUSES. It looks exactly like a
 254:  *     local stack port and this rule does not recognise it, and treating an unrecognised local port
 255:  *     as data would hand two slots the same socket. Fail closed, and a person decides.
 256:  *
 257:  * `personalBlockProblems` stays broad over EVERY port key regardless of this rule, so a port in the
 258:  * founder's own block can never reach a slot by being classified as data.
 259:  */
 260: export function portMappings(text: string, slot: number): { mappings: PortMapping[]; problems: string[] } {
 261:   assertSlotNumber(slot);
 262:   const mappings: PortMapping[] = [];
 263:   const problems: string[] = [];
 264: 
 265:   for (const entry of scanConfig(text)) {
 266:     if (!isPortKey(entry.key)) continue;
 267:     // WHOLE TOKEN, never a prefix (ruling A5): `54_321` is 54321 here, not 54.
 268:     const parsed = portValue(entry.value);
 269:     const from = parsed ?? NaN;
 270:     const listener = isListenerPort(entry.section, entry.key);
 271: 
 272:     if (!listener) {
 273:       if (Number.isFinite(from) && from >= MAPPABLE_PORT_LOW && from <= MAPPABLE_PORT_HIGH) {
 274:         problems.push(
 275:           `[${entry.section}] ${entry.key} = ${from} is not a listener port this rule knows, but it sits in the local ` +
 276:             `stack's band ${MAPPABLE_PORT_LOW}â€“${MAPPABLE_PORT_HIGH} â€” decide by hand whether the slot moves it`,
 277:         );
 278:       }
 279:       continue; // a client-connection port is data and travels unchanged
 280:     }
 281: 
 282:     if (parsed === null) {
 283:       problems.push(`[${entry.section}] ${entry.key} = ${entry.value} is not a plain port number, so the slot overlay cannot move it`);
 284:       continue;
 285:     }
 286:     if (entry.section === 'edge_runtime' && entry.key === 'inspector_port' && from === PERSONAL_INSPECTOR_PORT) {
 287:       mappings.push({ section: entry.section, key: entry.key, line: entry.line, from, to: from + slot * 10 });
 288:       continue;
 289:     }
 290:     if (from >= MAPPABLE_PORT_LOW && from <= MAPPABLE_PORT_HIGH) {
 291:       mappings.push({ section: entry.section, key: entry.key, line: entry.line, from, to: from + slot * 1000 });
 292:       continue;
 293:     }
 294:     problems.push(
 295:       `[${entry.section}] ${entry.key} = ${from} is outside ${MAPPABLE_PORT_LOW}â€“${MAPPABLE_PORT_HIGH}, so the slot ` +
 296:         `overlay does not know where to move it â€” decide the slot's port for this setting by hand`,
 297:     );
 298:   }
 299: 
 300:   return { mappings, problems };
 301: }
