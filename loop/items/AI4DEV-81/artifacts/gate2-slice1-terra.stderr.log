 240:         `the witness accepted a ${tier}-tier oracle answering from committed bytes while reporting nothing stubbed`,
 241:       ).toThrow(
 242:         new RegExp(`refusing to construct capability "oracles\\.judge": a ${tier}-tier oracle on a filesystem replay`),
 243:       );
 244:     }
