 366:     emailedPasswordResetLink: async (email) => (await linksFor(email, 'recovery'))[0] ?? null,
 367: 
 368:     completePasswordReset: async (link, newPassword) => {
 369:       // THE FLOW SHAPE IS MEASURED RATHER THAN REMEMBERED. AI4DEV-60's proof found the implicit
 370:       // fragment on this CLI version and recorded that a PKCE code appears on others; following the
 371:       // link and reading what comes back is what keeps this working across either.
 372:       const response = await fetch(link, { redirect: 'manual' });
 373:       const location = response.headers.get('location') ?? '';
 374:       const fragment = location.includes('#') ? location.slice(location.indexOf('#') + 1) : '';
 375:       const accessToken = new URLSearchParams(fragment).get('access_token') ?? '';
 376:       if (!accessToken) return { ok: false };
 377:       const update = await fetch(`${api}/auth/v1/user`, {
 378:         method: 'PUT',
 379:         headers: { apikey: slot.anonKey, Authorization: `Bearer ${accessToken}`, 'Content-Type': 'application/json' },
 380:         body: JSON.stringify({ password: newPassword }),
 381:       });
 382:       return { ok: update.status < 400 };
 383:     },
 384: 
 385:     /**
 386:      * THE VERIFIED FACT, DERIVED BY THE SHIPPED EXTRACTOR â€” never read as a boolean off a column.
 387:      *
 388:      * The row is read with operator authority and rendered as the canonical `/auth/v1/user` shape,
 389:      * and the SHIPPED `emailVerifiedFromUser` judges it. That is the same pattern the loop fixture
 390:      * uses and it exists for the same reason: the extractor the future Discovery route will call
 391:      * sits on the tested path rather than being a function no test ever runs. AI4DEV-59's proof is
 392:      * what binds the RENDERED shape to the real one â€” it fed a real response to the same function.
 393:      */
 394:     emailVerified: async (accountId) => {
 395:       const found = await rows<{ email_confirmed_at: string | null; email: string }>(
 396:         sql`select email, email_confirmed_at from auth.users where id = ${accountId}::uuid`,
 397:       );
 398:       if (found.length !== 1) return false;
 399:       return emailVerifiedFromUser({
 400:         id: accountId,
 401:         email: found[0].email,
 402:         email_confirmed_at: found[0].email_confirmed_at,
 403:       });
 404:     },
 405: 
 406:     emailedVerificationLink: async (email) => (await linksFor(email, 'signup'))[0] ?? null,
 407: 
 408:     useVerificationLink: async (link) => {
 409:       const response = await fetch(link, { redirect: 'manual' });
 410:       // GoTrue answers a 303 to the site URL for a token it issued AND for one it never issued â€” the
 411:       // tampered probe in AI4DEV-59's proof measured that. So the STATUS is not the oracle; the
 412:       // column is, and the body that cares reads `emailVerified` afterwards.
 413:       return { ok: response.status < 400 };
 414:     },
