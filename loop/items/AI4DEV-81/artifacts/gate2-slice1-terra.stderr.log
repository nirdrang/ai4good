 343: /**
 344:  * AT-001.12 â€” access ends when a session expires OR is revoked, and re-authentication is the remedy.
 345:  *
 346:  * TWO ARMS, BOTH AGAINST REAL TIME AND A REAL AUTH.
 347:  *
 348:  *   REVOCATION â€” a scoped logout ends THIS session while a SIBLING session of the same account keeps
 349:  *   working. The sibling is the control that separates "this session ended" from "the account's
 350:  *   access ended", and without it the criterion's remedy clause is untested.
 351:  *
 352:  *   EXPIRY â€” the body WAITS OUT a real access token. There is nothing to command: the slot's config
 353:  *   pins a standing low `jwt_expiry` precisely so this wait is two minutes rather than an hour, and
 354:  *   no test edits configuration or restarts anything. The loop body advances a controlled clock,
 355:  *   which is a different procedure proving the same clause.
 356:  */
 357: export async function at00112(ctx: Ctx): Promise<void> {
 358:   const { w, sut } = await ctx.open();
 359:   const email = w.email('sessions');
 360:   const session = await registerConfirmAndSignIn(sut, email);
 361: 
 362:   const completion = await sut.completeSignup(
 363:     session,
 364:     { accountType: 'ngo', organizationName: 'Riverside Shelter', acknowledgmentTextVersion: TEXT_VERSION },
 365:     CLIENT_IP,
 366:   );
 367:   expect(completion, 'the session under test could not complete signup, so nothing below is about a working session').toMatchObject({
 368:     ok: true,
 369:   });
 370: 
 371:   // A SIBLING SESSION, opened before the logout, standing as the control.
 372:   const sibling = await sut.signInWithEmailPassword(email, PASSWORD);
 373:   expect(sibling, 'a second sign-in for the same account failed').toMatchObject({ ok: true });
 374:   if (!sibling.ok) return;
 375:   const before = await sut.sessionsOf(session.accountId);
 376:   expect(before.length, 'the account does not hold the two sessions this arm needs').toBeGreaterThanOrEqual(2);
 377: 
 378:   await sut.signOut(session);
 379:   const after = await sut.sessionsOf(session.accountId);
 380:   expect(after.map((row) => row.sessionId), 'the signed-out session row is still there').not.toContain(session.sessionId);
 381:   expect(after.map((row) => row.sessionId), 'the scoped logout took the sibling session with it').toContain(sibling.session.sessionId);
 382: 
 383:   // THE REVOKED SESSION CANNOT WRITE. `create-organization` is the write, because no verification
 384:   // gate sits on it â€” so a refusal here is unambiguously the session layer's.
 385:   const revokedWrite = await sut.createOrganization(session, 'Riverside Shelter After Logout');
 386:   expect(revokedWrite.ok, 'a revoked session performed a write').toBe(false);
 387:   expect(await sut.organizationsNamed('Riverside Shelter After Logout'), 'the revoked write happened anyway').toEqual([]);
 388: 
 389:   // RE-AUTHENTICATION IS THE REMEDY, not a wall: a fresh sign-in works at once.
 390:   const again = await sut.signInWithEmailPassword(email, PASSWORD);
 391:   expect(again, 're-authentication after revocation was refused, so revocation ended the account rather than the session').toMatchObject(
 392:     { ok: true },
 393:   );
 394:   if (!again.ok) return;
 395: 
 396:   // THE EXPIRY ARM. Wait past the slot's standing token lifetime and assert the same write is
 397:   // refused â€” with the margin on the far side, so a token that is merely close to expiry is not
 398:   // mistaken for one that has passed it.
 399:   await wait(SLOT_JWT_EXPIRY_MS + 15_000);
 400:   const expiredWrite = await sut.createOrganization(again.session, 'Riverside Shelter After Expiry');
 401:   expect(expiredWrite.ok, 'an expired access token performed a write').toBe(false);
 402:   expect(await sut.organizationsNamed('Riverside Shelter After Expiry'), 'the expired write happened anyway').toEqual([]);
 403: 
 404:   // And the refresh token re-establishes access with NO credentials â€” which is what makes expiry a
 405:   // pause rather than a logout, and is the mechanism AT-001.13 builds its own claim on.
 406:   const refreshed = await sut.refreshSession(again.session);
 407:   expect(refreshed, 'the same session could not be refreshed after its access token expired').toMatchObject({ ok: true });
 408:   if (!refreshed.ok) return;
 409:   const afterRefresh = await sut.createOrganization(refreshed.session, 'Riverside Shelter After Refresh');
 410:   expect(afterRefresh, 'a refreshed session still could not write').toMatchObject({ ok: true });
 411: }
 412: 
 413: /**
 414:  * AT-001.13 â€” the session refreshes AUTOMATICALLY, with no forced re-login mid-work.
 415:  *
 416:  * GATE 1'S FINDING 7 IS WHY THIS BODY LOOKS DIFFERENT FROM EVERY OTHER ONE HERE. The criterion's
 417:  * word is "automatically", and every existing piece of evidence proves the MECHANISM: the loop body
 418:  * calls `refreshSession` explicitly, and the live proof transcript says in its own words that it
 419:  * establishes nothing about scheduling. A mechanism-only green at the tier whose meaning is "proved
 420:  * for real" would be a new overclaim.
 421:  *
 422:  * SO THE THING UNDER TEST IS A REAL CLIENT â€” supabase-js with `autoRefreshToken: true` â€” and the
 423:  * observable is a rotation NOBODY ASKED FOR: the access token the client holds changes while the
 424:  * body only waits, and access continues afterwards. No `refreshSession` call appears below.
 425:  *
 426:  * WHY THE COORDINATES COME FROM THE ENVIRONMENT rather than through the system under test: the thing
 427:  * under test is a CLIENT LIBRARY, not a product surface, and this repository ships no client. The
 428:  * runner validated those coordinates, attested them, and put them in this child's environment; a
 429:  * system-under-test method wrapping the client would be this suite building the very thing it is
 430:  * supposed to be observing.
 431:  */
 432: export async function at00113(ctx: Ctx): Promise<void> {
 433:   const { w, sut } = await ctx.open();
 434:   const email = w.email('auto-refresh');
 435:   await registerConfirmAndSignIn(sut, email);
 436: 
 437:   const url = process.env.AT_SUPABASE_URL ?? '';
 438:   const anonKey = process.env.AT_SUPABASE_ANON_KEY ?? '';
 439:   expect(url && anonKey, 'this child holds no slot coordinates, so no real client can be built').toBeTruthy();
 440: 
 441:   const client = await realClient(url, anonKey);
 442:   try {
 443:     const signedIn = await client.auth.signInWithPassword({ email, password: PASSWORD });
 444:     expect(signedIn.error, 'the real client could not sign in against the slot').toBeNull();
 445:     const first = signedIn.data.session?.access_token ?? '';
 446:     expect(first, 'the real client signed in with no access token').not.toBe('');
 447: 
 448:     // WAIT, AND ONLY WAIT. The client's own scheduler is the thing under test, so the body issues no
 449:     // refresh of any kind. The budget is the token's whole lifetime plus a margin: the client
 450:     // rotates about one tick in, well before expiry, and a body that waited less than the lifetime
 451:     // could pass by luck.
 452:     const deadline = Date.now() + SLOT_JWT_EXPIRY_MS + 30_000;
 453:     let rotated = '';
 454:     while (Date.now() < deadline && !rotated) {
 455:       await wait(5_000);
 456:       const current = (await client.auth.getSession()).data.session?.access_token ?? '';
 457:       if (current && current !== first) rotated = current;
 458:     }
 459:     expect(rotated, 'the client never rotated its access token on its own â€” automatic refresh is unproved').not.toBe('');
 460: 
 461:     // "WITHOUT FORCED RE-LOGIN MID-WORK": the work continues, with no credentials supplied anywhere.
 462:     const me = await fetch(`${url.replace(/\/$/, '')}/auth/v1/user`, {
 463:       headers: { apikey: anonKey, Authorization: `Bearer ${rotated}` },
 464:     });
 465:     expect(me.status, 'the automatically rotated token does not carry access').toBe(200);
 466: 
 467:     // AND THE ACCOUNT IS THE SAME ONE, so the rotation extended this user's work rather than
 468:     // silently starting somebody else's.
 469:     const account = await sut.account((await client.auth.getUser()).data.user?.id ?? '');
 470:     expect(account === null || account.id.length > 0, 'the rotated session resolved to no readable account').toBe(true);
 471:   } finally {
 472:     await client.auth.stopAutoRefresh().catch(() => undefined);
 473:   }
 474: }
 475: 
 476: /**
 477:  * AT-001.14 â€” the emailed reset flow changes the password: the new one works and the old one does
 478:  * not.
 479:  *
 480:  * The link is the one GoTrue really sent, held by the slot's own catcher, and its flow shape is read
