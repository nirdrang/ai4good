 760: function emitRuntimeRegistration(registration: Registration): void {
 761:   const dir = process.env.AT_REGISTRATION_DIR;
 762:   if (!dir) return;
 763:   mkdirSync(dir, { recursive: true });
 764:   appendFileSync(join(dir, `registration-${process.pid}.jsonl`), `${JSON.stringify(registration)}\n`, 'utf8');
 765: }
