 508: /* ------------------------------------------------------------------------ teardown accounting */
 509: 
 510: /** One thing a test built and must give back, named so a failure says which one. */
 511: export interface TrackedTeardown {
 512:   /** plain words for the thing being torn down, e.g. `fixture world "req-016/base"` */
 513:   what: string;
 514:   teardown(): Promise<void>;
 515: }
 516: 
 517: export interface TeardownFailure {
 518:   what: string;
 519:   error: unknown;
 520: }
 521: 
 522: function errorText(error: unknown): string {
 523:   return error instanceof Error ? error.message : String(error);
 524: }
 525: 
 526: /**
 527:  * Tear down everything the test built â€” worlds first, then harnesses, last-opened-first within
 528:  * each â€” ATTEMPTING EVERY ONE and collecting the rejections rather than stopping at the first.
 529:  *
 530:  * Attempting all of them is the point: giving up after one rejection leaves the rest of the stack
 531:  * standing, and a frozen clock, an armed fault or a vendor counter that survives into the next id
 532:  * is exactly the cross-test leak the per-test teardown exists to prevent.
 533:  */
 534: export async function drainTeardowns(worlds: TrackedTeardown[], harnesses: TrackedTeardown[]): Promise<TeardownFailure[]> {
 535:   const failures: TeardownFailure[] = [];
 536:   const drain = async (stack: TrackedTeardown[]) => {
 537:     while (stack.length) {
 538:       const entry = stack.pop()!;
 539:       try {
 540:         await entry.teardown();
 541:       } catch (err) {
 542:         failures.push({ what: entry.what, error: err });
 543:       }
 544:     }
 545:   };
 546:   await drain(worlds);
 547:   await drain(harnesses);
 548:   return failures;
 549: }
 550: 
 551: /**
 552:  * One acceptance test's whole lifecycle: run the body, tear everything down, then decide.
 553:  *
 554:  * WHY THE VERDICT LIVES HERE rather than in a `finally` that swallows teardown rejections â€”
 555:  * which is what this used to do: a world whose teardown rejected did NOT release what it holds,
 556:  * so the next id inherits it. Reporting that as green is a false green of the worst kind, because
 557:  * the damage lands on a different test and the report blames the wrong id.
 558:  *
 559:  * When the body already failed, the body's error still wins the report: it is the more specific
 560:  * fact, and a teardown that rejects because the body left the world half-built is a symptom, not
 561:  * the cause. The teardown failures are printed so they are never invisible.
 562:  */
 563: export async function runTrackedTest(
 564:   atId: string,
 565:   run: () => Promise<void>,
 566:   worlds: TrackedTeardown[],
 567:   harnesses: TrackedTeardown[],
 568: ): Promise<void> {
 569:   let bodyFailed = false;
 570:   let bodyError: unknown;
 571:   try {
 572:     await run();
 573:   } catch (err) {
 574:     bodyFailed = true;
 575:     bodyError = err;
 576:   }
 577: 
 578:   const failures = await drainTeardowns(worlds, harnesses);
 579: 
 580:   if (bodyFailed) {
 581:     for (const failure of failures) {
 582:       console.error(`${atId} â€” teardown ALSO failed (${failure.what}): ${errorText(failure.error)}`);
 583:     }
 584:     throw bodyError;
 585:   }
 586: 
 587:   if (failures.length) {
 588:     const summary = failures.map((failure) => `${failure.what}: ${errorText(failure.error)}`).join('; ');
 589:     throw new AggregateError(
 590:       failures.map((failure) => (failure.error instanceof Error ? failure.error : new Error(errorText(failure.error)))),
 591:       `${atId} INVALID â€” the body passed but ${failures.length} teardown${failures.length === 1 ? '' : 's'} failed, ` +
 592:         `so state this test built leaks into the next id: ${summary}`,
 593:     );
 594:   }
 595: }
