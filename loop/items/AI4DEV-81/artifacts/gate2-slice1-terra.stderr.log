  29:  * Any failure in that sequence is an INFRASTRUCTURE failure: non-zero exit, no tests run, a
  30:  * message naming what failed. The runner never falls back to the loop tier's stubs and never
  31:  * runs against a database whose state it could not establish â€” a gate grading a stand-in, or an
  32:  * unknown database, is worse than a gate that refuses to run. Secrets are never printed: raw CLI
  33:  * output is redacted, and validation reports which check failed, never the value that failed it.
  34:  */
  35: 
  36: import { spawn, spawnSync } from 'node:child_process';
  37: import { closeSync, existsSync, mkdirSync, mkdtempSync, openSync, readdirSync, readFileSync, rmSync, writeSync } from 'node:fs';
  38: import { hostname, tmpdir } from 'node:os';
  39: import { join } from 'node:path';
  40: 
  41: import { INSTALL_ROOT, inspectBijection, normalizeRequirement, REPO_ROOT, suiteDir } from './check.ts';
  42: // The cycle with db-pool.ts is deliberate and safe: neither module calls the other at module
  43: // scope, and both sides export hoisted function declarations.
  44: import { evidence, occupy, prepare, stackEnv as slotStackEnv, type Occupancy, type PrepareResult } from './db-pool.ts';
  45: import {
  46:   expectationDeviations,
  47:   expectedManifestPath,
  48:   loadTierExpectation,
  49:   reportAccountingDeviations,
  50:   type TierExpectation,
  51: } from './expected.ts';
  52: 
  53: const TIERS = ['loop', 'integration', 'drill'] as const;
  54: type Tier = (typeof TIERS)[number];
  55: 
  56: const USAGE = 'usage: bun run at:verify req-0NN --tier <loop|integration|drill> [--wired] [--expect]';
  57: 
  58: /** How long the stack gets to become genuinely ready before the run is called off. */
  59: const READY_TIMEOUT_MS = Number(process.env.AT_READY_TIMEOUT_MS ?? 120_000);
  60: /** How long `supabase db reset` gets before it is assumed wedged and its process tree killed. */
  61: const RESET_TIMEOUT_MS = Number(process.env.AT_RESET_TIMEOUT_MS ?? 600_000);
  62: /** A lock older than this, or held by a process that is gone, is taken over. */
  63: const LOCK_STALE_MINUTES = Number(process.env.AT_LOCK_STALE_MINUTES ?? 60);
  64: /** The takeover gate is held for milliseconds; anything this old was abandoned by a dead process. */
  65: const GATE_STALE_MINUTES = Number(process.env.AT_LOCK_GATE_STALE_MINUTES ?? 2);
  66: 
  67: /** `supabase status` reports these two as stopped because config.toml disables them. Benign. */
  68: const DISABLED_SERVICES = /^supabase_(imgproxy|pooler)_/;
  69: 
  70: /**
  71:  * The pinned CLI, invoked directly â€” no shell, no PATH lookup, no globally installed version.
  72:  * Resolved from the INSTALL root, never the (overridable) data root: the pinned versions live in
  73:  * the real checkout's `node_modules` wherever the acceptance files being read happen to be.
  74:  */
  75: const SUPABASE_ENTRY = join(INSTALL_ROOT, 'node_modules', 'supabase', 'dist', 'supabase.js');
  76: 
  77: interface Args {
  78:   requirement: string;
  79:   tier: Tier;
  80:   wired: boolean;
  81:   /** Named `expectDeclared`, not `expect`, so nobody later reads it as vitest's `expect`. */
  82:   expectDeclared: boolean;
  83: }
  84: 
  85: function parseArgs(argv: string[]): Args {
  86:   let requirement = '';
  87:   let tier = '';
  88:   let wired = false;
  89:   let expectDeclared = false;
  90: 
  91:   for (let i = 0; i < argv.length; i++) {
  92:     const arg = argv[i];
  93:     if (arg === '--wired') wired = true;
  94:     else if (arg === '--expect') expectDeclared = true;
  95:     else if (arg === '--tier') tier = argv[++i] ?? '';
  96:     else if (arg.startsWith('--tier=')) tier = arg.slice('--tier='.length);
  97:     else if (arg.startsWith('--')) throw new Error(`unknown option "${arg}"`);
  98:     else if (!requirement) requirement = arg;
  99:     else throw new Error(`unexpected argument "${arg}"`);
 100:   }
 101: 
 102:   if (!requirement) throw new Error('no requirement given');
 103:   if (!tier) throw new Error('--tier is required â€” there is no default tier, by design');
 104:   if (!TIERS.includes(tier as Tier)) throw new Error(`unknown tier "${tier}" â€” expected one of ${TIERS.join('|')}`);
 105:   // Refused here rather than later: `--wired` runs no tests at all, so there would be no report
 106:   // for a declaration to be checked against, and a declaration refusal must never be reported as
 107:   // the wired refusal. A usage error exits 2, which is what a `--expect` command that cannot be
 108:   // honoured is required to do.
 109:   if (wired && expectDeclared) {
 110:     throw new Error('--expect and --wired cannot be combined: --wired runs no tests, so there is no report for a declaration to be checked against');
 111:   }
 112: 
 113:   return { requirement: normalizeRequirement(requirement), tier: tier as Tier, wired, expectDeclared };
 114: }
 115: 
 116: /* --------------------------------------------------------------- the child environment (leak) */
 117: 
 118: /**
 119:  * The ONLY variables a child process inherits. Everything else is dropped.
 120:  *
 121:  * WHY AN ALLOWLIST: bun auto-loads `.env` and `.env.local` into this process, and `.env.example`
 122:  * tells developers to put their real secrets in `.env.local`. Spreading `process.env` into the
 123:  * test process would hand every one of those to every test â€” and a test reading a conventional
 124:  * name like `SUPABASE_SERVICE_ROLE_KEY` would then be pointed at the HOSTED project, which the
 125:  * acceptance suites must never touch. The child gets the platform minimum plus exactly the
 126:  * values this runner validated. Children are additionally launched with bun's `--no-env-file`,
 127:  * so a child does not re-read the env files for itself.
 128:  */
 129: const ENV_ALLOWLIST = [
 130:   // process/platform basics
 131:   'PATH',
 132:   'PATHEXT',
 133:   'COMSPEC',
 134:   'SystemRoot',
 135:   'SystemDrive',
 136:   'windir',
 137:   'OS',
 138:   'NUMBER_OF_PROCESSORS',
 139:   'PROCESSOR_ARCHITECTURE',
 140:   'PROCESSOR_IDENTIFIER',
 141:   'USERNAME',
 142:   'LANG',
 143:   'LC_ALL',
 144:   'TZ',
 145:   // temp + home, which bun, vitest and the Supabase CLI all need in order to write caches
 146:   'TEMP',
 147:   'TMP',
 148:   'TMPDIR',
 149:   'HOME',
 150:   'HOMEDRIVE',
 151:   'HOMEPATH',
 152:   'USERPROFILE',
 153:   'APPDATA',
 154:   'LOCALAPPDATA',
 155:   'PROGRAMDATA',
 156:   'PROGRAMFILES',
 157:   'PROGRAMFILES(X86)',
 158:   'PROGRAMW6432',
 159:   'XDG_CACHE_HOME',
 160:   'BUN_INSTALL',
 161:   // how the Supabase CLI finds the container runtime (never a credential)
 162:   'DOCKER_HOST',
 163:   'DOCKER_CONTEXT',
 164:   'DOCKER_CONFIG',
 165:   'DOCKER_CERT_PATH',
 166: ];
 167: 
 168: /** Windows environment names are case-insensitive, so match that way and keep the parent's casing. */
 169: export function childEnv(extra: Record<string, string> = {}): Record<string, string> {
 170:   const wanted = new Set(ENV_ALLOWLIST.map((name) => name.toLowerCase()));
 171:   const env: Record<string, string> = {};
 172:   for (const [key, value] of Object.entries(process.env)) {
 173:     if (value !== undefined && wanted.has(key.toLowerCase())) env[key] = value;
 174:   }
 175:   return { ...env, ...extra };
 176: }
 177: 
 178: /**
 179:  * The bun binary. Children are launched under bun deliberately â€” `--no-env-file` is a bun flag,
 180:  * and it is what stops a child from re-reading `.env`/`.env.local` for itself. Normally this
 181:  * process IS bun, so its own path is the answer; the PATH lookup only matters when something
 182:  * else (a test runner's node worker, say) is asking.
 183:  */
 184: export function bunExecutable(): string {
 185:   if (/[\\/]bun(\.exe)?$/i.test(process.execPath)) return process.execPath;
 186:   const lookup = spawnSync(process.platform === 'win32' ? 'where' : 'which', ['bun'], {
 187:     encoding: 'utf8',
 188:     env: childEnv(),
 189:   });
 190:   const found = (lookup.stdout ?? '')
 191:     .split('\n')
 192:     .map((line) => line.trim())
 193:     .find(Boolean);
 194:   if (!found) throw new Error('bun was not found on PATH â€” the harness runs its children under bun');
 195:   return found;
 196: }
 197: 
 198: /* --------------------------------------------------------------------------------- redaction */
 199: 
 200: /** Strip anything key-shaped out of text that is about to be printed. */
 201: export function redact(text: string): string {
 202:   return String(text ?? '')
 203:     .replace(/eyJ[A-Za-z0-9_-]{5,}\.[A-Za-z0-9_-]{5,}\.[A-Za-z0-9_-]{5,}/g, '<redacted-jwt>')
 204:     .replace(/\bsb_[a-z]+_[A-Za-z0-9_-]{8,}/g, '<redacted-key>')
 205:     .replace(/(postgres(?:ql)?:\/\/)[^@\s/]+@/gi, '$1<redacted>@')
 206:     .replace(/[A-Za-z0-9_-]{40,}/g, '<redacted-token>');
 207: }
 208: 
 209: /** First non-empty line, redacted and length-capped â€” enough to diagnose, not enough to leak. */
 210: export function diagnostic(text: string | undefined, limit = 400): string {
 211:   const line =
 212:     redact(text ?? '')
 213:       .split('\n')
 214:       .map((l) => l.trim())
 215:       .find((l) => l.length > 0) ?? '';
 216:   return line.length > limit ? `${line.slice(0, limit)}â€¦` : line;
 217: }
 218: 
 219: /* ------------------------------------------------------------------------ config.toml reading */
 220: 
 221: export interface LocalConfig {
 222:   projectId: string;
 223:   apiPort: number;
 224:   dbPort: number;
 225: }
 226: 
 227: /**
 228:  * Ports and project id come from `supabase/config.toml` â€” never guessed, never hard-coded.
 229:  *
 230:  * The root is a parameter so the database-slot pool can read a SLOT's own config with this exact
 231:  * scanner instead of a second copy of it. Unset â€” every ordinary run â€” it reads the repo tree, so
 232:  * the loop and integration call sites behave as they did before the parameter existed.
 233:  */
 234: export function readLocalConfig(root: string = REPO_ROOT): LocalConfig {
 235:   const file = join(root, 'supabase', 'config.toml');
 236:   const text = readFileSync(file, 'utf8');
 237:   let section = '';
 238:   let projectId = '';
 239:   let apiPort = 0;
 240:   let dbPort = 0;
 241: 
 242:   for (const raw of text.split('\n')) {
 243:     const line = raw.trim();
 244:     const header = /^\[([^\]]+)\]/.exec(line);
 245:     if (header) {
 246:       section = header[1];
 247:       continue;
 248:     }
 249:     const port = /^port\s*=\s*(\d+)/.exec(line);
 250:     if (section === '' && /^project_id\s*=/.test(line)) projectId = /"([^"]+)"/.exec(line)?.[1] ?? '';
 251:     else if (section === 'api' && port && !apiPort) apiPort = Number(port[1]);
 252:     else if (section === 'db' && port && !dbPort) dbPort = Number(port[1]);
 253:   }
 254: 
 255:   const missing = [projectId ? '' : 'project_id', apiPort ? '' : '[api] port', dbPort ? '' : '[db] port'].filter(Boolean);
 256:   if (missing.length) throw new Error(`${file} is missing ${missing.join(' and ')}`);
 257:   return { projectId, apiPort, dbPort };
 258: }
 259: 
 260: /* ---------------------------------------------------------------------- the machine-wide lock */
 261: 
 262: export interface StackLock {
 263:   file: string;
 264:   release(): void;
 265: }
 266: 
 267: /**
 268:  * Where the machine-wide claim files live.
 269:  *
 270:  * `AT_LOCK_DIR` overrides it, the same pattern and the same reason as `AT_REPO_ROOT`: a test that
 271:  * exercises the claim protocol must not write into the directory a real run reads, or a selftest
 272:  * and a live `at:verify` could take each other's lock. Unset â€” every ordinary run â€” the answer is
 273:  * unchanged.
 274:  */
 275: function lockDir(): string {
 276:   const override = process.env.AT_LOCK_DIR?.trim();
 277:   const dir = override ? override : join(process.env.LOCALAPPDATA ?? process.env.XDG_CACHE_HOME ?? tmpdir(), 'ai4good-build', 'at-locks');
 278:   mkdirSync(dir, { recursive: true });
 279:   return dir;
 280: }
 281: 
 282: function processIsAlive(pid: number): boolean {
 283:   try {
 284:     process.kill(pid, 0);
 285:     return true;
 286:   } catch (err) {
 287:     // EPERM means it exists but belongs to someone else; ESRCH means it is gone.
 288:     return (err as NodeJS.ErrnoException).code === 'EPERM';
 289:   }
 290: }
 291: 
 292: /** The lock path for one stack. Machine-wide, and deliberately carries no folder component. */
 293: export function stackLockPath(config: LocalConfig): string {
 294:   return join(lockDir(), `at-verify-${config.projectId}-${config.apiPort}.lock`);
 295: }
 296: 
 297: export interface Holder {
 298:   pid?: number;
 299:   host?: string;
 300:   requirement?: string;
 301:   startedAt?: string;
 302:   /** Set only on a claim that replaced a stale one, so the takeover is recorded IN the claim. */
 303:   tookOverFrom?: { pid?: number; startedAt?: string; requirement?: string };
 304: }
 305: 
 306: /**
 307:  * Which holders a caller is allowed to displace.
 308:  *
 309:  * `stale-or-dead` is the runner's own long-standing rule: a dead process, or a live one whose
 310:  * claim is older than `LOCK_STALE_MINUTES`. `dead-pid-only` never displaces a running process at
 311:  * any age â€” the database-slot pool passes it, because a slot's occupancy is ruled to break on a
 312:  * dead holder pid and on nothing else. A run that legitimately lasts longer than the stale window
 313:  * must not have its database reset under it.
 314:  */
 315: export type TakeoverPolicy = 'stale-or-dead' | 'dead-pid-only';
 316: 
 317: export interface StackLockOptions {
 318:   takeover?: TakeoverPolicy;
 319: }
 320: 
 321: /** Live = a holder this policy may not displace. */
 322: function holderIsLive(holder: Holder, policy: TakeoverPolicy = 'stale-or-dead'): boolean {
 323:   if (typeof holder.pid !== 'number' || !processIsAlive(holder.pid)) return false;
 324:   if (policy === 'dead-pid-only') return true;
 325:   const startedAt = holder.startedAt ? Date.parse(holder.startedAt) : NaN;
 326:   const ageMinutes = Number.isFinite(startedAt) ? (Date.now() - startedAt) / 60_000 : Infinity;
 327:   return ageMinutes < LOCK_STALE_MINUTES;
 328: }
 329: 
 330: function heldByAnotherRun(holder: Holder, file: string): Error {
 331:   return new Error(
 332:     `another at:verify run holds this stack (pid ${holder.pid} on ${holder.host ?? 'this machine'}, ` +
 333:       `requirement ${holder.requirement ?? 'unknown'}, started ${holder.startedAt ?? 'unknown'}). ` +
 334:       `Two runs against one stack destroy each other: the second would reset the first's database ` +
 335:       `mid-run. Wait for it to finish. If that process is definitely gone, delete ${file}.`,
 336:   );
 337: }
 338: 
 339: /**
 340:  * A gate left behind by a process that died mid-takeover. The section lasts milliseconds, so
 341:  * anything this old is certainly abandoned; removing one wrongly costs at most two processes in
 342:  * the section, which is the behaviour we had before the gate existed.
 343:  */
 344: function clearStrandedGate(gate: string): void {
 345:   try {
 346:     const held = JSON.parse(readFileSync(gate, 'utf8')) as { pid?: number; at?: string };
 347:     const at = held.at ? Date.parse(held.at) : NaN;
 348:     const ageMinutes = Number.isFinite(at) ? (Date.now() - at) / 60_000 : Infinity;
 349:     const alive = typeof held.pid === 'number' && processIsAlive(held.pid);
 350:     if (!alive || ageMinutes > GATE_STALE_MINUTES) rmSync(gate, { force: true });
 351:   } catch {
 352:     // unreadable or already gone â€” the next pass finds out
 353:   }
 354: }
 355: 
 356: /**
 357:  * Serialize every destructive run against one stack. The key is project id + api port because
 358:  * that pair IS the stack's identity: a second checkout carrying the same `project_id` shares the
 359:  * same Docker containers and the same ports, so its `at:verify` would reset this run's database
 360:  * out from under it. Mirrors `Acquire-WorkLock` in loop/work/work-lib.ps1 â€” exclusive create,
 361:  * holder recorded, stale takeover.
 362:  *
 363:  * TAKEOVER IS THE WHOLE DIFFICULTY. Two processes can both read the same leftover lock and both
 364:  * conclude it is stale; if each then removed it and created its own, the second removal would take
 365:  * out the FIRST one's brand-new live lock and both would run â€” the precise failure this exists to
 366:  * prevent. Moving the stale file aside with an atomic rename does NOT fix that: the winner
 367:  * repopulates the path microseconds later, so the loser's rename succeeds against a LIVE lock,
 368:  * which is just as destructive as unlinking it. (Proved with a two-contender race, not reasoned
 369:  * about; the race is in runner.selftest.ts.)
 370:  *
 371:  * So the takeover DECISION is serialized by a second exclusive-create lock â€” the gate. Only one
 372:  * process is ever inside it, and it re-reads the holder INSIDE, so:
 373:  *   - no other process can be taking over concurrently (the gate is exclusive);
 374:  *   - no ordinary claim can have slipped in, because the stale file occupies the path continuously
 375:  *     until the gate holder removes it, and an exclusive create only succeeds on a free path;
 376:  *   - if a third process wins the claim in the instant after removal, the gate holder's own create
 377:  *     simply fails and it restarts, having deleted nothing further.
 378:  * A gate stranded by a killed process is cleared on age. The section lasts milliseconds, so a live
 379:  * holder never reaches that threshold, and clearing one wrongly degrades to two takers in the
 380:  * section â€” today's behaviour, not worse.
 381:  */
 382: export function acquireStackLock(config: LocalConfig, requirement: string, options: StackLockOptions = {}): StackLock {
 383:   const file = stackLockPath(config);
 384:   const policy: TakeoverPolicy = options.takeover ?? 'stale-or-dead';
 385: 
 386:   const claim = (displaced?: Holder): StackLock | null => {
 387:     let fd: number;
 388:     try {
 389:       fd = openSync(file, 'wx');
 390:     } catch (err) {
 391:       if ((err as NodeJS.ErrnoException).code === 'EEXIST') return null;
 392:       throw err;
 393:     }
 394:     try {
 395:       writeSync(
 396:         fd,
 397:         JSON.stringify({
 398:           pid: process.pid,
 399:           host: hostname(),
 400:           requirement,
 401:           startedAt: new Date().toISOString(),
 402:           // A takeover recorded ONLY on the console is lost the moment the terminal scrolls. The
 403:           // claim file outlives the run that wrote it, so whoever reads it later can see that this
 404:           // occupancy began by displacing an abandoned one, and whose.
 405:           ...(displaced
 406:             ? {
 407:                 tookOverFrom: {
 408:                   pid: displaced.pid,
 409:                   startedAt: displaced.startedAt,
 410:                   requirement: displaced.requirement,
 411:                 },
 412:               }
 413:             : {}),
 414:         }),
 415:       );
 416:     } finally {
 417:       closeSync(fd);
 418:     }
 419:     return {
 420:       file,
 421:       release: () => {
 422:         try {
 423:           const held = JSON.parse(readFileSync(file, 'utf8')) as { pid?: number };
 424:           if (held.pid === process.pid) rmSync(file, { force: true });
 425:         } catch {
 426:           // already removed, or unreadable â€” nothing of ours left to release
 427:         }
 428:       },
 429:     };
 430:   };
 431: 
 432:   const gate = `${file}.takeover`;
 433: 
 434:   /** The recorded holder, or null if the lock is gone. */
 435:   const readHolder = (): Holder | null => {
 436:     try {
 437:       return JSON.parse(readFileSync(file, 'utf8')) as Holder;
 438:     } catch (err) {
 439:       if ((err as NodeJS.ErrnoException).code === 'ENOENT') return null;
 440:       return {}; // unreadable or half-written: treat as an unidentifiable holder, judged below
 441:     }
 442:   };
 443: 
 444:   /** Bounded synchronous pause; a gate is held for milliseconds, so this is all the wait needed. */
 445:   const pause = (ms: number) => {
 446:     const until = Date.now() + ms;
 447:     while (Date.now() < until) {
 448:       /* spin */
 449:     }
 450:   };
 451: 
 452:   /**
 453:    * UNDER `dead-pid-only`, AN UNIDENTIFIABLE HOLDER IS NEVER TAKEOVER-ELIGIBLE.
 454:    *
 455:    * `readHolder` returns `{}` for a file it cannot read or parse, and `holderIsLive({})` is false
 456:    * under every policy â€” so without this guard a claim file that is empty or half written looks
 457:    * exactly like a dead holder and is deleted. The window is real and small: it is the microseconds
 458:    * between `openSync(file, 'wx')` and the `writeSync` that fills the file, so a second occupier
 459:    * arriving in that instant would remove a LIVE process's brand-new claim. That is the one thing
 460:    * this policy exists to make impossible.
 461:    *
 462:    * One bounded re-read skates over the write window. A holder that STILL has no parseable pid is
 463:    * not a dead holder â€” it is a file nobody in this process can account for â€” so it refuses loudly
 464:    * and names the manual repair. `stale-or-dead` keeps its long-standing behaviour: that path
 465:    * predates the slot pool and is another item's business.
 466:    *
 467:    * Returns the identified holder, or null when the file went away and the loop should retry.
 468:    */
 469:   const identified = (holder: Holder, where: string): Holder | null => {
 470:     if (typeof holder.pid === 'number') return holder;
 471:     if (policy !== 'dead-pid-only') return holder;
 472: 
 473:     pause(50);
 474:     const again = readHolder();
 475:     if (again === null) return null; // released while we looked; the loop takes the free path
 476:     if (typeof again.pid === 'number') return again;
 477: 
 478:     throw new Error(
 479:       `refusing to take over the claim at ${file}: it names no process id that this run can read, ` +
 480:         `so it cannot be shown to be dead â€” and a claim file being written right now looks exactly ` +
 481:         `like this. Nothing was taken over. If no run holds that stack, delete ${file} by hand ` +
 482:         `(checked ${where}).`,
 483:     );
 484:   };
 485: 
 486:   // Bounded: every retry follows another process winning the gate, which cannot repeat forever.
 487:   for (let attempt = 0; attempt < 20; attempt++) {
 488:     const claimed = claim();
 489:     if (claimed) return claimed;
 490: 
 491:     const read = readHolder();
 492:     if (read === null) continue; // released between the failed claim and the read
 493:     const holder = identified(read, 'before the takeover gate');
 494:     if (holder === null) continue;
 495:     if (holderIsLive(holder, policy)) throw heldByAnotherRun(holder, file);
 496: 
 497:     // Stale. Enter the takeover gate â€” the only place the live lock path may be removed.
 498:     let gateFd: number;
 499:     try {
 500:       gateFd = openSync(gate, 'wx');
 501:     } catch (err) {
 502:       if ((err as NodeJS.ErrnoException).code !== 'EEXIST') throw err;
 503:       clearStrandedGate(gate);
 504:       pause(10);
 505:       continue;
 506:     }
 507: 
 508:     try {
 509:       writeSync(gateFd, JSON.stringify({ pid: process.pid, at: new Date().toISOString() }));
 510:       const readInside = readHolder();
 511:       if (readInside === null) continue; // released while we were entering; the next claim takes it
 512:       // The same guard as above: the gate must not be able to remove an unidentifiable file either.
 513:       const inside = identified(readInside, 'inside the takeover gate');
 514:       if (inside === null) continue;
 515:       if (holderIsLive(inside, policy)) continue; // refreshed under us; the next pass refuses it properly
 516: 
 517:       rmSync(file, { force: true });
 518:       const takeover = claim(inside);
 519:       if (!takeover) continue; // a third process claimed the free path first â€” delete nothing more
 520: 
 521:       console.log(
 522:         `at:verify â€” took over a stale stack lock (holder pid ${inside.pid ?? 'unknown'} ` +
 523:           `${typeof inside.pid === 'number' && processIsAlive(inside.pid) ? `is older than ${LOCK_STALE_MINUTES} minutes` : 'is no longer running'})`,
 524:       );
 525:       return takeover;
 526:     } finally {
 527:       closeSync(gateFd);
 528:       rmSync(gate, { force: true });
 529:     }
 530:   }
 531: 
 532:   throw new Error(`could not acquire the stack lock at ${file} â€” it kept changing hands; try again`);
 533: }
 534: 
 535: /* -------------------------------------------------------------------- the stack's own report */
 536: 
 537: export interface StackStatus {
 538:   apiUrl: string;
 539:   dbUrl: string;
 540:   anonKey: string;
 541:   serviceRoleKey: string;
 542:   /**
 543:    * WHERE THE STACK'S OWN MAIL CATCHER ANSWERS, as the stack itself reports it.
 544:    *
 545:    * OPTIONAL, and that is not laziness. The four fields above are REQUIRED because nothing can run
 546:    * without them; a catcher is needed only by a suite that reads mail, and the CLI has renamed this
 547:    * field once already (`INBUCKET_URL` became `MAILPIT_URL` when the catcher changed, and both are
 548:    * emitted today). Making it required would turn a rename into an infrastructure failure for every
 549:    * run, including the ones that never read a message. A suite that DOES need it refuses loudly at
 550:    * its own construction â€” `live-email.ts` says exactly that â€” which is where the refusal belongs.
 551:    *
 552:    * It is read here rather than recomputed from `[local_smtp] port` plus the pool's per-slot offset,
 553:    * so there is one statement of the catcher's address rather than two that can disagree.
 554:    */
 555:   mailUrl?: string;
 556: }
 557: 
 558: const REQUIRED_STATUS_FIELDS: Record<'apiUrl' | 'dbUrl' | 'anonKey' | 'serviceRoleKey', string> = {
 559:   apiUrl: 'API_URL',
 560:   dbUrl: 'DB_URL',
 561:   anonKey: 'ANON_KEY',
 562:   serviceRoleKey: 'SERVICE_ROLE_KEY',
 563: };
 564: 
 565: export function supabaseArgs(...args: string[]): string[] {
 566:   if (!existsSync(SUPABASE_ENTRY)) throw new Error(`the Supabase CLI is not installed at ${SUPABASE_ENTRY} â€” run \`bun install\``);
 567:   return ['--no-env-file', SUPABASE_ENTRY, ...args];
 568: }
 569: 
 570: /**
 571:  * WHICH PROJECT an invocation acts on. A target names both halves of an identity, because either
 572:  * half alone is a hybrid.
 573:  */
 574: export interface CliTarget {
 575:   /** The directory that CONTAINS the `supabase/` project folder â€” what `--workdir` names. */
 576:   workdir: string;
 577:   /** The project id the invocation must resolve, stated POSITIVELY in `SUPABASE_PROJECT_ID`. */
 578:   projectId: string;
 579: }
 580: 
 581: export interface CliInvocation {
 582:   args: string[];
 583:   cwd: string;
 584:   env: Record<string, string>;
 585: }
 586: 
 587: /**
 588:  * THE ONE SEAM every Supabase CLI invocation is built at. Nothing in this repository assembles a
 589:  * CLI command line, working directory or environment anywhere else, and that single seam is the
 590:  * whole wall â€” a wall with two builders is a wall with a gap.
 591:  *
 592:  * THREE THINGS HAVE TO AGREE, and the reason each is here was measured, not reasoned about:
 593:  *
 594:  *   1. `SUPABASE_PROJECT_ID`, set POSITIVELY to the target's project id. The CLI treats that
 595:  *      variable as an OVERRIDE of `project_id` in `config.toml`. The repo's tracked `.env` carries
 596:  *      it, bun loads `.env` into this process, and on 2026-08-09 a `db reset` aimed at slot 2
 597:  *      destroyed the founder's personal database because the environment supplied the identity
 598:  *      while the slot's config supplied the ports. The wall is stating the identity, never merely
 599:  *      avoiding an override: an absence can be reintroduced by any parent process, a positive
 600:  *      value cannot.
 601:  *   2. NO OTHER `SUPABASE_*` variable. `childEnv` is an allowlist that carries none, and this
 602:  *      function asserts that rather than trusting it, because the allowlist is edited by people.
 603:  *   3. The WORKING DIRECTORY, equal to `--workdir`. Measured 2026-08-10: when the CLI's working
 604:  *      directory is itself a Supabase project, `--workdir <other>` produces a hybrid â€” the other
 605:  *      project's ports beside the working directory's project's containers. Run from a directory
 606:  *      that is not a project, the same command correctly says
 607:  *      `No such container: supabase_db_ai4good-slot-1`.
 608:  *
 609:  * `bun --no-env-file` (in `supabaseArgs`) closes the fourth route: a child that re-reads `.env`
 610:  * for itself.
 611:  *
 612:  * No target means the repository's own project, exactly as every call site behaved before targets
 613:  * existed: no `--workdir`, the repo root, and an environment carrying no `SUPABASE_*` at all.
 614:  */
 615: export function supabaseInvocation(target: CliTarget | undefined, args: string[]): CliInvocation {
 616:   if (!target) return { args: supabaseArgs(...args), cwd: REPO_ROOT, env: childEnv() };
 617: 
 618:   const env = childEnv({ SUPABASE_PROJECT_ID: target.projectId });
 619:   const foreign = Object.keys(env).filter((name) => /^SUPABASE_/i.test(name) && name.toUpperCase() !== 'SUPABASE_PROJECT_ID');
 620:   if (foreign.length) {
 621:     throw new Error(
 622:       `refusing to run the Supabase CLI against ${target.projectId}: the child environment would also carry ` +
 623:         `${foreign.join(', ')}, and a second SUPABASE_* variable can override the identity this invocation states.`,
 624:     );
 625:   }
 626:   if (env.SUPABASE_PROJECT_ID !== target.projectId) {
 627:     throw new Error(`refusing to run the Supabase CLI: SUPABASE_PROJECT_ID would not be "${target.projectId}"`);
 628:   }
 629:   return { args: supabaseArgs('--workdir', target.workdir, ...args), cwd: target.workdir, env };
 630: }
 631: 
 632: export interface CliResult {
 633:   status: number | null;
 634:   signal?: NodeJS.Signals | null;
 635:   stdout: string;
 636:   stderr: string;
 637:   error?: Error;
 638: }
 639: 
 640: /** Run the pinned CLI through the seam and hand back the RAW result. The caller decides what to
 641:  * read and what may be printed â€” raw output carries every key the stack issues. */
 642: export function runSupabaseCli(target: CliTarget | undefined, args: string[]): CliResult {
 643:   const invocation = supabaseInvocation(target, args);
 644:   const res = spawnSync(bunExecutable(), invocation.args, { cwd: invocation.cwd, env: invocation.env, encoding: 'utf8' });
 645:   return {
 646:     status: res.status,
 647:     signal: res.signal,
 648:     stdout: res.stdout ?? '',
 649:     stderr: res.stderr ?? '',
 650:     error: res.error as Error | undefined,
 651:   };
 652: }
 653: 
 654: /**
 655:  * Ask the running stack to describe itself. The raw output is NEVER printed: it contains every
 656:  * key the stack issues. Only field names travel into error messages.
 657:  */
 658: export function readStackStatus(target?: CliTarget): StackStatus {
 659:   return parseStackStatus(runSupabaseCli(target, ['status', '-o', 'json']));
 660: }
 661: 
 662: /**
 663:  * The status parser, separate from the invocation so that a caller which needs the RAW output for
 664:  * its own checks (the slot pool's identity read) reads it once and parses the same result, rather
 665:  * than running the CLI twice or keeping a second copy of this parser.
 666:  */
 667: export function parseStackStatus(res: CliResult): StackStatus {
 668:   if (res.error) {
 669:     const err = res.error as NodeJS.ErrnoException;
 670:     throw new Error(`could not launch the Supabase CLI (${err.code ?? 'spawn error'}): ${diagnostic(err.message)}`);
 671:   }
 672: 
 673:   const stdout = res.stdout ?? '';
 674:   const open = stdout.indexOf('{');
 675:   const close = stdout.lastIndexOf('}');
 676:   if (open < 0 || close <= open) {
 677:     throw new Error(
 678:       `\`supabase status\` reported no JSON (exit ${res.status}${res.signal ? `, signal ${res.signal}` : ''}): ` +
 679:         `${diagnostic(res.stderr) || '(no error output)'}`,
 680:     );
 681:   }
 682: 
 683:   // The CLI exits non-zero merely because config.toml disables imgproxy and the pooler. That is
 684:   // not a failure; anything ELSE reported stopped is.
 685:   const notice = `${stdout.slice(0, open)}\n${res.stderr ?? ''}`;
 686:   const stopped = /Stopped services:\s*\[([^\]]*)\]/.exec(notice)?.[1] ?? '';
 687:   const unexpectedStopped = stopped.split(/\s+/).filter((name) => name && !DISABLED_SERVICES.test(name));
 688:   if (unexpectedStopped.length) {
 689:     throw new Error(`the stack reports stopped services: ${unexpectedStopped.join(', ')} â€” start them before running the suite`);
 690:   }
 691: 
 692:   let parsed: Record<string, unknown>;
 693:   try {
 694:     parsed = JSON.parse(stdout.slice(open, close + 1)) as Record<string, unknown>;
 695:   } catch (err) {
 696:     throw new Error(`\`supabase status\` produced unparseable JSON: ${(err as Error).message}`);
 697:   }
 698: 
 699:   const status: Partial<StackStatus> = {};
 700:   const missing: string[] = [];
 701:   for (const [field, key] of Object.entries(REQUIRED_STATUS_FIELDS) as [keyof typeof REQUIRED_STATUS_FIELDS, string][]) {
 702:     const value = parsed[key];
 703:     if (typeof value !== 'string' || value.trim() === '') missing.push(key);
 704:     else status[field] = value;
 705:   }
 706:   if (missing.length) throw new Error(`\`supabase status\` reported no ${missing.join(', no ')}`);
 707: 
 708:   // BOTH NAMES, newest first. The CLI emits `MAILPIT_URL` today and still emits the older
 709:   // `INBUCKET_URL` beside it; reading both means a CLI that drops either one keeps working, and a
 710:   // CLI that drops both leaves this undefined rather than silently wrong.
 711:   for (const key of ['MAILPIT_URL', 'INBUCKET_URL']) {
 712:     const value = parsed[key];
 713:     if (typeof value === 'string' && value.trim() !== '') {
 714:       status.mailUrl = value;
 715:       break;
 716:     }
 717:   }
 718:   return status as StackStatus;
 719: }
 720: 
 721: /* --------------------------------------------------------- proving the stack is the LOCAL one */
 722: 
 723: const LOOPBACK = new Set(['127.0.0.1', 'localhost', '::1', '[::1]']);
 724: 
 725: function decodeJwtClaims(token: string): Record<string, unknown> | null {
 726:   const parts = token.split('.');
 727:   if (parts.length !== 3) return null;
 728:   try {
 729:     return JSON.parse(Buffer.from(parts[1], 'base64url').toString('utf8')) as Record<string, unknown>;
 730:   } catch {
 731:     return null;
 732:   }
 733: }
 734: 
 735: /**
 736:  * Refuse to touch anything that is not demonstrably the local development stack. Returns the
 737:  * names of the checks that failed â€” never the values, which are keys and connection strings.
 738:  */
 739: export function localStackProblems(status: StackStatus, config: LocalConfig): string[] {
 740:   const problems: string[] = [];
 741: 
 742:   const checkUrl = (label: string, raw: string, expectedPort: number) => {
 743:     let url: URL;
 744:     try {
 745:       url = new URL(raw);
 746:     } catch {
 747:       problems.push(`${label} is not a URL`);
 748:       return;
 749:     }
 750:     if (!LOOPBACK.has(url.hostname)) problems.push(`${label} does not point at the loopback address`);
 751:     if (url.port !== String(expectedPort)) problems.push(`${label} port is not the ${expectedPort} configured in supabase/config.toml`);
 752:   };
 753: 
 754:   checkUrl('API_URL', status.apiUrl, config.apiPort);
 755:   checkUrl('DB_URL', status.dbUrl, config.dbPort);
 756: 
 757:   const checkKey = (label: string, token: string, expectedRole: string) => {
 758:     const claims = decodeJwtClaims(token);
 759:     if (!claims) {
 760:       problems.push(`${label} is not a decodable local development JWT`);
 761:       return;
 762:     }
 763:     if (claims.iss !== 'supabase-demo') problems.push(`${label} was not issued by the local development issuer`);
 764:     if (claims.role !== expectedRole) problems.push(`${label} does not carry the ${expectedRole} role`);
 765:     if (typeof claims.ref === 'string') problems.push(`${label} carries a hosted project reference`);
 766:   };
 767: 
 768:   checkKey('ANON_KEY', status.anonKey, 'anon');
 769:   checkKey('SERVICE_ROLE_KEY', status.serviceRoleKey, 'service_role');
 770: 
 771:   return problems;
 772: }
 773: 
 774: /* --------------------------------------------------------------------------------- readiness */
 775: 
 776: interface BunSqlClient {
 777:   (strings: TemplateStringsArray, ...values: unknown[]): Promise<unknown>;
 778:   close(): Promise<void>;
 779: }
 780: type BunSqlCtor = new (url: string) => BunSqlClient;
 781: 
 782: /** Postgres itself answers a query â€” not "the port is open", which a half-started stack satisfies. */
 783: async function databaseAnswers(dbUrl: string): Promise<string | null> {
 784:   const SQL = (globalThis as { Bun?: { SQL?: BunSqlCtor } }).Bun?.SQL;
 785:   if (!SQL) return 'this runtime has no SQL client (expected bun)';
 786:   let sql: BunSqlClient | null = null;
 787:   try {
 788:     sql = new SQL(dbUrl);
 789:     await sql`select 1`;
 790:     return null;
 791:   } catch (err) {
 792:     return diagnostic((err as Error).message);
 793:   } finally {
 794:     await sql?.close().catch(() => undefined);
 795:   }
 796: }
 797: 
 798: /** One request that only succeeds if Kong routed it, PostgREST served it, and Postgres answered. */
 799: async function gatewayAnswers(status: StackStatus): Promise<string | null> {
 800:   try {
 801:     const res = await fetch(`${status.apiUrl.replace(/\/$/, '')}/rest/v1/`, {
 802:       headers: { apikey: status.anonKey, Authorization: `Bearer ${status.anonKey}` },
 803:       signal: AbortSignal.timeout(5000),
 804:     });
 805:     if (!res.ok) return `the API gateway answered ${res.status}`;
 806:     const type = res.headers.get('content-type') ?? '';
 807:     if (!type.includes('json')) return `the API gateway answered 200 but served ${type || 'no content type'}`;
 808:     return null;
 809:   } catch (err) {
 810:     return diagnostic((err as Error).message);
 811:   }
 812: }
 813: 
 814: /**
 815:  * Wait until the stack is genuinely usable, or give up. "Something answered on the port" is not
 816:  * readiness: a half-started stack answers 502/503, and a run launched against it fails in ways
 817:  * that look like test failures instead of infrastructure failures.
 818:  */
 819: export async function waitForReady(status: StackStatus, phase: string): Promise<void> {
 820:   const deadline = Date.now() + READY_TIMEOUT_MS;
 821:   let lastProblem = 'not attempted';
 822:   let delay = 250;
 823: 
 824:   while (Date.now() < deadline) {
 825:     const db = await databaseAnswers(status.dbUrl);
 826:     if (db === null) {
 827:       const gateway = await gatewayAnswers(status);
 828:       if (gateway === null) return;
 829:       lastProblem = gateway;
 830:     } else {
 831:       lastProblem = `the database did not answer: ${db}`;
 832:     }
 833:     await new Promise((resolve) => setTimeout(resolve, delay));
 834:     delay = Math.min(delay * 2, 2000);
 835:   }
 836: 
 837:   throw new Error(`the stack was still not ready ${phase} after ${Math.round(READY_TIMEOUT_MS / 1000)}s â€” last problem: ${lastProblem}`);
 838: }
 839: 
 840: /* --------------------------------------------------------------------- the migration-set proof */
 841: 
 842: /** Counted, not just proved â€” the pool's evidence line has to state the migration state it saw. */
 843: export interface MigrationProof {
 844:   expected: number;
 845:   applied: number;
 846: }
 847: 
 848: /**
 849:  * The migrations the reset is supposed to replay, read from disk. The CLI names them
 850:  * `<timestamp>_name.sql` and records the timestamp as the applied version, so the timestamp is
 851:  * the identity. `.gitkeep` and `README.md` are not migrations and are ignored.
 852:  */
 853: export function expectedMigrations(root: string = REPO_ROOT): string[] {
 854:   const dir = join(root, 'supabase', 'migrations');
 855:   if (!existsSync(dir)) return [];
 856:   return readdirSync(dir)
 857:     .map((name) => /^(\d{14})_.*\.sql$/.exec(name)?.[1])
 858:     .filter((version): version is string => Boolean(version))
 859:     .sort();
 860: }
 861: 
 862: /** What the database says it actually replayed. */
 863: async function appliedMigrations(dbUrl: string): Promise<string[]> {
 864:   const SQL = (globalThis as { Bun?: { SQL?: BunSqlCtor } }).Bun?.SQL;
 865:   if (!SQL) throw new Error('this runtime has no SQL client (expected bun)');
 866:   let sql: BunSqlClient | null = null;
 867:   try {
 868:     sql = new SQL(dbUrl);
 869:     const rows = (await sql`select version from supabase_migrations.schema_migrations order by version`) as {
 870:       version: string;
 871:     }[];
 872:     return rows.map((row) => String(row.version)).sort();
 873:   } catch (err) {
 874:     // A database that has never had a migration applied has no history table at all. "No table"
 875:     // and "empty table" mean the same thing â€” nothing was applied â€” and saying so lets the
 876:     // comparison below name exactly which migrations are missing instead of reporting a SQL error.
 877:     const message = (err as Error).message ?? '';
 878:     if (/schema_migrations/.test(message) && /does not exist/i.test(message)) return [];
 879:     throw new Error(`could not read the migration history: ${diagnostic(message)}`);
 880:   } finally {
 881:     await sql?.close().catch(() => undefined);
 882:   }
 883: }
 884: 
 885: /** Exact set equality, both directions, named plainly. */
 886: export function migrationSetProblems(expected: string[], applied: string[]): string[] {
 887:   const missing = expected.filter((version) => !applied.includes(version));
 888:   const extra = applied.filter((version) => !expected.includes(version));
 889:   const problems: string[] = [];
 890:   if (missing.length) problems.push(`never applied: ${missing.join(', ')}`);
 891:   if (extra.length) problems.push(`applied but not in supabase/migrations: ${extra.join(', ')}`);
 892:   return problems;
 893: }
 894: 
 895: /**
 896:  * Prove the rebuild actually replayed the migration set â€” the promise `supabase/migrations/README.md`
 897:  * makes. "The reset command exited zero" is not that proof: a reset that replays NOTHING also exits
 898:  * zero, and a suite then grades an empty schema while believing it graded the real one.
 899:  *
 900:  * An empty expected set is legitimate today (no migrations have been written yet) and is allowed â€”
 901:  * but it is STATED on every run, so an empty rebuild can never be silently mistaken for a real one.
 902:  */
 903: export async function proveMigrationsReplayed(status: StackStatus, root: string = REPO_ROOT): Promise<MigrationProof> {
 904:   const expected = expectedMigrations(root);
 905:   const applied = await appliedMigrations(status.dbUrl);
 906:   const problems = migrationSetProblems(expected, applied);
 907: 
 908:   const summary = `${expected.length} migration${expected.length === 1 ? '' : 's'} expected, ${applied.length} applied`;
 909:   if (problems.length) {
 910:     throw new Error(`the rebuilt database does not match supabase/migrations (${summary}) â€” ${problems.join('; ')}`);
 911:   }
 912:   console.log(
 913:     expected.length === 0
 914:       ? `at:verify â€” ${summary} â€” the schema is empty by design at this stage`
 915:       : `at:verify â€” ${summary} â€” the rebuilt schema matches supabase/migrations exactly`,
 916:   );
 917:   return { expected: expected.length, applied: applied.length };
 918: }
 919: 
 920: /* ------------------------------------------------------------------------------------- reset */
 921: 
 922: /**
 923:  * WHAT A PRE-DESTRUCTIVE IDENTITY READ PROVED (audit ruling B2, decision D13).
 924:  *
 925:  * The read itself lives beside the pool, because only the pool knows what a slot is. What travels
 926:  * from the read to the destructive act is this: the project id the CLI's own output POSITIVELY
 927:  * named, or `null` when the read proved no project at all.
 928:  */
 929: export interface SlotIdentityProof {
 930:   /** The project id the identity read proved, from the CLI's own container names. */
 931:   provenProjectId: string | null;
 932: }
 933: 
 934: /**
 935:  * Rebuild the local database from `supabase/migrations` â€” the same work `bun run db:reset` does,
 936:  * invoked at the pinned CLI so failures are catchable and bounded.
 937:  *
 938:  * WHY EVERY RUN: without it the second run works on the first run's leftover rows, and on a
 939:  * schema missing whatever migration landed since â€” a suite grading a database nobody established.
 940:  *
 941:  * A TARGET COSTS A PROOF, AND THE TYPE SYSTEM COLLECTS IT (audit ruling B2). D13 rules the identity
 942:  * read structurally ON the destructive path, "never a separate call a caller can skip". Before this
 943:  * signature the read sat at the one call site instead, so any importer could aim a reset at a slot
 944:  * with no read at all and still compile. Now a target demands the proof object the read returns:
 945:  * the overloads make the skip a compile error, and a proof that names another project â€” or names
 946:  * none â€” is a named refusal here, before anything is spawned. No target is the repository's own
 947:  * project and is unchanged, exactly as it behaved before targets existed.
 948:  */
 949: export async function resetLocalDatabase(): Promise<void>;
 950: export async function resetLocalDatabase(target: CliTarget, proof: SlotIdentityProof): Promise<void>;
 951: export async function resetLocalDatabase(target?: CliTarget, proof?: SlotIdentityProof): Promise<void> {
 952:   if (target && proof?.provenProjectId !== target.projectId) {
 953:     throw new Error(
 954:       `REFUSING TO RESET ${target.projectId}: the identity read handed to this reset ` +
 955:         `${proof?.provenProjectId ? `proves ${proof.provenProjectId}` : 'proves no project at all'}, not ${target.projectId}. ` +
 956:         `A reset aimed at a target is only permitted on the read that proved that target. Nothing was done.`,
 957:     );
 958:   }
 959:   const invocation = supabaseInvocation(target, ['db', 'reset', '--local']);
 960:   const child = spawn(bunExecutable(), invocation.args, {
 961:     cwd: invocation.cwd,
 962:     env: invocation.env,
 963:     // progress is worth watching (a reset replays every migration); stderr is captured so a
 964:     // failure can be reported in our own words rather than scrolling past.
 965:     stdio: ['ignore', 'inherit', 'pipe'],
 966:   });
 967: 
 968:   let stderr = '';
 969:   child.stderr?.on('data', (chunk: Buffer) => {
 970:     stderr = (stderr + chunk.toString('utf8')).slice(-8000);
 971:   });
 972: 
 973:   let timedOut = false;
 974:   const timer = setTimeout(() => {
 975:     timedOut = true;
 976:     // Kill the TREE: the CLI shells out to the container runtime, and killing only the parent
 977:     // leaves a migration running against the database this run is about to test.
 978:     if (child.pid && process.platform === 'win32') spawnSync('taskkill', ['/PID', String(child.pid), '/T', '/F'], { stdio: 'ignore' });
 979:     else child.kill('SIGKILL');
 980:   }, RESET_TIMEOUT_MS);
 981: 
 982:   try {
 983:     await new Promise<void>((resolve, reject) => {
 984:       child.once('error', (err) => {
 985:         const e = err as NodeJS.ErrnoException;
 986:         reject(new Error(`the reset process could not be launched (${e.code ?? 'spawn error'}): ${diagnostic(e.message)}`));
 987:       });
 988:       child.once('close', (code, signal) => {
 989:         if (timedOut) {
 990:           reject(new Error(`the reset did not finish within ${Math.round(RESET_TIMEOUT_MS / 1000)}s and its process tree was killed`));
 991:         } else if (code === 0) {
 992:           resolve();
 993:         } else {
 994:           const how = code === null ? `was killed by signal ${signal}` : `exited ${code}`;
 995:           reject(new Error(`\`supabase db reset\` ${how}: ${diagnostic(stderr) || '(no error output)'}`));
 996:         }
 997:       });
 998:     });
 999:   } finally {
1000:     clearTimeout(timer);
1001:   }
1002: }
1003: 
1004: /* --------------------------------------------------------------------------- vitest json shape */
1005: 
1006: export interface AssertionResult {
1007:   title?: string;
1008:   fullName?: string;
1009:   status?: string;
1010:   failureMessages?: string[];
1011: }
1012: 
1013: /**
1014:  * The report's own arithmetic, alongside the per-test results. `--expect` needs both: the id
1015:  * parser only sees tests whose titles carry an AT id, so an untagged `it()` that fails is
1016:  * invisible to it and visible in these counts. Optional because this describes a file on disk â€”
1017:  * a missing field is validated at runtime (see `reportAccountingDeviations`), not asserted here.
1018:  */
1019: interface VitestJson {
1020:   /**
1021:    * One entry per test FILE. `status` and `message` are kept alongside the assertions because a
1022:    * file that fails to import, or whose hook throws, changes no test's status: that failure is
1023:    * visible here and nowhere else in the report.
1024:    */
