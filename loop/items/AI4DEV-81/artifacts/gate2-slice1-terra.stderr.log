1490: /**
1491:  * DROP AND RECREATE, never `create table if not exists`: the first spike left a `spike_canary`
1492:  * table of its own shape in slot 1, and an insert against somebody else's columns fails on a
1493:  * constraint rather than writing the canary. The canary has to be this run's own table.
1494:  */
1495: async function writeCanary(slot: number, status: StackStatus, note: string): Promise<void> {
1496:   await withSlotSql(slot, status, async (sql) => {
1497:     await sql`drop table if exists public.spike_canary`;
1498:     await sql`create table public.spike_canary (note text)`;
1499:     await sql`insert into public.spike_canary (note) values (${note})`;
1500:   });
1501: }
1502: 
1503: /** The canary's note, or null when the table or the row is gone â€” which is what a reset does. */
1504: async function readCanary(slot: number, status: StackStatus): Promise<string | null> {
1505:   return withSlotSql(slot, status, async (sql) => {
1506:     try {
1507:       const rows = (await sql`select note from public.spike_canary`) as { note?: unknown }[];
1508:       return rows.length ? String(rows[0].note) : null;
1509:     } catch (err) {
1510:       const message = (err as Error).message ?? '';
1511:       if (/spike_canary/.test(message) && /does not exist/i.test(message)) return null;
1512:       throw err;
1513:     }
1514:   });
1515: }
