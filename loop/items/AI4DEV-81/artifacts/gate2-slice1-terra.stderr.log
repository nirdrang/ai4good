1121: function runtimeRegistrations(dir: string): RuntimeRegistration[] {
1122:   const registrations: RuntimeRegistration[] = [];
1123:   for (const file of readdirSync(dir, { withFileTypes: true })) {
1124:     if (!file.isFile() || !file.name.endsWith('.jsonl')) continue;
1125:     const lines = readFileSync(join(dir, file.name), 'utf8').split(/\r?\n/).filter(Boolean);
1126:     for (const line of lines) registrations.push(JSON.parse(line) as RuntimeRegistration);
1127:   }
1128:   return registrations;
1129: }
