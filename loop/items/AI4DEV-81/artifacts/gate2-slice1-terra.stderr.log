  36: export interface ParsedAtId {
  37:   atId: string;
  38:   /** e.g. '016', '005.5' */
  39:   requirement: string;
  40:   /** e.g. '01', '05a' */
  41:   number: string;
  42: }
  43: 
  44: export function parseAtId(atId: string): ParsedAtId {
  45:   const m = AT_ID.exec(atId);
  46:   if (!m) {
  47:     throw new Error(
  48:       `malformed AT id ${JSON.stringify(atId)} â€” expected AT-<requirement>.<number>, ` +
  49:         `e.g. AT-016.01 or AT-005.5.03 (the last dot-segment is the test number)`,
  50:     );
  51:   }
  52:   return { atId, requirement: m[1], number: m[2] };
  53: }
