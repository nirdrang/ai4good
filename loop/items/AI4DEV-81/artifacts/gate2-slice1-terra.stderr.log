 204: /**
 205:  * THE LOCAL STACK'S OWN LISTENER PORTS â€” the only ports a slot's identity moves (ruling E4).
 206:  *
 207:  * A `config.toml` holds two kinds of port. A LISTENER port is a socket this machine opens for
 208:  * this stack, so two stacks that share one collide, and the overlay must move it. A CLIENT port
 209:  * is part of an address of somebody else's service â€” `[auth.email.smtp] port = 587` is Postmark's
 210:  * port, not ours â€” so it is DATA, and moving it or refusing it would break a slot that is
 211:  * configured exactly like the tree it grades.
 212:  *
 213:  * The list is exact section + key pairs, so `[api] port` moves while `[api.tls] port` (were one
 214:  * added) does not silently inherit the rule.
 215:  */
 216: const LISTENER_PORTS: readonly { section: string; key: string }[] = [
 217:   { section: 'api', key: 'port' },
 218:   { section: 'db', key: 'port' },
 219:   { section: 'db', key: 'shadow_port' },
 220:   { section: 'db.pooler', key: 'port' },
 221:   { section: 'studio', key: 'port' },
 222:   { section: 'local_smtp', key: 'port' },
 223:   { section: 'local_smtp', key: 'smtp_port' },
 224:   { section: 'local_smtp', key: 'pop3_port' },
 225:   { section: 'analytics', key: 'port' },
 226:   { section: 'edge_runtime', key: 'inspector_port' },
 227: ];
 228: 
 229: function isListenerPort(section: string, key: string): boolean {
 230:   return LISTENER_PORTS.some((listener) => listener.section === section && listener.key === key);
 231: }
