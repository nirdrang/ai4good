  17:  */
  18: 
  19: import { appendFileSync, mkdirSync } from 'node:fs';
  20: import { join } from 'node:path';
  21: import { expect, it } from 'vitest';
  22: 
  23: import { CapabilityPending } from './capabilities.ts';
  24: import type { AtHarness, TierHarness } from './contracts.ts';
  25: import type { SuiteId, SutKeyOf, SutOf, WorldOf } from './suite-adapters.ts';
  26: 
  27: /* ------------------------------------------------------------------------ the AT id grammar */
  28: 
  29: /**
  30:  * `AT-<requirement>.<number>` â€” the FINAL dot-segment is the test number and everything
  31:  * between `AT-` and it is the requirement id, because requirement ids may themselves carry a
  32:  * dot suffix (`005.5` is a real requirement, so `AT-005.5.03` is a real id).
  33:  */
  34: const AT_ID = /^AT-(\d{3}(?:\.\d+)*)\.(\d+[a-z]?)$/;
  35: 
  36: export interface ParsedAtId {
  37:   atId: string;
  38:   /** e.g. '016', '005.5' */
  39:   requirement: string;
  40:   /** e.g. '01', '05a' */
  41:   number: string;
  42: }
  43: 
  44: export function parseAtId(atId: string): ParsedAtId {
  45:   const m = AT_ID.exec(atId);
  46:   if (!m) {
  47:     throw new Error(
  48:       `malformed AT id ${JSON.stringify(atId)} â€” expected AT-<requirement>.<number>, ` +
  49:         `e.g. AT-016.01 or AT-005.5.03 (the last dot-segment is the test number)`,
  50:     );
  51:   }
  52:   return { atId, requirement: m[1], number: m[2] };
  53: }
  54: 
  55: /* ---------------------------------------------------------------------------- registrations */
  56: 
  57: /** Surface is an axis independent of tier: one authored body, driven through different drivers. */
  58: export type Surface = 'backend' | 'ui' | 'skill';
  59: 
  60: /**
  61:  * What a suite may vary PER TEST.
  62:  *
  63:  * Neither the requirement nor the system-under-test key is here any more. Both come from the
  64:  * binding, and both now determine TYPES (`SutOf` / `WorldOf`), so a per-test override would let one
  65:  * test in a suite describe a different seam from the one its neighbours describe â€” which is the
  66:  * drift this whole item exists to make impossible.
  67:  */
  68: export interface AtTestOptions {
  69:   /** `ui` marks the test as part of a wiring leaf's `--wired` re-run selection */
  70:   surface?: Surface;
  71: }
  72: 
  73: /**
  74:  * WHICH SUITE THIS IS. The two facts a suite supplies, and the only two it is allowed to supply.
  75:  *
  76:  * `requirement` is a key of `suite-adapters.ts`'s registry, so it is not a free string: a
  77:  * requirement with no registered adapter cannot be bound at all. `sut` is constrained to the keys
  78:  * that adapter really exposes, so a misspelling is a compile error instead of a run-time
  79:  * `sut-missing`. Everything else about the seam â€” the system under test's shape and the fixture
  80:  * world's shape â€” is DERIVED from those two, never stated.
  81:  */
  82: export interface SuiteBinding<R extends SuiteId, K extends SutKeyOf<R>> {
  83:   /** the requirement this suite tests, e.g. 'req-016' */
  84:   requirement: R;
  85:   /** which member of `harness.sut` the whole suite drives, e.g. 'notifications' */
  86:   sut: K;
  87:   /** the suite's own words for "the implementation has not landed yet" */
  88:   sutMissingDetail?: string;
  89: }
  90: 
  91: export interface Registration extends ParsedAtId {
  92:   title: string;
  93:   surface: Surface;
  94: }
  95: 
  96: const registrations = new Map<string, Registration>();
  97: 
  98: /** Everything registered in the modules loaded so far. `--wired` selects the ui-marked ids. */
  99: export function registeredTests(): Registration[] {
 100:   return [...registrations.values()];
 101: }
 102: 
 103: /* ------------------------------------------------------------------------------------ tiers */
 104: 
 105: export type Tier = 'loop' | 'integration' | 'drill';
 106: 
 107: export const TIERS: readonly Tier[] = ['loop', 'integration', 'drill'] as const;
 108: 
 109: const RAW_TIER = (globalThis as { process?: { env?: Record<string, string | undefined> } }).process?.env?.AT_TIER;
 110: 
 111: /**
 112:  * The runner (`bun run at:verify req-0NN --tier <tier>`) passes the tier through this env var.
 113:  * There is NO default: an unset or misspelled AT_TIER on an intended integration run must
 114:  * not silently degrade to the stubbed `loop` world â€” that is the /pm-done gate quietly
 115:  * grading itself on an easier exam.
 116:  */
 117: export const TIER: Tier | null = TIERS.includes(RAW_TIER as Tier) ? (RAW_TIER as Tier) : null;
 118: 
 119: const tierError = (requirement: string) =>
 120:   `AT_TIER is ${RAW_TIER === undefined ? 'unset' : JSON.stringify(RAW_TIER)}; expected one of ${TIERS.join('|')} â€” run via \`bun run at:verify req-${requirement} --tier <tier>\``;
 121: 
 122: /* -------------------------------------------------------------------------- the harness seam */
 123: 
 124: /** Canonical harness barrel produced by AI4DEV-3 H2-H6, resolved relative to THIS file. */
 125: export const HARNESS_MODULE = './index.ts';
 126: 
 127: /**
 128:  * The minimum a fixture world owes the harness.
 129:  *
 130:  * A TYPE ALIAS, like every other contract a test body can read from. `open()` hands `w` to the body,
 131:  * so while this was an interface a suite could merge a member into it and read that member green off
 132:  * an object that never supplies it â€” the same defect closed fifteen times elsewhere in this seam,
 133:  * left open here by an exclusion that contradicted its own criterion.
 134:  *
 135:  * The exploit needed `W` at its DEFAULT, which is what made it easy to miss: a suite that pinned its
 136:  * own world type (as REQ-016 did) resolved `w` to that type and never saw the merged member â€” which
 137:  * hid the hole rather than closing it.
 138:  *
 139:  * A suite can no longer pin a world type at all. AI4DEV-31 derives `w` from the adapter that really
 140:  * produces it, so this type's job is now only what it always said on the tin: the minimum the
 141:  * harness needs in order to tear a world down, which is why `suite-adapters.ts` constrains every
 142:  * registered adapter's `fixtures.world()` to return one.
 143:  */
 144: export type WorldLike = {
 145:   teardown(): Promise<void>;
 146: };
 147: 
 148: /** Re-tuned pinned values for ONE world. Keys are the at-config registry's dotted keys. */
 149: export type ConfigOverrides = Record<string, number | boolean>;
 150: 
 151: export interface HarnessModule {
 152:   createHarness(opts: { requirement: string; tier: Tier; configOverrides?: ConfigOverrides }): Promise<AtHarness>;
 153: }
 154: 
 155: let harnessModule: HarnessModule | null = null;
 156: let harnessResolveError = '';
 157: 
 158: try {
 159:   const mod = (await import(/* @vite-ignore */ HARNESS_MODULE)) as Partial<HarnessModule>;
 160:   if (typeof mod.createHarness !== 'function') {
 161:     harnessResolveError = `resolved ${HARNESS_MODULE} but it exports no createHarness()`;
 162:   } else {
 163:     harnessModule = mod as HarnessModule;
 164:   }
 165: } catch (err) {
 166:   harnessResolveError = err instanceof Error ? err.message : String(err);
 167: }
 168: 
 169: /* ---------------------------------------------------------------------------- pending errors */
 170: 
 171: export type PendingPhase = 'harness-missing' | 'sut-missing' | 'tier-unset';
 172: 
 173: export class AtPending extends Error {
 174:   constructor(
 175:     readonly atId: string,
 176:     readonly phase: PendingPhase,
 177:     detail: string,
 178:   ) {
 179:     super(`${atId} PENDING [${phase}] â€” ${detail}`);
 180:     this.name = 'AtPending';
 181:   }
 182: }
 183: 
 184: /* --------------------------------------------------------------------------- the test context */
 185: 
 186: /**
 187:  * THE STRUCTURE of what `open()` hands back, parameterized by shape and NOT EXPORTED.
 188:  *
 189:  * The exported `OpenWorld` below takes a requirement and a sut key instead, and this is why. Any
 190:  * exported type generic over the SUT's shape is a way back into the hole, and not through the door
 191:  * anyone was watching: leave `bindSuite` alone, and widen the type at the BODY instead â€”
 192:  * `async (ctx: AtContext<NotificationsSut & { invented?: string }, World>) => â€¦` â€” then read the
 193:  * invented member. It needs no cast and no suppression. It was measured compiling clean against the
 194:  * first version of this change, with every other door already shut.
 195:  *
 196:  * NOTHING STRUCTURAL CAN REJECT IT, which is the part worth writing down. `NotificationsSut` and
 197:  * `NotificationsSut & { invented?: string }` are assignable in BOTH directions â€” an optional member
 198:  * adds no obligation â€” so they are indistinguishable to the assignability check however the
 199:  * variance is arranged. Marking the parameter invariant does not help; nor does any conditional
 200:  * "exactly this type" trick, because both directions genuinely hold.
 201:  *
 202:  * So what this closes is the INVITED spelling. `OpenWorld`, `AtContext`, `AtTestBody` and
 203:  * `EvidenceCapture` are exported over `<R, K>` â€” a requirement and a sut key, both of which derive â€”
 204:  * and the shape-parameterized versions stay inside this module. The old API positively ASKED a suite
 205:  * to name its seam types; the new one hands it nothing to name them with. That is the same decision
 206:  * D1 made for `bindSuite`, carried to the rest of the exported surface rather than stopped one type
 207:  * short.
 208:  *
 209:  * IT IS NOT UNSPELLABLE, AND AN EARLIER VERSION OF THIS COMMENT SAID IT WAS. Gate 2 refuted that by
 210:  * compiling the refutation, and it was reproduced here before being accepted. A determined author
 211:  * rebuilds the widened type out of the derived ones:
 212:  *
 213:  *   type WidenedCtx = Omit<AtContext<'req-016','notifications'>, 'open'> & {
 214:  *     open(): Promise<OpenWorld<'req-016','notifications'> & { sut: { invented?: string } }>;
 215:  *   };
 216:  *
 217:  * Exit 0 â€” through the bound `atTest`, the raw `atTest` and `defineEvidenceCapture` alike, with no
 218:  * cast, no `any`, no suppression and no module augmentation. NOTHING IN THE TYPE SYSTEM CAN STOP IT,
 219:  * for the reason two paragraphs up: the widened type and the derived one are assignable in both
 220:  * directions, so no annotation the harness writes can tell them apart. Closing it means INSPECTING
 221:  * SOURCE â€” permitting only inline, unannotated bodies â€” which is a different kind of machinery,
 222:  * filed as its own item rather than built here (AI4DEV-37).
 223:  *
 224:  * The line is worth stating as a rule rather than as an excuse. What is closed is a suite NAMING the
 225:  * seam types, and with it every route the API used to invite. What is open is a hand-written
 226:  * structural reconstruction, which is a decision somebody takes rather than a mistake they make.
 227:  * `tests/at/typeprobes/sut-seam.probe.ts` carries it verbatim as a documented known-open case (it
 228:  * cannot be an active probe there, because that program must not compile and this attack does), and
 229:  * `loop/items/AI4DEV-31/gate2-widen-reproduction.txt` is the compile transcript with its controls.
 230:  */
 231: type SeamOpenWorld<Sut = unknown, W extends WorldLike = WorldLike, T extends Tier = 'loop'> = {
 232:   /**
 233:    * The harness, at EXACTLY the type `createHarness()` is statically checked to produce â€” not a
 234:    * suite-chosen type, and not the suite's type arguments pushed back into it.
 235:    *
 236:    * Two doors are shut here, and both were opened by earlier drafts of this file. A free type
 237:    * parameter (`H extends HarnessLike`) let a suite declare seams the factory never supplies, since
 238:    * an intersection is a subtype and satisfies the constraint. Re-labelling the produced harness
 239:    * with the suite's own world and channel types was the same defect wearing a smaller hat: the
 240:    * factory proves `AtHarness<â€¦, WorldSeam, string>`, so a suite binding channel `'sms'` would have
 241:    * been told `vendors.email.attempts()` yields `'sms'` on the strength of nothing at all.
 242:    *
 243:    * `h` is deliberately NOT re-parameterized by AI4DEV-31 either. Deriving `w` and `sut` from the
 244:    * adapter does not license pushing them back into the harness: that is the same door, and it
 245:    * stays shut.
 246:    *
 247:    * IT IS PARAMETERIZED BY THE TIER, AND THAT IS NOT THE SAME DOOR. `T` is not a suite's type
 248:    * argument: a suite never writes it, and the only two values it takes come from which key of a
 249:    * per-tier body map a body was written under. `TierHarness<T>` then SUBTRACTS â€” at integration the
 250:    * clock loses its control seam and the vendors seam loses its arming methods â€” so the parameter
 251:    * can only ever narrow what a body may reach. A free harness type parameter widened; this one
 252:    * cannot, because the mapping from `T` to the harness type is written here and there is no `T` a
 253:    * suite can supply that adds a member.
 254:    */
 255:   h: TierHarness<T>;
 256:   /**
 257:    * The fixture world, at the type the requirement's ADAPTER really returns â€” `WorldOf<R>`, read
 258:    * off `fixtures.world`'s return type in `suite-adapters.ts`.
 259:    *
 260:    * It used to be the suite's own type argument, asserted rather than verified, so
 261:    * `bindSuite<NotificationsSut, AnythingAtAll>` type-checked green and a body could read members
 262:    * no fixture supplies. `tests/at/typeprobes/sut-seam-legacy.probe.ts` is that attack, kept alive:
 263:    * it compiled clean before this change and must fail now.
 264:    */
 265:   w: W;
 266:   /**
 267:    * The requirement's system under test, at the type its ADAPTER declares (`SutOf<R, K>`), and
 268:    * guaranteed non-null once open() returns.
 269:    *
 270:    * WHAT IS ACTUALLY CHECKED, precisely, because a closure claim wider than the truth is the defect
 271:    * this item removes: the adapter annotates what it builds (`const sut: NotificationsSut = â€¦`), so
 272:    * the shape is proven at the producer; the suite reads that type instead of restating it; the
 273:    * `requirement` literal ties the map entry, the module the type came from and the module
 274:    * `loadAdapter()` really imports to one self-declared value, checked at compile time AND again at
 275:    * run time. One assertion survives, at the end of `open()`, and it is commented there.
 276:    *
 277:    * WHAT IS NOT CHECKED: `any`, `as`, `@ts-ignore`, `@ts-nocheck`, mutating the adapter's object at
 278:    * run time, pointing `AT_REPO_ROOT` at a different tree, and REBUILDING A WIDENED CONTEXT BY HAND
 279:    * out of the derived types (measured, and documented on `SeamOpenWorld` above) all still work. The
 280:    * threat model is a suite DRIFTING from its harness with nobody able to notice â€” an honest mistake
 281:    * that type-checks green â€” not an author set on defeating the type system, who can always write a
 282:    * cast, and who now has to write something at least as deliberate as one.
 283:    */
 284:   sut: Sut;
 285: };
 286: 
 287: /**
 288:  * What `open()` hands a test body, for the suite bound to requirement `R` and sut key `K`.
 289:  *
 290:  * Named by TWO STRINGS, never by a shape â€” see `SeamOpenWorld` above for why that distinction is
 291:  * the whole protection rather than a stylistic preference.
 292:  */
 293: export type OpenWorld<R extends SuiteId, K extends SutKeyOf<R>, T extends Tier = 'loop'> = SeamOpenWorld<
 294:   SutOf<R, K>,
 295:   WorldOf<R>,
 296:   T
 297: >;
 298: 
 299: export interface OpenOverrides {
 300:   /**
 301:    * Re-tune pinned values for THIS world only, so one authored body can be run against two
 302:    * materially different configurations. A key the at-config registry does not already carry
 303:    * throws: an override may re-tune a knob that exists, never invent one the product has not
 304:    * got.
 305:    */
 306:   config?: ConfigOverrides;
 307: }
 308: 
 309: /** The STRUCTURE of what a test body is given â€” not exported, for the reason on `SeamOpenWorld`. */
 310: type SeamContext<Sut = unknown, W extends WorldLike = WorldLike, T extends Tier = 'loop'> = {
 311:   atId: string;
 312:   /** build a fresh "Given" world (and its own harness). Call it more than once for isolation. */
 313:   open(fixture?: string, opts?: OpenOverrides): Promise<SeamOpenWorld<Sut, W, T>>;
 314:   /** consume an immutable capture whose producer proved at least one real open() */
 315:   capture<C>(evidence: EvidenceCaptureImpl<C, Sut, W, T>): Promise<C>;
 316: };
 317: 
 318: /** Everything a test body is given. `atId` is read-only context, never re-supplied to open(). */
 319: export type AtContext<R extends SuiteId, K extends SutKeyOf<R>, T extends Tier = 'loop'> = SeamContext<
 320:   SutOf<R, K>,
 321:   WorldOf<R>,
 322:   T
 323: >;
 324: 
 325: const USAGE = Symbol('at-context-usage');
 326: 
 327: interface Usage {
 328:   opens: number;
 329:   captures: number;
 330: }
 331: 
 332: /**
 333:  * NOT EXPORTED, and a type alias rather than an interface, for the two different reasons this file
 334:  * keeps apart: not exported so no suite can name it, an alias so nothing can merge a member into it
 335:  * even from inside this module. It is reachable from a test body â€” `capture()` hands it to an
 336:  * evidence producer â€” and everything on that path obeys the alias rule.
 337:  */
 338: type InternalContext<Sut, W extends WorldLike, T extends Tier = 'loop'> = SeamContext<Sut, W, T> & {
 339:   [USAGE]: Usage;
 340: };
 341: 
 342: /** Where in the captured structure a value sits, said in words a test author can act on. */
 343: function evidencePath(path: string): string {
 344:   return path ? `the captured value at ${JSON.stringify(path)}` : 'the captured value';
 345: }
 346: 
 347: function constructorName(value: object): string {
 348:   return Object.getPrototypeOf(value)?.constructor?.name ?? 'an object with an exotic prototype';
 349: }
 350: 
 351: /**
 352:  * Deep-freeze a capture â€” and REFUSE anything that freezing does not actually make immutable.
 353:  *
 354:  * `Object.freeze` is shallow in a second sense nobody expects: it seals a Map's own properties
 355:  * and leaves `set`/`delete` fully working, and the same is true of a Set, a Date and any class
 356:  * instance with mutating methods. So a capture carrying one of those LOOKS frozen and is not â€”
 357:  * which defeats the whole point of capture-once/assert-many, where one lens normalizing or
 358:  * de-duplicating evidence in place would hide it from the next lens. Silently freezing such a
 359:  * value is worse than rejecting it, because the immutability the suites are told to rely on
 360:  * would be a lie in exactly the cases that matter.
 361:  *
 362:  * So the accepted shapes are the ones freezing genuinely closes: primitives, arrays, and plain
 363:  * objects (`Object.prototype` or a null prototype â€” what `structuredClone` and object literals
 364:  * produce). Everything else throws, naming the path, so the producer converts it to inert data
 365:  * (a Date to an ISO string, a Map to entries) where the conversion is visible.
 366:  */
 367: export function freezeEvidence<T>(value: T, path = '', seen = new WeakSet<object>()): T {
 368:   if (value === null) return value;
 369:   const type = typeof value;
 370:   if (type === 'undefined' || type === 'string' || type === 'number' || type === 'boolean' || type === 'bigint') return value;
 371:   if (type === 'function') {
 372:     throw new Error(`${evidencePath(path)} is a function â€” captured evidence must be inert data, not something that can still run`);
 373:   }
 374:   if (type === 'symbol') {
 375:     throw new Error(`${evidencePath(path)} is a symbol â€” captured evidence must be inert data an assertion can read`);
 376:   }
 377: 
 378:   const object = value as unknown as object;
 379:   if (seen.has(object)) return value;
 380:   seen.add(object);
 381: 
 382:   if (Array.isArray(object)) {
 383:     for (const [index, child] of object.entries()) freezeEvidence(child, `${path}[${index}]`, seen);
 384:     return Object.freeze(value);
 385:   }
 386: 
 387:   const proto = Object.getPrototypeOf(object);
 388:   if (proto !== null && proto !== Object.prototype) {
 389:     throw new Error(
 390:       `${evidencePath(path)} is a ${constructorName(object)} â€” freezeEvidence accepts only primitives, ` +
 391:         `arrays and plain objects, because Object.freeze leaves a Map, Set, Date or class instance ` +
 392:         `mutable through its own methods. Capture it as inert data instead.`,
 393:     );
 394:   }
 395: 
 396:   for (const [key, child] of Object.entries(object as Record<string, unknown>)) {
 397:     freezeEvidence(child, path ? `${path}.${key}` : key, seen);
 398:   }
 399:   return Object.freeze(value);
 400: }
 401: 
 402: export function captureProducerProblem(opensBefore: number, opensAfter: number): string | null {
 403:   return opensAfter === opensBefore ? 'capture producer completed without open()' : null;
 404: }
 405: 
 406: /**
 407:  * The implementation class, DELIBERATELY NOT EXPORTED â€” only the type alias below is.
 408:  *
 409:  * An exported class is a value with a public constructor, so `new EvidenceCapture<T, Anything,
 410:  * AnythingElse>(name, producer)` was a way to hand a producer a fabricated `AtContext` without ever
 411:  * touching `bindSuite`: the same lie as the one AI4DEV-31 closes at `open()`, reached through a
 412:  * `new`. Exporting only the type removes the constructor from a suite's reach, and has the second
 413:  * effect of making `EvidenceCapture` a type ALIAS, which declaration merging cannot open.
 414:  */
 415: class EvidenceCaptureImpl<C, Sut = unknown, W extends WorldLike = WorldLike, T extends Tier = 'loop'> {
 416:   private result: Promise<C> | null = null;
 417:   private producerAtId = '';
 418: 
 419:   constructor(
 420:     readonly name: string,
 421:     /** the suite this capture reads the seam of â€” it is in the failure text so a red says whose */
 422:     readonly requirement: string,
 423:     private readonly producer: (ctx: SeamContext<Sut, W, T>) => Promise<C>,
 424:   ) {}
 425: 
 426:   consume(ctx: InternalContext<Sut, W, T>): Promise<C> {
 427:     if (!this.result) {
 428:       this.producerAtId = ctx.atId;
 429:       const opensBefore = ctx[USAGE].opens;
 430:       this.result = (async () => {
 431:         try {
 432:           const value = await this.producer(ctx);
 433:           const problem = captureProducerProblem(opensBefore, ctx[USAGE].opens);
 434:           if (problem) {
 435:             throw new Error(`evidence capture ${JSON.stringify(this.name)} produced by ${ctx.atId} â€” ${problem}`);
 436:           }
 437:           return freezeEvidence(value);
 438:         } catch (err) {
 439:           const detail = err instanceof Error ? err.message : String(err);
 440:           throw new Error(
 441:             `evidence capture ${JSON.stringify(this.name)} (${this.requirement}) produced by ${this.producerAtId} failed â€” ${detail}`,
 442:             { cause: err },
 443:           );
 444:         }
 445:       })();
 446:     }
 447:     return this.result;
 448:   }
 449: }
 450: 
 451: /**
 452:  * An immutable capture, consumable by any test in the suite that defined it.
 453:  *
 454:  * A TYPE, never the class â€” and named by a requirement and a sut key, never by a shape. Both halves
 455:  * matter: the class would expose a constructor that takes a producer at any types, and shape
 456:  * parameters would let a body widen the context it is handed. See `SeamOpenWorld`.
 457:  */
 458: export type EvidenceCapture<T, R extends SuiteId, K extends SutKeyOf<R>> = EvidenceCaptureImpl<T, SutOf<R, K>, WorldOf<R>>;
 459: 
 460: /**
 461:  * `defineEvidenceCapture` was the SECOND door to the seam AI4DEV-31 closes, and closing `bindSuite`
 462:  * alone would have moved the defect rather than removed it: this function handed its producer a
 463:  * full `AtContext<Sut, W>` at whatever types the caller named, so a suite that never called
 464:  * `bindSuite` could still declare a system under test and a world out of nothing and read both green.
 465:  *
 466:  * So it takes the BINDING and derives, exactly as `atTest` does. There is no type argument left to
 467:  * lie with: `SutOf<R, K>` and `WorldOf<R>` come from the adapter registered under `R`.
 468:  *
 469:  * A `const` typed by a call-signature alias, NOT an exported `function` declaration â€” that is not
 470:  * stylistic. Gate 1 measured that an exported function declaration can be given a fresh generic
 471:  * overload through `declare module`, restoring the fabricated type argument, and that type aliases
 472:  * do not protect it. A `const` has no declaration to merge an overload into.
 473:  */
 474: type DefineEvidenceCaptureFn = <T, R extends SuiteId, K extends SutKeyOf<R>>(
 475:   binding: SuiteBinding<R, K>,
 476:   name: string,
 477:   producer: (ctx: AtContext<R, K>) => Promise<T>,
 478: ) => EvidenceCapture<T, R, K>;
 479: 
 480: export const defineEvidenceCapture: DefineEvidenceCaptureFn = (binding, name, producer) =>
 481:   new EvidenceCaptureImpl(name, binding.requirement, producer);
 482: 
 483: export function testUseProblem(opens: number, captures: number): string | null {
 484:   return opens === 0 && captures === 0 ? 'test body never opened a fixture world or consumed trusted captured evidence' : null;
 485: }
 486: 
 487: /**
 488:  * Runs one body and refuses a pass that observed nothing.
 489:  *
 490:  * Still parameterized by SHAPE rather than by `<R, K>`, and that is not an oversight. It is not a
 491:  * door to the seam: it never produces a harness-backed value, so the only context it can be given
 492:  * is one the caller built by hand â€” fabricating a type there is a caller lying to itself about its
 493:  * own object, with no harness claim anywhere in it. Keeping the structural signature is also what
 494:  * lets `conformance.selftest.ts` drive it with a hand-built context, which is the point of the
 495:  * false-green reproduction it appears in.
 496:  */
 497: export async function executeRegisteredBody<Sut, W extends WorldLike>(
 498:   atId: string,
 499:   body: (ctx: SeamContext<Sut, W>) => Promise<void>,
 500:   ctx: SeamContext<Sut, W>,
 501:   usage: Usage,
 502: ): Promise<void> {
 503:   await body(ctx);
 504:   const problem = testUseProblem(usage.opens, usage.captures);
 505:   if (problem) throw new Error(`${atId} INVALID â€” ${problem}`);
 506: }
 507: 
 508: /* ------------------------------------------------------------------------ teardown accounting */
 509: 
 510: /** One thing a test built and must give back, named so a failure says which one. */
 511: export interface TrackedTeardown {
 512:   /** plain words for the thing being torn down, e.g. `fixture world "req-016/base"` */
 513:   what: string;
 514:   teardown(): Promise<void>;
 515: }
 516: 
 517: export interface TeardownFailure {
 518:   what: string;
 519:   error: unknown;
 520: }
 521: 
 522: function errorText(error: unknown): string {
 523:   return error instanceof Error ? error.message : String(error);
 524: }
 525: 
 526: /**
 527:  * Tear down everything the test built â€” worlds first, then harnesses, last-opened-first within
 528:  * each â€” ATTEMPTING EVERY ONE and collecting the rejections rather than stopping at the first.
 529:  *
 530:  * Attempting all of them is the point: giving up after one rejection leaves the rest of the stack
 531:  * standing, and a frozen clock, an armed fault or a vendor counter that survives into the next id
 532:  * is exactly the cross-test leak the per-test teardown exists to prevent.
 533:  */
 534: export async function drainTeardowns(worlds: TrackedTeardown[], harnesses: TrackedTeardown[]): Promise<TeardownFailure[]> {
 535:   const failures: TeardownFailure[] = [];
 536:   const drain = async (stack: TrackedTeardown[]) => {
 537:     while (stack.length) {
 538:       const entry = stack.pop()!;
 539:       try {
 540:         await entry.teardown();
 541:       } catch (err) {
 542:         failures.push({ what: entry.what, error: err });
 543:       }
 544:     }
 545:   };
 546:   await drain(worlds);
 547:   await drain(harnesses);
 548:   return failures;
 549: }
 550: 
 551: /**
 552:  * One acceptance test's whole lifecycle: run the body, tear everything down, then decide.
 553:  *
 554:  * WHY THE VERDICT LIVES HERE rather than in a `finally` that swallows teardown rejections â€”
 555:  * which is what this used to do: a world whose teardown rejected did NOT release what it holds,
 556:  * so the next id inherits it. Reporting that as green is a false green of the worst kind, because
 557:  * the damage lands on a different test and the report blames the wrong id.
 558:  *
 559:  * When the body already failed, the body's error still wins the report: it is the more specific
 560:  * fact, and a teardown that rejects because the body left the world half-built is a symptom, not
 561:  * the cause. The teardown failures are printed so they are never invisible.
 562:  */
 563: export async function runTrackedTest(
 564:   atId: string,
 565:   run: () => Promise<void>,
 566:   worlds: TrackedTeardown[],
 567:   harnesses: TrackedTeardown[],
 568: ): Promise<void> {
 569:   let bodyFailed = false;
 570:   let bodyError: unknown;
 571:   try {
 572:     await run();
 573:   } catch (err) {
 574:     bodyFailed = true;
 575:     bodyError = err;
 576:   }
 577: 
 578:   const failures = await drainTeardowns(worlds, harnesses);
 579: 
 580:   if (bodyFailed) {
 581:     for (const failure of failures) {
 582:       console.error(`${atId} â€” teardown ALSO failed (${failure.what}): ${errorText(failure.error)}`);
 583:     }
 584:     throw bodyError;
 585:   }
 586: 
 587:   if (failures.length) {
 588:     const summary = failures.map((failure) => `${failure.what}: ${errorText(failure.error)}`).join('; ');
 589:     throw new AggregateError(
 590:       failures.map((failure) => (failure.error instanceof Error ? failure.error : new Error(errorText(failure.error)))),
 591:       `${atId} INVALID â€” the body passed but ${failures.length} teardown${failures.length === 1 ? '' : 's'} failed, ` +
 592:         `so state this test built leaks into the next id: ${summary}`,
 593:     );
 594:   }
 595: }
 596: 
 597: interface OpenOptions {
 598:   atId: string;
 599:   requirement: string;
 600:   sutKey: string;
 601:   sutMissing: string;
 602:   fixture: string;
 603:   configOverrides?: ConfigOverrides;
 604: }
 605: 
 606: /**
 607:  * Builds a harness and a world, at the types the HARNESS can actually prove: `sut` is `unknown`
 608:  * (`h.sut[key]` on a concrete `AtHarness`) and `w` is a bare `WorldLike`. It deliberately knows
 609:  * nothing about any suite â€” the narrowing to that suite's derived types happens once, at the end of
 610:  * `open()`, where the comment says exactly what is still taken on trust.
 611:  */
 612: async function openWorld(o: OpenOptions): Promise<{ opened: SeamOpenWorld; harness: AtHarness }> {
 613:   if (TIER === null) throw new AtPending(o.atId, 'tier-unset', tierError(o.requirement));
 614: 
 615:   if (!harnessModule) {
 616:     throw new AtPending(
 617:       o.atId,
 618:       'harness-missing',
 619:       `AI4DEV-3 capability modules (H2 fixtures/clock, H3 sentinels/faults, H4 oracles, ` +
 620:         `H5 vendor sims) are not in the tree: cannot resolve "${HARNESS_MODULE}" ` +
 621:         `from tests/at/harness (${harnessResolveError})`,
 622:     );
 623:   }
 624: 
 625:   const h = await harnessModule.createHarness({
 626:     requirement: `req-${o.requirement}`,
 627:     tier: TIER,
 628:     configOverrides: o.configOverrides,
 629:   });
 630:   // Tracked from here on: every later failure must still tear the harness down.
 631:   try {
 632:     expect(h.tier, `harness built tier "${h.tier}" for a --tier ${TIER} run`).toBe(TIER);
 633: 
 634:     /*
 635:      * TIER SEMANTICS: above `loop`, nothing the suite leans on may be a stand-in. The RULE is
 636:      * unchanged and is not relaxed by one capability. What changed is the SHAPE OF THE REFUSAL.
 637:      *
 638:      * This was a bare `expect(await h.stubbedCapabilities()).toEqual([])`, and the failure it
 639:      * produced fit NEITHER declarable red kind â€” so an integration run of any suite was not merely
 640:      * red, it was UNDECLARABLE, and `--expect` could never be honoured at the tier that is the
 641:      * closing gate. A red nobody can describe exactly is a red nobody understands, which is the
 642:      * doctrine `expected.ts` states and this line contradicted.
 643:      *
 644:      * `CapabilityPending` names the exact stubbed capabilities, which is precisely the
 645:      * `capability-pending` shape a declaration rebuilds and compares from position 0. The gate is if
 646:      * anything STRICTER than before: the names travel into the report, so a declaration has to say
 647:      * WHICH capabilities are still stubbed rather than only that some are.
 648:      *
 649:      * `expect.hasAssertions()` is satisfied by the throw rather than by an assertion, exactly as it
 650:      * is for every `AtPending` body in every suite: a thrown error is the reported failure and the
 651:      * assertion count is not consulted.
 652:      */
 653:     const stubRefusal = aboveLoopStubbedRefusal(TIER, await h.stubbedCapabilities());
 654:     if (stubRefusal) throw stubRefusal;
 655: 
 656:     const sut = h.sut?.[o.sutKey];
 657:     if (!sut) throw new AtPending(o.atId, 'sut-missing', o.sutMissing);
 658: 
 659:     const w = await h.fixtures.world(o.fixture);
 660:     return { opened: { h, w, sut }, harness: h };
 661:   } catch (err) {
 662:     await h.teardown().catch(() => undefined);
 663:     throw err;
 664:   }
 665: }
 666: 
 667: /* ------------------------------------------------------------------------------- registration */
 668: 
 669: /** One authored test body, for the suite bound to requirement `R` and sut key `K`, at tier `T`. */
 670: export type AtTestBody<R extends SuiteId, K extends SutKeyOf<R>, T extends Tier = 'loop'> = (
 671:   ctx: AtContext<R, K, T>,
 672: ) => Promise<void>;
 673: 
 674: /**
 675:  * ONE BODY PER ID PER TIER â€” the per-tier body form.
 676:  *
 677:  * WHY IT EXISTS. Some acceptance criteria are proved by DIFFERENT PROCEDURES at different tiers,
 678:  * proving the same criterion. AT-001.12's expiry arm at loop tier commands a controlled clock
 679:  * forward; at integration there is nothing to command, and the same criterion is proved by waiting
 680:  * out a real access token against a real GoTrue. Writing one body that branched on the tier would put
 681:  * two procedures inside one function with a conditional deciding which claim was being made â€” and a
 682:  * body that reads `if (h.tier === â€¦)` is a body whose green means something different depending on a
 683:  * value the reader has to trace.
 684:  *
 685:  * WHAT DOES NOT FORK. The CRITERION never forks: both bodies carry the same acceptance text in their
 686:  * title, and the id is registered once. What forks is the procedure and, with it, the capabilities
 687:  * the procedure may reach â€” which is what the per-tier context types carry.
 688:  *
 689:  * EVERY TIER MUST BE COVERED, and that is refused rather than defaulted. `analyzeReportedTests()`
 690:  * requires EXACTLY ONE runtime registration and EXACTLY ONE vitest result per expected id; a map
 691:  * that named only `loop` would emit neither at integration, and the id would be reported `missing` â€”
 692:  * a state no declaration can describe. So a map either names every tier or supplies `default` for
 693:  * the ones it does not, and a map that leaves a hole is an error AT THE CALL SITE, where it is
 694:  * written, rather than a missing row three commands later.
 695:  */
 696: export type AtTestBodies<R extends SuiteId, K extends SutKeyOf<R>> = {
 697:   /**
 698:    * The body for every tier this map does not name â€” typed at the LOOP tier, exactly as the
 699:    * single-body form is, because it is the single-body form wearing a key. See `AtTestFn` for why
 700:    * that is the tier the shared shape is written at, and what it does and does not protect.
 701:    */
 702:   default?: AtTestBody<R, K, 'loop'>;
 703:   loop?: AtTestBody<R, K, 'loop'>;
 704:   integration?: AtTestBody<R, K, 'integration'>;
 705:   drill?: AtTestBody<R, K, 'drill'>;
 706: };
 707: 
 708: /**
 709:  * The tier's body, or the problem that means there is none. PURE, so the refusal is unit testable.
 710:  *
 711:  * A bare function is the single-body form and covers every tier â€” every suite in this tree is
 712:  * written that way and none of them changes.
 713:  */
 714: export function tierBodyProblem(bodies: Record<string, unknown>, atId: string): string | null {
 715:   const named = TIERS.filter((tier) => typeof bodies[tier] === 'function');
 716:   if (named.length === 0 && typeof bodies.default !== 'function') {
 717:     return (
 718:       `${atId} was registered with a per-tier body map that names no body at all â€” neither a tier nor a default. ` +
 719:       `One id, one body per tier.`
 720:     );
 721:   }
 722:   const uncovered = TIERS.filter((tier) => typeof bodies[tier] !== 'function');
 723:   if (uncovered.length && typeof bodies.default !== 'function') {
 724:     return (
 725:       `${atId} was registered with a per-tier body map that covers ${named.join(', ')} but not ` +
 726:       `${uncovered.join(', ')}, and supplies no default. An id with no body at a tier reports as MISSING there, ` +
 727:       `which no declaration can describe â€” supply a body for every tier, or a default.`
 728:     );
 729:   }
 730:   return null;
 731: }
 732: 
 733: /**
 734:  * WHICH body a per-tier map supplies for a tier. PURE, so the choice is unit testable without
 735:  * registering anything with vitest.
 736:  *
 737:  * `null` for the tier means the map named a body for a DIFFERENT tier and no default â€” which
 738:  * `tierBodyProblem` refuses before this is ever consulted in the real path. It is returned rather
 739:  * than thrown so the selftest can state the rule positively: a body written for one tier does not
 740:  * run at another.
 741:  */
 742: export function chooseTierBody<B>(bodies: Record<string, B | undefined>, tier: Tier | null): B | null {
 743:   const named = tier === null ? undefined : bodies[tier];
 744:   return named ?? bodies.default ?? bodies.loop ?? null;
 745: }
 746: 
 747: /**
 748:  * THE ABOVE-LOOP STAND-IN REFUSAL, as a value rather than as a statement inside `openWorld`.
 749:  *
 750:  * It is exported and pure for one reason: `expected.ts` rebuilds the text a declared
 751:  * `capability-pending` red must produce, and the ONLY way to know the two agree is to compare them.
 752:  * `live-ledger.selftest.ts` does exactly that, so a wording change on either side breaks a test
 753:  * instead of silently making every integration declaration unmatchable.
 754:  */
 755: export function aboveLoopStubbedRefusal(tier: Tier, stubbed: readonly string[]): CapabilityPending | null {
 756:   if (tier === 'loop' || stubbed.length === 0) return null;
 757:   return new CapabilityPending([...stubbed]);
 758: }
 759: 
 760: function emitRuntimeRegistration(registration: Registration): void {
 761:   const dir = process.env.AT_REGISTRATION_DIR;
 762:   if (!dir) return;
 763:   mkdirSync(dir, { recursive: true });
 764:   appendFileSync(join(dir, `registration-${process.pid}.jsonl`), `${JSON.stringify(registration)}\n`, 'utf8');
 765: }
 766: 
 767: /**
 768:  * THE ONE PLACE the AT id's requirement and the binding's requirement are made to agree.
 769:  *
 770:  * They are two independent strings that must denote the same suite: the id decides which fixture
 771:  * adapter `createHarness()` loads at RUN time (`openWorld` passes `parsed.requirement` straight
 772:  * through), while the binding decides which adapter the TYPES were read off at compile time. Left
 773:  * unchecked, `AT-017.03` registered through a suite bound to `req-016` would drive req-017's
 774:  * implementation while every type in the body described req-016's, and both halves would look fine.
 775:  *
 776:  * The formats differ and the comparison must normalize, or it would reject every valid suite:
 777:  * `parseAtId('AT-016.01').requirement` is `"016"`, whereas the binding and the registry key are
 778:  * `"req-016"`.
 779:  *
 780:  * The field stays MANDATORY. Making the check fire only when a requirement happens to be supplied
 781:  * would reopen the hole through the door marked convenience â€” so a binding with no requirement is
 782:  * its own error, not a skipped check.
 783:  */
 784: export function requirementMismatch(atId: string, parsedRequirement: string, bound: string): string | null {
 785:   if (!bound) {
 786:     return (
 787:       `${atId} was registered with no requirement â€” atTest cannot check that the suite whose types ` +
 788:       `were used is the suite whose fixture adapter will be loaded. Bind the suite with ` +
 789:       `bindSuite({ requirement: 'req-${parsedRequirement}', sut: â€¦ }).`
 790:     );
 791:   }
 792:   const fromId = `req-${parsedRequirement}`;
 793:   if (fromId === bound) return null;
 794:   return (
 795:     `${atId} was registered through a suite bound to ${bound} â€” at run time the harness would load ` +
 796:     `${fromId}'s fixture adapter, because the requirement comes from the AT id, while the ` +
 797:     `type-check described ${bound}'s. One id, one suite: correct the id or correct the binding.`
 798:   );
 799: }
 800: 
 801: /**
 802:  * Register one acceptance test. The id is declared here and nowhere else.
 803:  *
 804:  * - a malformed id throws AT REGISTRATION â€” the id is checked where it is written.
 805:  * - the id's requirement must match the suite's binding, for the reason above.
 806:  * - `expect.hasAssertions()` makes a body that asserts nothing a RED, so a tagged test cannot
 807:  *   satisfy the bijection checker by existing.
 808:  * - worlds AND harnesses are tracked per test and always torn down, so a frozen clock, a vendor
 809:  *   counter or an armed fault cannot leak into the next id â€” and a teardown that REJECTS fails
 810:  *   the test rather than being swallowed, because state that was never released is a defect that
 811:  *   would otherwise land on a different id.
 812:  *
 813:  * THE BODY'S TYPES ARE DERIVED, NOT ACCEPTED. `Sut` and `W` used to be this function's own type
 814:  * parameters, filled in by whatever the suite wrote; now they are `SutOf<R, K>` and `WorldOf<R>`,
 815:  * read off the adapter registered under `R` in `suite-adapters.ts`. There is no type argument left
 816:  * for a suite to lie with.
 817:  *
 818:  * A `const` typed by a call-signature alias, NOT an exported `function` declaration, for the reason
 819:  * given on `defineEvidenceCapture`: a function declaration accepts a merged-in overload and a
 820:  * `const` does not.
 821:  *
 822:  * THE SINGLE-BODY FORM IS TYPED AT THE LOOP TIER, and it is worth saying exactly what that does and
 823:  * does not buy. One body runs at every tier, so it is typed at the tier with the RICHEST
 824:  * capabilities â€” the loop tier, whose clock can be commanded and whose vendor seam can be armed.
 825:  * That keeps every suite in this tree compiling unchanged, and it means the type system does NOT
 826:  * stop a single body from commanding a clock that, above loop, is the passage of time.
 827:  *
 828:  * WHAT DOES STOP IT is the per-tier form: an id whose procedure differs above loop supplies an
 829:  * integration body, and THAT body is typed at `'integration'`, where the two seams are absent from
 830:  * the type. So the protection is opt-in at exactly the ids that need it, which are the ids whose
 831:  * criteria are about real time and real mail. An id that needs it and does not take it fails at run
 832:  * time rather than at compile time, and the fix is to write the body, not to widen the type.
 833:  */
 834: type AtTestFn = {
 835:   <R extends SuiteId, K extends SutKeyOf<R>>(
 836:     atId: string,
 837:     title: string,
 838:     opts: AtTestOptions & SuiteBinding<R, K>,
 839:     body: AtTestBody<R, K, 'loop'> | AtTestBodies<R, K>,
 840:   ): void;
 841: };
 842: 
 843: export const atTest: AtTestFn = <R extends SuiteId, K extends SutKeyOf<R>>(
 844:   atId: string,
 845:   title: string,
 846:   opts: AtTestOptions & SuiteBinding<R, K>,
 847:   body: AtTestBody<R, K, 'loop'> | AtTestBodies<R, K>,
 848: ): void => {
 849:   if (typeof body !== 'function' && (body === null || typeof body !== 'object')) {
 850:     throw new Error(`${atId}: atTest was given no test body`);
 851:   }
 852: 
 853:   /*
 854:    * WHICH BODY RUNS, decided here and once.
 855:    *
 856:    * A bare function is the single-body form: one procedure, every tier, exactly as every suite in
 857:    * this tree is written today. A MAP is the per-tier form, and the tier is resolved from `TIER` â€”
 858:    * the runner's own value, with no default anywhere â€” so the body that registers is the body
 859:    * written for the tier this process is running.
 860:    *
 861:    * A MAP WITH A HOLE IS REFUSED AT REGISTRATION, not skipped. `tierBodyProblem` says why: an id
 862:    * with no body at a tier reports MISSING there, and MISSING is the one state no declaration can
 863:    * describe. Refusing at the call site puts the error where the map is written.
 864:    *
 865:    * WITH `AT_TIER` UNSET there is no tier to choose, so the map's `default` â€” or, failing that, the
 866:    * loop body â€” registers, and `openWorld` refuses with `tier-unset` on its first `open()` exactly
 867:    * as it always has. The alternative would be registering NOTHING, which turns a plainly-diagnosed
 868:    * misuse into an unexplained missing row.
 869:    */
 870:   const resolved: AtTestBody<R, K, 'loop'> = (() => {
 871:     if (typeof body === 'function') return body;
 872:     const problem = tierBodyProblem(body as Record<string, unknown>, atId);
 873:     if (problem) throw new Error(problem);
 874:     const chosen = chooseTierBody(body as Record<string, unknown>, TIER);
 875:     // THE ONE BRIDGE BETWEEN THE TWO TIERS' CONTEXT TYPES, and it is a widening of a NARROWER type.
 876:     // An integration body is written against a context whose clock and vendor seams have FEWER
 877:     // members, so the object built below â€” which has all of them â€” satisfies it; what the cast says
 878:     // is that this function hands one runtime object to bodies written at two different types, and
 879:     // the direction is always narrow-body/wide-object. A body cannot reach a member the object
 880:     // lacks, because no tier's type names one the loop type does not.
 881:     return chosen as AtTestBody<R, K, 'loop'>;
 882:   })();
 883: 
 884:   const parsed = parseAtId(atId);
 885:   const mismatch = requirementMismatch(atId, parsed.requirement, opts.requirement);
 886:   if (mismatch) throw new Error(mismatch);
 887: 
 888:   const previous = registrations.get(atId);
 889:   if (previous) throw new Error(`${atId} is registered twice ("${previous.title}" and "${title}") â€” one id, one test`);
 890:   const registration = { ...parsed, title, surface: opts.surface ?? 'backend' };
 891:   registrations.set(atId, registration);
 892:   emitRuntimeRegistration(registration);
 893: 
 894:   const sutKey = opts.sut;
 895:   const sutMissing =
 896:     opts.sutMissingDetail ?? `REQ-${parsed.requirement}'s implementation is not in the tree â€” harness.sut.${sutKey} is absent`;
 897: 
 898:   it(`${atId} â€” ${title}`, async () => {
 899:     expect.hasAssertions();
 900: 
 901:     const worlds: TrackedTeardown[] = [];
 902:     const harnesses: TrackedTeardown[] = [];
 903:     const usage: Usage = { opens: 0, captures: 0 };
 904:     const ctx: InternalContext<SutOf<R, K>, WorldOf<R>, 'loop'> = {
 905:       atId,
 906:       [USAGE]: usage,
 907:       open: async (fixture = `req-${parsed.requirement}/base`, openOpts) => {
 908:         const { opened, harness } = await openWorld({
 909:           atId,
 910:           requirement: parsed.requirement,
 911:           sutKey,
 912:           sutMissing,
 913:           fixture,
 914:           configOverrides: openOpts?.config,
 915:         });
 916:         harnesses.push({ what: `harness for fixture world ${JSON.stringify(fixture)}`, teardown: () => harness.teardown() });
 917:         worlds.push({ what: `fixture world ${JSON.stringify(fixture)}`, teardown: () => opened.w.teardown() });
 918:         usage.opens += 1;
 919:         // THE ONE SURVIVING ASSERTION, and exactly what it still takes on trust.
 920:         //
 921:         // `h.sut[key]` is `unknown` and `h.fixtures.world()` is `WorldSeam`, because `h` is the
 922:         // concrete `AtHarness` the factory is checked to produce and that type deliberately says
 923:         // nothing about any one suite. No run-time value can prove its own static type, so this
 924:         // relabelling cannot be removed â€” only moved to where the claim is smallest.
 925:         //
 926:         // What changed is WHOSE claim it is. It used to be the suite's: `bindSuite<X, Y>` named two
 927:         // types and this line stamped them onto whatever the harness returned, so any pair of names
 928:         // was accepted. Now both come from `suite-adapters.ts`, which reads them off the adapter
 929:         // module that the `requirement` literal proves is the module `loadAdapter()` imports â€”
 930:         // checked at the map entry, and again at run time in `index.ts`.
 931:         //
 932:         // So what remains unchecked here is narrow and nameable: that the object `createHarness()`
 933:         // built at run time really is the one that module's `createFixtureAdapter()` returned. That
 934:         // holds unless somebody casts inside `index.ts` or mutates the adapter after it is built â€”
 935:         // both trusted-author escapes this item does not claim to close.
 936:         return opened as OpenWorld<R, K, 'loop'>;
 937:       },
 938:       capture: async (evidence) => {
 939:         const value = await evidence.consume(ctx);
 940:         usage.captures += 1;
 941:         return value;
 942:       },
 943:     };
 944: 
 945:     await runTrackedTest(atId, () => executeRegisteredBody(atId, resolved, ctx, usage), worlds, harnesses);
 946:   });
 947: };
 948: 
 949: /* ------------------------------------------------------------------------------ suite binding */
 950: 
