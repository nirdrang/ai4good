 201: /**
 202:  * AT-001.06 â€” a volunteer is refused the NGO-only action while an NGO performs it.
 203:  *
 204:  * THE CONTROL IS NOT OPTIONAL: an operation that refuses everybody would satisfy the negative half
 205:  * on its own, so the NGO succeeds FIRST and the volunteer's refusal is then attributable to the
 206:  * account type.
 207:  *
 208:  * THE LINKED IDENTITY IS A GIVEN HERE, and it is written by the operator. Since the GitHub leaf a
 209:  * volunteer cannot complete signup without one; the refusal under test is the NGO-only one, so the
 210:  * volunteer has to reach the state of being a signed-up volunteer first. AT-001.04 owns the link
 211:  * rule and is declared red at this tier for exactly the reason that rule cannot be proved live.
 212:  */
 213: export async function at00106(ctx: Ctx): Promise<void> {
 214:   const { w, sut } = await ctx.open();
 215: 
 216:   const ngo = await registerConfirmAndSignIn(sut, w.email('ngo-actor'));
 217:   const ngoCompletion = await sut.completeSignup(
 218:     ngo,
 219:     { accountType: 'ngo', organizationName: 'Riverside Shelter', acknowledgmentTextVersion: TEXT_VERSION },
 220:     CLIENT_IP,
 221:   );
 222:   expect(ngoCompletion, 'the NGO control could not complete signup').toMatchObject({ ok: true });
 223:   if (!ngoCompletion.ok) return;
 224: 
 225:   const ngoAction = await sut.createOrganization(ngo, 'Riverside Shelter Second Programme');
 226:   expect(ngoAction, 'the NGO control was refused the NGO-only action, so the refusal below proves nothing').toMatchObject({
 227:     ok: true,
 228:   });
 229:   if (!ngoAction.ok) return;
 230:   expect(await sut.organization(ngoAction.organizationId)).toMatchObject({ name: 'Riverside Shelter Second Programme' });
 231:   expect(await sut.membership(ngoAction.organizationId, ngoCompletion.accountId)).toMatchObject({ role: 'admin' });
 232: 
 233:   const volunteer = await registerConfirmAndSignIn(sut, w.email('volunteer-actor'));
 234:   await sut.linkGithubIdentity(volunteer, 'volunteer-actor-handle');
 235:   const volunteerCompletion = await sut.completeSignup(
 236:     volunteer,
 237:     { accountType: 'volunteer', acknowledgmentTextVersion: TEXT_VERSION },
 238:     CLIENT_IP,
 239:   );
 240:   expect(volunteerCompletion, 'the volunteer could not complete signup, so the refusal below is not the one under test').toMatchObject(
 241:     { ok: true },
 242:   );
 243:   if (!volunteerCompletion.ok) return;
 244: 
 245:   const REFUSED_NAME = 'Riverside Shelter Copy';
 246:   const volunteerAction = await sut.createOrganization(volunteer, REFUSED_NAME);
 247:   expect(volunteerAction.ok, 'a volunteer account performed an NGO-only action').toBe(false);
 248:   if (volunteerAction.ok) return;
 249: 
 250:   // A REJECTION INCLUDES ITS WRITES NOT HAPPENING, and on the live stack that is row-level truth
 251:   // rather than a mirror: no organisation by the attempted name, and no membership anywhere.
 252:   expect(await sut.organizationsNamed(REFUSED_NAME), `the refused action created an organisation named ${REFUSED_NAME}`).toEqual([]);
 253:   expect(await sut.membershipsOf(volunteerCompletion.accountId), 'the refused action left the volunteer holding a membership').toEqual(
 254:     [],
 255:   );
 256:   expect(volunteerAction.reason).toMatch(/NGO accounts only/i);
 257:   expect(volunteerAction.reason).toMatch(/volunteer/i);
 258: }
