 182: function isPortKey(key: string): boolean {
 183:   return key === 'port' || key.endsWith('_port');
 184: }
 185: 
 186: /**
 187:  * A PORT VALUE, PARSED WHOLE (audit ruling A5).
 188:  *
 189:  * The rule is the ENTIRE value token, never a prefix of it. TOML writes an integer with optional
 190:  * underscores between digits, so `54_321` is a perfectly ordinary way to write a personal-block
 191:  * port â€” and a prefix parse reads it as `54`, which is in no band anybody checks. That is a hole
 192:  * in the wall's own guard, so the whole token must be an integer or this returns `null` and the
 193:  * caller treats the value as a PROBLEM.
 194:  *
 195:  * A trailing `# comment` is not part of the value and is dropped before the token is judged;
 196:  * anything else left beside the digits â€” quotes, an `env()` call, a second number â€” fails.
 197:  */
 198: function portValue(raw: string): number | null {
 199:   const token = raw.split('#')[0].trim();
 200:   if (!/^\d(?:_?\d)*$/.test(token)) return null;
 201:   return Number(token.replace(/_/g, ''));
 202: }
