 147: interface ConfigEntry {
 148:   line: number;
 149:   section: string;
 150:   key: string;
 151:   value: string;
 152: }
 153: 
 154: /**
 155:  * Every ACTIVE `key = value` in the file, with the section it sits in. Commented lines are not
 156:  * settings and are skipped â€” which is the whole reason the scan is section-aware rather than a
 157:  * set of regular expressions over the file: `port` appears in nine places and most of them are
 158:  * examples in comments.
 159:  *
 160:  * Multi-line array values are not read as one value. Nothing in this repo's config uses one, and
 161:  * a value this scanner cannot see is a value it never rewrites, so the failure mode is a config
 162:  * that is copied verbatim rather than one that is silently mis-edited.
 163:  */
 164: export function scanConfig(text: string): ConfigEntry[] {
 165:   const entries: ConfigEntry[] = [];
 166:   let section = '';
 167:   const lines = text.split('\n');
 168:   for (let index = 0; index < lines.length; index++) {
 169:     const line = lines[index].trim();
 170:     if (line.startsWith('#') || line === '') continue;
 171:     const header = /^\[([^\]]+)\]/.exec(line);
 172:     if (header) {
 173:       section = header[1];
 174:       continue;
 175:     }
 176:     const setting = /^([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)$/.exec(line);
 177:     if (setting) entries.push({ line: index, section, key: setting[1], value: setting[2].trim() });
 178:   }
 179:   return entries;
 180: }
