 174:  *
 175:  * The oracle witness used to accept BY ABSENCE on both axes: anything that was not `loop` counted
 176:  * as above loop, and anything that was not `replay-fs` counted as a transport worth a `real`
 177:  * verdict. That is "I found no forbidden thing, therefore the thing is present" â€” the sentence this
 178:  * file's own header forbids, on the only witness here whose `real` verdict is DERIVED. The three
 179:  * `theArticleItself` rows return `real` too, and on every run, but unconditionally and from a
 180:  * decision about the name; this is the one witness that reaches `real` by reasoning about evidence,
 181:  * so it is the only place that reasoning can be wrong. A
 182:  * `{ tier: 'integration', transport: 'bogus' }` construction came back `real` with confident-sounding
 183:  * evidence for a brand nobody had ever heard of.
 184:  *
 185:  * SOURCE OF TRUTH FOR EACH LIST, so a future divergence is findable:
 186:  *   tiers      â€” `Tier` in `registry.ts`
 187:  *   transports â€” `TransportKind` in `oracles.ts`
 188:  *
 189:  * These are deliberately NOT imported as types. `oracles.ts` imports this file, so importing back
 190:  * would add a cycle â€” and a compile-time union cannot constrain a runtime string anyway, which is
 191:  * the whole reason this check has to exist at all: `CapabilityEvidence.tier` and `.transport` are
 192:  * plain `string`, because the evidence arrives from a caller.
 193:  */
 194: const LEGAL_TIERS: readonly string[] = ['loop', 'integration', 'drill'];
 195: const LEGAL_TRANSPORTS: readonly string[] = ['replay-fs', 'live', 'fake'];
 196: 
 197: /**
 198:  * THE TABLE IS CLOSED: six exact names, no prefixes and no wildcards.
 199:  *
 200:  * A prefix rule (`sut.*` had one) means nobody ever decided about the names it swallows, which is
 201:  * an unlimited namespace inside a table whose whole claim is that it is closed. The two families
 202:  * that used to need one â€” `fixtures.worlds` and every `sut.<key>` â€” are off this table entirely and
 203:  * built through `adapterDerivedCapability()` below, so nothing looks a SUT name up and there is no
 204:  * typo surface left to guard.
 205:  */
 206: const WITNESSES = new Map<string, CapabilityWitness>([
 207:   [
 208:     'clock.controlled',
 209:     (value) => {
 210:       // The harness's `Clock` contract IS the control seam: freezeAt + advance. A capability that
 211:       // can be COMMANDED to jump forward is not the passage of time.
 212:       if (callable(value, 'freezeAt') && callable(value, 'advance')) {
 213:         return {
 214:           kind: 'stand-in',
 215:           reason:
 216:             'the value exposes the Clock control seam (freezeAt/advance) â€” time that can be commanded to jump ' +
 217:             'forward is not the passage of time',
 218:         };
 219:       }
 220:       // THE BRANCH THIS WITNESS'S OWN REFUSAL TEXT ANTICIPATED. It used to end "this tree holds no
 221:       // attested real clock backing to record in its place", which was true while nothing could
 222:       // produce one. `createAttestedRealClock()` in `clock.ts` now can: at integration the harness
 223:       // constructs the passage of time with NO control seam and stamps it with the slot attestation.
 224:       // The grant is on that positive evidence and on nothing else â€” a seamless object with no
 225:       // attestation still refuses, exactly as before, because "I found no stand-in seam" was never
 226:       // evidence of real backing and is not one now.
 227:       const attested = attestationOf(value, 'clock.controlled');
 228:       if (attested) {
 229:         return {
 230:           kind: 'real',
 231:           evidence: `an attested real clock: it exposes no control seam and cannot be commanded forward â€” ${attested.evidence}`,
 232:         };
 233:       }
 234:       throw new Error(
 235:         'refusing to construct capability "clock.controlled": its value exposes no callable Clock control seam ' +
 236:           `(freezeAt/advance), and it carries no attested real clock backing to record in its place. ${REFUSAL_DOCTRINE}`,
 237:       );
 238:     },
 239:   ],
 240:   [
 241:     'vendors.email',
 242:     (value) => {
 243:       // ONE LEVEL DOWN: the registered value is the `Vendors` wrapper `{ email: <sim> }`, so the
 244:       // seam to read is `email.rejectNext` / `email.attempts`, never `rejectNext` on the wrapper.
 245:       // A provider that can be told to reject the next N sends, and that hands back every attempt
 246:       // that reached its seam, is a simulator.
 247:       if (callable(value, 'email', 'rejectNext') && callable(value, 'email', 'attempts')) {
 248:         return {
 249:           kind: 'stand-in',
 250:           reason:
 251:             'the value exposes the EmailProviderSim control seam (email.rejectNext/email.attempts) â€” a provider ' +
 252:             'that can be told to reject the next N sends, and that hands back every attempt, is a simulator',
 253:         };
 254:       }
 255:       // THE LIVE BRANCH, and it is a MAIL CATCHER rather than a mail sender â€” which is worth being
 256:       // exact about, because the two are not the same claim. Nothing in this repository sends mail
 257:       // through a real provider at any tier, and no green anywhere says it does. What the slot's
 258:       // stack really holds is the catcher every message the local Auth emits lands in, and reading
 259:       // it is a real capability: the message under assertion was produced by GoTrue on this run, not
 260:       // minted by a simulator the test armed. The grant is on a PROBED endpoint plus the slot
 261:       // attestation; the sim branch above is untouched, so the loop tier's verdict is unchanged.
 262:       // ONE LEVEL DOWN AGAIN, for the same reason the control seam is read one level down: the
 263:       // registered value is the `{ email: â€¦ }` wrapper, which is an object literal anybody can
 264:       // build, and the thing that was actually probed is the reader inside it.
 265:       const attested = attestationOf((value as { email?: unknown } | null)?.email, 'vendors.email');
 266:       if (attested) {
 267:         return {
 268:           kind: 'real',
 269:           evidence:
 270:             'an attested live mail catcher: the messages read are the ones the slot stack really ' +
 271:             `delivered, and no send outcome can be armed from a test â€” ${attested.evidence}`,
 272:         };
 273:       }
 274:       throw new Error(
 275:         'refusing to construct capability "vendors.email": its value exposes no callable EmailProviderSim control ' +
 276:           `seam (email.rejectNext/email.attempts), and it carries no attested live provider to record in its ` +
 277:           `place. ${REFUSAL_DOCTRINE}`,
 278:       );
 279:     },
 280:   ],
 281:   ['config.registry', theArticleItself('atconfig.ts IS the registry of pinned values')],
 282:   ['sentinels.planted', theArticleItself('the marker store IS the planting machinery')],
 283:   ['faults.injection', theArticleItself('the fault router IS the injection machinery')],
 284:   [
 285:     'oracles.judge',
 286:     // DERIVED FROM THE TIER AND THE TRANSPORT BRAND, which is where this doctrine was already
 287:     // working one layer down before it was carried up here. `oracles.ts` refuses both mismatched
 288:     // combinations at the point it builds the transport; this witness reaches the same judgement
 289:     // from the evidence handed over, and refuses the same two combinations rather than trusting
 290:     // that the caller already did.
 291:     (_value, evidence) => {
 292:       const { tier, transport } = evidence;
 293:       if (tier === undefined || transport === undefined) {
 294:         throw new Error(
 295:           'refusing to construct capability "oracles.judge": its provenance is derived from the running tier and ' +
 296:             'the judge transport\'s kind brand, and this construction supplied ' +
 297:             `${tier === undefined ? 'no tier' : `tier ${JSON.stringify(tier)}`} and ` +
 298:             `${transport === undefined ? 'no transport kind' : `transport ${JSON.stringify(transport)}`}. ` +
 299:             `${REFUSAL_DOCTRINE}`,
 300:         );
 301:       }
 302:       // ENUMERATE BEFORE ANY RULE IS APPLIED. Every rule below reads a brand it recognises; a value
 303:       // neither list contains is unclassifiable, and unclassifiable refuses rather than falling
 304:       // through to whichever branch happens to catch it.
 305:       if (!LEGAL_TIERS.includes(tier)) {
 306:         throw new Error(
 307:           `refusing to construct capability "oracles.judge": the TIER axis was given ${JSON.stringify(tier)}, which is ` +
 308:             `not a brand this witness recognises. The legal tiers are ${LEGAL_TIERS.join(', ')}. ${REFUSAL_DOCTRINE}`,
 309:         );
 310:       }
 311:       if (!LEGAL_TRANSPORTS.includes(transport)) {
 312:         throw new Error(
 313:           `refusing to construct capability "oracles.judge": the TRANSPORT axis was given ${JSON.stringify(transport)}, ` +
 314:             `which is not a brand this witness recognises. The legal transports are ${LEGAL_TRANSPORTS.join(', ')}. ` +
 315:             `${REFUSAL_DOCTRINE}`,
 316:         );
 317:       }
 318:       if (tier === 'loop') {
 319:         if (transport === 'live') {
 320:           throw new Error(
 321:             'refusing to construct capability "oracles.judge": a loop-tier oracle on a live transport would report ' +
 322:               "today's answer under yesterday's expectations while the ledger still called it a stand-in.",
 323:           );
 324:         }
 325:         return {
 326:           kind: 'stand-in',
 327:           reason: `the loop tier judges through a ${transport} transport rather than the live judge`,
 328:         };
 329:       }
 330:       if (transport === 'replay-fs') {
 331:         throw new Error(
 332:           `refusing to construct capability "oracles.judge": a ${tier}-tier oracle on a filesystem replay transport ` +
 333:             'would be a real capability answering from committed bytes while reporting that it stubbed nothing.',
 334:         );
 335:       }
 336:       return {
 337:         kind: 'real',
 338:         evidence: `the ${tier} tier judges through a ${transport} transport, and no filesystem replay is permitted here`,
 339:       };
 340:     },
 341:   ],
 342: ]);
 343: 
 344: function sealed<T>(name: string, verdict: CapabilityVerdict, value: T): Capability<T> {
 345:   return Object.freeze({
 346:     [CAPABILITY]: true as const,
 347:     name,
 348:     provenance: verdict.kind,
 349:     standInReason: verdict.kind === 'stand-in' ? verdict.reason : null,
 350:     realEvidence: verdict.kind === 'real' ? verdict.evidence : null,
 351:     value,
 352:   });
 353: }
 354: 
 355: /**
 356:  * The one constructor. The verdict comes from the witness registered for `name`; an unregistered
 357:  * name is refused, and a witness that cannot classify the value throws through this call.
 358:  */
 359: export function witnessedCapability<T>(name: string, value: T, evidence: CapabilityEvidence = {}): Capability<T> {
 360:   if (!name.trim()) throw new Error('a capability requires a non-empty name');
 361:   const witness = WITNESSES.get(name);
 362:   if (witness === undefined) {
 363:     throw new Error(
 364:       `refusing to construct capability ${JSON.stringify(name)}: no witness is registered for that name. The ` +
 365:         `witness table is CLOSED â€” ${[...WITNESSES.keys()].sort().join(', ')} â€” so a name nobody has decided ` +
 366:         `about is an error here rather than a default in either direction.`,
 367:     );
 368:   }
 369:   return sealed(name, witness(value, evidence), value);
 370: }
 371: 
 372: /**
 373:  * THE NAMES THIS ROUTE MAY BUILD: `fixtures.worlds` exactly, and every `sut.<key>`.
 374:  *
 375:  * `index.ts` composes the SUT names â€” `Object.entries(adapter.sut)` behind its own `sut.` literal â€”
 376:  * and strips the same prefix back off in `createHarness()`. This copy of the literal is the
 377:  * ADMISSION CHECK for the route, not a second place the name is built, and the two must stay in
 378:  * step: a change to the prefix there without a change here would refuse every SUT capability at
 379:  * construction, loudly and on the first run.
 380:  */
 381: const ADAPTER_DERIVED_EXACT = 'fixtures.worlds';
 382: const ADAPTER_DERIVED_PREFIX = 'sut.';
 383: 
 384: /**
 385:  * THE ADAPTER-DERIVED ROUTE, for the two families whose provenance comes from where the module was
 386:  * loaded rather than from anything about the value: `fixtures.worlds` and every `sut.<key>`.
 387:  *
 388:  * It returns stand-in UNCONDITIONALLY, and that is deliberate. `adapterUrl()` in `index.ts` has
 389:  * exactly one possible output today, so a route that BRANCHED on the URL would be a constant
 390:  * dressed as a check â€” the same dishonesty this file exists to remove. The URL is the CONTENT of
 391:  * the reason, so the ledger names the module really imported; it is not the condition of a test.
 392:  *
 393:  * ON THE URL, STATED AS IT ACTUALLY IS. Through the one route the harness uses, it is loader-derived:
 394:  * `loadAdapter()` computes it from REPO_ROOT plus the requirement and hands it back, and no caller
 395:  * passes a path in. THE SIGNATURE DOES NOT ENFORCE THAT â€” this parameter is a plain string and any
 396:  * caller may supply any non-empty one. What bounds it is that every outcome here is stand-in: a
 397:  * fabricated URL ADDS a name to the ledger `registry.ts` refuses above loop, so it can only make the
 398:  * closing gate stricter. The failure direction is a false RED, never a false green.
 399:  *
 400:  * THE TWO ROUTES PARTITION THE NAMESPACE, and the check below is what makes that true rather than
 401:  * merely intended. Before it, `adapterDerivedCapability('clock.controlled', strippedClock, url)`
 402:  * minted a stand-in for a name the closed witness table would have REFUSED â€” routing around the
 403:  * table through a door the table does not watch. So this route refuses any name the table knows, and
 404:  * refuses any name outside its own two families.
 405:  *
 406:  * THIS IS NOT THE PREFIX RULE THAT WAS REMOVED FROM THE WITNESS TABLE, and the difference is the
 407:  * whole justification. There, a `sut.*` prefix matched a name into a table that GRANTS A VERDICT, so
 408:  * a verdict was handed to a name nobody had decided about â€” an unlimited namespace inside a table
 409:  * whose claim was that it was closed. Here the verdict is unconditional stand-in whatever the name
 410:  * is, so matching the prefix grants nothing at all; it only restricts WHICH NAMES MAY USE THIS
 411:  * ROUTE. A prefix that decides an outcome is a hole; a prefix that decides admission is a partition.
 412:  */
 413: export function adapterDerivedCapability<T>(name: string, value: T, moduleUrl: string): Capability<T> {
 414:   if (!name.trim()) throw new Error('a capability requires a non-empty name');
 415:   if (WITNESSES.has(name)) {
 416:     throw new Error(
 417:       `refusing to construct capability ${JSON.stringify(name)} on the adapter-derived route: a witness is registered ` +
 418:         'for that name, and this route would stamp it stand-in without ever asking that witness â€” including for a ' +
 419:         'value the witness would have REFUSED. The two routes partition the capability namespace; they do not overlap.',
 420:     );
 421:   }
 422:   if (name !== ADAPTER_DERIVED_EXACT && !(name.startsWith(ADAPTER_DERIVED_PREFIX) && name.length > ADAPTER_DERIVED_PREFIX.length)) {
 423:     throw new Error(
 424:       `refusing to construct capability ${JSON.stringify(name)} on the adapter-derived route: this route builds ` +
 425:         `${ADAPTER_DERIVED_EXACT} and every ${ADAPTER_DERIVED_PREFIX}<key> the fixture adapter exports, and nothing ` +
 426:         'else. A name outside both families belongs on the witness table, where something decides about it.',
 427:     );
 428:   }
 429:   if (!moduleUrl.trim()) {
 430:     throw new Error(
 431:       `refusing to construct capability ${JSON.stringify(name)} on the adapter-derived route with no module URL: ` +
 432:         'the URL is the whole content of the reason, so an empty one would put a stand-in on the ledger that ' +
 433:         'cannot say which module it came from.',
 434:     );
 435:   }
 436:   return sealed(name, { kind: 'stand-in', reason: `loaded from the fixture adapter at ${moduleUrl}` }, value);
 437: }
 438: 
 439: /* --------------------------------------------------------------------------- the LIVE route */
 440: 
 441: /**
 442:  * THE THIRD ROUTE, and it is a SEPARATE CONSTRUCTOR WITH ITS OWN ADMISSION PARTITION â€” deliberately,
 443:  * mirroring the two-route design above rather than adding a branch inside either of them.
 444:  *
 445:  * The adapter-derived route is safe precisely because every outcome it can produce is stand-in: a
 446:  * fabricated module URL can only ADD a name to the list `registry.ts` refuses above loop, so its
 447:  * failure direction is a false RED. This route GRANTS `real`, so the same laxity would be a hole,
 448:  * and the difference is written into its admission checks rather than into a comment:
 449:  *
 450:  *   - NOTHING IS EVER GRANTED `real` BY PREFIX. `liveSutCapability` builds `sut.<key>` for ONE key
 451:  *     at a time and the verdict it grants is about that key's METHOD ENUMERATION, which the live
 452:  *     adapter module exports as a closed list. A method outside the list is not real, is not
 453:  *     stand-in, and cannot be called: `pendingMethodProxy` refuses it AT USE, by name.
 454:  *   - EVERY ENUMERATED NAME MUST EXIST ON THE LOADED SURFACE. An enumeration naming a method the
 455:  *     adapter does not implement would be a real grant covering a method nothing backs, which is
 456:  *     the false green in miniature. It is refused here, at construction, naming the names.
 457:  *   - EVERY GRANT CARRIES THE SLOT ATTESTATION. Without the round trip that proved the coordinates
 458:  *     answered with this run's minted value, there is no positive evidence and no grant.
 459:  *
 460:  * WHAT A `real` VERDICT HERE MEANS, said in the narrowest true words: the value under this name was
 461:  * built by the live adapter against a slot whose coordinates answered with this run's attestation,
 462:  * and the enumerated methods are the ones that adapter really implements. It does not mean the
 463:  * methods are correct, and it does not mean the un-enumerated ones are absent â€” they are present and
 464:  * they refuse.
 465:  */
 466: export function liveSutCapability<T extends object>(
 467:   name: string,
 468:   value: T,
 469:   backedMethods: readonly string[],
 470:   surface: Record<string, unknown>,
 471:   attestation: LiveAttestation,
 472: ): Capability<T> {
 473:   if (!name.startsWith(ADAPTER_DERIVED_PREFIX) || name.length === ADAPTER_DERIVED_PREFIX.length) {
 474:     throw new Error(
 475:       `refusing to construct capability ${JSON.stringify(name)} on the live route: this constructor builds ` +
 476:         `${ADAPTER_DERIVED_PREFIX}<key> names and nothing else. ${ADAPTER_DERIVED_EXACT} has its own constructor, ` +
 477:         `and every other name belongs on the witness table, where something decides about it.`,
 478:     );
 479:   }
 480:   if (WITNESSES.has(name)) {
 481:     throw new Error(
 482:       `refusing to construct capability ${JSON.stringify(name)} on the live route: a witness is registered for that ` +
 483:         'name, and this route would grant it real without ever asking that witness. The routes partition the ' +
 484:         'capability namespace; they do not overlap.',
 485:     );
 486:   }
 487:   if (backedMethods.length === 0) {
 488:     throw new Error(
 489:       `refusing to construct capability ${JSON.stringify(name)} on the live route with an EMPTY backed-method ` +
 490:         'enumeration: a real verdict over nothing at all would put a name on the ledger that says a live adapter ' +
 491:         'backs it while no method is backed. A suite with nothing live has no live capability.',
 492:     );
 493:   }
 494:   const duplicated = [...new Set(backedMethods.filter((method, index) => backedMethods.indexOf(method) !== index))];
 495:   if (duplicated.length) {
 496:     throw new Error(
 497:       `refusing to construct capability ${JSON.stringify(name)}: its backed-method enumeration names ` +
 498:         `${duplicated.join(', ')} more than once, so the enumeration is not the closed list it claims to be.`,
 499:     );
 500:   }
 501:   const absent = backedMethods.filter((method) => typeof surface[method] !== 'function');
 502:   if (absent.length) {
 503:     throw new Error(
 504:       `refusing to construct capability ${JSON.stringify(name)}: its backed-method enumeration names ` +
 505:         `${absent.join(', ')}, which the loaded live adapter does not implement as callable members. An enumeration ` +
 506:         'is a claim about a surface, and a claim about a member that is not there would grant real over nothing.',
 507:     );
 508:   }
 509:   const attested = attestationOf(attestation, SLOT_ATTESTATION_BRAND);
 510:   if (!attested) {
 511:     throw new Error(
 512:       `refusing to construct capability ${JSON.stringify(name)} on the live route with no slot attestation: shape ` +
 513:         'checks over a connection string are fabricable by anyone with a text editor, so the only positive grounds ' +
 514:         'this harness accepts are "these coordinates answered with this run\'s runner-minted value".',
 515:     );
 516:   }
 517:   return sealed(
 518:     name,
 519:     {
 520:       kind: 'real',
 521:       evidence:
 522:         `backed live against the slot by the suite's live adapter over the closed enumeration ` +
 523:         `[${[...backedMethods].sort().join(', ')}]; every other method refuses at use â€” ${attested.evidence}`,
 524:     },
 525:     value,
 526:   );
 527: }
 528: 
 529: /** The live route's `fixtures.worlds` half: one exact name, the same attestation requirement. */
 530: export function liveFixturesCapability<T>(value: T, attestation: LiveAttestation): Capability<T> {
 531:   const attested = attestationOf(attestation, SLOT_ATTESTATION_BRAND);
 532:   if (!attested) {
 533:     throw new Error(
 534:       `refusing to construct capability ${JSON.stringify(ADAPTER_DERIVED_EXACT)} on the live route with no slot ` +
 535:         'attestation: without the round trip that proved the coordinates answered with this run\'s minted value ' +
 536:         'there are no positive grounds, and finding no stand-in seam is not evidence of real backing.',
 537:     );
 538:   }
 539:   return sealed(
 540:     ADAPTER_DERIVED_EXACT,
 541:     { kind: 'real', evidence: `fixture worlds built against the slot's own stack â€” ${attested.evidence}` },
 542:     value,
 543:   );
 544: }
 545: 
 546: export function stubbedCapabilityNames(capabilities: readonly Capability<unknown>[]): string[] {
 547:   return capabilities
 548:     .filter((entry) => entry[CAPABILITY] === true && entry.provenance === 'stand-in')
 549:     .map((entry) => entry.name)
 550:     .sort();
 551: }
 552: 
 553: export class CapabilityPending extends Error {
 554:   constructor(readonly capabilities: readonly string[]) {
 555:     super(`CAPABILITY PENDING â€” ${capabilities.join(', ')}`);
 556:     this.name = 'CapabilityPending';
 557:   }
 558: }
 559: 
 560: /** A typed seam for later slices. Any attempted use fails with the capability names, never a no-op. */
 561: export function pendingCapability<T extends object>(...capabilities: string[]): T {
 562:   const names = [...new Set(capabilities)];
 563:   return new Proxy(
 564:     {},
 565:     {
 566:       get() {
 567:         throw new CapabilityPending(names);
 568:       },
 569:     },
 570:   ) as T;
 571: }
 572: 
 573: /**
 574:  * PROVENANCE AT METHOD GRANULARITY, because a whole suite shares one `sut.<key>`.
 575:  *
 576:  * REQ-001 binds exactly one system-under-test key, `accounts`, and thirty-seven acceptance ids drive
 577:  * it. A verdict at the key level therefore says one word about thirty-seven different questions: the
 578:  * live adapter genuinely backs a sign-in and genuinely cannot perform an OAuth consent round trip,
 579:  * and there is no single honest label for both.
 580:  *
 581:  * So the key's ledger entry is `real` over a CLOSED ENUMERATION of backed method names, and every
 582:  * method outside that enumeration is a callable proxy that THROWS `CapabilityPending` naming
 583:  * `sut.<key>.<method>` the moment a body touches it.
 584:  *
 585:  * WHY THIS IS NOT A LEDGER STAND-IN, which is the distinction the whole design turns on. A stand-in
 586:  * ANSWERS: it produces a value the test then asserts on, so a suite can go green over it, which is
 587:  * why `registry.ts` refuses one above the loop tier. A pending proxy answers NOTHING â€” it fakes no
 588:  * behaviour, returns no value and can never produce a green. Its only possible effect is to turn one
 589:  * id red, by name, with a detail the declaration machinery can match exactly. The failure direction
 590:  * is a false RED and never a false green, so it belongs on the permitted side of the gate.
 591:  *
 592:  * READ, NEVER CALLED, IS STILL A REFUSAL, and deliberately so. The trap throws from `get`, not from
 593:  * the returned function, so `const f = sut.somethingUnbacked` is already the refusal. A body that
 594:  * merely names an unbacked method has leaned on it, and letting the read pass would move the red to
 595:  * whichever later line happened to invoke it â€” or hide it entirely behind an `if`.
 596:  *
 597:  * THREE PROPERTY READS ARE ANSWERED RATHER THAN REFUSED, and each is a real hazard rather than a
 598:  * convenience: `then` (an `await` on this object probes it, and throwing there turns an unrelated
 599:  * await into this refusal), and the two well-known symbols a runtime reaches for when it prints or
 600:  * inspects a value. A test never asserts on any of the three.
 601:  */
 602: export function pendingMethodProxy<T extends object>(
 603:   capabilityName: string,
 604:   backedMethods: readonly string[],
 605:   surface: Record<string, unknown>,
 606: ): T {
 607:   const backed = new Set(backedMethods);
 608:   return new Proxy(surface, {
 609:     get(target, property, receiver) {
 610:       if (typeof property === 'symbol') return Reflect.get(target, property, receiver) as unknown;
 611:       if (property === 'then') return undefined;
 612:       if (backed.has(property)) {
 613:         const member = Reflect.get(target, property, receiver) as unknown;
 614:         return typeof member === 'function' ? (member as (...args: unknown[]) => unknown).bind(target) : member;
 615:       }
 616:       throw new CapabilityPending([`${capabilityName}.${property}`]);
 617:     },
 618:     // A body cannot discover which methods are backed by enumerating the object and then take a
 619:     // different path: `has` answers for the whole surface, exactly as the loop adapter's does, so an
 620:     // unbacked method is present and refuses rather than being absent and skippable.
 621:     has(target, property) {
 622:       return Reflect.has(target, property);
 623:     },
 624:   }) as T;
 625: }

