1171: /**
1172:  * End-of-run housekeeping. The lock release lives in a `finally` of its OWN so that it cannot be
1173:  * skipped: on Windows, removing the report directory can throw EPERM while a file in it is still
1174:  * open, and if that throw escaped, the stack lock would be stranded and every later run would
1175:  * find a leftover it has to reason about. A lost temp directory is untidy; a stranded lock blocks
1176:  * work, so the release always wins and the cleanup failure is reported instead of hidden.
1177:  */
1178: export function cleanupRun(reportDir: string, lock: { release(): void } | null): void {
1179:   try {
1180:     rmSync(reportDir, { recursive: true, force: true });
1181:   } catch (err) {
1182:     console.error(`at:verify â€” could not remove the report directory ${reportDir}: ${diagnostic((err as Error).message)}`);
1183:   } finally {
1184:     lock?.release();
1185:   }
1186: }
