 422: /** The identity the pool must never wear. Read from the item tree, never hard-coded. */
 423: export function personalProjectId(itemRoot: string = REPO_ROOT): string {
 424:   return readLocalConfig(itemRoot).projectId;
 425: }
 426: 
 427: function refusePersonal(slotConfigText: string, itemRoot: string, act: string): void {
 428:   const problems = personalBlockProblems(slotConfigText, personalProjectId(itemRoot));
 429:   if (problems.length) {
 430:     throw new Error(
 431:       `refusing to ${act}: this configuration is not provably outside the founder's personal stack. ` +
 432:         `Failed checks: ${problems.join('; ')}. The personal stack is untouchable, so nothing was done.`,
 433:     );
 434:   }
 435: }
 436: 
 437: /**
 438:  * The same guard, over a slot's config AS IT SITS ON DISK (rulings T7 and F1).
 439:  *
 440:  * `occupy` and `prepare` run the guard over text they hold in hand. The other three entry points â€”
 441:  * reset, stop and the env emitter â€” are exported and reachable directly, so each runs the guard
 442:  * for itself over the file. A guard that only the usual caller runs is a convention, not a guard.
 443:  */
 444: function refusePersonalSlotConfig(slot: number, itemRoot: string, act: string): void {
 445:   const configPath = slotConfigPath(slot);
 446:   if (!existsSync(configPath)) {
 447:     throw new Error(
 448:       `refusing to ${act} slot ${slot}: it has no config at ${configPath}, so it cannot be shown to be outside the ` +
 449:         `founder's personal stack. Run \`bun tests/at/harness/db-pool.ts setup\`. Nothing was done.`,
 450:     );
 451:   }
 452:   refusePersonal(readFileSync(configPath, 'utf8'), itemRoot, `${act} slot ${slot}`);
 453: }
 454: 
 455: /* ------------------------------------------------------------------------- the path closure */
 456: 
 457: /** Config settings whose value names a file or directory the stack has to be able to read. */
 458: const PATH_KEYS = new Set([
 459:   'sql_paths',
 460:   'schema_paths',
 461:   'content_path',
 462:   'cert_path',
 463:   'key_path',
 464:   'signing_keys_path',
 465:   'objects_path',
 466:   'declarative_schema_path',
 467: ]);
 468: 
 469: function stringValues(raw: string): string[] {
 470:   const array = /^\[(.*)\]$/.exec(raw);
 471:   const body = array ? array[1] : raw;
 472:   return [...body.matchAll(/"([^"]*)"/g)].map((match) => match[1]).filter((value) => value.trim() !== '');
 473: }
 474: 
 475: /**
 476:  * Fail closed on what the config asks for but the mirror cannot deliver.
 477:  *
 478:  * `prepare` mirrors the item tree's whole `supabase/` directory into the slot, so every path
 479:  * UNDER that directory is provided exactly as the item tree has it â€” present if present, absent
 480:  * if absent. A configured path that is absent in the item tree is therefore not a problem: the
 481:  * slot is then in the same state the repo-configured stack would be in, which is the state the
 482:  * item asked for. (`[db.seed] sql_paths = ["./seed.sql"]` with no `seed.sql` in the tree is
 483:  * exactly today's arrangement on the personal stack.)
 484:  *
 485:  * A path that points OUTSIDE `supabase/` is a different thing: the mirror cannot deliver it, so
 486:  * the slot would start half-provisioned and grade against a file it does not have. That refuses
 487:  * loudly and a person decides. The same applies to the two directories the mirror EXCLUDES
 488:  * (`MIRROR_EXCLUSIONS`): a config that names a file inside the CLI's own runtime state is naming
 489:  * something the slot will not have, so the closure stays honest about the exclusions.
 490:  *
 491:  * A VALUE THIS SCANNER CANNOT SEE REFUSES rather than passing. `scanConfig` reads one line per
 492:  * setting, so a multi-line array â€” `sql_paths = [` on its own line â€” yields the value `[` and no
 493:  * paths at all. For the OVERLAY an invisible value is harmless: it is copied verbatim. For the
 494:  * CLOSURE it is a missed refusal, which is the failure this function exists to prevent.
 495:  */
 496: export function pathClosureProblems(configText: string, itemRoot: string): string[] {
 497:   const problems: string[] = [];
 498:   const base = resolve(join(itemRoot, 'supabase'));
 499: 
 500:   for (const entry of scanConfig(configText)) {
 501:     if (!PATH_KEYS.has(entry.key)) continue;
 502:     if (entry.value.startsWith('[') && !entry.value.includes(']')) {
 503:       problems.push(
 504:         `[${entry.section}] ${entry.key} opens an array that does not close on the same line, so this check ` +
 505:           `cannot see the paths it names â€” write the value on one line (${entry.key} = ["./a.sql", "./b.sql"]) ` +
 506:           `and run this again`,
 507:       );
 508:       continue;
 509:     }
 510:     for (const value of stringValues(entry.value)) {
 511:       if (/^[a-z][a-z0-9+.-]*:\/\//i.test(value)) {
 512:         problems.push(`[${entry.section}] ${entry.key} names "${value}", which is a URL rather than a file the slot can be given`);
 513:         continue;
 514:       }
 515:       if (isAbsolute(value)) {
 516:         problems.push(`[${entry.section}] ${entry.key} names the absolute path "${value}", which the slot mirror cannot reproduce`);
 517:         continue;
 518:       }
 519:       const target = resolve(base, value);
 520:       const inside = relative(base, target);
 521:       if (inside.startsWith('..')) {
 522:         problems.push(
 523:           `[${entry.section}] ${entry.key} names "${value}", which is outside supabase/ â€” the slot mirror copies supabase/ ` +
 524:             `and nothing else, so this file would be missing from the slot`,
 525:         );
 526:         continue;
 527:       }
 528:       const first = inside.split(/[\\/]/)[0];
 529:       if (MIRROR_EXCLUSIONS.includes(first)) {
 530:         problems.push(
 531:           `[${entry.section}] ${entry.key} names "${value}", which resolves into supabase/${first} â€” the slot mirror ` +
 532:             `deliberately does not copy that directory (it is the CLI's own runtime state about another stack), so ` +
 533:             `this file would be missing from the slot`,
 534:         );
 535:       }
 536:     }
 537:   }
 538: 
 539:   return problems;
 540: }
 541: 
 542: /* -------------------------------------------------------------------------------- the mirror */
 543: 
 544: /**
 545:  * What the mirror does NOT carry into a slot (rulings T3, F3 and T11). Top-level entries of
 546:  * `supabase/` only, so the list cannot quietly grow into a filter on file names.
 547:  *
 548:  *   - `.temp` and `.branches` are the CLI's OWN RUNTIME STATE, not project source. `.temp` holds
 549:  *     the CLI's record of the stack it last ran â€” the founder's personal one â€” and `.gitignore`
 550:  *     itself says its `start-secrets/**` "must NEVER be committed". Copying it carries another
 551:  *     stack's identity residue and its secrets into every slot.
 552:  *   - `config.toml` is the slot's IDENTITY, and the item tree's copy carries the personal
 553:  *     identity. Excluding it means no slot config ever holds that identity, not even for the
 554:  *     instant between the mirror and the regenerated write â€” and a crash in that instant leaves
 555:  *     NO config rather than a personal one.
 556:  */
 557: export const MIRROR_EXCLUSIONS: readonly string[] = ['.temp', '.branches', 'config.toml'];
 558: 
 559: /**
 560:  * Every symlink under a directory tree. A pre-copy scan, because a symlink is not a file the
 561:  * mirror can reproduce: `cpSync` would copy it as a link, and the link points wherever it likes â€”
 562:  * including straight back at the personal stack's own directory.
 563:  */
 564: function symlinksUnder(dir: string): string[] {
 565:   const found: string[] = [];
 566:   const walk = (current: string): void => {
 567:     for (const entry of readdirSync(current, { withFileTypes: true })) {
 568:       const full = join(current, entry.name);
 569:       if (entry.isSymbolicLink()) {
 570:         found.push(full);
 571:         continue; // never follow it â€” that is the whole point
 572:       }
 573:       if (entry.isDirectory()) walk(full);
 574:     }
 575:   };
 576:   walk(dir);
 577:   return found;
 578: }
 579: 
 580: /**
 581:  * Copy the item tree's `supabase/` into the slot, having first removed the slot's copy.
 582:  *
 583:  * DELETE THEN COPY, never merge: the previous holder's leftover migration or leftover function is
 584:  * exactly the state this pool exists to make impossible.
 585:  *
 586:  * THE PROJECT SOURCE ENTIRE, and nothing else (ruling E3 as narrowed by T3, F3 and T11). Every
 587:  * path the config names under `supabase/` arrives in the slot exactly as the item tree has it â€”
 588:  * present if present, absent if absent â€” and `pathClosureProblems` refuses any config path that
 589:  * names one of the three excluded entries, so the closure guarantee stays honest about them.
 590:  * (`README.md` and `.gitkeep` therefore travel into the slot's `migrations/` too. The CLI reads
 591:  * only `<timestamp>_name.sql` there, and the runner's migration proof counts exactly those.)
 592:  *
 593:  * A SYMLINK ANYWHERE UNDER `supabase/` REFUSES THE WHOLE MIRROR (ruling T13). The tree carries
 594:  * none today, so nothing breaks; one smuggled in later refuses loudly instead of being copied as
 595:  * a link into a directory the pool then resets.
 596:  */
 597: export function mirrorItemTree(itemRoot: string, slot: number): void {
 598:   const source = join(itemRoot, 'supabase');
 599:   const destination = join(slotDir(slot), 'supabase');
 600:   if (!existsSync(source)) throw new Error(`${source} does not exist â€” there is no project to give the slot`);
 601: 
 602:   const links = symlinksUnder(source);
 603:   if (links.length) {
 604:     throw new Error(
 605:       `refusing to mirror ${source} into slot ${slot}: it contains ${links.length} symlink(s) â€” ${links.join(', ')}. ` +
 606:         `A symlink is not a file the mirror can reproduce, and a link copied into a slot points wherever it likes, ` +
 607:         `including outside the pool. Replace them with real files, or decide by hand. Nothing was copied.`,
 608:     );
 609:   }
 610: 
 611:   rmSync(destination, { recursive: true, force: true });
 612:   mkdirSync(destination, { recursive: true });
 613:   cpSync(source, destination, {
 614:     recursive: true,
 615:     filter: (from: string) => {
 616:       const inside = relative(source, from);
 617:       if (inside === '') return true;
 618:       return !MIRROR_EXCLUSIONS.includes(inside.split(/[\\/]/)[0]);
 619:     },
 620:   });
 621: }
 622: 
 623: /* --------------------------------------------------------------------------- the reservation */
 624: 
 625: export interface Reservation {
 626:   slot: number;
 627:   item: string;
 628:   branch: string;
 629:   at: string;
 630:   holder: string;
 631: }
 632: 
 633: /**
 634:  * The reservation as a VIEW reads it: anything this run cannot read is reported as nothing.
 635:  *
 636:  * This read is for rendering a picture of the pool, never for deciding whether a slot may be
 637:  * taken. A view that refuses to render is no safety. Decision paths use `readReservationStrict`.
 638:  */
 639: export function readReservation(slot: number): Reservation | null {
 640:   try {
 641:     return JSON.parse(readFileSync(reservationPath(slot), 'utf8')) as Reservation;
 642:   } catch {
 643:     return null;
 644:   }
 645: }
 646: 
 647: /** One second of small steps â€” thousands of times the write window, and the same remedy T1 uses. */
 648: const RESERVATION_READ_TRIES = 40;
 649: const RESERVATION_READ_STEP_MS = 25;
 650: 
 651: /** Bounded synchronous pause, the same shape `acquireStackLock` uses for the same window. */
 652: function pause(ms: number): void {
 653:   const until = Date.now() + ms;
 654:   while (Date.now() < until) {
 655:     /* spin */
 656:   }
 657: }
 658: 
 659: /** A parse result a decision path may act on: an object naming the item that holds the slot. */
 660: function isReservation(value: unknown): value is Reservation {
 661:   if (typeof value !== 'object' || value === null) return false;
 662:   const item = (value as { item?: unknown }).item;
 663:   return typeof item === 'string' && item.trim() !== '';
 664: }
 665: 
 666: /**
 667:  * THE RESERVATION AS A DECISION PATH MUST READ IT (audit ruling A2).
 668:  *
 669:  * Three outcomes, and the middle one is the whole point:
 670:  *
 671:  *   - the file is ABSENT â€” there is no reservation, and the caller proceeds;
 672:  *   - the file EXISTS but this run cannot read or parse it â€” it waits out the write window and
 673:  *     reads again, because `Reserve-DbSlot` creates the file exclusively and fills it a moment
 674:  *     later, and in between the file exists and says nothing (measured on this machine, T10);
 675:  *   - the file is STILL unreadable after the wait â€” it REFUSES, naming the file. A reservation
 676:  *     nobody can read is not the same thing as no reservation, and treating it as absent lets a
 677:  *     run take a slot another item holds.
 678:  *
 679:  * PARSING IS NOT READING (audit ruling B3). `null`, `42`, `"text"` and `[]` are all valid JSON and
 680:  * none of them is a reservation. Handing one back made a present-but-garbage file indistinguishable
 681:  * from ENOENT, and the `AT_DB_SLOT` override â€” which asks `if (reserved && ...)` â€” then read a
 682:  * reservation file containing `null` as no reservation at all. So the parse result must have the
 683:  * SHAPE of a reservation, and everything else takes the half-written path into the refusal below.
 684:  * After this, a `null` return means ENOENT and nothing else.
 685:  */
 686: export function readReservationStrict(slot: number): Reservation | null {
 687:   const path = reservationPath(slot);
 688:   for (let attempt = 0; attempt < RESERVATION_READ_TRIES; attempt++) {
 689:     if (attempt > 0) pause(RESERVATION_READ_STEP_MS);
 690:     let raw: string;
 691:     try {
 692:       raw = readFileSync(path, 'utf8');
 693:     } catch (err) {
 694:       if ((err as NodeJS.ErrnoException).code === 'ENOENT') return null;
 695:       continue; // present, and held by its writer â€” look again in a moment
 696:     }
 697:     if (raw.trim() === '') continue; // created, not yet filled
 698:     let parsed: unknown;
 699:     try {
 700:       parsed = JSON.parse(raw);
 701:     } catch {
 702:       continue; // half written
 703:     }
 704:     if (isReservation(parsed)) return parsed;
 705:     // parses, and says nothing a decision can use â€” half written, or not a reservation at all
 706:   }
 707:   throw new Error(
 708:     `refusing to decide about slot ${slot}: it holds a reservation at ${path} that this run cannot read after ` +
 709:       `${(RESERVATION_READ_TRIES * RESERVATION_READ_STEP_MS) / 1000} seconds of trying. A reservation nobody can read is ` +
 710:       `NOT the same thing as no reservation, and reading it as absent would let this run take a slot another item ` +
 711:       `holds. Nothing was done. Look at that file, and delete it by hand if no item holds this slot.`,
 712:   );
 713: }
 714: 
 715: /** The slot reserved for this item, or null. Derived from the file, never declared by a caller. */
 716: export function slotForItem(item: string): number | null {
 717:   for (let slot = 1; slot <= POOL_SIZE; slot++) {
 718:     if (readReservation(slot)?.item === item) return slot;
 719:   }
 720:   return null;
 721: }
 722: 
 723: /**
 724:  * The item id a branch names â€” a pure function over the branch string, and it FAILS CLOSED.
 725:  *
 726:  * Exactly one id, or it refuses naming the condition. Never the first match of several: a branch
 727:  * carrying two ids is a question about which item is being verified, and answering it by
 728:  * position would attach a run, a reservation and a database to the wrong item silently.
 729:  */
 730: export function itemFromBranch(branch: string): string {
 731:   const raw = String(branch ?? '').trim();
 732:   if (raw === '') throw new Error('the branch name is empty, so no item id can be derived from it');
 733:   if (raw === 'HEAD') throw new Error('HEAD is detached, so the branch names no item â€” check out the item branch, or set AT_DB_SLOT');
 734: 
 735:   const ids = [...new Set([...raw.matchAll(/\b(ai4dev|ai4pm)-(\d+)\b/gi)].map((match) => `${match[1].toUpperCase()}-${Number(match[2])}`))];
 736:   if (ids.length === 0) throw new Error(`the branch "${raw}" names no item id, so no reserved slot can be found for it`);
 737:   if (ids.length > 1) throw new Error(`the branch "${raw}" names ${ids.length} item ids (${ids.join(', ')}) â€” a person decides which one this run verifies`);
 738:   return ids[0];
 739: }
 740: 
 741: /** The branch this tree is on. A git failure refuses; it never falls back to a guess. */
 742: export function currentBranch(root: string = REPO_ROOT): string {
 743:   const res = spawnSync('git', ['-C', root, 'rev-parse', '--abbrev-ref', 'HEAD'], { encoding: 'utf8', env: childEnv() });
 744:   if (res.error) throw new Error(`git could not be run to read the current branch (${diagnostic((res.error as Error).message)})`);
 745:   if (res.status !== 0) throw new Error(`git could not report the current branch (exit ${res.status}): ${diagnostic(res.stderr) || '(no error output)'}`);
 746:   return (res.stdout ?? '').trim();
 747: }
 748: 
 749: /* ------------------------------------------------------------------------------- the pool view */
 750: 
 751: export interface PoolSlotView {
 752:   slot: number;
 753:   dir: string;
 754:   configured: boolean;
 755:   projectId: string | null;
 756:   apiPort: number | null;
 757:   dbPort: number | null;
 758:   reservation: Reservation | null;
 759:   occupiedBy: Holder | null;
 760: }
 761: 
 762: /** What the pool looks like right now â€” for the setup report, the helpers, and a person asking. */
 763: export function readPool(): PoolSlotView[] {
 764:   const views: PoolSlotView[] = [];
 765:   for (let slot = 1; slot <= POOL_SIZE; slot++) {
 766:     const dir = slotDir(slot);
 767:     let config: LocalConfig | null = null;
 768:     try {
 769:       config = readLocalConfig(dir);
 770:     } catch {
 771:       config = null;
 772:     }
 773:     // The claim is keyed on the slot's PERMANENT identity (ruling T6), so this read finds it even
 774:     // when the slot has no config yet and even after `prepare` has moved the slot's ports.
 775:     let occupiedBy: Holder | null = null;
 776:     try {
 777:       occupiedBy = JSON.parse(readFileSync(stackLockPath(slotClaimKey(slot)), 'utf8')) as Holder;
 778:     } catch {
 779:       occupiedBy = null;
 780:     }
 781:     views.push({
 782:       slot,
 783:       dir,
 784:       configured: config !== null,
 785:       projectId: config?.projectId ?? null,
 786:       apiPort: config?.apiPort ?? null,
 787:       dbPort: config?.dbPort ?? null,
 788:       reservation: readReservation(slot),
 789:       occupiedBy,
 790:     });
 791:   }
 792:   return views;
 793: }
 794: 
 795: /* ---------------------------------------------------------------------------------- occupancy */
 796: 
 797: export interface Occupancy {
 798:   slot: number;
 799:   dir: string;
 800:   config: LocalConfig;
 801:   /** The item this occupancy belongs to, or `null` when it came from the AT_DB_SLOT override. */
 802:   item: string | null;
 803:   via: 'reservation' | 'override';
 804:   claim: StackLock;
 805:   release(): void;
 806: }
 807: 
 808: export interface OccupyOptions {
 809:   /** The item id. Derived from the branch when absent. */
 810:   item?: string;
 811:   /** The AT_DB_SLOT override â€” for runs outside an item: the founder, the evidence gate, a spike. */
 812:   slot?: number;
 813: }
 814: 
 815: /**
 816:  * Take a slot for one verify window.
 817:  *
 818:  * ADMISSION CONTROL IS THE COORDINATOR'S, NOT THE RUNNER'S. A run whose item holds no reservation
 819:  * refuses and names the helper that makes one; it never falls back onto a free slot, because a
 820:  * silent fallback is how a pool of two quietly becomes a pool of one shared stack.
 821:  *
 822:  * The claim is the runner's existing stack lock, with the takeover policy the ruled text asks
 823:  * for: a DEAD holder pid is broken loudly, a live holder is never displaced at any age.
 824:  *
 825:  * THE OVERRIDE SKIPS ADMISSION CONTROL, NOT OWNERSHIP (ruling T5). `AT_DB_SLOT` is ruled â€” the
 826:  * founder, the evidence gate and the spike all use it â€” and slot STATE is disposable by design, so
 827:  * the reservation is not what protects a slot; the occupancy claim is, and the override keeps it.
 828:  * But taking a slot another item is holding is a silent collision and costs nothing to refuse, so
 829:  * an override run refuses loudly when the target slot's reservation names a DIFFERENT item than
 830:  * this run can derive. A run that can derive no item at all treats ANY reservation as foreign.
 831:  */
 832: export function occupy(requirement: string, options: OccupyOptions = {}): Occupancy {
 833:   let slot: number;
 834:   let item: string | null = null;
 835:   let via: 'reservation' | 'override';
 836: 
 837:   if (options.slot !== undefined) {
 838:     slot = assertSlotNumber(options.slot);
 839:     item = options.item ?? null;
 840:     via = 'override';
 841: 
 842:     let derived: string | null = options.item ?? null;
 843:     if (derived === null) {
 844:       try {
 845:         derived = itemFromBranch(currentBranch());
 846:       } catch {
 847:         derived = null; // no item derivable â€” every reservation is then somebody else's
 848:       }
 849:     }
 850:     // STRICT (ruling A2): an unreadable reservation refuses here rather than reading as absent.
 851:     const reserved = readReservationStrict(slot);
 852:     if (reserved && reserved.item !== derived) {
 853:       throw new Error(
 854:         `refusing to take slot ${slot} with AT_DB_SLOT: it is reserved for ${reserved.item} ` +
 855:           `(branch ${reserved.branch || 'unrecorded'}, taken ${reserved.at}, holder ${reserved.holder}) and this run ` +
 856:           `${derived === null ? 'can derive no item of its own' : `belongs to ${derived}`}. Every occupancy resets the ` +
 857:           `slot's database from its own tree, so this run would rebuild that item's database under it. Use a slot the ` +
 858:           `pool shows free, or release that reservation first.`,
 859:       );
 860:     }
 861:   } else {
 862:     item = options.item ?? itemFromBranch(currentBranch());
 863:     const reserved = slotForItem(item);
 864:     if (reserved === null) {
 865:       throw new Error(
 866:         `no database slot is reserved for ${item}. The coordinator reserves a slot when the item starts â€” ` +
 867:           `run \`Reserve-DbSlot -Item ${item}\` from loop/work/db-slots.ps1, or set AT_DB_SLOT=<n> for a run ` +
 868:           `outside an item. There is deliberately no fallback onto a free slot: admission control belongs to ` +
 869:           `the coordinator, not to this run.`,
 870:       );
 871:     }
 872:     slot = reserved;
 873:     via = 'reservation';
 874:   }
 875: 
 876:   const dir = slotDir(slot);
 877:   const configPath = slotConfigPath(slot);
 878:   if (!existsSync(configPath)) {
 879:     // TWO CAUSES, and the repair is the same one command (ruling T11). Either the pool was never
 880:     // set up on this machine, or a `prepare` died between the mirror â€” which removes the slot's
 881:     // config on purpose, so no slot ever holds the personal identity â€” and the regenerated write
 882:     // that immediately follows it. A missing config is the safe end of that window, never a wrong
 883:     // one, and it is not permanent.
 884:     throw new Error(
 885:       `slot ${slot} has no config at ${configPath}. Either the pool was never set up on this machine, or a ` +
 886:         `previous run stopped between the mirror and the write that follows it â€” the mirror removes the slot's ` +
 887:         `config on purpose, so a slot never carries the personal identity even for an instant. Either way the ` +
 888:         `repair is one command: \`bun tests/at/harness/db-pool.ts setup\`.`,
 889:     );
 890:   }
 891:   refusePersonal(readFileSync(configPath, 'utf8'), REPO_ROOT, `occupy slot ${slot}`);
 892: 
 893:   const config = readLocalConfig(dir);
 894:   // Keyed on the slot's PERMANENT identity, never on the config's current ports (ruling T6).
 895:   const claim = acquireStackLock(slotClaimKey(slot), requirement, { takeover: 'dead-pid-only' });
 896: 
 897:   // The reservation is re-read AFTER the claim. Between the lookup above and this line the
 898:   // coordinator may have released the slot and given it to another item, and a run that resets a
 899:   // database another item now owns is the exact collision this pool exists to prevent.
 900:   if (via === 'reservation' && item !== null) {
 901:     // STRICT here too (ruling A2), so `nobody` below means the file is GONE and never means the
 902:     // file could not be read. The claim is released before the refusal travels, exactly as the
 903:     // refusal below does it: a refusal that strands a claim locks the slot against everyone.
 904:     let still: Reservation | null;
 905:     try {
 906:       still = readReservationStrict(slot);
 907:     } catch (err) {
 908:       claim.release();
 909:       throw err;
 910:     }
 911:     if (still?.item !== item) {
 912:       claim.release();
 913:       throw new Error(
 914:         `slot ${slot} was reserved for ${item} when this run started and now names ${still?.item ?? 'nobody'} â€” ` +
 915:           `the reservation changed under the run, so nothing was reset and nothing was run.`,
 916:       );
 917:     }
 918:   }
 919: 
 920:   return {
 921:     slot,
 922:     dir,
 923:     config,
 924:     item,
 925:     via,
 926:     claim,
 927:     release: () => claim.release(),
 928:   };
 929: }
 930: 
 931: /** Release an occupancy. Null-safe so it can sit in a `finally` beside a claim that never happened. */
 932: export function release(occupancy: Occupancy | null | undefined): void {
 933:   occupancy?.release();
 934: }
 935: 
 936: /* ----------------------------------------------------------------------------------- prepare */
 937: 
 938: export interface PrepareResult {
 939:   status: StackStatus;
 940:   migrations: MigrationProof;
 941:   /** True when the slot's stack had to be restarted because its configuration changed. */
 942:   restarted: boolean;
 943:   /**
 944:    * The nonce this run minted and wrote into the slot database AFTER the reset.
 945:    *
 946:    * It is what turns four plain strings into positive evidence downstream: the child reads it back
 947:    * through the coordinates it was handed, and only then may any capability be called `real`. See
 948:    * `attestation.ts` for why the shape checks in `runner.ts` cannot do that job â€” they guard the
 949:    * personal stack and are fabricable by anyone with a text editor.
 950:    */
 951:   attestation: string;
 952: }
 953: 
 954: interface StartMarker {
 955:   configHash: string;
 956:   at: string;
 957:   pid: number;
 958: }
 959: 
 960: function hashConfig(text: string): string {
 961:   return createHash('sha256').update(text, 'utf8').digest('hex');
 962: }
 963: 
 964: function readMarker(slot: number): StartMarker | null {
 965:   try {
 966:     return JSON.parse(readFileSync(slotMarkerPath(slot), 'utf8')) as StartMarker;
 967:   } catch {
 968:     return null;
 969:   }
 970: }
 971: 
 972: /**
 973:  * Run the pinned CLI against one slot. Raw output is never printed: `supabase start` prints keys.
 974:  *
 975:  * THIS IS THE ONE HELPER (ruling E1, decision D13). No role hand-writes a slot CLI command: the
 976:  * incident of 2026-08-09 was a hand-written spike script that closed neither route the identity
 977:  * override travels by, and it destroyed the founder's database. Everything the wall is made of
 978:  * lives in `supabaseInvocation` in runner.ts â€” the positive `SUPABASE_PROJECT_ID`, the refusal of
 979:  * any other `SUPABASE_*`, `bun --no-env-file`, and the working directory equal to `--workdir` â€”
 980:  * and `slotTarget` is the only thing this file has to get right.
 981:  *
 982:  * It is for commands that must EXIT ZERO. `status` does not (the config disables imgproxy and the
 983:  * pooler), so the identity read below runs the CLI through the same seam and parses the result
 984:  * with the runner's own parser instead.
 985:  */
 986: function runSlotCli(slot: number, args: string[], what: string): void {
 987:   const res = runSupabaseCli(slotTarget(slot), args);
 988:   if (res.error) {
 989:     throw new Error(`could not launch the Supabase CLI to ${what} slot ${slot} (${diagnostic(res.error.message)})`);
 990:   }
 991:   if (res.status !== 0) {
 992:     throw new Error(`\`supabase ${args.join(' ')}\` could not ${what} slot ${slot} (exit ${res.status}): ${diagnostic(res.stderr) || diagnostic(res.stdout) || '(no error output)'}`);
 993:   }
 994: }
 995: 
 996: /** Both halves of a slot's identity, in the shape the shared CLI seam takes. */
 997: export function slotTarget(slot: number): CliTarget {
 998:   return { workdir: slotDir(slot), projectId: slotProjectId(slot) };
 999: }
1000: 
1001: /**
1002:  * The Supabase container names in a piece of CLI output that do NOT belong to this slot.
1003:  *
1004:  * The CLI names its containers `supabase_<service>_<project id>`, and it prints them: a healthy
1005:  * `supabase status` opens with `Stopped services: [supabase_imgproxy_<id> supabase_pooler_<id>]`,
1006:  * and its error paths say things like `No such container: supabase_db_<id>`. That line is the
1007:  * CLI's own statement of WHICH PROJECT it resolved, and it is the instrument that would have
1008:  * caught the incident: on 2026-08-10 a hybrid invocation reported the slot's ports beside
1009:  * `supabase_imgproxy_poancmeitlmxejofwzuu` â€” the personal project â€” in the same output.
1010:  *
1011:  * The rule is a suffix match and it is deliberately strict: a `supabase_â€¦` token that does not end
1012:  * in this slot's project id is reported, whatever it is. A false report costs a loud refusal on a
1013:  * read; a missed one costs a database.
1014:  */
1015: export function foreignContainerNames(text: string, slotProject: string): string[] {
1016:   const names = [...String(text ?? '').matchAll(/\bsupabase_[A-Za-z0-9][A-Za-z0-9_.-]*/g)].map((match) => match[0]);
1017:   return [...new Set(names.filter((name) => !name.endsWith(`_${slotProject}`)))];
1018: }
1019: 
1020: /**
1021:  * The Supabase container names in a piece of CLI output that DO belong to this slot â€” the positive
1022:  * half of the same instrument (ruling T2).
1023:  *
1024:  * MEASURED BEFORE THIS WAS WRITTEN, 2026-08-10, read-only, both slots: `status -o json` through the
1025:  * shared helper prints exactly two such tokens on stderr â€”
1026:  * `Stopped services: [supabase_imgproxy_ai4good-slot-N supabase_pooler_ai4good-slot-N]` â€” and zero
1027:  * tokens that belong to any other project. So the evidence this check demands is evidence the CLI
1028:  * really does produce.
1029:  *
1030:  * Absence is not innocence: `foreignContainerNames` finds nothing in an output that names no
1031:  * container at all, which is exactly the hybrid shape the 2026-08-09 incident wore (the slot's
1032:  * ports beside another project's containers). A destructive act therefore requires at least one
1033:  * name that IS this slot's, never merely the lack of one that is not.
1034:  *
1035:  * Residual, recorded rather than hidden: those two tokens exist because the tracked config disables
1036:  * imgproxy and the pooler. A config that enables both would print no "Stopped services" line, this
1037:  * check would find no evidence, and the destructive act would REFUSE. That is the fail-closed
1038:  * direction (ruling E7) and it is loud, but it is a real coupling to the config and to the pinned
1039:  * CLI's output shape (residual F4 in the plan).
1040:  */
1041: export function ownContainerNames(text: string, slotProject: string): string[] {
1042:   const names = [...String(text ?? '').matchAll(/\bsupabase_[A-Za-z0-9][A-Za-z0-9_.-]*/g)].map((match) => match[0]);
1043:   return [...new Set(names.filter((name) => name.endsWith(`_${slotProject}`)))];
1044: }
1045: 
1046: /**
1047:  * DOCKER'S OWN ANSWER, on the destructive path, every time (ruling T2).
1048:  *
1049:  * The CLI's status output is one instrument and it is coupled to the CLI's version. Docker is a
1050:  * second, independent one: before a reset, docker must show this slot's OWN database container
1051:  * running. A docker read is the only interaction anything here is permitted to have with the
1052:  * founder's stack, and it is unrestricted on slots.
1053:  *
1054:  * It fails closed. If docker cannot be run, or reports no container of this slot's own, the reset
1055:  * refuses: an instrument that cannot answer is not an answer of "yes".
1056:  */
1057: export function slotDbContainers(slot: number): string[] {
1058:   const project = slotProjectId(slot);
1059:   const res = spawnSync('docker', ['ps', '--filter', `name=supabase_db_${project}`, '--format', '{{.Names}}'], {
1060:     env: childEnv(),
1061:     encoding: 'utf8',
1062:   });
1063:   if (res.error) throw new Error(`docker could not be run to confirm slot ${slot}'s database container (${diagnostic((res.error as Error).message)})`);
1064:   if (res.status !== 0) throw new Error(`\`docker ps\` exited ${res.status} while confirming slot ${slot}'s database container: ${diagnostic(res.stderr) || '(no error output)'}`);
1065:   return (res.stdout ?? '')
1066:     .split('\n')
1067:     .map((line) => line.trim())
1068:     .filter(Boolean);
1069: }
1070: 
1071: function proveSlotDbContainer(slot: number, act: string): void {
1072:   const project = slotProjectId(slot);
1073:   const names = slotDbContainers(slot);
1074:   const own = names.filter((name) => name.includes(project));
1075:   if (own.length !== names.length || own.length === 0) {
1076:     throw new Error(
1077:       `REFUSING TO ${act.toUpperCase()} SLOT ${slot}: docker does not confirm this slot's own database container. ` +
1078:         `\`docker ps\` named ${names.length ? names.join(', ') : 'no running container'} for ${project}. ` +
1079:         `Start the slot (\`bun tests/at/harness/db-pool.ts setup\`) and try again. Nothing was done.`,
1080:     );
1081:   }
1082:   console.log(`db-pool â€” docker confirms slot ${slot}'s own database container before the ${act}: ${own.join(', ')}`);
1083: }
1084: 
1085: export interface SlotIdentityRead extends SlotIdentityProof {
1086:   /** The stack's own report, when a stack answered. */
1087:   status: StackStatus | null;
1088:   /** Why no stack answered, when none did. Never a mismatch â€” a mismatch throws. */
1089:   notRunning: string | null;
1090:   /**
1091:    * The project id this read POSITIVELY proved, or `null` when it proved none (audit ruling B2).
1092:    *
1093:    * Positive evidence means the CLI's own output named a container belonging to this slot. The
1094:    * other three checks can all hold over an output that names no container at all, and that is the
1095:    * exact shape the 2026-08-09 hybrid produced. A destructive read always carries the id, because a
1096:    * destructive read with no own container refuses above; a non-running or merely informational
1097:    * read carries `null`, and `resetLocalDatabase` refuses on it.
1098:    */
1099:   provenProjectId: string | null;
1100: }
1101: 
1102: /**
1103:  * THE PRE-DESTRUCTIVE IDENTITY READ (ruling E1, decision D13).
1104:  *
1105:  * Before anything destructive, the CLI is asked â€” through the same helper, so the read and the
1106:  * destructive act resolve identically â€” to say what it resolves. Three things must hold, and any
1107:  * one of them failing refuses loudly and does nothing:
1108:  *
1109:  *   1. every Supabase container name in the output belongs to this slot's project;
1110:  *   2. the founder's personal project id appears nowhere in the output;
1111:  *   3. the ports and keys the stack reports are the slot's own, loopback, locally issued
1112:  *      (`localStackProblems`, against the SLOT's config).
1113:  *
1114:  * A DESTRUCTIVE act adds a fourth, and it is the one that closes the vacuous pass (ruling T2):
1115:  *
1116:  *   4. at least one Supabase container name in the output IS this slot's own.
1117:  *
1118:  * The first three can all hold over an output that names no container at all, and an output that
1119:  * names no container is precisely what the 2026-08-09 hybrid produced when it reported the slot's
1120:  * ports while resolving another project. Absence of contrary evidence is not identity.
1121:  *
1122:  * A stack that is simply not running is not a mismatch: it is reported as `notRunning` so the
1123:  * caller can decide (there is nothing to stop), and only a real disagreement throws.
1124:  */
1125: export function proveSlotTarget(slot: number, act: string, itemRoot: string = REPO_ROOT, destructive = false): SlotIdentityRead {
1126:   const project = slotProjectId(slot);
1127:   const res: CliResult = runSupabaseCli(slotTarget(slot), ['status', '-o', 'json']);
1128:   if (res.error) {
1129:     throw new Error(`refusing to ${act} slot ${slot}: the Supabase CLI could not be launched to read its identity (${diagnostic(res.error.message)})`);
1130:   }
1131: 
1132:   const raw = `${res.stdout}\n${res.stderr}`;
1133:   const personal = personalProjectId(itemRoot);
1134:   const foreign = foreignContainerNames(raw, project);
1135:   const carriesPersonal = personal !== '' && raw.includes(personal);
1136:   if (foreign.length || carriesPersonal) {
1137:     throw new Error(
1138:       `REFUSING TO ${act.toUpperCase()} SLOT ${slot}: the identity read did not resolve to ${project}. ` +
1139:         (foreign.length ? `The CLI named ${foreign.join(', ')}. ` : '') +
1140:         (carriesPersonal ? `The founder's personal project id appears in the output. ` : '') +
1141:         `Nothing was done.`,
1142:     );
1143:   }
1144: 
1145:   let status: StackStatus;
1146:   try {
1147:     status = parseStackStatus(res);
1148:   } catch (err) {
1149:     return { status: null, notRunning: diagnostic((err as Error).message), provenProjectId: null };
1150:   }
1151: 
1152:   const config = readLocalConfig(slotDir(slot));
1153:   const problems = localStackProblems(status, config);
1154:   if (problems.length) {
1155:     throw new Error(
1156:       `REFUSING TO ${act.toUpperCase()} SLOT ${slot}: the stack that answered is not provably slot ${slot}'s own. ` +
1157:         `Failed checks: ${problems.join('; ')}. (Values are deliberately not printed.) Nothing was done.`,
1158:     );
1159:   }
1160: 
1161:   const own = ownContainerNames(raw, project);
1162:   if (destructive && own.length === 0) {
1163:     throw new Error(
1164:       `REFUSING TO ${act.toUpperCase()} SLOT ${slot}: the identity read names no container belonging to ${project}, ` +
1165:         `so it carries no positive evidence of which project the CLI resolved. The ports alone are not identity â€” ` +
1166:         `the 2026-08-09 incident reported the right ports while resolving another project. Nothing was done.`,
1167:     );
1168:   }
1169: 
1170:   console.log(
1171:     `db-pool â€” slot ${slot} identity proven before the ${act}: project ${project}, api ${config.apiPort}, db ${config.dbPort}` +
1172:       (own.length ? `, containers ${own.join(', ')}` : ''),
1173:   );
1174:   return { status, notRunning: null, provenProjectId: own.length ? project : null };
1175: }
1176: 
1177: /**
1178:  * `db reset` on a slot. THE IDENTITY READ IS INSIDE, so no caller can reach the reset without it â€”
1179:  * that is what "structurally on the destructive path" means, as opposed to a rule someone follows.
1180:  */
1181: export async function resetSlotDatabase(slot: number, itemRoot: string = REPO_ROOT): Promise<StackStatus> {
1182:   // The BROAD guard first (rulings T7 and F1). D5's ruled sentence names "occupy, prepare, reset or
1183:   // emit env", and this is an exported entry point a caller reaches directly â€” the spike does â€” so
1184:   // it runs the guard itself instead of trusting whoever called it to have run it.
1185:   refusePersonalSlotConfig(slot, itemRoot, 'reset');
1186:   const read = proveSlotTarget(slot, 'reset', itemRoot, true);
1187:   if (!read.status) {
1188:     throw new Error(
1189:       `refusing to reset slot ${slot}: it reported no running stack, so its identity could not be proven ` +
1190:         `(${read.notRunning}). Start the slot first; nothing was reset.`,
1191:     );
1192:   }
1193:   proveSlotDbContainer(slot, 'reset');
1194:   // THE READ TRAVELS INTO THE RESET (audit ruling B2). The proof is a parameter, so this call site
1195:   // cannot be bypassed by an importer that aims the reset at a slot without reading it first.
1196:   await resetLocalDatabase(slotTarget(slot), read);
1197:   return read.status;
1198: }
1199: 
1200: /** `stop` on a slot, behind the same guard and the same read. A slot with no stack has nothing to stop. */
1201: export function stopSlotStack(slot: number, itemRoot: string = REPO_ROOT): void {
1202:   refusePersonalSlotConfig(slot, itemRoot, 'stop');
1203:   const read = proveSlotTarget(slot, 'stop', itemRoot, true);
1204:   if (!read.status) {
1205:     console.log(`db-pool â€” slot ${slot} reported no running stack (${read.notRunning}); there is nothing to stop`);
1206:     return;
1207:   }
1208:   runSlotCli(slot, ['stop'], 'stop');
1209: }
1210: 
1211: /** `start` on a slot. Not destructive, and a stack that is down cannot be asked who it is first. */
1212: export function startSlotStack(slot: number): void {
1213:   runSlotCli(slot, ['start'], 'start');
1214: }
1215: 
1216: /**
1217:  * Make the slot's database be the item tree's database, and prove it.
1218:  *
1219:  * The order is load-bearing: mirror the tree, regenerate the identity-overlaid config, restart the
1220:  * stack IF the configuration it was started with has changed, then read the stack, prove it is
1221:  * local, wait for readiness, reset, wait again, and prove the migration set replayed.
1222:  *
1223:  * WHY A MARKER RATHER THAN THE FILE ITSELF decides the restart: the file says what the slot SHOULD
1224:  * be running; only a marker written after a successful start says what it IS running. A crash
1225:  * between writing the config and restarting would otherwise leave equal text over a stack still
1226:  * serving the old auth behaviour, and the next occupancy would trust it.
1227:  */
1228: export async function prepare(occupancy: Occupancy, itemRoot: string = REPO_ROOT): Promise<PrepareResult> {
1229:   const { slot, dir } = occupancy;
1230:   const sourceText = readFileSync(join(itemRoot, 'supabase', 'config.toml'), 'utf8');
1231:   const generated = generateSlotConfig(sourceText, slot);
1232: 
1233:   refusePersonal(generated, itemRoot, `prepare slot ${slot}`);
1234: 
1235:   const closure = pathClosureProblems(generated, itemRoot);
1236:   if (closure.length) {
1237:     throw new Error(
1238:       `slot ${slot} would start half-provisioned: ${closure.join('; ')}. No stack was started and nothing was reset.`,
1239:     );
1240:   }
1241: 
1242:   // THE MIRROR AND THE CONFIG WRITE ARE ONE STEP (ruling T11). The mirror excludes `config.toml`
1243:   // and removes the slot's copy, so between these two statements the slot has NO config â€” never the
1244:   // item tree's one, which carries the personal identity. A crash in the window leaves a slot with
1245:   // nothing, which `occupy` refuses loudly and one `setup` repairs. The write is unconditional:
1246:   // the mirror has just deleted whatever was there.
1247:   mirrorItemTree(itemRoot, slot);
1248:   const configPath = slotConfigPath(slot);
1249:   mkdirSync(join(dir, 'supabase'), { recursive: true });
1250:   writeFileSync(configPath, generated, 'utf8');
1251: 
1252:   const hash = hashConfig(generated);
1253:   const marker = readMarker(slot);
1254:   const restarted = marker?.configHash !== hash;
1255:   if (restarted) {
1256:     // The auth container reads config at START, not at reset, so a changed config that is not
1257:     // restarted into would grade the previous item's auth behaviour.
1258:     console.log(`at:verify â€” db slot ${slot} configuration changed since its last start; restarting the slot's stack`);
1259:     stopSlotStack(slot, itemRoot);
1260:     startSlotStack(slot);
1261:     const proven: StartMarker = { configHash: hash, at: new Date().toISOString(), pid: process.pid };
1262:     writeFileSync(slotMarkerPath(slot), JSON.stringify(proven), 'utf8');
1263:   }
1264: 
1265:   // The identity read doubles as the prove-local check against the SLOT's config, and it is the
1266:   // same read the reset performs again for itself immediately before acting.
1267:   const read = proveSlotTarget(slot, 'prepare', itemRoot);
1268:   if (!read.status) {
1269:     throw new Error(`slot ${slot} reported no running stack (${read.notRunning}), so nothing was reset and nothing was run`);
1270:   }
1271:   const status = read.status;
1272: 
1273:   await waitForReady(status, `before the slot ${slot} reset`);
1274:   await resetSlotDatabase(slot, itemRoot);
1275:   await waitForReady(status, `after the slot ${slot} reset`);
1276:   const migrations = await proveMigrationsReplayed(status, itemRoot);
1277: 
1278:   // THE ATTESTATION IS WRITTEN LAST, and the order is the whole point. The reset destroys everything
1279:   // the previous run left, so a nonce written after it cannot be a leftover; the migration proof
1280:   // runs before it, so nothing this writes can be mistaken for migrated schema. What the child can
1281:   // then establish is exactly one fact, and it is the fact nothing else establishes: the database at
1282:   // the coordinates it was handed is the database this run prepared.
1283:   const attestation = mintAttestationNonce();
1284:   await writeAttestation(status.dbUrl, attestation);
1285: 
1286:   return { status, migrations, restarted, attestation };
1287: }
1288: 
1289: /* ------------------------------------------------------------------------------- env and evidence */
1290: 
1291: /**
1292:  * The coordinates a suite is allowed to see. Nothing else about the slot travels into the child,
1293:  * and the personal guard runs here too: env is how a stack reaches a test, so emitting the wrong
1294:  * one is as destructive as resetting the wrong one.
1295:  *
1296:  * TWO CHECKS, and they see different things (rulings T7 and F1). The broad guard reads the slot's
1297:  * CONFIG, which is where a personal identity would arrive from; the inline checks below read the
1298:  * STATUS, which is what actually answered, and the config guard cannot see that.
1299:  */
1300: export function stackEnv(
1301:   occupancy: Occupancy,
1302:   status: StackStatus,
1303:   itemRoot: string = REPO_ROOT,
1304:   extra: { attestation?: string; mailUrl?: string } = {},
1305: ): Record<string, string> {
1306:   refusePersonalSlotConfig(occupancy.slot, itemRoot, 'emit the coordinates of');
1307: 
1308:   for (const [label, raw] of [
1309:     ['AT_SUPABASE_URL', status.apiUrl],
1310:     ['AT_SUPABASE_DB_URL', status.dbUrl],
1311:   ] as const) {
1312:     const port = Number(new URL(raw).port);
1313:     if (port >= PERSONAL_PORT_LOW && port <= PERSONAL_PORT_HIGH) {
1314:       throw new Error(`refusing to emit ${label}: it points at port ${port}, inside the founder's personal stack's port block`);
1315:     }
1316:   }
1317:   if (occupancy.config.projectId === personalProjectId()) {
1318:     throw new Error(`refusing to emit slot ${occupancy.slot}'s coordinates: its project id is the personal stack's`);
1319:   }
1320:   return {
1321:     AT_SUPABASE_URL: status.apiUrl,
1322:     AT_SUPABASE_DB_URL: status.dbUrl,
1323:     AT_SUPABASE_ANON_KEY: status.anonKey,
1324:     AT_SUPABASE_SERVICE_ROLE_KEY: status.serviceRoleKey,
1325:     // TWO MORE COORDINATES, AND NEITHER IS A CREDENTIAL.
1326:     //
1327:     // The attestation nonce is a value THIS RUN minted and wrote into the slot after its reset; it
1328:     // grants nothing and unlocks nothing, and its only use is to be read back through the four
1329:     // strings above so that "these coordinates answered" becomes a fact instead of a shape.
1330:     //
1331:     // The mail catcher URL comes from the slot's OWN status, never from `[local_smtp] port` plus the
1332:     // per-slot offset. That arithmetic lives in `portMappings` and a second copy of it downstream is
1333:     // how two copies come to disagree while both look right.
1334:     ...(extra.attestation ? { AT_SLOT_ATTESTATION: extra.attestation } : {}),
1335:     ...(extra.mailUrl ? { AT_SUPABASE_MAIL_URL: extra.mailUrl } : {}),
1336:   };
1337: }
1338: 
1339: /**
1340:  * The api port THAT ANSWERED, read from the post-prepare status (audit ruling A3).
1341:  *
1342:  * The status is proven before this is called, so the parse cannot fail in practice; if it ever
1343:  * does, the line carries what the status said verbatim rather than a number from somewhere else.
1344:  */
1345: function statusApiPort(status: StackStatus): string {
1346:   try {
1347:     const port = new URL(status.apiUrl).port;
1348:     if (port) return port;
1349:   } catch {
1350:     /* not a URL this run can parse â€” fall through and print what the status actually said */
1351:   }
1352:   return status.apiUrl || 'unknown';
1353: }
1354: 
1355: /**
1356:  * The one line the verify transcript carries about the database it ran against: which slot, that
1357:  * the reset happened, and what the migration state was. A green that cannot name its reset ran
1358:  * against unknown state.
1359:  *
1360:  * THE PORT COMES FROM THE STATUS, NOT FROM THE OCCUPANCY (ruling A3). The occupancy's config is
1361:  * read when the slot is taken, and `prepare` then regenerates that config from the item tree â€” so
1362:  * under a port change the occupancy names the OLD port while the suite runs against the new one.
