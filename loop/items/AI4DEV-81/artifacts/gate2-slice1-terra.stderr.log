  35: const TEXT_VERSION = 'tos-2026-01+promise-2026-01';
  36: const CLIENT_IP = '203.0.113.7';
  37: const PASSWORD = 'correct horse battery staple';
  38: 
  39: /**
  40:  * THE STANDING SESSION LIFETIME the slot's generated config pins, in milliseconds.
  41:  *
  42:  * It is a NUMBER THIS FILE STATES and the generator's own constant is the source of truth; the two
  43:  * are not imported into each other because a suite reaching into the pool's internals is a coupling
  44:  * nobody wants. What keeps them honest is that a mismatch shows up as a body waiting past its own
  45:  * budget and failing loudly, never as a green.
  46:  */
  47: const SLOT_JWT_EXPIRY_MS = 120_000;
  48: 
  49: const wait = (ms: number): Promise<void> => new Promise((resolve) => setTimeout(resolve, ms));
  50: 
  51: /* ------------------------------------------------------------------ the real client, for AT-001.13 */
  52: 
  53: /**
  54:  * EXACTLY THE CLIENT SURFACE AT-001.13 DEPENDS ON, declared here rather than imported.
  55:  *
  56:  * `@supabase/supabase-js` is a real runtime dependency of that body â€” the criterion is about a
  57:  * client refreshing itself, and this repository ships none â€” but its type declarations describe a
  58:  * BROWSER: they reach for `Window`, `CloseEvent`, `PublicKeyCredential` and a dozen other DOM names.
  59:  * `tests/at/tsconfig.json` deliberately holds `lib: ["ES2022"]` with no DOM, and equally
  60:  * deliberately keeps `skipLibCheck` FALSE â€” its own comment says why, and neither is a knob this
  61:  * suite may turn to make one test body compile.
  62:  *
  63:  * So the module is loaded through a NON-LITERAL specifier, which TypeScript cannot resolve and
  64:  * therefore does not type-check, and the surface this body uses is written out below. That is not a
  65:  * way round the type system: it is a narrower claim than importing the whole library would make,
  66:  * and it is checked at run time by the code failing loudly if the shape is wrong. The same pattern
  67:  * is what `index.ts` uses to load a suite's adapter.
  68:  */
  69: type RealClient = {
  70:   auth: {
  71:     signInWithPassword(credentials: { email: string; password: string }): Promise<{
  72:       data: { session: { access_token: string } | null };
  73:       error: unknown;
  74:     }>;
  75:     getSession(): Promise<{ data: { session: { access_token: string } | null } }>;
  76:     getUser(): Promise<{ data: { user: { id: string } | null } }>;
  77:     stopAutoRefresh(): Promise<void>;
  78:   };
  79: };
  80: 
  81: async function realClient(url: string, anonKey: string): Promise<RealClient> {
  82:   const specifier = '@supabase/supabase-js';
  83:   const module = (await import(/* @vite-ignore */ specifier)) as {
  84:     createClient?: (url: string, key: string, opts: unknown) => RealClient;
  85:   };
  86:   if (typeof module.createClient !== 'function') {
  87:     throw new Error(`${specifier} exports no createClient() â€” AT-001.13's whole claim is about a real client`);
  88:   }
  89:   return module.createClient(url, anonKey, {
  90:     auth: { autoRefreshToken: true, persistSession: false, detectSessionInUrl: false },
  91:   });
  92: }
  93: 
  94: /**
  95:  * Register, confirm through the emailed link, and sign in â€” the live public order, as one step.
  96:  *
  97:  * IT ASSERTS AS IT GOES, because a helper that swallowed a failure would report the wrong cause for
  98:  * the right red: "no session" three assertions later, rather than "no confirmation email arrived".
  99:  */
 100: async function registerConfirmAndSignIn(
 101:   sut: Awaited<ReturnType<Ctx['open']>>['sut'],
 102:   email: string,
 103:   password = PASSWORD,
 104: ): Promise<Session> {
 105:   const registered = await sut.registerWithEmailPassword(email, password);
 106:   expect(registered.sessionId, 'the live registration issued a session, which under confirmations it must not').toBe('');
 107: 
 108:   const link = await sut.emailedVerificationLink(email);
 109:   expect(link, `no confirmation email reached the slot's mail catcher for ${email}`).not.toBeNull();
 110:   const used = await sut.useVerificationLink(link!);
 111:   expect(used.ok, 'following the emailed confirmation link was refused').toBe(true);
 112: 
 113:   const signedIn = await sut.signInWithEmailPassword(email, password);
 114:   expect(signedIn, `sign-in after confirmation failed for ${email}`).toMatchObject({ ok: true });
 115:   if (!signedIn.ok) throw new Error('unreachable: the assertion above fails first');
 116:   expect(signedIn.session.accountId, 'sign-in resolved to a different account than the registration created').toBe(
 117:     registered.accountId,
 118:   );
 119:   return signedIn.session;
 120: }
 121: 
 122: /* ------------------------------------------------------------------------ the ids that go green */
 123: 
 124: /**
 125:  * AT-001.01 â€” the FULL-OUTCOME oracle, not the atomicity arm alone.
 126:  *
 127:  * The criterion names five outcomes and a later sign-in, and gate 1 ruled that a green here has to
 128:  * prove all of them: an account of type NGO, an org, an admin membership in it, an acknowledgment
 129:  * carrying timestamp, IP and text version, the pre-project gate discriminating, and a return
 130:  * sign-in. Atomicity is the NEGATIVE arm and is asserted last.
 131:  *
 132:  * WHAT IS LIVE HERE THAT WAS NOT AT LOOP TIER: the act is the DEPLOYED `complete-signup`, so the
 133:  * platform's own token check, `resolveCaller`, the edge function and the database's
 134:  * `complete_signup` all sit on the path; and `hasPlatformAcknowledgment` calls the SHIPPED SQL
 135:  * predicate rather than an adapter query, which is the one thing the loop tier's own fixture says
 136:  * its green cannot establish.
 137:  */
 138: export async function at00101(ctx: Ctx): Promise<void> {
 139:   const { w, sut } = await ctx.open();
 140:   const email = w.email('ngo-signup');
 141:   const session = await registerConfirmAndSignIn(sut, email);
 142: 
 143:   expect(
 144:     await sut.hasPlatformAcknowledgment(session.accountId),
 145:     'a user who has authenticated but not completed signup must NOT hold the platform acknowledgment',
 146:   ).toBe(false);
 147: 
 148:   const completion = await sut.completeSignup(
 149:     session,
 150:     { accountType: 'ngo', organizationName: 'Riverside Shelter', acknowledgmentTextVersion: TEXT_VERSION },
 151:     CLIENT_IP,
 152:   );
 153:   expect(completion, 'the deployed complete-signup refused the NGO completion').toMatchObject({ ok: true });
 154:   if (!completion.ok) return;
 155:   expect(completion.organizationId, 'an NGO completion produced no organisation').not.toBeNull();
 156: 
 157:   expect(await sut.account(completion.accountId)).toEqual({ id: session.accountId, accountType: 'ngo' });
 158:   expect(await sut.organization(completion.organizationId!)).toMatchObject({ name: 'Riverside Shelter' });
 159:   expect(await sut.membership(completion.organizationId!, completion.accountId)).toEqual({
 160:     organizationId: completion.organizationId,
 161:     accountId: completion.accountId,
 162:     role: 'admin',
 163:   });
 164: 
 165:   const acknowledgments = await sut.acknowledgments(completion.accountId);
 166:   expect(acknowledgments, 'exactly one platform acknowledgment is recorded by one completion').toHaveLength(1);
 167:   expect(acknowledgments[0].textVersion, 'the acknowledgment must say WHICH text was accepted').toBe(TEXT_VERSION);
 168:   // The address the gateway chain REPORTED, never a verified source address â€” the header travels
 169:   // through kong and the edge runtime and must arrive in the row intact.
 170:   expect(acknowledgments[0].ip, 'the reported address did not reach the acknowledgment row').toContain(CLIENT_IP);
 171:   expect(
 172:     Number.isFinite(Date.parse(acknowledgments[0].acknowledgedAt)),
 173:     `the acknowledgment timestamp ${JSON.stringify(acknowledgments[0].acknowledgedAt)} is not a readable instant`,
 174:   ).toBe(true);
 175: 
 176:   expect(
 177:     await sut.hasPlatformAcknowledgment(completion.accountId),
 178:     'the SHIPPED has_platform_acknowledgment does not hold once signup has completed',
 179:   ).toBe(true);
 180: 
 181:   const returning = await sut.signInWithEmailPassword(email, PASSWORD);
 182:   expect(returning, 'the same credentials did not sign in again').toMatchObject({ ok: true });
 183:   if (!returning.ok) return;
 184:   expect(returning.session.accountId).toBe(session.accountId);
 185: 
 186:   // THE NEGATIVE ARM: the acknowledgment is REQUIRED, and a refusal that wrote the account row first
 187:   // has not refused â€” it has half-succeeded. On the live stack this is the database's own
 188:   // single-transaction guarantee, which is what the loop tier could only mirror.
 189:   const other = await registerConfirmAndSignIn(sut, w.email('no-acknowledgment'));
 190:   const refused = await sut.completeSignup(other, { accountType: 'ngo', organizationName: 'Riverside Shelter Annexe' }, CLIENT_IP);
 191:   expect(refused.ok, 'signup completed with no acknowledgment of the ToS and Platform Promise').toBe(false);
 192:   if (refused.ok) return;
 193:   expect(refused.reason, 'the refusal does not say the acknowledgment is what is missing').toMatch(/acknowledgment/i);
 194:   expect(await sut.account(other.accountId), 'the refused completion left an account row behind').toBeNull();
 195:   expect(
 196:     await sut.hasPlatformAcknowledgment(other.accountId),
 197:     'the refused completion recorded an acknowledgment anyway',
 198:   ).toBe(false);
 199: }
