 128: /* ------------------------------------------------------------------------------ the plumbing */
 129: 
 130: interface BunSqlClient {
 131:   (strings: TemplateStringsArray, ...values: unknown[]): Promise<unknown>;
 132:   close(): Promise<void>;
 133: }
 134: type BunSqlCtor = new (url: string) => BunSqlClient;
 135: 
 136: interface Slot {
 137:   apiUrl: string;
 138:   dbUrl: string;
 139:   anonKey: string;
 140:   serviceRoleKey: string;
 141:   mailUrl: string;
 142: }
 143: 
 144: /** What this adapter holds for a session it really obtained. A handle with no entry holds nothing. */
 145: interface LiveSession {
 146:   accessToken: string;
 147:   refreshToken: string;
 148: }
 149: 
 150: /** The one place a handle is turned into a token, and the one place the divergence is enforced. */
 151: function tokensOf(store: Map<string, LiveSession>, session: Session, act: string): LiveSession {
 152:   const held = session.sessionId ? store.get(session.sessionId) : undefined;
 153:   if (!held) {
 154:     throw new Error(
 155:       `refusing to ${act}: this handle names account ${session.accountId} and holds NO session. On the live stack a ` +
 156:         `registration under enable_confirmations = true issues no tokens, so the handle it returns cannot act. Follow ` +
 157:         `the live public order â€” register, use the emailed verification link, sign in â€” and act with the sign-in's ` +
 158:         `session. Nothing was fabricated to make this call work.`,
 159:     );
 160:   }
 161:   return held;
 162: }
 163: 
 164: /** The `session_id` claim, which is the identity of the `auth.sessions` row GoTrue minted. */
 165: function sessionIdOf(accessToken: string): string {
 166:   const claims = JSON.parse(Buffer.from(accessToken.split('.')[1], 'base64url').toString('utf8')) as {
 167:     session_id?: unknown;
 168:     sub?: unknown;
 169:   };
 170:   return String(claims.session_id ?? '');
 171: }
 172: 
 173: function accountIdOf(accessToken: string): string {
 174:   const claims = JSON.parse(Buffer.from(accessToken.split('.')[1], 'base64url').toString('utf8')) as { sub?: unknown };
 175:   return String(claims.sub ?? '');
 176: }
 177: 
 178: /* -------------------------------------------------------------------------------- the factory */
 179: 
 180: export async function createLiveAdapter(opts: {
 181:   slot: Slot;
 182:   vendors: LiveVendors;
 183:   config: unknown;
 184:   worlds: unknown;
 185: }): Promise<{
 186:   sut: { accounts: AccountsSut };
 187:   fixtures: { world(name: string): Promise<World> };
 188:   teardown(): Promise<void>;
 189: }> {
 190:   const { slot, vendors } = opts;
 191:   const api = slot.apiUrl.replace(/\/$/, '');
 192: 
 193:   const SQL = (globalThis as { Bun?: { SQL?: BunSqlCtor } }).Bun?.SQL;
 194:   if (!SQL) throw new Error('this runtime has no SQL client (expected bun) â€” the live adapter reads the slot database directly');
 195:   const sql = new SQL(slot.dbUrl);
 196: 
 197:   const sessions = new Map<string, LiveSession>();
 198: 
 199:   const authPost = async (path: string, body: unknown, bearer?: string): Promise<{ status: number; json: Record<string, unknown> }> => {
 200:     const response = await fetch(`${api}${path}`, {
 201:       method: 'POST',
 202:       headers: {
 203:         apikey: slot.anonKey,
 204:         Authorization: `Bearer ${bearer ?? slot.anonKey}`,
 205:         'Content-Type': 'application/json',
 206:       },
 207:       body: JSON.stringify(body),
 208:     });
 209:     const text = await response.text();
 210:     let json: Record<string, unknown> = {};
 211:     try {
 212:       json = text ? (JSON.parse(text) as Record<string, unknown>) : {};
 213:     } catch {
 214:       json = { raw: text };
 215:     }
 216:     return { status: response.status, json };
 217:   };
 218: 
 219:   /** A deployed edge function, called exactly as a browser client would â€” bearer, JSON, no shortcut. */
 220:   const callFunction = async (name: string, body: unknown, session: Session, ip: string): Promise<{ status: number; json: Record<string, unknown> }> => {
 221:     const tokens = tokensOf(sessions, session, `call the deployed ${name}`);
 222:     const response = await fetch(`${api}/functions/v1/${name}`, {
 223:       method: 'POST',
 224:       headers: {
 225:         apikey: slot.anonKey,
 226:         Authorization: `Bearer ${tokens.accessToken}`,
 227:         'Content-Type': 'application/json',
 228:         // AT-001.01 records the address the gateway chain REPORTED. `_contract.ts` says exactly what
 229:         // that is and is not: a spoofed header is stored verbatim and no source address is verified.
 230:         'x-forwarded-for': ip,
 231:       },
 232:       body: JSON.stringify(body),
 233:     });
 234:     const text = await response.text();
 235:     let json: Record<string, unknown> = {};
 236:     try {
 237:       json = text ? (JSON.parse(text) as Record<string, unknown>) : {};
 238:     } catch {
 239:       json = { raw: text };
 240:     }
 241:     return { status: response.status, json };
 242:   };
 243: 
 244:   /**
 245:    * The links a message carries, in the order they appear.
 246:    *
 247:    * The RAW message is searched rather than a rendered body, so a token survives verbatim. Both the
 248:    * confirmation and the recovery mail carry `/auth/v1/verify?...`, and they are told apart by the
 249:    * `type` parameter â€” which is what AI4DEV-60's proof had to do too, because one address can hold
 250:    * both kinds at once.
 251:    */
 252:   const linksFor = async (address: string, wanted: 'signup' | 'recovery'): Promise<string[]> => {
 253:     const messages = await vendors.email.messagesFor(address);
 254:     const links: string[] = [];
 255:     for (const message of messages) {
 256:       // Quoted-printable soft line breaks are what a mail transport inserts into a long URL; leaving
 257:       // them in produces a link that 404s and reads exactly like "no email arrived".
 258:       const body = message.body.replace(/=\r?\n/g, '').replace(/&amp;/g, '&');
 259:       for (const match of body.matchAll(/https?:\/\/[^\s"'<>)\]]+/g)) {
 260:         const url = match[0].replace(/[.,;]+$/, '');
 261:         if (!url.includes('/auth/v1/verify')) continue;
 262:         if (!url.includes(`type=${wanted}`)) continue;
 263:         links.push(url);
 264:       }
 265:     }
 266:     return links;
 267:   };
 268: 
 269:   const rows = async <T>(query: Promise<unknown>): Promise<T[]> => (await query) as T[];
 270: 
 271:   const accounts: AccountsSut = {
 272:     /* ------------------------------------------------- Supabase Auth, over the slot's own gateway */
 273: 
 274:     registerWithEmailPassword: async (email, password) => {
 275:       const { status, json } = await authPost('/auth/v1/signup', { email, password });
 276:       if (status >= 400) throw new Error(`the live signup for a fresh address answered ${status}`);
 277:       // NO SESSION IS MINTED HERE. See this file's header: with confirmations on the live stack
 278:       // issues none, and a fabricated handle would let a body act as a user that cannot act.
 279:       const accountId = String((json.id as string | undefined) ?? (json.user as { id?: string } | undefined)?.id ?? '');
 280:       if (!accountId) throw new Error('the live signup answered 200 but named no user id');
 281:       return { accountId, email, provider: 'email', sessionId: '' };
 282:     },
 283: 
 284:     signInWithEmailPassword: async (email, password) => {
 285:       const { status, json } = await authPost('/auth/v1/token?grant_type=password', { email, password });
 286:       if (status >= 400) {
 287:         // ONE REASON FOR BOTH BRANCHES, which is the shape `_contract.ts` requires: an answer that
 288:         // differed would tell an anonymous caller which addresses hold accounts.
 289:         return { ok: false, reason: String(json.msg ?? json.error_description ?? 'sign-in was refused') };
 290:       }
 291:       const accessToken = String(json.access_token ?? '');
 292:       const refreshToken = String(json.refresh_token ?? '');
 293:       if (!accessToken) return { ok: false, reason: 'sign-in answered 200 with no access token' };
 294:       const sessionId = sessionIdOf(accessToken);
 295:       sessions.set(sessionId, { accessToken, refreshToken });
 296:       return { ok: true, session: { accountId: accountIdOf(accessToken), email, provider: 'email', sessionId } };
 297:     },
 298: 
 299:     /**
 300:      * THE LINKED GITHUB IDENTITY, WRITTEN BY THE OPERATOR â€” and it is a GIVEN, never an act under
 301:      * test.
 302:      *
 303:      * The real act is a browser consent round trip that no agent performs, and this repository holds
 304:      * no OAuth credential for it. What is written here is the STATE Auth would be in afterwards: one
 305:      * `auth.identities` row. Two ids read this state â€” AT-001.06 needs a fully signed-up volunteer
 306:      * before it can test an NGO-only refusal, and AT-001.03's volunteer half needs the same
 307:      * precondition â€” and for both of them the link is scenery.
 308:      *
 309:      * AT-001.04 AND AT-001.05 DO NOT GET TO USE IT, because for them the link IS the act: "linking
 310:      * completes signup", and "when the link completes, onboarding fires". Their integration bodies
 311:      * refuse with the missing capability named rather than reaching this method, and the manifest
 312:      * declares them red on exactly that. The distinction is the criterion's, not this file's.
 313:      */
 314:     linkGithubIdentity: async (session, githubHandle) => {
 315:       const identityId = crypto.randomUUID();
 316:       await sql`
 317:         insert into auth.identities (id, provider_id, user_id, identity_data, provider, last_sign_in_at, created_at, updated_at)
 318:         values (
 319:           ${identityId}::uuid,
 320:           ${githubHandle},
 321:           ${session.accountId}::uuid,
 322:           ${JSON.stringify({ sub: githubHandle, user_name: githubHandle, provider_id: githubHandle })}::jsonb,
 323:           'github',
 324:           now(), now(), now()
 325:         )
 326:       `;
 327:     },
 328: 
 329:     signOut: async (session) => {
 330:       const tokens = tokensOf(sessions, session, 'sign out');
 331:       // `?scope=local` ends THIS session. The vendor's default is `global`, which ends every session
 332:       // the account holds â€” measured in AI4DEV-60's proof â€” and `_contract.ts` models the local one.
 333:       const response = await fetch(`${api}/auth/v1/logout?scope=local`, {
 334:         method: 'POST',
 335:         headers: { apikey: slot.anonKey, Authorization: `Bearer ${tokens.accessToken}` },
 336:       });
 337:       if (response.status >= 400) throw new Error(`the live logout answered ${response.status}`);
 338:       sessions.delete(session.sessionId);
 339:     },
 340: 
 341:     refreshSession: async (session): Promise<RefreshSessionOutcome> => {
 342:       const tokens = tokensOf(sessions, session, 'refresh a session');
 343:       // NO CREDENTIALS IN THIS CALL, which is the whole content of AT-001.13's mechanism: a refresh
 344:       // token, and no password anywhere.
 345:       const { status, json } = await authPost('/auth/v1/token?grant_type=refresh_token', { refresh_token: tokens.refreshToken });
 346:       if (status >= 400) return { ok: false, reason: String(json.msg ?? 'the refresh was refused') };
 347:       const accessToken = String(json.access_token ?? '');
 348:       if (!accessToken) return { ok: false, reason: 'the refresh answered 200 with no access token' };
 349:       const sessionId = sessionIdOf(accessToken);
 350:       sessions.set(sessionId, { accessToken, refreshToken: String(json.refresh_token ?? tokens.refreshToken) });
 351:       return { ok: true, session: { ...session, sessionId } };
 352:     },
 353: 
 354:     sessionsOf: async (accountId) => {
 355:       const found = await rows<{ id: string }>(sql`select id from auth.sessions where user_id = ${accountId}::uuid order by created_at`);
 356:       return found.map((row) => ({ sessionId: String(row.id) }));
 357:     },
 358: 
 359:     requestPasswordReset: async (email) => {
 360:       // IT ALWAYS SUCCEEDS, including for an address nobody registered â€” a security shape, measured
 361:       // on the live stack in AI4DEV-60's proof, not a convenience.
 362:       await authPost('/auth/v1/recover', { email });
 363:       return { ok: true };
 364:     },
