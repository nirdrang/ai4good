 378: /* ------------------------------------------------------- the personal stack, refused in code */
 379: 
 380: /**
 381:  * The "untouchable" ruling as an executable guard. Called before every destructive act and before
 382:  * any env is emitted, because a convention that is only written down is one a later change can
 383:  * step over without noticing.
 384:  *
 385:  * It scans EVERY active port-valued key, not a fixed list: the danger is a port in the personal
 386:  * block reaching a slot, and it does not matter which setting carried it there.
 387:  */
 388: export function personalBlockProblems(slotConfigText: string, personalProjectId: string): string[] {
 389:   const problems: string[] = [];
 390:   const entries = scanConfig(slotConfigText);
 391: 
 392:   const projectId = entries.find((entry) => entry.section === '' && entry.key === 'project_id');
 393:   const value = /^"([^"]*)"/.exec(projectId?.value ?? '')?.[1] ?? '';
 394:   if (!value) problems.push('the slot config carries no project_id, so it cannot be told apart from the personal stack');
 395:   else if (value === personalProjectId) problems.push(`the slot config carries the personal stack's project id "${personalProjectId}"`);
 396: 
 397:   for (const entry of entries) {
 398:     if (!isPortKey(entry.key)) continue;
 399:     // WHOLE TOKEN, AND AN UNPARSEABLE VALUE IS A PROBLEM (audit ruling A5). Two fail-opens sat
 400:     // here: a prefix parse read `54_321` â€” a legal TOML spelling of a personal-block port â€” as
 401:     // 54, and a value that did not parse at all was skipped in silence. A port this guard cannot
 402:     // read cannot be shown to be outside the founder's block, so it refuses, named with its value.
 403:     const port = portValue(entry.value);
 404:     if (port === null) {
 405:       problems.push(
 406:         `[${entry.section}] ${entry.key} = ${entry.value} is not a plain port number, so it cannot be shown to be ` +
 407:           `outside the personal stack's port block ${PERSONAL_PORT_LOW}â€“${PERSONAL_PORT_HIGH}`,
 408:       );
 409:       continue;
 410:     }
 411:     if (port >= PERSONAL_PORT_LOW && port <= PERSONAL_PORT_HIGH) {
 412:       problems.push(`[${entry.section}] ${entry.key} = ${port} is inside the personal stack's port block ${PERSONAL_PORT_LOW}â€“${PERSONAL_PORT_HIGH}`);
 413:     }
 414:     if (entry.key === 'inspector_port' && port === PERSONAL_INSPECTOR_PORT) {
 415:       problems.push(`[${entry.section}] inspector_port = ${port} is the personal stack's inspector port`);
 416:     }
 417:   }
 418: 
 419:   return problems;
 420: }
