 121: describe('one slot has exactly one occupier', () => {
 122:   it('two concurrent occupies on one slot end with exactly one winner', async () => {
 123:     installSlot(1);
 124:     const moduleUrl = new URL('./db-pool.ts', import.meta.url).href;
 125:     const startAt = Date.now() + 800;
 126: 
 127:     const contender = (): Promise<string> => {
 128:       const code =
 129:         `const { occupy } = await import(${JSON.stringify(moduleUrl)});\n` +
 130:         `while (Date.now() < ${startAt}) {}\n` + // a barrier, so both attempt at the same instant
 131:         `try {\n` +
 132:         `  const held = occupy('req-000', { slot: 1 });\n` +
 133:         `  console.log('ACQUIRED');\n` +
 134:         `  await Bun.sleep(600);\n` + // hold it, so the loser meets a LIVE holder
 135:         `  held.release();\n` +
 136:         `} catch { console.log('REFUSED'); }\n`;
 137:       // spawn, NOT spawnSync: a synchronous spawn would run the contenders one after the other,
 138:       // and the second would find the claim already released â€” a race that never raced.
 139:       return new Promise<string>((resolve) => {
 140:         const child = spawn(bunExecutable(), ['--no-env-file', '-e', code], {
 141:           env: { ...process.env, AT_DB_POOL_ROOT: poolTemp, AT_LOCK_DIR: lockTemp } as NodeJS.ProcessEnv,
 142:           stdio: ['ignore', 'pipe', 'pipe'],
 143:         });
 144:         let out = '';
 145:         child.stdout.on('data', (chunk: Buffer) => (out += chunk.toString('utf8')));
 146:         child.stderr.on('data', (chunk: Buffer) => (out += chunk.toString('utf8')));
 147:         child.once('error', (err) => resolve(`ERROR ${err.message}`));
 148:         child.once('close', () => resolve(out));
 149:       });
 150:     };
 151: 
 152:     const [a, b] = await Promise.all([contender(), contender()]);
 153:     const outcomes = [a, b].map((out) => (out.includes('ACQUIRED') ? 'ACQUIRED' : out.includes('REFUSED') ? 'REFUSED' : `UNKNOWN(${out.trim()})`));
 154: 
 155:     try {
 156:       expect(outcomes.filter((o) => o === 'ACQUIRED'), `outcomes were ${JSON.stringify(outcomes)}`).toHaveLength(1);
 157:       expect(outcomes.filter((o) => o === 'REFUSED'), `outcomes were ${JSON.stringify(outcomes)}`).toHaveLength(1);
 158:       expect(existsSync(claimPath(1)), 'the winner did not release its claim').toBe(false);
 159:     } finally {
 160:       scrubClaim(1);
 161:     }
 162:   }, 60_000);
 163: 
 164:   it('breaks a dead holder LOUDLY and records the takeover in the new claim', () => {
 165:     installSlot(1);
 166:     // A REAL process id, from a child that has already exited (ruling F9). A made-up large number
 167:     // is only ASSUMED dead, and a busy machine can legitimately be holding it â€” which would make
 168:     // the one test that guards the takeover rule fail for a reason that has nothing to do with it.
 169:     const gone = deadPid();
 170:     plantClaim(1, { pid: gone, host: 'gone', requirement: 'req-000', startedAt: new Date().toISOString() });
 171:     const said = vi.spyOn(console, 'log').mockImplementation(() => undefined);
 172:     try {
 173:       const held = occupy('req-016', { slot: 1 });
 174:       const claim = JSON.parse(readFileSync(held.claim.file, 'utf8')) as {
 175:         pid?: number;
 176:         tookOverFrom?: { pid?: number; requirement?: string };
 177:       };
 178:       expect(claim.pid, 'the takeover did not record this process as the holder').toBe(process.pid);
 179:       expect(claim.tookOverFrom?.pid, 'the displaced holder was not recorded IN the claim').toBe(gone);
 180:       expect(claim.tookOverFrom?.requirement).toBe('req-000');
 181:       expect(said.mock.calls.flat().join(' '), 'the takeover was silent').toContain('took over a stale stack lock');
 182:       held.release();
 183:     } finally {
 184:       said.mockRestore();
 185:       scrubClaim(1);
 186:     }
 187:   });
 188: 
 189:   it('never takes over a LIVE holder, at any age, and names it', () => {
 190:     installSlot(1);
 191:     // Alive (this very process) and old enough that the runner's own stale window would displace
 192:     // it. The pool passes dead-pid-only, so it must not.
 193:     plantClaim(1, {
 194:       pid: process.pid,
 195:       host: 'here',
 196:       requirement: 'req-000',
 197:       startedAt: new Date(Date.now() - 48 * 60 * 60 * 1000).toISOString(),
 198:     });
 199:     try {
 200:       expect(() => occupy('req-016', { slot: 1 })).toThrow(new RegExp(`another at:verify run holds this stack \\(pid ${process.pid}`));
 201:     } finally {
 202:       scrubClaim(1);
 203:     }
 204:   });
 205: 
 206:   it('never takes over a claim file it cannot identify, and names the file (ruling T1)', () => {
 207:     installSlot(1);
 208:     // AN EMPTY FILE IS WHAT A LIVE CLAIM LOOKS LIKE MID-WRITE. The exclusive create and the write
 209:     // that fills it are two acts, and between them the file exists and says nothing. Under
 210:     // dead-pid-only that must NEVER read as a dead holder: taking it over would delete a live
 211:     // run's brand-new claim, which is the one thing this policy exists to make impossible.
 212:     for (const planted of ['', '   \n', '{"pid":', 'not json at all']) {
 213:       plantRawClaim(1, planted);
 214:       try {
 215:         expect(() => occupy('req-016', { slot: 1 }), `a claim file containing ${JSON.stringify(planted)} was taken over`).toThrow(
 216:           /names no process id that this run can read/,
 217:         );
 218:         expect(() => occupy('req-016', { slot: 1 })).toThrow(claimPath(1));
 219:         expect(existsSync(claimPath(1)), 'the refusal deleted the file it could not identify').toBe(true);
 220:       } finally {
 221:         scrubClaim(1);
 222:       }
 223:     }
 224:   }, 30_000);
 225: 
 226:   it('releases from a `finally` when the caller throws', () => {
 227:     installSlot(1);
 228:     let held: Occupancy | null = null;
 229:     expect(() => {
 230:       try {
 231:         held = occupy('req-016', { slot: 1 });
 232:         throw new Error('the suite blew up');
 233:       } finally {
 234:         release(held);
 235:       }
 236:     }).toThrow('the suite blew up');
 237:     expect(existsSync(claimPath(1)), 'a throwing caller stranded the occupancy claim').toBe(false);
 238:   });
 239: });
