1467: /** bun's SQL client. Described here rather than imported: the runner keeps its own private copy. */
1468: interface BunSqlClient {
1469:   (strings: TemplateStringsArray, ...values: unknown[]): Promise<unknown>;
1470:   close(): Promise<void>;
1471: }
1472: type BunSqlCtor = new (url: string) => BunSqlClient;
1473: 
1474: /** A canary connection may only ever reach a slot; the personal block is refused at the socket. */
1475: async function withSlotSql<T>(slot: number, status: StackStatus, fn: (sql: BunSqlClient) => Promise<T>): Promise<T> {
1476:   const port = Number(new URL(status.dbUrl).port);
1477:   if (!Number.isFinite(port) || (port >= PERSONAL_PORT_LOW && port <= PERSONAL_PORT_HIGH)) {
1478:     throw new Error(`refusing to open a connection for slot ${slot}: port ${port} is inside the founder's personal port block`);
1479:   }
1480:   const SQL = (globalThis as { Bun?: { SQL?: BunSqlCtor } }).Bun?.SQL;
1481:   if (!SQL) throw new Error('this runtime has no SQL client (expected bun)');
1482:   const sql = new SQL(status.dbUrl);
1483:   try {
1484:     return await fn(sql);
1485:   } finally {
1486:     await sql.close().catch(() => undefined);
1487:   }
1488: }
