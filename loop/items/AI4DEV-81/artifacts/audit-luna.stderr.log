interface BunSqlClient {\n812:   (strings: TemplateStringsArray, ...values: unknown[]): Promise<unknown>;\n813:   
close(): Promise<void>;\n814: }\n815: type BunSqlCtor = new (url: string) => BunSqlClient;\n816: \n817: /** Postgres 
