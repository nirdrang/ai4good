+        'signing in again after revocation did not restore the ability to write',
+      ).toBe(true);
+      expect(
+        (await sut.organizationsNamed(REVOKED_NAME)).length,
+        'the write after re-authentication did not create the organisation',
+      ).toBe(1);
+    },
+    integration: at00112,
   },
