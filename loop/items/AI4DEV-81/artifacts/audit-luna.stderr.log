{ h, w, sut }, harness: h };\n713:   } catch (err) {\n714:     await h.teardown().catch(() => undefined);\n715:     
throw err;\n716:   }\n717: }\n718: \n719: /* 
------------------------------------------------------------------------------- registration */\n720: \n721: /** One 
authored test body, for the suite bound to requirement `R` and sut key `K`, at tier `T`. */\n722: export type 
AtTestBody<R extends SuiteId, K extends SutKeyOf<R>, T extends Tier = 'loop'> = (\n723:   ctx: AtContext<R, K, 
T>,\n724: ) => Promise<void>;\n725: \n726: /**\n727:  * ONE BODY PER ID PER TIER — the per-tier body form.\n728:  
*\n729:  * WHY IT EXISTS. Some acceptance criteria are proved by DIFFERENT PROCEDURES at different tiers,\n730:  * 
proving the same criterion. AT-001.12's expiry arm at loop tier commands a controlled clock\n731:  * forward; at 
integration there is nothing to command, and the same criterion is proved by waiting\n732:  * out a real access token 
against a real GoTrue. Writing one body that branched on the tier would put\n733:  * two procedures inside one 
function with a conditional deciding which claim was being made — and a\n734:  * body that reads `if (h.tier === …)` 
is a body whose green means something different depending on a\n735:  * value the reader has to trace.\n736:  *\n737:  
* WHAT DOES NOT FORK. The CRITERION never forks: both bodies carry the same acceptance text in their\n738:  * title, 
and the id is registered once. What forks is the procedure and, with it, the capabilities\n739:  * the procedure may 
reach — which is what the per-tier context types carry.\n740:  *\n741:  * EVERY TIER MUST BE COVERED, and that is 
