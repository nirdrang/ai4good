 212:   /**
 213:    * THE WITNESS'S OWN TIER/TRANSPORT REFUSALS, PINNED DIRECTLY â€” and this test exists because they
 214:    * were not.
 215:    *
 216:    * `createOracleCapability()` in `oracles.ts` throws on both mismatched combinations BEFORE the
 217:    * witness is ever reached, so through production the witness's copies are unreachable. The
 218:    * assertions in `oracles.selftest.ts` that look like they cover them match text present in BOTH
 219:    * copies, so deleting the witness's half left every test in the tree green. That is a guard that
 220:    * cannot fail, inside the item whose subject is guards that cannot fail.
 221:    *
 222:    * D6's design is that neither side trusts the other to have checked â€” and since the witness table
 223:    * became the only thing between a direct `witnessedCapability()` call and a verdict, deleting the
 224:    * witness's half would reopen exactly the door this file's other tests close. So it is PINNED, not
 225:    * removed, and every regex below matches wording unique to the witness: it says
 226:    * `refusing to construct capability "oracles.judge"` where `oracles.ts` says
 227:    * `refusing to build a â€¦ oracle`. An assertion satisfiable by the other copy would pin nothing.
 228:    */
 229:   it("refuses each mismatched tier/transport pair at the WITNESS, not only at the oracle's own guard", () => {
 230:     const judge = { judge: async () => undefined };
 231: 
 232:     expect(
 233:       () => witnessedCapability('oracles.judge', judge, { tier: 'loop', transport: 'live' }),
 234:       'the witness accepted a loop-tier oracle on a live transport â€” the only guard left is the one in oracles.ts',
 235:     ).toThrow(/refusing to construct capability "oracles\.judge": a loop-tier oracle on a live transport/);
 236: 
 237:     for (const tier of ['integration', 'drill']) {
 238:       expect(
 239:         () => witnessedCapability('oracles.judge', judge, { tier, transport: 'replay-fs' }),
 240:         `the witness accepted a ${tier}-tier oracle answering from committed bytes while reporting nothing stubbed`,
 241:       ).toThrow(
 242:         new RegExp(`refusing to construct capability "oracles\\.judge": a ${tier}-tier oracle on a filesystem replay`),
 243:       );
 244:     }
 245:   });
