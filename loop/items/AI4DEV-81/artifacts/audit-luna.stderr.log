let cursor: object | null = surface;\n    cursor !== null && cursor !== Object.prototype;\n    cursor = 
Object.getPrototypeOf(cursor) as object | null\n  ) {\n    if (Object.prototype.hasOwnProperty.call(cursor, method)) 
return typeof surface[method] === 'function';\n  }\n  return false;\n}\n\n/**\n * THE THIRD ROUTE, and it is a 
