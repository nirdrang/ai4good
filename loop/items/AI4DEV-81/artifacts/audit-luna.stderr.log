1216: /**
1217:  * Make the slot's database be the item tree's database, and prove it.
1218:  *
1219:  * The order is load-bearing: mirror the tree, regenerate the identity-overlaid config, restart the
1220:  * stack IF the configuration it was started with has changed, then read the stack, prove it is
1221:  * local, wait for readiness, reset, wait again, and prove the migration set replayed.
1222:  *
1223:  * WHY A MARKER RATHER THAN THE FILE ITSELF decides the restart: the file says what the slot SHOULD
1224:  * be running; only a marker written after a successful start says what it IS running. A crash
1225:  * between writing the config and restarting would otherwise leave equal text over a stack still
1226:  * serving the old auth behaviour, and the next occupancy would trust it.
1227:  */
1228: export async function prepare(occupancy: Occupancy, itemRoot: string = REPO_ROOT): Promise<PrepareResult> {
1229:   const { slot, dir } = occupancy;
1230:   const sourceText = readFileSync(join(itemRoot, 'supabase', 'config.toml'), 'utf8');
1231:   const generated = generateSlotConfig(sourceText, slot);
1232: 
1233:   refusePersonal(generated, itemRoot, `prepare slot ${slot}`);
1234: 
1235:   const closure = pathClosureProblems(generated, itemRoot);
1236:   if (closure.length) {
1237:     throw new Error(
1238:       `slot ${slot} would start half-provisioned: ${closure.join('; ')}. No stack was started and nothing was reset.`,
1239:     );
1240:   }
1241: 
1242:   // THE MIRROR AND THE CONFIG WRITE ARE ONE STEP (ruling T11). The mirror excludes `config.toml`
1243:   // and removes the slot's copy, so between these two statements the slot has NO config â€” never the
1244:   // item tree's one, which carries the personal identity. A crash in the window leaves a slot with
1245:   // nothing, which `occupy` refuses loudly and one `setup` repairs. The write is unconditional:
1246:   // the mirror has just deleted whatever was there.
1247:   mirrorItemTree(itemRoot, slot);
1248:   const configPath = slotConfigPath(slot);
1249:   mkdirSync(join(dir, 'supabase'), { recursive: true });
1250:   writeFileSync(configPath, generated, 'utf8');
1251: 
1252:   const hash = hashConfig(generated);
1253:   const marker = readMarker(slot);
1254:   const restarted = marker?.configHash !== hash;
1255:   if (restarted) {
1256:     // The auth container reads config at START, not at reset, so a changed config that is not
1257:     // restarted into would grade the previous item's auth behaviour.
1258:     console.log(`at:verify â€” db slot ${slot} configuration changed since its last start; restarting the slot's stack`);
1259:     stopSlotStack(slot, itemRoot);
1260:     startSlotStack(slot);
1261:     const proven: StartMarker = { configHash: hash, at: new Date().toISOString(), pid: process.pid };
1262:     writeFileSync(slotMarkerPath(slot), JSON.stringify(proven), 'utf8');
1263:   }
1264: 
1265:   // The identity read doubles as the prove-local check against the SLOT's config, and it is the
1266:   // same read the reset performs again for itself immediately before acting.
1267:   const read = proveSlotTarget(slot, 'prepare', itemRoot);
1268:   if (!read.status) {
1269:     throw new Error(`slot ${slot} reported no running stack (${read.notRunning}), so nothing was reset and nothing was run`);
1270:   }
1271:   const status = read.status;
1272: 
1273:   await waitForReady(status, `before the slot ${slot} reset`);
1274:   await resetSlotDatabase(slot, itemRoot);
1275:   await waitForReady(status, `after the slot ${slot} reset`);
1276:   const migrations = await proveMigrationsReplayed(status, itemRoot);
1277: 
1278:   // THE ATTESTATION IS WRITTEN LAST, and the order is the whole point. The reset destroys everything
1279:   // the previous run left, so a nonce written after it cannot be a leftover; the migration proof
1280:   // runs before it, so nothing this writes can be mistaken for migrated schema. What the child can
1281:   // then establish is exactly one fact, and it is the fact nothing else establishes: the database at
1282:   // the coordinates it was handed is the database this run prepared.
1283:   //
1284:   // AND THE PROOF TRAVELS INTO IT (ruling S1-1), exactly as it travels into the reset: the write
1285:   // takes the identity read that proved this slot and reads the database URL out of it, so there is
1286:   // no way to aim it at coordinates the read did not prove.
1287:   const attestation = mintAttestationNonce();
1288:   await writeAttestation(slotTarget(slot), read, attestation);
1289: 
1290:   return { status, migrations, restarted, attestation };
1291: }
