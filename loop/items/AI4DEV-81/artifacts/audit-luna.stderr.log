export type Surface = 'backend' | 'ui' | 'skill';\n59: \n60: /**\n61:  * What a suite may vary PER TEST.\n62:  *\n63:  
* Neither the requirement nor the system-under-test key is here any more. Both come from the\n64:  * binding, and both 
