408:/**
409: * AT-001.12 â€” access ends when a session expires OR is revoked, and re-authentication is the remedy.
410: *
411: * TWO ARMS, BOTH AGAINST REAL TIME AND A REAL AUTH.
412: *
413: *   REVOCATION â€” a scoped logout ends THIS session while a SIBLING session of the same account keeps
414: *   working. The sibling is the control that separates "this session ended" from "the account's
415: *   access ended", and without it the criterion's remedy clause is untested.
416: *
417: *   EXPIRY â€” the body WAITS OUT a real access token. There is nothing to command: the slot's config
418: *   pins a standing low `jwt_expiry` precisely so this wait is two minutes rather than an hour, and
419: *   no test edits configuration or restarts anything. The loop body advances a controlled clock,
420: *   which is a different procedure proving the same clause.
421: */
422:export async function at00112(ctx: Ctx): Promise<void> {
423:  const { w, sut } = await ctx.open();
424:  const email = w.email('sessions');
425:  const session = await registerConfirmAndSignIn(sut, email);
426:
427:  const completion = await sut.completeSignup(
428:    session,
429:    { accountType: 'ngo', organizationName: 'Riverside Shelter', acknowledgmentTextVersion: TEXT_VERSION },
430:    CLIENT_IP,
431:  );
432:  expect(completion, 'the session under test could not complete signup, so nothing below is about a working session').toMatchObject({
433:    ok: true,
434:  });
435:
436:  // A SIBLING SESSION, opened before the logout, standing as the control.
437:  const sibling = await sut.signInWithEmailPassword(email, PASSWORD);
438:  expect(sibling, 'a second sign-in for the same account failed').toMatchObject({ ok: true });
439:  if (!sibling.ok) return;
440:  const before = await sut.sessionsOf(session.accountId);
441:  expect(before.length, 'the account does not hold the two sessions this arm needs').toBeGreaterThanOrEqual(2);
442:
443:  await sut.signOut(session);
444:  const after = await sut.sessionsOf(session.accountId);
445:  expect(after.map((row) => row.sessionId), 'the signed-out session row is still there').not.toContain(session.sessionId);
446:  expect(after.map((row) => row.sessionId), 'the scoped logout took the sibling session with it').toContain(sibling.session.sessionId);
447:
448:  // THE REVOKED SESSION CANNOT WRITE. `create-organization` is the write, because no verification
449:  // gate sits on it â€” so a refusal here is unambiguously the session layer's.
450:  const revokedWrite = await sut.createOrganization(session, 'Riverside Shelter After Logout');
451:  expect(revokedWrite.ok, 'a revoked session performed a write').toBe(false);
452:  expect(await sut.organizationsNamed('Riverside Shelter After Logout'), 'the revoked write happened anyway').toEqual([]);
453:
454:  // RE-AUTHENTICATION IS THE REMEDY, not a wall: a fresh sign-in works at once.
455:  const again = await sut.signInWithEmailPassword(email, PASSWORD);
456:  expect(again, 're-authentication after revocation was refused, so revocation ended the account rather than the session').toMatchObject(
457:    { ok: true },
458:  );
459:  if (!again.ok) return;
460:
461:  // THE EXPIRY ARM. Wait past the slot's standing token lifetime and assert the same write is
462:  // refused â€” with the margin on the far side, so a token that is merely close to expiry is not
463:  // mistaken for one that has passed it.
464:  await wait(SLOT_JWT_EXPIRY_MS + 15_000);
465:  const expiredWrite = await sut.createOrganization(again.session, 'Riverside Shelter After Expiry');
466:  expect(expiredWrite.ok, 'an expired access token performed a write').toBe(false);
467:  expect(await sut.organizationsNamed('Riverside Shelter After Expiry'), 'the expired write happened anyway').toEqual([]);
468:
469:  // And the refresh token re-establishes access with NO credentials â€” which is what makes expiry a
470:  // pause rather than a logout, and is the mechanism AT-001.13 builds its own claim on.
471:  const refreshed = await sut.refreshSession(again.session);
472:  expect(refreshed, 'the same session could not be refreshed after its access token expired').toMatchObject({ ok: true });
473:  if (!refreshed.ok) return;
474:  const afterRefresh = await sut.createOrganization(refreshed.session, 'Riverside Shelter After Refresh');
475:  expect(afterRefresh, 'a refreshed session still could not write').toMatchObject({ ok: true });
476:}
