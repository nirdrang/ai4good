 408: /**
 409:  * AT-001.12 â€” access ends when a session expires OR is revoked, and re-authentication is the remedy.
 410:  *
 411:  * TWO ARMS, BOTH AGAINST REAL TIME AND A REAL AUTH.
 412:  *
 413:  *   REVOCATION â€” a scoped logout ends THIS session while a SIBLING session of the same account keeps
 414:  *   working. The sibling is the control that separates "this session ended" from "the account's
 415:  *   access ended", and without it the criterion's remedy clause is untested.
 416:  *
 417:  *   EXPIRY â€” the body WAITS OUT a real access token. There is nothing to command: the slot's config
 418:  *   pins a standing low `jwt_expiry` precisely so this wait is two minutes rather than an hour, and
 419:  *   no test edits configuration or restarts anything. The loop body advances a controlled clock,
 420:  *   which is a different procedure proving the same clause.
 421:  */
 422: export async function at00112(ctx: Ctx): Promise<void> {
 423:   const { w, sut } = await ctx.open();
 424:   const email = w.email('sessions');
 425:   const session = await registerConfirmAndSignIn(sut, email);
 426: 
 427:   const completion = await sut.completeSignup(
 428:     session,
 429:     { accountType: 'ngo', organizationName: 'Riverside Shelter', acknowledgmentTextVersion: TEXT_VERSION },
 430:     CLIENT_IP,
 431:   );
 432:   expect(completion, 'the session under test could not complete signup, so nothing below is about a working session').toMatchObject({
 433:     ok: true,
 434:   });
 435: 
 436:   // A SIBLING SESSION, opened before the logout, standing as the control.
 437:   const sibling = await sut.signInWithEmailPassword(email, PASSWORD);
