number;\n403:     try {\n404:       fd = openSync(file, 'wx');\n405:     } catch (err) {\n406:       if ((err as 
NodeJS.ErrnoException).code === 'EEXIST') return null;\n407:       throw err;\n408:     }\n409:     try {\n410:       
