(err) {\n626:     bodyFailed = true;\n627:     bodyError = err;\n628:   }\n629: \n630:   const failures = await 
drainTeardowns(worlds, harnesses);\n631: \n632:   if (bodyFailed) {\n633:     for (const failure of failures) {\n634:  
     console.error(`${atId} — teardown ALSO failed (${failure.what}): ${errorText(failure.error)}`);\n635:     }\n636: 
    throw bodyError;\n637:   }\n638: \n639:   if (failures.length) {\n640:     const summary = failures.map((failure) 
=> `${failure.what}: ${errorText(failure.error)}`).join('; ');\n641:     throw new AggregateError(\n642:       
failures.map((failure) => (failure.error instanceof Error ? failure.error : new 
Error(errorText(failure.error)))),\n643:       `${atId} INVALID — the body passed but ${failures.length} 
teardown${failures.length === 1 ? '' : 's'} failed, ` +\n644:         `so state this test built leaks into the next 
id: ${summary}`,\n645:     );\n646:   }\n647: }\n648: \n649: interface OpenOptions {\n650:   atId: string;\n651:   
requirement: string;\n652:   sutKey: string;\n653:   sutMissing: string;\n654:   fixture: string;\n655:   
configOverrides?: ConfigOverrides;\n656: }\n657: \n658: /**\n659:  * Builds a harness and a world, at the types the 
