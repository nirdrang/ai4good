346:atTest(
347:  'AT-001.12',
348:  'an expired or revoked session ends access â€” the next request re-authenticates',
349:  // THE INTEGRATION BODY WAITS OUT A REAL ACCESS TOKEN, so it gets a bounded raise at that tier and
350:  // at no other; the loop body advances a controlled clock and keeps vitest's own 30 seconds.
351:  { surface: 'backend', timeoutMs: { integration: INTEGRATION_TIMEOUT_MS } },
352:  {
353:    default: async ({ open }) => {
354:      const { h, w, sut } = await open();
355:  
356:      // THE WRITE THIS BODY USES IS `createOrganization`, and the choice is load-bearing: no
357:      // verification gate sits on it, so every refusal below is unambiguously the session layer's
358:      // rather than the Discovery floor's. Each attempt uses a FRESH name, so `organizationsNamed`
359:      // can say whether that particular attempt wrote anything.
360:      const { email } = await registerAndConfirm(sut, w.email('session-expiry'), PASSWORD);
361:  
362:      // SIGN-IN PRECEDES COMPLETION â€” the live public order. The registration handle is not used for
363:      // anything, here or below: on the real stack with confirmations on it does not exist.
364:      const first = await sut.signInWithEmailPassword(email, PASSWORD);
365:      expect(first.ok, 'the confirmed account could not sign in').toBe(true);
366:      if (!first.ok) return;
367:  
368:      const completion = await sut.completeSignup(
369:        first.session,
370:        { accountType: 'ngo', organizationName: 'Riverside Shelter', acknowledgmentTextVersion: TEXT_VERSION },
371:        CLIENT_IP,
372:      );
373:      expect(completion, 'the NGO completion was refused').toMatchObject({ ok: true });
374:      if (!completion.ok) return;
375:  
376:      // (1) THE CONTROL. A live session writes. Without it every refusal below could be a write path
377:      // that never worked at all.
378:      const CONTROL_NAME = 'Riverside Shelter Control Programme';
379:      expect(
380:        (await sut.createOrganization(first.session, CONTROL_NAME)).ok,
381:        'a live session could not write â€” nothing below would be about the session layer',
382:      ).toBe(true);
383:  
384:      // (2) EXPIRY. The clock is the only thing that changes across this line: the same session, the
385:      // same account, the same shape of write.
386:      //
387:      // THE ADVANCE IS EXACTLY THE TTL, AND EXACTLY IS THE WHOLE POINT. One hour is
388:      // `jwt_expiry = 3600` in `supabase/config.toml`, which the fixture mirrors, and this lands the
389:      // clock ON the expiry instant rather than past it. The fixture's `sessionIsLive` compares with
390:      // a strict `<`, so at this instant the session is already dead and the write below is refused;
391:      // an inclusive `<=` would admit it and this body would fail. That boundary was a promise with
392:      // no oracle until this line pinned it. AT-001.13 keeps its just-under/just-past pair, which
393:      // discriminates the refresh rather than the boundary.
394:      await h.clock.advance(3600 * 1000);
395:  
396:      const EXPIRED_NAME = 'Riverside Shelter Expired Programme';
397:      const afterExpiry = await sut.createOrganization(first.session, EXPIRED_NAME);
398:      expect(afterExpiry.ok, 'an EXPIRED session was allowed to write').toBe(false);
399:      // A STALE-SESSION WRITE THAT HAPPENED ANYWAY IS NOT A BLOCK. The refusal hands back no
400:      // identifier, so the row that must not exist is looked for by the name that was attempted.
401:      expect(
402:        await sut.organizationsNamed(EXPIRED_NAME),
403:        'the refused write of an expired session created the organisation anyway',
404:      ).toEqual([]);
405:  
406:      // (3) RE-AUTHENTICATION IS THE REMEDY, proved by being the exact change that unblocks. The same
407:      // write, the same name, under a session obtained by signing in again.
408:      const second = await sut.signInWithEmailPassword(email, PASSWORD);
409:      expect(second.ok, 'the account could not sign in again after its session expired').toBe(true);
410:      if (!second.ok) return;
411:      expect(second.session.accountId, 're-authentication returned a different account').toBe(first.session.accountId);
412:  
413:      expect(
414:        (await sut.createOrganization(second.session, EXPIRED_NAME)).ok,
415:        're-authentication did not restore the ability to write',
416:      ).toBe(true);
417:      expect(
418:        (await sut.organizationsNamed(EXPIRED_NAME)).length,
419:        'the write after re-authentication did not create the organisation',
420:      ).toBe(1);
421:  
422:      // (4) REVOCATION, the criterion's other half, on a session that is live at the moment it is
423:      // revoked â€” so the clock plays no part in this half and the two causes stay distinguishable.
424:      await sut.signOut(second.session);
425:  
426:      const REVOKED_NAME = 'Riverside Shelter Revoked Programme';
427:      const afterRevocation = await sut.createOrganization(second.session, REVOKED_NAME);
428:      expect(afterRevocation.ok, 'a REVOKED session was allowed to write').toBe(false);
429:      expect(
430:        await sut.organizationsNamed(REVOKED_NAME),
431:        'the refused write of a revoked session created the organisation anyway',
432:      ).toEqual([]);
433:  
434:      // (5) AND RE-AUTHENTICATION IS THE REMEDY FOR REVOCATION TOO. Revoking one session must not end
435:      // the account's access â€” that difference is what makes "the next request re-authenticates" a
436:      // remedy rather than a wall.
437:      const third = await sut.signInWithEmailPassword(email, PASSWORD);
438:      expect(third.ok, 'the account could not sign in again after its session was revoked').toBe(true);
439:      if (!third.ok) return;
440:      expect(
441:        (await sut.createOrganization(third.session, REVOKED_NAME)).ok,
442:        'signing in again after revocation did not restore the ability to write',
443:      ).toBe(true);
444:      expect(
445:        (await sut.organizationsNamed(REVOKED_NAME)).length,
446:        'the write after re-authentication did not create the organisation',
447:      ).toBe(1);
448:    },
449:    integration: at00112,
450:  },
