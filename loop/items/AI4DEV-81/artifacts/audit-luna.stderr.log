databaseAnswers(dbUrl: string): Promise<string | null> {\n819:   const SQL = (globalThis as { Bun?: { SQL?: BunSqlCtor 
} }).Bun?.SQL;\n820:   if (!SQL) return 'this runtime has no SQL client (expected bun)';\n821:   let sql: BunSqlClient 
| null = null;\n822:   try {\n823:     sql = new SQL(dbUrl);\n824:     await sql`select 1`;\n825:     return 
null;\n826:   } catch (err) {\n827:     return diagnostic((err as Error).message);\n828:   } finally {\n829:     await 
