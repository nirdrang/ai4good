interface StackLockOptions {\n333:   takeover?: TakeoverPolicy;\n334: }\n335: \n336: /** Live = a holder this policy 
may not displace. */\n337: function holderIsLive(holder: Holder, policy: TakeoverPolicy = 'stale-or-dead'): boolean 
{\n338:   if (typeof holder.pid !== 'number' || !processIsAlive(holder.pid)) return false;\n339:   if (policy === 
'dead-pid-only') return true;\n340:   const startedAt = holder.startedAt ? Date.parse(holder.startedAt) : NaN;\n341:   
const ageMinutes = Number.isFinite(startedAt) ? (Date.now() - startedAt) / 60_000 : Infinity;\n342:   return 
ageMinutes < LOCK_STALE_MINUTES;\n343: }\n344: \n345: function heldByAnotherRun(holder: Holder, file: string): Error 
{\n346:   return new Error(\n347:     `another at:verify run holds this stack (pid ${holder.pid} on ${holder.host ?? 
'this machine'}, ` +\n348:       `requirement ${holder.requirement ?? 'unknown'}, started ${holder.startedAt ?? 
'unknown'}). ` +\n349:       `Two runs against one stack destroy each other: the second would reset the first's 
database ` +\n350:       `mid-run. Wait for it to finish. If that process is definitely gone, delete ${file}.`,\n351:  
 );\n352: }\n353: \n354: /**\n355:  * A gate left behind by a process that died mid-takeover. The section lasts 
milliseconds, so\n356:  * anything this old is certainly abandoned; removing one wrongly costs at most two processes 
in\n357:  * the section, which is the behaviour we had before the gate existed.\n358:  */\n359: function 
clearStrandedGate(gate: string): void {\n360:   try {\n361:     const held = JSON.parse(readFileSync(gate, 'utf8')) as 
{ pid?: number; at?: string };\n362:     const at = held.at ? Date.parse(held.at) : NaN;\n363:     const ageMinutes = 
Number.isFinite(at) ? (Date.now() - at) / 60_000 : Infinity;\n364:     const alive = typeof held.pid === 'number' && 
processIsAlive(held.pid);\n365:     if (!alive || ageMinutes > GATE_STALE_MINUTES) rmSync(gate, { force: true 
});\n366:   } catch {\n367:     // unreadable or already gone — the next pass finds out\n368:   }\n369: }\n370: \n371: 
/**\n372:  * Serialize every destructive run against one stack. The key is project id + api port because\n373:  * that 
pair IS the stack's identity: a second checkout carrying the same `project_id` shares the\n374:  * same Docker 
containers and the same ports, so its `at:verify` would reset this run's database\n375:  * out from under it. Mirrors 
`Acquire-WorkLock` in loop/work/work-lib.ps1 — exclusive create,\n376:  * holder recorded, stale takeover.\n377:  
*\n378:  * TAKEOVER IS THE WHOLE DIFFICULTY. Two processes can both read the same leftover lock and both\n379:  * 
conclude it is stale; if each then removed it and created its own, the second removal would take\n380:  * out the 
FIRST one's brand-new live lock and both would run — the precise failure this exists to\n381:  * prevent. Moving the 
stale file aside with an atomic rename does NOT fix that: the winner\n382:  * repopulates the path microseconds later, 
so the loser's rename succeeds against a LIVE lock,\n383:  * which is just as destructive as unlinking it. (Proved 
with a two-contender race, not reasoned\n384:  * about; the race is in runner.selftest.ts.)\n385:  *\n386:  * So the 
takeover DECISION is serialized by a second exclusive-create lock — the gate. Only one\n387:  * process is ever inside 
it, and it re-reads the holder INSIDE, so:\n388:  *   - no other process can be taking over concurrently (the gate is 
exclusive);\n389:  *   - no ordinary claim can have slipped in, because the stale file occupies the path 
continuously\n390:  *     until the gate holder removes it, and an exclusive create only succeeds on a free 
path;\n391:  *   - if a third process wins the claim in the instant after removal, the gate holder's own create\n392:  
*     simply fails and it restarts, having deleted nothing further.\n393:  * A gate stranded by a killed process is 
cleared on age. The section lasts milliseconds, so a live\n394:  * holder never reaches that threshold, and clearing 
one wrongly degrades to two takers in the\n395:  * section — today's behaviour, not worse.\n396:  */\n397: export 
function acquireStackLock(config: LocalConfig, requirement: string, options: StackLockOptions = {}): StackLock {\n398: 
  const file = stackLockPath(config);\n399:   const policy: TakeoverPolicy = options.takeover ?? 
'stale-or-dead';\n400: \n401:   const claim = (displaced?: Holder): StackLock | null => {\n402:     let fd: 
number;\n403:     try {\n404:       fd = openSync(file, 'wx');\n405:     } catch (err) {\n406:       if ((err as 
NodeJS.ErrnoException).code === 'EEXIST') return null;\n407:       throw err;\n408:     }\n409:     try {\n410:       
writeSync(\n411:         fd,\n412:         JSON.stringify({\n413:           pid: process.pid,\n414:           host: 
hostname(),\n415:           requirement,\n416:           startedAt: new Date().toISOString(),\n417:           // A 
takeover recorded ONLY on the console is lost the moment the terminal scrolls. The\n418:           // claim file 
outlives the run that wrote it, so whoever reads it later can see that this\n419:           // occupancy began by 
displacing an abandoned one, and whose.\n420:           ...(displaced\n421:             ? {\n422:                 
tookOverFrom: {\n423:                   pid: displaced.pid,\n424:                   startedAt: 
displaced.startedAt,\n425:                   requirement: displaced.requirement,\n426:                 },\n427:        
       }\n428:             : {}),\n429:         }),\n430:       );\n431:     } finally {\n432:       
closeSync(fd);\n433:     }\n434:     return {\n435:       file,\n436:       release: () => {\n437:         try {\n438: 
