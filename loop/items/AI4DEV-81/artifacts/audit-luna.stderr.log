`WorldLike`. It deliberately knows\n661:  * nothing about any suite — the narrowing to that suite's derived types 
happens once, at the end of\n662:  * `open()`, where the comment says exactly what is still taken on trust.\n663:  
*/\n664: async function openWorld(o: OpenOptions): Promise<{ opened: SeamOpenWorld; harness: AtHarness }> {\n665:   if 
(TIER === null) throw new AtPending(o.atId, 'tier-unset', tierError(o.requirement));\n666: \n667:   if 
(!harnessModule) {\n668:     throw new AtPending(\n669:       o.atId,\n670:       'harness-missing',\n671:       
`AI4DEV-3 capability modules (H2 fixtures/clock, H3 sentinels/faults, H4 oracles, ` +\n672:         `H5 vendor sims) 
are not in the tree: cannot resolve \"${HARNESS_MODULE}\" ` +\n673:         `from tests/at/harness 
(${harnessResolveError})`,\n674:     );\n675:   }\n676: \n677:   const h = await harnessModule.createHarness({\n678:   
