it required would turn a config that omits it into an\n230:    * infrastructure failure for every run. 
`localStackProblems` checks the reported catcher URL\n231:    * against it when both exist, and says so plainly when 
the status reports one and the config\n232:    * states none.\n233:    */\n234:   mailPort?: number;\n235: }\n236: 
\n237: /**\n238:  * Ports and project id come from `supabase/config.toml` — never guessed, never hard-coded.\n239:  
*\n240:  * The root is a parameter so the database-slot pool can read a SLOT's own config with this exact\n241:  * 
scanner instead of a second copy of it. Unset — every ordinary run — it reads the repo tree, so\n242:  * the loop and 
integration call sites behave as they did before the parameter existed.\n243:  */\n244: export function 
readLocalConfig(root: string = REPO_ROOT): LocalConfig {\n245:   const file = join(root, 'supabase', 
'config.toml');\n246:   const text = readFileSync(file, 'utf8');\n247:   let section = '';\n248:   let projectId = 
'';\n249:   let apiPort = 0;\n250:   let dbPort = 0;\n251:   let mailPort = 0;\n252: \n253:   for (const raw of 
text.split('\\n')) {\n254:     const line = raw.trim();\n255:     const header = /^\\[([^\\]]+)\\]/.exec(line);\n256:  
   if (header) {\n257:       section = header[1];\n258:       continue;\n259:     }\n260:     const port = 
/^port\\s*=\\s*(\\d+)/.exec(line);\n261:     if (section === '' && /^project_id\\s*=/.test(line)) projectId = 
/\"([^\"]+)\"/.exec(line)?.[1] ?? '';\n262:     else if (section === 'api' && port && !apiPort) apiPort = 
Number(port[1]);\n263:     else if (section === 'db' && port && !dbPort) dbPort = Number(port[1]);\n264:     // 
`[local_smtp]`'s FIRST port is the catcher's web API — the one `supabase status` reports as\n265:     // 
