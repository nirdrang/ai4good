missing ${missing.join(' and ')}`);\n272:   return { projectId, apiPort, dbPort, ...(mailPort ? { mailPort } : {}) 
};\n273: }\n274: \n275: /* ---------------------------------------------------------------------- the machine-wide 
lock */\n276: \n277: export interface StackLock {\n278:   file: string;\n279:   release(): void;\n280: }\n281: \n282: 
