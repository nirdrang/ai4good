string = string> = {\n134:   recipientId: string;\n135:   eventId: string;\n136:   channel: Channel;\n137:   outcome: 
ProviderOutcome;\n138: };\n139: \n140: export type EmailProviderSim<Channel extends string = string> = {\n141:   /** 
next N sends are rejected / never accepted (AT-016.11) */\n142:   rejectNext(count: number): void;\n143:   /** next N 
sends are ACCEPTED by the provider but the ack is lost (AT-016.11) */\n144:   acceptButLoseAck(count: number): 
void;\n145:   /** everything the provider actually accepted, in order */\n146:   accepted(): 
ProviderAttempt<Channel>[];\n147:   /**\n148:    * EVERY send that arrived at the provider seam, accepted or not, in 
order.\n149:    * This is the out-of-band trace: it is recorded by the simulator, not by the SUT, so it\n150:    * can 
contradict the SUT's own attempt counter (AT-016.11's retry proof, AT-016.01's\n151:    * \"no path around the 
emitter\").\n152:    */\n153:   attempts(): ProviderAttempt<Channel>[];\n154: };\n155: \n156: export type 
Vendors<Channel extends string = string> = {\n157:   email: EmailProviderSim<Channel>;\n158: };\n159: \n160: /* 
-------------------------------------------------------------- H4 semantic oracles */\n161: \n162: /**\n163:  * 
Judging the MEANING of generated text, where string-matching cannot decide.\n164:  *\n165:  * Three ratified 
acceptance criteria need this: AT-009.07 (rejection copy instructs and never\n166:  * accuses), AT-004.10 (Discovery 
output satisfies a fixture-specific semantic oracle), AT-033.07\n167:  * (the assistant's four framed answers, each 
with a pinned oracle). NONE of their suites exists\n168:  * yet, so what the ratified text pins today is not any 
finished rubric — it is the set of\n169:  * criterion KINDS the contract has to be able to express: semantic-absence, 
semantic-containment,\n170:  * count-minimum, numeric-tolerance, no-fabrication. That set is what the shapes below are 
derived\n171:  * from, and `harness/rubrics/` says plainly which of its examples are near-final and which are\n172:  * 
disposable skeletons.\n173:  *\n174:  * THE CRITERION IS A DISCRIMINATED UNION, and that is the load-bearing decision 
(Gate 1 finding\n175:  * F4). A rubric that only carried prose statements would push every threshold into the 
judge:\n176:  * \"is the runway within 10% of $4,200\" is a question about arithmetic, and asking a language 
model\n177:  * arithmetic questions makes the answer as unstable as the language. So the union splits the work.\n178:  
* A `semantic` criterion is a binary question only a reader can answer. An `extraction` criterion\n179:  * asks the 
judge for a NUMBER and nothing else, and the comparison against the expected value\n180:  * happens in 
`harness/oracles.ts`, in code, deterministically. The judge is never told the\n181:  * expected value or the tolerance 
— it cannot answer the question it is not asked.\n182:  *\n183:  * Expected values, tolerances and minimums for the 
real acceptance criteria are supplied by the\n184:  * suites that own those ids, when they are translated. What ships 
here is the SHAPE, with the\n185:  * boundary cases (a difference exactly equal to the tolerance, a count exactly one 
below the\n186:  * minimum) pinned in `oracles.selftest.ts`.\n187:  */\n188: \n189: /** A binary question about the 
material that only a reader can settle. */\n190: export type SemanticCriterion = {\n191:   kind: 'semantic';\n192:   
id: string;\n193:   /** phrased so that TRUE is the compliant answer — the judge answers whether it holds */\n194:   
statement: string;\n195:   /** a failing REQUIRED criterion fails the whole verdict; an optional one is reported and 
no more */\n196:   required: boolean;\n197: };\n198: \n199: /**\n200:  * What the judge is asked to pull out of the 
material. `unit` and `normalization` exist because\n201:  * \"the runway\" and \"the runway in months, rounded down\" 
are different questions, and the second\n202:  * one is the answerable one.\n203:  */\n204: export type ExtractionSpec 
= {\n205:   what: string;\n206:   unit?: string;\n207:   normalization?: string;\n208: };\n209: \n210: /** |extracted 
− expected| ≤ tolerance. Inclusive at the boundary, and conformance pins that. */\n211: export type 
NumericToleranceComparator = {\n212:   op: 'numeric_within_tolerance';\n213:   expected: number;\n214:   tolerance: 
number;\n215: };\n216: \n217: /** extracted ≥ minimum, over a count — so a fractional extraction is a typed error, not 
a round. */\n218: export type CountAtLeastComparator = {\n219:   op: 'count_at_least';\n220:   minimum: number;\n221: 
};\n222: \n223: export type CriterionComparator = NumericToleranceComparator | CountAtLeastComparator;\n224: \n225: 
/** The judge extracts; `oracles.ts` compares. The comparator never reaches the judge. */\n226: export type 
ExtractionCriterion = {\n227:   kind: 'extraction';\n228:   id: string;\n229:   statement: string;\n230:   required: 
boolean;\n231:   extract: ExtractionSpec;\n232:   compare: CriterionComparator;\n233: };\n234: \n235: export type 
RubricCriterion = SemanticCriterion | ExtractionCriterion;\n236: \n237: /**\n238:  * One oracle, decomposed into named 
criteria.\n239:  *\n240:  * `materialSlots` names every piece of text the rubric may see, and `judge()` refuses 
material\n241:  * that does not match the declaration exactly — a missing slot would silently make a criterion\n242:  
* unanswerable, and an undeclared one would let a caller feed the judge text no rubric mentions.\n243:  *\n244:  * 
`version` is a human-facing marker only. Recordings are invalidated by the request hash\n245:  * (`oracles.ts`), never 
by this string, because a hand-maintained version constant is exactly the\n246:  * mechanism a rubric edit forgets to 
bump (Gate 1 finding F6).\n247:  */\n248: export type Rubric = {\n249:   id: string;\n250:   version: string;\n251:   
materialSlots: string[];\n252:   criteria: RubricCriterion[];\n253: };\n254: \n255: /** How the k repeated votes split 
on one criterion. `pass + fail` always equals the vote count. */\n256: export type VoteTally = {\n257:   pass: 
number;\n258:   fail: number;\n259: };\n260: \n261: export type CriterionVerdict = {\n262:   criterionId: 
string;\n263:   pass: boolean;\n264:   /** a short verbatim quote, taken from the first vote that agreed with the 
majority */\n265:   evidence: string;\n266:   votes: VoteTally;\n267: };\n268: \n269: /**\n270:  * What a verdict is 
worth, attached to the verdict itself.\n271:  *\n272:  * `requestedModel` and `servedModels` are deliberately two 
fields: a fixed model id is a pinned\n273:  * snapshot, not a pinned behaviour, so the id we asked for and the id the 
provider says it served\n274:  * are two facts and drift between them has to be visible rather than assumed 
away.\n275:  */\n276: export type VerdictProvenance = {\n277:   /** 'replay' = committed recordings, no network; 
'live' = a real judge call this run */\n278:   source: 'live' | 'replay';\n279:   requestedModel: string;\n280:   /** 
`response.model` per vote, in vote order */\n281:   servedModels: string[];\n282:   /** the full-request hash per 
vote, in vote order — the replay key */\n283:   requestHashes: string[];\n284:   rubricId: string;\n285:   
rubricVersion: string;\n286:   effort: string;\n287:   votes: number;\n288: };\n289: \n290: export type 
SemanticVerdict = {\n291:   /** every REQUIRED criterion passed */\n292:   pass: boolean;\n293:   criteria: 
CriterionVerdict[];\n294:   provenance: VerdictProvenance;\n295: };\n296: \n297: /**\n298:  * The seam a suite 
reaches. One method, because everything else about the oracle — which model,\n299:  * how many votes, live or replayed 
— is the harness's to decide from the tier and the at-config\n300:  * registry, not a suite's to pass in.\n301:  
*/\n302: export type SemanticOracle = {\n303:   judge(rubric: Rubric, material: Record<string, string>): 
Promise<SemanticVerdict>;\n304: };\n305: \n306: /* 
----------------------------------------------------------------------- the harness */\n307: \n308: /**\n309:  * What 
`createHarness()` hands a suite. A suite names its own system-under-test map and world\n310:  * type; everything else 
is the same for all thirty of them.\n311:  *\n312:  * A TYPE ALIAS, NOT AN INTERFACE, and that is load-bearing. An 
interface is open to declaration\n313:  * merging, so a suite could write `declare module './contracts.ts' { interface 
AtHarness { auditLog?: string[] } }`\n314:  * and then read `h.auditLog` with a green type-check, against a harness 
that supplies no such thing.\n315:  * The member being OPTIONAL is what makes it slip through: `createHarness()` still 
satisfies its\n316:  * annotation, so nothing anywhere goes red. That is the same lie a free harness type parameter 
used\n317:  * to permit, arriving by a different door and needing no `any` and no suppression. A type alias\n318:  * 
cannot be merged into, so this door is shut, and `tests/at/typeprobes/` keeps the attack on file\n319:  * as an 
executable negative test.\n320:  *\n321:  * EVERY CAPABILITY CONTRACT IN THIS FILE IS AN ALIAS FOR THE SAME REASON. 
Closing only the type\n322:  * below left the identical attack open one level down, and worse there: `sentinels`, 
`faults`,\n323:  * `static` and `vendors` come from `pendingCapability<T>()`, which casts a Proxy `as T`, so a\n324:  
* merged-in member did not break `index.ts` even when it was REQUIRED — where the same member added\n325:  * to this 
type fails with TS2741. `ConfigRegistry` in `config.ts` is an alias for the same reason.\n326:  *\n327:  * So the rule 
is: contracts are type aliases, never interfaces. It covers everything reachable from\n328:  * the harness object AND 
the objects `open()` hands a test body — `OpenWorld`, `AtContext` and\n329:  * `WorldLike` in `registry.ts` obey it 
for the same reason these do. `WorldLike` was briefly\n330:  * excluded as belonging to AI4DEV-31's seam; that 
conflated two different defects. The suite's `W`\n331:  * being an unverified claim was AI4DEV-31's, and that item 
derived the seam types from the fixture\n332:  * adapter that produces them, leaving a suite no type argument to name 
either one with — though a\n333:  * widened context can still be REBUILT by hand out of the derived types, which is 
measured and\n334:  * documented on `SeamOpenWorld` in `registry.ts`. The interface being augmentable is this 
defect,\n335:  * not that one — and `w` is handed to the body exactly as `h` is.\n336:  *\n337:  * 
`tests/at/typeprobes/` carries an attack for every protected type, and\n338:  * `type-invention.selftest.ts` fails by 
name if any of them becomes an interface again.\n339:  */\n340: export type AtHarness<Sut = Record<string, unknown>, W 
extends WorldSeam = WorldSeam, Channel extends string = string> = {\n341:   tier: Tier;\n342:   /**\n343:    * 
Capability names this harness STUBBED for the running tier (e.g. 'vendors.email',\n344:    * 'sut.notifications'). 
MUST be empty above `loop` — otherwise an integration-tier run,\n345:    * which is the /pm-done gate, can silently 
stub the thing it is gating.\n346:    *\n347:    * Each name on this list was put there by `capabilities.ts` from one 
of THREE sources: a witness\n348:    * that read the value's own control seam, the module URL the fixture adapter was 
loaded from, or —\n349:    * for `oracles.judge` alone — the running tier and the judge transport's kind brand. No 
caller\n350:    * names a provenance.\n351:    *\n352:    * WHAT EMPTYING IT COSTS DIFFERS BY NAME, and one sentence 
for all five would overclaim. For\n353:    * `clock.controlled` and `vendors.email` the verdict is read off the very 
seam the suites drive,\n354:    * so removing either name means removing that seam — and the behaviour tests that 
command the\n355:    * clock forward and force a send to fail go red with it. For `fixtures.worlds`, every 
`sut.<key>`\n356:    * and `oracles.judge` there is no such seam: the verdict comes from the adapter-derived route 
or\n357:    * from the tier and transport brands, so emptying the list there is a source edit in\n358:    * 
`capabilities.ts` — visible in a diff and pinned by the conformance wall, but a word-edit all\n359:    * the 
same.\n360:    */\n361:   stubbedCapabilities(): Promise<string[]>;\n362:   clock: Clock;\n363:   fixtures: 
Fixtures<W>;\n364:   sentinels: Sentinels;\n365:   faults: Faults;\n366:   static: StaticScan;\n367:   config: 
ConfigRegistry;\n368:   vendors: Vendors<Channel>;\n369:   /**\n370:    * REQUIRED, like every other capability: a 
suite that reaches for it and finds nothing must fail\n371:    * to compile, not read `undefined`. At `loop` this is a 
REPLAY of committed recordings and the\n372:    * ledger reports it a stand-in; above `loop` it is the live judge and 
is reported real. That\n373:    * verdict is DERIVED — `capabilities.ts` computes it from the running tier and the 
transport's\n374:    * kind brand, and `oracles.ts` says why the split establishes this capability's provenance 
and\n375:    * nothing more.\n376:    */\n377:   oracles: SemanticOracle;\n378:   sut: Sut;\n379:   /** REQUIRED, not 
optional: frozen clocks, vendor counters and fault state leak without it */\n380:   teardown(): Promise<void>;\n381: 
};\n382: \n383: /**\n384:  * THE SAME HARNESS, SEEN AT ONE TIER — two members differ and the rest is identical.\n385:  
*\n386:  * `clock` and `vendors` are the two capabilities whose provenance is read off the very seam a suite\n387:  * 
drives (`AtHarness.stubbedCapabilities` says so above). At the loop tier both are stand-ins with\n388:  * control 
seams, which is what the loop bodies command. Above it the harness constructs the real\n389:  * article — the passage 
of time, and the slot's own mail catcher — and NEITHER has a control seam,\n390:  * because a capability that can be 
commanded is a substitute by definition.\n391:  *\n392:  * WHY IT IS A TYPE AND NOT A RUNTIME CHECK. A per-tier body 
written against the wrong tier's\n393:  * capabilities is an honest mistake that would otherwise surface as a run-time 
`TypeError` inside a\n394:  * test whose red is then undeclarable. Here it is a compile error at the body.\n395:  
*\n396:  * NOTHING ELSE FORKS. `sut`, `fixtures`, `sentinels`, `faults`, `static`, `config` and `oracles` are\n397:  * 
the same type at every tier: what changes at integration is what BACKS them, which is the ledger's\n398:  * business 
and not the body's.\n399:  */\n400: export type TierHarness<\n401:   T extends Tier,\n402:   Sut = Record<string, 
unknown>,\n403:   W extends WorldSeam = WorldSeam,\n404:   Channel extends string = string,\n405: > = T extends 
'loop'\n406:   ? AtHarness<Sut, W, Channel>\n407:   : Omit<AtHarness<Sut, W, Channel>, 'clock' | 'vendors'> & { clock: 
