'function');\n768:   if (named.length === 0 && typeof bodies.default !== 'function') {\n769:     return (\n770:       
`${atId} was registered with a per-tier body map that names no body at all — neither a tier nor a default. ` +\n771:   
    `One id, one body per tier.`\n772:     );\n773:   }\n774:   const uncovered = TIERS.filter((tier) => typeof 
bodies[tier] !== 'function');\n775:   if (uncovered.length && typeof bodies.default !== 'function') {\n776:     return 
(\n777:       `${atId} was registered with a per-tier body map that covers ${named.join(', ')} but not ` +\n778:       
`${uncovered.join(', ')}, and supplies no default. An id with no body at a tier reports as MISSING there, ` +\n779:    
   `which no declaration can describe — supply a body for every tier, or a default.`\n780:     );\n781:   }\n782:   
return null;\n783: }\n784: \n785: /**\n786:  * WHICH body a per-tier map supplies for a tier. PURE, so the choice is 
