that is the point: there is no `rejectNext`\n44:  * and no `acceptButLoseAck`, because nothing here can be told what 
to do. A capability that can be\n45:  * commanded to fail is a simulator, and `capabilities.ts` would stamp it a 
stand-in on exactly that\n46:  * evidence.\n47:  */\n48: export type LiveEmail = {\n49:   /** every message the 
catcher holds for this address, newest first */\n50:   messagesFor(address: string): Promise<LiveEmailMessage[]>;\n51: 
  /** the catcher's own identification, as measured at construction — for a transcript, never a rule */\n52:   
readonly describedAs: string;\n53: };\n54: \n55: export type LiveVendors = { email: LiveEmail };\n56: \n57: type 
MailpitMessageSummary = {\n58:   ID?: unknown;\n59:   Subject?: unknown;\n60:   To?: unknown;\n61: };\n62: \n63: 
function addressesOf(value: unknown): string[] {\n64:   if (!Array.isArray(value)) return [];\n65:   return value\n66: 
    .map((entry) => (entry && typeof entry === 'object' ? String((entry as { Address?: unknown }).Address ?? '') : 
''))\n67:     .filter((address) => address.length > 0);\n68: }\n69: \n70: type HttpAnswer = { status: number; text: 
string };\n71: \n72: async function readJson(url: string): Promise<HttpAnswer> {\n73:   const response = await 
fetch(url, { signal: AbortSignal.timeout(10_000) });\n74:   return { status: response.status, text: await 
response.text() };\n75: }\n76: \n77: /**\n78:  * Build the live mail-catcher capability, or refuse.\n79:  *\n80:  * 
The attestation is required and is not decoration: it is the same slot round trip every other live\n81:  * capability 
is granted on, so the ledger can never carry a `real` mail catcher for a stack this run\n82:  * did not prepare. It is 
VALIDATED here rather than merely typed (gate-2 ruling S1-2): a\n83:  * `LiveAttestation` is two strings, so an object 
literal used to mint a live email capability, and\n84:  * the brand — which only `attestSlot()` stamps — is what tells 
the two apart.\n85:  *\n86:  * `readAnswer` IS A SELFTEST SEAM and the harness passes it nowhere; `attestation.ts` 
states the\n87:  * doctrine at length on its own seam and the same words apply here. It supplies an ANSWER and 
never\n88:  * a verdict: whatever it returns goes through the SAME identification below as a real response, so\n89:  * 
an answer that is not a catcher's still refuses. Without it the refusals below would be rules\n90:  * nothing 
exercises, because this file's checks are about what an HTTP answer MEANS and the loop\n91:  * tier has no catcher to 
ask.\n92:  */\n93: export async function createLiveEmail(opts: {\n94:   catcherUrl: string;\n95:   attestation: 
LiveAttestation;\n96:   readAnswer?: (url: string) => Promise<HttpAnswer>;\n97: }): Promise<LiveVendors> {\n98:   
const base = opts.catcherUrl.replace(/\\/$/, '');\n99:   const read = opts.readAnswer ?? readJson;\n100:   const 
attested = attestationOf(opts.attestation, SLOT_ATTESTATION_BRAND);\n101:   if (!attested) {\n102:     throw new 
Error(\n103:       'refusing to build the live email capability: the attestation handed in carries no slot brand, so 
it is a ' +\n104:         'plain object with two strings on it rather than the record of a round trip that happened. A 
live mail ' +\n105:         'catcher is granted `real` on this evidence, so the evidence has to be the real 
article.',\n106:     );\n107:   }\n108:   if (!base) {\n109:     throw new Error(\n110:       \"refusing to build the 
