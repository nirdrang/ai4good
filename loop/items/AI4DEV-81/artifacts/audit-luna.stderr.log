   (async (url: string): Promise<string[]> => {\n      const SQL = sqlConstructor();\n      const sql = new 
SQL(url);\n      try {\n        const rows = (await sql`select nonce from at_runtime.slot_attestation`) as { nonce?: 
unknown }[];\n        return rows.map((row) => String(row?.nonce ?? ''));\n      } finally {\n        await 
sql.close().catch(() => undefined);\n      }\n    });\n\n  let rows: string[];\n  try {\n    rows = await 
