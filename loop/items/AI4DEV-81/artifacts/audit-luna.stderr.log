53:export class ControlledClock {
54:  private currentMs = Date.parse('2026-01-01T00:00:00.000Z');
55:
56:  async freezeAt(iso: string): Promise<void> {
57:    const next = Date.parse(iso);
58:    if (!Number.isFinite(next)) throw new Error(`controlled clock cannot freeze at invalid timestamp ${JSON.stringify(iso)}`);
59:    this.currentMs = next;
60:  }
61:
62:  async advance(ms: number): Promise<void> {
63:    if (!Number.isFinite(ms) || ms < 0) {
64:      throw new Error(`controlled clock advance must be a finite non-negative number, got ${ms}`);
65:    }
66:    this.currentMs += ms;
67:  }
68:
69:  now(): number {
70:    return this.currentMs;
71:  }
72:
73:  /*
74:   * There was an `observedByProduct()` here, and it is deliberately gone. It returned this
75:   * clock's own time, which is the clock answering a question about itself: it passes whether or
76:   * not a single line of product code reads the clock, so it proves exactly nothing about the
77:   * wiring it claimed to prove. Product-clock wiring is proven BEHAVIOURALLY â€” advance the clock,
78:   * then assert a product behaviour that depends on time actually changed (AT-016.08's anti-spam
79:   * window, and the conformance test that drives it through createHarness()).
80:   *
81:   * Sampling time from inside the product process IS a real capability, and a useful one; it needs
82:   * a product process to sample, so it belongs to an integration-tier slice, not to a self-report.
83:   */
84:}
385: *
386: * `clock` and `vendors` are the two capabilities whose provenance is read off the very seam a suite
387: * drives (`AtHarness.stubbedCapabilities` says so above). At the loop tier both are stand-ins with
388: * control seams, which is what the loop bodies command. Above it the harness constructs the real
389: * article â€” the passage of time, and the slot's own mail catcher â€” and NEITHER has a control seam,
390: * because a capability that can be commanded is a substitute by definition.
391: *
392: * WHY IT IS A TYPE AND NOT A RUNTIME CHECK. A per-tier body written against the wrong tier's
393: * capabilities is an honest mistake that would otherwise surface as a run-time `TypeError` inside a
