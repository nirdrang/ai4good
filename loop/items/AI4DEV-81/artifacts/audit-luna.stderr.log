.sort();\n895: }\n896: \n897: /** What the database says it actually replayed. */\n898: async function 
appliedMigrations(dbUrl: string): Promise<string[]> {\n899:   const SQL = (globalThis as { Bun?: { SQL?: BunSqlCtor } 
}).Bun?.SQL;\n900:   if (!SQL) throw new Error('this runtime has no SQL client (expected bun)');\n901:   let sql: 
BunSqlClient | null = null;\n902:   try {\n903:     sql = new SQL(dbUrl);\n904:     const rows = (await sql`select 
