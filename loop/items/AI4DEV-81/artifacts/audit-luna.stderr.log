'DOCKER_CONFIG',\n165:   'DOCKER_CERT_PATH',\n166: ];\n167: \n168: /** Windows environment names are case-insensitive, 
so match that way and keep the parent's casing. */\n169: export function childEnv(extra: Record<string, string> = {}): 
Record<string, string> {\n170:   const wanted = new Set(ENV_ALLOWLIST.map((name) => name.toLowerCase()));\n171:   
