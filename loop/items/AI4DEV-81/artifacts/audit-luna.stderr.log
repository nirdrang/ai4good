string;\n571:   error: unknown;\n572: }\n573: \n574: function errorText(error: unknown): string {\n575:   return error 
instanceof Error ? error.message : String(error);\n576: }\n577: \n578: /**\n579:  * Tear down everything the test 
built — worlds first, then harnesses, last-opened-first within\n580:  * each — ATTEMPTING EVERY ONE and collecting the 
rejections rather than stopping at the first.\n581:  *\n582:  * Attempting all of them is the point: giving up after 
one rejection leaves the rest of the stack\n583:  * standing, and a frozen clock, an armed fault or a vendor counter 
that survives into the next id\n584:  * is exactly the cross-test leak the per-test teardown exists to prevent.\n585:  
*/\n586: export async function drainTeardowns(worlds: TrackedTeardown[], harnesses: TrackedTeardown[]): 
