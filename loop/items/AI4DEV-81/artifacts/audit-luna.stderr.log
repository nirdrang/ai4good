471:class EvidenceCaptureImpl<C, Sut = unknown, W extends WorldLike = WorldLike, T extends Tier = 'loop'> {
472:  private result: Promise<C> | null = null;
473:  private producerAtId = '';
474:
475:  constructor(
476:    readonly name: string,
477:    /** the suite this capture reads the seam of â€” it is in the failure text so a red says whose */
478:    readonly requirement: string,
479:    private readonly producer: (ctx: SeamContext<Sut, W, T>) => Promise<C>,
480:  ) {}
481:
482:  consume(ctx: InternalContext<Sut, W, T>): Promise<C> {
483:    if (!this.result) {
484:      this.producerAtId = ctx.atId;
485:      const opensBefore = ctx[USAGE].opens;
486:      this.result = (async () => {
487:        try {
488:          const value = await this.producer(ctx);
489:          const problem = captureProducerProblem(opensBefore, ctx[USAGE].opens);
490:          if (problem) {
491:            throw new Error(`evidence capture ${JSON.stringify(this.name)} produced by ${ctx.atId} â€” ${problem}`);
492:          }
493:          return freezeEvidence(value);
494:        } catch (err) {
495:          throw captureFailure(this.name, this.requirement, this.producerAtId, err);
496:        }
497:      })();
498:    }
499:    return this.result;
500:  }
501:}
