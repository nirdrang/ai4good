1:import { attestationOf, stampAttestation, SLOT_ATTESTATION_BRAND, type LiveAttestation } from './capabilities.ts';
2:
3:/**
4: * THE PASSAGE OF TIME, WITH NO SEAM TO COMMAND IT â€” the integration tier's clock.
5: *
6: * It is a different CLASS rather than a `ControlledClock` with its two methods removed, and that is
7: * structural rather than tidy. `capabilities.ts`'s witness reads callability through the prototype
8: * chain, so a subclass that inherited `advance` would be stamped a stand-in however it was built;
9: * and the per-tier context types (`registry.ts`) expose this type to an integration body, so a body
10: * that reaches for `freezeAt` fails to COMPILE rather than failing at run time.
11: *
12: * WHAT MAKES IT `real` ON THE LEDGER is not the absence of the seam. "I found no stand-in seam" is
13: * the sentence `capabilities.ts` exists to forbid, and an object with `advance` deleted would
14: * satisfy it. What makes it real is the slot attestation stamped on it here: this clock is
15: * constructed only where a live round trip against the prepared slot has already succeeded, and the
16: * witness grants on that.
17: */
18:export class AttestedRealClock {
19:  now(): number {
20:    return Date.now();
21:  }
22:}
23:
24:/**
25: * Build the integration tier's clock and stamp it with the attestation that was already proved.
26: *
27: * A FUNCTION RATHER THAN A PUBLIC CONSTRUCTOR, so there is exactly one place a real clock can come
28: * into existence and it is a place that has an attestation in its hand.
29: *
30: * AND THE ATTESTATION IS VALIDATED, NOT MERELY TYPED (gate-2 ruling S1-2). `LiveAttestation` is a
31: * STRUCTURAL type â€” two strings â€” so `{ evidence: 'anything', constructedFor: 'slot' }` satisfied it
32: * and minted a real clock out of an object literal. The live sut and fixtures constructors already
33: * check the BRAND, which is stamped on the attestation object itself and cannot be written by hand;
34: * this one now asks the same question the same way. The threat model this tree names is the honest
35: * mistake nothing notices, and an unbranded attestation was one.
36: */
37:export function createAttestedRealClock(attestation: LiveAttestation): AttestedRealClock {
38:  const attested = attestationOf(attestation, SLOT_ATTESTATION_BRAND);
39:  if (!attested) {
40:    throw new Error(
41:      'refusing to construct an attested real clock: the attestation handed in carries no slot brand, so it is a ' +
42:        'plain object with two strings on it rather than the record of a round trip that happened. Only ' +
43:        '`attestSlot()` mints one, and it mints it after the coordinates it was handed answered with this run\'s ' +
44:        'runner-minted value.',
45:    );
46:  }
47:  return stampAttestation(new AttestedRealClock(), {
48:    evidence: `the harness's own real-clock constructor built it against the prepared slot â€” ${attested.evidence}`,
49:    constructedFor: 'clock.controlled',
50:  });
51:}
