503:/**
504: * An immutable capture, consumable by any test in the suite that defined it.
505: *
506: * A TYPE, never the class â€” and named by a requirement and a sut key, never by a shape. Both halves
507: * matter: the class would expose a constructor that takes a producer at any types, and shape
508: * parameters would let a body widen the context it is handed. See `SeamOpenWorld`.
509: */
510:export type EvidenceCapture<T, R extends SuiteId, K extends SutKeyOf<R>> = EvidenceCaptureImpl<T, SutOf<R, K>, WorldOf<R>>;
511:
512:/**
513: * `defineEvidenceCapture` was the SECOND door to the seam AI4DEV-31 closes, and closing `bindSuite`
514: * alone would have moved the defect rather than removed it: this function handed its producer a
515: * full `AtContext<Sut, W>` at whatever types the caller named, so a suite that never called
516: * `bindSuite` could still declare a system under test and a world out of nothing and read both green.
517: *
518: * So it takes the BINDING and derives, exactly as `atTest` does. There is no type argument left to
519: * lie with: `SutOf<R, K>` and `WorldOf<R>` come from the adapter registered under `R`.
520: *
521: * A `const` typed by a call-signature alias, NOT an exported `function` declaration â€” that is not
522: * stylistic. Gate 1 measured that an exported function declaration can be given a fresh generic
523: * overload through `declare module`, restoring the fabricated type argument, and that type aliases
524: * do not protect it. A `const` has no declaration to merge an overload into.
525: */
526:type DefineEvidenceCaptureFn = <T, R extends SuiteId, K extends SutKeyOf<R>>(
527:  binding: SuiteBinding<R, K>,
528:  name: string,
529:  producer: (ctx: AtContext<R, K>) => Promise<T>,
530:) => EvidenceCapture<T, R, K>;
531:
532:export const defineEvidenceCapture: DefineEvidenceCaptureFn = (binding, name, producer) =>
533:  new EvidenceCaptureImpl(name, binding.requirement, producer);
534:
535:export function testUseProblem(opens: number, captures: number): string | null {
536:  return opens === 0 && captures === 0 ? 'test body never opened a fixture world or consumed trusted captured evidence' : null;
537:}
538:
539:/**
540: * Runs one body and refuses a pass that observed nothing.
541: *
542: * Still parameterized by SHAPE rather than by `<R, K>`, and that is not an oversight. It is not a
543: * door to the seam: it never produces a harness-backed value, so the only context it can be given
544: * is one the caller built by hand â€” fabricating a type there is a caller lying to itself about its
545: * own object, with no harness claim anywhere in it. Keeping the structural signature is also what
546: * lets `conformance.selftest.ts` drive it with a hand-built context, which is the point of the
547: * false-green reproduction it appears in.
548: */
549:export async function executeRegisteredBody<Sut, W extends WorldLike>(
550:  atId: string,
551:  body: (ctx: SeamContext<Sut, W>) => Promise<void>,
552:  ctx: SeamContext<Sut, W>,
553:  usage: Usage,
554:): Promise<void> {
555:  await body(ctx);
556:  const problem = testUseProblem(usage.opens, usage.captures);
557:  if (problem) throw new Error(`${atId} INVALID â€” ${problem}`);
558:}
