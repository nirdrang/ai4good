===== integration 241-500 =====
 241:  *
 242:  * THE CONTROL IS NOT OPTIONAL: an operation that refuses everybody would satisfy the negative half
 243:  * on its own, so the NGO succeeds FIRST and the volunteer's refusal is then attributable to the
 244:  * account type.
 245:  *
 246:  * THE LINKED IDENTITY IS A GIVEN HERE, and it is written by the operator. Since the GitHub leaf a
 247:  * volunteer cannot complete signup without one; the refusal under test is the NGO-only one, so the
 248:  * volunteer has to reach the state of being a signed-up volunteer first. AT-001.04 owns the link
 249:  * rule and is declared red at this tier for exactly the reason that rule cannot be proved live.
 250:  */
 251: export async function at00106(ctx: Ctx): Promise<void> {
 252:   const { w, sut } = await ctx.open();
 253: 
 254:   const ngo = await registerConfirmAndSignIn(sut, w.email('ngo-actor'));
 255:   const ngoCompletion = await sut.completeSignup(
 256:     ngo,
 257:     { accountType: 'ngo', organizationName: 'Riverside Shelter', acknowledgmentTextVersion: TEXT_VERSION },
 258:     CLIENT_IP,
 259:   );
 260:   expect(ngoCompletion, 'the NGO control could not complete signup').toMatchObject({ ok: true });
 261:   if (!ngoCompletion.ok) return;
 262: 
 263:   const ngoAction = await sut.createOrganization(ngo, 'Riverside Shelter Second Programme');
 264:   expect(ngoAction, 'the NGO control was refused the NGO-only action, so the refusal below proves nothing').toMatchObject({
 265:     ok: true,
 266:   });
 267:   if (!ngoAction.ok) return;
 268:   expect(await sut.organization(ngoAction.organizationId)).toMatchObject({ name: 'Riverside Shelter Second Programme' });
 269:   expect(await sut.membership(ngoAction.organizationId, ngoCompletion.accountId)).toMatchObject({ role: 'admin' });
 270: 
 271:   const volunteer = await registerConfirmAndSignIn(sut, w.email('volunteer-actor'));
 272:   await sut.linkGithubIdentity(volunteer, 'volunteer-actor-handle');
 273:   const volunteerCompletion = await sut.completeSignup(
 274:     volunteer,
 275:     { accountType: 'volunteer', acknowledgmentTextVersion: TEXT_VERSION },
 276:     CLIENT_IP,
 277:   );
 278:   expect(volunteerCompletion, 'the volunteer could not complete signup, so the refusal below is not the one under test').toMatchObject(
 279:     { ok: true },
 280:   );
 281:   if (!volunteerCompletion.ok) return;
 282: 
 283:   const REFUSED_NAME = 'Riverside Shelter Copy';
 284:   const volunteerAction = await sut.createOrganization(volunteer, REFUSED_NAME);
 285:   expect(volunteerAction.ok, 'a volunteer account performed an NGO-only action').toBe(false);
 286:   if (volunteerAction.ok) return;
 287: 
 288:   // A REJECTION INCLUDES ITS WRITES NOT HAPPENING, and on the live stack that is row-level truth
 289:   // rather than a mirror: no organisation by the attempted name, and no membership anywhere.
 290:   expect(await sut.organizationsNamed(REFUSED_NAME), `the refused action created an organisation named ${REFUSED_NAME}`).toEqual([]);
 291:   expect(await sut.membershipsOf(volunteerCompletion.accountId), 'the refused action left the volunteer holding a membership').toEqual(
 292:     [],
 293:   );
 294:   expect(volunteerAction.reason).toMatch(/NGO accounts only/i);
 295:   expect(volunteerAction.reason).toMatch(/volunteer/i);
 296: }
