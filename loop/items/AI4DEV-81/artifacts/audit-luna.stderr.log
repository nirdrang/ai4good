`holderIsLive({})` is false\n471:    * under every policy — so without this guard a claim file that is empty or half 
written looks\n472:    * exactly like a dead holder and is deleted. The window is real and small: it is the 
microseconds\n473:    * between `openSync(file, 'wx')` and the `writeSync` that fills the file, so a second 
occupier\n474:    * arriving in that instant would remove a LIVE process's brand-new claim. That is the one 
thing\n475:    * this policy exists to make impossible.\n476:    *\n477:    * One bounded re-read skates over the 
write window. A holder that STILL has no parseable pid is\n478:    * not a dead holder — it is a file nobody in this 
process can account for — so it refuses loudly\n479:    * and names the manual repair. `stale-or-dead` keeps its 
long-standing behaviour: that path\n480:    * predates the slot pool and is another item's business.\n481:    *\n482:  
  * Returns the identified holder, or null when the file went away and the loop should retry.\n483:    */\n484:   
const identified = (holder: Holder, where: string): Holder | null => {\n485:     if (typeof holder.pid === 'number') 
return holder;\n486:     if (policy !== 'dead-pid-only') return holder;\n487: \n488:     pause(50);\n489:     const 
again = readHolder();\n490:     if (again === null) return null; // released while we looked; the loop takes the free 
path\n491:     if (typeof again.pid === 'number') return again;\n492: \n493:     throw new Error(\n494:       
`refusing to take over the claim at ${file}: it names no process id that this run can read, ` +\n495:         `so it 
cannot be shown to be dead — and a claim file being written right now looks exactly ` +\n496:         `like this. 
Nothing was taken over. If no run holds that stack, delete ${file} by hand ` +\n497:         `(checked 
${where}).`,\n498:     );\n499:   };\n500: \n501:   // Bounded: every retry follows another process winning the gate, 
which cannot repeat forever.\n502:   for (let attempt = 0; attempt < 20; attempt++) {\n503:     const claimed = 
claim();\n504:     if (claimed) return claimed;\n505: \n506:     const read = readHolder();\n507:     if (read === 
