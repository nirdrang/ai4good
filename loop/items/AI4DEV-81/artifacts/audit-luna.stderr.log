 247:   it('refuses an unrecognised brand on either evidence axis, instead of accepting it by absence', () => {
 248:     // ACCEPT BY ENUMERATION, NOT BY ABSENCE. The witness used to read "not loop" as above-loop and
 249:     // "not replay-fs" as a transport worth a real verdict, so a brand nobody had ever heard of came
 250:     // back `real` with confident-sounding evidence â€” on the only witness whose `real` verdict is
 251:     // derived from evidence rather than declared for a name, which is what makes it the one place
 252:     // that reasoning can go wrong. `CapabilityEvidence` carries plain strings, deliberately, because
 253:     // the evidence comes from a caller; a type union could not have caught this and is not what does.
 254:     const judge = { judge: async () => undefined };
 255: 
 256:     const badTier = () => witnessedCapability('oracles.judge', judge, { tier: 'staging', transport: 'live' });
 257:     expect(badTier, 'an unrecognised TIER brand was accepted as above-loop and given a real verdict').toThrow(
 258:       /TIER axis was given "staging"/,
 259:     );
 260:     expect(badTier, 'the refusal does not say which tiers ARE legal, so the caller cannot correct it').toThrow(
 261:       /loop, integration, drill/,
 262:     );
 263: 
 264:     const badTransport = () => witnessedCapability('oracles.judge', judge, { tier: 'integration', transport: 'bogus' });
 265:     expect(badTransport, 'an unrecognised TRANSPORT brand was accepted and given a real verdict').toThrow(
 266:       /TRANSPORT axis was given "bogus"/,
 267:     );
 268:     expect(badTransport, 'the refusal does not say which transports ARE legal').toThrow(/replay-fs, live, fake/);
 269: 
 270:     // AND THE ENUMERATION DISCRIMINATES rather than refusing everything. SIX of the nine brand pairs
 271:     // are accepted; the three refused are loop+live, integration+replay-fs and drill+replay-fs. The
 272:     // four pinned below cover every rule that produces an acceptance, including a `fake` transport
 273:     // above loop, which is the instrument the tier rules are themselves tested with. The two
 274:     // unpinned pairs â€” integration+fake and drill+live â€” reach `real` through the same final branch
 275:     // as drill+fake, so pinning them would add assertions and no coverage.
 276:     expect(witnessedCapability('oracles.judge', judge, { tier: 'loop', transport: 'replay-fs' }).provenance).toBe(
 277:       'stand-in',
 278:     );
 279:     expect(witnessedCapability('oracles.judge', judge, { tier: 'loop', transport: 'fake' }).provenance).toBe('stand-in');
 280:     expect(witnessedCapability('oracles.judge', judge, { tier: 'integration', transport: 'live' }).provenance).toBe(
 281:       'real',
 282:     );
 283:     expect(witnessedCapability('oracles.judge', judge, { tier: 'drill', transport: 'fake' }).provenance).toBe('real');
 284:   });
