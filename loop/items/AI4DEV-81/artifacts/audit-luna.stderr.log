------------------------------------------------------------------------ the AT id grammar */\n28: \n29: /**\n30:  * 
`AT-<requirement>.<number>` — the FINAL dot-segment is the test number and everything\n31:  * between `AT-` and it is 
the requirement id, because requirement ids may themselves carry a\n32:  * dot suffix (`005.5` is a real requirement, 
so `AT-005.5.03` is a real id).\n33:  */\n34: const AT_ID = /^AT-(\\d{3}(?:\\.\\d+)*)\\.(\\d+[a-z]?)$/;\n35: \n36: 
export interface ParsedAtId {\n37:   atId: string;\n38:   /** e.g. '016', '005.5' */\n39:   requirement: string;\n40:  
 /** e.g. '01', '05a' */\n41:   number: string;\n42: }\n43: \n44: export function parseAtId(atId: string): ParsedAtId 
{\n45:   const m = AT_ID.exec(atId);\n46:   if (!m) {\n47:     throw new Error(\n48:       `malformed AT id 
${JSON.stringify(atId)} — expected AT-<requirement>.<number>, ` +\n49:         `e.g. AT-016.01 or AT-005.5.03 (the 
last dot-segment is the test number)`,\n50:     );\n51:   }\n52:   return { atId, requirement: m[1], number: m[2] 
};\n53: }\n54: \n55: /* ---------------------------------------------------------------------------- registrations 
*/\n56: \n57: /** Surface is an axis independent of tier: one authored body, driven through different drivers. */\n58: 
export type Surface = 'backend' | 'ui' | 'skill';\n59: \n60: /**\n61:  * What a suite may vary PER TEST.\n62:  *\n63:  
