156:/**
157: * Judge a completion request in full â€” the request, and the one FACT about the caller the volunteer
158: * branch turns on.
159: *
160: * THE VOLUNTEER BRANCH IS GATED ON A LINKED GITHUB IDENTITY. AT-001.04: "completion is blocked with
161: * the GitHub-link requirement stated; linking completes signup". The gate reads `caller.githubHandle`
162: * â€” a fact Supabase Auth reports about the authenticated user â€” and never a request field, so no
163: * client can assert its way past it. An NGO completion never reads the fact at all: AT-001.04's own
164: * scope is volunteer signup, and a gate that leaked onto NGOs would refuse a signup no criterion
165: * says anything about.
166: *
167: * IT FAILS CLOSED, AND THAT IS STATED BECAUSE THE EDGE ENTRY POINT HAS NO TYPE-CHECKER. Measured, not
168: * assumed: `bun run typecheck` covers the root project (`src/**`) and the `tests/at` program, and
169: * neither reaches an edge-function entry point (`supabase/functions/<name>/index.ts`). So a call
170: * site that forgets the second argument is
171: * a real possibility, and the reading below â€” `caller?.githubHandle`, absent or blank meaning "no
172: * linked identity" â€” makes that mistake BLOCK every volunteer completion loudly instead of waiving
173: * the gate silently. A gate that disappears when a caller is careless is not a gate.
174: *
175: * WHY THE JUDGED VALUE TRAVELS BACK OUT in `ValidCompleteSignup.githubHandle`: so the write path uses
176: * the handle this decision was made on rather than deriving its own, which is the same reason the
177: * organisation name comes back trimmed instead of being re-trimmed downstream.
178: */
179:export function validateCompleteSignup(
180:  request: CompleteSignupRequest,
181:  caller: CompleteSignupCaller,
182:): Decision<ValidCompleteSignup> {
183:  const parsedType = parseAccountType(request.accountType);
184:  if (!parsedType.ok) return refuse(parsedType.reason);
185:  const accountType = parsedType.value;
186:
187:  const rawName = request.organizationName;
188:  let organizationName: string | null = null;
189:
190:  if (accountType === 'ngo') {
191:    if (typeof rawName !== 'string' || rawName.trim() === '') {
192:      return refuse('an NGO signup must carry a non-empty organisation name');
193:    }
194:    organizationName = rawName.trim();
195:  } else if (rawName !== undefined && rawName !== null) {
196:    // Refused rather than ignored. A volunteer has no organisation, so a name arriving on a
197:    // volunteer request means the caller and the server disagree about what is being created, and
198:    // silently dropping it would let that disagreement reach the database as a missing row instead
199:    // of surfacing as a refusal.
200:    return refuse('a volunteer signup carries no organisation name â€” one account holds exactly one global type');
201:  }
202:
203:  // THE CALLER FACT, read defensively â€” see the fail-closed paragraph above. A missing argument, a
204:  // null, or a blank string all mean the same thing here: no GitHub identity is linked.
205:  const linkedGithubHandle =
206:    typeof caller?.githubHandle === 'string' && caller.githubHandle.trim() !== '' ? caller.githubHandle.trim() : null;
207:
208:  if (accountType === 'volunteer' && linkedGithubHandle === null) {
209:    return refuse(
210:      'a volunteer signup cannot be completed without a linked GitHub account â€” link GitHub to this account, then complete signup',
211:    );
212:  }
213:
214:  const rawVersion = request.acknowledgmentTextVersion;
215:  if (typeof rawVersion !== 'string' || rawVersion.trim() === '') {
216:    return refuse(
217:      'the ToS + Platform Promise acknowledgment text version is required â€” an acknowledgment that does not say which text was accepted records nothing',
218:    );
219:  }
220:
221:  return accept({
222:    accountType,
223:    organizationName,
224:    acknowledgmentTextVersion: rawVersion.trim(),
225:    // NULL FOR AN NGO EVEN WHEN ONE IS LINKED. An NGO's account may well carry a GitHub identity â€”
226:    // nothing forbids it â€” but the GitHub link and the onboarding import it fires are volunteer
227:    // signup's, so an NGO completion carries no handle onward and writes no volunteer profile.
228:    githubHandle: accountType === 'volunteer' ? linkedGithubHandle : null,
229:  });
230:}
