  98:   /**
  99:    * The sixth reproduction, added by AI4DEV-31: the id says one suite, the binding says another.
 100:    *
 101:    * Two independent strings have to denote the same suite â€” the AT id decides which fixture adapter
 102:    * is loaded at RUN time, the binding decides which adapter the TYPES were read off. Left
 103:    * unchecked, `AT-017.03` in a suite bound to req-016 drives req-017's implementation while every
 104:    * type in the body describes req-016's, and both halves look correct on their own.
 105:    *
 106:    * The formats differ and the comparison MUST normalize: `parseAtId` yields `016` while the
 107:    * binding and the registry key are `req-016`. A literal comparison would reject every valid suite
 108:    * in the tree, so the happy path is asserted here too rather than left implied.
 109:    */
 110:   it('refuses an AT id whose requirement is not the suite it was bound to', () => {
 111:     expect(requirementMismatch('AT-016.01', '016', 'req-016'), 'a valid suite was rejected by the guard').toBeNull();
 112:     expect(requirementMismatch('AT-005.5.03', '005.5', 'req-005.5'), 'a dotted requirement id was rejected').toBeNull();
 113: 
 114:     const mismatch = requirementMismatch('AT-017.03', '017', 'req-016');
 115:     expect(mismatch, 'the guard did not name the requirement the harness would actually load').toContain('req-017');
 116:     expect(mismatch, 'the guard did not name the requirement the type-check described').toContain('req-016');
 117: 
 118:     const missing = requirementMismatch('AT-016.01', '016', '');
 119:     expect(missing, 'an absent requirement was treated as "nothing to check" rather than as an error').toContain(
 120:       'no requirement',
 121:     );
 122: 
 123:     // AND THE GUARD IS ACTUALLY WIRED IN. A problem computed and not acted on is this tree's own
 124:     // recurring false-green shape, so the pure function above is not enough on its own. Both calls
 125:     // throw before `it()` is ever reached, which is why registering here adds no test to this run.
 126:     expect(() =>
 127:       atTest('AT-017.03', 'bound to the wrong suite', { requirement: 'req-016', sut: 'notifications' }, async () => undefined),
 128:     ).toThrow(/req-017/);
 129: 
 130:     // The suites the runner's black-box tests generate are written as source at run time and are
 131:     // never type-checked, so this guard has to hold for a caller TypeScript never saw. The cast
 132:     // reproduces exactly that caller and nothing else.
 133:     const untyped = atTest as unknown as (atId: string, title: string, opts: object, body: () => Promise<void>) => void;
 134:     expect(() => untyped('AT-016.01', 'no requirement at all', { sut: 'notifications' }, async () => undefined)).toThrow(
 135:       /no requirement/,
 136:     );
 137:   });
