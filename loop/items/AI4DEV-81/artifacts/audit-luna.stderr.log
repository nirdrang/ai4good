process.pid) rmSync(file, { force: true });\n440:         } catch {\n441:           // already removed, or unreadable 
— nothing of ours left to release\n442:         }\n443:       },\n444:     };\n445:   };\n446: \n447:   const gate = 
`${file}.takeover`;\n448: \n449:   /** The recorded holder, or null if the lock is gone. */\n450:   const readHolder = 
(): Holder | null => {\n451:     try {\n452:       return JSON.parse(readFileSync(file, 'utf8')) as Holder;\n453:     
} catch (err) {\n454:       if ((err as NodeJS.ErrnoException).code === 'ENOENT') return null;\n455:       return {}; 
// unreadable or half-written: treat as an unidentifiable holder, judged below\n456:     }\n457:   };\n458: \n459:   
