applied.filter((version) => !expected.includes(version));\n924:   const problems: string[] = [];\n925:   if 
(missing.length) problems.push(`never applied: ${missing.join(', ')}`);\n926:   if (extra.length) 
problems.push(`applied but not in supabase/migrations: ${extra.join(', ')}`);\n927:   return problems;\n928: }\n929: 
