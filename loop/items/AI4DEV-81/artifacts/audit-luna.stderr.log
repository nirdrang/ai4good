`--no-env-file`,\n127:  * so a child does not re-read the env files for itself.\n128:  */\n129: const ENV_ALLOWLIST = 
[\n130:   // process/platform basics\n131:   'PATH',\n132:   'PATHEXT',\n133:   'COMSPEC',\n134:   'SystemRoot',\n135: 
  'SystemDrive',\n136:   'windir',\n137:   'OS',\n138:   'NUMBER_OF_PROCESSORS',\n139:   
'PROCESSOR_ARCHITECTURE',\n140:   'PROCESSOR_IDENTIFIER',\n141:   'USERNAME',\n142:   'LANG',\n143:   'LC_ALL',\n144:  
 'TZ',\n145:   // temp + home, which bun, vitest and the Supabase CLI all need in order to write caches\n146:   
'TEMP',\n147:   'TMP',\n148:   'TMPDIR',\n149:   'HOME',\n150:   'HOMEDRIVE',\n151:   'HOMEPATH',\n152:   
'USERPROFILE',\n153:   'APPDATA',\n154:   'LOCALAPPDATA',\n155:   'PROGRAMDATA',\n156:   'PROGRAMFILES',\n157:   
