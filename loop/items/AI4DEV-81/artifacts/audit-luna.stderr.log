export type WorldSeam = {\n36:   teardown(): Promise<void>;\n37: };\n38: \n39: /** A suite parameterizes this with its 
own world type; the seam is the same for all of them. */\n40: export type Fixtures<W extends WorldSeam = WorldSeam> = 
{\n41:   world(name: string): Promise<W>;\n42: };\n43: \n44: /**\n45:  * Time, under the test's control — funding's 
