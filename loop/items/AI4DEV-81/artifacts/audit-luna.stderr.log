 153: /**
 154:  * PROVENANCE IS A VERDICT THE HARNESS COMPUTES, NOT A WORD A CALLER WRITES (AI4DEV-48).
 155:  *
 156:  * The measured hole: calling the real-labelling factory for `clock.controlled` and four names like
 157:  * it turned the stand-in ledger empty, and `registry.ts` â€” which refuses any stubbed capability
 158:  * above the loop tier â€” then had nothing to refuse. That API is gone, so these tests are about the
 159:  * mechanism that replaced it, and the second one is the one that matters most: a witness that
 160:  * cannot classify a value must REFUSE it, because "I found no stand-in seam" is not evidence of
 161:  * real backing. That was the shape of the first draft's own defect.
 162:  */
 163: describe('provenance is computed from the value or the loader, and refuses what it cannot classify', () => {
 164:   it('refuses a capability name no witness has decided about, naming the name', () => {
 165:     // A name off the closed table: nobody has decided about it, so it is an error here rather than
 166:     // a default in either direction.
 167:     expect(() => witnessedCapability('vendors.sms', { email: {} })).toThrow(/vendors\.sms/);
 168:     expect(() => witnessedCapability('vendors.sms', {})).toThrow(/no witness is registered/);
 169: 
 170:     // AND THE SUT FAMILY IS GENUINELY OFF THE TABLE, rather than swallowed by a `sut.*` prefix. A
 171:     // prefix rule would mean nobody ever decided about any SUT name â€” an unlimited namespace inside
 172:     // a table whose whole claim is that it is closed.
 173:     expect(() => witnessedCapability('sut.notifications', {})).toThrow(/sut\.notifications/);
 174:   });
 175: 
 176:   it('refuses a KNOWN capability name whose value is malformed, instead of classifying it real', () => {
 177:     // THE SINGLE MOST IMPORTANT ASSERTION IN THIS FILE. Each value below is a known name whose
 178:     // control seam is absent or half present. A witness returning "real" because it found nothing
 179:     // to say is the deleted real-labelling factory reached through a different door.
 180:     expect(() => witnessedCapability('clock.controlled', {}), 'a clock with no seam at all was classified').toThrow(
 181:       /no callable Clock control seam/,
 182:     );
 183:     expect(
 184:       () => witnessedCapability('clock.controlled', { freezeAt: async () => undefined }),
 185:       'a clock that can be frozen but not advanced was classified â€” half a control seam is not a verdict',
 186:     ).toThrow(/clock\.controlled/);
 187:     expect(() => witnessedCapability('vendors.email', {}), 'a vendor wrapper with no sim behind it was classified').toThrow(
 188:       /no callable EmailProviderSim control seam/,
 189:     );
 190:     expect(
 191:       () => witnessedCapability('vendors.email', { email: { attempts: () => [] } }),
 192:       'a vendor sim that cannot be told to reject was classified â€” half a control seam is not a verdict',
 193:     ).toThrow(/vendors\.email/);
 194: 
 195:     // THE ORACLE IS DERIVED FROM CALLER EVIDENCE, so its refusal is that the evidence is missing.
 196:     expect(
 197:       () => witnessedCapability('oracles.judge', { judge: async () => undefined }),
 198:       'an oracle built with neither tier nor transport was given a provenance anyway',
 199:     ).toThrow(/no tier/);
 200: 
 201:     // AND THE REFUSALS DISCRIMINATE. A witness that refused everything would satisfy every
 202:     // assertion above and leave the harness unable to build â€” and the callability test has to walk
 203:     // the PROTOTYPE CHAIN, because `advance` is a method on `ControlledClock.prototype` and an
 204:     // own-property test would refuse the real clock on its first run.
 205:     const clock = witnessedCapability('clock.controlled', new ControlledClock());
 206:     expect(clock.provenance, 'the real controlled clock was refused â€” the witness is reading own properties').toBe(
 207:       'stand-in',
 208:     );
 209:     expect(clock.standInReason, 'the stand-in verdict does not name the seam that produced it').toContain('freezeAt');
 210:   });
