 298: /**
 299:  * AT-001.07 â€” a provisioned platform administrator authenticates and carries the type; the public
 300:  * signup surface offers only the two.
 301:  *
 302:  * THE SECOND CLAUSE IS PROVED DIFFERENTLY HERE, and that difference is the reason this body exists.
 303:  * At loop tier it reads `publicSignupAccountTypes()`, which is a constant a shipped module exports â€”
 304:  * a list is a claim. At this tier the live oracle is a REFUSAL, which is a fact: the DEPLOYED
 305:  * completion path is asked for a `platform_admin` and must refuse it and leave no row behind. That
 306:  * is a strictly stronger oracle, and it is why the constant is not among the methods the live
 307:  * adapter backs.
 308:  */
 309: export async function at00107(ctx: Ctx): Promise<void> {
 310:   const { w, sut } = await ctx.open();
 311: 
 312:   const adminEmail = w.email('platform-admin');
 313:   const provisioned = await sut.provisionPlatformAdmin(adminEmail, PASSWORD);
 314: 
 315:   const signedIn = await sut.signInWithEmailPassword(adminEmail, PASSWORD);
 316:   expect(signedIn, 'the provisioned platform admin could not sign in').toMatchObject({ ok: true });
 317:   if (!signedIn.ok) return;
 318:   expect(signedIn.session.accountId).toBe(provisioned.accountId);
 319:   expect(
 320:     await sut.account(signedIn.session.accountId),
 321:     'the signed-in administrator does not carry the platform_admin global type',
 322:   ).toMatchObject({ accountType: 'platform_admin' });
 323: 
 324:   const visitor = await registerConfirmAndSignIn(sut, w.email('would-be-admin'));
 325:   const escalation = await sut.completeSignup(
 326:     visitor,
 327:     { accountType: 'platform_admin', acknowledgmentTextVersion: TEXT_VERSION },
 328:     CLIENT_IP,
 329:   );
 330:   expect(escalation.ok, 'the DEPLOYED public signup path minted a platform administrator').toBe(false);
 331:   if (escalation.ok) return;
 332:   expect(escalation.reason).toMatch(/platform_admin/);
 333:   expect(await sut.account(visitor.accountId), 'the refused escalation left an account row behind').toBeNull();
 334: }
 335: 
 336: /**
 337:  * AT-001.09 â€” email verification, PARAMETERIZED OVER BOTH email-capable account types.
 338:  *
 339:  * Gate 1's finding 8 is what makes this body cover two types rather than one: the criterion says
 340:  * "EITHER account type â€¦ (NGO and volunteer)" and carries the acceptance file's own
 341:  * "parameterized over account types" note, and the migrated NGO-only set proved half of it.
 342:  *
 343:  * AND EACH ITERATION REALLY IS ITS TYPE (gate-2 ruling S2-4). The first version of this body labelled
 344:  * the two iterations `ngo` and `volunteer` and differed only in the email address it used â€” neither
 345:  * one ever created an account of either type, so the parameterization was nominal and a
 346:  * type-specific verification regression would have gone unnoticed by both halves. Each iteration now
 347:  * COMPLETES SIGNUP as its type after verification â€” the NGO with an organisation, the volunteer with
 348:  * a linked GitHub identity, both with the acknowledgment â€” and asserts the account row carries that
 349:  * global type.
 350:  *
 351:  * WHAT IS LIVE HERE: the message is the one GoTrue really sent, held by the slot's own mail catcher;
 352:  * the link is followed by HTTP; and the verified fact is judged by the SHIPPED extractor over the
 353:  * real row rather than read as a boolean.
 354:  */
 355: export async function at00109(ctx: Ctx): Promise<void> {
 356:   const { w, sut } = await ctx.open();
 357: 
 358:   for (const kind of ['ngo', 'volunteer'] as const) {
 359:     const email = w.email(`${kind}-verify`);
 360:     const registered = await sut.registerWithEmailPassword(email, PASSWORD);
 361:     expect(registered.sessionId, 'the live registration issued a session, which under confirmations it must not').toBe('');
 362: 
 363:     // UNVERIFIED FIRST, and it must DISCRIMINATE: an extractor that answered true unconditionally
 364:     // would satisfy every assertion after the link is used.
 365:     expect(
 366:       await sut.emailVerified(registered.accountId),
 367:       `a fresh ${kind} registration is already reported verified â€” nothing below would then mean anything`,
 368:     ).toBe(false);
 369: 
 370:     // Auth itself refuses sign-in before confirmation, which is the state the criterion describes.
 371:     const early = await sut.signInWithEmailPassword(email, PASSWORD);
 372:     expect(early.ok, `an unconfirmed ${kind} account signed in`).toBe(false);
 373: 
 374:     const link = await sut.emailedVerificationLink(email);
 375:     expect(link, `no confirmation email reached the slot's mail catcher for the ${kind} address`).not.toBeNull();
 376: 
 377:     const used = await sut.useVerificationLink(link!);
 378:     expect(used.ok, `following the emailed ${kind} confirmation link was refused`).toBe(true);
 379:     expect(
 380:       await sut.emailVerified(registered.accountId),
 381:       `using the emailed link did not flip the ${kind} account to verified`,
 382:     ).toBe(true);
 383: 
 384:     const after = await sut.signInWithEmailPassword(email, PASSWORD);
 385:     expect(after, `a confirmed ${kind} account could not sign in`).toMatchObject({ ok: true });
 386:     if (!after.ok) return;
 387: 
 388:     // THE COMPLETION AS THIS TYPE, which is what makes the two iterations two different runs of the
 389:     // criterion rather than the same run under two labels. The volunteer's linked GitHub identity is
 390:     // a GIVEN written by the operator â€” AT-001.04 owns the link rule and is red at this tier â€” and
 391:     // without it the deployed path refuses a volunteer completion, correctly.
 392:     const request =
 393:       kind === 'ngo'
 394:         ? { accountType: 'ngo' as const, organizationName: `Riverside Shelter ${kind}-verify`, acknowledgmentTextVersion: TEXT_VERSION }
 395:         : { accountType: 'volunteer' as const, acknowledgmentTextVersion: TEXT_VERSION };
 396:     if (kind === 'volunteer') await sut.linkGithubIdentity(after.session, `verify-${registered.accountId.slice(0, 8)}`);
 397: 
 398:     const completion = await sut.completeSignup(after.session, request, CLIENT_IP);
 399:     expect(completion, `the verified ${kind} could not complete signup as a ${kind}`).toMatchObject({ ok: true });
 400:     if (!completion.ok) return;
 401:     expect(
 402:       await sut.account(completion.accountId),
 403:       `the completed ${kind} account does not carry the ${kind} global type`,
 404:     ).toEqual({ id: registered.accountId, accountType: kind });
 405:   }
 406: }
