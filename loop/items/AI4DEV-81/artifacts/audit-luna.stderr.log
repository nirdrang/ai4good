gatewayAnswers(status);\n863:       if (gateway === null) return;\n864:       lastProblem = gateway;\n865:     } else 
{\n866:       lastProblem = `the database did not answer: ${db}`;\n867:     }\n868:     await new Promise((resolve) => 
setTimeout(resolve, delay));\n869:     delay = Math.min(delay * 2, 2000);\n870:   }\n871: \n872:   throw new 
Error(`the stack was still not ready ${phase} after ${Math.round(READY_TIMEOUT_MS / 1000)}s — last problem: 
${lastProblem}`);\n873: }\n874: \n875: /* --------------------------------------------------------------------- the 
migration-set proof */\n876: \n877: /** Counted, not just proved — the pool's evidence line has to state the migration 
