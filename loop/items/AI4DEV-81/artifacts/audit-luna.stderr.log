StaticScan = {\n121:   /** components whose SOURCE imports a comms-provider client or reads a provider credential 
*/\n122:   providerClientImporters(): Promise<string[]>;\n123: };\n124: \n125: /* 
------------------------------------------------------------------- H5 vendor sims */\n126: \n127: export type 
ProviderOutcome = 'accepted' | 'rejected' | 'ack_lost';\n128: \n129: /**\n130:  * Channels are named by the 
requirement that owns them (REQ-016's are 'email' and 'inapp'), so\n131:  * the vendor types are generic over the 
