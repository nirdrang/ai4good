431:export function captureProducerProblem(opensBefore: number, opensAfter: number): string | null {
432:  return opensAfter === opensBefore ? 'capture producer completed without open()' : null;
433:}
434:
435:/**
436: * The implementation class, DELIBERATELY NOT EXPORTED â€” only the type alias below is.
437: *
438: * An exported class is a value with a public constructor, so `new EvidenceCapture<T, Anything,
439: * AnythingElse>(name, producer)` was a way to hand a producer a fabricated `AtContext` without ever
440: * touching `bindSuite`: the same lie as the one AI4DEV-31 closes at `open()`, reached through a
441: * `new`. Exporting only the type removes the constructor from a suite's reach, and has the second
442: * effect of making `EvidenceCapture` a type ALIAS, which declaration merging cannot open.
443: */
444:/**
445: * WHAT A FAILING SHARED PRODUCER THROWS â€” and the two refusals it must NOT dress up.
446: *
447: * PURE AND EXPORTED, so the rule has an oracle: it is a rule about what a red LOOKS like, and a
448: * rule about a shape that nothing compares is a rule nobody knows works.
449: *
450: * The wrapper exists so an ordinary failure inside a shared producer says WHICH capture failed and
451: * whose, instead of surfacing on five consumer ids as an unattributed error. That is right for an
452: * ordinary failure and wrong for a REFUSAL. `CapabilityPending` and `AtPending` are the two red
453: * shapes a declaration can describe, and `expected.ts` rebuilds their first line and compares it
454: * exactly. Wrapping one turns `CapabilityPending: CAPABILITY PENDING â€” â€¦` into
455: * `Error: evidence capture "â€¦" failed â€” CAPABILITY PENDING â€” â€¦`, which no declaration can express.
456: * Measured on REQ-016's first integration run: five ids were red in a shape nobody could declare,
457: * which is the exact defect the declarable refusal exists to remove.
458: *
459: * Nothing is hidden by passing them through: both carry their own names, and the id that reports
460: * one is the id that leaned on it.
461: */
462:export function captureFailure(name: string, requirement: string, producerAtId: string, err: unknown): unknown {
463:  if (err instanceof CapabilityPending || err instanceof AtPending) return err;
464:  const detail = err instanceof Error ? err.message : String(err);
465:  return new Error(
466:    `evidence capture ${JSON.stringify(name)} (${requirement}) produced by ${producerAtId} failed â€” ${detail}`,
467:    { cause: err },
468:  );
469:}
