 224:   it('two contenders racing for ONE stale lock end with exactly one owner', async () => {
 225:     const config = testConfig();
 226:     // Stale by age as well as by liveness, so neither contender can decide otherwise.
 227:     plantLock(config, {
 228:       pid: 999_999,
 229:       host: 'gone',
 230:       requirement: 'req-000',
 231:       startedAt: new Date(Date.now() - 48 * 60 * 60 * 1000).toISOString(),
 232:     });
 233: 
 234:     const runnerUrl = new URL('./runner.ts', import.meta.url).href;
 235:     const startAt = Date.now() + 600;
 236:     const contender = (): Promise<string> => {
 237:       const code =
 238:         `const { acquireStackLock } = await import(${JSON.stringify(runnerUrl)});\n` +
 239:         `const config = ${JSON.stringify(JSON.stringify(config))};\n` +
 240:         `while (Date.now() < ${startAt}) {}\n` + // a barrier, so both attempt at the same instant
 241:         `try {\n` +
 242:         `  const lock = acquireStackLock(JSON.parse(config), 'req-016');\n` +
 243:         `  console.log('ACQUIRED');\n` +
 244:         `  await Bun.sleep(500);\n` + // hold it, so the loser meets a LIVE holder
 245:         `  lock.release();\n` +
 246:         `} catch { console.log('REFUSED'); }\n`;
 247:       // spawn, NOT spawnSync: a synchronous spawn would run the two contenders one after the
 248:       // other, and the second would find the lock already released â€” a race that never raced.
 249:       return new Promise<string>((resolve) => {
 250:         const child = spawn(bunExecutable(), ['--no-env-file', '-e', code], { stdio: ['ignore', 'pipe', 'pipe'] });
 251:         let out = '';
 252:         child.stdout.on('data', (chunk: Buffer) => (out += chunk.toString('utf8')));
 253:         child.stderr.on('data', (chunk: Buffer) => (out += chunk.toString('utf8')));
 254:         child.once('error', (err) => resolve(`ERROR ${err.message}`));
 255:         child.once('close', () => resolve(out));
 256:       });
 257:     };
 258: 
 259:     // Started together; the in-child barrier is what makes them collide, not the spawn timing.
 260:     const [a, b] = await Promise.all([contender(), contender()]);
 261:     const outcomes = [a, b].map((out) => (out.includes('ACQUIRED') ? 'ACQUIRED' : out.includes('REFUSED') ? 'REFUSED' : `UNKNOWN(${out.trim()})`));
 262: 
 263:     try {
 264:       expect(outcomes.filter((o) => o === 'ACQUIRED'), `outcomes were ${JSON.stringify(outcomes)}`).toHaveLength(1);
 265:       expect(outcomes.filter((o) => o === 'REFUSED'), `outcomes were ${JSON.stringify(outcomes)}`).toHaveLength(1);
 266:       expect(existsSync(stackLockPath(config)), 'the winner did not release its lock').toBe(false);
 267:     } finally {
 268:       scrub(config);
 269:     }
 270:   }, 60_000);
 271: });
