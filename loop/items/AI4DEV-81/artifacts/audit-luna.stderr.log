integration?: AtTestBody<R, K, 'integration'>;\n757:   drill?: AtTestBody<R, K, 'drill'>;\n758: };\n759: \n760: 
/**\n761:  * The tier's body, or the problem that means there is none. PURE, so the refusal is unit testable.\n762:  
*\n763:  * A bare function is the single-body form and covers every tier — every suite in this tree is\n764:  * 
written that way and none of them changes.\n765:  */\n766: export function tierBodyProblem(bodies: Record<string, 
