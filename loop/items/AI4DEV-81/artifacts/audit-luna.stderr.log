= (ms: number) => {\n461:     const until = Date.now() + ms;\n462:     while (Date.now() < until) {\n463:       /* 
spin */\n464:     }\n465:   };\n466: \n467:   /**\n468:    * UNDER `dead-pid-only`, AN UNIDENTIFIABLE HOLDER IS NEVER 
