 732: 
 733:       // THE ID ALLOCATION IS A SIDE EFFECT LIKE ANY OTHER, and it is the one the rollback used to
 734:       // miss. Allocated before the fault point, the crashed emit spent `event-1` on an event that
 735:       // was never written, the next firing came back `event-2` with no `event-1` anywhere, and the
 736:       // rollback's own comment called itself one unit while a third thing survived the crash.
 737:       //
 738:       // This case exists because NOTHING ELSE IN THE TREE READS ID CONTIGUITY: move the allocation
 739:       // back above the try/catch and every suite stays green, so a repair nobody can notice being
 740:       // undone is on the same footing as the defect it repaired.
 741:       const { eventId } = await world.fire('payment.succeeded');
 742:       expect(
 743:         eventId,
 744:         'the crashed emit consumed an event id â€” the rollback left the counter advanced, so the ids no longer match the events that exist',
 745:       ).toBe('event-1');
 746:       expect(
 747:         (await sut.events({ type: 'payment.succeeded' })).map((event) => event.id),
 748:         'the one event that survived does not carry the id its own fire() reported',
 749:       ).toEqual(['event-1']);
 750:     } finally {
 751:       await h.teardown();
 752:     }
 753:   });
