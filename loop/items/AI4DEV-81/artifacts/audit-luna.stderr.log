 786:   it('lets the process that first sent a delivery keep it, so a send before a restart is told apart from one after', async () => {
 787:     const h = await createHarness({ requirement: 'req-016', tier: 'loop' });
 788:     try {
 789:       const world = (await h.fixtures.world('epoch-stamp')) as World;
 790:       const sut = h.sut.notifications as NotificationsSut;
 791: 
 792:       const before = await h.faults.processEpoch();
 793:       await world.fire('payment.succeeded');
 794:       await sut.drainDeliveries();
 795: 
 796:       await h.faults.processRestart();
 797:       const after = await h.faults.processEpoch();
 798:       await world.fire('payment.failed');
 799:       await sut.drainDeliveries();
 800: 
 801:       // WHAT `_contract.ts` PROMISES ABOUT `deliveredByProcess`: a send that happened after a
 802:       // restart carries a different string than one that happened before it. That is only true if
 803:       // the FIRST send owns the stamp â€” a drain that re-stamps every row it sweeps records the
 804:       // identity of the last drain instead, and the earlier send is retroactively attributed to a
 805:       // process that did not perform it. Nothing else in the tree can tell those two apart:
 806:       // AT-016.07 drains once, after its restart, so it reads the same value either way.
 807:       const sentBefore = (await sut.deliveries({ type: 'payment.succeeded' })).map((d) => d.deliveredByProcess);
 808:       const sentAfter = (await sut.deliveries({ type: 'payment.failed' })).map((d) => d.deliveredByProcess);
 809:       expect(sentBefore.length, 'the pre-restart send produced no delivery to attribute').toBeGreaterThan(0);
 810:       expect(sentAfter.length, 'the post-restart send produced no delivery to attribute').toBeGreaterThan(0);
 811:       expect(
 812:         [...new Set(sentBefore)],
 813:         'a delivery sent BEFORE the restart was re-stamped by the later drain â€” the field reports the last drain, not the process that sent it',
 814:       ).toEqual([before]);
 815:       expect(
 816:         [...new Set(sentAfter)],
 817:         'the post-restart send does not carry the identity the process had when it performed it',
 818:       ).toEqual([after]);
 819:     } finally {
 820:       await h.teardown();
 821:     }
 822:   });
