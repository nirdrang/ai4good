   'AT-016.04',\n        { kind: 'capability-pending', capabilities: ['fixtures.worlds', 'sut.notifications'] },\n     
   `${thrown.name}: ${thrown.message}`,\n      ),\n    ).toBe(true);\n  });\n\n  it('still names the capture, the 
suite and the producer for an ordinary failure', () => {\n    // The wrapper's own purpose is unchanged: a real 
