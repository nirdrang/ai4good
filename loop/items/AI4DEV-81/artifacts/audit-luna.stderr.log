.replace(/(postgres(?:ql)?:\\/\\/)[^@\\s/]+@/gi, '$1<redacted>@')\n206:     .replace(/[A-Za-z0-9_-]{40,}/g, 
'<redacted-token>');\n207: }\n208: \n209: /** First non-empty line, redacted and length-capped — enough to diagnose, 
not enough to leak. */\n210: export function diagnostic(text: string | undefined, limit = 400): string {\n211:   const 
line =\n212:     redact(text ?? '')\n213:       .split('\\n')\n214:       .map((l) => l.trim())\n215:       .find((l) 
=> l.length > 0) ?? '';\n216:   return line.length > limit ? `${line.slice(0, limit)}…` : line;\n217: }\n218: \n219: 
/* ------------------------------------------------------------------------ config.toml reading */\n220: \n221: export 
interface LocalConfig {\n222:   projectId: string;\n223:   apiPort: number;\n224:   dbPort: number;\n225:   /**\n226:  
