 112: /**
 113:  * Register, confirm through the emailed link, and sign in â€” the live public order, as one step.
 114:  *
 115:  * IT ASSERTS AS IT GOES, because a helper that swallowed a failure would report the wrong cause for
 116:  * the right red: "no session" three assertions later, rather than "no confirmation email arrived".
 117:  */
 118: async function registerConfirmAndSignIn(
 119:   sut: Awaited<ReturnType<Ctx['open']>>['sut'],
 120:   email: string,
 121:   password = PASSWORD,
 122: ): Promise<Session> {
 123:   const registered = await sut.registerWithEmailPassword(email, password);
 124:   expect(registered.sessionId, 'the live registration issued a session, which under confirmations it must not').toBe('');
 125: 
 126:   const link = await sut.emailedVerificationLink(email);
 127:   expect(link, `no confirmation email reached the slot's mail catcher for ${email}`).not.toBeNull();
 128:   const used = await sut.useVerificationLink(link!);
 129:   expect(used.ok, 'following the emailed confirmation link was refused').toBe(true);
 130: 
 131:   const signedIn = await sut.signInWithEmailPassword(email, password);
 132:   expect(signedIn, `sign-in after confirmation failed for ${email}`).toMatchObject({ ok: true });
 133:   if (!signedIn.ok) throw new Error('unreachable: the assertion above fails first');
 134:   expect(signedIn.session.accountId, 'sign-in resolved to a different account than the registration created').toBe(
 135:     registered.accountId,
 136:   );
 137:   return signedIn.session;
 138: }
