 478: /**
 479:  * AT-001.13 â€” the session refreshes AUTOMATICALLY, with no forced re-login mid-work.
 480:  *
 481:  * GATE 1'S FINDING 7 IS WHY THIS BODY LOOKS DIFFERENT FROM EVERY OTHER ONE HERE. The criterion's
 482:  * word is "automatically", and every existing piece of evidence proves the MECHANISM: the loop body
 483:  * calls `refreshSession` explicitly, and the live proof transcript says in its own words that it
 484:  * establishes nothing about scheduling. A mechanism-only green at the tier whose meaning is "proved
 485:  * for real" would be a new overclaim.
 486:  *
 487:  * SO THE THING UNDER TEST IS A REAL CLIENT â€” supabase-js with `autoRefreshToken: true` â€” and the
 488:  * observable is a rotation NOBODY ASKED FOR: the access token the client holds changes while the
 489:  * body only waits, and access continues afterwards. No `refreshSession` call appears below.
 490:  *
 491:  * WHY THE COORDINATES COME FROM THE ENVIRONMENT rather than through the system under test: the thing
 492:  * under test is a CLIENT LIBRARY, not a product surface, and this repository ships no client. The
 493:  * runner validated those coordinates, attested them, and put them in this child's environment; a
 494:  * system-under-test method wrapping the client would be this suite building the very thing it is
 495:  * supposed to be observing.
 496:  */
 497: export async function at00113(ctx: Ctx): Promise<void> {
 498:   const { w, sut } = await ctx.open();
 499:   const email = w.email('auto-refresh');
 500:   const session = await registerConfirmAndSignIn(sut, email);
 501: 
 502:   // SIGNUP IS COMPLETED FIRST, so there is an account row for the rotated session to resolve TO.
 503:   // Without it the same-account assertion below could only ever compare two nulls, which is how the
 504:   // vacuous version of it came to be written (gate-2 ruling S2-5).
 505:   const completion = await sut.completeSignup(
 506:     session,
 507:     { accountType: 'ngo', organizationName: 'Riverside Shelter Auto Refresh', acknowledgmentTextVersion: TEXT_VERSION },
 508:     CLIENT_IP,
 509:   );
 510:   expect(completion, 'the account under test could not complete signup, so it holds no account row').toMatchObject({ ok: true });
 511: 
 512:   const url = process.env.AT_SUPABASE_URL ?? '';
 513:   const anonKey = process.env.AT_SUPABASE_ANON_KEY ?? '';
 514:   expect(url && anonKey, 'this child holds no slot coordinates, so no real client can be built').toBeTruthy();
 515: 
 516:   const client = await realClient(url, anonKey);
 517:   try {
 518:     const signedIn = await client.auth.signInWithPassword({ email, password: PASSWORD });
 519:     expect(signedIn.error, 'the real client could not sign in against the slot').toBeNull();
 520:     const first = signedIn.data.session?.access_token ?? '';
 521:     expect(first, 'the real client signed in with no access token').not.toBe('');
 522: 
 523:     // WHOSE SESSION THIS IS, captured AT SIGN-IN and from the client's own answer â€” so the assertion
 524:     // after the rotation compares the rotated identity with a value that was read before any
 525:     // rotation happened, rather than with itself.
 526:     const signedInAs = (await client.auth.getUser()).data.user?.id ?? '';
 527:     expect(signedInAs, 'the real client signed in and named no user').not.toBe('');
 528:     expect(signedInAs, 'the real client signed in as a different account than the harness registered').toBe(
 529:       session.accountId,
 530:     );
 531: 
 532:     // WAIT, AND ONLY WAIT. The client's own scheduler is the thing under test, so the body issues no
 533:     // refresh of any kind. The budget is the token's whole lifetime plus a margin: the client
 534:     // rotates about one tick in, well before expiry, and a body that waited less than the lifetime
 535:     // could pass by luck.
 536:     const deadline = Date.now() + SLOT_JWT_EXPIRY_MS + 30_000;
 537:     let rotated = '';
 538:     while (Date.now() < deadline && !rotated) {
 539:       await wait(5_000);
 540:       const current = (await client.auth.getSession()).data.session?.access_token ?? '';
 541:       if (current && current !== first) rotated = current;
 542:     }
 543:     expect(rotated, 'the client never rotated its access token on its own â€” automatic refresh is unproved').not.toBe('');
 544: 
 545:     // "WITHOUT FORCED RE-LOGIN MID-WORK": the work continues, with no credentials supplied anywhere.
 546:     const me = await fetch(`${url.replace(/\/$/, '')}/auth/v1/user`, {
 547:       headers: { apikey: anonKey, Authorization: `Bearer ${rotated}` },
 548:     });
 549:     expect(me.status, 'the automatically rotated token does not carry access').toBe(200);
 550: 
 551:     // AND IT IS THE SAME USER'S WORK THAT CONTINUED, which is the clause the previous version of
 552:     // this assertion did not reach: `account === null || account.id.length > 0` is satisfied by
 553:     // every possible value, so it passed whoever the rotated token belonged to. Two independent
 554:     // reads now say the same name â€” the client's own `getUser()` over the rotated token, and the
 555:     // account row read out of the database with operator authority.
 556:     const rotatedUser = (await client.auth.getUser()).data.user?.id ?? '';
 557:     expect(rotatedUser, 'the automatically rotated token names a different user than the one that signed in').toBe(
 558:       signedInAs,
 559:     );
 560:     const account = await sut.account(rotatedUser);
 561:     expect(account, 'the rotated session resolved to no readable account row').not.toBeNull();
 562:     expect(account?.id, 'the account row the rotated session resolves to is somebody else\'s').toBe(signedInAs);
 563:   } finally {
 564:     await client.auth.stopAutoRefresh().catch(() => undefined);
 565:   }
 566: }
