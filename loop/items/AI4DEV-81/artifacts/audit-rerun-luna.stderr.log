  99: async function realClient(url: string, anonKey: string): Promise<RealClient> {
 100:   const specifier = '@supabase/supabase-js';
 101:   const module = (await import(/* @vite-ignore */ specifier)) as {
 102:     createClient?: (url: string, key: string, opts: unknown) => RealClient;
 103:   };
 104:   if (typeof module.createClient !== 'function') {
 105:     throw new Error(`${specifier} exports no createClient() â€” AT-001.13's whole claim is about a real client`);
 106:   }
 107:   return module.createClient(url, anonKey, {
 108:     auth: { autoRefreshToken: true, persistSession: false, detectSessionInUrl: false },
 109:   });
 110: }
