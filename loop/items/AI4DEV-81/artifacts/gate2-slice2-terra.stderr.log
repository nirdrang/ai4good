 432: export async function at00113(ctx: Ctx): Promise<void> {
 433:   const { w, sut } = await ctx.open();
 434:   const email = w.email('auto-refresh');
 435:   await registerConfirmAndSignIn(sut, email);
 436: 
 437:   const url = process.env.AT_SUPABASE_URL ?? '';
 438:   const anonKey = process.env.AT_SUPABASE_ANON_KEY ?? '';
 439:   expect(url && anonKey, 'this child holds no slot coordinates, so no real client can be built').toBeTruthy();
 440: 
 441:   const client = await realClient(url, anonKey);
 442:   try {
 443:     const signedIn = await client.auth.signInWithPassword({ email, password: PASSWORD });
 444:     expect(signedIn.error, 'the real client could not sign in against the slot').toBeNull();
 445:     const first = signedIn.data.session?.access_token ?? '';
 446:     expect(first, 'the real client signed in with no access token').not.toBe('');
 447: 
 448:     // WAIT, AND ONLY WAIT. The client's own scheduler is the thing under test, so the body issues no
 449:     // refresh of any kind. The budget is the token's whole lifetime plus a margin: the client
 450:     // rotates about one tick in, well before expiry, and a body that waited less than the lifetime
 451:     // could pass by luck.
 452:     const deadline = Date.now() + SLOT_JWT_EXPIRY_MS + 30_000;
 453:     let rotated = '';
 454:     while (Date.now() < deadline && !rotated) {
 455:       await wait(5_000);
 456:       const current = (await client.auth.getSession()).data.session?.access_token ?? '';
 457:       if (current && current !== first) rotated = current;
 458:     }
 459:     expect(rotated, 'the client never rotated its access token on its own â€” automatic refresh is unproved').not.toBe('');
 460: 
 461:     // "WITHOUT FORCED RE-LOGIN MID-WORK": the work continues, with no credentials supplied anywhere.
 462:     const me = await fetch(`${url.replace(/\/$/, '')}/auth/v1/user`, {
 463:       headers: { apikey: anonKey, Authorization: `Bearer ${rotated}` },
 464:     });
 465:     expect(me.status, 'the automatically rotated token does not carry access').toBe(200);
 466: 
 467:     // AND THE ACCOUNT IS THE SAME ONE, so the rotation extended this user's work rather than
 468:     // silently starting somebody else's.
 469:     const account = await sut.account((await client.auth.getUser()).data.user?.id ?? '');
 470:     expect(account === null || account.id.length > 0, 'the rotated session resolved to no readable account').toBe(true);
 471:   } finally {
 472:     await client.auth.stopAutoRefresh().catch(() => undefined);
 473:   }
 474: }

