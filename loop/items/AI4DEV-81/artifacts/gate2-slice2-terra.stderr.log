 346: atTest(
 347:   'AT-001.12',
 348:   'an expired or revoked session ends access â€” the next request re-authenticates',
 349:   { surface: 'backend' },
 350:   {
 351:     default: async ({ open }) => {
 352:       const { h, w, sut } = await open();
 353:   
 354:       // THE WRITE THIS BODY USES IS `createOrganization`, and the choice is load-bearing: no
 355:       // verification gate sits on it, so every refusal below is unambiguously the session layer's
 356:       // rather than the Discovery floor's. Each attempt uses a FRESH name, so `organizationsNamed`
 357:       // can say whether that particular attempt wrote anything.
 358:       const { email } = await registerAndConfirm(sut, w.email('session-expiry'), PASSWORD);
 359:   
 360:       // SIGN-IN PRECEDES COMPLETION â€” the live public order. The registration handle is not used for
 361:       // anything, here or below: on the real stack with confirmations on it does not exist.
 362:       const first = await sut.signInWithEmailPassword(email, PASSWORD);
 363:       expect(first.ok, 'the confirmed account could not sign in').toBe(true);
 364:       if (!first.ok) return;
 365:   
 366:       const completion = await sut.completeSignup(
 367:         first.session,
 368:         { accountType: 'ngo', organizationName: 'Riverside Shelter', acknowledgmentTextVersion: TEXT_VERSION },
 369:         CLIENT_IP,
 370:       );
 371:       expect(completion, 'the NGO completion was refused').toMatchObject({ ok: true });
 372:       if (!completion.ok) return;
 373:   
 374:       // (1) THE CONTROL. A live session writes. Without it every refusal below could be a write path
 375:       // that never worked at all.
 376:       const CONTROL_NAME = 'Riverside Shelter Control Programme';
 377:       expect(
 378:         (await sut.createOrganization(first.session, CONTROL_NAME)).ok,
 379:         'a live session could not write â€” nothing below would be about the session layer',
 380:       ).toBe(true);
 381:   
 382:       // (2) EXPIRY. The clock is the only thing that changes across this line: the same session, the
 383:       // same account, the same shape of write.
 384:       //
 385:       // THE ADVANCE IS EXACTLY THE TTL, AND EXACTLY IS THE WHOLE POINT. One hour is
 386:       // `jwt_expiry = 3600` in `supabase/config.toml`, which the fixture mirrors, and this lands the
 387:       // clock ON the expiry instant rather than past it. The fixture's `sessionIsLive` compares with
 388:       // a strict `<`, so at this instant the session is already dead and the write below is refused;
 389:       // an inclusive `<=` would admit it and this body would fail. That boundary was a promise with
 390:       // no oracle until this line pinned it. AT-001.13 keeps its just-under/just-past pair, which
 391:       // discriminates the refresh rather than the boundary.
 392:       await h.clock.advance(3600 * 1000);
 393:   
 394:       const EXPIRED_NAME = 'Riverside Shelter Expired Programme';
 395:       const afterExpiry = await sut.createOrganization(first.session, EXPIRED_NAME);
 396:       expect(afterExpiry.ok, 'an EXPIRED session was allowed to write').toBe(false);
 397:       // A STALE-SESSION WRITE THAT HAPPENED ANYWAY IS NOT A BLOCK. The refusal hands back no
 398:       // identifier, so the row that must not exist is looked for by the name that was attempted.
 399:       expect(
 400:         await sut.organizationsNamed(EXPIRED_NAME),
 401:         'the refused write of an expired session created the organisation anyway',
 402:       ).toEqual([]);
 403:   
 404:       // (3) RE-AUTHENTICATION IS THE REMEDY, proved by being the exact change that unblocks. The same
 405:       // write, the same name, under a session obtained by signing in again.
 406:       const second = await sut.signInWithEmailPassword(email, PASSWORD);
 407:       expect(second.ok, 'the account could not sign in again after its session expired').toBe(true);
 408:       if (!second.ok) return;
 409:       expect(second.session.accountId, 're-authentication returned a different account').toBe(first.session.accountId);
 410:   
 411:       expect(
 412:         (await sut.createOrganization(second.session, EXPIRED_NAME)).ok,
 413:         're-authentication did not restore the ability to write',
 414:       ).toBe(true);
 415:       expect(
 416:         (await sut.organizationsNamed(EXPIRED_NAME)).length,
 417:         'the write after re-authentication did not create the organisation',
 418:       ).toBe(1);
 419:   
 420:       // (4) REVOCATION, the criterion's other half, on a session that is live at the moment it is
 421:       // revoked â€” so the clock plays no part in this half and the two causes stay distinguishable.
 422:       await sut.signOut(second.session);
 423:   
 424:       const REVOKED_NAME = 'Riverside Shelter Revoked Programme';
 425:       const afterRevocation = await sut.createOrganization(second.session, REVOKED_NAME);
 426:       expect(afterRevocation.ok, 'a REVOKED session was allowed to write').toBe(false);
 427:       expect(
 428:         await sut.organizationsNamed(REVOKED_NAME),
 429:         'the refused write of a revoked session created the organisation anyway',
 430:       ).toEqual([]);
 431:   
 432:       // (5) AND RE-AUTHENTICATION IS THE REMEDY FOR REVOCATION TOO. Revoking one session must not end
 433:       // the account's access â€” that difference is what makes "the next request re-authenticates" a
 434:       // remedy rather than a wall.
 435:       const third = await sut.signInWithEmailPassword(email, PASSWORD);
 436:       expect(third.ok, 'the account could not sign in again after its session was revoked').toBe(true);
 437:       if (!third.ok) return;
 438:       expect(
 439:         (await sut.createOrganization(third.session, REVOKED_NAME)).ok,
 440:         'signing in again after revocation did not restore the ability to write',
 441:       ).toBe(true);
 442:       expect(
 443:         (await sut.organizationsNamed(REVOKED_NAME)).length,
 444:         'the write after re-authentication did not create the organisation',
 445:       ).toBe(1);
 446:     },
 447:     integration: at00112,
 448:   },
 449: );
