1300: export function stackEnv(
1301:   occupancy: Occupancy,
1302:   status: StackStatus,
1303:   itemRoot: string = REPO_ROOT,
1304:   extra: { attestation?: string; mailUrl?: string } = {},
1305: ): Record<string, string> {
1306:   refusePersonalSlotConfig(occupancy.slot, itemRoot, 'emit the coordinates of');
1307: 
