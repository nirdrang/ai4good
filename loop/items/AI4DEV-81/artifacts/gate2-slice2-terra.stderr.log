 801: /**
 802:  * Register one acceptance test. The id is declared here and nowhere else.
 803:  *
 804:  * - a malformed id throws AT REGISTRATION â€” the id is checked where it is written.
 805:  * - the id's requirement must match the suite's binding, for the reason above.
 806:  * - `expect.hasAssertions()` makes a body that asserts nothing a RED, so a tagged test cannot
 807:  *   satisfy the bijection checker by existing.
 808:  * - worlds AND harnesses are tracked per test and always torn down, so a frozen clock, a vendor
 809:  *   counter or an armed fault cannot leak into the next id â€” and a teardown that REJECTS fails
 810:  *   the test rather than being swallowed, because state that was never released is a defect that
 811:  *   would otherwise land on a different id.
 812:  *
 813:  * THE BODY'S TYPES ARE DERIVED, NOT ACCEPTED. `Sut` and `W` used to be this function's own type
 814:  * parameters, filled in by whatever the suite wrote; now they are `SutOf<R, K>` and `WorldOf<R>`,
 815:  * read off the adapter registered under `R` in `suite-adapters.ts`. There is no type argument left
 816:  * for a suite to lie with.
 817:  *
 818:  * A `const` typed by a call-signature alias, NOT an exported `function` declaration, for the reason
 819:  * given on `defineEvidenceCapture`: a function declaration accepts a merged-in overload and a
 820:  * `const` does not.
 821:  *
 822:  * THE SINGLE-BODY FORM IS TYPED AT THE LOOP TIER, and it is worth saying exactly what that does and
 823:  * does not buy. One body runs at every tier, so it is typed at the tier with the RICHEST
 824:  * capabilities â€” the loop tier, whose clock can be commanded and whose vendor seam can be armed.
 825:  * That keeps every suite in this tree compiling unchanged, and it means the type system does NOT
 826:  * stop a single body from commanding a clock that, above loop, is the passage of time.
 827:  *
 828:  * WHAT DOES STOP IT is the per-tier form: an id whose procedure differs above loop supplies an
 829:  * integration body, and THAT body is typed at `'integration'`, where the two seams are absent from
 830:  * the type. So the protection is opt-in at exactly the ids that need it, which are the ids whose
 831:  * criteria are about real time and real mail. An id that needs it and does not take it fails at run
 832:  * time rather than at compile time, and the fix is to write the body, not to widen the type.
 833:  */
 834: type AtTestFn = {
 835:   <R extends SuiteId, K extends SutKeyOf<R>>(
 836:     atId: string,
 837:     title: string,
 838:     opts: AtTestOptions & SuiteBinding<R, K>,
 839:     body: AtTestBody<R, K, 'loop'> | AtTestBodies<R, K>,
 840:   ): void;
 841: };
 842: 
 843: export const atTest: AtTestFn = <R extends SuiteId, K extends SutKeyOf<R>>(
 844:   atId: string,
 845:   title: string,
 846:   opts: AtTestOptions & SuiteBinding<R, K>,
 847:   body: AtTestBody<R, K, 'loop'> | AtTestBodies<R, K>,
 848: ): void => {
 849:   if (typeof body !== 'function' && (body === null || typeof body !== 'object')) {
 850:     throw new Error(`${atId}: atTest was given no test body`);
 851:   }
 852: 
 853:   /*
 854:    * WHICH BODY RUNS, decided here and once.
 855:    *
 856:    * A bare function is the single-body form: one procedure, every tier, exactly as every suite in
 857:    * this tree is written today. A MAP is the per-tier form, and the tier is resolved from `TIER` â€”
 858:    * the runner's own value, with no default anywhere â€” so the body that registers is the body
 859:    * written for the tier this process is running.
 860:    *
 861:    * A MAP WITH A HOLE IS REFUSED AT REGISTRATION, not skipped. `tierBodyProblem` says why: an id
 862:    * with no body at a tier reports MISSING there, and MISSING is the one state no declaration can
 863:    * describe. Refusing at the call site puts the error where the map is written.
 864:    *
 865:    * WITH `AT_TIER` UNSET there is no tier to choose, so the map's `default` â€” or, failing that, the
 866:    * loop body â€” registers, and `openWorld` refuses with `tier-unset` on its first `open()` exactly
 867:    * as it always has. The alternative would be registering NOTHING, which turns a plainly-diagnosed
 868:    * misuse into an unexplained missing row.
 869:    */
 870:   const resolved: AtTestBody<R, K, 'loop'> = (() => {
 871:     if (typeof body === 'function') return body;
 872:     const problem = tierBodyProblem(body as Record<string, unknown>, atId);
 873:     if (problem) throw new Error(problem);
 874:     const chosen = chooseTierBody(body as Record<string, unknown>, TIER);
 875:     // THE ONE BRIDGE BETWEEN THE TWO TIERS' CONTEXT TYPES, and it is a widening of a NARROWER type.
 876:     // An integration body is written against a context whose clock and vendor seams have FEWER
 877:     // members, so the object built below â€” which has all of them â€” satisfies it; what the cast says
 878:     // is that this function hands one runtime object to bodies written at two different types, and
 879:     // the direction is always narrow-body/wide-object. A body cannot reach a member the object
 880:     // lacks, because no tier's type names one the loop type does not.
 881:     return chosen as AtTestBody<R, K, 'loop'>;
 882:   })();
 883: 
 884:   const parsed = parseAtId(atId);
 885:   const mismatch = requirementMismatch(atId, parsed.requirement, opts.requirement);
 886:   if (mismatch) throw new Error(mismatch);
 887: 
 888:   const previous = registrations.get(atId);
 889:   if (previous) throw new Error(`${atId} is registered twice ("${previous.title}" and "${title}") â€” one id, one test`);
 890:   const registration = { ...parsed, title, surface: opts.surface ?? 'backend' };
 891:   registrations.set(atId, registration);
 892:   emitRuntimeRegistration(registration);
 893: 
 894:   const sutKey = opts.sut;
 895:   const sutMissing =
 896:     opts.sutMissingDetail ?? `REQ-${parsed.requirement}'s implementation is not in the tree â€” harness.sut.${sutKey} is absent`;
 897: 
 898:   it(`${atId} â€” ${title}`, async () => {
 899:     expect.hasAssertions();
 900: 
 901:     const worlds: TrackedTeardown[] = [];
 902:     const harnesses: TrackedTeardown[] = [];
 903:     const usage: Usage = { opens: 0, captures: 0 };
 904:     const ctx: InternalContext<SutOf<R, K>, WorldOf<R>, 'loop'> = {
 905:       atId,
 906:       [USAGE]: usage,
 907:       open: async (fixture = `req-${parsed.requirement}/base`, openOpts) => {
 908:         const { opened, harness } = await openWorld({
 909:           atId,
 910:           requirement: parsed.requirement,
 911:           sutKey,
 912:           sutMissing,
 913:           fixture,
 914:           configOverrides: openOpts?.config,
 915:         });
 916:         harnesses.push({ what: `harness for fixture world ${JSON.stringify(fixture)}`, teardown: () => harness.teardown() });
 917:         worlds.push({ what: `fixture world ${JSON.stringify(fixture)}`, teardown: () => opened.w.teardown() });
 918:         usage.opens += 1;
 919:         // THE ONE SURVIVING ASSERTION, and exactly what it still takes on trust.
 920:         //
 921:         // `h.sut[key]` is `unknown` and `h.fixtures.world()` is `WorldSeam`, because `h` is the
 922:         // concrete `AtHarness` the factory is checked to produce and that type deliberately says
 923:         // nothing about any one suite. No run-time value can prove its own static type, so this
 924:         // relabelling cannot be removed â€” only moved to where the claim is smallest.
 925:         //
 926:         // What changed is WHOSE claim it is. It used to be the suite's: `bindSuite<X, Y>` named two
 927:         // types and this line stamped them onto whatever the harness returned, so any pair of names
 928:         // was accepted. Now both come from `suite-adapters.ts`, which reads them off the adapter
 929:         // module that the `requirement` literal proves is the module `loadAdapter()` imports â€”
 930:         // checked at the map entry, and again at run time in `index.ts`.
 931:         //
 932:         // So what remains unchecked here is narrow and nameable: that the object `createHarness()`
 933:         // built at run time really is the one that module's `createFixtureAdapter()` returned. That
 934:         // holds unless somebody casts inside `index.ts` or mutates the adapter after it is built â€”
 935:         // both trusted-author escapes this item does not claim to close.
 936:         return opened as OpenWorld<R, K, 'loop'>;
 937:       },
 938:       capture: async (evidence) => {
 939:         const value = await evidence.consume(ctx);
 940:         usage.captures += 1;
 941:         return value;
 942:       },
 943:     };
 944: 
 945:     await runTrackedTest(atId, () => executeRegisteredBody(atId, resolved, ctx, usage), worlds, harnesses);
 946:   });
 947: };
