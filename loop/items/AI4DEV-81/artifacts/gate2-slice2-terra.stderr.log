1004: /* --------------------------------------------------------------------------- vitest json shape */
1005: 
1006: export interface AssertionResult {
1007:   title?: string;
1008:   fullName?: string;
1009:   status?: string;
1010:   failureMessages?: string[];
1011: }
1012: 
1013: /**
1014:  * The report's own arithmetic, alongside the per-test results. `--expect` needs both: the id
1015:  * parser only sees tests whose titles carry an AT id, so an untagged `it()` that fails is
1016:  * invisible to it and visible in these counts. Optional because this describes a file on disk â€”
1017:  * a missing field is validated at runtime (see `reportAccountingDeviations`), not asserted here.
1018:  */
1019: interface VitestJson {
1020:   /**
1021:    * One entry per test FILE. `status` and `message` are kept alongside the assertions because a
1022:    * file that fails to import, or whose hook throws, changes no test's status: that failure is
1023:    * visible here and nowhere else in the report.
1024:    */
1025:   testResults?: { name?: string; status?: string; message?: string; assertionResults?: AssertionResult[] }[];
1026:   numTotalTests?: number;
1027:   numPassedTests?: number;
1028:   numFailedTests?: number;
1029:   numPendingTests?: number;
1030:   numTodoTests?: number;
1031:   success?: boolean;
1032: }
1033: 
1034: export interface IdRow {
1035:   id: string;
1036:   status: 'green' | 'red' | 'missing';
1037:   detail: string;
1038: }
1039: 
1040: export interface RuntimeRegistration {
1041:   atId: string;
1042:   title: string;
1043:   surface: string;
1044: }
1045: 
1046: export interface ReportAnalysis {
1047:   rows: IdRow[];
1048:   unexpected: string[];
1049: }
1050: 
1051: function assertionId(assertion: AssertionResult): string | null {
1052:   return /^(AT-[\d.]+[a-z]?)\s+â€”/.exec(assertion.title ?? assertion.fullName ?? '')?.[1] ?? null;
1053: }
1054: 
1055: export function analyzeReportedTests(
1056:   expected: string[],
1057:   registrations: RuntimeRegistration[],
1058:   assertions: AssertionResult[],
1059: ): ReportAnalysis {
1060:   const registrationGroups = new Map<string, RuntimeRegistration[]>();
1061:   for (const registration of registrations) {
1062:     const group = registrationGroups.get(registration.atId) ?? [];
1063:     group.push(registration);
1064:     registrationGroups.set(registration.atId, group);
1065:   }
1066: 
1067:   const assertionGroups = new Map<string, AssertionResult[]>();
1068:   for (const assertion of assertions) {
1069:     const id = assertionId(assertion);
1070:     if (!id) continue;
1071:     const group = assertionGroups.get(id) ?? [];
1072:     group.push(assertion);
1073:     assertionGroups.set(id, group);
1074:   }
1075: 
1076:   const rows: IdRow[] = expected.map((id) => {
1077:     const runtime = registrationGroups.get(id) ?? [];
1078:     const results = assertionGroups.get(id) ?? [];
1079:     if (runtime.length !== 1) {
1080:       return {
1081:         id,
1082:         status: 'red',
1083:         detail:
1084:           runtime.length === 0
1085:             ? 'no runtime registration emitted by atTest'
1086:             : `${runtime.length} runtime registrations emitted by atTest; expected exactly 1`,
1087:       };
1088:     }
1089:     if (results.length !== 1) {
1090:       return {
1091:         id,
1092:         status: 'red',
1093:         detail: `${results.length} Vitest results reported; expected exactly 1`,
1094:       };
1095:     }
1096: 
1097:     const result = results[0];
1098:     const expectedTitle = `${id} â€” ${runtime[0].title}`;
1099:     if (result.title !== expectedTitle) {
1100:       return {
1101:         id,
1102:         status: 'red',
1103:         detail: `Vitest title ${JSON.stringify(result.title)} does not match runtime registration ${JSON.stringify(expectedTitle)}`,
1104:       };
1105:     }
1106:     if (result.status !== 'passed') {
1107:       return {
1108:         id,
1109:         status: 'red',
1110:         detail: firstLine(result.failureMessages?.join('\n'), `status "${result.status}"`),
1111:       };
1112:     }
1113:     return { id, status: 'green', detail: runtime[0].title };
1114:   });
1115: 
1116:   const observed = new Set([...registrationGroups.keys(), ...assertionGroups.keys()]);
1117:   const unexpected = [...observed].filter((id) => !expected.includes(id)).sort();
1118:   return { rows, unexpected };
1119: }
