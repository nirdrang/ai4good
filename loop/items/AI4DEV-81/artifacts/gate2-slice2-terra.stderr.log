   1: {
   2:   /* Every file under tests/at, whatever its extension - the point of this config is that a suite
   3:      written next month is covered the day it is written. `allowJs`/`checkJs` are what make the
   4:      coverage claim exactly true rather than nearly true: a JavaScript helper dropped in here runs
   5:      under vitest, so it must be type-checked too, not merely discouraged by a README.
   6:      The explicit `exclude` is load-bearing - naming one replaces TypeScript's default, and vitest
   7:      recreates tests/at/node_modules (its own cache) on every at:selftest run. */
   8:   "include": ["**/*"],
   9:   /* `typeprobes` holds code that MUST NOT compile - the negative tests for the harness-invention
  10:      attacks. A green run over that directory IS the defect, so it cannot live in this program; it
  11:      has its own config and `type-invention.selftest.ts` asserts that it still fails. */
  12:   "exclude": ["node_modules", "typeprobes"],
  13:   "compilerOptions": {
  14:     /* Node-side, NOT the browser. `target` matches the root config deliberately: vite resolves the
  15:        nearest tsconfig per file, and this field drives useDefineForClassFields, so a divergence
  16:        here would change class semantics in the harness at runtime. */
  17:     "target": "ES2022",
  18:     "module": "ESNext",
  19:     "lib": ["ES2022"],
  20:     "types": ["node"],
  21: 
  22:     /* The harness imports with explicit .ts specifiers ('./registry.ts'), which only Bundler
  23:        resolution accepts; TypeScript requires noEmit alongside allowImportingTsExtensions. */
  24:     "moduleResolution": "Bundler",
  25:     "allowImportingTsExtensions": true,
  26:     "allowJs": true,
  27:     "checkJs": true,
  28:     "noEmit": true,
  29: 
  30:     /* Checking, not linting. skipLibCheck stays FALSE: it cannot tell a third-party .d.ts from a
  31:        first-party one under tests/at, and skipping our own declarations is what this item exists
  32:        to stop. noUncheckedSideEffectImports matches the root config - without it a renamed bare
  33:        side-effect import produces no diagnostic at all. */
  34:     "skipLibCheck": false,
  35:     "strict": true,
  36:     "noUncheckedSideEffectImports": true
  37:   }
  38: }
