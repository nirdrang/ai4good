 244:   /**
 245:    * The links a message carries, in the order they appear.
 246:    *
 247:    * The RAW message is searched rather than a rendered body, so a token survives verbatim. Both the
 248:    * confirmation and the recovery mail carry `/auth/v1/verify?...`, and they are told apart by the
 249:    * `type` parameter â€” which is what AI4DEV-60's proof had to do too, because one address can hold
 250:    * both kinds at once.
 251:    */
 252:   const linksFor = async (address: string, wanted: 'signup' | 'recovery'): Promise<string[]> => {
 253:     const messages = await vendors.email.messagesFor(address);
 254:     const links: string[] = [];
 255:     for (const message of messages) {
 256:       // Quoted-printable soft line breaks are what a mail transport inserts into a long URL; leaving
 257:       // them in produces a link that 404s and reads exactly like "no email arrived".
 258:       const body = message.body.replace(/=\r?\n/g, '').replace(/&amp;/g, '&');
 259:       for (const match of body.matchAll(/https?:\/\/[^\s"'<>)\]]+/g)) {
 260:         const url = match[0].replace(/[.,;]+$/, '');
 261:         if (!url.includes('/auth/v1/verify')) continue;
 262:         if (!url.includes(`type=${wanted}`)) continue;
 263:         links.push(url);
 264:       }
 265:     }
 266:     return links;
 267:   };
