 151: function tokensOf(store: Map<string, LiveSession>, session: Session, act: string): LiveSession {
 152:   const held = session.sessionId ? store.get(session.sessionId) : undefined;
 153:   if (!held) {
 154:     throw new Error(
 155:       `refusing to ${act}: this handle names account ${session.accountId} and holds NO session. On the live stack a ` +
 156:         `registration under enable_confirmations = true issues no tokens, so the handle it returns cannot act. Follow ` +
 157:         `the live public order â€” register, use the emailed verification link, sign in â€” and act with the sign-in's ` +
 158:         `session. Nothing was fabricated to make this call work.`,
 159:     );
 160:   }
 161:   return held;
 162: }
