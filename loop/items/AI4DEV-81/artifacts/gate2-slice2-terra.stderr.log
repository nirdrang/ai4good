 767: /**
 768:  * THE ONE PLACE the AT id's requirement and the binding's requirement are made to agree.
 769:  *
 770:  * They are two independent strings that must denote the same suite: the id decides which fixture
 771:  * adapter `createHarness()` loads at RUN time (`openWorld` passes `parsed.requirement` straight
 772:  * through), while the binding decides which adapter the TYPES were read off at compile time. Left
 773:  * unchecked, `AT-017.03` registered through a suite bound to `req-016` would drive req-017's
 774:  * implementation while every type in the body described req-016's, and both halves would look fine.
 775:  *
 776:  * The formats differ and the comparison must normalize, or it would reject every valid suite:
 777:  * `parseAtId('AT-016.01').requirement` is `"016"`, whereas the binding and the registry key are
 778:  * `"req-016"`.
 779:  *
 780:  * The field stays MANDATORY. Making the check fire only when a requirement happens to be supplied
 781:  * would reopen the hole through the door marked convenience â€” so a binding with no requirement is
 782:  * its own error, not a skipped check.
 783:  */
 784: export function requirementMismatch(atId: string, parsedRequirement: string, bound: string): string | null {
 785:   if (!bound) {
 786:     return (
 787:       `${atId} was registered with no requirement â€” atTest cannot check that the suite whose types ` +
 788:       `were used is the suite whose fixture adapter will be loaded. Bind the suite with ` +
 789:       `bindSuite({ requirement: 'req-${parsedRequirement}', sut: â€¦ }).`
 790:     );
 791:   }
 792:   const fromId = `req-${parsedRequirement}`;
 793:   if (fromId === bound) return null;
 794:   return (
 795:     `${atId} was registered through a suite bound to ${bound} â€” at run time the harness would load ` +
 796:     `${fromId}'s fixture adapter, because the requirement comes from the AT id, while the ` +
 797:     `type-check described ${bound}'s. One id, one suite: correct the id or correct the binding.`
 798:   );
 799: }
