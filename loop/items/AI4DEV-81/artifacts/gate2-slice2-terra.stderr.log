 451: atTest(
 452:   'AT-001.13',
 453:   'a session in continuous use refreshes without a forced mid-work re-login',
 454:   { surface: 'ui' },
 455:   {
 456:     default: async ({ open }) => {
 457:       const { h, w, sut } = await open();
 458:   
 459:       /**
 460:        * WHICH HALF OF THIS CRITERION THIS TIER PROVES, said before the first assertion.
 461:        *
 462:        * PROVED HERE: a refresh takes NO credentials, extends the session it was given, and keeps work
 463:        * going past the instant the session would otherwise have died â€” while an unrefreshed sibling
 464:        * opened at the same instant dies exactly then. That pair is the discriminator: without the
 465:        * sibling, a fixture that never expired anything would pass every assertion below.
 466:        *
 467:        * NOT PROVED HERE: the word "automatically". Scheduling a refresh is the supabase-js client's
 468:        * job and no client exists in this tree; a fixture that scheduled its own would be grading
 469:        * itself. That half is handed to the manifest's wiring leaf by this id's `ui` mark, and the
 470:        * requirement's integration-tier gate binds it above that.
 471:        */
 472:       const { email } = await registerAndConfirm(sut, w.email('continuous-work'), PASSWORD);
 473:   
 474:       // TWO SESSIONS OPENED AT THE SAME INSTANT. The clock does not move between them, so they share
 475:       // an expiry â€” which is what makes the divergence later attributable to the refresh and to
 476:       // nothing else.
 477:       const refreshedSignIn = await sut.signInWithEmailPassword(email, PASSWORD);
 478:       const controlSignIn = await sut.signInWithEmailPassword(email, PASSWORD);
 479:       expect(refreshedSignIn.ok && controlSignIn.ok, 'the confirmed account could not open two sessions').toBe(true);
 480:       if (!refreshedSignIn.ok || !controlSignIn.ok) return;
 481:   
 482:       const refreshed = refreshedSignIn.session;
 483:       const control = controlSignIn.session;
 484:       expect(refreshed.sessionId, 'two sign-ins returned ONE session â€” the pair below would prove nothing').not.toBe(control.sessionId);
 485:       expect(control.accountId, 'the two sessions belong to different accounts').toBe(refreshed.accountId);
 486:   
 487:       // Sign-in precedes completion, the live public order. The account is completed once and serves
 488:       // both sessions, which is what the paired writes need.
 489:       const completion = await sut.completeSignup(
 490:         refreshed,
 491:         { accountType: 'ngo', organizationName: 'Riverside Shelter', acknowledgmentTextVersion: TEXT_VERSION },
 492:         CLIENT_IP,
 493:       );
 494:       expect(completion, 'the NGO completion was refused').toMatchObject({ ok: true });
 495:       if (!completion.ok) return;
 496:   
 497:       // (1) BOTH SESSIONS WORK. One write each, so neither is assumed to work from the other's
 498:       // success.
 499:       expect((await sut.createOrganization(refreshed, 'Riverside Programme One')).ok, 'the refreshed session could not write at the start').toBe(true);
 500:       expect((await sut.createOrganization(control, 'Riverside Programme Two')).ok, 'the control session could not write at the start').toBe(true);
 501:   
 502:       // (2) WORK CONTINUES, and the clock moves to just inside the expiry both sessions share. Both
 503:       // still work, so the divergence in (4) cannot be blamed on this advance.
 504:       await h.clock.advance(3599 * 1000);
 505:       expect((await sut.createOrganization(refreshed, 'Riverside Programme Three')).ok, 'the refreshed session died before its expiry').toBe(true);
 506:       expect((await sut.createOrganization(control, 'Riverside Programme Four')).ok, 'the control session died before its expiry').toBe(true);
 507:   
 508:       // (3) THE REFRESH. NO CREDENTIALS PASS THROUGH THIS CALL â€” there is no parameter for one, so
 509:       // this body could not sign in here even by mistake. That is the criterion's "without forced
 510:       // re-login", written as a fact of the interface rather than as a claim in a test name.
 511:       const refreshOutcome = await sut.refreshSession(refreshed);
 512:       expect(refreshOutcome.ok, 'refreshing a live session was refused').toBe(true);
 513:       if (!refreshOutcome.ok) return;
 514:       expect(
 515:         refreshOutcome.session.sessionId,
 516:         'the refresh opened a NEW session instead of extending the one it was given',
 517:       ).toBe(refreshed.sessionId);
 518:       expect(refreshOutcome.session.accountId, 'the refresh returned a different account').toBe(refreshed.accountId);
 519:   
 520:       // (4) PAST THE INSTANT BOTH SESSIONS WOULD HAVE DIED. The refreshed one keeps working; the
 521:       // sibling that was not refreshed is refused, and its attempted write left nothing behind.
 522:       await h.clock.advance(2 * 1000);
 523:   
 524:       const AFTER_NAME = 'Riverside Programme Five';
 525:       const refreshedWrite = await sut.createOrganization(refreshOutcome.session, AFTER_NAME);
 526:       expect(refreshedWrite.ok, 'the REFRESHED session was refused after its original expiry â€” refresh did nothing').toBe(true);
 527:   
 528:       const CONTROL_NAME = 'Riverside Programme Six';
 529:       const controlWrite = await sut.createOrganization(control, CONTROL_NAME);
 530:       expect(
 531:         controlWrite.ok,
 532:         'the UNREFRESHED sibling still worked past its expiry â€” nothing above is attributable to the refresh',
 533:       ).toBe(false);
 534:       expect(
 535:         await sut.organizationsNamed(CONTROL_NAME),
 536:         'the refused write of the unrefreshed session created the organisation anyway',
 537:       ).toEqual([]);
 538:       expect(
 539:         (await sut.organizationsNamed(AFTER_NAME)).length,
 540:         'the refreshed session said it wrote and did not',
 541:       ).toBe(1);
 542:     },
 543:     integration: at00113,
 544:   },
 545: );
