 547: atTest(
 548:   'AT-001.14',
 549:   'after the emailed reset flow the new password works and the old one does not',
 550:   { surface: 'ui' },
 551:   {
 552:     default: async ({ open }) => {
 553:       const { w, sut } = await open();
 554:   
 555:       const OLD_PASSWORD = PASSWORD;
 556:       const NEW_PASSWORD = 'a different correct horse battery staple';
 557:   
 558:       const { email } = await registerAndConfirm(sut, w.email('password-reset'), OLD_PASSWORD);
 559:   
 560:       // (1) THE CONTROL. The old password works before the reset, so "the old one does not" below is
 561:       // a change this flow caused rather than a password that never worked.
 562:       const before = await sut.signInWithEmailPassword(email, OLD_PASSWORD);
 563:       expect(before.ok, 'the old password did not work before the reset').toBe(true);
 564:       if (!before.ok) return;
 565:       const accountId = before.session.accountId;
 566:   
 567:       expect((await sut.requestPasswordReset(email)).ok, 'requesting a password reset was refused').toBe(true);
 568:   
 569:       // (2) A LINK THAT WAS NEVER ISSUED CHANGES NOTHING â€” read FIRST, before the real link is
 570:       // followed, so it is answered on an account whose password has not moved yet.
 571:       //
 572:       // THIS IS NOT A CLAIM ABOUT LINK LIFETIME. Retired AT-001.15's ground is deliberately
 573:       // untouched. It guards THIS TEST'S OWN ORACLE: if a link-shaped string reset an account it
 574:       // never belonged to, then "completing the emailed flow is what changes the password" would mean
 575:       // nothing, because any string would change anything.
 576:       const neverIssued = await sut.completePasswordReset('never-issued-link', NEW_PASSWORD);
 577:       expect(neverIssued.ok, 'a reset link that was never issued was accepted').toBe(false);
 578:       expect(
 579:         (await sut.signInWithEmailPassword(email, OLD_PASSWORD)).ok,
 580:         'a reset link that was never issued changed the password anyway',
 581:       ).toBe(true);
 582:   
 583:       // (3) THE EMAILED LINK IS WHAT DOES IT.
 584:       const link = await sut.emailedPasswordResetLink(email);
 585:       expect(link, 'no reset link was emailed to the address that asked for one').not.toBeNull();
 586:       expect((await sut.completePasswordReset(link!, NEW_PASSWORD)).ok, 'the emailed reset link was refused').toBe(true);
 587:   
 588:       // (4) THE CRITERION'S BOTH HALVES. The new password works.
 589:       const withNew = await sut.signInWithEmailPassword(email, NEW_PASSWORD);
 590:       expect(withNew.ok, 'the new password does not work after the reset').toBe(true);
 591:       if (!withNew.ok) return;
 592:       expect(withNew.session.accountId, 'the reset produced a different account').toBe(accountId);
 593:   
 594:       // And the old one does not. The session count is read across the refused attempt for the same
 595:       // reason AT-001.38 reads it: a refusal hands back no handle, so only a count can show that the
 596:       // rejected sign-in minted nothing.
 597:       const sessionsBeforeOldAttempt = await sut.sessionsOf(accountId);
 598:       const withOld = await sut.signInWithEmailPassword(email, OLD_PASSWORD);
 599:       expect(withOld.ok, 'the OLD password still works after the reset').toBe(false);
 600:       expect(
 601:         await sut.sessionsOf(accountId),
 602:         'the rejected old-password sign-in created a session',
 603:       ).toEqual(sessionsBeforeOldAttempt);
 604:     },
 605:     integration: at00114,
 606:   },
 607: );
