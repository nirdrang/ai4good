 181: atTest(
 182:   'AT-001.10',
 183:   'an unverified NGO account is blocked from Discovery messages with verification named as the remedy',
 184:   { surface: 'backend' },
 185:   {
 186:     default: async ({ open }) => {
 187:       const { w, sut } = await open();
 188:   
 189:       // WHAT THIS TEST GRADES, said plainly: the SHIPPED decision
 190:       // `discoveryMessageAllowed` in `supabase/functions/_shared/verification.ts`. There is NO
 191:       // Discovery route in this repository â€” it is REQ-002/004's â€” so `sendDiscoveryMessage` is a
 192:       // stand-in surface that exists to put that decision on a tested path. No green here says
 193:       // Discovery messaging is gated anywhere; it says the gate answers correctly and that a refusal
 194:       // writes nothing.
 195:       //
 196:       // AND THE STATE THIS BODY BUILDS IS NOT REACHABLE BY THE LIVE PUBLIC PATH. With confirmations
 197:       // on, GoTrue issues no session at signup, so a completed-but-unverified account cannot be
 198:       // produced by a visitor. The gate exists anyway, and the reason is decision-8: verification is
 199:       // "the floor for any Discovery message" â€” the write path's own rule, not one borrowed from the
 200:       // session layer. Non-public paths and configuration history reach this state, and the live
 201:       // auth-layer block is measured separately in the item's proof script, check (c).
 202:       const email = w.email('unverified-ngo');
 203:       const session = await sut.registerWithEmailPassword(email, PASSWORD);
 204:       const completion = await sut.completeSignup(
 205:         session,
 206:         {
 207:           accountType: 'ngo',
 208:           organizationName: 'Riverside Shelter',
 209:           acknowledgmentTextVersion: TEXT_VERSION,
 210:         },
 211:         CLIENT_IP,
 212:       );
 213:       expect(completion, 'the NGO completion was refused').toMatchObject({ ok: true });
 214:       if (!completion.ok) return;
 215:   
 216:       // The control that makes the refusal below attributable. If the account were already verified,
 217:       // a refusal would be evidence of a broken gate rather than of a working one.
 218:       expect(
 219:         await sut.emailVerified(session.accountId),
 220:         'this test is about an UNVERIFIED account; if it is verified, nothing below is about AT-001.10',
 221:       ).toBe(false);
 222:   
 223:       const MESSAGE = 'Hello â€” we would like to talk about your project.';
 224:   
 225:       // (1) THE BLOCK, AND THE REMEDY IT NAMES. "the attempt is blocked with verification named as
 226:       // the remedy": a refusal saying only "forbidden" would satisfy a weaker reading of the
 227:       // criterion and would tell the sender nothing about what to do next.
 228:       const blocked = await sut.sendDiscoveryMessage(session, MESSAGE);
 229:       expect(blocked.ok, 'an unverified account was allowed to send a Discovery message').toBe(false);
 230:       if (blocked.ok) return;
 231:       expect(blocked.reason, 'the refusal does not name verification').toMatch(/verif/i);
 232:       expect(blocked.reason, 'the refusal does not name the email address as what needs verifying').toMatch(/email/i);
 233:   
 234:       // (2) THE BLOCKED ATTEMPT WROTE NOTHING. A block whose write happened anyway is not a block,
 235:       // and the refusal's own return value cannot show this â€” only a read-back can.
 236:       expect(
 237:         await sut.discoveryMessagesBy(session.accountId),
 238:         'the blocked Discovery message was recorded anyway',
 239:       ).toEqual([]);
 240:   
 241:       // (3) THE DISCRIMINATING CONTROL. Verification is proved to be THE REMEDY by being the exact
 242:       // change that unblocks the exact same send. Without this half, a gate that refused everybody
 243:       // unconditionally would pass every assertion above.
 244:       const link = await sut.emailedVerificationLink(email);
 245:       expect(link, 'no verification link was emailed to the NGO address').not.toBeNull();
 246:       expect((await sut.useVerificationLink(link!)).ok, 'the emailed verification link was refused').toBe(true);
 247:       expect(
 248:         await sut.emailVerified(session.accountId),
 249:         'using the emailed verification link did not flip the account to verified',
 250:       ).toBe(true);
 251:   
 252:       const allowed = await sut.sendDiscoveryMessage(session, MESSAGE);
 253:       expect(allowed.ok, 'the SAME Discovery message was still refused after verification').toBe(true);
 254:       expect(
 255:         await sut.discoveryMessagesBy(session.accountId),
 256:         'the allowed Discovery message was not recorded',
 257:       ).toEqual([MESSAGE]);
 258:     },
 259:     integration: at00110,
 260:   },
 261: );
