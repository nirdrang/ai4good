diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 7bb8b41..74635bc 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -1,93 +1,102 @@
 # KNOWN LIMITS — true of every CI system that runs a pull request's own configuration.
 # On a pull_request event GitHub runs this workflow as the PULL REQUEST defines it, and the
 # package.json scripts these steps call are equally editable by the pull request under test. What
 # this file proves is therefore: the head commit, against the checks as that commit defines them.
 # It cannot be tamper-proof — a check cannot police the file it is written in. Resistance to a
 # deliberately weakened check comes from server-side rules (required review, a ruleset restricting
 # .github/workflows edits) and from a human reading the diff, not from anything in here.
 
 name: CI
 
 on:
   pull_request:
     branches: [main]
   push:
     branches: [main]
 
 # Minimal and explicit. `contents: read` is what checkout needs; `pull-requests: read` is what the
 # ownership guard's `gh api .../pulls/N/files` call needs. Nothing here writes anything.
 permissions:
   contents: read
   pull-requests: read
 
 # One in-flight run per pull request: a new push to the same pull request cancels the older run.
 # Anything that is not a pull request falls back to the run id, which is unique per run — so those
 # runs share no group at all, none of them queues behind or cancels another, and every commit
 # landing on main gets its own verdict. Grouping them by branch would NOT do that: GitHub keeps at
 # most one pending run per group, so a third quick push would discard the second one's pending run
 # and that commit would never be judged.
 concurrency:
   group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.run_id }}
   cancel-in-progress: ${{ github.event_name == 'pull_request' }}
 
 jobs:
   verify:
     # WHERE THIS RUNS IS A VARIABLE, NOT A CODE CHANGE. Set the repository variable
     # `CI_RUNNER_LABEL` to a self-hosted runner's label to route the check there; clear it to
     # come straight back to GitHub-hosted capacity. That indirection is deliberate and it is
     # about safety, not convenience: this check is the ONLY licence to merge, so recovering from
     # a broken runner must never itself require a merge. Editing `runs-on` to fall back would
     # need a pull request, which would need this check, which is the runner that just broke.
     #
     # See .github/runner/ for the Linux container that serves the self-hosted label, and why the
     # check still judges the code on Linux either way.
     runs-on: ${{ vars.CI_RUNNER_LABEL || 'ubuntu-latest' }}
     # Generous on purpose. This bounds a RUNAWAY JOB; it is not a queue policy. At 15 minutes it
-    # was acting as one: hosted capacity queued this job for 11-15 minutes on 2026-08-06 and
-    # twice the budget expired before a single step ran, reporting `cancelled` as though someone
-    # had stopped it. The work itself takes about ten seconds on the fast lane.
+    # was acting as one. Twice on 2026-08-06 this job got no runner for 11-15 minutes and the
+    # budget expired before a single step ran, reporting `cancelled` as though someone had
+    # stopped it.
+    #
+    # WHY NO RUNNER, SAID AS IT WAS MEASURED: nobody established that. Two explanations fit the
+    # evidence equally well - GitHub-hosted capacity queueing the job, and a self-hosted lane that
+    # was not answering - and the observable is the same either way, which is a job sitting with
+    # no runner. The budget is raised because the budget was wrong for the observed wait, not
+    # because either story was settled. An earlier version of this comment asserted the queueing
+    # one; that assertion had nothing behind it.
+    #
+    # The work itself takes about ten seconds on the fast lane.
     timeout-minutes: 30
     steps:
       # THE HEAD COMMIT, NOT THE MERGE COMMIT. On a pull_request event GitHub's default ref is a
       # synthetic merge of head into base — a commit that exists in no branch and that nobody
       # reviewed. This item exists to make CI's verdict be about the commit in the pull request, so
       # the head sha is named explicitly. On push events the expression falls through to
       # github.sha, which is the pushed commit.
       - name: Check out the commit under test
         uses: actions/checkout@v4
         with:
           ref: ${{ github.event.pull_request.head.sha || github.sha }}
 
       - name: Report the commit under test
         shell: bash
         env:
           PR_HEAD_SHA: ${{ github.event.pull_request.head.sha }}
         run: |
           echo "event:             ${GITHUB_EVENT_NAME}"
           echo "pull request head: ${PR_HEAD_SHA:-(not a pull request)}"
           echo "checked out:       $(git rev-parse HEAD)"
           git log -1 --format='%H  %an  %s'
 
       # THE TWIN GUARD. orchestrator.md and orchestrator-opus.md are one role in two files and
       # must be identical apart from the frontmatter and two declared fallback paragraphs. The
       # edit-both-or-neither rule drifted within a day of being relied on (2026-08-10), so it is
       # a check now, not a sentence. Fails fast, before anything expensive runs. The same script
       # backs the /work pre-flight and the drill suite: one definition of "synced".
       - name: Guard the orchestrator twins against drift
         shell: bash
         run: |
           # The workflow file comes from the merge ref, but the checkout is the PR head - a
           # branch cut before this guard landed does not contain the script (measured on run
           # 31446415848, 2026-08-11: pwsh died on the missing file and failed an innocent PR).
           # A tree that predates the guard is skipped LOUDLY, never failed: its twins are
           # whatever its branch point carried, and the merged head - which is what actually
           # lands - runs the guard from main's side on the next push.
           if [ ! -f loop/work/twin-check.ps1 ]; then
             echo "twin guard: script not in this tree (branch predates the guard) - skipping."
             echo "The guard binds this PR at its merged head; merge main forward to run it here."
             exit 0
           fi
           if command -v pwsh >/dev/null 2>&1; then
             pwsh -NoProfile -File loop/work/twin-check.ps1
           else
             powershell -NoProfile -File loop/work/twin-check.ps1
