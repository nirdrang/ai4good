 263: /**
 264:  * The registered address these four bodies start from, brought to the state the live public path
 265:  * leaves it in: created, and confirmed through the emailed link.
 266:  *
 267:  * IT EXISTS SO THE ORDER IS WRITTEN ONCE. Every one of the four opens the same way, and an order
 268:  * repeated four times is an order three of them can drift out of.
 269:  *
 270:  * IT RETURNS THE ADDRESS AND THE ACCOUNT ID, AND STILL NEVER THE REGISTRATION HANDLE. Withholding
 271:  * the handle is the point: the live stack with confirmations on issues no session at signup, so no
 272:  * body below may take one from here. The account id is a different kind of fact and is
 273:  * LIVE-FAITHFUL â€” a registered, unconfirmed user exists on the real stack and has an id there, and
 274:  * an operator reading `auth.sessions` needs exactly that id to read anything at all. AT-001.38 uses
 275:  * it to count sessions BEFORE the first sign-in, which is what turns "a sign-in mints a session"
 276:  * from a count above zero into a count that grew by one.
 277:  */
 278: const registerAndConfirm = async (
 279:   sut: AccountsSut,
 280:   email: string,
 280:   email: string,
 281:   password: string,
 282: ): Promise<{ email: string; accountId: string }> => {
 283:   const registration = await sut.registerWithEmailPassword(email, password);
 284:   const link = await sut.emailedVerificationLink(email);
 285:   expect(link, `no verification link was emailed to ${email}`).not.toBeNull();
 286:   expect((await sut.useVerificationLink(link!)).ok, 'the emailed verification link was refused').toBe(true);
 287:   return { email, accountId: registration.accountId };
 288: };
 289: 
 290: atTest(
 291:   'AT-001.38',
 292:   'sign-in with the correct email and a wrong password is rejected and creates no session',
 293:   { surface: 'ui' },
 294:   {
 295:     default: async ({ open }) => {
 296:       const { w, sut } = await open();
 297:   
 298:       const { email, accountId } = await registerAndConfirm(sut, w.email('wrong-password'), PASSWORD);
 299:   
 300:       // (1) THE CONTROL, AND IT COMES FIRST. Without it, a refusal below would be evidence of an
 301:       // account that cannot sign in at all rather than of a password being checked.
 302:       //
 303:       // THE COUNT IS READ ON BOTH SIDES OF THIS SIGN-IN, and the pair is what makes the control a
 304:       // control. A count above zero would prove nothing here: the fixture mints a session at
 305:       // registration â€” the divergence this file's header names â€” so a `signInWithEmailPassword` that
 306:       // minted nothing at all would still leave sessions behind. Exactly one more than before is the
 307:       // assertion, and only a sign-in that mints satisfies it. The after-reading is also what the
 308:       // failed attempt below is compared with.
 309:       const sessionsBeforeGoodSignIn = await sut.sessionsOf(accountId);
 310:   
 311:       const good = await sut.signInWithEmailPassword(email, PASSWORD);
 312:       expect(good.ok, 'the correct password was refused â€” nothing below would be about AT-001.38').toBe(true);
 313:       if (!good.ok) return;
 314:   
 315:       const sessionsAfterGoodSignIn = await sut.sessionsOf(good.session.accountId);
 316:       expect(
 317:         sessionsAfterGoodSignIn.length,
 318:         'a successful sign-in must mint exactly one new session, or the second clause below has no oracle',
 319:       ).toBe(sessionsBeforeGoodSignIn.length + 1);
 320:   
 321:       // (2) THE CRITERION'S FIRST CLAUSE: correct email, incorrect password, rejected.
 322:       const bad = await sut.signInWithEmailPassword(email, 'not the password');
 323:       expect(bad.ok, 'sign-in with the correct email and a WRONG password was accepted').toBe(false);
 324:   
 325:       // THE REFUSAL CARRIES NO EXISTENCE ORACLE, AND THAT IS THE FIXTURE'S STATED FACT RATHER THAN
 326:       // THIS BODY'S ASSERTION. `_fixture.ts`'s `signInWithEmailPassword` answers both branches â€” no
 327:       // such account, and wrong password â€” from ONE reason, deliberately and with the reason written
 328:       // beside the code. The criterion that owns no-existence-oracle behaviour is AT-001.21, another
 329:       // leaf's, so no line here compares one refusal's text with another's: an implementation that
 330:       // satisfied both of THIS id's clauses must not fail this body on response-text policy.
 331:       if (bad.ok) return;
 332:   
 333:       // (3) THE CRITERION'S SECOND CLAUSE: "no authenticated session is created". The refusal's own
 334:       // return value cannot show this â€” it hands back no handle â€” so it is read as a count across the
 335:       // failed attempt. Compared against the reading taken after the SUCCESSFUL sign-in, so a fixture
 336:       // that minted nothing at all would fail (1) instead of passing here by accident.
 337:       expect(
 338:         await sut.sessionsOf(good.session.accountId),
 339:         'the rejected sign-in created a session',
 340:       ).toEqual(sessionsAfterGoodSignIn);
 341:     },
 342:     integration: at00138,
 343:   },
 344: );
