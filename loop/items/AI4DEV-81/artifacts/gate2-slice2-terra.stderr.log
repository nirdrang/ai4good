 708: /**
 709:  * The tier's body, or the problem that means there is none. PURE, so the refusal is unit testable.
 710:  *
 711:  * A bare function is the single-body form and covers every tier â€” every suite in this tree is
 712:  * written that way and none of them changes.
 713:  */
 714: export function tierBodyProblem(bodies: Record<string, unknown>, atId: string): string | null {
 715:   const named = TIERS.filter((tier) => typeof bodies[tier] === 'function');
 716:   if (named.length === 0 && typeof bodies.default !== 'function') {
 717:     return (
 718:       `${atId} was registered with a per-tier body map that names no body at all â€” neither a tier nor a default. ` +
 719:       `One id, one body per tier.`
 720:     );
 721:   }
 722:   const uncovered = TIERS.filter((tier) => typeof bodies[tier] !== 'function');
 723:   if (uncovered.length && typeof bodies.default !== 'function') {
 724:     return (
 725:       `${atId} was registered with a per-tier body map that covers ${named.join(', ')} but not ` +
 726:       `${uncovered.join(', ')}, and supplies no default. An id with no body at a tier reports as MISSING there, ` +
 727:       `which no declaration can describe â€” supply a body for every tier, or a default.`
 728:     );
 729:   }
 730:   return null;
 731: }
