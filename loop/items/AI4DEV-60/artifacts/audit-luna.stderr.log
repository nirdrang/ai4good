436:atTest(
437:  'AT-001.13',
438:  'a session in continuous use refreshes without a forced mid-work re-login',
439:  { surface: 'ui' },
440:  async ({ open }) => {
441:    const { h, w, sut } = await open();
442:
443:    /**
444:     * WHICH HALF OF THIS CRITERION THIS TIER PROVES, said before the first assertion.
445:     *
446:     * PROVED HERE: a refresh takes NO credentials, extends the session it was given, and keeps work
447:     * going past the instant the session would otherwise have died â€” while an unrefreshed sibling
448:     * opened at the same instant dies exactly then. That pair is the discriminator: without the
449:     * sibling, a fixture that never expired anything would pass every assertion below.
450:     *
451:     * NOT PROVED HERE: the word "automatically". Scheduling a refresh is the supabase-js client's
452:     * job and no client exists in this tree; a fixture that scheduled its own would be grading
453:     * itself. That half is handed to the manifest's wiring leaf by this id's `ui` mark, and the
454:     * requirement's integration-tier gate binds it above that.
455:     */
456:    const { email } = await registerAndConfirm(sut, w.email('continuous-work'), PASSWORD);
457:
458:    // TWO SESSIONS OPENED AT THE SAME INSTANT. The clock does not move between them, so they share
459:    // an expiry â€” which is what makes the divergence later attributable to the refresh and to
460:    // nothing else.
461:    const refreshedSignIn = await sut.signInWithEmailPassword(email, PASSWORD);
462:    const controlSignIn = await sut.signInWithEmailPassword(email, PASSWORD);
463:    expect(refreshedSignIn.ok && controlSignIn.ok, 'the confirmed account could not open two sessions').toBe(true);
464:    if (!refreshedSignIn.ok || !controlSignIn.ok) return;
465:
466:    const refreshed = refreshedSignIn.session;
467:    const control = controlSignIn.session;
468:    expect(refreshed.sessionId, 'two sign-ins returned ONE session â€” the pair below would prove nothing').not.toBe(control.sessionId);
469:    expect(control.accountId, 'the two sessions belong to different accounts').toBe(refreshed.accountId);
470:
471:    // Sign-in precedes completion, the live public order. The account is completed once and serves
472:    // both sessions, which is what the paired writes need.
473:    const completion = await sut.completeSignup(
474:      refreshed,
475:      { accountType: 'ngo', organizationName: 'Riverside Shelter', acknowledgmentTextVersion: TEXT_VERSION },
476:      CLIENT_IP,
477:    );
478:    expect(completion, 'the NGO completion was refused').toMatchObject({ ok: true });
479:    if (!completion.ok) return;
480:
481:    // (1) BOTH SESSIONS WORK. One write each, so neither is assumed to work from the other's
482:    // success.
483:    expect((await sut.createOrganization(refreshed, 'Riverside Programme One')).ok, 'the refreshed session could not write at the start').toBe(true);
484:    expect((await sut.createOrganization(control, 'Riverside Programme Two')).ok, 'the control session could not write at the start').toBe(true);
485:
486:    // (2) WORK CONTINUES, and the clock moves to just inside the expiry both sessions share. Both
487:    // still work, so the divergence in (4) cannot be blamed on this advance.
488:    await h.clock.advance(3599 * 1000);
489:    expect((await sut.createOrganization(refreshed, 'Riverside Programme Three')).ok, 'the refreshed session died before its expiry').toBe(true);
490:    expect((await sut.createOrganization(control, 'Riverside Programme Four')).ok, 'the control session died before its expiry').toBe(true);
491:
492:    // (3) THE REFRESH. NO CREDENTIALS PASS THROUGH THIS CALL â€” there is no parameter for one, so
493:    // this body could not sign in here even by mistake. That is the criterion's "without forced
494:    // re-login", written as a fact of the interface rather than as a claim in a test name.
495:    const refreshOutcome = await sut.refreshSession(refreshed);
496:    expect(refreshOutcome.ok, 'refreshing a live session was refused').toBe(true);
497:    if (!refreshOutcome.ok) return;
498:    expect(
499:      refreshOutcome.session.sessionId,
500:      'the refresh opened a NEW session instead of extending the one it was given',
501:    ).toBe(refreshed.sessionId);
502:    expect(refreshOutcome.session.accountId, 'the refresh returned a different account').toBe(refreshed.accountId);
503:
504:    // (4) PAST THE INSTANT BOTH SESSIONS WOULD HAVE DIED. The refreshed one keeps working; the
505:    // sibling that was not refreshed is refused, and its attempted write left nothing behind.
506:    await h.clock.advance(2 * 1000);
507:
508:    const AFTER_NAME = 'Riverside Programme Five';
509:    const refreshedWrite = await sut.createOrganization(refreshOutcome.session, AFTER_NAME);
510:    expect(refreshedWrite.ok, 'the REFRESHED session was refused after its original expiry â€” refresh did nothing').toBe(true);
511:
512:    const CONTROL_NAME = 'Riverside Programme Six';
513:    const controlWrite = await sut.createOrganization(control, CONTROL_NAME);
514:    expect(
515:      controlWrite.ok,
516:      'the UNREFRESHED sibling still worked past its expiry â€” nothing above is attributable to the refresh',
517:    ).toBe(false);
518:    expect(
519:      await sut.organizationsNamed(CONTROL_NAME),
520:      'the refused write of the unrefreshed session created the organisation anyway',
521:    ).toEqual([]);
522:    expect(
523:      (await sut.organizationsNamed(AFTER_NAME)).length,
524:      'the refreshed session said it wrote and did not',
525:    ).toBe(1);
526:  },
527:);
