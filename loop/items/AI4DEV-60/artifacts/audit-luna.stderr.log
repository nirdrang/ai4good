529:atTest(
530:  'AT-001.14',
531:  'after the emailed reset flow the new password works and the old one does not',
532:  { surface: 'ui' },
533:  async ({ open }) => {
534:    const { w, sut } = await open();
535:
536:    const OLD_PASSWORD = PASSWORD;
537:    const NEW_PASSWORD = 'a different correct horse battery staple';
538:
539:    const { email } = await registerAndConfirm(sut, w.email('password-reset'), OLD_PASSWORD);
540:
541:    // (1) THE CONTROL. The old password works before the reset, so "the old one does not" below is
542:    // a change this flow caused rather than a password that never worked.
543:    const before = await sut.signInWithEmailPassword(email, OLD_PASSWORD);
544:    expect(before.ok, 'the old password did not work before the reset').toBe(true);
545:    if (!before.ok) return;
546:    const accountId = before.session.accountId;
547:
548:    expect((await sut.requestPasswordReset(email)).ok, 'requesting a password reset was refused').toBe(true);
549:
550:    // (2) A LINK THAT WAS NEVER ISSUED CHANGES NOTHING â€” read FIRST, before the real link is
551:    // followed, so it is answered on an account whose password has not moved yet.
552:    //
553:    // THIS IS NOT A CLAIM ABOUT LINK LIFETIME. Retired AT-001.15's ground is deliberately
554:    // untouched. It guards THIS TEST'S OWN ORACLE: if a link-shaped string reset an account it
555:    // never belonged to, then "completing the emailed flow is what changes the password" would mean
556:    // nothing, because any string would change anything.
557:    const neverIssued = await sut.completePasswordReset('never-issued-link', NEW_PASSWORD);
558:    expect(neverIssued.ok, 'a reset link that was never issued was accepted').toBe(false);
559:    expect(
560:      (await sut.signInWithEmailPassword(email, OLD_PASSWORD)).ok,
561:      'a reset link that was never issued changed the password anyway',
562:    ).toBe(true);
563:
564:    // (3) THE EMAILED LINK IS WHAT DOES IT.
565:    const link = await sut.emailedPasswordResetLink(email);
566:    expect(link, 'no reset link was emailed to the address that asked for one').not.toBeNull();
567:    expect((await sut.completePasswordReset(link!, NEW_PASSWORD)).ok, 'the emailed reset link was refused').toBe(true);
568:
569:    // (4) THE CRITERION'S BOTH HALVES. The new password works.
570:    const withNew = await sut.signInWithEmailPassword(email, NEW_PASSWORD);
571:    expect(withNew.ok, 'the new password does not work after the reset').toBe(true);
572:    if (!withNew.ok) return;
573:    expect(withNew.session.accountId, 'the reset produced a different account').toBe(accountId);
574:
575:    // And the old one does not. The session count is read across the refused attempt for the same
576:    // reason AT-001.38 reads it: a refusal hands back no handle, so only a count can show that the
577:    // rejected sign-in minted nothing.
578:    const sessionsBeforeOldAttempt = await sut.sessionsOf(accountId);
579:    const withOld = await sut.signInWithEmailPassword(email, OLD_PASSWORD);
580:    expect(withOld.ok, 'the OLD password still works after the reset').toBe(false);
581:    expect(
582:      await sut.sessionsOf(accountId),
583:      'the rejected old-password sign-in created a session',
584:    ).toEqual(sessionsBeforeOldAttempt);
585:  },
586:);

