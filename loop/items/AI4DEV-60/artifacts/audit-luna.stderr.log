101:const SENSITIVE = /token|secret|password|apikey|api_key|jwt|nonce|otp|code$/i;
102:
103:function scrubString(text: string): string {
104:  return text
105:    .replace(/eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+/g, '<redacted-jwt>')
106:    .replace(/([A-Za-z0-9_.-]+)=([^&\s"'<>]+)/g, (whole, name: string) =>
107:      SENSITIVE.test(name) ? `${name}=<redacted>` : whole,
108:    );
109:}
110:
111:function redact(value: unknown): string {
112:  const walk = (node: unknown): unknown => {
113:    if (Array.isArray(node)) return node.map(walk);
114:    if (node !== null && typeof node === 'object') {
115:      const out: Record<string, unknown> = {};
116:      for (const [key, inner] of Object.entries(node as Record<string, unknown>)) {
117:        out[key] = SENSITIVE.test(key) ? '<redacted>' : walk(inner);
118:      }
119:      return out;
120:    }
121:    if (typeof node === 'string') return scrubString(node);
122:    return node;
123:  };
124:  try {
125:    return JSON.stringify(walk(value));
126:  } catch {
127:    return '<unserialisable>';
128:  }
129:}
