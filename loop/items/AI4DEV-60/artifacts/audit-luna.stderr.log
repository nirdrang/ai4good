152: * WHICH CREDENTIAL-BEARING FIELDS A BODY CARRIES â€” the widened guard, stated as a list rather than
153: * as "no access token".
154: *
155: * A refusal that carried a refresh token or a whole `session` object while carrying no
156: * `access_token` would pass the narrow reading and be exactly as wrong. The names are returned so
157: * the transcript can say WHICH field was present rather than only that something was.
158: */
159:function credentialFieldsIn(body: unknown): string[] {
160:  if (body === null || typeof body !== 'object') return [];
161:  const record_ = body as Record<string, unknown>;
162:  return ['access_token', 'refresh_token', 'session', 'provider_token', 'provider_refresh_token']
163:    .filter((name) => record_[name] !== undefined && record_[name] !== null);
164:}
