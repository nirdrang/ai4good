131:function redactedLocation(url: string): string {
132:  if (url === '') return '';
133:  const hash = url.indexOf('#');
134:  const fragmentNote = hash < 0 ? '' : '#<redacted-fragment>';
135:  const withoutHash = hash < 0 ? url : url.slice(0, hash);
136:
137:  const question = withoutHash.indexOf('?');
138:  if (question < 0) return `${withoutHash}${fragmentNote}`;
139:
140:  const query = withoutHash
141:    .slice(question + 1)
142:    .split('&')
143:    .map((pair) => {
144:      const equals = pair.indexOf('=');
145:      return equals < 0 ? pair : `${pair.slice(0, equals)}=<redacted>`;
146:    })
147:    .join('&');
148:  return `${withoutHash.slice(0, question)}?${query}${fragmentNote}`;
149:}
