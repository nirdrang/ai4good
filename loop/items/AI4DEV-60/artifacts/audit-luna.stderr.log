307:/**
308: * IS THIS THE REFUSAL WE NAMED, or merely A refusal â€” the distinction the predecessor's gate found
309: * missing. A pass needs BOTH halves: a 4xx that is not 429 (a client refusal, not a throttle and not
310: * a server fault), and a body naming the pinned error code.
311: *
312: * IT READS THE IN-MEMORY BODY, NOT THE PRINTED ONE, and that is load-bearing: the redactor's key
313: * pattern ends with `code$`, so `error_code` is blanked in everything it prints. Judging the printed
314: * text would judge `<redacted>`. An error code is an enum value, not a credential, so it is surfaced
315: * separately through this safe extraction.
316: */
317:function refusalNaming(wire: Wire, expected: string): { ok: boolean; discriminator: string } {
318:  const body = wire.body !== null && typeof wire.body === 'object' ? (wire.body as Record<string, unknown>) : {};
319:  const errorCode = typeof body.error_code === 'string' ? body.error_code : '';
320:  const message = [body.msg, body.message, body.error_description, body.error, wire.body]
321:    .filter((part): part is string => typeof part === 'string')
322:    .join(' | ');
323:
324:  const statusIsClientRefusal = wire.status >= 400 && wire.status < 500 && wire.status !== 429;
325:  return {
326:    ok: statusIsClientRefusal && errorCode === expected,
327:    discriminator:
328:      `HTTP ${wire.status} Â· error_code=${errorCode === '' ? '<absent>' : errorCode}` +
329:      ` (expected ${expected}) Â· message=${JSON.stringify(scrubString(message) || '<absent>')}`,
330:  };
331:}
