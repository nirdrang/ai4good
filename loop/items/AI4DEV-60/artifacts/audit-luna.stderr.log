111:export function callerFromAuthAnswer(status: number, user: unknown): Caller | null {
112:  if (!isSuccessStatus(status)) return null;
113:  // `typeof null === 'object'`, so the null check is not decoration: without it the property read
114:  // below throws, and a throw on the write path is not a refusal.
115:  if (typeof user !== 'object' || user === null) return null;
116:  const id = (user as { id?: unknown }).id;
117:  if (typeof id !== 'string') return null;
118:  return { id, githubHandle: extractGithubHandle(user) };
