63:   * signup gate turns on.
64:   *
65:   * It is a property of the user, not of the session: an email- or Google-established session whose
66:   * user later links GitHub carries a handle here while its establishing provider is unchanged.
67:   */
68:  githubHandle: string | null;
69:};
