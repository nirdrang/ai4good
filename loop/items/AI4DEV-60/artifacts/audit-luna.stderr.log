363:    const CONTROL_NAME = 'Riverside Shelter Control Programme';
364:    expect(
365:      (await sut.createOrganization(first.session, CONTROL_NAME)).ok,
366:      'a live session could not write â€” nothing below would be about the session layer',
367:    ).toBe(true);
368:
369:    // (2) EXPIRY. The clock is the only thing that changes across this line: the same session, the
370:    // same account, the same shape of write.
371:    //
372:    // THE ADVANCE IS EXACTLY THE TTL, AND EXACTLY IS THE WHOLE POINT. One hour is
373:    // `jwt_expiry = 3600` in `supabase/config.toml`, which the fixture mirrors, and this lands the
374:    // clock ON the expiry instant rather than past it. The fixture's `sessionIsLive` compares with
375:    // a strict `<`, so at this instant the session is already dead and the write below is refused;
376:    // an inclusive `<=` would admit it and this body would fail. That boundary was a promise with
377:    // no oracle until this line pinned it. AT-001.13 keeps its just-under/just-past pair, which
378:    // discriminates the refresh rather than the boundary.
379:    await h.clock.advance(3600 * 1000);
380:
381:    const EXPIRED_NAME = 'Riverside Shelter Expired Programme';
382:    const afterExpiry = await sut.createOrganization(first.session, EXPIRED_NAME);
383:    expect(afterExpiry.ok, 'an EXPIRED session was allowed to write').toBe(false);
384:    // A STALE-SESSION WRITE THAT HAPPENED ANYWAY IS NOT A BLOCK. The refusal hands back no
385:    // identifier, so the row that must not exist is looked for by the name that was attempted.
386:    expect(
387:      await sut.organizationsNamed(EXPIRED_NAME),
388:      'the refused write of an expired session created the organisation anyway',
389:    ).toEqual([]);
390:
391:    // (3) RE-AUTHENTICATION IS THE REMEDY, proved by being the exact change that unblocks. The same
392:    // write, the same name, under a session obtained by signing in again.
393:    const second = await sut.signInWithEmailPassword(email, PASSWORD);
394:    expect(second.ok, 'the account could not sign in again after its session expired').toBe(true);
395:    if (!second.ok) return;
396:    expect(second.session.accountId, 're-authentication returned a different account').toBe(first.session.accountId);
397:
398:    expect(
399:      (await sut.createOrganization(second.session, EXPIRED_NAME)).ok,
400:      're-authentication did not restore the ability to write',
401:    ).toBe(true);
402:    expect(
403:      (await sut.organizationsNamed(EXPIRED_NAME)).length,
404:      'the write after re-authentication did not create the organisation',
405:    ).toBe(1);
406:
407:    // (4) REVOCATION, the criterion's other half, on a session that is live at the moment it is
408:    // revoked â€” so the clock plays no part in this half and the two causes stay distinguishable.
409:    await sut.signOut(second.session);
410:
411:    const REVOKED_NAME = 'Riverside Shelter Revoked Programme';
412:    const afterRevocation = await sut.createOrganization(second.session, REVOKED_NAME);
413:    expect(afterRevocation.ok, 'a REVOKED session was allowed to write').toBe(false);
414:    expect(
415:      await sut.organizationsNamed(REVOKED_NAME),
416:      'the refused write of a revoked session created the organisation anyway',
417:    ).toEqual([]);
418:
419:    // (5) AND RE-AUTHENTICATION IS THE REMEDY FOR REVOCATION TOO. Revoking one session must not end
420:    // the account's access â€” that difference is what makes "the next request re-authenticates" a
421:    // remedy rather than a wall.
422:    const third = await sut.signInWithEmailPassword(email, PASSWORD);
423:    expect(third.ok, 'the account could not sign in again after its session was revoked').toBe(true);
424:    if (!third.ok) return;
425:    expect(
426:      (await sut.createOrganization(third.session, REVOKED_NAME)).ok,
427:      'signing in again after revocation did not restore the ability to write',
428:    ).toBe(true);
429:    expect(
430:      (await sut.organizationsNamed(REVOKED_NAME)).length,
431:      'the write after re-authentication did not create the organisation',
432:    ).toBe(1);
433:  },
434:);
