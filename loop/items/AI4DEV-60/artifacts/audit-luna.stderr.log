395:/**
396: * THE POST-LINK AUTH STATE FOR GITHUB, FABRICATED BY OPERATOR AUTHORITY â€” the predecessor's recipe
397: * carried over whole, including the correction that cost it real time.
398: *
399: * Linking a GitHub identity is an OAuth consent round trip: a person at github.com and a redirect no
400: * script can drive. What linking LEAVES BEHIND is a row in `auth.identities`, and that row is what
401: * the shipped code reads. So the row is written directly, as the operator.
402: *
403: * `created_at`, `updated_at` and `last_sign_in_at` are NULLABLE in the table, so a row without them
404: * inserts happily; but GoTrue reads identities into a Go struct with non-pointer timestamps, so
405: * `GET /auth/v1/user` then answers 500 for that user, and the whole thing looks exactly like an
406: * expired token rather than like a malformed row three layers away. So they are filled here.
407: */
408:async function fabricateGithubIdentity(userId: string, handle: string): Promise<void> {
409:  await sql`
410:    insert into auth.identities (id, user_id, provider, provider_id, identity_data,
411:                                 created_at, updated_at, last_sign_in_at)
412:    values (
413:      gen_random_uuid(),
414:      ${userId}::uuid,
415:      'github',
416:      ${`gh-${handle}-${RUN}`},
417:      -- The casts are explicit because jsonb_build_object takes "any", so PostgreSQL has nothing to
418:      -- infer a parameter's type from and refuses the statement outright rather than guessing.
419:      jsonb_build_object('sub', ${userId}::text, 'user_name', ${handle}::text, 'provider_id', ${`gh-${handle}-${RUN}`}::text),
420:      now(), now(), now()
421:    )`;
422:}
