122:/**
123: * WHO IS CALLING — answered by Supabase Auth, never by this function.
124: *
125: * `verify_jwt = true` in `config.toml` means the platform has already verified the token's
126: * signature before this code runs. That still leaves the question of which user it belongs to, and
127: * the cheap answer — decode the payload and read `sub` — would mean trusting a base64 blob because
128: * something upstream is believed to have checked it. So the token is presented to `/auth/v1/user`
129: * instead and Auth answers. One extra round trip, no cryptography in our code, and no dependency:
130: * `fetch` is enough.
131: */
132:export async function resolveCaller(request: Request, supabaseUrl: string, anonKey: string): Promise<Caller | null> {
133:  const authorization = request.headers.get('Authorization');
134:  if (!authorization) return null;
135:
136:  const response = await fetch(`${supabaseUrl}/auth/v1/user`, {
137:    headers: { Authorization: authorization, apikey: anonKey },
138:  });
139:  if (!response.ok) return null;
140:
141:  const user = (await response.json()) as unknown;
142:  const id = (user as { id?: unknown }).id;
143:  if (typeof id !== 'string') return null;
144:
145:  // THE ID AND THE LINKED GITHUB HANDLE — and still NOT the establishing provider.
146:  //
147:  // This is the one-line extension the previous version of this comment reserved for "the leaf that
148:  // needs either", and it takes exactly one of the two. The GitHub handle is carried because
149:  // `validateCompleteSignup` gates volunteer completion on it and a client must not be able to
150:  // assert it; the ADDRESS and the ESTABLISHING PROVIDER are still left behind, because nothing on
151:  // either path reads them and a `provider` field sitting on this type would be a standing
152:  // suggestion that email-vs-Google participates in a decision here. It does not — that is the whole
153:  // of what AT-001.03 establishes, and a LINKED identity is a different fact from the one that
154:  // established the session.
155:  //
156:  // `extractGithubHandle` is given the WHOLE response rather than a pre-narrowed field: it does the
