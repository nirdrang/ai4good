333:/**
334: * THE SAME LINK WITH A TOKEN GOTRUE NEVER ISSUED â€” the instrument both the verification leaf and
335: * this one use, carried over unchanged.
336: *
337: * The token this returns was never minted, so following it says nothing about expiry, about single
338: * use, or about resend â€” retired AT-001.15 stays untouched. Every other part of the link is left
339: * exactly as GoTrue wrote it, so the only difference between this request and the real one is the
340: * token itself. The mutation shifts digits and letters inside their own alphabet, which keeps the
341: * token the same length and shape: a token that changed shape could be refused for being malformed
342: * rather than for being unissued, and the check would then measure input validation.
343: */
344:function tamperLinkToken(link: string): { tampered: string; parameter: string } | null {
345:  let url: URL;
346:  try {
347:    url = new URL(link);
348:  } catch {
349:    return null;
350:  }
351:  const parameter = ['token', 'token_hash', 'confirmation_token'].find((name) => {
352:    const value = url.searchParams.get(name);
353:    return typeof value === 'string' && value !== '';
354:  });
355:  if (parameter === undefined) return null;
356:
357:  const original = url.searchParams.get(parameter) as string;
358:  const mutated = original.replace(/[0-9a-zA-Z]/g, (character) => {
359:    if (character >= '0' && character <= '9') return String((Number(character) + 5) % 10);
360:    const base = character >= 'a' ? 'a'.charCodeAt(0) : 'A'.charCodeAt(0);
361:    return String.fromCharCode(base + ((character.charCodeAt(0) - base + 13) % 26));
362:  });
363:  if (mutated === original) return null;
364:
365:  url.searchParams.set(parameter, mutated);
366:  return { tampered: url.toString(), parameter };
367:}
