211:function isIpv6(value: string): boolean {
212:  if (value.split('::').length > 2) return false;
213:  const abbreviated = value.includes('::');
214:  const groups = value.split(':').filter((group) => group !== '');
215:  if (groups.length === 0) return abbreviated; // `::` itself
216:  const last = groups[groups.length - 1];
217:  // `::ffff:127.0.0.1` is a legal IPv6 address whose final element is a dotted IPv4 and occupies
218:  // two of the eight groups.
219:  const trailingIpv4 = last.includes('.');
220:  if (trailingIpv4 && !isIpv4(last)) return false;
221:  const hexGroups = trailingIpv4 ? groups.slice(0, -1) : groups;
222:  if (!hexGroups.every((group) => /^[0-9a-fA-F]{1,4}$/.test(group))) return false;
223:  const count = hexGroups.length + (trailingIpv4 ? 2 : 0);
224:  return abbreviated ? count < 8 : count === 8;
225:}
