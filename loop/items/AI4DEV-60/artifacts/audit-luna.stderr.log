384:async function sessionRows(userId: string): Promise<Array<{ id: string; not_after: string | null }>> {
385:  const rows = await sql`
386:    select id::text as id, not_after::text as not_after
387:      from auth.sessions
388:     where user_id = ${userId}::uuid
389:     order by created_at`;
390:  return rows as Array<{ id: string; not_after: string | null }>;
391:}
