 213: /** The result of a database function call: its value, or the database's own refusal. */
 214: export type RpcOutcome = { ok: true; value: unknown } | { ok: false; status: number; message: string };
 215: 
 216: /**
 217:  * Call one `public.` function, with the service role, in ONE round trip.
 218:  *
 219:  * One round trip is one implicit transaction, which is the whole reason the signup writes live
 220:  * inside a database function rather than being issued as separate Data API calls from here. Four
 221:  * calls would be four transactions, and a failure partway would leave an account with no
 222:  * organisation, membership or acknowledgment.
 223:  *
 224:  * The service role bypasses row-level security, which is why the database functions perform their
 225:  * own checks: nothing else is standing on this path.
 226:  */
 227: export async function callDatabaseFunction(
 228:   supabaseUrl: string,
 229:   serviceRoleKey: string,
 230:   name: string,
 231:   args: Record<string, unknown>,
 232: ): Promise<RpcOutcome> {
 233:   const response = await fetch(`${supabaseUrl}/rest/v1/rpc/${name}`, {
 234:     method: 'POST',
 235:     headers: {
 236:       'content-type': 'application/json',
 237:       apikey: serviceRoleKey,
 238:       Authorization: `Bearer ${serviceRoleKey}`,
 239:     },
 240:     body: JSON.stringify(args),
 241:   });
 242: 
 243:   const text = await response.text();
 244:   if (!response.ok) {
 245:     // PostgREST wraps a raised exception as `{ message, code, details, hint }`. The message is the
 246:     // sentence the database function chose, so it is passed through rather than replaced with a
 247:     // generic one â€” those functions raise sentences precisely so a caller can act on them.
 248:     let message = text;
 249:     try {
 250:       const body = JSON.parse(text) as { message?: unknown };
 251:       if (typeof body.message === 'string') message = body.message;
 252:     } catch {
 253:       // A non-JSON body from PostgREST means something other than a raised exception went wrong;
 254:       // the raw text is then the most informative thing available.
 255:     }
 256:     return { ok: false, status: response.status, message };
 257:   }
 258: 
 259:   return { ok: true, value: text === '' ? null : (JSON.parse(text) as unknown) };
 260: }
 261: 
 262: /** Read a JSON request body, or refuse â€” a malformed body must not read as an empty one. */
 263: export async function readJsonBody(request: Request): Promise<{ ok: true; value: Record<string, unknown> } | { ok: false; reason: string }> {
 264:   let text: string;
 265:   try {
 266:     text = await request.text();
 267:   } catch {
 268:     return { ok: false, reason: 'the request body could not be read' };
 269:   }
 270:   if (text.trim() === '') return { ok: true, value: {} };
 271:   try {
 272:     const parsed = JSON.parse(text) as unknown;
 273:     if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) {
 274:       return { ok: false, reason: 'the request body must be a JSON object' };
 275:     }
 276:     return { ok: true, value: parsed as Record<string, unknown> };
 277:   } catch {
 278:     return { ok: false, reason: 'the request body is not valid JSON' };
 279:   }
 280: }
