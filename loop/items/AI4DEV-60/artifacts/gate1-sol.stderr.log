  95:   // working while a migration is rolling, in either order. Sending `p_github_handle: null` instead
  96:   // would name an argument the older function does not have, and PostgREST would fail to resolve the
  97:   // call: same intent, and the NGO signup path broken for the length of the window.
  98:   //
  99:   // The database sees no difference in the new-plane case: an omitted argument arrives as the
 100:   // default, which is null, which is exactly what the NGO branch requires.
 101:   const githubArguments = githubHandle === null
 102:     ? {}
 103:     : {
 104:       p_github_handle: githubHandle,
 105:       p_github_top_languages: githubStats?.topLanguages ?? null,
 106:       p_github_repository_count: githubStats?.repositoryCount ?? null,
 107:       p_github_contribution_summary: githubStats?.contributionSummary ?? null,
 108:     };
