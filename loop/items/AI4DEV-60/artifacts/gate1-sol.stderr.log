  35: const SUPABASE_URL = requireEnv('SUPABASE_URL');
  36: const ANON_KEY = requireEnv('SUPABASE_ANON_KEY', 'SUPABASE_PUBLISHABLE_KEY');
  37: const SERVICE_ROLE_KEY = requireEnv('SUPABASE_SERVICE_ROLE_KEY', 'SUPABASE_SECRET_KEY');
  38: 
  39: /**
  40:  * The caller's global account type, read from `public.accounts` with the service role.
  41:  *
  42:  * THREE OUTCOMES, NOT TWO, and the distinction is the whole point of this shape. `absent` means the
  43:  * row is not there â€” a real and distinct state, an authenticated user who has not completed signup,
  44:  * and the caller is told to complete signup. `failed` means the read did not happen: the Data API
  45:  * answered with an error, so this function knows nothing about the account either way. Collapsing
  46:  * the second into the first told a caller whose database was unreachable to "complete signup before
  47:  * creating an organisation", which is a refusal naming the wrong thing to fix â€” the exact
  48:  * conflation this comment used to warn against while the code performed it.
  49:  */
  50: type AccountTypeLookup =
  51:   | { kind: 'found'; accountType: string }
  52:   | { kind: 'absent' }
  53:   | { kind: 'failed'; detail: string };
  54: 
  55: async function accountTypeOf(accountId: string): Promise<AccountTypeLookup> {
  56:   const response = await fetch(
  57:     `${SUPABASE_URL}/rest/v1/accounts?id=eq.${encodeURIComponent(accountId)}&select=account_type`,
  58:     {
  59:       headers: {
  60:         apikey: SERVICE_ROLE_KEY,
  61:         Authorization: `Bearer ${SERVICE_ROLE_KEY}`,
  62:         Accept: 'application/json',
  63:       },
  64:     },
  65:   );
  66:   if (!response.ok) return { kind: 'failed', detail: `the account read answered ${response.status}` };
  67:   const rows = (await response.json()) as { account_type?: unknown }[];
  68:   const type = rows[0]?.account_type;
  69:   if (typeof type === 'string') return { kind: 'found', accountType: type };
  70:   // No row, or a row with no readable type â€” both mean this account holds no global type yet.
  71:   return { kind: 'absent' };
  72: }
  73: 
  74: Deno.serve(edgeHandler('create-organization', async (request: Request): Promise<Response> => {
  75:   if (request.method !== 'POST') return refusal('create-organization accepts POST only', 405);
  76: 
  77:   const caller = await resolveCaller(request, SUPABASE_URL, ANON_KEY);
  78:   if (!caller) return refusal('authenticate before creating an organisation', 401);
  79: 
  80:   const lookup = await accountTypeOf(caller.id);
  81:   // A failed read is an outage, not a judgement about this account, so it answers 502 and says so.
  82:   if (lookup.kind === 'failed') {
  83:     return refusal(`the caller's account could not be read, so no decision was made: ${lookup.detail}`, 502);
  84:   }
  85:   if (lookup.kind === 'absent') return refusal('complete signup before creating an organisation', 409);
  86: 
  87:   const allowed = ngoOnlyActionAllowed(lookup.accountType);
  88:   if (!allowed.ok) return refusal(allowed.reason, 403);
  89: 
  90:   const body = await readJsonBody(request);
  91:   if (!body.ok) return refusal(body.reason, 400);
  92: 
  93:   // THE NAME RULE IS THE SHARED MODULE'S, like every other judgement on this path. It used to be
  94:   // written here AND again in the acceptance adapter â€” one rule in two copies, neither of them the
  95:   // module the suite grades, so AT-001.06's green graded the adapter's copy of it.
  96:   const name = validateOrganizationName(body.value.name);
  97:   if (!name.ok) return refusal(name.reason, 400);
  98: 
  99:   // ONE ROUND TRIP, for the same reason `complete-signup` uses one: the organisation and its admin
 100:   // membership are two writes, and issuing them as two Data API calls would be two transactions â€”
 101:   // a failure between them leaves an organisation nobody is a member of, which no acceptance
 102:   // criterion describes and nothing would repair.
 103:   const outcome = await callDatabaseFunction(SUPABASE_URL, SERVICE_ROLE_KEY, 'create_organization', {
 104:     p_account_id: caller.id,
 105:     p_name: name.value,
 106:   });
 107: 
 108:   if (!outcome.ok) {
 109:     const status = outcome.status >= 400 && outcome.status < 500 ? 409 : 502;
 110:     return refusal(outcome.message, status);
 111:   }
 112: 
 113:   const result = outcome.value as { organization_id?: string } | null;
 114:   return json({ ok: true, organizationId: result?.organization_id ?? null }, 200);
