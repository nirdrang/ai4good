#!/bin/bash
# PATH-front wrapper for the grok CLI on hosts whose kernel lacks Landlock.
set -euo pipefail

self=$(readlink -f "$0")
real=/root/.local/bin/grok
if [ ! -x "$real" ] || [ "$(readlink -f "$real")" = "$self" ]; then
  real=""
  IFS=: read -ra dirs <<<"$PATH"
  for d in "${dirs[@]}"; do
    c="$d/grok"
    [ -x "$c" ] && [ "$(readlink -f "$c")" != "$self" ] && { real="$c"; break; }
  done
fi
[ -n "$real" ] || { echo "grok wrapper: real grok binary not found" >&2; exit 127; }

landlock=0
if grep -qs landlock /sys/kernel/security/lsm; then
  landlock=1
fi

out=()
while [ $# -gt 0 ]; do
  case "$1" in
    --sandbox)
      case "${2:-}" in
        workspace)
          if [ "$landlock" -eq 0 ]; then
            echo "grok-shim: rewriting --sandbox workspace to devbox" >&2
            out+=(--sandbox devbox)
          else
            out+=(--sandbox workspace)
          fi
          ;;
        read-only)
          if [ "$landlock" -eq 0 ]; then
            echo "grok-shim: rewriting --sandbox read-only to devbox" >&2
            out+=(--sandbox devbox)
          else
            out+=(--sandbox read-only)
          fi
          ;;
        *) out+=(--sandbox "${2:-}") ;;
      esac
      shift 2 ;;
    --permission-mode)
      case "${2:-}" in
        acceptEdits)
          if [ "$landlock" -eq 0 ]; then
            echo "grok-shim: rewriting --permission-mode acceptEdits to bypassPermissions" >&2
            out+=(--permission-mode bypassPermissions)
          else
            out+=(--permission-mode acceptEdits)
          fi
          ;;
        *) out+=(--permission-mode "${2:-}") ;;
      esac
      shift 2 ;;
    --no-auto-update) shift ;;
    *) out+=("$1"); shift ;;
  esac
done

export GROK_DISABLE_AUTOUPDATER=1
if [ "$landlock" -eq 0 ]; then
  echo "grok-shim: exporting GROK_SANDBOX_AUTO_ALLOW_BASH=1" >&2
  export GROK_SANDBOX_AUTO_ALLOW_BASH=1
fi
exec "$real" "${out[@]}"
